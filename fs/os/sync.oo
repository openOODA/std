// # Mutex and spawn under ThreadCap
//
// Logline: sync_mutex_lock, sync_mutex_unlock, and sync_thread_spawn wrap the pthread floor under ThreadCap.
//
// Setup: CAPS.oot names ThreadCap. Runtime injects the token. This file does not mint one.
//
// Beats:
//   1. lock and unlock forward a non-negative mutex id to mutex_lock and mutex_unlock.
//   2. sync_thread_spawn forwards a non-empty name to thread_spawn.
//   3. sync_demo locks, unlocks, and spawns demo under a granted ThreadCap
//      (named demo, not main: an imported main would hijack the importer).
//
// residual: not a full OS scheduler or spinlock product

pub fn sync_mutex_lock(thread: &ThreadCap, mid: Int) -> Result[String, String]
    requires mid >= 0
{
    return mutex_lock(thread, mid);
}

pub fn sync_mutex_unlock(thread: &ThreadCap, mid: Int) -> Result[String, String]
    requires mid >= 0
{
    return mutex_unlock(thread, mid);
}

pub fn sync_thread_spawn(thread: &ThreadCap, name: String) -> Result[String, String]
    requires name.len() > 0
{
    return thread_spawn(thread, name);
}

// Honesty probe: granted ThreadCap → mutex lock/unlock Ok; spawn Ok handle.
// (assert_eq! does not lower in the LLVM emitter, so this spells it out.)
pub fn sync_demo(thread: &ThreadCap) -> Result[Int, String] {
    let lk: Result[String, String] = sync_mutex_lock(thread, 1);
    if lk.is_err() {
        return Err("sync: mutex lock must be Ok");
    }
    let uk: Result[String, String] = sync_mutex_unlock(thread, 1);
    if uk.is_err() {
        return Err("sync: mutex unlock must be Ok");
    }
    let sp: Result[String, String] = sync_thread_spawn(thread, "demo");
    if sp.is_err() {
        return Err("sync: thread spawn must be Ok");
    }
    return Ok(0);
}
