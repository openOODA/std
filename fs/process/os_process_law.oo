// # OS process exit code and fd index law
//
// Logline: Exit code 0 is success and any other value is failure, and a valid file descriptor lies in the half-open range [0, 1024).
//
// Setup: Pure Int. No ProcessCap, no FsCap. fd_limit is a fixed constant 1024 from the standard POSIX per-process table.
//
// Beats:
//   1. os_exit_is_success holds 1 only for code 0.
//   2. Negative exit codes fail closed to 0.
//   3. os_fd_valid holds 1 for fd in [0, 1024) and 0 for fd at 1024 or above or below 0.

import "std/core/primitives/domain_cert.oo";

pub fn os_exit_is_success(code: Int) -> Int {
    if code == 0 {
        return 1;
    }
    return 0;
}

pub fn os_fd_valid(fd: Int) -> Int {
    if fd < 0 {
        return 0;
    }
    if fd >= 1024 {
        return 0;
    }
    return 1;
}

pub fn verify_os_process_law() -> Bool {
    if os_exit_is_success(0) != 1 {
        return false;
    }
    if os_exit_is_success(1) != 0 {
        return false;
    }
    if os_exit_is_success(255) != 0 {
        return false;
    }
    if os_exit_is_success(-1) != 0 {
        return false;
    }
    if os_fd_valid(0) != 1 {
        return false;
    }
    if os_fd_valid(1) != 1 {
        return false;
    }
    if os_fd_valid(1023) != 1 {
        return false;
    }
    if os_fd_valid(1024) != 0 {
        return false;
    }
    if os_fd_valid(-1) != 0 {
        return false;
    }
    if os_fd_valid(65535) != 0 {
        return false;
    }
    return true;
}

// Domain certificate: 1 if the OS process law holds across all golden and hostile cases.
pub fn os_process_law_holds() -> DomainCert {
    if verify_os_process_law() {
        return domain_cert("os", "os_process_law", 1);
    }
    return domain_cert("os", "os_process_law", 0);
}
