// # Operating System Resource Limit Module
//
// Logline: POSIX RLIMIT_* resource-type constants for callers composing C-level oo_rlimit_set_*.
//
// Setup: The .oo facade exposes only the RLIMIT_* integer constants. The
//   actual setrlimit syscalls lower via runtime oo_rlimit_set_mem_mb /
//   oo_rlimit_set_nofile / oo_rlimit_set_cpu_sec under SysCap; this file
//   does not provide user-space setrlimit shims.
//
// Beats:
//   1. Define standard resource limit constants (RLIMIT_CPU, RLIMIT_NOFILE, RLIMIT_AS, RLIMIT_NPROC).
// RULES.oot 1.4: Default-deny for system resource reconfiguration. Explicit &SysCap required.
// RULES.oot 1.7: Under 256 lines.

// RLIMIT_CPU resource constant (0).
pub fn rlimit_cpu_limit() -> Int {
    return 0;
}

// RLIMIT_FSIZE resource constant (1).
pub fn rlimit_fsize_limit() -> Int {
    return 1;
}

// RLIMIT_DATA resource constant (2).
pub fn rlimit_data_limit() -> Int {
    return 2;
}

// RLIMIT_STACK resource constant (3).
pub fn rlimit_stack_limit() -> Int {
    return 3;
}

// RLIMIT_CORE resource constant (4).
pub fn rlimit_core_limit() -> Int {
    return 4;
}

// RLIMIT_NOFILE resource constant (7).
pub fn rlimit_nofile_limit() -> Int {
    return 7;
}

// RLIMIT_AS (virtual memory) resource constant (9).
pub fn rlimit_as_limit() -> Int {
    return 9;
}

// RLIMIT_NPROC resource constant (6).
pub fn rlimit_nproc_limit() -> Int {
    return 6;
}
