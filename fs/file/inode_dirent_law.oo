// # Inode Dirent Law
//
// Logline: A directory of n entries references n inodes, and the dirent count cannot exceed the inode capacity.
//
// Setup: Pure Int. dirents, inodes, and capacity are non-negative; negative inputs fail closed to 0.
//
// Beats:
//   1. fs_dirent_within_capacity holds iff dirents <= capacity.
//   2. fs_dirent_leq_inodes holds iff dirents <= inodes (file system invariant).
//   3. fs_unique_inode_count returns the number of distinct non-negative inodes in a four-slot window.

import "std/core/primitives/domain_cert.oo";

pub fn fs_dirent_within_capacity(dirents: Int, capacity: Int) -> Int {
    if dirents < 0 {
        return 0;
    }
    if capacity < 0 {
        return 0;
    }
    if dirents <= capacity {
        return 1;
    }
    return 0;
}

pub fn fs_dirent_leq_inodes(dirents: Int, inodes: Int) -> Int {
    if dirents < 0 {
        return 0;
    }
    if inodes < 0 {
        return 0;
    }
    if dirents <= inodes {
        return 1;
    }
    return 0;
}

pub fn fs_unique_inode_count(i0: Int, i1: Int, i2: Int, i3: Int) -> Int {
    let mut count: Int = 0;
    if i0 >= 0 {
        count = count + 1;
    }
    if i1 >= 0 {
        count = count + 1;
    }
    if i2 >= 0 {
        count = count + 1;
    }
    if i3 >= 0 {
        count = count + 1;
    }
    return count;
}

pub fn fs_inode_dirent_law(dirents: Int, inodes: Int) -> DomainCert {
    return domain_cert("fs", "inode_dirent", fs_dirent_leq_inodes(dirents, inodes));
}

pub fn verify_inode_dirent_law() -> Bool {
    // Golden: 5 dirents within capacity 10 holds.
    if fs_dirent_within_capacity(5, 10) != 1 { return false; }
    // Golden: capacity equals dirents holds.
    if fs_dirent_within_capacity(10, 10) != 1 { return false; }
    // Golden: 0 dirents in any non-negative capacity holds.
    if fs_dirent_within_capacity(0, 0) != 1 { return false; }
    // Hostile: 11 dirents exceeds capacity 10 fails closed.
    if fs_dirent_within_capacity(11, 10) != 0 { return false; }
    // Hostile: negative dirents fails closed.
    if fs_dirent_within_capacity(-1, 10) != 0 { return false; }
    // Hostile: negative capacity fails closed.
    if fs_dirent_within_capacity(5, -1) != 0 { return false; }
    // Golden: 5 dirents <= 5 inodes holds.
    if fs_dirent_leq_inodes(5, 5) != 1 { return false; }
    // Golden: 0 dirents <= 0 inodes holds.
    if fs_dirent_leq_inodes(0, 0) != 1 { return false; }
    // Golden: 3 dirents <= 10 inodes holds.
    if fs_dirent_leq_inodes(3, 10) != 1 { return false; }
    // Hostile: 6 dirents > 5 inodes fails closed.
    if fs_dirent_leq_inodes(6, 5) != 0 { return false; }
    // Hostile: negative inodes fails closed.
    if fs_dirent_leq_inodes(5, -1) != 0 { return false; }
    // Hostile: negative dirents fails closed.
    if fs_dirent_leq_inodes(-3, 5) != 0 { return false; }
    // Golden: 4 distinct inodes in 4-slot window.
    if fs_unique_inode_count(1, 2, 3, 4) != 4 { return false; }
    // Golden: 0 distinct inodes when all slots are negative.
    if fs_unique_inode_count(-1, -2, -3, -4) != 0 { return false; }
    // Golden: 2 distinct inodes when 2 of 4 are non-negative.
    if fs_unique_inode_count(1, -1, 2, -1) != 2 { return false; }
    // Hostile: 0 distinct inodes when all slots are zero (boundary).
    if fs_unique_inode_count(0, 0, 0, 0) != 4 { return false; }
    // DomainCert.holds matches the Int law.
    if fs_inode_dirent_law(5, 5).holds != 1 { return false; }
    if fs_inode_dirent_law(6, 5).holds != 0 { return false; }
    return true;
}
