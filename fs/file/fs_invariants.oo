// # Filesystem dot-dot traversal law
//
// Logline: A path that contains ".." is traversal. Traversal is rejected.
//
// Setup: Pure. Imports domain_cert.oo. fs_is_dotdot_traversal returns 1 or 0.
//
// Beats:
//   1. fs_is_dotdot_traversal("../x") is 1.
//   2. fs_is_dotdot_traversal("a.txt") is 0.
//   3. fs_traversal_rejected("../etc") holds 1.

import "std/core/primitives/domain_cert.oo";

pub fn fs_is_dotdot_traversal(path: String) -> Int {
    if str_index_of(path, "..") >= 0 {
        return 1;
    }
    return 0;
}

pub fn fs_traversal_rejected(path: String) -> DomainCert {
    let t: Int = fs_is_dotdot_traversal(path);
    return domain_cert("fs", "traversal_rejected", t);
}

pub fn fs_path_not_traversal(path: String) -> DomainCert {
    let t: Int = fs_is_dotdot_traversal(path);
    if t == 0 {
        return domain_cert("fs", "not_traversal", 1);
    }
    return domain_cert("fs", "not_traversal", 0);
}
