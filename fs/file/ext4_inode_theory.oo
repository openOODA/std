// # ext4 Inode Theory
//
// Logline: An ext4 inode addresses 12 direct blocks plus 1 indirect, 1 double-indirect, and 1 triple-indirect block.
//
// Setup: Pure Int. Sizes and block sizes are non-negative; negative inputs fail closed to 0. block_size must be > 0.
//
// Beats:
//   1. ext4_block_count returns ceil(size / block_size) for size > 0.
//   2. ext4_max_direct_bytes returns 12 * block_size.
//   3. ext4_uses_indirect holds iff size > 12 * block_size.
//   4. ext4_max_file_bytes returns the cap with all indirection levels enabled.

import "std/core/primitives/domain_cert.oo";

fn e4_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn ext4_direct_block_count() -> Int {
    return 12;
}

pub fn ext4_block_count(size: Int, block_size: Int) -> Result[Int, String] {
    if size < 0 { return Err("ERR\te4\tdomain"); }
    if block_size <= 0 { return Err("ERR\te4\tdomain"); }
    if size == 0 { return Ok(0); }
    let groups: Int = (size + block_size - 1) / block_size;
    return Ok(groups);
}

pub fn ext4_max_direct_bytes(block_size: Int) -> Result[Int, String] {
    if block_size <= 0 { return Err("ERR\te4\tdomain"); }
    return Ok(12 * block_size);
}

pub fn ext4_uses_indirect(size: Int, block_size: Int) -> Int {
    if size < 0 { return 0; }
    let capr: Result[Int, String] = ext4_max_direct_bytes(block_size);
    if capr.is_ok() == false { return 0; }
    if size > e4_got(capr) { return 1; }
    return 0;
}

pub fn ext4_max_file_bytes(block_size: Int, ptr_per_block: Int) -> Result[Int, String] {
    if block_size <= 0 { return Err("ERR\te4\tdomain"); }
    if ptr_per_block <= 0 { return Err("ERR\te4\tdomain"); }
    let direct: Int = 12 * block_size;
    let ind1: Int = block_size * ptr_per_block;
    let ind2: Int = block_size * ptr_per_block * ptr_per_block;
    let ind3: Int = block_size * ptr_per_block * ptr_per_block * ptr_per_block;
    return Ok(direct + ind1 + ind2 + ind3);
}

pub fn ext4_inode_theory(size: Int, block_size: Int) -> DomainCert {
    let mut h: Int = 0;
    if size >= 0 {
        if block_size > 0 {
            h = 1;
        }
    }
    return domain_cert("fs", "ext4_inode", h);
}

pub fn verify_ext4_inode_theory() -> Bool {
    // Golden: 12 direct blocks is the count.
    if ext4_direct_block_count() != 12 { return false; }
    // Golden: 256-byte file in 4096-byte blocks needs 1 block.
    if e4_got(ext4_block_count(256, 4096)) != 1 { return false; }
    if e4_got(ext4_block_count(4096, 4096)) != 1 { return false; }
    if e4_got(ext4_block_count(4097, 4096)) != 2 { return false; }
    let zbl: Result[Int, String] = ext4_block_count(0, 4096);
    if zbl.is_ok() == false { return false; }
    if e4_got(zbl) != 0 { return false; }
    if e4_got(ext4_block_count(12288, 4096)) != 3 { return false; }
    if ext4_block_count(0 - 1, 4096).is_ok() { return false; }
    if ext4_block_count(1024, 0).is_ok() { return false; }
    if ext4_block_count(1024, 0 - 4096).is_ok() { return false; }
    if e4_got(ext4_max_direct_bytes(4096)) != 49152 { return false; }
    if e4_got(ext4_max_direct_bytes(1024)) != 12288 { return false; }
    if ext4_max_direct_bytes(0).is_ok() { return false; }
    // Golden: file exactly 48 KiB does not need indirect.
    if ext4_uses_indirect(49152, 4096) != 0 { return false; }
    // Golden: file 48 KiB + 1 byte needs indirect.
    if ext4_uses_indirect(49153, 4096) != 1 { return false; }
    // Golden: 1 MiB file needs indirect.
    if ext4_uses_indirect(1048576, 4096) != 1 { return false; }
    // Hostile: negative size fails closed.
    if ext4_uses_indirect(-1, 4096) != 0 { return false; }
    // Hostile: zero block_size fails closed.
    if ext4_uses_indirect(1024, 0) != 0 { return false; }
    // Golden: 4-byte pointers and 4096-byte blocks yield 12 + 1024 + 1048576 + 1073741824 direct cap.
    let cap: Int = e4_got(ext4_max_file_bytes(4096, 1024));
    if cap != 12 * 4096 + 4096 * 1024 + 4096 * 1024 * 1024 + 4096 * 1024 * 1024 * 1024 { return false; }
    if ext4_max_file_bytes(0, 1024).is_ok() { return false; }
    if ext4_max_file_bytes(4096, 0).is_ok() { return false; }
    // DomainCert holds matches the Int law.
    if ext4_inode_theory(256, 4096).holds != 1 { return false; }
    if ext4_inode_theory(-1, 4096).holds != 0 { return false; }
    if ext4_inode_theory(256, 0).holds != 0 { return false; }
    return true;
}
