// # Journaling Law
//
// Logline: A journaled commit writes the log record before the data and metadata update; ordering is mandatory.
//
// Setup: Pure Int. Step indices are non-negative; log_step < data_step means log-first ordering. Negative inputs fail closed to 0.
//
// Beats:
//   1. fs_journal_log_first holds iff log_step < data_step.
//   2. fs_journal_ordered_holds holds iff the 2-step commit order is log then data.
//   3. fs_journal_replay_count returns the number of records to replay on startup.

import "std/core/primitives/domain_cert.oo";

pub fn fs_journal_log_first(log_step: Int, data_step: Int) -> Int {
    if log_step < 0 {
        return 0;
    }
    if data_step < 0 {
        return 0;
    }
    if log_step < data_step {
        return 1;
    }
    return 0;
}

pub fn fs_journal_ordered_holds(log_step: Int, data_step: Int) -> Int {
    if log_step == 0 {
        if data_step == 1 {
            return 1;
        }
    }
    return 0;
}

fn jrn_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn fs_journal_replay_count(pending_records: Int) -> Result[Int, String] {
    if pending_records < 0 { return Err("ERR\tjrn\tdomain"); }
    return Ok(pending_records);
}

pub fn fs_journal_two_step() -> Int {
    return 2;
}

pub fn journaling_law(log_step: Int, data_step: Int) -> DomainCert {
    return domain_cert("fs", "journaling", fs_journal_log_first(log_step, data_step));
}

pub fn verify_journaling_law() -> Bool {
    // Golden: standard 2-step commit (log=0, data=1) holds.
    if fs_journal_log_first(0, 1) != 1 { return false; }
    // Golden: log before data with any offset holds.
    if fs_journal_log_first(5, 6) != 1 { return false; }
    // Hostile: data before log fails closed.
    if fs_journal_log_first(1, 0) != 0 { return false; }
    // Hostile: equal steps (no ordering) fail closed.
    if fs_journal_log_first(2, 2) != 0 { return false; }
    // Hostile: negative log_step fails closed.
    if fs_journal_log_first(-1, 1) != 0 { return false; }
    // Hostile: negative data_step fails closed.
    if fs_journal_log_first(0, -1) != 0 { return false; }
    // Golden: 2-step commit constant.
    if fs_journal_two_step() != 2 { return false; }
    // Golden: 2-step (0,1) holds.
    if fs_journal_ordered_holds(0, 1) != 1 { return false; }
    // Hostile: (1,0) reversed fails closed.
    if fs_journal_ordered_holds(1, 0) != 0 { return false; }
    // Hostile: (0,0) not ordered fails closed.
    if fs_journal_ordered_holds(0, 0) != 0 { return false; }
    // Hostile: (2,3) not the standard 2-step fails closed.
    if fs_journal_ordered_holds(2, 3) != 0 { return false; }
    // Golden: replay count equals pending records.
    let zrep: Result[Int, String] = fs_journal_replay_count(0);
    if zrep.is_ok() == false { return false; }
    if jrn_got(zrep) != 0 { return false; }
    if jrn_got(fs_journal_replay_count(7)) != 7 { return false; }
    if jrn_got(fs_journal_replay_count(100)) != 100 { return false; }
    // Hostile: negative pending returns Err.
    if fs_journal_replay_count(0 - 1).is_ok() { return false; }
    // DomainCert holds matches the Int law.
    if journaling_law(0, 1).holds != 1 { return false; }
    if journaling_law(1, 0).holds != 0 { return false; }
    return true;
}
