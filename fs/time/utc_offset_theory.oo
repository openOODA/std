// # UTC offset theory
//
// Logline: A UTC offset in minutes is a closed signed integer in [-720, 720]; DST transitions shift the offset by exactly 60 minutes on transition dates within 1 minute of the wall-clock jump.
//
// Setup: Pure Int offsets in minutes. Offsets outside [-720, 720] fail closed. DST applies to a fixed-rule zone (e.g. America/New_York) where EST = -300 and EDT = -240.
//
// Beats:
//   1. Closed: fixed offset is whatever signed minute value sits in [-720, 720].
//   2. utc_offset_holds returns 1 iff offset_min is in [-720, 720].
//   3. Coupled: at March 13, 2022 02:00 in NYC, the offset jumps from -300 to -240 within 1 minute.
//   4. Hostile: out-of-range offset fails closed to holds=0.

import "std/core/primitives/domain_cert.oo";

// Lowest representable UTC offset in minutes (-12 hours).
pub fn utc_offset_min() -> Int {
    return 0 - 720;
}

// Highest representable UTC offset in minutes (+14 hours).
pub fn utc_offset_max() -> Int {
    return 720;
}

// EST in minutes: UTC-5 = -300.
pub fn utc_est_minutes() -> Int {
    return 0 - 300;
}

// EDT in minutes: UTC-4 = -240.
pub fn utc_edt_minutes() -> Int {
    return 0 - 240;
}

// CET in minutes: UTC+1 = +60.
pub fn utc_cet_minutes() -> Int {
    return 60;
}

// CEST in minutes: UTC+2 = +120.
pub fn utc_cest_minutes() -> Int {
    return 120;
}

// 1 if offset_min is in the closed range [-720, 720]; 0 otherwise.
pub fn utc_offset_valid(offset_min: Int) -> Int {
    if offset_min < utc_offset_min() { return 0; }
    if offset_min > utc_offset_max() { return 0; }
    return 1;
}

// 1 if the offset jumped by exactly 60 minutes between two readings; 0 otherwise.
pub fn utc_offset_jumped(before_min: Int, after_min: Int) -> Int {
    let d: Int = after_min - before_min;
    if d < 0 { return 0; }
    if d == 60 { return 1; }
    return 0;
}

// 1 if the jump amount is within `tol` minutes of the canonical 60-minute DST step.
pub fn utc_dst_step_ok(before_min: Int, after_min: Int, tol: Int) -> Int {
    let mut d: Int = after_min - before_min;
    if d < 0 { d = 0 - d; }
    if d == 60 { return 1; }
    let tabs_d: Int = d - 60;
    if tabs_d < 0 { return 0; }
    if tabs_d <= tol { return 1; }
    return 0;
}

pub fn utc_offset_holds(offset_min: Int) -> DomainCert {
    return domain_cert("time", "utc_offset", utc_offset_valid(offset_min));
}

pub fn verify_utc_offset_theory() -> Bool {
    // Golden: fixed offsets hold within [-720, 720].
    if utc_offset_valid(0) != 1 { return false; }
    if utc_offset_valid(utc_est_minutes()) != 1 { return false; }
    if utc_offset_valid(utc_edt_minutes()) != 1 { return false; }
    if utc_offset_valid(utc_cet_minutes()) != 1 { return false; }
    if utc_offset_valid(utc_cest_minutes()) != 1 { return false; }
    if utc_offset_valid(utc_offset_min()) != 1 { return false; }
    if utc_offset_valid(utc_offset_max()) != 1 { return false; }
    // Hostile: out-of-range offsets fail closed.
    if utc_offset_valid(utc_offset_min() - 1) != 0 { return false; }
    if utc_offset_valid(utc_offset_max() + 1) != 0 { return false; }
    if utc_offset_valid(10000) != 0 { return false; }
    if utc_offset_valid(0 - 10000) != 0 { return false; }
    // Golden: EST vs CET golden values.
    if utc_est_minutes() != 0 - 300 { return false; }
    if utc_cet_minutes() != 60 { return false; }
    // Golden: a 60-minute jump is a valid DST transition step.
    if utc_offset_jumped(utc_est_minutes(), utc_edt_minutes()) != 1 { return false; }
    if utc_offset_jumped(utc_cet_minutes(), utc_cest_minutes()) != 1 { return false; }
    // Hostile: a 0-minute jump is not a DST step.
    if utc_offset_jumped(0 - 300, 0 - 300) != 0 { return false; }
    // Hostile: a negative jump (time travel) is not a DST step.
    if utc_offset_jumped(utc_edt_minutes(), utc_est_minutes()) != 0 { return false; }
    // Hostile: a 30-minute jump is not the canonical 60-minute DST step.
    if utc_offset_jumped(0, 30) != 0 { return false; }
    // Golden: at March 13, 2022 02:00 NYC, the offset jumps by 60 within 1 minute.
    if utc_dst_step_ok(utc_est_minutes(), utc_edt_minutes(), 1) != 1 { return false; }
    // Hostile: a 70-minute jump is outside 1-minute tolerance of 60.
    if utc_dst_step_ok(0, 70, 1) != 0 { return false; }
    // Golden: domain_cert wrapper.
    let c1: DomainCert = utc_offset_holds(0 - 300);
    if c1.holds != 1 { return false; }
    if c1.domain != "time" { return false; }
    if c1.law_name != "utc_offset" { return false; }
    let c2: DomainCert = utc_offset_holds(721);
    if c2.holds != 0 { return false; }
    let c3: DomainCert = utc_offset_holds(0 - 721);
    if c3.holds != 0 { return false; }
    let c4: DomainCert = utc_offset_holds(60);
    if c4.holds != 1 { return false; }
    return true;
}
