// # Compression size-claim law
//
// Logline: Claimed decompressed size 0 with nonzero compressed input is invalid.
//
// Setup: Pure Int sizes. No codec.
//
// Beats:
//   1. compression_size_ok(4, 0) holds=0.
//   2. compression_size_ok(4, 4) holds=1.
//   3. domain_cert boxes the holds bit for the compression domain.
//
// residual: size gate only; not a decompressor

import "std/core/primitives/domain_cert.oo";
pub fn compression_size_ok(compressed: Int, decompressed: Int) -> Int {
    if compressed != 0 {
        if decompressed == 0 {
            return 0;
        }
    }
    return 1;
}

pub fn compression_size_law(compressed: Int, decompressed: Int) -> DomainCert {
    return domain_cert("compression", "size_ok", compression_size_ok(compressed, decompressed));
}
