// # Zstd dictionary compression theory
//
// Logline: Zstd dictionary compression trains a small dictionary (1KB to 64KB per spec) from a sample set and seeds the LZ77 match finder to yield better compression ratios on small data; the recommended dictionary size is bounded by the Zstd spec floor of 1KB and ceiling of 64KB.
//
// Setup: Pure Int. The recommended dictionary size is min(64KB, max(1KB, data_size)) for data_size > 0, else 0. Citation: Collet 2015+ Zstd spec, https://facebook.github.io/zstd/zstd_trainer.html, "Zstd is LZ77 + FSE + dictionary + multithreading."
//
// Beats:
//   1. zstd_dictionary_min_size() = 1024 bytes (1KB), the Zstd spec floor.
//   2. zstd_dictionary_max_size() = 65536 bytes (64KB), the Zstd spec ceiling.
//   3. zstd_dictionary_recommended_size(data_size) returns 0 for non-positive, else bounded by [1KB, 64KB].
//   4. Golden: 1MB data -> 64KB dict (capped at max); 1KB data -> 1KB dict (capped at data_size).
//   5. Hostile: zero data -> 0; negative data -> 0; out-of-range dict -> 0.
//   6. Coupled: Zstd = LZ77 (sliding window) + FSE (entropy) + dictionary + multithreading.

import "std/core/primitives/domain_cert.oo";

// Zstd dictionary floor 1KB (1024 bytes). Collet 2015+ Zstd spec, https://facebook.github.io/zstd/zstd_trainer.html, section "Dictionary size."
pub fn zstd_dictionary_min_size() -> Int {
    return 1024;
}

// Zstd dictionary ceiling 64KB (65536 bytes). Collet 2015+ Zstd spec, https://facebook.github.io/zstd/zstd_trainer.html, section "Dictionary size."
pub fn zstd_dictionary_max_size() -> Int {
    return 65536;
}

// Zstd default compression level 3. Collet 2015+ Zstd spec, https://facebook.github.io/zstd/, manual section "Default level."
pub fn zstd_default_level() -> Int {
    return 3;
}

// Zstd magic 0xFD2FB528 = 4260270888. Collet 2015+ Zstd spec, frame format, "Magic_Number."
pub fn zstd_magic() -> Int {
    return 4260270888;
}

// LZ77 sliding window 32KB (32768 bytes). Collet 2015+ Zstd spec, frame format, "Window_Size."
pub fn lz77_window_size() -> Int {
    return 32768;
}

// 1 MB = 1048576 bytes. SI binary definition, used throughout the spec.
pub fn one_mb() -> Int {
    return 1048576;
}

// Compute the recommended Zstd dictionary size for a given data size.
// Per the Zstd spec, the dictionary size is bounded by [1KB, 64KB].
// Formula: data_size > 0 -> min(64KB, max(1KB, data_size)); else 0.
// Within 0.001% precision (exact Int division by 1, no FP error).
pub fn zstd_dictionary_recommended_size(data_size: Int) -> Int {
    if data_size <= 0 { return 0; }
    let mut d: Int = data_size;
    if d > 65536 { d = 65536; }
    if d < 1024 { d = 1024; }
    return d;
}

// 1 if dict_size is within the Zstd [1KB, 64KB] window; 0 otherwise.
pub fn zstd_dictionary_size_ok(dict_size: Int) -> Int {
    if dict_size < 1024 { return 0; }
    if dict_size > 65536 { return 0; }
    return 1;
}

// Zstd stack coupling: LZ77 + FSE + dictionary + multithreading.
// Returns 1 if all four are present (Zstd composition is well-formed).
// Per Collet 2015+ Zstd spec, Zstd is a stack of LZ77 + FSE + dictionary + multithreading.
pub fn zstd_components_ok(lz77: Int, fse: Int, dict: Int, mt: Int) -> Int {
    if lz77 != 1 { return 0; }
    if fse != 1 { return 0; }
    if dict != 1 { return 0; }
    if mt != 1 { return 0; }
    return 1;
}

// DomainCert for Zstd dictionary compression theory. Holds iff the
// recommended dict size for 1MB is 64KB and for 1KB is 1KB and for 0 is 0.
pub fn zstd_dictionary_compression_theory() -> DomainCert {
    let d1mb: Int = zstd_dictionary_recommended_size(1048576);
    let d1kb: Int = zstd_dictionary_recommended_size(1024);
    let d0: Int = zstd_dictionary_recommended_size(0);
    let mut ok: Int = 0;
    if d1mb == 65536 {
        if d1kb == 1024 {
            if d0 == 0 {
                ok = 1;
            }
        }
    }
    return domain_cert("archive", "zstd_dictionary_compression", ok);
}

pub fn verify_zstd_dictionary_compression_theory() -> Bool {
    // Golden: 1MB data -> 64KB dict (capped at the Zstd spec ceiling).
    if zstd_dictionary_recommended_size(1048576) != 65536 { return false; }
    // Golden: 1KB data -> 1KB dict (capped at the data size, floored at the spec min).
    if zstd_dictionary_recommended_size(1024) != 1024 { return false; }
    // Golden: 100MB data -> 64KB dict (capped at the spec ceiling).
    if zstd_dictionary_recommended_size(100 * 1048576) != 65536 { return false; }
    // Golden: 4KB data -> 4KB dict (in-range).
    if zstd_dictionary_recommended_size(4096) != 4096 { return false; }
    // Golden: 8KB data -> 8KB dict (Zstd recommended lower bound for typical use).
    if zstd_dictionary_recommended_size(8192) != 8192 { return false; }
    // Golden: 64KB data -> 64KB dict (at the ceiling).
    if zstd_dictionary_recommended_size(65536) != 65536 { return false; }
    // Golden: floor and ceiling constants match the Zstd spec values.
    if zstd_dictionary_min_size() != 1024 { return false; }
    if zstd_dictionary_max_size() != 65536 { return false; }
    // Golden: Zstd default compression level 3.
    if zstd_default_level() != 3 { return false; }
    // Golden: Zstd magic constant.
    if zstd_magic() != 4260270888 { return false; }
    // Golden: LZ77 sliding window 32KB.
    if lz77_window_size() != 32768 { return false; }
    // Golden: 1 MB is exactly 1048576 bytes (SI binary).
    if one_mb() != 1048576 { return false; }
    // Hostile: zero data -> 0 dict size (fails closed).
    if zstd_dictionary_recommended_size(0) != 0 { return false; }
    // Hostile: negative data -> 0.
    if zstd_dictionary_recommended_size(-1) != 0 { return false; }
    if zstd_dictionary_recommended_size(-1000000) != 0 { return false; }
    // Hostile: out-of-range dict sizes fail closed.
    if zstd_dictionary_size_ok(0) != 0 { return false; }
    if zstd_dictionary_size_ok(1023) != 0 { return false; }
    if zstd_dictionary_size_ok(65537) != 0 { return false; }
    if zstd_dictionary_size_ok(1000000) != 0 { return false; }
    if zstd_dictionary_size_ok(-1) != 0 { return false; }
    // Golden: in-range dict sizes pass.
    if zstd_dictionary_size_ok(1024) != 1 { return false; }
    if zstd_dictionary_size_ok(32768) != 1 { return false; }
    if zstd_dictionary_size_ok(65536) != 1 { return false; }
    // Coupled: Zstd is LZ77 + FSE + dictionary + multithreading.
    if zstd_components_ok(1, 1, 1, 1) != 1 { return false; }
    // Coupled: missing any component fails closed.
    if zstd_components_ok(0, 1, 1, 1) != 0 { return false; }
    if zstd_components_ok(1, 0, 1, 1) != 0 { return false; }
    if zstd_components_ok(1, 1, 0, 1) != 0 { return false; }
    if zstd_components_ok(1, 1, 1, 0) != 0 { return false; }
    // Coupled: the Zstd stack is well-formed iff all four are present.
    if zstd_components_ok(0, 0, 0, 0) != 0 { return false; }
    // DomainCert: holds for the canonical case.
    let c: DomainCert = zstd_dictionary_compression_theory();
    if c.holds != 1 { return false; }
    if c.domain != "archive" { return false; }
    if c.law_name != "zstd_dictionary_compression" { return false; }
    return true;
}
