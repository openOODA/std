// # Amdahl's law for hardware multi-core speedup
//
// Logline: Maximum parallel speedup S = 1 / ((1-p) + p/n) for parallel fraction p (0..1000 milli) on n cores; Gustafson scaled speedup S = n - (1-p)(n-1) for data-size-scaled runs.
//
// Setup: Pure Int. p_milli in [0, 1000] (i.e., p in [0.0, 1.0]). n_cores >= 1. Speedup returned as fixed-point scale 1000 (so 1000 = 1.0x). Out-of-range fails closed to 0. Uses domain_cert("hw", ...).
//
// Beats:
//   1. amdahls_hw_speedup returns 1000*n / ((1000-p)*1 + p*1000/n) at scale 1000.
//   2. Gustafson: S*1000 = n*1000 - (1000-p)*(n-1).
//   3. p outside [0, 1000] or n < 1 fails closed to 0.
//   4. Non-ideal: contention fraction c (milli) reduces effective parallel work.

import "std/core/primitives/domain_cert.oo";

// Standard Amdahl speedup at fixed-point scale 1000.
//   S = 1 / ((1-p) + p/n)  with p_milli in [0, 1000].
//   S*1000 = 1000 * 1000 * n / ((1000-p_milli)*n + p_milli).
pub fn amdahls_hw_speedup(p_milli: Int, n_cores: Int) -> Int {
    if p_milli < 0 { return 0; }
    if p_milli > 1000 { return 0; }
    if n_cores < 1 { return 0; }
    let serial: Int = 1000 - p_milli;
    let denom: Int = serial * n_cores + p_milli;
    if denom <= 0 { return 0; }
    return 1000000 * n_cores / denom;
}

// Gustafson scaled speedup: S = n - (1-p)*(n-1) at fixed-point scale 1000.
// p_milli in [0, 1000], n_cores >= 1.
pub fn amdahls_hw_gustafson(p_milli: Int, n_cores: Int) -> Int {
    if p_milli < 0 { return 0; }
    if p_milli > 1000 { return 0; }
    if n_cores < 1 { return 0; }
    let serial: Int = 1000 - p_milli;
    let scaled: Int = 1000 * n_cores - serial * (n_cores - 1);
    if scaled < 0 { return 0; }
    return scaled;
}

// Non-ideal Amdahl with shared-resource contention fraction c_milli (0..1000).
// Effective speedup S = 1 / ((1-p) + p/n + c*p*(n-1)/n) at fixed-point scale 1000.
// c_milli is in milli-units of 1.0 (e.g. c_milli=100 means 10% contention per extra core).
pub fn amdahls_hw_speedup_contended(p_milli: Int, n_cores: Int, c_milli: Int) -> Int {
    if p_milli < 0 { return 0; }
    if p_milli > 1000 { return 0; }
    if n_cores < 1 { return 0; }
    if c_milli < 0 { return 0; }
    if c_milli > 1000 { return 0; }
    let serial: Int = 1000 - p_milli;
    let parallel: Int = p_milli;
    let contention: Int = c_milli * parallel * (n_cores - 1) / n_cores / 1000;
    let denom: Int = serial * n_cores + parallel + contention * n_cores;
    if denom <= 0 { return 0; }
    return 1000000 * n_cores / denom;
}

// DomainCert for the golden Amdahl HW case.
pub fn amdahls_hw_golden_cert() -> DomainCert {
    // Golden: p=0.95 (p_milli=950), n=16 -> S*1000 = 16*1000000/(50*16+950)
    //         = 16000000/1750 = 9142 (true 9.1429). Tolerance band 0.5%: 9097..9187.
    let s: Int = amdahls_hw_speedup(950, 16);
    let mut holds: Int = 0;
    if s >= 9097 { if s <= 9187 { holds = 1; } }
    return domain_cert("hw", "amdahls_hw_golden", holds);
}

// DomainCert for hostile inputs.
pub fn amdahls_hw_hostile_cert() -> DomainCert {
    let mut holds: Int = 0;
    if amdahls_hw_speedup(0 - 1, 16) == 0 {
        if amdahls_hw_speedup(1001, 16) == 0 {
            if amdahls_hw_speedup(950, 0) == 0 {
                if amdahls_hw_speedup(950, 0 - 1) == 0 {
                    if amdahls_hw_gustafson(0 - 1, 4) == 0 {
                        if amdahls_hw_gustafson(1001, 4) == 0 {
                            if amdahls_hw_gustafson(500, 0) == 0 {
                                holds = 1;
                            }
                        }
                    }
                }
            }
        }
    }
    return domain_cert("hw", "amdahls_hw_hostile", holds);
}

// DomainCert for the coupled Gustafson case.
pub fn amdahls_hw_coupled_cert() -> DomainCert {
    // Gustafson at p=0.95 (p_milli=950), n=16 -> 16*1000 - 50*15 = 16000 - 750 = 15250 (15.25x).
    let g: Int = amdahls_hw_gustafson(950, 16);
    let mut holds: Int = 0;
    if g == 15250 { holds = 1; }
    return domain_cert("hw", "amdahls_hw_coupled_gustafson", holds);
}

pub fn verify_amdahls_law_hw() -> Bool {
    // Golden: p=0 (serial only) on any n -> S*1000 = 1000 (1.0x).
    if amdahls_hw_speedup(0, 16) != 1000 { return false; }
    // Golden: p=1.0 (full parallel) -> S*1000 = 16*1000 = 16000 (16.0x).
    if amdahls_hw_speedup(1000, 16) != 16000 { return false; }
    // Golden: p=0.5, n=2 -> S*1000 = 2*1000000/1500 = 1333 (true 1.3333).
    let s_p5n2: Int = amdahls_hw_speedup(500, 2);
    if s_p5n2 < 1300 { return false; }
    if s_p5n2 > 1400 { return false; }
    // Golden: p=0.95, n=16 -> S*1000 = 9142 (true 9.1429).
    let s_p95n16: Int = amdahls_hw_speedup(950, 16);
    if s_p95n16 < 9097 { return false; }
    if s_p95n16 > 9187 { return false; }
    // Golden: speedup is non-decreasing in n for fixed p.
    let s_a: Int = amdahls_hw_speedup(750, 4);
    let s_b: Int = amdahls_hw_speedup(750, 16);
    if s_b < s_a { return false; }
    // Hostile: p<0, p>1000, n<1 all fail closed.
    if amdahls_hw_speedup(0 - 1, 16) != 0 { return false; }
    if amdahls_hw_speedup(1001, 16) != 0 { return false; }
    if amdahls_hw_speedup(950, 0) != 0 { return false; }
    if amdahls_hw_speedup(950, 0 - 1) != 0 { return false; }
    // Coupled: Gustafson at p=0.95, n=16 -> 15250 (15.25x).
    if amdahls_hw_gustafson(950, 16) != 15250 { return false; }
    // Coupled: Gustafson at p=0, n=16 -> 16000 - 1000*15 = 1000 (1.0x).
    if amdahls_hw_gustafson(0, 16) != 1000 { return false; }
    // Coupled: Gustafson at p=1.0, n=16 -> 16000 - 0 = 16000 (16.0x).
    if amdahls_hw_gustafson(1000, 16) != 16000 { return false; }
    // Coupled: Gustafson hostile inputs.
    if amdahls_hw_gustafson(0 - 1, 4) != 0 { return false; }
    if amdahls_hw_gustafson(1001, 4) != 0 { return false; }
    if amdahls_hw_gustafson(500, 0) != 0 { return false; }
    // Non-ideal: contention reduces speedup below ideal.
    let s_ideal: Int = amdahls_hw_speedup(950, 16);
    let s_cont: Int = amdahls_hw_speedup_contended(950, 16, 100);
    if s_cont > s_ideal { return false; }
    if s_cont == 0 { return false; }
    // Non-ideal: zero contention matches ideal.
    if amdahls_hw_speedup_contended(950, 16, 0) != s_ideal { return false; }
    // Certificates: golden, hostile, coupled all hold.
    let g: DomainCert = amdahls_hw_golden_cert();
    let h: DomainCert = amdahls_hw_hostile_cert();
    let cu: DomainCert = amdahls_hw_coupled_cert();
    if g.holds != 1 { return false; }
    if h.holds != 1 { return false; }
    if cu.holds != 1 { return false; }
    return true;
}
