// # Two println literals
//
// Logline: Print A then B so emit-aarch64 writes two rodata strings and two writes.
//
// Setup: Side path only. No ident binds.
//
// Beats:
//   1. Declare main.
//   2. Print A.
//   3. Print B.

pub fn verify_aarch64_multi() -> Bool {
    println("A");
    println("B");
    return true;
}
