// # AArch64 Float Lowering Helpers
//
// Logline: Tracks IEEE-754 doubles in GPRs and emits FMOV/SCVTF/FALU/FCMP for Float expressions.
//
// Setup: A64X.fp is 1 when x0 holds double bits. flt lists Float local names.
//
// Beats:
//   1. Copy the cursor with a new fp flag.
//   2. Recognize Float locals and Float struct fields.
//   3. Materialize decimal literals via SCVTF and FDIV.
//   4. Emit double ALU and FCMP on bits in x0/x1.

import "std/hw/silicon/aarch64_xstate.oo";
import "std/hw/silicon/aarch64_encoder.oo";
import "std/hw/silicon/aarch64_encode_mem.oo";
import "std/hw/silicon/aarch64_encode_fp.oo";

pub fn a64x_name_is_flt(x: A64X, nm: String) -> Bool {
    let names: List[String] = x.st.flt;
    let n: Int = list_len(names);
    let mut i: Int = n - 1;
    while i >= 0 {
        if list_get(names, i) == nm {
            return true;
        }
        i = i - 1;
    }
    return false;
}

fn a64x_x_to_d(x0: A64X, dd: Int, xn: Int) -> A64X {
    let mut x: A64X = a64x_emit(x0, arm64_word_sub_imm(31, 31, 16));
    x = a64x_emit(x, arm64_word_str(xn, 31, 0));
    x = a64x_emit(x, arm64_word_ldr_d(dd, 31, 0));
    return a64x_emit(x, arm64_word_add_imm(31, 31, 16));
}

fn a64x_d_to_x(x0: A64X, xd: Int, dn: Int) -> A64X {
    let mut x: A64X = a64x_emit(x0, arm64_word_sub_imm(31, 31, 16));
    x = a64x_emit(x, arm64_word_str_d(dn, 31, 0));
    x = a64x_emit(x, arm64_word_ldr(xd, 31, 0));
    return a64x_emit(x, arm64_word_add_imm(31, 31, 16));
}

fn a64x_ieee_pos(num: Int, den: Int) -> Int {
    if num == 0 || den == 0 {
        return 0;
    }
    let mut n: Int = num;
    let mut d: Int = den;
    let mut exp: Int = 0;
    while n < d {
        n = n + n;
        exp = exp - 1;
    }
    while n >= d + d {
        d = d + d;
        exp = exp + 1;
    }
    let mut r: Int = n - d;
    let mut mant: Int = 0;
    let mut i: Int = 0;
    while i < 52 {
        r = r + r;
        mant = mant + mant;
        if r >= d {
            mant = mant + 1;
            r = r - d;
        }
        i = i + 1;
    }
    r = r + r;
    if r >= d {
        mant = mant + 1;
    }
    return ((exp + 1023) << 52) | mant;
}

pub fn a64x_emit_f64(x0: A64X, ip: Int, frac: Int, scale: Int) -> A64X {
    let bits: Int = (0 + a64x_ieee_pos(ip * scale + frac, scale));
    let mut x: A64X = a64x_emit(x0, arm64_word_movz(0, bits & 65535, 0));
    x = a64x_emit(x, arm64_word_movk(0, (bits >> 16) & 65535, 1));
    x = a64x_emit(x, arm64_word_movk(0, (bits >> 32) & 65535, 2));
    x = a64x_emit(x, arm64_word_movk(0, (bits >> 48) & 65535, 3));
    return a64x_with_fp(x, 1);
}

pub fn a64x_fbinop(x0: A64X, b: Int) -> A64X {
    let mut x: A64X = a64x_x_to_d(x0, 1, 1);
    x = a64x_x_to_d(x, 0, 0);
    if b == 43 {
        x = a64x_emit(x, arm64_word_fadd_d(0, 1, 0));
    } else {
        if b == 45 {
            x = a64x_emit(x, arm64_word_fsub_d(0, 1, 0));
        } else {
            if b == 42 {
                x = a64x_emit(x, arm64_word_fmul_d(0, 1, 0));
            } else {
                x = a64x_emit(x, arm64_word_fdiv_d(0, 1, 0));
            }
        }
    }
    x = a64x_d_to_x(x, 0, 0);
    return a64x_with_fp(x, 1);
}

pub fn a64x_ibinop(x0: A64X, b: Int) -> A64X {
    let mut x: A64X = x0;
    if b == 43 { x = a64x_emit(x, arm64_word_add_reg(0, 1, 0)); } else {
        if b == 45 { x = a64x_emit(x, arm64_word_sub_reg(0, 1, 0)); } else {
            if b == 42 { x = a64x_emit(x, arm64_word_mul(0, 1, 0)); } else {
                if b == 47 { x = a64x_emit(x, arm64_word_sdiv(0, 1, 0)); } else {
                    if b == 37 {
                        x = a64x_emit(x, arm64_word_sdiv(2, 1, 0));
                        x = a64x_emit(x, arm64_word_msub(0, 2, 0, 1));
                    } else {
                        if b == 38 { x = a64x_emit(x, arm64_word_and_reg(0, 1, 0)); } else {
                            if b == 124 { x = a64x_emit(x, arm64_word_orr_reg(0, 1, 0)); } else {
                                if b == 60 { x = a64x_emit(x, arm64_word_lsl_reg(0, 1, 0)); } else {
                                    if b == 62 { x = a64x_emit(x, arm64_word_lsr_reg(0, 1, 0)); } else {
                                        x = a64x_emit(x, arm64_word_eor_reg(0, 1, 0));
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return a64x_with_fp(x, 0);
}

pub fn a64x_fneg_x0(x0: A64X) -> A64X {
    let mut x: A64X = a64x_x_to_d(x0, 0, 0);
    x = a64x_emit(x, arm64_word_fneg_d(0, 0));
    x = a64x_d_to_x(x, 0, 0);
    return a64x_with_fp(x, 1);
}

pub fn a64x_fcmp(x0: A64X) -> A64X {
    let mut x: A64X = a64x_x_to_d(x0, 1, 1);
    x = a64x_x_to_d(x, 0, 0);
    return a64x_emit(x, arm64_word_fcmp_d(1, 0));
}
