// # AArch64 Pattern Match And Condition Selection
//
// Logline: Lowers rich pattern matching and conditional boolean expressions to AArch64 words.
//
// Setup: Match evaluates target to discriminant in x0 and payload in x1, spilled to tmp_res.
//
// Beats:
//   1. Lower multi-arm match dispatch with cmp x0, #tag and b.ne chain.
//   2. Bind pattern payloads (Ok, Err, Some, None, _) with correct types.
//   3. Lower block statement arms and expression arms to x0.
//   4. Backpatch unconditional jumps to match_end.

import "std/hw/silicon/aarch64_parse.oo";
import "std/hw/silicon/aarch64_encoder.oo";
import "std/hw/silicon/aarch64_encode_mem.oo";
import "std/hw/silicon/aarch64_abi.oo";
import "std/hw/silicon/aarch64_regs.oo";
import "std/hw/silicon/aarch64_xstate.oo";
import "std/hw/silicon/aarch64_xscan.oo";
import "std/hw/silicon/aarch64_xfn.oo";
import "std/hw/silicon/aarch64_xexpr.oo";
import "std/hw/silicon/aarch64_xterm.oo";
import "std/hw/silicon/aarch64_xfloat.oo";
import "std/hw/silicon/aarch64_xmark.oo";

fn a64x_arm_let(x0: A64X) -> A64X {
    let mut x: A64X = a64x_skip(a64x_from_p(a64_eat_kw(a64x_as_p(x0), "let"), x0));
    if a64_starts(a64x_as_p(x), "mut") { x = a64x_from_p(a64_eat_kw(a64x_as_p(x), "mut"), x); }
    x = a64x_from_p(a64_ident(a64x_as_p(x)), x);
    let nm: String = x.p.text;
    x = a64x_skip(x);
    let mut tyfp: Int = 0; let mut tyn: String = ""; let mut islf: Int = 0;
    if a64_peek(a64x_as_p(x)) == 58 {
        x = a64x_eat_type(a64x_from_p(a64_eat(a64x_as_p(x), 58), x));
        tyn = x.p.text; islf = x.p.ival;
        if tyn == "Float" { tyfp = 1; }
        if tyn == "String" { tyfp = 2; }
        if tyn == "Result" || tyn == "Option" { tyfp = 3; }
    }
    x = a64x_cond(a64x_from_p(a64_eat(a64x_as_p(x), 61), x));
    if tyfp == 1 { x = a64x_with_fp(x, 1); }
    if tyfp == 2 || x.st.fp == 2 { x = a64x_with_fp(x, 2); }
    if tyfp == 3 { x = a64x_with_fp(x, 3); }
    if tyfp == 0 && (tyn == "Int" || tyn == "Bool") { x = a64x_with_fp(x, 0); }
    x = a64x_from_p(a64_eat(a64x_as_p(x), 59), x);
    let hit: Int = (0 + a64_lookup_parse(x.p.names, x.p.offs, nm));
    if hit >= 0 {
        x = a64x_store_pair(x, hit);
        if x.st.fp == 2 { x = a64x_mark_str(x, nm); }
        if x.st.fp == 3 {
            x = a64x_mark_res(x, nm);
            let inn: String = a64x_last_inner(x); if bytes_len(inn) > 0 { x = a64x_mark_ok(x, nm, inn); }
            let err_ty: String = a64x_last_err(x); if bytes_len(err_ty) > 0 { x = a64x_mark_err(x, nm, err_ty); }
        }
        if bytes_len(tyn) > 0 && tyn != "Float" && tyn != "String" && tyn != "Result" && tyn != "Option" && tyn != "Int" && tyn != "Bool" { x = a64x_mark_ty(x, nm, tyn); }
        if tyn == "List" && islf == 1 { x = a64x_mark_str(x, "LF:" + nm); }
        return x;
    }
    x = a64x_bind16(x, nm);
    if x.st.fp == 2 { x = a64x_mark_str(x, nm); }
    if x.st.fp == 3 {
        x = a64x_mark_res(x, nm);
        let inn2: String = a64x_last_inner(x); if bytes_len(inn2) > 0 { x = a64x_mark_ok(x, nm, inn2); }
        let err2: String = a64x_last_err(x); if bytes_len(err2) > 0 { x = a64x_mark_err(x, nm, err2); }
    }
    if bytes_len(tyn) > 0 && tyn != "Float" && tyn != "String" && tyn != "Result" && tyn != "Option" && tyn != "Int" && tyn != "Bool" { x = a64x_mark_ty(x, nm, tyn); }
    if tyn == "List" && islf == 1 { x = a64x_mark_str(x, "LF:" + nm); }
    return a64x_store_pair(x, x.p.ival);
}

fn a64x_arm_if(x0: A64X) -> A64X {
    let mut x: A64X = a64x_from_p(a64_eat_kw(a64x_as_p(x0), "if"), x0);
    x = a64x_cond(x);
    x = a64x_emit(x, arm64_word_cmp_reg(0, 31));
    let br: Int = list_len(x.p.words);
    x = a64x_arm_stmts(a64x_from_p(a64_eat(a64x_as_p(a64x_emit(x, arm64_word_b_cond(arm64_cond_eq(), 0))), 123), x));
    x = a64x_skip(a64x_from_p(a64_eat(a64x_as_p(x), 125), x));
    if a64_starts(a64x_as_p(x), "else") {
        x = a64x_from_p(a64_eat_kw(a64x_as_p(x), "else"), x);
        let jmp: Int = list_len(x.p.words);
        x = a64x_emit(x, arm64_word_b(0));
        let offn: Int = list_len(x.p.words) - br;
        x = a64x_skip(a64x_set_words(x, a64_wset(x.p.words, br, arm64_word_b_cond(arm64_cond_eq(), offn))));
        if a64_starts(a64x_as_p(x), "if") { x = a64x_arm_if(x); } else {
            x = a64x_from_p(a64_eat(a64x_as_p(a64x_arm_stmts(a64x_from_p(a64_eat(a64x_as_p(x), 123), x))), 125), x);
        }
        let offj: Int = list_len(x.p.words) - jmp;
        return a64x_set_words(x, a64_wset(x.p.words, jmp, arm64_word_b(offj)));
    }
    let off: Int = list_len(x.p.words) - br;
    return a64x_set_words(x, a64_wset(x.p.words, br, arm64_word_b_cond(arm64_cond_eq(), off)));
}

fn a64x_arm_stmt(x0: A64X) -> A64X {
    let x: A64X = a64x_skip(x0);
    if a64_starts(a64x_as_p(x), "let") { return a64x_arm_let(x); }
    if a64_starts(a64x_as_p(x), "match") { return a64x_match_core(x); }
    if a64_starts(a64x_as_p(x), "if") { return a64x_arm_if(x); }
    if a64_starts(a64x_as_p(x), "println") {
        let mut p: A64X = a64x_cond(a64x_from_p(a64_eat(a64x_as_p(a64x_from_p(a64_eat_kw(a64x_as_p(x), "println"), x)), 40), x));
        p = a64x_from_p(a64_eat(a64x_as_p(p), 41), p);
        if a64_peek(a64x_as_p(p)) == 59 { p = a64x_from_p(a64_eat(a64x_as_p(p), 59), p); }
        return a64x_bl(p, "__puts");
    }
    if a64_starts(a64x_as_p(x), "process_exit") {
        let mut p: A64X = a64x_cond(a64x_from_p(a64_eat(a64x_as_p(a64x_from_p(a64_eat_kw(a64x_as_p(x), "process_exit"), x)), 40), x));
        p = a64x_from_p(a64_eat(a64x_as_p(p), 41), p);
        if a64_peek(a64x_as_p(p)) == 59 { p = a64x_from_p(a64_eat(a64x_as_p(p), 59), p); }
        return a64x_emit(a64x_emit(p, arm64_word_movz(abi_sys_reg(), 93, 0)), arm64_word_svc(0));
    }
    let b0: Int = a64_peek(a64x_as_p(x));
    if a64_is_alpha(b0) {
        let mut z: A64X = a64x_from_p(a64_ident(a64x_as_p(x)), x);
        let nm: String = z.p.text;
        z = a64x_skip(z);
        if a64_peek(a64x_as_p(z)) == 61 {
            z = a64x_from_p(a64_eat(a64x_as_p(a64x_cond(a64x_from_p(a64_eat(a64x_as_p(z), 61), z))), 59), z);
            let off2: Int = (0 + a64_lookup_parse(z.p.names, z.p.offs, nm));
            if off2 < 0 { return a64x_fail(z, "ERR\ta64x_assign"); }
            return a64x_store_pair(z, off2);
        }
    }
    let mut e: A64X = a64x_cond(x);
    e = a64x_skip(e);
    if a64_peek(a64x_as_p(e)) == 59 { e = a64x_from_p(a64_eat(a64x_as_p(e), 59), e); }
    return e;
}

fn a64x_arm_stmts(x0: A64X) -> A64X {
    let mut x: A64X = x0; let mut n: Int = 0;
    while x.st.err == "" {
        n = n + 1;
        if n > 8000 { return a64x_fail(x, "ERR\ta64x_arm_stmts\tloop"); }
        x = a64x_skip(x);
        let b: Int = a64_peek(a64x_as_p(x));
        if b == 125 || b < 0 { return x; }
        let i0: Int = x.p.i;
        x = a64x_arm_stmt(x);
        if x.st.err == "" && x.p.i <= i0 { return a64x_fail(x, "ERR\ta64x_arm_stmts\tno_advance"); }
    }
    return x;
}

pub fn a64x_match_core(x0: A64X) -> A64X {
    let mut x: A64X = a64x_from_p(a64_eat_kw(a64x_as_p(x0), "match"), x0);
    x = a64x_cond(x);
    let srcn: String = x.p.text;
    x = a64x_emit(x, arm64_word_str(0, abi_fp_reg(), a64x_tmp_cond()));
    x = a64x_emit(x, arm64_word_str(1, abi_fp_reg(), a64x_tmp_res()));
    let mut ok_pty: String = a64x_ok_ty(x, srcn);
    if bytes_len(ok_pty) == 0 { ok_pty = a64x_ret_ok_ty(x, srcn); }
    if bytes_len(ok_pty) == 0 { ok_pty = a64x_last_inner(x); }
    let mut err_pty: String = a64x_err_ty(x, srcn);
    if bytes_len(err_pty) == 0 { err_pty = a64x_ret_err_ty(x, srcn); }
    if bytes_len(err_pty) == 0 { err_pty = a64x_last_err(x); }
    x = a64x_from_p(a64_eat(a64x_as_p(x), 123), x);
    let mut end_jmps: List[Int] = list_new();
    let mut arm_idx: Int = 0;
    while x.st.err == "" {
        x = a64x_skip(x);
        let b: Int = a64_peek(a64x_as_p(x));
        if b == 125 || b < 0 { break; }
        x = a64x_from_p(a64_ident(a64x_as_p(x)), x);
        let pat: String = x.p.text;
        let mut expected_tag: Int = arm_idx;
        let mut has_param: Bool = false;
        let mut pty: String = "";
        if pat == "Ok" || pat == "Some" { expected_tag = 0; has_param = true; pty = ok_pty; }
        if pat == "Err" { expected_tag = 1; has_param = true; pty = err_pty; }
        if pat == "None" { expected_tag = 1; has_param = false; }
        if pat == "_" { expected_tag = -1; has_param = false; }
        let mut bind_nm: String = "";
        x = a64x_skip(x);
        if has_param || a64_peek(a64x_as_p(x)) == 40 {
            x = a64x_from_p(a64_eat(a64x_as_p(x), 40), x);
            x = a64x_from_p(a64_ident(a64x_as_p(x)), x);
            bind_nm = x.p.text;
            x = a64x_from_p(a64_eat(a64x_as_p(x), 41), x);
        }
        x = a64x_from_p(a64_eat(a64x_as_p(x), 61), x);
        x = a64x_from_p(a64_eat(a64x_as_p(x), 62), x);
        let mut br_next: Int = -1;
        if expected_tag >= 0 {
            x = a64x_emit(x, arm64_word_ldr(0, abi_fp_reg(), a64x_tmp_cond()));
            if expected_tag == 0 { x = a64x_emit(x, arm64_word_cmp_reg(0, 31)); } else { x = a64x_emit(x, arm64_word_movz(2, expected_tag, 0)); x = a64x_emit(x, arm64_word_cmp_reg(0, 2)); }
            let br: Int = list_len(x.p.words);
            br_next = br;
            x = a64x_emit(x, arm64_word_b_cond(arm64_cond_ne(), 0));
        }
        if bytes_len(bind_nm) > 0 {
            x = a64x_bind16(x, bind_nm);
            if bytes_len(pty) > 0 {
                x = a64x_mark_ty(x, bind_nm, pty);
                if pty == "String" { x = a64x_mark_str(x, bind_nm); }
                if pty == "Float" { x = a64x_mark_flt(x, bind_nm); }
                if pty == "Result" || pty == "Option" { x = a64x_mark_res(x, bind_nm); }
            }
            x = a64x_store_pair(a64x_emit(x, arm64_word_ldr(0, abi_fp_reg(), a64x_tmp_res())), x.p.ival);
        }
        x = a64x_skip(x);
        if a64_peek(a64x_as_p(x)) == 123 {
            x = a64x_arm_stmts(a64x_from_p(a64_eat(a64x_as_p(x), 123), x));
            x = a64x_from_p(a64_eat(a64x_as_p(x), 125), x);
        } else {
            x = a64x_cond(x);
        }
        let jmp_end: Int = list_len(x.p.words);
        x = a64x_emit(x, arm64_word_b(0));
        end_jmps = list_push(end_jmps, jmp_end);
        if br_next >= 0 {
            let off_next: Int = list_len(x.p.words) - br_next;
            x = a64x_set_words(x, a64_wset(x.p.words, br_next, arm64_word_b_cond(arm64_cond_ne(), off_next)));
        }
        x = a64x_skip(x);
        if a64_peek(a64x_as_p(x)) == 44 { x = a64x_from_p(a64_eat(a64x_as_p(x), 44), x); }
        arm_idx = arm_idx + 1;
    }
    x = a64x_from_p(a64_eat(a64x_as_p(x), 125), x);
    let n_jmps: Int = list_len(end_jmps);
    let mut k: Int = 0;
    while k < n_jmps {
        let j: Int = list_get(end_jmps, k);
        let off_end: Int = list_len(x.p.words) - j;
        x = a64x_set_words(x, a64_wset(x.p.words, j, arm64_word_b(off_end)));
        k = k + 1;
    }
    return x;
}

pub fn a64x_cond(x0: A64X) -> A64X {
    let mut x: A64X = a64x_skip(x0);
    if a64_starts(a64x_as_p(x), "match") { return a64x_match_core(x); }
    return a64x_expr(x);
}
