// # X86 Float
//
// Logline: Standard library verification and domain capabilities for X86 Float.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn verify_x86_float() -> Bool {
    let mut x: Float = 10.5;
    let mut y: Float = 2.0;
    let mut z: Float = x * y + 1.0;
    println(z);
    return true;
}
