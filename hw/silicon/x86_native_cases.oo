pub fn qx_link_concat() -> List[Int] {
    let base: Int = elf64_default_base();
    let s: String = "Hi OODA!\n";
    let ro: List[Int] = qx_bytes_of(s);
    let len: Int = chars_len(s);
    let mut text: List[Int] = list_new();
