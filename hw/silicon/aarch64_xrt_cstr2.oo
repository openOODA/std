// # AArch64 C-String Slice And Search
//
// Logline: Emits str_slice, str_index_of, str_replace, char_is_alpha, and char_is_space.
//
// Setup: Follows a64rt_cstr. Slice copies onto the bump heap; replace loops index_of plus concat.
//
// Beats:
//   1. str_slice clamps start/end and copies [start, end) plus a NUL.
//   2. str_index_of is a naive scan returning the first index or -1.
//   3. str_replace rebuilds the string by slicing around each hit.
//   4. char_is_alpha tests A-Z/a-z; char_is_space tests SP/TAB/LF/CR.

import "std/hw/silicon/aarch64_encoder.oo";
import "std/hw/silicon/aarch64_encode_mem.oo";
import "std/hw/silicon/aarch64_parse.oo";
import "std/hw/silicon/aarch64_xstate.oo";
import "std/hw/silicon/aarch64_xexpr.oo";
import "std/hw/silicon/aarch64_xrt.oo";
import "std/hw/silicon/aarch64_xrt_cstr3.oo";

fn a64rt_slice(r0: A64R) -> A64R {
    let mut r: A64R = a64rt_fn(r0, "str_slice");
    let mut x: A64X = a64rt_prol(r.x);
    x = a64x_emit(x, arm64_word_mov_reg(9, 0));
    x = a64x_emit(x, arm64_word_mov_reg(10, 1));
    x = a64x_emit(x, arm64_word_mov_reg(11, 2));
    x = a64x_emit(x, arm64_word_cmp_reg(10, 31));
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_ge(), 2));
    x = a64x_emit(x, arm64_word_movz(10, 0, 0));
    x = a64x_emit(x, arm64_word_mov_reg(0, 9));
    x = a64x_bl(x, "__strlen");
    x = a64x_emit(x, arm64_word_mov_reg(12, 0));
    x = a64x_emit(x, arm64_word_cmp_reg(11, 12));
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_le(), 2));
    x = a64x_emit(x, arm64_word_mov_reg(11, 12));
    x = a64x_emit(x, arm64_word_cmp_reg(11, 10));
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_ge(), 2));
    x = a64x_emit(x, arm64_word_mov_reg(11, 10));
    x = a64x_emit(x, arm64_word_sub_reg(13, 11, 10));
    x = a64x_emit(x, arm64_word_add_imm(14, 13, 1));
    x = a64x_emit(x, arm64_word_mov_reg(15, 28));
    x = a64x_emit(x, arm64_word_add_reg(28, 28, 14));
    x = a64x_emit(x, arm64_word_movz(14, 0, 0));
    let lp: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_cmp_reg(14, 13));
    let bd: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_eq(), 0));
    x = a64x_emit(x, arm64_word_add_reg(1, 10, 14));
    x = a64x_emit(x, arm64_word_ldrb_reg(2, 9, 1));
    x = a64x_emit(x, arm64_word_strb_reg(2, 15, 14));
    x = a64x_emit(x, arm64_word_add_imm(14, 14, 1));
    let bb: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b(lp - bb));
    let done: Int = list_len(x.p.words);
    x = a64x_set_words(x, a64_wset(x.p.words, bd, arm64_word_b_cond(arm64_cond_eq(), done - bd)));
    x = a64x_emit(x, arm64_word_add_reg(1, 15, 13));
    x = a64x_emit(x, arm64_word_strb_reg(31, 1, 31));
    x = a64x_emit(x, arm64_word_mov_reg(0, 15));
    return a64rt_setx(r, a64rt_epi(x));
}

fn a64rt_index_of(r0: A64R) -> A64R {
    let mut r: A64R = a64rt_fn(r0, "str_index_of");
    let mut x: A64X = a64rt_prol(r.x);
    x = a64x_emit(x, arm64_word_mov_reg(9, 0));
    x = a64x_emit(x, arm64_word_mov_reg(10, 1));
    x = a64x_emit(x, arm64_word_mov_reg(0, 10));
    x = a64x_bl(x, "__strlen");
    x = a64x_emit(x, arm64_word_mov_reg(12, 0));
    x = a64x_emit(x, arm64_word_mov_reg(0, 9));
    x = a64x_bl(x, "__strlen");
    x = a64x_emit(x, arm64_word_mov_reg(11, 0));
    x = a64x_emit(x, arm64_word_cmp_reg(12, 31));
    let bemp: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_eq(), 0));
    x = a64x_emit(x, arm64_word_movz(13, 0, 0));
    let outer: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_add_reg(2, 13, 12));
    x = a64x_emit(x, arm64_word_cmp_reg(2, 11));
    let bgt: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_gt(), 0));
    x = a64x_emit(x, arm64_word_movz(14, 0, 0));
    let inner: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_cmp_reg(14, 12));
    let bhit: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_eq(), 0));
    x = a64x_emit(x, arm64_word_add_reg(2, 13, 14));
    x = a64x_emit(x, arm64_word_ldrb_reg(3, 9, 2));
    x = a64x_emit(x, arm64_word_ldrb_reg(4, 10, 14));
    x = a64x_emit(x, arm64_word_cmp_reg(3, 4));
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_ne(), 3));
    x = a64x_emit(x, arm64_word_add_imm(14, 14, 1));
    let binn: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b(inner - binn));
    x = a64x_emit(x, arm64_word_add_imm(13, 13, 1));
    let bout: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b(outer - bout));
    let no: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_movz(0, 1, 0));
    x = a64x_emit(x, arm64_word_neg(0, 0));
    let jmp: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b(0));
    let yes: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_mov_reg(0, 13));
    let jyes: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b(0));
    let zidx: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_movz(0, 0, 0));
    let endc: Int = list_len(x.p.words);
    x = a64x_set_words(x, a64_wset(x.p.words, bemp, arm64_word_b_cond(arm64_cond_eq(), zidx - bemp)));
    x = a64x_set_words(x, a64_wset(x.p.words, bgt, arm64_word_b_cond(arm64_cond_gt(), no - bgt)));
    x = a64x_set_words(x, a64_wset(x.p.words, bhit, arm64_word_b_cond(arm64_cond_eq(), yes - bhit)));
    x = a64x_set_words(x, a64_wset(x.p.words, jmp, arm64_word_b(endc - jmp)));
    x = a64x_set_words(x, a64_wset(x.p.words, jyes, arm64_word_b(endc - jyes)));
    return a64rt_setx(r, a64rt_epi(x));
}

pub fn a64rt_cstr2(r0: A64R) -> A64R {
    let mut r: A64R = a64rt_slice(r0);
    r = a64rt_index_of(r);
    return a64rt_cstr3(r);
}
