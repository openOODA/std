// # AArch64 SHA-256 W Extend
//
// Logline: Fills W[16..63] using sigma0 of W[i-15] and sigma1 of W[i-2].
//
// Setup: W pointer in x0. Each slot is 8 bytes. Calls __sha_rotr.
//
// Beats:
//   1. Load W[i-15] and form sigma0 = rotr7 xor rotr18 xor shr3.
//   2. Load W[i-2] and form sigma1 = rotr17 xor rotr19 xor shr10.
//   3. W[i] = W[i-16] + sigma0 + W[i-7] + sigma1 masked to 32 bits.
//   4. Repeat from i=16 to i=63.

import "std/hw/silicon/aarch64_encoder.oo";
import "std/hw/silicon/aarch64_encode_mem.oo";
import "std/hw/silicon/aarch64_parse.oo";
import "std/hw/silicon/aarch64_xstate.oo";
import "std/hw/silicon/aarch64_xrt.oo";
import "std/hw/silicon/aarch64_xrt_sha256s.oo";

fn a64rt_slot(x0: A64X, base_off: Int, idx_delta: Int) -> A64X {
    let mut x: A64X = a64x_emit(x0, arm64_word_ldr(11, 31, 8));
    x = a64x_emit(x, arm64_word_sub_imm(2, 11, idx_delta));
    x = a64x_emit(x, arm64_word_movz(3, 3, 0));
    x = a64x_emit(x, arm64_word_lsl_reg(2, 2, 3));
    x = a64x_emit(x, arm64_word_ldr(3, 31, 0));
    x = a64x_emit(x, arm64_word_add_reg(2, 3, 2));
    return a64x_emit(x, arm64_word_ldr(0, 2, 0));
}

pub fn a64rt_sha256q(r0: A64R) -> A64R {
    let mut r: A64R = a64rt_fn(r0, "__sha_wext");
    let mut x: A64X = a64rt_prol(r.x);
    x = a64x_emit(x, arm64_word_sub_imm(31, 31, 32));
    x = a64x_emit(x, arm64_word_str(0, 31, 0));
    x = a64x_emit(x, arm64_word_movz(0, 16, 0));
    x = a64x_emit(x, arm64_word_str(0, 31, 8));
    let lp: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_ldr(11, 31, 8));
    x = a64x_emit(x, arm64_word_movz(0, 64, 0));
    x = a64x_emit(x, arm64_word_cmp_reg(11, 0));
    let bd: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_eq(), 0));
    x = a64rt_slot(x, 0, 15);
    x = a64x_emit(x, arm64_word_str(0, 31, 16));
    x = a64x_emit(x, arm64_word_movz(1, 7, 0));
    x = a64x_bl(x, "__sha_rotr");
    x = a64x_emit(x, arm64_word_mov_reg(10, 0));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 16));
    x = a64x_emit(x, arm64_word_movz(1, 18, 0));
    x = a64x_bl(x, "__sha_rotr");
    x = a64x_emit(x, arm64_word_eor_reg(10, 10, 0));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 16));
    x = a64x_emit(x, arm64_word_movz(1, 3, 0));
    x = a64x_emit(x, arm64_word_lsr_reg(0, 0, 1));
    x = a64x_emit(x, arm64_word_eor_reg(10, 10, 0));
    x = a64x_emit(x, arm64_word_str(10, 31, 24));
    x = a64rt_slot(x, 0, 2);
    x = a64x_emit(x, arm64_word_str(0, 31, 16));
    x = a64x_emit(x, arm64_word_movz(1, 17, 0));
    x = a64x_bl(x, "__sha_rotr");
    x = a64x_emit(x, arm64_word_mov_reg(10, 0));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 16));
    x = a64x_emit(x, arm64_word_movz(1, 19, 0));
    x = a64x_bl(x, "__sha_rotr");
    x = a64x_emit(x, arm64_word_eor_reg(10, 10, 0));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 16));
    x = a64x_emit(x, arm64_word_movz(1, 10, 0));
    x = a64x_emit(x, arm64_word_lsr_reg(0, 0, 1));
    x = a64x_emit(x, arm64_word_eor_reg(10, 10, 0));
    x = a64rt_slot(x, 0, 16);
    x = a64x_emit(x, arm64_word_add_reg(0, 0, 10));
    x = a64x_emit(x, arm64_word_ldr(1, 31, 24));
    x = a64x_emit(x, arm64_word_add_reg(0, 0, 1));
    x = a64x_emit(x, arm64_word_str(0, 31, 16));
    x = a64rt_slot(x, 0, 7);
    x = a64x_emit(x, arm64_word_ldr(1, 31, 16));
    x = a64x_emit(x, arm64_word_add_reg(0, 0, 1));
    x = a64x_emit(x, arm64_word_movz(2, 65535, 0));
    x = a64x_emit(x, arm64_word_movk(2, 65535, 1));
    x = a64x_emit(x, arm64_word_and_reg(0, 0, 2));
    x = a64x_emit(x, arm64_word_ldr(11, 31, 8));
    x = a64x_emit(x, arm64_word_movz(3, 3, 0));
    x = a64x_emit(x, arm64_word_lsl_reg(2, 11, 3));
    x = a64x_emit(x, arm64_word_ldr(3, 31, 0));
    x = a64x_emit(x, arm64_word_add_reg(2, 3, 2));
    x = a64x_emit(x, arm64_word_str(0, 2, 0));
    x = a64x_emit(x, arm64_word_add_imm(11, 11, 1));
    x = a64x_emit(x, arm64_word_str(11, 31, 8));
    let bb: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b(lp - bb));
    let done: Int = list_len(x.p.words);
    x = a64x_set_words(x, a64_wset(x.p.words, bd, arm64_word_b_cond(arm64_cond_eq(), done - bd)));
    x = a64x_emit(x, arm64_word_add_imm(31, 31, 32));
    r = a64rt_setx(r, a64rt_epi(x));
    return a64rt_sha256s(r);
}
