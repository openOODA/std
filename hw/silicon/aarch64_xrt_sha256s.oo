// # AArch64 SHA-256 H Copy Add And Rounds Hook
//
// Logline: Copies H into work, adds work into H, and enters the 64-round mixer.
//
// Setup: Eight 8-byte slots. 32-bit adds masked. Rounds live in sha256t.
//
// Beats:
//   1. __sha_hcopy copies eight words from H to work.
//   2. __sha_hadd adds eight work words into H.
//   3. Both loops use a 32-bit mask.
//   4. HMAC and rounds continue in sha256t.

import "std/hw/silicon/aarch64_encoder.oo";
import "std/hw/silicon/aarch64_encode_mem.oo";
import "std/hw/silicon/aarch64_parse.oo";
import "std/hw/silicon/aarch64_xstate.oo";
import "std/hw/silicon/aarch64_xrt.oo";
import "std/hw/silicon/aarch64_xrt_sha256t.oo";

fn a64rt_h8(r0: A64R, nm: String, add: Int) -> A64R {
    let mut r: A64R = a64rt_fn(r0, nm);
    let mut x: A64X = a64rt_prol(r.x);
    x = a64x_emit(x, arm64_word_mov_reg(9, 0));
    x = a64x_emit(x, arm64_word_mov_reg(10, 1));
    x = a64x_emit(x, arm64_word_movz(11, 0, 0));
    let lp: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_movz(0, 8, 0));
    x = a64x_emit(x, arm64_word_cmp_reg(11, 0));
    let bd: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_eq(), 0));
    x = a64x_emit(x, arm64_word_movz(2, 3, 0));
    x = a64x_emit(x, arm64_word_lsl_reg(2, 11, 2));
    x = a64x_emit(x, arm64_word_add_reg(3, 9, 2));
    x = a64x_emit(x, arm64_word_add_reg(4, 10, 2));
    if add == 1 {
        x = a64x_emit(x, arm64_word_ldr(0, 4, 0));
        x = a64x_emit(x, arm64_word_ldr(1, 3, 0));
        x = a64x_emit(x, arm64_word_add_reg(0, 0, 1));
        x = a64x_emit(x, arm64_word_movz(1, 65535, 0));
        x = a64x_emit(x, arm64_word_movk(1, 65535, 1));
        x = a64x_emit(x, arm64_word_and_reg(0, 0, 1));
        x = a64x_emit(x, arm64_word_str(0, 3, 0));
    } else {
        x = a64x_emit(x, arm64_word_ldr(0, 3, 0));
        x = a64x_emit(x, arm64_word_str(0, 4, 0));
    }
    x = a64x_emit(x, arm64_word_add_imm(11, 11, 1));
    let bb: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b(lp - bb));
    let done: Int = list_len(x.p.words);
    x = a64x_set_words(x, a64_wset(x.p.words, bd, arm64_word_b_cond(arm64_cond_eq(), done - bd)));
    return a64rt_setx(r, a64rt_epi(x));
}

pub fn a64rt_sha256s(r0: A64R) -> A64R {
    let mut r: A64R = a64rt_h8(r0, "__sha_hcopy", 0);
    r = a64rt_h8(r, "__sha_hadd", 1);
    return a64rt_sha256t(r);
}
