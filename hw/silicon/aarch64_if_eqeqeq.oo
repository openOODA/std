// # if 1 == 1 == 0 is leftover
//
// Logline: A chained == after INT==INT must fail closed.
//
// Setup: Folded INT==INT requires LBRACE next.
//
// Beats:
//   1. if 1 == 1 == 0 print THEN.
//   2. Emit must ERR leftover.
//   3. No _start.

pub fn verify_aarch64_if_eqeqeq() -> Bool {
    if 1 == 1 == 0 {
        println("THEN");
    }
    return true;
}
