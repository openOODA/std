// # AArch64 Comparisons If-Expressions And Concat Selection
//
// Logline: Wraps terms with if-expressions, relops, and || / && so if/while/let see a 0/1 or value in x0.
//
// Setup: Terms, calls, and ALU live in xterm. Integer / is already SDIV; string + is __concat.
//
// Beats:
//   1. Lower if-expressions with else so both arms leave a value in x0.
//   2. Materialize relops as 0/1 via inverted B.cond after saving the left.
//   3. Chain || as ORR and && as AND of those booleans.
//   4. Evaluate boolean negation and parenthesized expressions.

import "std/hw/silicon/aarch64_parse.oo";
import "std/hw/silicon/aarch64_encoder.oo";
import "std/hw/silicon/aarch64_encode_mem.oo";
import "std/hw/silicon/aarch64_abi.oo";
import "std/hw/silicon/aarch64_regs.oo";
import "std/hw/silicon/aarch64_xstate.oo";
import "std/hw/silicon/aarch64_xfn.oo";
import "std/hw/silicon/aarch64_xexpr.oo";
import "std/hw/silicon/aarch64_xterm.oo";
import "std/hw/silicon/aarch64_xfloat.oo";
import "std/hw/silicon/aarch64_xmark.oo";

fn a64x_if_expr(x0: A64X) -> A64X {
    let mut x: A64X = a64x_from_p(a64_eat_kw(a64x_as_p(x0), "if"), x0);
    x = a64x_expr(x);
    x = a64x_emit(x, arm64_word_cmp_reg(0, 31));
    let br: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_eq(), 0));
    x = a64x_from_p(a64_eat(a64x_as_p(x), 123), x);
    x = a64x_expr(x);
    x = a64x_from_p(a64_eat(a64x_as_p(x), 125), x);
    x = a64x_skip(x);
    let jmp: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b(0));
    let offn: Int = list_len(x.p.words) - br;
    x = a64x_set_words(x, a64_wset(x.p.words, br, arm64_word_b_cond(arm64_cond_eq(), offn)));
    if a64_starts(a64x_as_p(x), "else") {
        x = a64x_skip(a64x_from_p(a64_eat_kw(a64x_as_p(x), "else"), x));
        if a64_starts(a64x_as_p(x), "if") {
            x = a64x_if_expr(x);
        } else {
            x = a64x_from_p(a64_eat(a64x_as_p(x), 123), x);
            x = a64x_expr(x);
            x = a64x_from_p(a64_eat(a64x_as_p(x), 125), x);
        }
    } else {
        x = a64x_movimm(x, 0, 0);
    }
    let offj: Int = list_len(x.p.words) - jmp;
    return a64x_set_words(x, a64_wset(x.p.words, jmp, arm64_word_b(offj)));
}

fn a64x_operand(x0: A64X) -> A64X {
    let x: A64X = a64x_skip(x0);
    if a64_peek(a64x_as_p(x)) == 40 {
        let mut y: A64X = a64x_from_p(a64_eat(a64x_as_p(x), 40), x);
        y = a64x_expr(y);
        let obj_nm: String = y.p.text;
        y = a64x_with_text(a64x_from_p(a64_eat(a64x_as_p(y), 41), y), obj_nm);
        return a64x_alu(a64x_dots(y));
    }
    return a64x_term(x);
}

fn a64x_rel_one(x0: A64X) -> A64X {
    let mut x: A64X = a64x_skip(x0);
    let b: Int = a64_peek(a64x_as_p(x));
    if b != 60 && b != 62 && !((b == 61 || b == 33) && x.p.i + 1 < bytes_len(x.p.src) && byte_at(x.p.src, x.p.i + 1) == 61) {
        return x;
    }
    let lfp: Int = x.st.fp;
    let lstr: Bool = a64x_is_str(x);
    x = a64x_emit(x, arm64_word_str(0, abi_fp_reg(), a64x_tmp_cmp()));
    x = a64x_take_relop(x);
    let inv: Int = x.p.ival;
    x = a64x_operand(x);
    x = a64x_emit(x, arm64_word_ldr(1, abi_fp_reg(), a64x_tmp_cmp()));
    if (b == 61 || b == 33) && (lstr || a64x_is_str(x)) {
        x = a64x_emit(a64x_emit(a64x_emit(x, arm64_word_mov_reg(2, 0)), arm64_word_mov_reg(0, 1)), arm64_word_mov_reg(1, 2));
        x = a64x_emit(a64x_bl(x, "__strcmp"), arm64_word_cmp_reg(0, 31));
    } else {
        if lfp == 1 || x.st.fp == 1 { x = a64x_fcmp(x); } else { x = a64x_emit(x, arm64_word_cmp_reg(1, 0)); }
    }
    x = a64x_emit(a64x_emit(x, arm64_word_movz(0, 0, 0)), arm64_word_b_cond(inv, 2));
    return a64x_with_fp(a64x_emit(x, arm64_word_movz(0, 1, 0)), 0);
}

pub fn a64x_expr(x0: A64X) -> A64X {
    let mut x: A64X = a64x_skip(x0);
    if a64_starts(a64x_as_p(x), "match") { return a64x_match_core(x); }
    if a64_starts(a64x_as_p(x), "if") { return a64x_if_expr(x); }
    let mut did_not: Bool = false;
    if a64_peek(a64x_as_p(x)) == 33 { x = a64x_from_p(a64_eat(a64x_as_p(x), 33), x); did_not = true; }
    if a64_peek(a64x_as_p(x)) == 40 {
        x = a64x_from_p(a64_eat(a64x_as_p(x), 40), x);
        x = a64x_expr(x);
        let obj_nm: String = x.p.text;
        x = a64x_with_text(a64x_from_p(a64_eat(a64x_as_p(x), 41), x), obj_nm);
        x = a64x_rel_one(a64x_alu(a64x_dots(x)));
    } else {
        x = a64x_rel_one(a64x_term(x));
    }
    if did_not {
        x = a64x_emit(a64x_emit(a64x_emit(x, arm64_word_cmp_reg(0, 31)), arm64_word_movz(0, 1, 0)), arm64_word_b_cond(arm64_cond_eq(), 2));
        x = a64x_with_fp(a64x_emit(x, arm64_word_movz(0, 0, 0)), 0);
    }
    x = a64x_skip(x);
    while a64_peek(a64x_as_p(x)) == 124 || a64_peek(a64x_as_p(x)) == 38 {
        let op: Int = a64_peek(a64x_as_p(x));
        let p: A64P = a64x_as_p(x);
        if p.i + 1 >= bytes_len(p.src) || byte_at(p.src, p.i + 1) != op { return x; }
        x = a64x_from_p(a64_at(p, p.i + 2), x);
        x = a64x_emit(x, arm64_word_str(0, abi_fp_reg(), a64x_tmp_cond()));
        x = a64x_rel_one(a64x_operand(x));
        x = a64x_emit(x, arm64_word_ldr(1, abi_fp_reg(), a64x_tmp_cond()));
        if op == 124 { x = a64x_emit(x, arm64_word_orr_reg(0, 1, 0)); } else { x = a64x_emit(x, arm64_word_and_reg(0, 1, 0)); }
        x = a64x_skip(x);
    }
    return x;
}
