// # AArch64 Lexical Closure And Anonymous Function Lowering
//
// Logline: Lowers lambda expressions, captures lexical variables into heap objects, and synthesizes trampolines.
//
// Setup: Encodes closures as heap fat pointers [fn_ptr (8B), env...]. Trampolines unpack x16 env pointer into local frame slots.
//
// Beats:
//   1. Scan closure body tokens to identify free variable captures against parent frame.
//   2. Lower trampoline function inline with jump-over branch and AAPCS64 frame.
//   3. Allocate heap closure object via oo_a64_alloc and store code address and captures.
//   4. Lower indirect call sites via x16 closure pointer and BLR x17.

import "std/hw/silicon/aarch64_parse.oo";
import "std/hw/silicon/aarch64_encoder.oo";
import "std/hw/silicon/aarch64_encode_mem.oo";
import "std/hw/silicon/aarch64_abi.oo";
import "std/hw/silicon/aarch64_regs.oo";
import "std/hw/silicon/aarch64_xstate.oo";
import "std/hw/silicon/aarch64_xscan.oo";
import "std/hw/silicon/aarch64_xfn.oo";
import "std/hw/silicon/aarch64_xexpr.oo";
import "std/hw/silicon/aarch64_xmark.oo";
import "std/hw/silicon/aarch64_xclosure_scan.oo";

fn a64x_c_call_args(x0: A64X) -> A64X {
    let mut x: A64X = a64x_skip(a64x_from_p(a64_eat(a64x_as_p(x0), 40), x0));
    let mut n: Int = 0; let mut flags: List[Int] = list_new();
    while a64_peek(a64x_as_p(x)) != 41 && a64_peek(a64x_as_p(x)) >= 0 {
        x = a64x_emit(a64x_emit(a64x_emit(a64x_c_expr(x), arm64_word_sub_imm(abi_sp_reg(), abi_sp_reg(), 16)), arm64_word_str(0, abi_sp_reg(), 0)), arm64_word_str(1, abi_sp_reg(), 8));
        let mut f_flag: Int = 0; if x.st.fp == 3 { f_flag = 1; }
        flags = list_push(flags, f_flag); n = n + 1; x = a64x_skip(x);
        if a64_peek(a64x_as_p(x)) == 44 { x = a64x_skip(a64x_from_p(a64_eat(a64x_as_p(x), 44), x)); }
    }
    x = a64x_from_p(a64_eat(a64x_as_p(x), 41), x);
    let mut reg: Int = 0; let mut i: Int = 0;
    while i < n && reg < 8 {
        x = a64x_emit(x, arm64_word_ldr(reg, abi_sp_reg(), (n - 1 - i) * 16));
        if list_get(flags, i) == 1 && reg + 1 < 8 { x = a64x_emit(x, arm64_word_ldr(reg + 1, abi_sp_reg(), (n - 1 - i) * 16 + 8)); reg = reg + 2; } else { reg = reg + 1; }
        i = i + 1;
    }
    if n > 0 { x = a64x_emit(x, arm64_word_add_imm(abi_sp_reg(), abi_sp_reg(), n * 16)); }
    return a64x_with_ival(x, n);
}

fn a64x_c_dots(x0: A64X, obj: String) -> A64X {
    let mut x: A64X = a64x_skip(x0);
    while a64_peek(a64x_as_p(x)) == 46 {
        let p: A64P = a64x_as_p(x);
        if p.i + 1 < bytes_len(p.src) && byte_at(p.src, p.i + 1) == 46 { return x; }
        x = a64x_from_p(a64_ident(a64_eat(a64x_as_p(x), 46)), x);
        let meth: String = x.p.text; x = a64x_skip(x);
        if a64_peek(a64x_as_p(x)) == 40 {
            x = a64x_c_call_args(a64x_emit(x, arm64_word_str(0, abi_fp_reg(), a64x_tmp_rcv())));
            let mut i: Int = x.p.ival; while i > 0 { x = a64x_emit(x, arm64_word_mov_reg(i, i - 1)); i = i - 1; }
            x = a64x_bl(a64x_emit(x, arm64_word_ldr(0, abi_fp_reg(), a64x_tmp_rcv())), meth);
        } else {
            let key: String = obj + "." + meth;
            let foff: Int = 0 + a64x_lookup_field(x, key);
            let mut f_off_val: Int = foff; if foff < 0 { if meth == "x" || meth == "name" { f_off_val = 0; } else { f_off_val = 8; } } x = a64x_emit(x, arm64_word_ldr(0, 0, f_off_val));
        }
        x = a64x_skip(x);
    }
    return x;
}

fn a64x_c_prefix(x0: A64X) -> A64X {
    let mut x: A64X = a64x_skip(x0);
    if a64_peek(a64x_as_p(x)) == 40 { return a64x_c_dots(a64x_from_p(a64_eat(a64x_as_p(a64x_c_expr(a64x_from_p(a64_eat(a64x_as_p(x), 40), x))), 41), x), x.p.text); }
    if a64_peek(a64x_as_p(x)) == 45 { return a64x_with_fp(a64x_emit(a64x_c_prefix(a64x_from_p(a64_eat(a64x_as_p(x), 45), x)), arm64_word_neg(0, 0)), 0); }
    if a64_peek(a64x_as_p(x)) == 33 { return a64x_with_fp(a64x_emit(a64x_emit(a64x_emit(a64x_emit(a64x_c_prefix(a64x_from_p(a64_eat(a64x_as_p(x), 33), x)), arm64_word_cmp_reg(0, 31)), arm64_word_movz(0, 1, 0)), arm64_word_b_cond(arm64_cond_eq(), 2)), arm64_word_movz(0, 0, 0)), 0); }
    if a64_is_alpha(a64_peek(a64x_as_p(x))) {
        x = a64x_from_p(a64_ident(a64x_as_p(x)), x);
        let nm: String = x.p.text; x = a64x_skip(x);
        if a64_peek(a64x_as_p(x)) == 40 {
            let off_loc: Int = 0 + a64_lookup_parse(x.p.names, x.p.offs, nm);
            if off_loc >= 0 { return a64x_c_dots(a64x_call_indirect(a64x_c_call_args(x), off_loc, x.p.ival), nm); }
            return a64x_c_dots(a64x_bl(a64x_c_call_args(x), nm), nm);
        }
        if nm == "true" { return a64x_c_dots(a64x_with_fp(a64x_movimm(x, 0, 1), 0), nm); }
        if nm == "false" || nm == "void" || nm == "Void" { return a64x_c_dots(a64x_with_fp(a64x_movimm(x, 0, 0), 0), nm); }
        let off2: Int = 0 + a64_lookup_parse(x.p.names, x.p.offs, nm); if off2 >= 0 { return a64x_c_dots(a64x_load_pair(x, off2), nm); }
    }
    return a64x_c_dots(a64x_primary(x), "");
}

fn a64x_c_alu(x0: A64X) -> A64X {
    let mut x: A64X = a64x_c_prefix(x0);
    while x.st.err == "" {
        x = a64x_skip(x); let b: Int = a64_peek(a64x_as_p(x));
        if b != 43 && b != 45 && b != 42 && b != 47 && b != 37 && b != 38 && b != 124 && b != 94 { return x; }
        let p2: A64P = a64x_as_p(x);
        if (b == 124 || b == 38) && p2.i + 1 < bytes_len(p2.src) && byte_at(p2.src, p2.i + 1) == b { return x; }
        let mut is_cat: Bool = false;
        if b == 43 {
            is_cat = a64x_is_str(x); let mut j: Int = x.p.i + 1;
            while j < bytes_len(x.p.src) && byte_at(x.p.src, j) <= 32 { j = j + 1; }
            if j < bytes_len(x.p.src) && byte_at(x.p.src, j) == 34 { is_cat = true; }
        }
        x = a64x_emit(a64x_emit(x, arm64_word_sub_imm(abi_sp_reg(), abi_sp_reg(), 16)), arm64_word_str(0, abi_sp_reg(), 0));
        x = a64x_c_prefix(a64x_from_p(a64_at(a64x_as_p(x), p2.i + 1), x));
        x = a64x_emit(a64x_emit(x, arm64_word_ldr(1, abi_sp_reg(), 0)), arm64_word_add_imm(abi_sp_reg(), abi_sp_reg(), 16));
        if b == 43 && (is_cat || x.st.fp == 2) {
            x = a64x_with_fp(a64x_bl(a64x_emit(a64x_emit(a64x_emit(x, arm64_word_mov_reg(2, 0)), arm64_word_mov_reg(0, 1)), arm64_word_mov_reg(1, 2)), "__concat"), 2);
        } else {
            x = a64x_ibinop(x, b);
        }
    }
    return x;
}

pub fn a64x_c_expr(x0: A64X) -> A64X {
    let mut x: A64X = a64x_skip(x0);
    if a64_starts(a64x_as_p(x), "if") {
        x = a64x_c_expr(a64x_from_p(a64_eat_kw(a64x_as_p(x), "if"), x));
        x = a64x_emit(x, arm64_word_cmp_reg(0, 31));
        let br: Int = list_len(x.p.words);
        x = a64x_from_p(a64_eat(a64x_as_p(a64x_c_expr(a64x_from_p(a64_eat(a64x_as_p(a64x_emit(x, arm64_word_b_cond(arm64_cond_eq(), 0))), 123), x))), 125), x);
        let jmp: Int = list_len(x.p.words);
        x = a64x_skip(a64x_set_words(a64x_emit(x, arm64_word_b(0)), a64_wset(x.p.words, br, arm64_word_b_cond(arm64_cond_eq(), list_len(x.p.words) - br))));
        if a64_starts(a64x_as_p(x), "else") {
            x = a64x_skip(a64x_from_p(a64_eat_kw(a64x_as_p(x), "else"), x));
            if a64_starts(a64x_as_p(x), "if") { x = a64x_c_expr(x); }
            else { x = a64x_from_p(a64_eat(a64x_as_p(a64x_c_expr(a64x_from_p(a64_eat(a64x_as_p(x), 123), x))), 125), x); }
        } else { x = a64x_movimm(x, 0, 0); }
        return a64x_set_words(x, a64_wset(x.p.words, jmp, arm64_word_b(list_len(x.p.words) - jmp)));
    }
    x = a64x_c_alu(x); x = a64x_skip(x);
    let b: Int = a64_peek(a64x_as_p(x));
    if b == 60 || b == 62 || ((b == 61 || b == 33) && x.p.i + 1 < bytes_len(x.p.src) && byte_at(x.p.src, x.p.i + 1) == 61) {
        x = a64x_emit(x, arm64_word_str(0, abi_fp_reg(), a64x_tmp_cmp()));
        x = a64x_take_relop(x); let inv: Int = x.p.ival;
        x = a64x_emit(a64x_emit(a64x_c_alu(x), arm64_word_ldr(1, abi_fp_reg(), a64x_tmp_cmp())), arm64_word_cmp_reg(1, 0));
        x = a64x_with_fp(a64x_emit(a64x_emit(a64x_emit(x, arm64_word_movz(0, 0, 0)), arm64_word_b_cond(inv, 2)), arm64_word_movz(0, 1, 0)), 0);
    }
    x = a64x_skip(x);
    while a64_peek(a64x_as_p(x)) == 124 || a64_peek(a64x_as_p(x)) == 38 {
        let op: Int = a64_peek(a64x_as_p(x)); let p: A64P = a64x_as_p(x);
        if p.i + 1 >= bytes_len(p.src) || byte_at(p.src, p.i + 1) != op { return x; }
        x = a64x_emit(a64x_from_p(a64_at(p, p.i + 2), x), arm64_word_str(0, abi_fp_reg(), a64x_tmp_cond()));
        x = a64x_emit(a64x_c_expr(x), arm64_word_ldr(1, abi_fp_reg(), a64x_tmp_cond()));
        if op == 124 { x = a64x_emit(x, arm64_word_orr_reg(0, 1, 0)); } else { x = a64x_emit(x, arm64_word_and_reg(0, 1, 0)); }
        x = a64x_skip(x);
    }
    return x;
}

fn a64x_c_stmt(x0: A64X) -> A64X {
    let mut x: A64X = a64x_skip(x0);
    if a64_starts(a64x_as_p(x), "let") {
        x = a64x_skip(a64x_from_p(a64_eat_kw(a64x_as_p(x), "let"), x));
        if a64_starts(a64x_as_p(x), "mut") { x = a64x_skip(a64x_from_p(a64_eat_kw(a64x_as_p(x), "mut"), x)); }
        x = a64x_from_p(a64_ident(a64x_as_p(x)), x);
        let nm: String = x.p.text; x = a64x_skip(x);
        if a64_peek(a64x_as_p(x)) == 58 { x = a64x_eat_type(a64x_from_p(a64_eat(a64x_as_p(x), 58), x)); }
        x = a64x_from_p(a64_eat(a64x_as_p(a64x_c_expr(a64x_from_p(a64_eat(a64x_as_p(x), 61), x))), 59), x);
        let hit: Int = 0 + a64_lookup_parse(x.p.names, x.p.offs, nm);
        if hit >= 0 { return a64x_store_pair(x, hit); }
        return a64x_store_pair(a64x_bind16(x, nm), x.p.ival);
    }
    if a64_starts(a64x_as_p(x), "for") {
        x = a64x_from_p(a64_ident(a64_eat_kw(a64x_as_p(x), "for")), x);
        let iname: String = x.p.text;
        x = a64x_bind16(a64x_c_expr(a64x_from_p(a64_eat_kw(a64x_as_p(x), "in"), x)), iname);
        let ioff: Int = x.p.ival;
        x = a64x_bind16(a64x_c_expr(a64x_from_p(a64_eat(a64_eat(a64x_as_p(a64x_emit(x, arm64_word_str(0, abi_fp_reg(), ioff))), 46), 46), x)), "__cfor_hi");
        let hioff: Int = x.p.ival;
        let top: Int = list_len(x.p.words) + 1;
        x = a64x_emit(a64x_emit(a64x_emit(a64x_emit(x, arm64_word_str(0, abi_fp_reg(), hioff)), arm64_word_ldr(0, abi_fp_reg(), ioff)), arm64_word_ldr(1, abi_fp_reg(), hioff)), arm64_word_cmp_reg(0, 1));
        let br: Int = list_len(x.p.words);
        x = a64x_from_p(a64_eat(a64x_as_p(a64x_c_stmts(a64x_from_p(a64_eat(a64x_as_p(a64x_emit(x, arm64_word_b_cond(arm64_cond_ge(), 0))), 123), x))), 125), x);
        x = a64x_emit(a64x_emit(a64x_emit(a64x_emit(x, arm64_word_ldr(0, abi_fp_reg(), ioff)), arm64_word_add_imm(0, 0, 1)), arm64_word_str(0, abi_fp_reg(), ioff)), arm64_word_b(top - list_len(x.p.words)));
        return a64x_set_words(x, a64_wset(x.p.words, br, arm64_word_b_cond(arm64_cond_ge(), list_len(x.p.words) - br)));
    }
    if a64_is_alpha(a64_peek(a64x_as_p(x))) {
        let mut z: A64X = a64x_from_p(a64_ident(a64x_as_p(x)), x);
        let nm2: String = z.p.text; z = a64x_skip(z);
        if a64_peek(a64x_as_p(z)) == 61 {
            z = a64x_from_p(a64_eat(a64x_as_p(a64x_c_expr(a64x_from_p(a64_eat(a64x_as_p(z), 61), z))), 59), z);
            let off: Int = 0 + a64_lookup_parse(z.p.names, z.p.offs, nm2);
            if off < 0 { return a64x_fail(z, "ERR\ta64x_assign"); }
            return a64x_store_pair(z, off);
        }
    }
    let mut e: A64X = a64x_c_expr(x); e = a64x_skip(e);
    if a64_peek(a64x_as_p(e)) == 59 { e = a64x_from_p(a64_eat(a64x_as_p(e), 59), e); }
    return e;
}

fn a64x_c_stmts(x0: A64X) -> A64X {
    let mut x: A64X = x0; let mut n: Int = 0;
    while x.st.err == "" {
        n = n + 1;
        if n > 8000 { return a64x_fail(x, "ERR\ta64x_c_stmts\tloop"); }
        x = a64x_skip(x);
        let b: Int = a64_peek(a64x_as_p(x));
        if b == 125 || b < 0 { return x; }
        let i0: Int = x.p.i; x = a64x_c_stmt(x);
        if x.st.err == "" && x.p.i <= i0 { return a64x_fail(x, "ERR\ta64x_c_stmts\tno_advance"); }
    }
    return x;
}

pub fn a64x_closure(x0: A64X) -> A64X {
    let mut x: A64X = a64x_from_p(a64_eat(a64x_as_p(x0), 124), x0);
    x = a64x_skip(x); let mut params: List[String] = list_new();
    if a64_peek(a64x_as_p(x)) == 124 { x = a64x_from_p(a64_eat(a64x_as_p(x), 124), x); }
    else {
        while a64_peek(a64x_as_p(x)) != 124 && a64_peek(a64x_as_p(x)) >= 0 {
            x = a64x_skip(x);
            if a64_starts(a64x_as_p(x), "mut") { x = a64x_skip(a64x_from_p(a64_eat_kw(a64x_as_p(x), "mut"), x)); }
            x = a64x_from_p(a64_ident(a64x_as_p(x)), x);
            params = list_push(params, x.p.text); x = a64x_skip(x);
            if a64_peek(a64x_as_p(x)) == 58 { x = a64x_eat_type(a64x_from_p(a64_eat(a64x_as_p(x), 58), x)); }
            x = a64x_skip(x);
            if a64_peek(a64x_as_p(x)) == 44 { x = a64x_skip(a64x_from_p(a64_eat(a64x_as_p(x), 44), x)); }
        }
        x = a64x_from_p(a64_eat(a64x_as_p(x), 124), x);
    }
    let caps: List[String] = a64x_scan_caps(x, params, x.p.i);
    let n_caps: Int = list_len(caps); let n_params: Int = list_len(params);
    let jmp_pc: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b(0));
    let entry_pc: Int = list_len(x.p.words);
    let parent_names: List[String] = x.p.names; let parent_offs: List[Int] = x.p.offs;
    let parent_next_off: Int = x.p.next_off; let parent_flt: List[String] = x.st.flt;
    x = a64x_emit(a64x_emit(a64x_emit(x, arm64_word_sub_imm(abi_sp_reg(), abi_sp_reg(), a64x_frame())), arm64_word_stp_pre(abi_fp_reg(), abi_lr_reg(), abi_sp_reg(), -16)), arm64_word_mov_fp_sp());
    x = a64x_reset_locals(x);
    let mut pi: Int = 0;
    while pi < n_params {
        x = a64x_bind16(x, list_get(params, pi));
        if pi < 8 { x = a64x_emit(x, arm64_word_str(pi, abi_fp_reg(), x.p.ival)); }
        else { x = a64x_emit(a64x_emit(x, arm64_word_ldr(9, abi_fp_reg(), 4016 + (pi - 8) * 16)), arm64_word_str(9, abi_fp_reg(), x.p.ival)); }
        pi = pi + 1;
    }
    let mut ci: Int = 0;
    while ci < n_caps {
        x = a64x_bind16(x, list_get(caps, ci));
        x = a64x_emit(a64x_emit(x, arm64_word_ldr(9, 16, 8 + 8 * ci)), arm64_word_str(9, abi_fp_reg(), x.p.ival));
        ci = ci + 1;
    }
    x = a64x_skip(x);
    if a64_peek(a64x_as_p(x)) == 123 { x = a64x_from_p(a64_eat(a64x_as_p(a64x_c_stmts(a64x_from_p(a64_eat(a64x_as_p(x), 123), x))), 125), x); } else { x = a64x_c_expr(x); }
    x = a64x_emit(a64x_emit(a64x_emit(x, arm64_word_ldp_post(abi_fp_reg(), abi_lr_reg(), abi_sp_reg(), 16)), arm64_word_add_imm(abi_sp_reg(), abi_sp_reg(), a64x_frame())), arm64_word_ret());
    x = a64x_set_words(x, a64_wset(x.p.words, jmp_pc, arm64_word_b(list_len(x.p.words) - jmp_pc)));
    x = a64x_with_scope(x, parent_names, parent_offs, parent_next_off, parent_flt);
    let env_sz: Int = 16 * ((1 + n_caps + 1) / 2);
    x = a64x_emit(a64x_emit(a64x_bl(a64x_emit(x, arm64_word_movz(0, env_sz, 0)), "oo_a64_alloc"), arm64_word_sub_imm(abi_sp_reg(), abi_sp_reg(), 16)), arm64_word_str(0, abi_sp_reg(), 0));
    x = a64x_emit(a64x_emit(x, arm64_word_adr(1, (entry_pc - list_len(x.p.words)) * 4)), arm64_word_str(1, 0, 0));
    let mut ki: Int = 0; while ki < n_caps {
        let p_off2: Int = 0 + a64_lookup_parse(parent_names, parent_offs, list_get(caps, ki));
        if p_off2 >= 0 { x = a64x_emit(a64x_emit(x, arm64_word_ldr(2, abi_fp_reg(), p_off2)), arm64_word_str(2, 0, 8 + 8 * ki)); }
        ki = ki + 1;
    }
    return a64x_with_fp(a64x_emit(a64x_emit(x, arm64_word_ldr(0, abi_sp_reg(), 0)), arm64_word_add_imm(abi_sp_reg(), abi_sp_reg(), 16)), 0);
}
