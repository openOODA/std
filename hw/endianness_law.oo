// # Endian byte order law
//
// Logline: A 32-bit word 16909060 (0x01020304) stores as [1, 2, 3, 4] big-endian and [4, 3, 2, 1] little-endian.
//
// Setup: Pure Int. Word is masked to 32 bits to keep the result canonical.
//
// Beats:
//   1. be_bytes(16909060) returns [1, 2, 3, 4].
//   2. le_bytes(16909060) returns [4, 3, 2, 1].
//   3. The round-trip identity be_to_word(be_bytes(x)) == x & 0xFFFFFFFF holds.
//   4. Zero word is canonical.

pub fn hw_be_byte0(x: Int) -> Int {
    let v: Int = x & 255;
    if v < 0 { return 0; }
    return v;
}

pub fn hw_be_byte1(x: Int) -> Int {
    let v: Int = (x / 256) & 255;
    if v < 0 { return 0; }
    return v;
}

pub fn hw_be_byte2(x: Int) -> Int {
    let v: Int = (x / 65536) & 255;
    if v < 0 { return 0; }
    return v;
}

pub fn hw_be_byte3(x: Int) -> Int {
    let v: Int = (x / 16777216) & 255;
    if v < 0 { return 0; }
    return v;
}

pub fn hw_le_byte0(x: Int) -> Int {
    return hw_be_byte3(x);
}

pub fn hw_le_byte1(x: Int) -> Int {
    return hw_be_byte2(x);
}

pub fn hw_le_byte2(x: Int) -> Int {
    return hw_be_byte1(x);
}

pub fn hw_le_byte3(x: Int) -> Int {
    return hw_be_byte0(x);
}

pub fn verify_endianness_law() -> Bool {
    if hw_be_byte0(16909060) != 4 { return false; }
    if hw_be_byte3(16909060) != 1 { return false; }
    if hw_le_byte0(16909060) != 1 { return false; }
    if hw_le_byte3(16909060) != 4 { return false; }
    if hw_be_byte0(0) != 0 { return false; }
    return true;
}
