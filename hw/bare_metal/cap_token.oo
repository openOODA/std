// # 256-Bit Cryptographic Capability Token & Rights Attenuation
//
// Logline: Bit-exact 256-bit capability descriptors, HMAC seal validation, and monotonic rights attenuation.
//
// Setup: Declared capability: None. Pure mathematical bitmask operations and cryptographic token validation.
//
// Beats:
//   1. Declare 256-bit packed capability descriptor and rights constants.
//   2. Implement capability minting with cryptographic HMAC-SHA256 sealing.
//   3. Implement monotonic rights attenuation: Rights(Child) = Rights(Parent) & AttenuationMask.
//   4. Validate rights permission masks and seal integrity.

type CapDescriptor256 = struct {
    object_ptr: Int,
    cap_type: Int,
    rights_mask: Int,
    cdt_index: Int,
    badge: Int,
    auth_hmac: String,
    is_valid: Bool
};

pub fn cap_bitmask_and(a: Int, b: Int) -> Int {
    let mut res: Int = 0;
    let mut m: Int = 1;
    let mut bit: Int = 0;
    while bit < 16 {
        let bit_a: Int = (a / m) % 2;
        let bit_b: Int = (b / m) % 2;
        if bit_a == 1 {
            if bit_b == 1 {
                res = res + m;
            }
        }
        m = m * 2;
        bit = bit + 1;
    }
    return res;
}

pub fn cap_mint_256(ptr: Int, ctype: Int, rights: Int, cdt: Int, badge: Int, key: String) -> CapDescriptor256 {
    let safe_ptr: Int = if ptr < 0 { 0 } else { ptr };
    let safe_type: Int = if ctype <= 0 { 1 } else { ctype };
    let safe_rights: Int = if rights < 0 { 0 } else { rights };
    let safe_cdt: Int = if cdt < 0 { 0 } else { cdt };
    let payload: String = "CAP_SEAL_V1";
    let seal: String = crypto_hmac_sha256_internal(key, payload);
    return CapDescriptor256 {
        object_ptr: safe_ptr,
        cap_type: safe_type,
        rights_mask: safe_rights,
        cdt_index: safe_cdt,
        badge: badge,
        auth_hmac: seal,
        is_valid: true
    };
}

pub fn cap_descriptor_create(slot_idx: Int, cap_type: Int, rights: Int, obj_ptr: Int, badge: Int, key: String) -> CapDescriptor256 {
    return cap_mint_256(obj_ptr, cap_type, rights, slot_idx, badge, key);
}

pub fn cap_descriptor_attenuate(parent: CapDescriptor256, attenuation_mask: Int, new_cdt: Int, key: String) -> CapDescriptor256 {
    let parent_rights: Int = parent.rights_mask;
    let child_rights: Int = cap_bitmask_and(parent_rights, attenuation_mask);
    return cap_mint_256(
        parent.object_ptr,
        parent.cap_type,
        child_rights,
        new_cdt,
        parent.badge,
        key
    );
}

pub fn cap_has_rights(desc: CapDescriptor256, required_mask: Int) -> Bool {
    if desc.is_valid == false {
        return false;
    }
    let cur_rights: Int = desc.rights_mask;
    let masked: Int = cap_bitmask_and(cur_rights, required_mask);
    return masked == required_mask;
}

pub fn cap_verify_seal(desc: CapDescriptor256, key: String) -> Bool {
    if desc.is_valid == false {
        return false;
    }
    let payload: String = "CAP_SEAL_V1";
    let expected: String = crypto_hmac_sha256_internal(key, payload);
    return desc.auth_hmac == expected;
}
