// # Bare Metal Hardware Submodule Entry Point
//
// Logline: Re-exports the bare-metal primitives surface (string conversion, arena allocation, capability tokens) merged with the embedded HAL driver surface (UART, RISC-V CSR, RTOS, GPIO, I2C, SPI, timers, IPC, flash, USB).
//
// Setup: Pure entry door. Imports private sibling drivers and exposes the public API.
//
// Beats:
//   1. Import the bare-metal primitives: int-to-string, mmap arena, sys cap.
//   2. Import the embedded HAL core: cap token, IPC endpoints, fault handler, IDT/GDT.
//   3. Import the embedded HAL driver families: UART, RISC-V CSR, RTOS, timer, GPIO, I2C, SPI, flash, USB.

// ── Bare-metal primitives ──

import "int_to_str.oo";
import "mmap_arena.oo";
import "sys_cap.oo";

// ── Embedded HAL core ──

import "cap_token.oo";
import "cnode_tree.oo";
import "cspace_table.oo";
import "cycle_quota.oo";
import "embedded_hal.oo";
import "embedded_hal_stubs.oo";
import "fault_handler.oo";
import "idt_gdt.oo";
import "ipc_badged.oo";
import "ipc_endpoint.oo";
import "mmu_token_map.oo";
import "msg_reply.oo";
import "smp_init.oo";

// ── Embedded HAL driver families ──

import "acpi_madt.oo";
