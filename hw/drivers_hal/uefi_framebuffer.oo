// # UEFI 64-Bit Linear Framebuffer Graphics Driver
//
// Logline: Implements 64-bit UEFI Graphics Output Protocol (GOP) linear
// framebuffer management, RGB/BGR pixel packing, 2D rasterization primitives,
// Bresenham integer line drawing, and 8x16 bitmap font glyph rendering.
//
// Setup: Coordinates must lie within framebuffer bounds [0, width) x [0, height);
// pitch must satisfy pixels_per_scanline >= width; color channels clamp to 0..255.
//
// Beats:
//   1. Standard operating routine for this driver.
//   2. Errata/edge case handling.
// capability: Requires &SysCap for all framebuffer rasterization operations.
//
// verification: Verified by qa/tests_sovereign/tier1_features/test_t1_f09_uefi_framebuffer.oo.

type UefiFramebuffer = struct {
    base_addr: Int,
    width: Int,
    height: Int,
    pixels_per_scanline: Int,
    pixel_format: Int,
    bytes_per_pixel: Int,
    pixels: List[Int],
    is_valid: Bool
};

pub fn uefi_fb_format_rgb() -> Int { return 0; }
pub fn uefi_fb_format_bgr() -> Int { return 1; }

pub fn uefi_fb_pack_color(format: Int, r: Int, g: Int, b: Int, a: Int) -> Int {
    let alpha: Int = (a & 255) << 24;
    if format == uefi_fb_format_bgr() {
        return alpha | ((b & 255) << 16) | ((g & 255) << 8) | (r & 255);
    }
    return alpha | ((r & 255) << 16) | ((g & 255) << 8) | (b & 255);
}

pub fn uefi_fb_unpack_r(format: Int, color: Int) -> Int {
    if format == uefi_fb_format_bgr() { return color & 255; }
    return (color >> 16) & 255;
}

pub fn uefi_fb_unpack_g(format: Int, color: Int) -> Int { return (color >> 8) & 255; }

pub fn uefi_fb_unpack_b(format: Int, color: Int) -> Int {
    if format == uefi_fb_format_bgr() { return (color >> 16) & 255; }
    return color & 255;
}

pub fn uefi_fb_offset(fb: UefiFramebuffer, x: Int, y: Int) -> Int {
    return y * fb.pixels_per_scanline + x;
}

pub fn uefi_fb_byte_offset(fb: UefiFramebuffer, x: Int, y: Int) -> Int {
    return uefi_fb_offset(fb, x, y) * fb.bytes_per_pixel;
}

pub fn uefi_fb_init(sys: &SysCap, base_addr: Int, width: Int, height: Int, pitch: Int, pixel_format: Int) -> Result[UefiFramebuffer, String] {
    if width <= 0 || height <= 0 { return Err("E_INVALID_FB_DIMENSIONS"); }
    if pitch < width { return Err("E_INVALID_FB_PITCH"); }
    if pixel_format != uefi_fb_format_rgb() && pixel_format != uefi_fb_format_bgr() {
        return Err("E_INVALID_PIXEL_FORMAT");
    }
    let total_pixels: Int = pitch * height;
    let mut pixels: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total_pixels {
        pixels = list_push(pixels, 0);
        i = i + 1;
    }
    return Ok(UefiFramebuffer {
        base_addr: base_addr,
        width: width,
        height: height,
        pixels_per_scanline: pitch,
        pixel_format: pixel_format,
        bytes_per_pixel: 4,
        pixels: pixels,
        is_valid: true
    });
}

pub fn uefi_fb_put_pixel(sys: &SysCap, fb: UefiFramebuffer, x: Int, y: Int, color: Int) -> Result[UefiFramebuffer, String] {
    if x < 0 || x >= fb.width || y < 0 || y >= fb.height {
        return Err("E_FB_COORDINATES_OUT_OF_BOUNDS");
    }
    let target_idx: Int = uefi_fb_offset(fb, x, y);
    let mut new_pixels: List[Int] = list_new();
    let mut i: Int = 0;
    let n: Int = list_len(fb.pixels);
    while i < n {
        if i == target_idx {
            new_pixels = list_push(new_pixels, color);
        } else {
            new_pixels = list_push(new_pixels, list_get(fb.pixels, i));
        }
        i = i + 1;
    }
    return Ok(UefiFramebuffer {
        base_addr: fb.base_addr,
        width: fb.width,
        height: fb.height,
        pixels_per_scanline: fb.pixels_per_scanline,
        pixel_format: fb.pixel_format,
        bytes_per_pixel: fb.bytes_per_pixel,
        pixels: new_pixels,
        is_valid: true
    });
}

pub fn uefi_fb_get_pixel(sys: &SysCap, fb: UefiFramebuffer, x: Int, y: Int) -> Result[Int, String] {
    if x < 0 || x >= fb.width || y < 0 || y >= fb.height {
        return Err("E_FB_COORDINATES_OUT_OF_BOUNDS");
    }
    let target_idx: Int = uefi_fb_offset(fb, x, y);
    return Ok(list_get(fb.pixels, target_idx));
}

pub fn uefi_fb_fill_rect(sys: &SysCap, fb: UefiFramebuffer, x: Int, y: Int, w: Int, h: Int, color: Int) -> Result[UefiFramebuffer, String] {
    let mut cur_fb: UefiFramebuffer = fb;
    let mut cy: Int = y;
    while cy < y + h {
        let mut cx: Int = x;
        while cx < x + w {
            if cx >= 0 && cx < cur_fb.width && cy >= 0 && cy < cur_fb.height {
                let res: Result[UefiFramebuffer, String] = uefi_fb_put_pixel(sys, cur_fb, cx, cy, color);
                if res.is_err() { return res; }
                cur_fb = match res {
                    Ok(f)  => f,
                    Err(e) => cur_fb
                };
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    return Ok(cur_fb);
}

pub fn uefi_fb_draw_line(sys: &SysCap, fb: UefiFramebuffer, x0: Int, y0: Int, x1: Int, y1: Int, color: Int) -> Result[UefiFramebuffer, String] {
    let mut cur_fb: UefiFramebuffer = fb;
    let dx: Int = if x1 >= x0 { x1 - x0 } else { x0 - x1 };
    let sx: Int = if x0 < x1 { 1 } else { -1 };
    let dy: Int = if y1 >= y0 { -(y1 - y0) } else { -(y0 - y1) };
    let sy: Int = if y0 < y1 { 1 } else { -1 };
    let mut err: Int = dx + dy;
    let mut cx: Int = x0;
    let mut cy: Int = y0;
    let mut active: Bool = true;
    while active {
        let res: Result[UefiFramebuffer, String] = uefi_fb_put_pixel(sys, cur_fb, cx, cy, color);
        if res.is_err() { return res; }
        cur_fb = match res {
            Ok(f)  => f,
            Err(e) => cur_fb
        };
        if cx == x1 && cy == y1 {
            active = false;
        } else {
            let e2: Int = 2 * err;
            if e2 >= dy {
                err = err + dy;
                cx = cx + sx;
            }
            if e2 <= dx {
                err = err + dx;
                cy = cy + sy;
            }
        }
    }
    return Ok(cur_fb);
}

pub fn uefi_fb_glyph_row_bits(char_code: Int, row: Int) -> Int {
    if char_code == 65 {
        if row == 0 || row == 1 { return 24; }
        if row == 2 || row == 3 { return 60; }
        if row == 4 || row == 5 { return 102; }
        if row == 6 || row == 7 { return 126; }
        if row == 8 || row == 9 { return 102; }
        if row == 10 || row == 11 { return 102; }
        return 102;
    }
    if char_code == 43 {
        if row == 7 || row == 8 { return 255; }
        return 24;
    }
    if row == 0 || row == 15 { return 255; }
    return 129;
}

pub fn uefi_fb_draw_char_8x16(sys: &SysCap, fb: UefiFramebuffer, x: Int, y: Int, char_code: Int, fg_color: Int, bg_color: Int) -> Result[UefiFramebuffer, String] {
    let mut cur_fb: UefiFramebuffer = fb;
    let mut r: Int = 0;
    while r < 16 {
        let row_bits: Int = uefi_fb_glyph_row_bits(char_code, r);
        let mut c: Int = 0;
        while c < 8 {
            let bit_set: Bool = ((row_bits >> (7 - c)) & 1) != 0;
            let col_val: Int = if bit_set { fg_color } else { bg_color };
            let px: Int = x + c;
            let py: Int = y + r;
            if px >= 0 && px < cur_fb.width && py >= 0 && py < cur_fb.height {
                let res: Result[UefiFramebuffer, String] = uefi_fb_put_pixel(sys, cur_fb, px, py, col_val);
                if res.is_err() { return res; }
                cur_fb = match res {
                    Ok(f)  => f,
                    Err(e) => cur_fb
                };
            }
            c = c + 1;
        }
        r = r + 1;
    }
    return Ok(cur_fb);
}
