// # Cache line alignment law
//
// Logline: A valid cache line size is a positive power of two, and any address aligned to the line size lies on a line boundary.
//
// Setup: Pure Int. Reuses the pow2 predicate from std/hw/hw_invariants.oo.
//
// Beats:
//   1. line_size must be a positive power of two.
//   2. An address is line-aligned iff (addr & (line_size - 1)) == 0.
//   3. The split returns (line_index, byte_offset).

import "std/hw/hw_invariants.oo";

fn hwl_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn hw_line_index(addr: Int, line_size: Int) -> Result[Int, String] {
    if hw_align_ok(line_size) == 0 { return Err("ERR\thwl\tdomain"); }
    if addr < 0 { return Err("ERR\thwl\tdomain"); }
    return Ok(addr / line_size);
}

pub fn hw_line_offset(addr: Int, line_size: Int) -> Result[Int, String] {
    if hw_align_ok(line_size) == 0 { return Err("ERR\thwl\tdomain"); }
    if addr < 0 { return Err("ERR\thwl\tdomain"); }
    return Ok(addr & (line_size - 1));
}

pub fn hw_is_line_aligned(addr: Int, line_size: Int) -> Int {
    if hw_align_ok(line_size) == 0 {
        return 0;
    }
    if (addr & (line_size - 1)) == 0 {
        return 1;
    }
    return 0;
}

pub fn verify_cache_line_law() -> Bool {
    if hw_is_line_aligned(64, 64) != 1 { return false; }
    if hw_is_line_aligned(128, 64) != 1 { return false; }
    if hw_is_line_aligned(65, 64) != 0 { return false; }
    if hw_is_line_aligned(0, 64) != 1 { return false; }
    if hwl_got(hw_line_offset(65, 64)) != 1 { return false; }
    if hwl_got(hw_line_index(65, 64)) != 1 { return false; }
    let zoff: Result[Int, String] = hw_line_offset(64, 64);
    if zoff.is_ok() == false { return false; }
    if hwl_got(zoff) != 0 { return false; }
    let zidx: Result[Int, String] = hw_line_index(0, 64);
    if zidx.is_ok() == false { return false; }
    if hwl_got(zidx) != 0 { return false; }
    if hw_line_index(64, 0).is_ok() { return false; }
    if hw_line_offset(7, 3).is_ok() { return false; }
    if hw_is_line_aligned(64, 0) != 0 { return false; }
    if hw_is_line_aligned(64, 3) != 0 { return false; }
    return true;
}
