// # Memory bandwidth law
//
// Logline: bandwidth_bytes_per_sec equals bytes_transferred divided by elapsed_seconds; zero or negative time fails closed to 0.
//
// Setup: Pure Int. Caller supplies bytes and nanoseconds so the identity is unit-agnostic.
//
// Beats:
//   1. bandwidth_bps(bytes, ns) = bytes * 1_000_000_000 / ns.
//   2. ns == 0 or negative returns 0 (fail closed, no division by zero).
//   3. Negative bytes returns 0.

fn bps_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn hw_bandwidth_bps(bytes: Int, ns: Int) -> Result[Int, String] {
    if bytes < 0 { return Err("ERR\tbps\tdomain"); }
    if ns <= 0 { return Err("ERR\tbps\tdomain"); }
    return Ok((bytes * 1000000000) / ns);
}

pub fn hw_is_above_threshold(bps: Int, threshold_bps: Int) -> Int {
    if threshold_bps <= 0 {
        return 0;
    }
    if bps >= threshold_bps {
        return 1;
    }
    return 0;
}

pub fn verify_memory_bandwidth_law() -> Bool {
    if bps_got(hw_bandwidth_bps(1024, 1000)) != 1024 * 1000000 { return false; }
    let zb: Result[Int, String] = hw_bandwidth_bps(0, 1000);
    if zb.is_ok() == false { return false; }
    if bps_got(zb) != 0 { return false; }
    if hw_bandwidth_bps(1024, 0).is_ok() { return false; }
    if hw_bandwidth_bps(0 - 1, 1000).is_ok() { return false; }
    if hw_is_above_threshold(2000000000, 1000000000) != 1 { return false; }
    if hw_is_above_threshold(500000000, 1000000000) != 0 { return false; }
    if hw_is_above_threshold(0, 0) != 0 { return false; }
    return true;
}
