// # MOESI coherence protocol theory
//
// Logline: MOESI (Modified, Owned, Exclusive, Shared, Invalid) is the 5-state extension of MESI used by AMD64; the Owned state lets a cache line carry dirty data across cores without immediate writeback, while an O -> E transition is illegal without a writeback (the dirty data must first reach memory or another state); in directory-based systems a directory tracks which cores share each line.
//
// Setup: Pure Int. moesi_state_count() returns 5 (M, O, E, S, I). moesi_owns_modified_data() returns 1 to witness that the Owned state holds dirty data shared across cores. moesi_transition_ok(from, to, writeback) returns Err when O -> E is requested without writeback; legal transitions return Ok(1). moesi_directory_present() returns 1 to witness directory tracking. Hostile O -> E without writeback fails. Uses domain_cert("hw", ...).
//
// Beats:
//   1. moesi_state_count = 5; moesi_owns_modified_data = 1.
//   2. moesi_transition_ok: O -> E without writeback = Err; O -> E with writeback = Ok(1).
//   3. moesi_directory_present = 1 (coupled: directory tracks sharing).

import "std/core/primitives/domain_cert.oo";

fn moesi_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// MOESI state count: M, O, E, S, I (5-state extension of MESI).
// Source: AMD64 Architecture Programmer's Manual, Vol. 2, Ch. 7, MOESI coherence.
pub fn moesi_state_count() -> Int {
    return 5;
}

// MOESI Owned state witness: dirty data shared across cores.
// Source: AMD64 Architecture Programmer's Manual, Vol. 2, Ch. 7, MOESI coherence.
pub fn moesi_owns_modified_data() -> Int {
    return 1;
}

// Check a MOESI transition. States: 0=I, 1=S, 2=E, 3=M, 4=O.
// O -> E is illegal without writeback; all other valid transitions are Ok.
// Source: AMD64 Architecture Programmer's Manual, Vol. 2, Ch. 7.
pub fn moesi_transition_ok(from: Int, to: Int, writeback: Int) -> Result[Int, String] {
    if from < 0 { return Err("ERR\tmoesi\tfrom"); }
    if from > 4 { return Err("ERR\tmoesi\tfrom"); }
    if to < 0 { return Err("ERR\tmoesi\tto"); }
    if to > 4 { return Err("ERR\tmoesi\tto"); }
    if writeback < 0 { return Err("ERR\tmoesi\twb"); }
    if writeback > 1 { return Err("ERR\tmoesi\twb"); }
    if from == 4 {
        if to == 2 {
            if writeback == 0 { return Err("ERR\tmoesi\toe"); }
        }
    }
    return Ok(1);
}

// MOESI with directory protocol: directory tracks which cores share each line.
// Source: Hennessy & Patterson, Computer Architecture, 6th ed., Ch. 5, directory protocols.
pub fn moesi_directory_present() -> Int {
    return 1;
}

pub fn moesi_golden_cert() -> DomainCert {
    let n: Int = moesi_state_count();
    let own: Int = moesi_owns_modified_data();
    let mut holds: Int = 0;
    if n == 5 {
        if own == 1 { holds = 1; }
    }
    return domain_cert("hw", "moesi_golden", holds);
}

pub fn moesi_hostile_cert() -> DomainCert {
    let mut holds: Int = 0;
    // O -> E without writeback is illegal.
    if moesi_transition_ok(4, 2, 0).is_ok() == false {
        // Legal transitions remain Ok.
        if moesi_transition_ok(4, 2, 1).is_ok() {
            if moesi_transition_ok(4, 3, 0).is_ok() {
                if moesi_transition_ok(3, 0, 0).is_ok() {
                    if moesi_transition_ok(2, 0, 0).is_ok() {
                        if moesi_transition_ok(1, 0, 0).is_ok() {
                            holds = 1;
                        }
                    }
                }
            }
        }
    }
    return domain_cert("hw", "moesi_hostile", holds);
}

pub fn moesi_coupled_cert() -> DomainCert {
    let d: Int = moesi_directory_present();
    let mut holds: Int = 0;
    if d == 1 { holds = 1; }
    return domain_cert("hw", "moesi_coupled", holds);
}

pub fn verify_moesi_protocol_theory() -> Bool {
    // Golden: 5 states, Owned = 1.
    if moesi_state_count() != 5 { return false; }
    if moesi_owns_modified_data() != 1 { return false; }
    // State set: M=3, O=4, E=2, S=1, I=0.
    // Legal transitions.
    if moesi_got(moesi_transition_ok(4, 2, 1)) != 1 { return false; }   // O -> E with writeback
    if moesi_got(moesi_transition_ok(4, 3, 0)) != 1 { return false; }   // O -> M (write to line)
    if moesi_got(moesi_transition_ok(3, 0, 1)) != 1 { return false; }   // M -> I with writeback
    if moesi_got(moesi_transition_ok(2, 0, 0)) != 1 { return false; }   // E -> I
    if moesi_got(moesi_transition_ok(1, 0, 0)) != 1 { return false; }   // S -> I
    if moesi_got(moesi_transition_ok(0, 1, 0)) != 1 { return false; }   // I -> S
    if moesi_got(moesi_transition_ok(0, 2, 0)) != 1 { return false; }   // I -> E
    if moesi_got(moesi_transition_ok(0, 3, 0)) != 1 { return false; }   // I -> M
    if moesi_got(moesi_transition_ok(0, 4, 0)) != 1 { return false; }   // I -> O
    // Hostile: O -> E without writeback is illegal.
    if moesi_transition_ok(4, 2, 0).is_ok() { return false; }
    // Hostile: out-of-range state values.
    if moesi_transition_ok(0 - 1, 0, 0).is_ok() { return false; }
    if moesi_transition_ok(5, 0, 0).is_ok() { return false; }
    if moesi_transition_ok(0, 0 - 1, 0).is_ok() { return false; }
    if moesi_transition_ok(0, 5, 0).is_ok() { return false; }
    if moesi_transition_ok(0, 0, 0 - 1).is_ok() { return false; }
    if moesi_transition_ok(0, 0, 2).is_ok() { return false; }
    // Coupled: directory present.
    if moesi_directory_present() != 1 { return false; }
    // Certificates: golden, hostile, coupled all hold.
    let g: DomainCert = moesi_golden_cert();
    let h: DomainCert = moesi_hostile_cert();
    let cu: DomainCert = moesi_coupled_cert();
    if g.holds != 1 { return false; }
    if h.holds != 1 { return false; }
    if cu.holds != 1 { return false; }
    return true;
}
