// # std/qa/probe_ed25519 — Ed25519 Oracle Vectors
//
// Logline: Verify sec/asymmetric ed25519 against an independent oracle
// (python cryptography, fixed seed) plus tamper rejection.
//
// Setup: Pure compute. Seed 00..1f, message "openooda-minisig-spike".
// Oracle values generated 2026-09-27; any drift fails closed.
//
// Beats:
//   1. pubkey_from_seed matches the oracle public key.
//   2. verify accepts the oracle signature.
//   3. verify rejects a one-bit-flipped signature.
//   4. verify rejects a wrong message.
//   5. sign reproduces the oracle signature byte-for-byte (deterministic).

import "sec/asymmetric/ecc/ed25519.oo";

pub fn main() -> Result[Int, String] {
    let seed: String = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
    let pub_want: String = "03a107bff3ce10be1d70dd18e74bc09967e4d6309ba50d5f1ddc8664125531b8";
    let msg: String = "6f70656e6f6f64612d6d696e697369672d7370696b65";
    let sig: String = "e2c3e77aebc763c0e204ad586f3d6aa28c675867004e4360cf27733f81644efb8e3cab3a9ac7bf4ec2ebc0c13a63ef1a60d9cc4aeccde0589b7becca94879c0d";
    let pk: Result[String, String] = ed25519_pubkey_from_seed_hex(seed);
    if pk.is_err() {
        return Err("ed25519: pubkey derive failed");
    }
    let pk_hex: String = match pk { Ok(s) => s, Err(_) => "" };
    if pk_hex != pub_want {
        println("ed25519: pubkey mismatch got " + pk_hex);
        return Err("ed25519: pubkey mismatch");
    }
    if !ed25519_verify_hex(pk_hex, msg, sig) {
        return Err("ed25519: oracle signature rejected");
    }
    let bad_sig: String = "e2c3e77aebc763c0e204ad586f3d6aa28c675867004e4360cf27733f81644efb8e3cab3a9ac7bf4ec2ebc0c13a63ef1a60d9cc4aeccde0589b7becca94879c0e";
    if ed25519_verify_hex(pk_hex, msg, bad_sig) {
        return Err("ed25519: tampered signature accepted");
    }
    let bad_msg: String = "6f70656e6f6f64612d6d696e697369672d7370696b66";
    if ed25519_verify_hex(pk_hex, bad_msg, sig) {
        return Err("ed25519: wrong message accepted");
    }
    let s2: Result[String, String] = ed25519_sign_hex(seed, msg);
    if s2.is_err() {
        return Err("ed25519: sign failed");
    }
    let sig2: String = match s2 { Ok(s) => s, Err(_) => "" };
    if sig2 != sig {
        println("ed25519: sign mismatch got " + sig2);
        return Err("ed25519: sign mismatch");
    }
    println("probe: std ed25519 oracle ok");
    return Ok(0);
}
