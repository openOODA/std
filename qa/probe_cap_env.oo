// # Environment Variable 8-Dimensional Capability Verification Probe
//
// Logline: Verify all 8 capability dimensions (AST typing, parameter bounds, path routing, ambient rejection, concurrency, allocation drag, string fidelity, child isolation) for &EnvCap under Negative Trust.
//
// Setup: Requires &ProcessCap and &EnvCap. Evaluates 8 capability axes under Zero Ambient Authority.
//
// Beats:
//   1. Dimension 1 (Heuristic Hunter): Type-safe capability invocation under &EnvCap.
//   2. Dimension 2 (Boundary Falsifier): Parameter bounds and negative edge falsification.
//   3. Dimension 3 (Data-Path Tracer): Genuine runtime execution routing via oo_process_policy_getenv.
//   4. Dimension 4 (Hermetic Jailor): Absolute denial of unlisted ambient authority.
//   5. Dimension 5 (Temporal Saboteur): Sequential multi-query determinism and replay consistency.
//   6. Dimension 6 (Drag Assassin): Constant-time bounded execution and allocation stability.
//   7. Dimension 7 (Semantic Subverter): Exact byte string fidelity and fail-closed error formatting.
//   8. Dimension 8 (Byzantine Infiltrator): Subprocess environment scrubbing and PATH normalization.

import "std/fs/process/process.oo";
import "std/fs/process/env.oo";

fn probe_d1_ast_typing(env: &EnvCap) -> Result[Int, String] {
    let p_res: Int = env_probe();
    if p_res != 0 {
        return Err("D1 FAIL: env_probe returned non-zero");
    }
    return Ok(0);
}

fn probe_d2_bounds(env: &EnvCap) -> Result[Int, String] {
    let r_empty: Result[String, String] = env_get(env, "");
    if r_empty.is_ok() {
        return Err("D2 FAIL: 0-byte key must fail closed");
    }

    let mut big_key: String = "OODA_";
    let mut i: Int = 0;
    while i < 260 {
        big_key = big_key + "A";
        i = i + 1;
    }
    let r_big: Result[String, String] = env_get(env, big_key);
    if r_big.is_ok() {
        return Err("D2 FAIL: oversized key must fail closed");
    }

    let r_eq: Result[String, String] = env_get(env, "OODA_TEST=INJECTION");
    if r_eq.is_ok() {
        return Err("D2 FAIL: malformed key containing '=' must fail closed");
    }

    return Ok(0);
}

fn probe_d3_data_path(env: &EnvCap) -> Result[String, String] {
    let r_pwd: Result[String, String] = env_get(env, "PWD");
    if r_pwd.is_err() {
        return Err("D3 FAIL: whitelisted PWD returned Err");
    }
    let pwd_val: String = match r_pwd {
        Ok(v) => v,
        Err(_) => ""
    };
    if chars_len(pwd_val) == 0 {
        return Err("D3 FAIL: PWD returned empty string");
    }
    return Ok(pwd_val);
}

fn probe_d4_hermetic_jail(env: &EnvCap) -> Result[Int, String] {
    let r_home: Result[String, String] = env_get(env, "HOME");
    if r_home.is_ok() {
        return Err("D4 FAIL: ambient HOME must be denied without whitelist");
    }
    let r_user: Result[String, String] = env_get(env, "USER");
    if r_user.is_ok() {
        return Err("D4 FAIL: ambient USER must be denied without whitelist");
    }
    let r_shell: Result[String, String] = env_get(env, "SHELL");
    if r_shell.is_ok() {
        return Err("D4 FAIL: ambient SHELL must be denied without whitelist");
    }
    let r_aws: Result[String, String] = env_get(env, "AWS_SECRET_ACCESS_KEY");
    if r_aws.is_ok() {
        return Err("D4 FAIL: ambient AWS_SECRET_ACCESS_KEY must be denied");
    }
    let r_evil: Result[String, String] = env_get(env, "EVIL_TOKEN");
    if r_evil.is_ok() {
        return Err("D4 FAIL: ambient EVIL_TOKEN must be denied");
    }
    return Ok(0);
}

fn probe_d5_temporal_replay(env: &EnvCap, expected_pwd: String) -> Result[Int, String] {
    let mut k: Int = 0;
    while k < 30 {
        let r_rep: Result[String, String] = env_get(env, "PWD");
        let rep_val: String = match r_rep {
            Ok(v) => v,
            Err(_) => ""
        };
        if rep_val != expected_pwd {
            return Err("D5 FAIL: temporal drift detected in repeated env_get(PWD)");
        }
        k = k + 1;
    }
    return Ok(0);
}

fn probe_d6_drag_allocation(env: &EnvCap) -> Result[Int, String] {
    let mut m: Int = 0;
    while m < 100 {
        let _r: Result[String, String] = env_get(env, "OODA_DRAG_CHECK_BENCHMARK");
        m = m + 1;
    }
    return Ok(0);
}

fn probe_d7_semantic_subverter(env: &EnvCap) -> Result[Int, String] {
    let r_unset: Result[String, String] = env_get(env, "OODA_TOTALLY_UNSET_KEY_FOR_TEST");
    if r_unset.is_ok() {
        return Err("D7 FAIL: unset OODA_ key must return Err");
    }
    let err_unset: String = match r_unset {
        Ok(_) => "",
        Err(e) => e
    };
    if err_unset != "env var not set" {
        return Err("D7 FAIL: expected 'env var not set', got: " + err_unset);
    }
    return Ok(0);
}

fn probe_d8_byzantine_isolation(p: &ProcessCap) -> Result[Int, String] {
    let r_sh: Result[String, String] = process_exec(p, "env");
    if r_sh.is_err() {
        return Err("D8 FAIL: process_exec failed under &ProcessCap");
    }
    let env_dump: String = match r_sh {
        Ok(s) => s,
        Err(_) => ""
    };
    if str_contains(env_dump, "EVIL_TOKEN=") {
        return Err("D8 FAIL: child environment leaked EVIL_TOKEN");
    }
    return Ok(0);
}

pub fn main(p: &ProcessCap, env: &EnvCap) -> Result[Int, String] {
    let r1: Result[Int, String] = probe_d1_ast_typing(env);
    if r1.is_err() { return r1; }

    let r2: Result[Int, String] = probe_d2_bounds(env);
    if r2.is_err() { return r2; }

    let r3: Result[String, String] = probe_d3_data_path(env);
    if r3.is_err() {
        let e3: String = match r3 { Ok(_) => "", Err(s) => s };
        return Err(e3);
    }
    let pwd_val: String = match r3 { Ok(s) => s, Err(_) => "" };

    let r4: Result[Int, String] = probe_d4_hermetic_jail(env);
    if r4.is_err() { return r4; }

    let r5: Result[Int, String] = probe_d5_temporal_replay(env, pwd_val);
    if r5.is_err() { return r5; }

    let r6: Result[Int, String] = probe_d6_drag_allocation(env);
    if r6.is_err() { return r6; }

    let r7: Result[Int, String] = probe_d7_semantic_subverter(env);
    if r7.is_err() { return r7; }

    let r8: Result[Int, String] = probe_d8_byzantine_isolation(p);
    if r8.is_err() { return r8; }

    println("probe: std/qa probe_cap_env passed (8-D Negative-Trust verified)");
    return Ok(0);
}
