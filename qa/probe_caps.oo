// # Caller Capability Rights Verification Probe
//
// Logline: Verify CallerCaps token parsing, subcommand permission admission, and fail-closed denial reason generation.
//
// Setup: Pure verification of standard library agent caller capability tokens.
//
// Beats:
//   1. Parse read-only caller capability set ("read") and verify write denial.
//   2. Parse read/write capability set ("read,write") and verify admin admittance.
//   3. Parse omnipotent capability set ("all") and verify universal admittance.
//   4. Assert caller_caps_denial_reason produces precise error diagnostics.

import "app/agent/token/caller_caps.oo";

pub fn main() -> Result[Int, String] {
    let r_caps: CallerCaps = caller_caps_parse("read");
    if !r_caps.has_read {
        return Err("probe_caps: caller_caps_parse('read') must set has_read=true");
    }
    if r_caps.has_write || r_caps.has_exec {
        return Err("probe_caps: caller_caps_parse('read') must not grant write or exec");
    }
    if !caller_caps_admits(r_caps, "status") {
        return Err("probe_caps: read caps must admit 'status'");
    }
    if !caller_caps_admits(r_caps, "report") {
        return Err("probe_caps: read caps must admit 'report'");
    }
    if caller_caps_admits(r_caps, "calibrate") {
        return Err("probe_caps: read caps must deny 'calibrate'");
    }
    if caller_caps_admits(r_caps, "fix") {
        return Err("probe_caps: read caps must deny 'fix'");
    }

    let reason: String = caller_caps_denial_reason(r_caps, "calibrate");
    if !str_contains(reason, "missing required cap='write'") {
        return Err("probe_caps: denial reason must explain missing write cap: " + reason);
    }

    let rw_caps: CallerCaps = caller_caps_parse("read,write");
    if !rw_caps.has_read || !rw_caps.has_write {
        return Err("probe_caps: caller_caps_parse('read,write') failed");
    }
    if !caller_caps_admits(rw_caps, "calibrate") {
        return Err("probe_caps: read,write caps must admit 'calibrate'");
    }
    if !caller_caps_admits(rw_caps, "fix") {
        return Err("probe_caps: read,write caps must admit 'fix'");
    }
    if caller_caps_admits(rw_caps, "shell_exec") {
        return Err("probe_caps: read,write caps must deny 'shell_exec'");
    }

    let all_caps: CallerCaps = caller_caps_parse("all");
    if !all_caps.has_read || !all_caps.has_write || !all_caps.has_exec {
        return Err("probe_caps: caller_caps_parse('all') failed");
    }
    if !caller_caps_admits(all_caps, "shell_exec") {
        return Err("probe_caps: all caps must admit 'shell_exec'");
    }
    let all2: CallerCaps = caller_caps_parse("ALL");
    if !all2.has_exec {
        return Err("probe_caps: 'ALL' must grant everything");
    }
    let star: CallerCaps = caller_caps_parse("*");
    if !star.has_read || !star.has_write || !star.has_exec {
        return Err("probe_caps: '*' must grant everything");
    }
    let sub: CallerCaps = caller_caps_parse("readonly");
    if sub.has_read || sub.has_write || sub.has_exec {
        return Err("probe_caps: 'readonly' must not grant read (token boundary)");
    }
    let wronly: CallerCaps = caller_caps_new(false, true, false, "write");
    if caller_caps_admits(wronly, "calibrate") {
        return Err("probe_caps: write without read must deny 'calibrate'");
    }
    if caller_caps_admits(wronly, "fix") {
        return Err("probe_caps: write without read must deny 'fix'");
    }
    if !caller_caps_admits(all_caps, "frobnicate") {
        return Err("probe_caps: unknown sub must require exec (all admits)");
    }
    if caller_caps_admits(r_caps, "frobnicate") {
        return Err("probe_caps: unknown sub must deny read caps");
    }
    if caller_caps_denial_reason(r_caps, "status") != "" {
        return Err("probe_caps: admitted sub must have empty denial reason");
    }
    let def: CallerCaps = caller_caps_default();
    if !def.has_read || def.has_write {
        return Err("probe_caps: default must be read-only");
    }
    if sub_required_caps("status") != "read" || sub_required_caps("fix") != "write" || sub_required_caps("shell_exec") != "exec" {
        return Err("probe_caps: sub_required_caps mapping mismatch");
    }

    println("probe: std/qa probe_caps passed (CallerCaps permissions verified)");
    return Ok(0);
}
