// # Network Capability Token Verification Probe
//
// Logline: Verify that &TcpCap gates network operations, wire request building adheres to capability contracts, and connections fail closed.
//
// Setup: Requires &TcpCap.
//
// Beats:
//   1. Build deterministic HTTP/1.1 wire request via http_cap_build_request.
//   2. Attempt loopback connect to unassigned port via net_tcp_connect (&TcpCap).
//   3. Assert connection fails closed gracefully without panics.

import "net/http_cap.oo";
import "net/tcp.oo";

pub fn main(tcp: &TcpCap) -> Result[Int, String] {
    let req: String = http_cap_build_request("127.0.0.1", 8080, "GET", "/cap_probe", list_new(), "");
    if !str_contains(req, "GET /cap_probe HTTP/1.1") {
        return Err("cap_net: request builder failed to emit method and path");
    }
    if !str_contains(req, "Host: 127.0.0.1:8080") {
        return Err("cap_net: request builder failed to emit Host header");
    }

    // Connect to closed loopback port: must return Result (Err on refusal) under &TcpCap
    let conn: Result[String, String] = net_tcp_connect(tcp, "127.0.0.1", 1);
    // Port 1 is closed; either an Err (connection refused) or Ok is valid OS behavior, but must not crash
    if conn.is_ok() {
        let fd_str: String = match conn { Ok(f) => f, Err(_) => "" };
        if chars_len(fd_str) == 0 {
            return Err("cap_net: unexpected empty descriptor returned on Ok");
        }
    }

    println("probe: std/qa cap_net passed (&TcpCap verified)");
    return Ok(0);
}
