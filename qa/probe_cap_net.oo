// # Network Capability Token Verification Probe
//
// Logline: Verify that &TcpCap gates network operations, request building
// emits exact wire bytes, and every failure mode fails closed with Err.
//
// Setup: Requires &TcpCap. No listener needed: all network assertions are
// deterministic failures (refused/invalid), never timing-dependent.
//
// Beats:
//   1. Build exact HTTP/1.1 wire bytes (GET, POST+body, extra headers).
//   2. Closed loopback port refuses: connect returns Err, no crash.
//   3. Invalid IP literal and port 0 fail closed.
//   4. Write/read on a bogus fd fail closed (no close API: fds are owned).

import "net/http_cap.oo";
import "net/tcp.oo";

pub fn main(tcp: &TcpCap) -> Result[Int, String] {
    let req: String = http_cap_build_request("127.0.0.1", 8080, "GET", "/cap_probe", list_new(), "");
    if req != "GET /cap_probe HTTP/1.1\r\nHost: 127.0.0.1:8080\r\nUser-Agent: openOODA-Net/1.0\r\nAccept: */*\r\nConnection: close\r\n\r\n" {
        return Err("cap_net: GET wire bytes mismatch got " + req);
    }
    let post: String = http_cap_build_request("h", 80, "POST", "/s", list_new(), "hi");
    if post != "POST /s HTTP/1.1\r\nHost: h:80\r\nUser-Agent: openOODA-Net/1.0\r\nAccept: */*\r\nConnection: close\r\nContent-Length: 2\r\n\r\nhi" {
        return Err("cap_net: POST wire bytes mismatch");
    }
    let mut hdrs: List[String] = list_new();
    hdrs = list_push(hdrs, "X-A: b");
    let custom: String = http_cap_build_request("h", 80, "GET", "/", hdrs, "");
    if !str_contains(custom, "X-A: b\r\n") {
        return Err("cap_net: custom header missing from wire bytes");
    }
    let conn: Result[String, String] = net_tcp_connect(tcp, "127.0.0.1", 1);
    if conn.is_ok() {
        return Err("cap_net: closed loopback port must refuse");
    }
    if net_tcp_connect(tcp, "256.256.256.256", 80).is_ok() {
        return Err("cap_net: invalid IP literal must fail closed");
    }
    if net_tcp_connect(tcp, "127.0.0.1", 0).is_ok() {
        return Err("cap_net: port 0 must fail closed");
    }
    if net_tcp_write(tcp, 0 - 1, "x").is_ok() {
        return Err("cap_net: write to bogus fd must fail closed");
    }
    if net_tcp_read(tcp, 0 - 1, 16).is_ok() {
        return Err("cap_net: read from bogus fd must fail closed");
    }
    println("probe: std/qa cap_net passed (&TcpCap verified)");
    return Ok(0);
}
