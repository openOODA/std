// # Shamir Secret Sharing over GF(256)
//
// Logline: Threshold secret sharing scheme splitting secrets into n polynomial evaluations with k-threshold reconstruction.
//
// Setup: Pure finite field arithmetic over GF(2^8) with irreducible polynomial 0x11B.
//
// Beats:
//   1. Implement GF(256) addition (XOR) and polynomial multiplication.
//   2. Implement GF(256) multiplicative inverse via Fermat's Little Theorem (a^254).
//   3. Generate n secret shares via degree (k-1) polynomial evaluation.
//   4. Reconstruct secret from any k shares via Lagrange basis interpolation.

type SecretShare = struct {
    x_val: Int,
    y_val: Int
};

pub fn gf256_add(a: Int, b: Int) -> Int {
    return (a ^ b) & 255;
}

pub fn gf256_mul(a: Int, b: Int) -> Int {
    let mut p: Int = 0;
    let mut val_a: Int = a & 255;
    let mut val_b: Int = b & 255;
    let mut i: Int = 0;
    while i < 8 {
        if (val_b & 1) != 0 {
            p = p ^ val_a;
        }
        let high_bit_set: Bool = (val_a & 128) != 0;
        val_a = (val_a << 1) & 255;
        if high_bit_set {
            val_a = val_a ^ 27; // 0x1B reduction polynomial
        }
        val_b = val_b >> 1;
        i = i + 1;
    }
    return p & 255;
}

pub fn gf256_inv(a: Int) -> Result[Int, String] {
    let val: Int = a & 255;
    if val == 0 {
        return Err("ERR\tgf256_inv\tdivision_by_zero");
    }
    // a^254 in GF(256)
    let mut res: Int = 1;
    let mut base: Int = val;
    let mut exp: Int = 254;
    while exp > 0 {
        if (exp & 1) != 0 {
            res = gf256_mul(res, base);
        }
        base = gf256_mul(base, base);
        exp = exp >> 1;
    }
    return Ok(res);
}

pub fn shamir_share_byte(secret: Int, k: Int, n: Int, coeffs: List[Int]) -> Result[List[SecretShare], String] {
    if k < 1 || k > n {
        return Err("ERR\tshamir_share_byte\tinvalid_threshold");
    }
    if list_len(coeffs) != (k - 1) {
        return Err("ERR\tshamir_share_byte\tincorrect_coefficient_count");
    }
    let mut shares: List[SecretShare] = list_new();
    let mut x: Int = 1;
    while x <= n {
        let mut y: Int = secret & 255;
        let mut x_pow: Int = x;
        let mut c_idx: Int = 0;
        while c_idx < (k - 1) {
            let coef: Int = list_get(coeffs, c_idx) & 255;
            let term: Int = gf256_mul(coef, x_pow);
            y = gf256_add(y, term);
            x_pow = gf256_mul(x_pow, x);
            c_idx = c_idx + 1;
        }
        let sh: SecretShare = SecretShare {
            x_val: x,
            y_val: y
        };
        shares = list_push(shares, sh);
        x = x + 1;
    }
    return Ok(shares);
}

pub fn shamir_reconstruct_byte(shares: List[SecretShare], k: Int) -> Result[Int, String] {
    let num_shares: Int = list_len(shares);
    if num_shares < k {
        return Err("ERR\tshamir_reconstruct_byte\tinsufficient_shares");
    }
    let mut secret: Int = 0;
    let mut i: Int = 0;
    while i < k {
        let s_i: SecretShare = list_get(shares, i);
        let mut num: Int = 1;
        let mut den: Int = 1;
        let mut j: Int = 0;
        while j < k {
            if i != j {
                let s_j: SecretShare = list_get(shares, j);
                num = gf256_mul(num, s_j.x_val);
                let diff: Int = gf256_add(s_j.x_val, s_i.x_val);
                den = gf256_mul(den, diff);
            }
            j = j + 1;
        }
        let inv_den_res: Result[Int, String] = gf256_inv(den);
        match inv_den_res {
            Ok(inv_den) => {
                let basis: Int = gf256_mul(num, inv_den);
                let term: Int = gf256_mul(s_i.y_val, basis);
                secret = gf256_add(secret, term);
            }
            Err(e) => {
                return Err(e);
            }
        }
        i = i + 1;
    }
    return Ok(secret);
}
