// # FIPS 203 ML-KEM Parameters and Core Types
//
// Logline: Defines ML-KEM parameter sets, cryptographic key containers, and ciphertext records for NIST FIPS 203.
//
// Setup: Pure algebraic parameter module supporting ML-KEM-512, ML-KEM-768, and ML-KEM-1024.
//
// Beats:
//   1. Declare parameter struct containing module rank, noise parameters, and bit-compression widths.
//   2. Declare public key, private key, ciphertext, and key pair record structures.
//   3. Implement parameter preset factories for security categories 1, 3, and 5.
//   4. Provide byte-length validation and structural integrity helpers.

type MlKemParams = struct {
    k: Int,
    q: Int,
    eta1: Int,
    eta2: Int,
    du: Int,
    dv: Int,
    pk_size: Int,
    sk_size: Int,
    ct_size: Int,
    ss_size: Int
};

type MlKemPublicKey = struct {
    k: Int,
    seed_rho: List[Int],
    t_coeffs: List[Int],
    raw_bytes: List[Int],
    is_valid: Bool
};

type MlKemPrivateKey = struct {
    k: Int,
    s_coeffs: List[Int],
    pk: MlKemPublicKey,
    hpk: List[Int],
    z_rand: List[Int],
    raw_bytes: List[Int]
};

type MlKemCiphertext = struct {
    k: Int,
    c1_coeffs: List[Int],
    c2_coeffs: List[Int],
    raw_bytes: List[Int],
    length_bytes: Int
};

type MlKemSharedSecret = struct {
    secret_bytes: List[Int],
    length_bytes: Int,
    is_established: Bool
};

type MlKemKeyPair = struct {
    pk: MlKemPublicKey,
    sk: MlKemPrivateKey,
    security_level: Int
};

pub fn ml_kem_params_512() -> MlKemParams {
    return MlKemParams {
        k: 2,
        q: 3329,
        eta1: 3,
        eta2: 2,
        du: 10,
        dv: 4,
        pk_size: 800,
        sk_size: 1632,
        ct_size: 768,
        ss_size: 32
    };
}

pub fn ml_kem_params_768() -> MlKemParams {
    return MlKemParams {
        k: 3,
        q: 3329,
        eta1: 2,
        eta2: 2,
        du: 10,
        dv: 4,
        pk_size: 1184,
        sk_size: 2400,
        ct_size: 1088,
        ss_size: 32
    };
}

pub fn ml_kem_params_1024() -> MlKemParams {
    return MlKemParams {
        k: 4,
        q: 3329,
        eta1: 2,
        eta2: 2,
        du: 11,
        dv: 5,
        pk_size: 1568,
        sk_size: 3168,
        ct_size: 1568,
        ss_size: 32
    };
}

pub fn ml_kem_params_by_k(k: Int) -> MlKemParams {
    if k == 2 {
        return ml_kem_params_512();
    }
    if k == 3 {
        return ml_kem_params_768();
    }
    return ml_kem_params_1024();
}

pub fn ml_kem_public_key_new(k: Int) -> MlKemPublicKey {
    return MlKemPublicKey {
        k: k,
        seed_rho: list_new(),
        t_coeffs: list_new(),
        raw_bytes: list_new(),
        is_valid: false
    };
}

pub fn ml_kem_private_key_new(k: Int) -> MlKemPrivateKey {
    let empty_pk: MlKemPublicKey = ml_kem_public_key_new(k);
    return MlKemPrivateKey {
        k: k,
        s_coeffs: list_new(),
        pk: empty_pk,
        hpk: list_new(),
        z_rand: list_new(),
        raw_bytes: list_new()
    };
}

pub fn ml_kem_ciphertext_new(k: Int, length_bytes: Int) -> MlKemCiphertext {
    return MlKemCiphertext {
        k: k,
        c1_coeffs: list_new(),
        c2_coeffs: list_new(),
        raw_bytes: list_new(),
        length_bytes: length_bytes
    };
}

pub fn ml_kem_shared_secret_new(bytes: List[Int]) -> MlKemSharedSecret {
    return MlKemSharedSecret {
        secret_bytes: bytes,
        length_bytes: list_len(bytes),
        is_established: true
    };
}

pub fn ml_kem_key_pair_new(pk: MlKemPublicKey, sk: MlKemPrivateKey, level: Int) -> MlKemKeyPair {
    return MlKemKeyPair {
        pk: pk,
        sk: sk,
        security_level: level
    };
}
