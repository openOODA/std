// # FIPS 203 ML-KEM Compression & Bit-Packing Subsystem
//
// Logline: Implements lossy Compress_d/Decompress_d and exact bit-packing encoders and decoders for d in {1, 5, 11, 12}.
//
// Setup: FIPS 203 Algorithms 4, 5, ByteEncode_d, and ByteDecode_d for ML-KEM-1024.
//
// Beats:
//   1. Implement integer and polynomial Compress_d and Decompress_d functions.
//   2. Implement 12-bit ByteEncode12 and ByteDecode12 (384 bytes per poly).
//   3. Implement 11-bit ByteEncode11 and ByteDecode11 (352 bytes per poly).
//   4. Implement 5-bit ByteEncode5, ByteDecode5 (160 bytes), and 1-bit ByteEncode1, ByteDecode1 (32 bytes).

import "./ml_kem_poly.oo";

pub fn ml_kem_compress_int(x: Int, d: Int) -> Int {
    let two_d: Int = 1 << d;
    let num: Int = two_d * ml_kem_poly_mod(x) + 1664;
    let div: Int = num / 3329;
    return div & (two_d - 1);
}

pub fn ml_kem_decompress_int(y: Int, d: Int) -> Int {
    let two_d: Int = 1 << d;
    let half: Int = 1 << (d - 1);
    let num: Int = 3329 * (y & (two_d - 1)) + half;
    return num / two_d;
}

pub fn ml_kem_poly_compress(p: MlKemPoly, d: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let c: Int = list_get(p.coeffs, i);
        out = list_push(out, ml_kem_compress_int(c, d));
        i = i + 1;
    }
    return out;
}

pub fn ml_kem_poly_decompress(c: List[Int], d: Int) -> MlKemPoly {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let v: Int = list_get(c, i);
        out = list_push(out, ml_kem_decompress_int(v, d));
        i = i + 1;
    }
    return MlKemPoly { coeffs: out, degree: 256, modulus: 3329 };
}

pub fn ml_kem_encode_12(coeffs: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 128 {
        let c0: Int = list_get(coeffs, 2 * i) & 4095;
        let c1: Int = list_get(coeffs, 2 * i + 1) & 4095;
        out = list_push(out, c0 & 255);
        out = list_push(out, (c0 >> 8) | ((c1 & 15) << 4));
        out = list_push(out, (c1 >> 4) & 255);
        i = i + 1;
    }
    return out;
}

pub fn ml_kem_decode_12(bytes: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 128 {
        let b0: Int = list_get(bytes, 3 * i);
        let b1: Int = list_get(bytes, 3 * i + 1);
        let b2: Int = list_get(bytes, 3 * i + 2);
        let c0: Int = b0 | ((b1 & 15) << 8);
        let c1: Int = (b1 >> 4) | (b2 << 4);
        out = list_push(out, c0);
        out = list_push(out, c1);
        i = i + 1;
    }
    return out;
}

pub fn ml_kem_encode_11(coeffs: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        let c0: Int = list_get(coeffs, 8 * i) & 2047;
        let c1: Int = list_get(coeffs, 8 * i + 1) & 2047;
        let c2: Int = list_get(coeffs, 8 * i + 2) & 2047;
        let c3: Int = list_get(coeffs, 8 * i + 3) & 2047;
        let c4: Int = list_get(coeffs, 8 * i + 4) & 2047;
        let c5: Int = list_get(coeffs, 8 * i + 5) & 2047;
        let c6: Int = list_get(coeffs, 8 * i + 6) & 2047;
        let c7: Int = list_get(coeffs, 8 * i + 7) & 2047;

        out = list_push(out, c0 & 255);
        out = list_push(out, ((c0 >> 8) | (c1 << 3)) & 255);
        out = list_push(out, ((c1 >> 5) | (c2 << 6)) & 255);
        out = list_push(out, (c2 >> 2) & 255);
        out = list_push(out, ((c2 >> 10) | (c3 << 1)) & 255);
        out = list_push(out, ((c3 >> 7) | (c4 << 4)) & 255);
        out = list_push(out, ((c4 >> 4) | (c5 << 7)) & 255);
        out = list_push(out, (c5 >> 1) & 255);
        out = list_push(out, ((c5 >> 9) | (c6 << 2)) & 255);
        out = list_push(out, ((c6 >> 6) | (c7 << 5)) & 255);
        out = list_push(out, (c7 >> 3) & 255);
        i = i + 1;
    }
    return out;
}

pub fn ml_kem_decode_11(bytes: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        let off: Int = 11 * i;
        let b0: Int = list_get(bytes, off);
        let b1: Int = list_get(bytes, off + 1);
        let b2: Int = list_get(bytes, off + 2);
        let b3: Int = list_get(bytes, off + 3);
        let b4: Int = list_get(bytes, off + 4);
        let b5: Int = list_get(bytes, off + 5);
        let b6: Int = list_get(bytes, off + 6);
        let b7: Int = list_get(bytes, off + 7);
        let b8: Int = list_get(bytes, off + 8);
        let b9: Int = list_get(bytes, off + 9);
        let b10: Int = list_get(bytes, off + 10);

        let c0: Int = (b0 | (b1 << 8)) & 2047;
        let c1: Int = ((b1 >> 3) | (b2 << 5)) & 2047;
        let c2: Int = ((b2 >> 6) | (b3 << 2) | (b4 << 10)) & 2047;
        let c3: Int = ((b4 >> 1) | (b5 << 7)) & 2047;
        let c4: Int = ((b5 >> 4) | (b6 << 4)) & 2047;
        let c5: Int = ((b6 >> 7) | (b7 << 1) | (b8 << 9)) & 2047;
        let c6: Int = ((b8 >> 2) | (b9 << 6)) & 2047;
        let c7: Int = ((b9 >> 5) | (b10 << 3)) & 2047;

        out = list_push(out, c0);
        out = list_push(out, c1);
        out = list_push(out, c2);
        out = list_push(out, c3);
        out = list_push(out, c4);
        out = list_push(out, c5);
        out = list_push(out, c6);
        out = list_push(out, c7);
        i = i + 1;
    }
    return out;
}

pub fn ml_kem_encode_5(coeffs: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        let c0: Int = list_get(coeffs, 8 * i) & 31;
        let c1: Int = list_get(coeffs, 8 * i + 1) & 31;
        let c2: Int = list_get(coeffs, 8 * i + 2) & 31;
        let c3: Int = list_get(coeffs, 8 * i + 3) & 31;
        let c4: Int = list_get(coeffs, 8 * i + 4) & 31;
        let c5: Int = list_get(coeffs, 8 * i + 5) & 31;
        let c6: Int = list_get(coeffs, 8 * i + 6) & 31;
        let c7: Int = list_get(coeffs, 8 * i + 7) & 31;

        out = list_push(out, (c0 | (c1 << 5)) & 255);
        out = list_push(out, ((c1 >> 3) | (c2 << 2) | (c3 << 7)) & 255);
        out = list_push(out, ((c3 >> 1) | (c4 << 4)) & 255);
        out = list_push(out, ((c4 >> 4) | (c5 << 1) | (c6 << 6)) & 255);
        out = list_push(out, ((c6 >> 2) | (c7 << 3)) & 255);
        i = i + 1;
    }
    return out;
}

pub fn ml_kem_decode_5(bytes: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        let off: Int = 5 * i;
        let b0: Int = list_get(bytes, off);
        let b1: Int = list_get(bytes, off + 1);
        let b2: Int = list_get(bytes, off + 2);
        let b3: Int = list_get(bytes, off + 3);
        let b4: Int = list_get(bytes, off + 4);

        let c0: Int = b0 & 31;
        let c1: Int = ((b0 >> 5) | (b1 << 3)) & 31;
        let c2: Int = (b1 >> 2) & 31;
        let c3: Int = ((b1 >> 7) | (b2 << 1)) & 31;
        let c4: Int = ((b2 >> 4) | (b3 << 4)) & 31;
        let c5: Int = (b3 >> 1) & 31;
        let c6: Int = ((b3 >> 6) | (b4 << 2)) & 31;
        let c7: Int = (b4 >> 3) & 31;

        out = list_push(out, c0);
        out = list_push(out, c1);
        out = list_push(out, c2);
        out = list_push(out, c3);
        out = list_push(out, c4);
        out = list_push(out, c5);
        out = list_push(out, c6);
        out = list_push(out, c7);
        i = i + 1;
    }
    return out;
}

pub fn ml_kem_encode_1(coeffs: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        let mut b: Int = 0;
        let mut j: Int = 0;
        while j < 8 {
            let bit: Int = list_get(coeffs, 8 * i + j) & 1;
            b = b | (bit << j);
            j = j + 1;
        }
        out = list_push(out, b);
        i = i + 1;
    }
    return out;
}

pub fn ml_kem_decode_1(bytes: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        let b: Int = list_get(bytes, i);
        let mut j: Int = 0;
        while j < 8 {
            out = list_push(out, (b >> j) & 1);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}
