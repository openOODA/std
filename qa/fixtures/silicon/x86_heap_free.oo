// # X86 Heap Free
//
// Logline: Standard library verification and domain capabilities for X86 Heap Free.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn verify_x86_heap_free() -> Bool {
    let p1 = oo_alloc(32);
    oo_write_int(p1, 100);
    oo_free(p1);
    let p2 = oo_alloc(32);
    oo_write_int(p2, 200);
    println(oo_read_int(p2));
    return true;
}
