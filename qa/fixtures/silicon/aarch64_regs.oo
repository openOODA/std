// # AArch64 Architecture Register Definitions and Condition Codes
//
// Logline: Hardware register mappings, condition flags, and operand field extractors for 64-bit ARM architecture.
//
// Setup: Pure architecture definitions for ARMv8-A / ARM64 processors.
//
// Beats:
//   1. Define 64-bit general purpose registers X0 through X30.
//   2. Define Stack Pointer (SP) and Zero Register XZR.
//   3. Define standard AArch64 condition codes (EQ, NE, CS, CC, MI, PL, VS, VC, HI, LS, GE, LT, GT, LE, AL).
//   4. Validate register indices and condition ranges.

pub fn arm64_x0() -> Int { return 0; }
pub fn arm64_x1() -> Int { return 1; }
pub fn arm64_x2() -> Int { return 2; }
pub fn arm64_x3() -> Int { return 3; }
pub fn arm64_x4() -> Int { return 4; }
pub fn arm64_x5() -> Int { return 5; }
pub fn arm64_x6() -> Int { return 6; }
pub fn arm64_x7() -> Int { return 7; }
pub fn arm64_x8() -> Int { return 8; }
pub fn arm64_x16() -> Int { return 16; }
pub fn arm64_x29() -> Int { return 29; } // FP
pub fn arm64_x30() -> Int { return 30; } // LR
pub fn arm64_sp() -> Int { return 31; }
pub fn arm64_xzr() -> Int { return 31; }

pub fn arm64_cond_eq() -> Int { return 0; }
pub fn arm64_cond_ne() -> Int { return 1; }
pub fn arm64_cond_ge() -> Int { return 10; }
pub fn arm64_cond_lt() -> Int { return 11; }
pub fn arm64_cond_gt() -> Int { return 12; }
pub fn arm64_cond_le() -> Int { return 13; }
pub fn arm64_cond_al() -> Int { return 14; }

pub fn arm64_is_valid_reg(reg: Int) -> Bool {
    return reg >= 0 && reg <= 31;
}
