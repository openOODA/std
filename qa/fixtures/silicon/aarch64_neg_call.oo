// # Unary-minus of a call is leftover
//
// Logline: println(-foo()) must fail closed and not emit a silent omit.
//
// Setup: foo is a call, not a same-fn int let.
//
// Beats:
//   1. Bind nothing.
//   2. Print -foo().
//   3. Emit must ERR leftover.

fn foo() -> Int { return 1; }

pub fn verify_aarch64_neg_call() -> Bool {
    println(-foo());
    return true;
}
