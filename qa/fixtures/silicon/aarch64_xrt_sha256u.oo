// # AArch64 SHA-256 Round2 Ch Temp1 And Maj
//
// Logline: Finishes one SHA-256 round: ch, K, W, S0, maj, then rotates work[].
//
// Setup: x0 work, x1 W, x2 K, x3 i, x4 S1. Uses __sha_be4 and __sha_rotr.
//
// Beats:
//   1. ch = (e and f) xor ((not e) and g).
//   2. temp1 = h + S1 + ch + K[i] + W[i] masked.
//   3. temp2 = S0(a) + maj.
//   4. Shift a..h and store; HMAC in sha256v.

import "std/hw/silicon/aarch64_encoder.oo";
import "std/hw/silicon/aarch64_encode_mem.oo";
import "std/hw/silicon/aarch64_parse.oo";
import "std/hw/silicon/aarch64_xstate.oo";
import "std/hw/silicon/aarch64_xrt.oo";
import "std/hw/silicon/aarch64_xrt_sha256v.oo";

pub fn a64rt_sha256u(r0: A64R) -> A64R {
    let mut r: A64R = a64rt_fn(r0, "__sha_round2");
    let mut x: A64X = a64rt_prol(r.x);
    x = a64x_emit(x, arm64_word_sub_imm(31, 31, 64));
    x = a64x_emit(x, arm64_word_str(0, 31, 0));
    x = a64x_emit(x, arm64_word_str(1, 31, 8));
    x = a64x_emit(x, arm64_word_str(2, 31, 16));
    x = a64x_emit(x, arm64_word_str(3, 31, 24));
    x = a64x_emit(x, arm64_word_str(4, 31, 32));
    x = a64x_emit(x, arm64_word_ldr(9, 0, 32));
    x = a64x_emit(x, arm64_word_ldr(10, 0, 40));
    x = a64x_emit(x, arm64_word_and_reg(11, 9, 10));
    x = a64x_emit(x, arm64_word_movz(2, 65535, 0));
    x = a64x_emit(x, arm64_word_movk(2, 65535, 1));
    x = a64x_emit(x, arm64_word_eor_reg(12, 9, 2));
    x = a64x_emit(x, arm64_word_ldr(10, 0, 48));
    x = a64x_emit(x, arm64_word_and_reg(12, 12, 10));
    x = a64x_emit(x, arm64_word_eor_reg(11, 11, 12));
    x = a64x_emit(x, arm64_word_ldr(10, 0, 56));
    x = a64x_emit(x, arm64_word_add_reg(11, 11, 10));
    x = a64x_emit(x, arm64_word_ldr(10, 31, 32));
    x = a64x_emit(x, arm64_word_add_reg(11, 11, 10));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 16));
    x = a64x_emit(x, arm64_word_ldr(1, 31, 24));
    x = a64x_emit(x, arm64_word_movz(2, 2, 0));
    x = a64x_emit(x, arm64_word_lsl_reg(2, 1, 2));
    x = a64x_emit(x, arm64_word_add_reg(0, 0, 2));
    x = a64x_bl(x, "__sha_be4");
    x = a64x_emit(x, arm64_word_add_reg(11, 11, 0));
    x = a64x_emit(x, arm64_word_ldr(2, 31, 8));
    x = a64x_emit(x, arm64_word_ldr(1, 31, 24));
    x = a64x_emit(x, arm64_word_movz(3, 3, 0));
    x = a64x_emit(x, arm64_word_lsl_reg(3, 1, 3));
    x = a64x_emit(x, arm64_word_add_reg(2, 2, 3));
    x = a64x_emit(x, arm64_word_ldr(0, 2, 0));
    x = a64x_emit(x, arm64_word_add_reg(11, 11, 0));
    x = a64x_emit(x, arm64_word_movz(2, 65535, 0));
    x = a64x_emit(x, arm64_word_movk(2, 65535, 1));
    x = a64x_emit(x, arm64_word_and_reg(11, 11, 2));
    x = a64x_emit(x, arm64_word_str(11, 31, 40));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 0));
    x = a64x_emit(x, arm64_word_mov_reg(1, 11));
    x = a64x_bl(x, "__sha_round3");
    x = a64x_emit(x, arm64_word_add_imm(31, 31, 64));
    r = a64rt_setx(r, a64rt_epi(x));
    return a64rt_sha256v(r);
}
