// # ALU plus println is leftover
//
// Logline: println(1+2) must fail closed and not emit a silent 1.
//
// Setup: Side emit-aarch64 does not fold ALU. Whole call is leftover.
//
// Beats:
//   1. Print 1 plus 2.
//   2. Emit must ERR leftover.
//   3. No _start omit.

pub fn verify_aarch64_alu_leftover() -> Bool {
    println(1 + 2);
    return true;
}
