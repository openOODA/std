// # X86 While Loop
//
// Logline: Standard library verification and domain capabilities for X86 While Loop.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn verify_x86_while_loop() -> Bool {
    let mut x: Int = 0;
    while x < 2 {
        x = x + 1;
        println("loop");
    }
    return true;
}
