// # AArch64 SHA-256 Round Mixer
//
// Logline: 64 rounds of S1/ch/temp1 and S0/maj/temp2 updating work[0..7].
//
// Setup: x0 work, x1 W, x2 K. K words are packed big-endian bytes.
//
// Beats:
//   1. Load a..h from work each round.
//   2. temp1 = h + S1(e) + ch + K[i] + W[i].
//   3. temp2 = S0(a) + maj; rotate the working variables.
//   4. HMAC is a64rt_sha256u.

import "std/hw/silicon/aarch64_encoder.oo";
import "std/hw/silicon/aarch64_encode_mem.oo";
import "std/hw/silicon/aarch64_parse.oo";
import "std/hw/silicon/aarch64_xstate.oo";
import "std/hw/silicon/aarch64_xrt.oo";
import "std/hw/silicon/aarch64_xrt_sha256u.oo";

pub fn a64rt_sha256t(r0: A64R) -> A64R {
    let mut r: A64R = a64rt_fn(r0, "__sha_rounds");
    let mut x: A64X = a64rt_prol(r.x);
    x = a64x_emit(x, arm64_word_sub_imm(31, 31, 48));
    x = a64x_emit(x, arm64_word_str(0, 31, 0));
    x = a64x_emit(x, arm64_word_str(1, 31, 8));
    x = a64x_emit(x, arm64_word_str(2, 31, 16));
    x = a64x_emit(x, arm64_word_movz(0, 0, 0));
    x = a64x_emit(x, arm64_word_str(0, 31, 24));
    let lp: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_ldr(11, 31, 24));
    x = a64x_emit(x, arm64_word_movz(0, 64, 0));
    x = a64x_emit(x, arm64_word_cmp_reg(11, 0));
    let bd: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b_cond(arm64_cond_eq(), 0));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 0));
    x = a64x_emit(x, arm64_word_ldr(1, 0, 32));
    x = a64x_emit(x, arm64_word_str(1, 31, 32));
    x = a64x_emit(x, arm64_word_mov_reg(0, 1));
    x = a64x_emit(x, arm64_word_movz(1, 6, 0));
    x = a64x_bl(x, "__sha_rotr");
    x = a64x_emit(x, arm64_word_mov_reg(10, 0));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 32));
    x = a64x_emit(x, arm64_word_movz(1, 11, 0));
    x = a64x_bl(x, "__sha_rotr");
    x = a64x_emit(x, arm64_word_eor_reg(10, 10, 0));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 32));
    x = a64x_emit(x, arm64_word_movz(1, 25, 0));
    x = a64x_bl(x, "__sha_rotr");
    x = a64x_emit(x, arm64_word_eor_reg(10, 10, 0));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 0));
    x = a64x_emit(x, arm64_word_ldr(1, 31, 8));
    x = a64x_emit(x, arm64_word_ldr(2, 31, 16));
    x = a64x_emit(x, arm64_word_ldr(3, 31, 24));
    x = a64x_emit(x, arm64_word_mov_reg(4, 10));
    x = a64x_bl(x, "__sha_round2");
    x = a64x_emit(x, arm64_word_ldr(11, 31, 24));
    x = a64x_emit(x, arm64_word_add_imm(11, 11, 1));
    x = a64x_emit(x, arm64_word_str(11, 31, 24));
    let bb: Int = list_len(x.p.words);
    x = a64x_emit(x, arm64_word_b(lp - bb));
    let done: Int = list_len(x.p.words);
    x = a64x_set_words(x, a64_wset(x.p.words, bd, arm64_word_b_cond(arm64_cond_eq(), done - bd)));
    x = a64x_emit(x, arm64_word_add_imm(31, 31, 48));
    r = a64rt_setx(r, a64rt_epi(x));
    return a64rt_sha256u(r);
}
