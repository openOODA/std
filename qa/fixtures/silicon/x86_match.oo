// # X86 Match
//
// Logline: Standard library verification and domain capabilities for X86 Match.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn verify_x86_match() -> Bool {
    let opt: Option[Int] = Some(42);
    let val: Int = match opt {
        Some(v) => v,
        None    => 0
    };
    println(val);
    return true;
}
