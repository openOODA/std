pub fn avx2_concat(a: List[Int], b: List[Int]) -> List[Int] {
  let mut out: List[Int] = a;
  let n: Int = list_len(b);
  let mut i: Int = 0;
  while i < n {
    out = list_push(out, list_get(b, i) & 255);
    i = i + 1;
  }
  return out;
}
