// # x86-64 AVX2 256-bit SIMD Vector Encoders — Sovereign Direct

// Logline: Encodes AVX2 VEX 3-byte prefixes and YMM vector arithmetic with fail-closed bounds per Intel SDM Vol2.

// Setup: Pure. Builds on x86_regs for YMM 0..15 per RFC 0026. Derives from Intel SDM Vol2A 2.3.5 (VEX) and 2.3.11 (EVEX). No ambient caps. No heuristics. No fallbacks.

// Beats:
//   1. Encode 3-byte VEX (C4) with explicit R/X/B/vvvv/L/pp/W/map validation.
//   2. Encode VEX-256 arithmetic (vaddps, vsubps, vmulps, vdivps, vaddpd, vsubpd, vmulpd, vdivpd) and FMA/mov.
//   3. Encode EVEX 4-byte stub for AVX-512 512-bit ZMM (fail-closed until codegen wired).
//   4. Concatenate byte streams with bounded &255 masking.

import "std/hw/silicon/x86_regs.oo";

pub fn vex3_encode(r_inv: Int, x_inv: Int, b_inv: Int, map_select: Int, w: Int, vvvv: Int, l_256: Int, pp: Int) -> List[Int] {
  if r_inv < 0 || r_inv > 1 { return list_new(); }
  if x_inv < 0 || x_inv > 1 { return list_new(); }
  if b_inv < 0 || b_inv > 1 { return list_new(); }
  if map_select < 0 || map_select > 31 { return list_new(); }
  if w < 0 || w > 1 { return list_new(); }
  if vvvv < 0 || vvvv > 15 { return list_new(); }
  if l_256 < 0 || l_256 > 1 { return list_new(); }
  if pp < 0 || pp > 3 { return list_new(); }
  let mut bytes: List[Int] = list_new();
  bytes = list_push(bytes, 196);
  let b1: Int = ((r_inv & 1) << 7) | ((x_inv & 1) << 6) | ((b_inv & 1) << 5) | (map_select & 31);
  bytes = list_push(bytes, b1);
  let inv_v: Int = 15 - (vvvv & 15);
  let b2: Int = ((w & 1) << 7) | ((inv_v & 15) << 3) | ((l_256 & 1) << 2) | (pp & 3);
  bytes = list_push(bytes, b2);
  return bytes;
}

pub fn evex_encode(r: Int, x: Int, b: Int, r_prime: Int, map: Int, w: Int, vvvv: Int, pp: Int, z: Int, l_prime: Int, l: Int, b2: Int) -> List[Int] {
  if r < 0 || r > 1 { return list_new(); }
  if x < 0 || x > 1 { return list_new(); }
  if b < 0 || b > 1 { return list_new(); }
  if r_prime < 0 || r_prime > 1 { return list_new(); }
  if map < 0 || map > 7 { return list_new(); }
  if w < 0 || w > 1 { return list_new(); }
  if vvvv < 0 || vvvv > 15 { return list_new(); }
  if pp < 0 || pp > 3 { return list_new(); }
  if z < 0 || z > 1 { return list_new(); }
  if l_prime < 0 || l_prime > 1 { return list_new(); }
  if l < 0 || l > 1 { return list_new(); }
  if b2 < 0 || b2 > 1 { return list_new(); }
  let mut bytes: List[Int] = list_new();
  bytes = list_push(bytes, 98);
  let b1: Int = ((r & 1) << 7) | ((x & 1) << 6) | ((b & 1) << 5) | ((r_prime & 1) << 4) | (map & 7);
  bytes = list_push(bytes, b1);
  let inv_v: Int = 15 - (vvvv & 15);
  let b2e: Int = ((w & 1) << 7) | ((inv_v & 15) << 3) | (1 << 2) | (pp & 3);
  bytes = list_push(bytes, b2e);
  let b3: Int = ((z & 1) << 7) | ((l_prime & 1) << 6) | ((l & 1) << 5) | ((b2 & 1) << 4);
  bytes = list_push(bytes, b3);
  return bytes;
}

fn vex_reg_ok(reg: Int) -> Bool {
  return reg >= 0 && reg <= 15;
}

pub fn emit_vex_vmovaps_ymm(dst: Int, src: Int) -> List[Int] {
  if !vex_reg_ok(dst) { return list_new(); }
  if !vex_reg_ok(src) { return list_new(); }
  let r_inv: Int = if dst >= 8 { 0 } else { 1 };
  let b_inv: Int = if src >= 8 { 0 } else { 1 };
  let mut out: List[Int] = vex3_encode(r_inv, 1, b_inv, 1, 0, 0, 1, 0);
  if list_len(out) == 0 { return out; }
  out = list_push(out, 40);
  let modrm: Int = (3 << 6) | ((dst & 7) << 3) | (src & 7);
  out = list_push(out, modrm);
  return out;
}

