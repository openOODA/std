// # AArch64 SHA-256 Round3 Rotate And HMAC
//
// Logline: Applies S0/maj, rotates a..h, and emits HMAC-SHA256 hex.
//
// Setup: x0 work, x1 temp1. HMAC builds ipad/opad on the bump heap.
//
// Beats:
//   1. S0 = rotr2 xor rotr13 xor rotr22 of a.
//   2. maj = (a and b) xor (a and c) xor (b and c).
//   3. Store a=t1+t2 through h=g into work.
//   4. crypto_hmac_sha256_internal is HMAC then hex.

import "std/hw/silicon/aarch64_encoder.oo";
import "std/hw/silicon/aarch64_encode_mem.oo";
import "std/hw/silicon/aarch64_parse.oo";
import "std/hw/silicon/aarch64_xstate.oo";
import "std/hw/silicon/aarch64_xexpr.oo";
import "std/hw/silicon/aarch64_xrt.oo";
import "std/hw/silicon/aarch64_xrt_hmac.oo";

fn a64rt_round3(r0: A64R) -> A64R {
    let mut r: A64R = a64rt_fn(r0, "__sha_round3");
    let mut x: A64X = a64rt_prol(r.x);
    x = a64x_emit(x, arm64_word_sub_imm(31, 31, 32));
    x = a64x_emit(x, arm64_word_str(0, 31, 0));
    x = a64x_emit(x, arm64_word_str(1, 31, 8));
    x = a64x_emit(x, arm64_word_ldr(0, 0, 0));
    x = a64x_emit(x, arm64_word_str(0, 31, 16));
    x = a64x_emit(x, arm64_word_movz(1, 2, 0));
    x = a64x_bl(x, "__sha_rotr");
    x = a64x_emit(x, arm64_word_mov_reg(10, 0));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 16));
    x = a64x_emit(x, arm64_word_movz(1, 13, 0));
    x = a64x_bl(x, "__sha_rotr");
    x = a64x_emit(x, arm64_word_eor_reg(10, 10, 0));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 16));
    x = a64x_emit(x, arm64_word_movz(1, 22, 0));
    x = a64x_bl(x, "__sha_rotr");
    x = a64x_emit(x, arm64_word_eor_reg(10, 10, 0));
    x = a64x_emit(x, arm64_word_ldr(9, 31, 0));
    x = a64x_emit(x, arm64_word_ldr(0, 9, 0));
    x = a64x_emit(x, arm64_word_ldr(1, 9, 8));
    x = a64x_emit(x, arm64_word_and_reg(2, 0, 1));
    x = a64x_emit(x, arm64_word_ldr(3, 9, 16));
    x = a64x_emit(x, arm64_word_and_reg(4, 0, 3));
    x = a64x_emit(x, arm64_word_eor_reg(2, 2, 4));
    x = a64x_emit(x, arm64_word_and_reg(4, 1, 3));
    x = a64x_emit(x, arm64_word_eor_reg(2, 2, 4));
    x = a64x_emit(x, arm64_word_add_reg(10, 10, 2));
    x = a64x_emit(x, arm64_word_movz(2, 65535, 0));
    x = a64x_emit(x, arm64_word_movk(2, 65535, 1));
    x = a64x_emit(x, arm64_word_and_reg(10, 10, 2));
    x = a64x_emit(x, arm64_word_ldr(1, 31, 8));
    x = a64x_emit(x, arm64_word_add_reg(0, 1, 10));
    x = a64x_emit(x, arm64_word_and_reg(0, 0, 2));
    x = a64x_emit(x, arm64_word_str(0, 31, 24));
    x = a64x_emit(x, arm64_word_ldr(0, 31, 0));
    x = a64x_emit(x, arm64_word_ldr(1, 31, 8));
    x = a64x_emit(x, arm64_word_ldr(2, 31, 24));
    x = a64x_bl(x, "__sha_shift");
    x = a64x_emit(x, arm64_word_add_imm(31, 31, 32));
    return a64rt_setx(r, a64rt_epi(x));
}

pub fn a64rt_sha256v(r0: A64R) -> A64R {
    let mut r: A64R = a64rt_round3(r0);
    return a64rt_hmac(r);
}
