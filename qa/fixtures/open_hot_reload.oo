// # hot_reload is residual
//
// Logline: A bare hot_reload call must refuse at check.
//
// Setup: OPEN-57. check_residual.oo default-deny.
//
// Beats:
//   1. Call hot_reload.
//   2. Declare main.
//   3. Check refuses.

pub fn verify_open_hot_reload() -> Bool {
    hot_reload();
    return true;
}
