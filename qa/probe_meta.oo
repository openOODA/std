// # std/qa/probe_meta — Meta Domain Verification
//
// Logline: Verify meta domain diagnostic metrics counter accumulation.
//
// Setup: Pure verification of meta diagnostic counters.
//
// Beats:
//   1. Construct monotonic counter with metric name.
//   2. Perform increment and delta addition operations.
//   3. Assert cumulative value matches expected count.

import "meta/diag/metrics_counter.oo";

pub fn main() -> Result[Int, String] {
    let c0: MetricsCounter = metrics_counter_new("probe_events");
    if metrics_counter_get(c0) != 0 {
        return Err("meta: initial counter must be 0");
    }
    let c1: MetricsCounter = metrics_counter_inc(c0);
    if metrics_counter_get(c1) != 1 {
        return Err("meta: counter after inc must be 1");
    }
    let c2: MetricsCounter = metrics_counter_add(c1, 5);
    if metrics_counter_get(c2) != 6 {
        return Err("meta: counter after add 5 must be 6");
    }
    println("probe: std/meta: ok");
    return Ok(0);
}
