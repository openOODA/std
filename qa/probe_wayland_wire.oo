// # Wayland Client Protocol Verification Probe
//
// Logline: Comprehensive verification probe asserting bit-level correctness, message framing, layer-shell integration, and fail-closed parser defenses.
//
// Setup: Pure verification probe exercising Wayland wire encoding and decoding across all supported core, layer-shell, seat, and idle notification primitives.
//
// Beats:
//   1. Assert 16-bit, 32-bit, signed 32-bit, and padded string wire round-trips.
//   2. Assert core request packet construction (display, registry, compositor, shm, surface).
//   3. Assert wlr-layer-shell-unstable-v1 fullscreen screensaver configuration and configure parsing.
//   4. Assert 1:1 negative falsification on truncated headers, illegal message lengths, and buffer overruns.

import "app/ui/wayland/ANCHOR.oo";

pub fn main() -> Result[Int, String] {
    // 1. Primitive Wire Codecs
    let u16_buf: List[Int] = wayland_pack_u16(4660); // 0x1234
    if list_len(u16_buf) != 2 { return Err("u16 buffer len != 2"); }
    if list_get(u16_buf, 0) != 52 { return Err("u16 lo byte wrong"); } // 0x34
    if list_get(u16_buf, 1) != 18 { return Err("u16 hi byte wrong"); } // 0x12
    if wayland_unpack_u16(u16_buf, 0) != 4660 { return Err("u16 unpack recovers value"); }

    let u32_buf: List[Int] = wayland_pack_u32(2309737967); // 0x89abcdef
    if list_len(u32_buf) != 4 { return Err("u32 buffer len != 4"); }
    if wayland_unpack_u32(u32_buf, 0) != 2309737967 { return Err("u32 unpack recovers value"); }

    let i32_neg: List[Int] = wayland_pack_i32(0 - 42);
    if wayland_unpack_i32(i32_neg, 0) != 0 - 42 { return Err("i32 unpack recovers negative value"); }

    let str_padded: List[Int] = wayland_pack_string("hello"); // 5 chars + 1 null = 6 -> pad 2 zeros -> 8 bytes total
    if list_len(str_padded) != 12 { return Err("string buffer with 4-byte len prefix != 12 bytes"); }
    if wayland_unpack_u32(str_padded, 0) != 6 { return Err("string length prefix includes null terminator"); }
    if list_get(str_padded, 4) != ord("h") { return Err("string char 0 mismatch"); }
    if list_get(str_padded, 9) != 0 { return Err("string null terminator mismatch"); }
    if list_get(str_padded, 10) != 0 || list_get(str_padded, 11) != 0 { return Err("string padding bytes non-zero"); }

    // 2. Core Protocol Messages
    let msg_sync: List[Int] = wl_display_sync(2);
    if list_len(msg_sync) != 12 { return Err("wl_display.sync packet length != 12"); }
    let hdr_sync: WaylandMsgHeader = wayland_parse_msg_header(msg_sync, 0);
    if !hdr_sync.ok { return Err("wl_display.sync header parse failed"); }
    if hdr_sync.object_id != 1 { return Err("wl_display object id != 1"); }
    if hdr_sync.opcode != 0 { return Err("wl_display.sync opcode != 0"); }
    if hdr_sync.size_bytes != 12 { return Err("wl_display.sync size != 12"); }
    if wayland_unpack_u32(msg_sync, 8) != 2 { return Err("callback new_id != 2"); }

    let msg_get_reg: List[Int] = wl_display_get_registry(3);
    let hdr_reg: WaylandMsgHeader = wayland_parse_msg_header(msg_get_reg, 0);
    if !hdr_reg.ok { return Err("wl_display.get_registry header parse failed"); }
    if hdr_reg.opcode != 1 { return Err("wl_display.get_registry opcode != 1"); }
    if wayland_unpack_u32(msg_get_reg, 8) != 3 { return Err("registry new_id != 3"); }

    let msg_bind: List[Int] = wl_registry_bind(3, 1, "wl_compositor", 4, 4);
    let hdr_bind: WaylandMsgHeader = wayland_parse_msg_header(msg_bind, 0);
    if !hdr_bind.ok { return Err("wl_registry.bind header parse failed"); }
    if hdr_bind.object_id != 3 { return Err("wl_registry target id != 3"); }
    if hdr_bind.opcode != 0 { return Err("wl_registry.bind opcode != 0"); }

    let msg_surf: List[Int] = wl_compositor_create_surface(4, 5);
    if list_len(msg_surf) != 12 { return Err("create_surface packet len != 12"); }

    let msg_shm_pool: List[Int] = wl_shm_create_pool(6, 7, 1920 * 1080 * 4);
    if list_len(msg_shm_pool) != 16 { return Err("create_pool packet len != 16"); }

    let msg_commit: List[Int] = wl_surface_commit(5);
    if list_len(msg_commit) != 8 { return Err("commit packet len != 8"); }

    // 3. wlr-layer-shell-unstable-v1 Fullscreen Overlay
    let msg_layer: List[Int] = zwlr_layer_shell_v1_get_layer_surface(8, 9, 5, 0, layer_shell_layer_overlay(), "idlescreen");
    let hdr_layer: WaylandMsgHeader = wayland_parse_msg_header(msg_layer, 0);
    if !hdr_layer.ok { return Err("layer_shell header parse failed"); }
    if hdr_layer.object_id != 8 { return Err("layer_shell target id != 8"); }
    if hdr_layer.opcode != 0 { return Err("get_layer_surface opcode != 0"); }

    let msg_anchor: List[Int] = zwlr_layer_surface_v1_set_anchor(9, layer_shell_anchor_fill());
    if wayland_unpack_u32(msg_anchor, 8) != 15 { return Err("anchor fill bitmask != 15"); }

    let msg_zone: List[Int] = zwlr_layer_surface_v1_set_exclusive_zone(9, 0 - 1);
    if wayland_unpack_i32(msg_zone, 8) != 0 - 1 { return Err("exclusive zone -1 mismatch"); }

    // Configure Event Parsing
    let mut cfg_event: List[Int] = list_new();
    let b_serial: List[Int] = wayland_pack_u32(1001);
    let mut i0: Int = 0; while i0 < 4 { cfg_event = list_push(cfg_event, list_get(b_serial, i0)); i0 = i0 + 1; }
    let b_w: List[Int] = wayland_pack_u32(1920);
    let mut i1: Int = 0; while i1 < 4 { cfg_event = list_push(cfg_event, list_get(b_w, i1)); i1 = i1 + 1; }
    let b_h: List[Int] = wayland_pack_u32(1080);
    let mut i2: Int = 0; while i2 < 4 { cfg_event = list_push(cfg_event, list_get(b_h, i2)); i2 = i2 + 1; }
    let cfg: LayerSurfaceConfigure = zwlr_layer_surface_parse_configure(cfg_event, 0);
    if !cfg.ok { return Err("configure event parse failed"); }
    if cfg.serial != 1001 { return Err("configure serial != 1001"); }
    if cfg.width != 1920 || cfg.height != 1080 { return Err("configure dimensions != 1920x1080"); }

    // 4. ext-idle-notify-v1
    let msg_idle: List[Int] = ext_idle_notifier_v1_get_idle_notification(10, 11, 300000, 12);
    let hdr_idle: WaylandMsgHeader = wayland_parse_msg_header(msg_idle, 0);
    if !hdr_idle.ok { return Err("idle header parse failed"); }
    if hdr_idle.opcode != 1 { return Err("get_idle_notification opcode != 1"); }
    if wayland_unpack_u32(msg_idle, 12) != 300000 { return Err("idle timeout ms != 300,000"); }

    let idle_hdr: WaylandMsgHeader = WaylandMsgHeader { ok: true, object_id: 11, opcode: ext_idle_event_idled(), size_bytes: 8 };
    let ev_idled_res: Result[String, String] = ext_idle_parse_event(idle_hdr);
    if ev_idled_res.is_err() { return Err("parse idled event failed"); }
    let ev_idled: String = match ev_idled_res { Ok(s) => s, Err(_) => "" };
    if ev_idled != "IDLED" { return Err("parse idled event value mismatch"); }

    let resume_hdr: WaylandMsgHeader = WaylandMsgHeader { ok: true, object_id: 11, opcode: ext_idle_event_resumed(), size_bytes: 8 };
    let ev_resumed_res: Result[String, String] = ext_idle_parse_event(resume_hdr);
    if ev_resumed_res.is_err() { return Err("parse resumed event failed"); }
    let ev_resumed: String = match ev_resumed_res { Ok(s) => s, Err(_) => "" };
    if ev_resumed != "RESUMED" { return Err("parse resumed event value mismatch"); }

    // 5. Negative-Trust Fail-Closed Falsification
    let mut truncated: List[Int] = list_new();
    truncated = list_push(truncated, 1);
    truncated = list_push(truncated, 0);
    let bad1: WaylandMsgHeader = wayland_parse_msg_header(truncated, 0);
    if bad1.ok { return Err("truncated header < 8 bytes did not fail"); }

    let mut illegal_len: List[Int] = list_new();
    let b_obj: List[Int] = wayland_pack_u32(1);
    let mut p0: Int = 0; while p0 < 4 { illegal_len = list_push(illegal_len, list_get(b_obj, p0)); p0 = p0 + 1; }
    let b_op: List[Int] = wayland_pack_u16(0);
    illegal_len = list_push(illegal_len, list_get(b_op, 0)); illegal_len = list_push(illegal_len, list_get(b_op, 1));
    let b_sz_bad: List[Int] = wayland_pack_u16(4); // size < 8 is illegal in Wayland
    illegal_len = list_push(illegal_len, list_get(b_sz_bad, 0)); illegal_len = list_push(illegal_len, list_get(b_sz_bad, 1));
    let bad2: WaylandMsgHeader = wayland_parse_msg_header(illegal_len, 0);
    if bad2.ok { return Err("size < 8 did not fail"); }

    println("PROBE OK\twayland_wire\tall 5 sections verified (wire + core + layer_shell + idle + negative)");
    return Ok(0);
}
