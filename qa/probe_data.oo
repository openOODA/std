// # std/qa/probe_data — Database Engine Verification
//
// Logline: Verify std data/database pure pieces: btree round-trip, page header, statement kinds, theory certs.
//
// Setup: Pure compute. No filesystem. No network. Fail closed on the first mismatch.
//
// Beats:
//   1. Btree insert then search hits; miss returns None; empty key refused.
//   2. SQLite page header decodes a table leaf; short and bad-type refused.
//   3. Statement kinds classify SELECT/INSERT/UPDATE/DELETE/CREATE; short refused.
//   4. Amdahl and ACID theory certs hold.

import "app/data/db/btree.oo";
import "app/data/db/memtable.oo";
import "app/data/db/wal.oo";
import "app/data/db/kv_types.oo";
import "app/data/database/sqlite_page_header.oo";
import "app/data/database/sql_parser.oo";
import "app/data/amdahls_law_data.oo";
import "app/data/acid_law.oo";

fn probe_btree() -> Result[Int, String] {
    let mut t: BTree = btree_new(16);
    let r1: Result[Bool, String] = btree_insert(&mut t, "k1", "v1");
    if r1.is_err() {
        return Err("data: btree insert k1 failed");
    }
    let r2: Result[Bool, String] = btree_insert(&mut t, "k2", "v2");
    if r2.is_err() {
        return Err("data: btree insert k2 failed");
    }
    let dup: Result[Bool, String] = btree_insert(&mut t, "k1", "v1b");
    if dup.is_err() {
        return Err("data: btree duplicate insert must upsert");
    }
    // Value assertions deferred: the C emitter lowers neither
    // Option[String] match arms nor .is_some() yet (Int only).
    // These calls pin crash-freedom of both search paths meanwhile.
    let _m1: Option[String] = btree_search(t, "k1");
    let _m2: Option[String] = btree_search(t, "zzz");
    let bad: Result[Bool, String] = btree_insert(&mut t, "", "v");
    if bad.is_ok() {
        return Err("data: btree empty key must refuse");
    }
    return Ok(0);
}

fn probe_page_header() -> Result[Int, String] {
    let mut buf: List[Int] = list_new();
    buf = list_push(buf, 13);
    buf = list_push(buf, 0);
    buf = list_push(buf, 0);
    buf = list_push(buf, 0);
    buf = list_push(buf, 5);
    buf = list_push(buf, 12);
    buf = list_push(buf, 200);
    buf = list_push(buf, 0);
    let h: SqliteHdr = sqlite_page_header_parse(buf);
    if h.flag != 1 {
        return Err("data: page header sample must parse");
    }
    if h.ptype != 13 {
        return Err("data: page header must decode table leaf 13");
    }
    if h.cells != 5 {
        return Err("data: page header must decode 5 cells");
    }
    let mut short: List[Int] = list_new();
    short = list_push(short, 13);
    let hs: SqliteHdr = sqlite_page_header_parse(short);
    if hs.flag == 1 {
        return Err("data: short header must refuse");
    }
    let mut badt: List[Int] = list_new();
    badt = list_push(badt, 7);
    badt = list_push(badt, 0);
    badt = list_push(badt, 0);
    badt = list_push(badt, 0);
    badt = list_push(badt, 0);
    badt = list_push(badt, 0);
    badt = list_push(badt, 0);
    badt = list_push(badt, 0);
    let hb: SqliteHdr = sqlite_page_header_parse(badt);
    if hb.flag == 1 {
        return Err("data: bad page type must refuse");
    }
    return Ok(0);
}

fn probe_stmt_kinds() -> Result[Int, String] {
    if sql_parse_statement_kind("SELECT a FROM t") != 1 {
        return Err("data: SELECT must be kind 1");
    }
    if sql_parse_statement_kind("insert into t values (1)") != 2 {
        return Err("data: INSERT must be kind 2");
    }
    if sql_parse_statement_kind("UPDATE t SET a = 1") != 3 {
        return Err("data: UPDATE must be kind 3");
    }
    if sql_parse_statement_kind("delete from t") != 4 {
        return Err("data: DELETE must be kind 4");
    }
    if sql_parse_statement_kind("CREATE TABLE t (a Int)") != 5 {
        return Err("data: CREATE must be kind 5");
    }
    if sql_parse_statement_kind("hi") != 0 {
        return Err("data: short query must be kind 0");
    }
    if sql_parse_statement_kind("FROBNICATE the wobble") != 0 {
        return Err("data: unknown verb must be kind 0");
    }
    return Ok(0);
}

fn probe_memtable() -> Result[Int, String] {
    let mut m: MemTable = memtable_new(100000);
    let e1: KvEntry = kv_entry_new("k1", "v1", 1);
    let p1: Result[Bool, String] = memtable_put(&mut m, e1);
    if p1.is_err() {
        return Err("data: memtable put k1 failed");
    }
    let e2: KvEntry = kv_entry_new("k2", "v2", 2);
    let p2: Result[Bool, String] = memtable_put(&mut m, e2);
    if p2.is_err() {
        return Err("data: memtable put k2 failed");
    }
    if memtable_len(m) != 2 {
        return Err("data: memtable must hold 2 entries");
    }
    let bad: KvEntry = kv_entry_new("", "v", 3);
    if memtable_put(&mut m, bad).is_ok() {
        return Err("data: memtable empty key must refuse");
    }
    let hit: List[KvEntry] = memtable_scan(m, "", "", 10);
    if list_len(hit) != 2 {
        return Err("data: memtable full scan must return 2");
    }
    let narrow: List[KvEntry] = memtable_scan(m, "k2", "k2", 10);
    if list_len(narrow) != 1 {
        return Err("data: memtable point scan must return 1");
    }
    if memtable_should_flush(m) {
        return Err("data: roomy memtable must not want flush");
    }
    let mut tiny: MemTable = memtable_new(10);
    let te: KvEntry = kv_entry_new("k1", "v1", 1);
    let tp: Result[Bool, String] = memtable_put(&mut tiny, te);
    if tp.is_err() {
        return Err("data: tiny memtable put failed");
    }
    if !memtable_should_flush(tiny) {
        return Err("data: tiny memtable must want flush");
    }
    return Ok(0);
}

/// Length-box for recovered entry lists. list_len on a match-bound
/// List[KvEntry] ident mis-dispatches to the int-list helper; reading the
/// length through a struct field resolves via the field table instead.
type ProbeEntryBox = struct {
    xs: List[KvEntry]
};

fn probe_wal() -> Result[Int, String] {
    if wal_open("").is_ok() {
        return Err("data: wal empty path must refuse");
    }
    let wo: Result[WalWriter, String] = wal_open("w");
    if wo.is_err() {
        return Err("data: wal open failed");
    }
    let no_wal_entries: List[KvEntry] = list_new();
    let mut w: WalWriter = match wo { Ok(x) => x, Err(_) => WalWriter { file_path: "w", current_lsn: 0, bytes_written: 0, entries: no_wal_entries } };
    let e1: KvEntry = kv_entry_new("k1", "v1", 1);
    let a1: Result[Int, String] = wal_append(&mut w, e1);
    let lsn1: Int = match a1 { Ok(v) => v, Err(_) => 0 - 1 };
    if lsn1 != 1 {
        return Err("data: first wal lsn must be 1");
    }
    let e2: KvEntry = kv_entry_new("k2", "v2", 2);
    let a2: Result[Int, String] = wal_append(&mut w, e2);
    let lsn2: Int = match a2 { Ok(v) => v, Err(_) => 0 - 1 };
    if lsn2 != 2 {
        return Err("data: second wal lsn must be 2");
    }
    let rec: Result[List[KvEntry], String] = wal_recover(w);
    if rec.is_err() {
        return Err("data: wal recover failed");
    }
    let no_rec_entries: List[KvEntry] = list_new();
    let entries: List[KvEntry] = match rec { Ok(v) => v, Err(_) => no_rec_entries };
    let box1: ProbeEntryBox = ProbeEntryBox { xs: entries };
    if list_len(box1.xs) != 2 {
        return Err("data: wal recover must replay 2 entries");
    }
    let tr: Result[Bool, String] = wal_truncate(&mut w);
    if tr.is_err() {
        return Err("data: wal truncate failed");
    }
    let rec2: Result[List[KvEntry], String] = wal_recover(w);
    if rec2.is_err() {
        return Err("data: wal re-recover failed");
    }
    let no_rec2_entries: List[KvEntry] = list_new();
    let entries2: List[KvEntry] = match rec2 { Ok(v) => v, Err(_) => no_rec2_entries };
    let box2: ProbeEntryBox = ProbeEntryBox { xs: entries2 };
    if list_len(box2.xs) != 0 {
        return Err("data: wal must be empty after truncate");
    }
    return Ok(0);
}

fn probe_theory() -> Result[Int, String] {
    if !verify_amdahls_law_data() {
        return Err("data: amdahl law cert must hold");
    }
    if !verify_acid_law() {
        return Err("data: acid law cert must hold");
    }
    return Ok(0);
}

pub fn main() -> Result[Int, String] {
    let b: Result[Int, String] = probe_btree();
    if b.is_err() {
        return b;
    }
    let p: Result[Int, String] = probe_page_header();
    if p.is_err() {
        return p;
    }
    let s: Result[Int, String] = probe_stmt_kinds();
    if s.is_err() {
        return s;
    }
    let m: Result[Int, String] = probe_memtable();
    if m.is_err() {
        return m;
    }
    let wl: Result[Int, String] = probe_wal();
    if wl.is_err() {
        return wl;
    }
    let t: Result[Int, String] = probe_theory();
    if t.is_err() {
        return t;
    }
    println("probe: std/data db engine ok");
    return Ok(0);
}
