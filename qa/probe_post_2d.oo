// # Probe: LDR/HDR depth fog halves, clamps, no-ops; bloom spreads
//
// Logline: Mid-range fog mixes exactly half black, past-far clamps to
// full fog, degenerate range returns src; a hot red pixel blooms 28 onto
// black neighbors while the center clamps at 255.
//
// Setup: Pure. No caps. Fog LDR runs on a 2x1 canvas with depths [0,100]
// against near 0 far 200: pixel one reads (200,100,50) untouched, pixel
// two mixes half to (5,10,15) since 10*128/256=5, 20*128/256=10,
// 30*128/256=15. Fog HDR halves (2.0,1.0,0.5) at t=0.5. Bloom runs on a
// 3x1 canvas with a single 255 red center: box sum 255, 255/9=28 added
// to the black edges, center 255+28 clamps. Prints probe: std/gfx
// post_2d: ok.
//
// Beats:
//   1. post_fog_ldr mixes half at mid-range and clamps past far.
//   2. post_fog_fb halves radiance exactly and no-ops degenerate.
//   3. post_bloom_ldr spreads 28, clamps center, keeps max-channel.

import "std/app/ui/media/qoi_types.oo";
import "std/app/ui/media/canvas_2d.oo";
import "std/app/ui/media/hdr_3d.oo";
import "std/app/ui/media/post_2d.oo";

fn po_close(got: Float, want: Float) -> Int {
    let mut po_d: Float = got - want;
    if po_d < 0.0 {
        po_d = 0.0 - po_d;
    }
    if po_d < 0.001 {
        return 1;
    }
    return 0;
}

pub fn main() -> Result[Int, String] {
    if qoi_rgba_new(1, 2, 3, 4).r != 1 {
        return Err("post probe: color unit must be 1");
    }
    if canvas_new(0, 5, qoi_rgba_new(0, 0, 0, 255)).is_ok() {
        return Err("post probe: zero width must fail");
    }
    let po_black: QoiRgba = qoi_rgba_new(0, 0, 0, 255);
    let po_mk: Result[Canvas, String] = canvas_new(2, 1, po_black);
    if po_mk.is_err() {
        return Err("post probe: canvas unit must build");
    }
    let po_empty: Canvas = match po_mk { Ok(a) => a, Err(_) => Canvas { width: 0, height: 0, px: list_new() } };
    let po_c0: Canvas = canvas_set(po_empty, 0, 0, qoi_rgba_new(200, 100, 50, 255));
    let po_cv: Canvas = canvas_set(po_c0, 1, 0, qoi_rgba_new(10, 20, 30, 255));
    let mut po_depth: List[Int] = list_new();
    po_depth = list_push(po_depth, 0);
    po_depth = list_push(po_depth, 100);
    let po_mid: Canvas = post_fog_ldr(po_cv, po_depth, 0, 200, po_black);
    if po_mid.width != 2 {
        return Err("post probe: fog width must be 2");
    }
    let po_flat: List[Int] = po_mid.px;
    if list_get(po_flat, 0) != 200 {
        return Err("post probe: near pixel red must stay 200");
    }
    if list_get(po_flat, 1) != 100 {
        return Err("post probe: near pixel green must stay 100");
    }
    if list_get(po_flat, 2) != 50 {
        return Err("post probe: near pixel blue must stay 50");
    }
    if list_get(po_flat, 4) != 5 {
        return Err("post probe: mid red must mix to 5");
    }
    if list_get(po_flat, 5) != 10 {
        return Err("post probe: mid green must mix to 10");
    }
    if list_get(po_flat, 6) != 15 {
        return Err("post probe: mid blue must mix to 15");
    }
    let po_white: QoiRgba = qoi_rgba_new(255, 255, 255, 255);
    let po_far: Canvas = post_fog_ldr(po_cv, po_depth, 0, 50, po_white);
    let po_flat2: List[Int] = po_far.px;
    if list_get(po_flat2, 4) != 255 {
        return Err("post probe: past-far red must clamp to 255");
    }
    if list_get(po_flat2, 5) != 255 {
        return Err("post probe: past-far green must clamp to 255");
    }
    if list_get(po_flat2, 6) != 255 {
        return Err("post probe: past-far blue must clamp to 255");
    }
    if list_get(po_flat2, 0) != 200 {
        return Err("post probe: past-far near pixel must stay 200");
    }
    let po_deg: Canvas = post_fog_ldr(po_cv, po_depth, 100, 100, po_white);
    let po_flat3: List[Int] = po_deg.px;
    if list_get(po_flat3, 4) != 10 {
        return Err("post probe: degenerate range must return src");
    }
    let po_fb0: HdrFb = hdr_add(hdr_new(1, 1), 0, 0, 2.0, 1.0, 0.5);
    let mut po_z1: List[Int] = list_new();
    po_z1 = list_push(po_z1, 50);
    let po_fogged: HdrFb = post_fog_fb(po_fb0, po_z1, 0, 100, 0.0, 0.0, 0.0);
    let po_fpx: List[Float] = po_fogged.px;
    if po_close(list_get(po_fpx, 0), 1.0) != 1 {
        return Err("post probe: hdr fog must halve red to 1.0");
    }
    if po_close(list_get(po_fpx, 1), 0.5) != 1 {
        return Err("post probe: hdr fog must halve green to 0.5");
    }
    if po_close(list_get(po_fpx, 2), 0.25) != 1 {
        return Err("post probe: hdr fog must halve blue to 0.25");
    }
    let po_fdeg: HdrFb = post_fog_fb(po_fb0, po_z1, 100, 100, 9.0, 9.0, 9.0);
    if po_close(list_get(po_fdeg.px, 0), 2.0) != 1 {
        return Err("post probe: hdr degenerate range must return src");
    }
    let mut po_z0: List[Int] = list_new();
    po_z0 = list_push(po_z0, 0);
    let po_fnear: HdrFb = post_fog_fb(po_fb0, po_z0, 0, 100, 9.0, 9.0, 9.0);
    if po_close(list_get(po_fnear.px, 0), 2.0) != 1 {
        return Err("post probe: hdr near-side depth must stay src");
    }
    let po_bmk: Result[Canvas, String] = canvas_new(3, 1, po_black);
    if po_bmk.is_err() {
        return Err("post probe: bloom canvas must build");
    }
    let po_bempty: Canvas = match po_bmk { Ok(a) => a, Err(_) => Canvas { width: 0, height: 0, px: list_new() } };
    let po_hot: Canvas = canvas_set(po_bempty, 1, 0, qoi_rgba_new(255, 0, 0, 255));
    let po_glow: Canvas = post_bloom_ldr(po_hot, 128, 256);
    let po_flat4: List[Int] = po_glow.px;
    if list_get(po_flat4, 0) != 28 {
        return Err("post probe: bloom left edge must be 28");
    }
    if list_get(po_flat4, 4) != 255 {
        return Err("post probe: bloom center must clamp 255");
    }
    if list_get(po_flat4, 5) != 0 {
        return Err("post probe: bloom center green must stay 0");
    }
    if list_get(po_flat4, 8) != 28 {
        return Err("post probe: bloom right edge must be 28");
    }
    let po_mmk: Result[Canvas, String] = canvas_new(1, 1, qoi_rgba_new(10, 200, 30, 255));
    if po_mmk.is_err() {
        return Err("post probe: max canvas must build");
    }
    let po_maxc: Canvas = match po_mmk { Ok(a) => a, Err(_) => Canvas { width: 0, height: 0, px: list_new() } };
    let po_maxb: Canvas = post_bloom_ldr(po_maxc, 128, 256);
    let po_flat5: List[Int] = po_maxb.px;
    if list_get(po_flat5, 0) != 11 {
        return Err("post probe: max-channel red must be 11");
    }
    if list_get(po_flat5, 1) != 222 {
        return Err("post probe: max-channel green must be 222");
    }
    if list_get(po_flat5, 2) != 33 {
        return Err("post probe: max-channel blue must be 33");
    }
    let po_emk: Result[Canvas, String] = canvas_new(1, 1, qoi_rgba_new(128, 128, 0, 255));
    if po_emk.is_err() {
        return Err("post probe: edge canvas must build");
    }
    let po_edgec: Canvas = match po_emk { Ok(a) => a, Err(_) => Canvas { width: 0, height: 0, px: list_new() } };
    let po_edgeb: Canvas = post_bloom_ldr(po_edgec, 128, 256);
    let po_flat6: List[Int] = po_edgeb.px;
    if list_get(po_flat6, 0) != 128 {
        return Err("post probe: threshold-edge must pass through");
    }
    if list_get(po_flat6, 1) != 128 {
        return Err("post probe: threshold-edge green must pass through");
    }
    println("probe: std/gfx post_2d: ok");
    return Ok(0);
}
