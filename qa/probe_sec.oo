// # std/qa/probe_sec — SHA3 Known Answers
//
// Logline: Verify sec/hash SHA3-256/512 against NIST vectors
// (independent check: python hashlib on the same messages).
//
// Setup: Pure hash. No filesystem. Fail closed if any digest drifts.
//
// Beats:
//   1. sha3_256 matches 3 NIST vectors (empty, abc, 56-byte).
//   2. sha3_512 matches 2 NIST vectors (empty, abc).
//   3. Digests differ across messages and have correct lengths.

import "sec/hash/sha3.oo";

pub fn main() -> Result[Int, String] {
    let empty: String = sha3_256("");
    let kat: String = "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a";
    if empty != kat {
        println("sec: sha3_256 empty KAT mismatch got " + empty);
        return Err("sec: sha3_256 empty KAT mismatch got " + empty);
    }
    let abc: String = sha3_256("abc");
    if abc != "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532" {
        println("sec: sha3_256 abc KAT mismatch got " + abc);
        return Err("sec: sha3_256 abc KAT mismatch");
    }
    let m56: String = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    if sha3_256(m56) != "41c0dba2a9d6240849100376a8235e2c82e1b9998a999e21db32dd97496d3376" {
        println("sec: sha3_256 m56 KAT mismatch got " + sha3_256(m56));
        return Err("sec: sha3_256 m56 KAT mismatch");
    }
    if sha3_512("") != "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26" {
        println("sec: sha3_512 empty KAT mismatch got " + sha3_512(""));
        return Err("sec: sha3_512 empty KAT mismatch");
    }
    if sha3_512("abc") != "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0" {
        println("sec: sha3_512 abc KAT mismatch got " + sha3_512("abc"));
        return Err("sec: sha3_512 abc KAT mismatch");
    }
    if abc == empty {
        return Err("sec: sha3_256 abc must differ from empty");
    }
    if chars_len(abc) != 64 {
        return Err("sec: sha3_256 must return 64 hex chars");
    }
    println("probe: std/sec sha3 kat ok");
    return Ok(0);
}
