// # std/qa/probe_sec — SHA3-256 Known Answer
//
// Logline: Verify sec/hash SHA3-256 against the empty-string NIST KAT.
//
// Setup: Pure hash. No filesystem. Fail closed if digest drifts.
//
// Beats:
//   1. Hash the empty string with sha3_256.
//   2. Require the NIST SHA3-256("") digest.
//   3. Hash a non-empty string and refuse equality with the empty digest.

import "sec/hash/sha3.oo";

pub fn main() -> Result[Int, String] {
    let empty: String = sha3_256("");
    let kat: String = "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a";
    if empty != kat {
        return Err("sec: sha3_256 empty KAT mismatch got " + empty);
    }
    let abc: String = sha3_256("abc");
    if abc == empty {
        return Err("sec: sha3_256 abc must differ from empty");
    }
    if chars_len(abc) != 64 {
        return Err("sec: sha3_256 must return 64 hex chars");
    }
    println("probe: std/sec sha3 kat ok");
    return Ok(0);
}
