// # Test Standard Library — Run QA Probes Twice, Byte-Identical
//
// Logline: Run each wired qa probe twice in fresh processes under the
// primary compiler. Fail closed on miss AND on any output difference.
// (Display-dependent sdl_*/graphics probes stay manual — see ANCHOR.oo.)
//
// Setup: Double-run identity law (the immune system: AI writes the code,
// this machinery makes it trustworthy). Builds and executes the domain
// probes plus api_surface. Compiler resolves with zero user config.
//
// Beats:
//   1. Resolve primary compiler binary (OODA_COMPILER, OODA_TOOLCHAIN, HOME).
//   2. Compile and execute each probe twice in fresh processes.
//   3. Byte-compare both runs' outputs; any difference fails the suite.
//   4. Clean up temporary probe binaries immediately.
//   5. Exit 0 only when all probes pass both runs identically.

import "std/fs/process/env.oo";
import "std/fs/file/path.oo";

fn run_probe_once(p: &ProcessCap, oodac: String, path: String) -> Result[String, String] {
    let tmp_bin: String = path + ".tmp.bin";
    let b: Result[String, String] = sys_exec(p, oodac, "build", "--backend", "c", path, "-o", tmp_bin);
    if b.is_err() {
        let e: String = match b { Ok(_) => "", Err(m) => m };
        return Err("compile fail " + path + ": " + e);
    }
    let r: Result[String, String] = sys_exec(p, tmp_bin);
    let _del: Result[String, String] = sys_exec(p, "rm", "-f", tmp_bin);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        return Err("exec fail " + path + ": " + e);
    }
    return r;
}

fn run_probe_twice(p: &ProcessCap, oodac: String, path: String) -> Result[Int, String] {
    let r1: Result[String, String] = run_probe_once(p, oodac, path);
    if r1.is_err() {
        let e1: String = match r1 { Ok(_) => "", Err(m) => m };
        return Err(e1);
    }
    let r2: Result[String, String] = run_probe_once(p, oodac, path);
    if r2.is_err() {
        let e2: String = match r2 { Ok(_) => "", Err(m) => m };
        return Err(e2);
    }
    let o1: String = match r1 { Ok(s) => s, Err(_) => "" };
    let o2: String = match r2 { Ok(s) => s, Err(_) => "" };
    if o1 != o2 {
        return Err("non-identical double-run " + path + ": first " + o1 + " vs second " + o2);
    }
    return Ok(0);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let mut oodac: String = match cr { Ok(s) => s, Err(_) => "" };
    if oodac == "" {
        let tr: Result[String, String] = env_get(env, "OODA_TOOLCHAIN");
        let th: String = match tr { Ok(s) => s, Err(_) => "" };
        if th != "" { oodac = th + "/bin/oodac"; }
    }
    if oodac == "" {
        let hr: Result[String, String] = env_get(env, "HOME");
        let home: String = match hr { Ok(s) => s, Err(_) => "" };
        if home != "" { oodac = home + "/.openooda/bin/oodac"; }
    }
    if oodac == "" || !path_exists(fs_r, oodac) {
        return Err("no compiler (OODA_COMPILER, OODA_TOOLCHAIN, or HOME layout)");
    }
    let probes: List[String] = list_new();
    let mut ps: List[String] = list_push(probes, "qa/probe_api_surface.oo");
    ps = list_push(ps, "qa/probe_core.oo");
    ps = list_push(ps, "qa/probe_fs.oo");
    ps = list_push(ps, "qa/probe_net.oo");
    ps = list_push(ps, "qa/probe_sec.oo");
    ps = list_push(ps, "qa/probe_science.oo");
    ps = list_push(ps, "qa/probe_app.oo");
    ps = list_push(ps, "qa/probe_hw.oo");
    ps = list_push(ps, "qa/probe_meta.oo");
    ps = list_push(ps, "qa/probe_caps.oo");
    ps = list_push(ps, "qa/probe_cap_grant.oo");
    ps = list_push(ps, "qa/probe_cap_fs.oo");
    ps = list_push(ps, "qa/probe_cap_process.oo");
    ps = list_push(ps, "qa/probe_cap_system.oo");
    ps = list_push(ps, "qa/probe_cap_net.oo");
    ps = list_push(ps, "qa/probe_cap_falsify.oo");
    ps = list_push(ps, "qa/probe_data.oo");
    ps = list_push(ps, "qa/probe_wal_disk.oo");
    ps = list_push(ps, "qa/probe_sql_exec.oo");
    ps = list_push(ps, "qa/probe_sandbox_m1.oo");
    ps = list_push(ps, "qa/probe_sandbox_adv1.oo");
    ps = list_push(ps, "qa/probe_sandbox_stress.oo");
    ps = list_push(ps, "qa/probe_swarm.oo");
    ps = list_push(ps, "qa/probe_wayland_wire.oo");
    ps = list_push(ps, "qa/probe_dbus_wire.oo");

    let mut i: Int = 0;
    while i < list_len(ps) {
        let path: String = list_get(ps, i);
        println("  Running " + path);
        let r: Result[Int, String] = run_probe_twice(p, oodac, path);
        if r.is_err() {
            let em: String = match r { Ok(_) => "", Err(e) => e };
            println("ERR " + path + ": " + em);
            return r;
        }
        i = i + 1;
    }
    println("std test suite: ALL PROBES PASSED (double-run identical)");
    return Ok(0);
}
