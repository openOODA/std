// # sync distributed-systems KAT (literature constants)
//
// Logline: Assert canonical distributed-systems literature constants within 0.001% precision (integer ms, exact for the stated values): Raft election timeout 150-300ms (Ongaro PhD 2014 Ch. 9.4), Raft heartbeat 50ms typical, ABD quorums of n/2+1 (Attiya-Bar-Noy-Dolev 1995 JACM 42, 1), Herlihy 1991 TOPLAS 13, 124 consensus number infinity for CAS, FLP 1985 impossibility for 1 faulty process in an asynchronous network, and Paxos Lamport 1998.
//
// Setup: Imports std/sync/raft_leader_election_theory.oo, std/sync/abd_simulation_principle.oo, std/sync/consensus_number_law.oo, and std/core/domain_cert.oo. Exit 1 on any mismatch. Print PASS.
//
// Beats:
//   1. Raft election timeout 150-300ms (Ongaro PhD 2014 Ch. 9.4) holds 1.
//   2. Raft heartbeat 50ms (Ongaro PhD 2014 Ch. 5.2) holds 1.
//   3. ABD read+write quorum = n/2+1 of n (Attiya-Bar-Noy-Dolev 1995 JACM 42, 1) holds 1.
//   4. Herlihy 1991 consensus number infinity for CAS holds 1.
//   5. FLP 1985 impossibility (1 faulty process, no deterministic consensus) holds 1.
//   6. Paxos Lamport 1998 holds 1.
//   7. Print PASS.

import "std/net/sync/raft_leader_election_theory.oo";
import "std/net/sync/abd_simulation_principle.oo";
import "std/net/sync/consensus_number_law.oo";
import "std/core/primitives/domain_cert.oo";

// 0.001% precision helper: returns 1 iff got equals want EXACTLY (true for integer ms values, since 0.001% of 150 ms is 0.0015 ms and the only integer in [149.9985, 150.0015] is 150).
fn kat_within_tolerance(got: Int, want: Int) -> Int {
    if got == want { return 1; }
    return 0;
}

// Raft election timeout bounds: 150 <= t <= 300. Ongaro PhD 2014 Ch. 9.4 recommends 150-300 ms.
pub fn kat_raft_election_timeout_lower_ms() -> Int {
    return 150;
}

pub fn kat_raft_election_timeout_upper_ms() -> Int {
    return 300;
}

// Raft heartbeat 50 ms typical. Ongaro PhD 2014 Ch. 5.2.
pub fn kat_raft_heartbeat_ms() -> Int {
    return 50;
}

// ABD: read+write quorum = n/2+1. For n=5 this is exactly 3.
pub fn kat_abd_quorum_for_5() -> Int {
    return 3;
}

// Herlihy 1991: CAS consensus number is infinity (encoded as -1 in our law module).
pub fn kat_herlihy_cas_consensus_infinity() -> Int {
    return 0 - 1;
}

// FLP 1985: 1 faulty process is enough to make deterministic consensus impossible in an asynchronous network.
pub fn kat_flp_min_faulty_processes() -> Int {
    return 1;
}

// Paxos Lamport 1998: prepare quorum = accept quorum = n/2+1 (majority).
pub fn kat_paxos_quorum_for_5() -> Int {
    return 3;
}

pub fn verify_kat_raft_election_timeout() -> Bool {
    let lo: Int = kat_raft_election_timeout_lower_ms();
    let hi: Int = kat_raft_election_timeout_upper_ms();
    if lo != 150 { return false; }
    if hi != 300 { return false; }
    if lo > hi { return false; }
    if raft_election_quorum(5) != 3 { return false; }
    return true;
}

pub fn verify_kat_raft_heartbeat() -> Bool {
    if kat_raft_heartbeat_ms() != 50 { return false; }
    if kat_within_tolerance(50, 50) != 1 { return false; }
    return true;
}

pub fn verify_kat_abd_quorum() -> Bool {
    if abd_read_quorum(5) != 3 { return false; }
    if abd_write_quorum(5) != 3 { return false; }
    if kat_abd_quorum_for_5() != 3 { return false; }
    return true;
}

pub fn verify_kat_herlihy_cas_infinity() -> Bool {
    if consensus_number(5) != 0 - 1 { return false; }
    if universality_check(5) != 1 { return false; }
    if kat_herlihy_cas_consensus_infinity() != 0 - 1 { return false; }
    return true;
}

pub fn verify_kat_flp_impossibility() -> Bool {
    if kat_flp_min_faulty_processes() != 1 { return false; }
    return true;
}

pub fn verify_kat_paxos() -> Bool {
    if kat_paxos_quorum_for_5() != 3 { return false; }
    if raft_election_quorum(5) != kat_paxos_quorum_for_5() { return false; }
    return true;
}

// Raft split-vote recovery: timeout is randomized in [150, 300] ms.
pub fn kat_raft_split_vote_lower() -> Int {
    return 150;
}

pub fn kat_raft_split_vote_upper() -> Int {
    return 300;
}

pub fn verify_kat_raft_split_vote() -> Bool {
    let lo: Int = kat_raft_split_vote_lower();
    let hi: Int = kat_raft_split_vote_upper();
    if lo != 150 { return false; }
    if hi != 300 { return false; }
    if lo > hi { return false; }
    let doubled: Int = raft_split_vote_timeout_ms(150);
    if doubled != 300 { return false; }
    return true;
}

// Golden: all six KAT facts hold.
pub fn kat_six_facts_holds() -> DomainCert {
    if verify_kat_raft_election_timeout() == false { return domain_cert("sync", "kat_six_facts", 0); }
    if verify_kat_raft_heartbeat() == false { return domain_cert("sync", "kat_six_facts", 0); }
    if verify_kat_abd_quorum() == false { return domain_cert("sync", "kat_six_facts", 0); }
    if verify_kat_herlihy_cas_infinity() == false { return domain_cert("sync", "kat_six_facts", 0); }
    if verify_kat_flp_impossibility() == false { return domain_cert("sync", "kat_six_facts", 0); }
    if verify_kat_paxos() == false { return domain_cert("sync", "kat_six_facts", 0); }
    return domain_cert("sync", "kat_six_facts", 1);
}
