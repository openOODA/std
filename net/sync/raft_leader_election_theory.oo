// # Raft leader election theory
//
// Logline: Raft elects a leader for each term by randomized election timeouts (typically 150-300ms; Ongaro PhD 2014 Ch. 9.4) and grants a vote only to a candidate whose log is at least as up-to-date as the voter's; a quorum of n/2+1 votes elects the leader, breaking split votes probabilistically.
// Logline (coupled): Raft = Paxos (Lamport 1998) with strong leadership + joint-consensus log + restricted leader election; the leader restricts log entries to those present in a majority of previous terms.
//
// Setup: Pure Int arithmetic on a RaftTermState record. No FS, net, env, or thread. The state machine is a closed transition system.
//
// Beats:
//   1. raft_election_quorum(n) = n/2 + 1 (Ongaro-Ousterhout 2014 USENIX ATC Sec. 5.2).
//   2. raft_majority_vote_count returns 1 when votes_for >= n/2+1 and 0 otherwise.
//   3. raft_vote_granted returns 1 iff candidate term > voter term, AND (candidate term == voter term AND log is at-least-as-up-to-date), else 0 (Ongaro PhD 2014 Ch. 5.4).
//   4. raft_term_monotonic holds 1 iff current_term > previous_term for any successful election step.
//   5. Coupled: Raft leader election = Paxos phase 1 + leader-bounded value (Lamport 1998; Ongaro PhD 2014 Ch. 9.6).

import "std/core/primitives/domain_cert.oo";

// Raft term state. n = cluster size, votes_for = votes received by candidate, term = current term, voted_for = candidate id this voter voted for (or -1 for null), log_up_to_date = voter's (lastTerm, lastIndex) packed as 1000*lastTerm+lastIndex.
type RaftTermState = struct {
    n: Int,
    votes_for: Int,
    term: Int,
    prev_term: Int,
    voted_for: Int,
    log_marker: Int,
    election_timeout_ms: Int
};

// New state. n >= 1. Returns Err on n < 1.
pub fn raft_state_new(n: Int, term: Int, log_marker: Int) -> Result[RaftTermState, String] {
    if n < 1 { return Err("ERR\trft\tdomain"); }
    let t: Int = term;
    if t < 0 { return Err("ERR\trft\tdomain"); }
    let lm: Int = log_marker;
    if lm < 0 { return Err("ERR\trft\tdomain"); }
    return Ok(RaftTermState {
        n: n,
        votes_for: 0,
        term: t,
        prev_term: t,
        voted_for: 0 - 1,
        log_marker: lm,
        election_timeout_ms: 0
    });
}

// n/2 + 1 is the Raft election quorum for a cluster of size n (Ongaro-Ousterhout 2014 USENIX ATC Sec. 5.2).
// Uses integer division so 5/2+1 = 3, 3/2+1 = 2, 1/2+1 = 1.
pub fn raft_election_quorum(n: Int) -> Int {
    if n < 1 { return 0; }
    let half: Int = n / 2;
    return half + 1;
}

// 1 if votes_for >= n/2+1; 0 otherwise. Empty cluster (n < 1) returns 0.
pub fn raft_majority_vote_count(n: Int, votes_for: Int) -> Int {
    let q: Int = raft_election_quorum(n);
    if q == 0 { return 0; }
    if votes_for >= q { return 1; }
    return 0;
}

// raft_vote_granted: voter grants its vote iff (candidate_term > voter_term) OR
// (candidate_term == voter_term AND candidate_log_marker >= voter_log_marker AND not_already_voted).
// Encodes Ongaro PhD 2014 Ch. 5.4 "Voter denies its vote if its log is more up-to-date".
pub fn raft_vote_granted(candidate_term: Int, voter_term: Int, candidate_log_marker: Int, voter_log_marker: Int, already_voted: Int) -> Int {
    if candidate_term < voter_term { return 0; }
    if already_voted == 1 { return 0; }
    if candidate_term > voter_term { return 1; }
    if candidate_log_marker >= voter_log_marker { return 1; }
    return 0;
}

// raft_term_monotonic: 1 iff current term > previous term. 0 otherwise. Term never decreases (Ongaro PhD 2014 Ch. 5.1).
pub fn raft_term_monotonic_holds(s: RaftTermState) -> DomainCert {
    if s.term > s.prev_term { return domain_cert("sync", "raft_term_monotonic", 1); }
    return domain_cert("sync", "raft_term_monotonic", 0);
}

// On split vote, the election timeout is randomized in [150, 300] ms to break ties
// (Ongaro PhD 2014 Ch. 9.4). Doubling on contention matches Ongaro's Section 9.6 guidance.
pub fn raft_split_vote_timeout_ms(base_ms: Int) -> Int {
    if base_ms <= 0 { return 150; }
    let dbl: Int = base_ms * 2;
    let cap: Int = 300;
    if dbl > cap { return cap; }
    return dbl;
}

fn rft_got(r: Result[RaftTermState, String]) -> RaftTermState {
    match r { Ok(v) => { return v; }, Err(_) => { return RaftTermState { n: 0, votes_for: 0, term: 0, prev_term: 0, voted_for: 0 - 1, log_marker: 0, election_timeout_ms: 0 }; } }
}

// Coupled: Raft = Paxos + leader + log. The leader for term t commits a value only after replicating it on a majority (Lamport 1998 Paxos made simple; Ongaro PhD 2014 Ch. 9.6). This helper asserts that leader election implies a Paxos phase-1 quorum.
pub fn raft_election_implies_paxos_quorum_holds(s: RaftTermState) -> DomainCert {
    if raft_majority_vote_count(s.n, s.votes_for) == 1 {
        if s.term > s.prev_term {
            return domain_cert("sync", "raft_paxos_quorum", 1);
        }
    }
    return domain_cert("sync", "raft_paxos_quorum", 0);
}

// Golden: 5 nodes, 3 votes, term monotonic, leader elected.
pub fn raft_5node_election_holds() -> DomainCert {
    let mut s: RaftTermState = rft_got(raft_state_new(5, 1, 100));
    s = RaftTermState { n: s.n, votes_for: 3, term: 2, prev_term: s.prev_term, voted_for: s.voted_for, log_marker: s.log_marker, election_timeout_ms: s.election_timeout_ms };
    s = RaftTermState { n: s.n, votes_for: s.votes_for, term: s.term, prev_term: 1, voted_for: s.voted_for, log_marker: s.log_marker, election_timeout_ms: s.election_timeout_ms };
    if raft_majority_vote_count(s.n, s.votes_for) != 1 { return domain_cert("sync", "raft_5node_election", 0); }
    if raft_term_monotonic_holds(s).holds != 1 { return domain_cert("sync", "raft_5node_election", 0); }
    return domain_cert("sync", "raft_5node_election", 1);
}

// Hostile: split vote (only 2 of 5 votes received) -> election fails; doubling the timeout is the recovery.
pub fn raft_split_vote_recovery_holds() -> DomainCert {
    let s: RaftTermState = rft_got(raft_state_new(5, 1, 100));
    if raft_majority_vote_count(s.n, 2) != 0 { return domain_cert("sync", "raft_split_vote_fail_closed", 0); }
    let doubled: Int = raft_split_vote_timeout_ms(150);
    if doubled != 300 { return domain_cert("sync", "raft_split_vote_fail_closed", 0); }
    let doubled2: Int = raft_split_vote_timeout_ms(200);
    if doubled2 != 300 { return domain_cert("sync", "raft_split_vote_fail_closed", 0); }
    return domain_cert("sync", "raft_split_vote_fail_closed", 1);
}

pub fn verify_raft_leader_election_theory() -> Bool {
    // Golden: 5 nodes, election quorum is 3.
    if raft_election_quorum(5) != 3 { return false; }
    if raft_election_quorum(3) != 2 { return false; }
    if raft_election_quorum(1) != 1 { return false; }
    if raft_election_quorum(7) != 4 { return false; }
    if raft_election_quorum(0) != 0 { return false; }
    // Golden: majority 3 of 5.
    if raft_majority_vote_count(5, 3) != 1 { return false; }
    if raft_majority_vote_count(5, 2) != 0 { return false; }
    if raft_majority_vote_count(5, 4) != 1 { return false; }
    if raft_majority_vote_count(5, 5) != 1 { return false; }
    // Golden: term monotonic across an election.
    let s0: RaftTermState = rft_got(raft_state_new(5, 1, 100));
    let s1: RaftTermState = RaftTermState { n: s0.n, votes_for: 3, term: 2, prev_term: s0.prev_term, voted_for: s0.voted_for, log_marker: s0.log_marker, election_timeout_ms: s0.election_timeout_ms };
    if raft_term_monotonic_holds(s1).holds != 1 { return false; }
    // Hostile: same term, votes < quorum -> not elected.
    let s_bad: RaftTermState = rft_got(raft_state_new(5, 1, 100));
    if raft_majority_vote_count(s_bad.n, s_bad.votes_for) != 0 { return false; }
    // Vote grant: candidate with higher term gets vote even if log is behind.
    if raft_vote_granted(2, 1, 50, 100, 0) != 1 { return false; }
    // Vote grant: same term, equal log marker, no prior vote -> vote granted.
    if raft_vote_granted(1, 1, 100, 100, 0) != 1 { return false; }
    // Hostile: same term, candidate log behind voter log -> vote denied.
    if raft_vote_granted(1, 1, 50, 100, 0) != 0 { return false; }
    // Hostile: candidate term lower -> vote denied.
    if raft_vote_granted(0, 1, 100, 100, 0) != 0 { return false; }
    // Hostile: already voted -> deny.
    if raft_vote_granted(2, 1, 200, 100, 1) != 0 { return false; }
    // Coupled: Raft = Paxos + leader; election + term bump implies Paxos phase-1 quorum.
    if raft_election_implies_paxos_quorum_holds(s1).holds != 1 { return false; }
    let s_nq: RaftTermState = RaftTermState { n: s1.n, votes_for: 2, term: s1.term, prev_term: s1.prev_term, voted_for: s1.voted_for, log_marker: s1.log_marker, election_timeout_ms: s1.election_timeout_ms };
    if raft_election_implies_paxos_quorum_holds(s_nq).holds != 0 { return false; }
    // Hostile: split vote recovery via doubled timeout.
    if raft_split_vote_recovery_holds().holds != 1 { return false; }
    // Golden: 5-node election domain_cert.
    if raft_5node_election_holds().holds != 1 { return false; }
    return true;
}
