// # Sync lock-count law
//
// Logline: Lock count cannot go negative. Unlock without lock fails closed.
//
// Setup: Pure. Imports domain_cert.oo. Count is an Int lock depth.
//
// Beats:
//   1. sync_unlock_without_lock holds 0.
//   2. Unlock from count 1 holds 1.
//   3. A negative count does not hold.

import "std/core/primitives/domain_cert.oo";

pub fn sync_lock_count_ok(count: Int) -> DomainCert {
    if count < 0 {
        return domain_cert("sync", "lock_count_nonneg", 0);
    }
    return domain_cert("sync", "lock_count_nonneg", 1);
}

pub fn sync_unlock_from(count: Int) -> DomainCert {
    let next: Int = count - 1;
    if next < 0 {
        return domain_cert("sync", "unlock", 0);
    }
    return domain_cert("sync", "unlock", 1);
}

pub fn sync_unlock_without_lock() -> DomainCert {
    return sync_unlock_from(0);
}
