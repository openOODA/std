// # Asynchronous Event Multiplexing and High-Resolution Timers
//
// Logline: Event-driven I/O multiplexer managing epoll interest lists, monotonic timerfd clocks, and inter-thread eventfds.
//
// Setup: Requires explicit &SysCap capability token. Zero ambient authority.
//
// Beats:
//   1. Define epoll event bitmasks and operation constants.
//   2. Create primary epoll instance descriptors via sys_epoll_create1.
//   3. Control interest lists (ADD, MOD, DEL) with user data tags.
//   4. Multiplex incoming I/O events, monotonic timer ticks, and eventfd signals.

import "std/fs/os/os.oo";

// Epoll event flags
pub fn epoll_in() -> Int { return 1; }
pub fn epoll_out() -> Int { return 4; }
pub fn epoll_err() -> Int { return 8; }
pub fn epoll_hup() -> Int { return 16; }
pub fn epoll_rdhup() -> Int { return 8192; }

// Epoll control operations
pub fn epoll_ctl_add() -> Int { return 1; }
pub fn epoll_ctl_mod() -> Int { return 2; }
pub fn epoll_ctl_del() -> Int { return 3; }

pub type EventPollItem = struct {
    fd: Int,
    events: Int,
    data: Int
};

pub type EventLoop = struct {
    epfd: Int,
    is_open: Bool
};

// Create a new epoll-based event loop descriptor
pub fn event_loop_create(sys: &SysCap) -> Result[EventLoop, String] {
    let r: Result[Int, String] = oo_sys_epoll_create1(sys, 524288); // EPOLL_CLOEXEC = 02000000 = 524288
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err("ERR\tepoll_create\t" + msg);
    }
    let fd: Int = match r { Ok(val) => val, Err(_) => 0 - 1 };
    return Ok(EventLoop { epfd: fd, is_open: true });
}

// Add a file descriptor to the interest list
pub fn event_loop_add(sys: &SysCap, loop: EventLoop, fd: Int, events: Int, data: Int) -> Result[Bool, String] {
    if !loop.is_open || loop.epfd < 0 {
        return Err("ERR\tepoll\tloop is closed");
    }
    if fd < 0 {
        return Err("ERR\tepoll\tinvalid target fd");
    }
    let r: Result[Int, String] = oo_sys_epoll_ctl(sys, loop.epfd, epoll_ctl_add(), fd, events, data);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err("ERR\tepoll_ctl_add\t" + msg);
    }
    return Ok(true);
}

// Modify an existing interest entry in the event loop
pub fn event_loop_modify(sys: &SysCap, loop: EventLoop, fd: Int, events: Int, data: Int) -> Result[Bool, String] {
    if !loop.is_open || loop.epfd < 0 {
        return Err("ERR\tepoll\tloop is closed");
    }
    if fd < 0 {
        return Err("ERR\tepoll\tinvalid target fd");
    }
    let r: Result[Int, String] = oo_sys_epoll_ctl(sys, loop.epfd, epoll_ctl_mod(), fd, events, data);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err("ERR\tepoll_ctl_mod\t" + msg);
    }
    return Ok(true);
}

// Remove a file descriptor from the interest list
pub fn event_loop_delete(sys: &SysCap, loop: EventLoop, fd: Int) -> Result[Bool, String] {
    if !loop.is_open || loop.epfd < 0 {
        return Err("ERR\tepoll\tloop is closed");
    }
    if fd < 0 {
        return Err("ERR\tepoll\tinvalid target fd");
    }
    let r: Result[Int, String] = oo_sys_epoll_ctl(sys, loop.epfd, epoll_ctl_del(), fd, 0, 0);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err("ERR\tepoll_ctl_del\t" + msg);
    }
    return Ok(true);
}

// Wait for pending events on the event loop
pub fn event_loop_wait(sys: &SysCap, loop: EventLoop, max_events: Int, timeout_ms: Int) -> Result[List[EventPollItem], String] {
    if !loop.is_open || loop.epfd < 0 {
        return Err("ERR\tepoll\tloop is closed");
    }
    let mut limit: Int = max_events;
    if limit <= 0 { limit = 1; }
    if limit > 64 { limit = 64; }
    let r: Result[String, String] = oo_sys_epoll_wait(sys, loop.epfd, limit, timeout_ms);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err("ERR\tepoll_wait\t" + msg);
    }
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    return Ok(parse_epoll_events(raw));
}

// Close the event loop and release file descriptor
pub fn event_loop_close(sys: &SysCap, loop: EventLoop) -> Result[Bool, String] {
    if !loop.is_open || loop.epfd < 0 {
        return Ok(true);
    }
    let r: Result[Int, String] = oo_sys_close(sys, loop.epfd);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err(msg);
    }
    return Ok(true);
}

// Create monotonic timerfd descriptor (CLOCK_MONOTONIC = 1, TFD_CLOEXEC = 524288, TFD_NONBLOCK = 2048)
pub fn timerfd_create_monotonic(sys: &SysCap) -> Result[Int, String] {
    let flags: Int = 524288 + 2048; // CLOEXEC + NONBLOCK
    let r: Result[Int, String] = oo_sys_timerfd_create(sys, 1, flags);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err("ERR\ttimerfd_create\t" + msg);
    }
    return r;
}

// Arm periodic timer with interval in nanoseconds (e.g. 16_666_666 ns for 60Hz)
pub fn timerfd_set_interval_ns(sys: &SysCap, tfd: Int, interval_ns: Int) -> Result[Bool, String] {
    if tfd < 0 {
        return Err("ERR\ttimerfd\tinvalid fd");
    }
    if interval_ns <= 0 {
        return Err("ERR\ttimerfd\tinterval must be positive");
    }
    let r: Result[Int, String] = oo_sys_timerfd_settime(sys, tfd, 0, interval_ns, interval_ns);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err("ERR\ttimerfd_settime\t" + msg);
    }
    return Ok(true);
}

// Create an eventfd descriptor for asynchronous notifications (EFD_CLOEXEC = 524288, EFD_NONBLOCK = 2048)
pub fn eventfd_create(sys: &SysCap, initval: Int) -> Result[Int, String] {
    let flags: Int = 524288 + 2048;
    let r: Result[Int, String] = oo_sys_eventfd(sys, initval, flags);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err("ERR\teventfd\t" + msg);
    }
    return r;
}

// Helper: Parse tab-separated "<fd>:<events>:<data>\t..." string into EventPollItem list
fn parse_epoll_events(raw: String) -> List[EventPollItem] {
    let mut items: List[EventPollItem] = list_new();
    let n: Int = chars_len(raw);
    if n == 0 { return items; }
    let mut i: Int = 0;
    while i < n {
        let start: Int = i;
        while i < n && byte_at(raw, i) != 9 { // '\t' = 9
            i = i + 1;
        }
        if i > start {
            let entry: String = str_slice(raw, start, i);
            let item: EventPollItem = parse_single_event(entry);
            if item.fd >= 0 {
                items = list_push(items, item);
            }
        }
        i = i + 1;
    }
    return items;
}

fn parse_single_event(entry: String) -> EventPollItem {
    let parts: List[String] = entry.split(":");
    if list_len(parts) < 3 {
        return EventPollItem { fd: 0 - 1, events: 0, data: 0 };
    }
    let s_fd: String = list_get(parts, 0);
    let s_ev: String = list_get(parts, 1);
    let s_da: String = list_get(parts, 2);
    let fd_val: Int = parse_int_simple(s_fd);
    let ev_val: Int = parse_int_simple(s_ev);
    let da_val: Int = parse_int_simple(s_da);
    return EventPollItem { fd: fd_val, events: ev_val, data: da_val };
}

fn parse_int_simple(s: String) -> Int {
    let n: Int = chars_len(s);
    if n == 0 { return 0; }
    let mut acc: Int = 0;
    let mut i: Int = 0;
    let mut sign: Int = 1;
    if byte_at(s, 0) == 45 { // '-'
        sign = 0 - 1;
        i = 1;
    }
    while i < n {
        let b: Int = byte_at(s, i);
        if b >= 48 && b <= 57 {
            acc = acc * 10 + (b - 48);
        }
        i = i + 1;
    }
    return acc * sign;
}
