// # Max-Flow Min-Cut Theorem
//
// Logline: In any flow network, the maximum source-to-sink flow equals the capacity of the minimum s-t cut (Ford-Fulkerson).
//
// Setup: Pure Int. capacities are non-negative. Source must differ from sink. Hosts net_invariants.oo stem.
//
// Beats:
//   1. Capacity bound: any s-t cut capacity is an upper bound on max flow.
//   2. Max-flow min-cut witness: returns 1 when flow equals cut capacity.
//   3. Residual capacity: cap - flow on a single edge.
//   4. Cut sum from a list of edge capacities: sum is the cut capacity.

import "std/net/net_invariants.oo";

fn mfm_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Residual capacity: cap - flow. Saturated (flow==cap) is Ok(0). Illegal is Err.
pub fn mfm_residual(capacity: Int, flow: Int) -> Result[Int, String] {
    if capacity < 0 { return Err("ERR\tmfm\tdomain"); }
    if flow < 0 { return Err("ERR\tmfm\tdomain"); }
    if flow > capacity { return Err("ERR\tmfm\tdomain"); }
    return Ok(capacity - flow);
}

pub fn mfm_can_augment(capacity: Int, flow: Int) -> Int {
    let rr: Result[Int, String] = mfm_residual(capacity, flow);
    if rr.is_ok() == false { return 0; }
    if mfm_got(rr) > 0 { return 1; }
    return 0;
}

pub fn mfm_cut_upper_bound(cut_capacity: Int) -> Result[Int, String] {
    if cut_capacity < 0 { return Err("ERR\tmfm\tdomain"); }
    return Ok(cut_capacity);
}

// Max-flow min-cut witness: 1 if reported flow equals reported cut capacity.
pub fn mfm_max_flow_min_cut(report_flow: Int, report_cut: Int) -> Int {
    if report_flow < 0 { return 0; }
    if report_cut < 0 { return 0; }
    if report_flow == report_cut { return 1; }
    return 0;
}

// Sum of cut edge capacities: returns total cut capacity. Out-of-range returns 0.
pub fn mfm_cut_sum(edges: List[Int]) -> Result[Int, String] {
    let n: Int = list_len(edges);
    if n <= 0 { return Ok(0); }
    let mut total: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: Int = list_get(edges, i);
        if c < 0 { return Err("ERR\tmfm\tdomain"); }
        total = total + c;
        i = i + 1;
    }
    return Ok(total);
}

// KAT and hostile cases for the max-flow min-cut theorem.
pub fn verify_max_flow_min_cut_theory() -> Bool {
    let net_inv_ok: Bool = net_host_ok("example.com").holds == 1;
    if net_inv_ok == false { return false; }
    if mfm_got(mfm_residual(10, 0)) != 10 { return false; }
    if mfm_got(mfm_residual(10, 7)) != 3 { return false; }
    let zsat: Result[Int, String] = mfm_residual(10, 10);
    if zsat.is_ok() == false { return false; }
    if mfm_got(zsat) != 0 { return false; }
    if mfm_residual(10, 11).is_ok() { return false; }
    if mfm_residual(0 - 1, 0).is_ok() { return false; }
    if mfm_residual(0, 0 - 1).is_ok() { return false; }
    if mfm_can_augment(10, 5) != 1 { return false; }
    if mfm_can_augment(10, 10) != 0 { return false; }
    if mfm_can_augment(10, 11) != 0 { return false; }
    if mfm_got(mfm_cut_upper_bound(7)) != 7 { return false; }
    let zcut: Result[Int, String] = mfm_cut_upper_bound(0);
    if zcut.is_ok() == false { return false; }
    if mfm_got(zcut) != 0 { return false; }
    if mfm_cut_upper_bound(0 - 1).is_ok() { return false; }
    if mfm_max_flow_min_cut(7, 7) != 1 { return false; }
    if mfm_max_flow_min_cut(6, 7) != 0 { return false; }
    if mfm_max_flow_min_cut(7, 0 - 1) != 0 { return false; }
    if mfm_max_flow_min_cut(0 - 1, 7) != 0 { return false; }
    let mut edges: List[Int] = list_new();
    edges = list_push(edges, 3);
    edges = list_push(edges, 4);
    edges = list_push(edges, 5);
    if mfm_got(mfm_cut_sum(edges)) != 12 { return false; }
    let mut bad: List[Int] = list_new();
    bad = list_push(bad, 1);
    bad = list_push(bad, 0 - 1);
    if mfm_cut_sum(bad).is_ok() { return false; }
    let mut empty: List[Int] = list_new();
    let zsum: Result[Int, String] = mfm_cut_sum(empty);
    if zsum.is_ok() == false { return false; }
    if mfm_got(zsum) != 0 { return false; }
    return true;
}
