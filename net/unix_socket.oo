// # Unix Domain Socket Transport
//
// Logline: Capability-gated bind, accept, read, write, and close for AF_UNIX streams.
//
// Setup: Wraps the sealed oo_unix_* primitives. bind materialises a filesystem
//        node and so takes BindCap with FsWriteCap; the data plane takes FsCap;
//        unlinking a socket path takes FsWriteCap.
//
// Beats:
//   1. Bind a listening Unix socket and hold its slot.
//   2. Accept one client connection, read a frame, and write a reply.
//   3. Close a listener or connection and remove the socket file deterministically.
import "std/fs/os/fs.oo";

pub type UnixSocketHandle = struct {
    slot: Int,
    path: String,
    is_open: Bool
};

pub type UnixConnection = struct {
    slot: Int,
    path: String,
    is_open: Bool
};

fn unix_socket_path_max() -> Int { return 108; }

fn unix_read_max() -> Int { return 65536; }

fn is_digit(c: String) -> Bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

// The runtime reports a bound descriptor as "fd:<slot>". A handle that does not
// carry its real slot is worse than no handle, so validate the digits and fail
// closed. parse_int_digits folds non-digits to zero, so the tail is checked first.
fn slot_from_fd(raw: String) -> Result[Int, String] {
    let tag: String = "fd:";
    if !str_starts_with(raw, tag) { return Err("UNIX_ERR: reply is not an fd handle"); }
    let tail: String = str_slice(raw, 3, chars_len(raw));
    let n: Int = chars_len(tail);
    if n == 0 { return Err("UNIX_ERR: fd handle carries no slot"); }
    let mut i: Int = 0;
    while i < n {
        if !is_digit(char_at(tail, i)) { return Err("UNIX_ERR: fd handle slot is not numeric"); }
        i = i + 1;
    }
    return Ok(parse_int_digits(tail));
}

pub fn unix_socket_bind(bind: &BindCap, fw: &FsWriteCap, path: String) -> Result[UnixSocketHandle, String] {
    if chars_len(path) == 0 { return Err("UNIX_ERR: empty path"); }
    if chars_len(path) >= unix_socket_path_max() { return Err("UNIX_ERR: path too long"); }
    let r: Result[String, String] = unix_bind(bind, fw, path);
    if r.is_err() {
        let e: String = match r { Ok(_) => "bind failed", Err(m) => m };
        return Err("UNIX_ERR: " + e);
    }
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    let slot: Int = match slot_from_fd(raw) { Ok(s) => s, Err(e) => return Err(e) };
    return Ok(UnixSocketHandle { slot: slot, path: path, is_open: true });
}

pub fn unix_socket_accept(fs: &FsCap, listener: UnixSocketHandle) -> Result[UnixConnection, String] {
    if !listener.is_open { return Err("UNIX_ERR: listener closed"); }
    let r: Result[String, String] = unix_accept(fs, listener.slot);
    if r.is_err() {
        let e: String = match r { Ok(_) => "accept failed", Err(m) => m };
        return Err("UNIX_ERR: " + e);
    }
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    let slot: Int = match slot_from_fd(raw) { Ok(s) => s, Err(e) => return Err(e) };
    return Ok(UnixConnection { slot: slot, path: listener.path, is_open: true });
}

pub fn unix_socket_connect(fs: &FsCap, fw: &FsWriteCap, path: String) -> Result[UnixConnection, String] {
    if chars_len(path) == 0 { return Err("UNIX_ERR: empty path"); }
    if chars_len(path) >= unix_socket_path_max() { return Err("UNIX_ERR: path too long"); }
    let r: Result[String, String] = unix_connect(fs, fw, path);
    if r.is_err() {
        let e: String = match r { Ok(_) => "connect failed", Err(m) => m };
        return Err("UNIX_ERR: " + e);
    }
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    let slot: Int = match slot_from_fd(raw) { Ok(s) => s, Err(e) => return Err(e) };
    return Ok(UnixConnection { slot: slot, path: path, is_open: true });
}

pub fn unix_socket_read(fs: &FsCap, conn: UnixConnection, max_bytes: Int) -> Result[String, String] {
    if !conn.is_open { return Err("UNIX_ERR: connection closed"); }
    let want: Int = if max_bytes < 1 { unix_read_max() } else { max_bytes };
    let r: Result[String, String] = unix_read(fs, conn.slot, want);
    if r.is_err() {
        let e: String = match r { Ok(_) => "read failed", Err(m) => m };
        return Err("UNIX_ERR: " + e);
    }
    return Ok(match r { Ok(s) => s, Err(_) => "" });
}

// A stream socket carries no message boundaries, so a caller assembling one
// frame cannot use the blocking read above: a peer whose frame arrives in
// pieces would park the caller in the runtime forever. This is the bounded
// form. An Ok carrying the empty string means the timeout elapsed and the
// caller should call again; only a read that returns nothing at all is an
// Err, so "timed out" and "peer is gone" never collapse into one case.
pub fn unix_socket_read_timeout(fs: &FsCap, conn: UnixConnection, timeout_ms: Int, max_bytes: Int) -> Result[String, String] {
    if !conn.is_open { return Err("UNIX_ERR: connection closed"); }
    let want: Int = if max_bytes < 1 { unix_read_max() } else { max_bytes };
    let wait: Int = if timeout_ms < 0 { 0 } else { timeout_ms };
    let r: Result[String, String] = unix_read_timeout(fs, conn.slot, wait, want);
    if r.is_err() {
        let e: String = match r { Ok(_) => "read failed", Err(m) => m };
        return Err("UNIX_ERR: " + e);
    }
    return Ok(match r { Ok(s) => s, Err(_) => "" });
}

pub fn unix_socket_write(fs: &FsCap, conn: UnixConnection, data: String) -> Int {
    if !conn.is_open { return 0; }
    let r: Result[String, String] = unix_write(fs, conn.slot, data);
    if r.is_err() { return 0; }
    return 1;
}

pub fn unix_socket_close_listener(fs: &FsCap, fw: &FsWriteCap, listener: UnixSocketHandle) -> Int {
    if !listener.is_open { return 0; }
    // The bound path is a real filesystem node, so it is removed as one. The
    // runtime unlinks stale paths on bind, but a clean shutdown should not
    // leave the socket behind for the next start to trip over.
    let _ = fs_remove_file(fw, listener.path);
    let r: Result[String, String] = unix_close(fs, listener.slot);
    if r.is_err() { return 0; }
    return 1;
}

pub fn unix_socket_close_connection(fs: &FsCap, fw: &FsWriteCap, conn: UnixConnection) -> Int {
    if !conn.is_open { return 0; }
    let r: Result[String, String] = unix_close(fs, conn.slot);
    if r.is_err() { return 0; }
    return 1;
}
