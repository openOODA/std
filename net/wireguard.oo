// # WireGuard VPN Bindings
//
// Logline: Define WGPeer and WGInterface; bind UDP transport for WireGuard tunnel, fail-closed on crypto and TUN.
//
// Setup: CAP-G6: prefer &UdpCap; legacy &NetCap still works via supersede. RULES.oot 1.4 default-deny; 1.3 fail-closed residual.
//
// Beats:
//   1. wg_init: bind &UdpCap to a WGInterface.
//   2. wg_add_peer: append WGPeer to the interface peer list.
//   3. wg_handshake: fail-closed residual for Noise_IK, Curve25519, BLAKE2s.
//   4. fail-closed: default-deny on unbuilt kernel TUN FFI.

type WGPeer = struct {
    pubkey: String,
    endpoint: String
};

type WGInterface = struct {
    listen_port: Int,
    private_key: String,
    udp: &UdpCap
};

pub fn wg_init(udp: &UdpCap) -> Int {
    return 0 - 1;
}

pub fn wg_create_interface(listen_port: Int, udp: &UdpCap) -> WGInterface {
    return WGInterface {
        listen_port: listen_port,
        private_key: "",
        udp: udp
    };
}

pub fn wg_add_peer(iface: &WGInterface, pubkey: String) -> WGPeer {
    return WGPeer {
        pubkey: pubkey,
        endpoint: ""
    };
}

pub fn wg_remove_peer(iface: &WGInterface, peer: &WGPeer) -> Int {
    return 0 - 1;
}

pub fn wg_start(iface: &WGInterface) -> Int {
    return 0 - 1;
}

pub fn wg_stop(iface: &WGInterface) -> Int {
    return 0 - 1;
}
