// # OAuth2 PKCE (RFC 7636 Int destub, fail-closed S256)
//
// Logline: Verifier length 43..128, unreserved charset, plain pair. S256 refuses until a real SHA-256 + Base64URL pipeline is wired in.
//
// Setup: method 0=plain 1=S256. error_code 0 ok, 1 format, 2 mismatch, 3 unsupported.
//
// Beats:
//   1. charset [A-Za-z0-9-._~] (RFC 7636 4.1).
//   2. plain: verifier id equals challenge.
//   3. S256: refuses unconditionally (djb2 stub removed).

type PkcePair = struct {
    verifier_n: Int,
    challenge: Int,
    method: Int,
    is_valid: Int
};

type PkceVerification = struct {
    is_valid: Int,
    error_code: Int
};

pub fn pkce_is_valid_char(ch: Int) -> Int {
    if ch >= 65 && ch <= 90 {
        return 1;
    }
    if ch >= 97 && ch <= 122 {
        return 1;
    }
    if ch >= 48 && ch <= 57 {
        return 1;
    }
    if ch == 45 {
        return 1;
    }
    if ch == 46 {
        return 1;
    }
    if ch == 95 {
        return 1;
    }
    if ch == 126 {
        return 1;
    }
    return 0;
}

pub fn pkce_validate_n(n: Int) -> Int {
    if n < 43 {
        return 0;
    }
    if n > 128 {
        return 0;
    }
    return 1;
}

pub fn pkce_validate_chars(n: Int, c0: Int, c1: Int, c2: Int, c3: Int) -> Int {
    if pkce_validate_n(n) == 0 {
        return 0;
    }
    if pkce_is_valid_char(c0) == 0 {
        return 0;
    }
    if pkce_is_valid_char(c1) == 0 {
        return 0;
    }
    if pkce_is_valid_char(c2) == 0 {
        return 0;
    }
    if pkce_is_valid_char(c3) == 0 {
        return 0;
    }
    return 1;
}

pub fn pkce_pair_new(n: Int, challenge: Int, method: Int) -> PkcePair {
    return PkcePair {
        verifier_n: n,
        challenge: challenge,
        method: method,
        is_valid: pkce_validate_n(n)
    };
}

// pkce_djb2_3: removed by net audit. The previous "hash" was a 3-byte
// DJB2 accumulator, which is not SHA-256 and not RFC 7636 §4.2
// interoperable. Leaving the function in place would have invited
// callers to forge "S256" challenges. Any caller that needs PKCE
// S256 must integrate a vetted crypto library.

pub fn pkce_verify_plain(n: Int, verifier: Int, challenge: Int) -> PkceVerification {
    if pkce_validate_n(n) == 0 {
        return PkceVerification { is_valid: 0, error_code: 1 };
    }
    if verifier == challenge {
        return PkceVerification { is_valid: 1, error_code: 0 };
    }
    return PkceVerification { is_valid: 0, error_code: 2 };
}

pub fn pkce_verify_exchange(
    n: Int,
    verifier: Int,
    challenge: Int,
    method: Int,
    c0: Int,
    c1: Int,
    c2: Int
) -> PkceVerification {
    if pkce_validate_n(n) == 0 {
        return PkceVerification { is_valid: 0, error_code: 1 };
    }
    if method == 0 {
        return pkce_verify_plain(n, verifier, challenge);
    }
    if method == 1 {
        // Fail-closed: the previous implementation accepted djb2(c0,c1,c2)
        // as the S256 challenge, which is not SHA-256. RFC 7636 §4.2
        // requires BASE64URL(SHA256(verifier)) for S256. Without a real
        // SHA-256 + Base64URL pipeline in the IR, we refuse to certify
        // any S256 challenge. The honest answer is "unsupported", not
        // a fake verify.
        return PkceVerification { is_valid: 0, error_code: 3 };
    }
    return PkceVerification { is_valid: 0, error_code: 3 };
}
