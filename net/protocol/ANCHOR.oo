// # Net Protocol
//
// Logline: Wire-level and application-level protocol codecs. Merges the prior
// std/net/wire/, std/net/web_protocols/, std/net/http3/, std/net/advanced/
// subtrees. Pure compute, no caps.
//
// Setup: Domain module under std/net/protocol. Re-exports the wire codecs
// (DNS wire, hpack, mqtt, quic, websocket) and the application protocols
// (cors, csp, graphql, jsonrpc, oauth2, oidc, openapi, paseto, rtp, sse,
// stun/turn, webrtc, webpush) and the advanced/ WebSocket stack
// (websocket connection lifecycle, ws_frame codec, ws_handshake fail-closed).
// Private siblings (web_proto_stubs, advanced stubs) remain non-public.
//
// Beats:
//   1. Wire codecs: dns_wire_codec, hpack_decoder, mqtt_packet, quic_framer, websocket_frame, websocket_stream, ws_frame_payload.
//   2. HTTP/3: flow, frame, http3, http3_quic, stream, varint.
//   3. Web app: cors_middleware, csp_header_builder, graphql_*, jsonrpc_*, sse_stream.
//   4. Auth: oauth2, oauth2_pkce, oauth2_token, oidc_jwt_claims, paseto_token, webpush_encryption.
//   5. Real-time media: rtcp_sr_rr, rtp_packet, stun_message, turn_allocation, webrtc_*, openapi_*.
//   6. Advanced WebSocket: websocket, ws_frame, ws_handshake (fail-closed).
//   7. Cluster gossip: gossip_mesh, web_protocols, web_proto_stubs.

import "cors_middleware.oo";
import "csp_header_builder.oo";
