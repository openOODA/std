// # DNS Resolution Theory
//
// Logline: A name resolves by walking . (root) -> TLD -> Authoritative; cached answers short-circuit the walk; TTL governs cache validity.
//
// Setup: Pure Int. cache_state 0 = miss, 1 = hit. now and expiry are monotonic seconds. Negative TTL or now >= expiry fails closed. Hosts net_invariants.oo stem.
//
// Beats:
//   1. Closed chain: full resolution = 3 queries (root, TLD, authoritative).
//   2. Cache hit: 0 queries; cache miss: 3 queries.
//   3. Coupled: cache_valid(now, expiry) = 1 iff now < expiry and ttl > 0.

import "std/net/net_invariants.oo";
import "std/core/primitives/domain_cert.oo";

// Number of queries on a cache miss: root, TLD, authoritative.
pub fn dns_queries_on_miss() -> Int {
    return 3;
}

// Number of queries on a cache hit.
pub fn dns_queries_on_hit() -> Int {
    return 0;
}

// Number of queries given a cache state: 0 = miss, 1 = hit. Unknown returns 3 (worst case).
pub fn dns_query_count(cache_state: Int) -> Int {
    if cache_state == 0 { return dns_queries_on_miss(); }
    if cache_state == 1 { return dns_queries_on_hit(); }
    return dns_queries_on_miss();
}

// TTL validity: 1 iff now < expiry and ttl > 0. now < 0, expiry < 0, ttl <= 0 returns 0.
pub fn dns_cache_valid(now: Int, expiry: Int, ttl: Int) -> Int {
    if now < 0 { return 0; }
    if expiry < 0 { return 0; }
    if ttl <= 0 { return 0; }
    if now >= expiry { return 0; }
    return 1;
}

fn dtr_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// TTL decay: remaining TTL given now and expiry. Expired is Ok(0). Negative inputs return Err.
pub fn dns_ttl_remaining(now: Int, expiry: Int) -> Result[Int, String] {
    if now < 0 { return Err("ERR\tdns\tdomain"); }
    if expiry < 0 { return Err("ERR\tdns\tdomain"); }
    if now >= expiry { return Ok(0); }
    return Ok(expiry - now);
}

// Closed chain witness: 1 iff cache_state in {0, 1}.
pub fn dns_closed_witness(cache_state: Int) -> Int {
    if cache_state == 0 { return 1; }
    if cache_state == 1 { return 1; }
    return 0;
}

// Domain certificate: 1 if the cache is in a valid state.
pub fn dns_holds(cache_state: Int) -> DomainCert {
    let inv_ok: Bool = net_host_ok("example.com").holds == 1;
    if inv_ok == false { return domain_cert("net", "dns_resolution_theory", 0); }
    if dns_closed_witness(cache_state) == 1 {
        return domain_cert("net", "dns_resolution_theory", 1);
    }
    return domain_cert("net", "dns_resolution_theory", 0);
}

// KAT and hostile cases for DNS resolution theory.
pub fn verify_dns_resolution_theory() -> Bool {
    if dns_holds(0).holds != 1 { return false; }
    if dns_holds(1).holds != 1 { return false; }
    if dns_holds(2).holds != 0 { return false; }
    if dns_queries_on_miss() != 3 { return false; }
    if dns_queries_on_hit() != 0 { return false; }
    if dns_query_count(0) != 3 { return false; }
    if dns_query_count(1) != 0 { return false; }
    if dns_query_count(2) != 3 { return false; }
    if dns_query_count(0 - 1) != 3 { return false; }
    if dns_cache_valid(100, 200, 60) != 1 { return false; }
    if dns_cache_valid(100, 100, 60) != 0 { return false; }
    if dns_cache_valid(200, 100, 60) != 0 { return false; }
    if dns_cache_valid(0, 100, 60) != 1 { return false; }
    if dns_cache_valid(0 - 1, 200, 60) != 0 { return false; }
    if dns_cache_valid(100, 0 - 1, 60) != 0 { return false; }
    if dns_cache_valid(100, 200, 0) != 0 { return false; }
    if dns_cache_valid(100, 200, 0 - 1) != 0 { return false; }
    if dtr_got(dns_ttl_remaining(100, 200)) != 100 { return false; }
    if dtr_got(dns_ttl_remaining(0, 60)) != 60 { return false; }
    let zttl: Result[Int, String] = dns_ttl_remaining(200, 200);
    if zttl.is_ok() == false { return false; }
    if dtr_got(zttl) != 0 { return false; }
    if dtr_got(dns_ttl_remaining(300, 200)) != 0 { return false; }
    if dns_ttl_remaining(0 - 1, 200).is_ok() { return false; }
    if dns_ttl_remaining(100, 0 - 1).is_ok() { return false; }
    if dns_closed_witness(0) != 1 { return false; }
    if dns_closed_witness(1) != 1 { return false; }
    if dns_closed_witness(2) != 0 { return false; }
    return true;
}
