pub fn net_mod_modules_count() -> Int {
    return net_modules_count();
}

pub fn net_mod_is_available(name: String) -> Bool {
    return net_is_module_available(name);
}

pub fn net_mod_http_get(http: &HttpCap, url: String) -> Result[String, String] {
    return net_http_get(http, url);
}

pub fn net_mod_http_post(http: &HttpCap, url: String) -> Result[String, String] {
    return net_http_post(http, url);
}

pub fn net_mod_dns_resolve(net: &NetCap, host: String) -> Result[String, String] {
    return net_dns_resolve(net, host);
}

pub fn net_mod_tcp_connect(tcp: &TcpCap, host: String, port: Int) -> Result[String, String] {
    return net_tcp_connect(tcp, host, port);
}

pub fn net_mod_tcp_write(tcp: &TcpCap, fd: Int, data: String) -> Result[String, String] {
    return net_tcp_write(tcp, fd, data);
}

pub fn net_mod_tcp_read(tcp: &TcpCap, fd: Int) -> Result[String, String] {
    return net_tcp_read(tcp, fd);
}

pub fn net_mod_tls_connect(tcp: &TcpCap, host: String, port: Int) -> Result[String, String] {
    return net_tls_connect(tcp, host, port);
}

pub fn net_mod_udp_bind(udp: &UdpCap, port: Int) -> Result[String, String] {
    return net_udp_bind(udp, port);
}

pub fn net_mod_udp_recv(udp: &UdpCap, fd: Int) -> Result[String, String] {
    return net_udp_recv(udp, fd);
}

pub fn net_mod_url_default_port(scheme: String) -> Int {
    return url_default_port(scheme);
}

pub fn net_mod_mime_from_path(path: String) -> String {
    return mime_from_path(path);
}
