// # bare_metal_init is residual
//
// Logline: A bare bare_metal_init call must refuse at check.
//
// Setup: OPEN-59. check_residual.oo default-deny.
//
// Beats:
//   1. Call bare_metal_init.
//   2. Declare main.
//   3. Check refuses.

pub fn verify_open_bare_metal() -> Bool {
    bare_metal_init();
    return true;
}
