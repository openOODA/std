// # Net Mesh Submodule Hub -- Zero-Drag
//
// Logline: Peer-to-peer mesh networking, DHT chord routing, edge inference, OTA updates, and power management.
//
// Setup: Pure compute domain module under std/net/mesh. Re-exports clean submodule anchors.
//
// Beats:
//   1. Re-export peer-to-peer chord DHT and epidemic gossip routing.
//   2. Re-export edge neural inference pipeline and analysis operations.
//   3. Re-export mesh node lifecycle, link state, and packet forwarding.
//   4. Re-export over-the-air firmware updates and power governance.
//   5. Maintain strict directory density (<= 8 pages) and zero cyclic imports.

import "./p2p/anchor.oo";
import "./inference/anchor.oo";
import "./link/anchor.oo";
import "./node/anchor.oo";
import "./ota/anchor.oo";
import "./power/anchor.oo";

pub fn mesh_mod_node_config(node_id: Int, max_peers: Int, role: Int) -> MeshNodeConfig {
    return mesh_config_init(node_id, max_peers, role);
}

pub fn mesh_mod_link_healthy(link: MeshLink) -> Bool {
    return mesh_link_is_healthy(link);
}
