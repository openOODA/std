// # Discarded write_file must fail check
//
// Logline: A write_file statement with no bind is unused Result.
//
// Setup: Must-use on Result-returning calls.
//
// Beats:
//   1. Take FsCap.
//   2. Call write_file as a statement.
//   3. Do not print PASSED.

pub fn verify_open_discard_write() -> Bool {
    write_file(fs, "x.txt", "y");
    return true;
}
