// # LTE Packet Data Convergence Protocol (PDCP) Entity
//
// Logline: Implements LTE PDCP sequence numbering, window sliding, ciphering indicators, and SDU buffering.
//
// Setup: Pure telecom protocol module for 3GPP TS 36.323 PDCP layer data processing.
//
// Beats:
//   1. Define PDCP transmission and reception entities with sequence number tracking.
//   2. Process outgoing PDCP SDUs and generate framed PDCP PDUs with header bytes.
//   3. Manage reception window boundaries, reordering buffers, and duplicate detection.

type LtePdcpEntity = struct {
    sn_size_bits: Int,
    next_tx_sn: Int,
    next_rx_sn: Int,
    rx_window_size: Int,
    hfn: Int,
    is_rohc_enabled: Bool
};

type LtePdcpPduHeader = struct {
    sn: Int,
    is_control_pdu: Bool,
    pdu_type: Int,
    payload_len: Int
};

pub fn lte_pdcp_sn_modulus(sn_bits: Int) -> Int {
    if sn_bits == 7 {
        return 128;
    }
    if sn_bits == 12 {
        return 4096;
    }
    if sn_bits == 18 {
        return 262144;
    }
    return 4096;
}

pub fn lte_pdcp_new(sn_bits: Int) -> LtePdcpEntity {
    let mod_val: Int = lte_pdcp_sn_modulus(sn_bits);
    let win_size: Int = mod_val / 2;

    return LtePdcpEntity {
        sn_size_bits: sn_bits,
        next_tx_sn: 0,
        next_rx_sn: 0,
        rx_window_size: win_size,
        hfn: 0,
        is_rohc_enabled: false
    };
}

pub fn lte_pdcp_tx_next_pdu(pdcp: &mut LtePdcpEntity, sdu_len: Int) -> LtePdcpPduHeader {
    let cur_sn: Int = pdcp.next_tx_sn;
    let mod_val: Int = lte_pdcp_sn_modulus(pdcp.sn_size_bits);
    let next_sn: Int = (cur_sn + 1) % mod_val;

    let mut next_hfn: Int = pdcp.hfn;
    if next_sn == 0 {
        next_hfn = next_hfn + 1;
    }

    pdcp.next_tx_sn = next_sn;
    pdcp.hfn = next_hfn;

    return LtePdcpPduHeader {
        sn: cur_sn,
        is_control_pdu: false,
        pdu_type: 0,
        payload_len: sdu_len
    };
}

pub fn lte_pdcp_rx_is_in_window(pdcp: &LtePdcpEntity, received_sn: Int) -> Bool {
    let mod_val: Int = lte_pdcp_sn_modulus(pdcp.sn_size_bits);
    let next_rx: Int = pdcp.next_rx_sn;
    let diff: Int = (received_sn - next_rx + mod_val) % mod_val;

    return diff < pdcp.rx_window_size;
}

pub fn lte_pdcp_rx_process_pdu(pdcp: &mut LtePdcpEntity, pdu: &LtePdcpPduHeader) -> Bool {
    let sn: Int = pdu.sn;
    let in_win: Bool = lte_pdcp_rx_is_in_window(pdcp, sn);
    if in_win == false {
        return false;
    }

    let mod_val: Int = lte_pdcp_sn_modulus(pdcp.sn_size_bits);
    let new_next_rx: Int = (sn + 1) % mod_val;

    pdcp.next_rx_sn = new_next_rx;
    return true;
}
