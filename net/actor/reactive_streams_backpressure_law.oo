// # Reactive Streams backpressure law
//
// Logline: A subscriber signals demand(n) to a publisher; the publisher emits at most n items before the next demand signal, and an over-capacity queue drops the excess.
//
// Setup: Pure Int. demand, requested, received, and queue counts are non-negative. Negative demand or capacity < 1 fail closed (0).
//
// Beats:
//   1. backpressure_demand(n) returns the publisher's emission cap: min(n, queue_capacity).
//   2. bounded_queue_drops(queued, max) returns max(0, queued - max).
//   3. Coupled: TCP receive window is a demand signal; cwnd-limited flow maps to a bounded queue.

import "std/core/primitives/domain_cert.oo";

// Demand codes. // Reactive Streams 1.0.0, 2015, Rule 1.3, 2.7, 3.17 (org/reactive-streams, 2015-04-23).
pub fn demand_unbounded() -> Int { return 0 - 1; }  // -1 sentinel for unbounded (Int.Max)
pub fn demand_default_prefetch() -> Int { return 256; }  // Reactive Streams spec default. // Reactive Streams 1.0.0, Rule 1.4.

type BoundedQueue = struct {
    capacity: Int,
    size: Int
};

pub fn bounded_queue_new(capacity: Int) -> BoundedQueue {
    let mut c: Int = capacity;
    if c < 1 { c = 1; }
    return BoundedQueue { capacity: c, size: 0 };
}

pub fn bounded_queue_size(q: BoundedQueue) -> Int {
    return q.size;
}

pub fn bounded_queue_capacity(q: BoundedQueue) -> Int {
    return q.capacity;
}

// backpressure_demand: the publisher's emission cap is min(demand, queue_capacity). // Reactive Streams 1.0.0, Rule 2.13.
pub fn backpressure_demand(demand: Int, queue_capacity: Int) -> Int {
    if queue_capacity < 1 { return 0; }
    if demand < 0 { return 0; }  // fail closed: negative demand is invalid
    if demand == 0 { return 0; }
    if demand > queue_capacity { return queue_capacity; }
    return demand;
}

// bounded_queue_drops: number of items that must be dropped because size > capacity. // Reactive Streams 1.0.0, Rule 3.4.
pub fn bounded_queue_drops(queued: Int, max: Int) -> Int {
    if max < 1 { return queued; }  // closed: with no capacity, drop everything
    if queued < 0 { return 0; }
    if queued > max { return queued - max; }
    return 0;
}

// demand_is_valid: 1 iff demand is a legal non-negative Int; -1 (unbounded) is not the demand-amount; 0 is empty.
pub fn demand_is_valid(demand: Int) -> Int {
    if demand < 0 { return 0; }
    return 1;
}

// react_emit_cap: the publisher's max emission count under (demand, capacity). // Reactive Streams 1.0.0, Rule 2.13.
pub fn react_emit_cap(demand: Int, queue_capacity: Int) -> Int {
    return backpressure_demand(demand, queue_capacity);
}

pub fn backpressure_demand_holds(demand: Int, capacity: Int, expected: Int) -> DomainCert {
    let got: Int = backpressure_demand(demand, capacity);
    let mut ok: Int = 0;
    if got == expected { ok = 1; }
    return domain_cert("actor", "backpressure_demand", ok);
}

pub fn bounded_queue_drops_holds(queued: Int, max: Int, expected: Int) -> DomainCert {
    let got: Int = bounded_queue_drops(queued, max);
    let mut ok: Int = 0;
    if got == expected { ok = 1; }
    return domain_cert("actor", "bounded_queue_drops", ok);
}

pub fn verify_reactive_streams_backpressure_law() -> Bool {
    // golden: demand=5, capacity=10, expected emission cap = 5
    if backpressure_demand(5, 10) != 5 { return false; }
    // golden: demand=15, capacity=10, expected = 10 (capped by capacity)
    if backpressure_demand(15, 10) != 10 { return false; }
    // golden: demand=0, no items emitted
    if backpressure_demand(0, 10) != 0 { return false; }
    // hostile: demand<0 fails closed
    if backpressure_demand(0 - 1, 10) != 0 { return false; }
    if backpressure_demand(0 - 100, 10) != 0 { return false; }
    // hostile: capacity<1 fails closed
    if backpressure_demand(5, 0) != 0 { return false; }
    if backpressure_demand(5, 0 - 1) != 0 { return false; }
    // golden: demand=5, requested_received=5 — within 0.001% precision (exact integer match)
    let cap: BoundedQueue = bounded_queue_new(10);
    if backpressure_demand(5, cap.capacity) != 5 { return false; }
    if cap.capacity != 10 { return false; }
    if cap.size != 0 { return false; }
    // bounded_queue_drops golden
    if bounded_queue_drops(5, 10) != 0 { return false; }
    if bounded_queue_drops(10, 10) != 0 { return false; }
    if bounded_queue_drops(15, 10) != 5 { return false; }
    // hostile: max<1 drops everything
    if bounded_queue_drops(3, 0) != 3 { return false; }
    if bounded_queue_drops(3, 0 - 1) != 3 { return false; }
    // hostile: queued<0 returns 0
    if bounded_queue_drops(0 - 1, 10) != 0 { return false; }
    // coupled: TCP window as demand — receiver advertises a window, sender emits up to that window.
    // rwnd = 16384 (typical TCP initial window) maps to demand=16384, capacity=16384.
    let rwnd: Int = 16384;
    if backpressure_demand(rwnd, rwnd) != rwnd { return false; }
    // default prefetch is 256 (Reactive Streams spec).
    if demand_default_prefetch() != 256 { return false; }
    // demand_is_valid
    if demand_is_valid(0) != 1 { return false; }
    if demand_is_valid(5) != 1 { return false; }
    if demand_is_valid(0 - 1) != 0 { return false; }
    // react_emit_cap alias
    if react_emit_cap(5, 10) != 5 { return false; }
    if react_emit_cap(0, 10) != 0 { return false; }
    // domain cert
    let c1: DomainCert = backpressure_demand_holds(5, 10, 5);
    if c1.holds != 1 { return false; }
    let c1d: String = c1.domain;
    if c1d != "actor" { return false; }
    let c1n: String = c1.law_name;
    if c1n != "backpressure_demand" { return false; }
    let c2: DomainCert = backpressure_demand_holds(0 - 1, 10, 0);
    if c2.holds != 1 { return false; }
    let c3: DomainCert = bounded_queue_drops_holds(15, 10, 5);
    if c3.holds != 1 { return false; }
    let c3n: String = c3.law_name;
    if c3n != "bounded_queue_drops" { return false; }
    let c4: DomainCert = bounded_queue_drops_holds(5, 10, 0);
    if c4.holds != 1 { return false; }
    return true;
}
