// # Actor mailbox closed-send law
//
// Logline: Sending on a closed mailbox fails closed; closed is an Int flag.
//
// Setup: Pure. Models mailbox state as closed=1. No ThreadCap.
//
// Beats:
//   1. actor_send_ok(closed, msg) holds=0 when closed==1.
//   2. actor_send_ok holds=1 when the mailbox is open (closed!=1).
//   3. domain_cert boxes the holds bit for the actor domain.
//
// residual: Int flag model only; not a live mailbox under ThreadCap

import "std/core/primitives/domain_cert.oo";
pub fn actor_send_ok(closed: Int, msg: Int) -> Int {
    if closed == 1 {
        return 0;
    }
    return 1;
}

pub fn actor_send_law(closed: Int, msg: Int) -> DomainCert {
    return domain_cert("actor", "send_closed", actor_send_ok(closed, msg));
}
