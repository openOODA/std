// # Mailbox backpressure law
//
// Logline: When an actor's mailbox is full the producer must be slowed (block, drop, or apply credits); idle mailboxes do not engage backpressure.
//
// Setup: Pure Int counts. Capacity must be >= 1. Classifier out-of-range fails closed (0). Credit: max_credits<1 or current<0 return Err; current>=max with valid max is Ok(0).
//
// Beats:
//   1. mbp_should_engage returns 1 iff size >= capacity.
//   2. Ideal: block producer (1). Non-ideal: drop oldest with rate limit (1).
//   3. Coupled: credit-based flow control returns max - current.

import "std/core/primitives/domain_cert.oo";

fn mbp_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// 1 if current size meets or exceeds capacity, signaling backpressure; 0 if room remains.
pub fn mbp_should_engage(current_size: Int, capacity: Int) -> Int {
    if capacity < 1 { return 0; }
    if current_size < 0 { return 0; }
    if current_size >= capacity { return 1; }
    return 0;
}

// 1 if at or above the soft threshold (capacity - 1); ideal block engagement.
pub fn mbp_block_ideal(current_size: Int, capacity: Int) -> Int {
    if capacity < 1 { return 0; }
    if current_size < 0 { return 0; }
    if current_size >= capacity - 1 {
        if current_size <= capacity {
            return 1;
        }
    }
    return 0;
}

// 1 if current_size > capacity, signaling a non-ideal drop-oldest fallback.
pub fn mbp_drop_oldest(current_size: Int, capacity: Int) -> Int {
    if capacity < 1 { return 0; }
    if current_size < 0 { return 0; }
    if current_size > capacity { return 1; }
    return 0;
}

// Coupled: credits = max - current. current >= max with valid max is Ok(0).
pub fn mbp_credit_remaining(current: Int, max_credits: Int) -> Result[Int, String] {
    if max_credits < 1 { return Err("ERR\tmbp\tmax"); }
    if current < 0 { return Err("ERR\tmbp\tcur"); }
    if current >= max_credits { return Ok(0); }
    return Ok(max_credits - current);
}

pub fn mailbox_backpressure_holds(current_size: Int, capacity: Int) -> DomainCert {
    if capacity < 1 {
        return domain_cert("actor", "mailbox_backpressure", 0);
    }
    let ok: Int = mbp_should_engage(current_size, capacity);
    return domain_cert("actor", "mailbox_backpressure", ok);
}

pub fn verify_mailbox_backpressure_law() -> Bool {
    if mbp_should_engage(5, 10) != 0 { return false; }
    if mbp_should_engage(9, 10) != 0 { return false; }
    if mbp_should_engage(10, 10) != 1 { return false; }
    if mbp_should_engage(20, 10) != 1 { return false; }
    if mbp_should_engage(0, 10) != 0 { return false; }
    if mbp_should_engage(5, 0) != 0 { return false; }
    if mbp_should_engage(5, 0 - 1) != 0 { return false; }
    if mbp_should_engage(0 - 1, 10) != 0 { return false; }
    if mbp_block_ideal(9, 10) != 1 { return false; }
    if mbp_block_ideal(10, 10) != 1 { return false; }
    if mbp_block_ideal(8, 10) != 0 { return false; }
    if mbp_block_ideal(5, 0) != 0 { return false; }
    if mbp_drop_oldest(11, 10) != 1 { return false; }
    if mbp_drop_oldest(10, 10) != 0 { return false; }
    if mbp_drop_oldest(5, 10) != 0 { return false; }
    if mbp_drop_oldest(11, 0) != 0 { return false; }
    if mbp_got(mbp_credit_remaining(3, 10)) != 7 { return false; }
    if mbp_got(mbp_credit_remaining(0, 10)) != 10 { return false; }
    if mbp_got(mbp_credit_remaining(9, 10)) != 1 { return false; }
    let z: Result[Int, String] = mbp_credit_remaining(10, 10);
    if z.is_ok() == false { return false; }
    if mbp_got(z) != 0 { return false; }
    let z2: Result[Int, String] = mbp_credit_remaining(11, 10);
    if z2.is_ok() == false { return false; }
    if mbp_got(z2) != 0 { return false; }
    if mbp_credit_remaining(3, 0).is_ok() { return false; }
    if mbp_credit_remaining(3, 0 - 1).is_ok() { return false; }
    if mbp_credit_remaining(0 - 1, 10).is_ok() { return false; }
    let c1: DomainCert = mailbox_backpressure_holds(5, 10);
    if c1.holds != 0 { return false; }
    if c1.domain != "actor" { return false; }
    if c1.law_name != "mailbox_backpressure" { return false; }
    let c2: DomainCert = mailbox_backpressure_holds(20, 10);
    if c2.holds != 1 { return false; }
    let c3: DomainCert = mailbox_backpressure_holds(5, 0);
    if c3.holds != 0 { return false; }
    return true;
}
