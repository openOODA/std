// # Message ordering principle
//
// Logline: Messages from the same sender to the same receiver are delivered in send order; receivers see strictly increasing sequence numbers per sender.
//
// Setup: Pure Int. Sender ids and sequence numbers are non-negative. Out-of-range or non-monotonic inputs fail closed (0).
//
// Beats:
//   1. order_invariant(prev_seq, cur_seq) holds iff cur_seq > prev_seq.
//   2. Negative or equal sequences fail closed.
//   3. Coupled: exactly-once dedup by (sender, seq) pair.

import "std/core/primitives/domain_cert.oo";

pub fn order_invariant(prev_seq: Int, cur_seq: Int) -> Int {
    if prev_seq < 0 { return 0; }
    if cur_seq < 0 { return 0; }
    if cur_seq > prev_seq { return 1; }
    return 0;
}

// 1 if (sender, seq) is not in the seen list; 0 if duplicate. Negative args fail closed.
pub fn exactly_once_is_new(
    seen: List[Int],
    sender: Int,
    seq: Int
) -> Int {
    if sender < 0 { return 0; }
    if seq < 0 { return 0; }
    let n: Int = list_len(seen);
    let mut i: Int = 0;
    let mut found: Int = 0;
    while i < n {
        let v: Int = list_get(seen, i);
        if v == sender {
            if i + 1 < n {
                let ns: Int = list_get(seen, i + 1);
                if ns == seq {
                    found = 1;
                }
            }
        }
        i = i + 1;
    }
    if found == 1 { return 0; }
    return 1;
}

// Append a (sender, seq) pair to the seen list, returning a new list.
pub fn exactly_once_record(
    seen: List[Int],
    sender: Int,
    seq: Int
) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(seen);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(seen, i));
        i = i + 1;
    }
    out = list_push(out, sender);
    out = list_push(out, seq);
    return out;
}

pub fn message_ordering_holds(prev_seq: Int, cur_seq: Int) -> DomainCert {
    let ok: Int = order_invariant(prev_seq, cur_seq);
    return domain_cert("actor", "message_ordering", ok);
}

pub fn verify_message_ordering_principle() -> Bool {
    if order_invariant(1, 2) != 1 { return false; }
    if order_invariant(0, 1) != 1 { return false; }
    if order_invariant(5, 100) != 1 { return false; }
    if order_invariant(1, 1) != 0 { return false; }
    if order_invariant(1, 0) != 0 { return false; }
    if order_invariant(2, 1) != 0 { return false; }
    if order_invariant(0 - 1, 2) != 0 { return false; }
    if order_invariant(2, 0 - 1) != 0 { return false; }
    if order_invariant(0 - 1, 0 - 1) != 0 { return false; }
    let mut seen: List[Int] = list_new();
    if exactly_once_is_new(seen, 7, 1) != 1 { return false; }
    seen = exactly_once_record(seen, 7, 1);
    if exactly_once_is_new(seen, 7, 1) != 0 { return false; }
    if exactly_once_is_new(seen, 7, 2) != 1 { return false; }
    if exactly_once_is_new(seen, 8, 1) != 1 { return false; }
    if exactly_once_is_new(seen, 0 - 1, 1) != 0 { return false; }
    if exactly_once_is_new(seen, 7, 0 - 1) != 0 { return false; }
    let c1: DomainCert = message_ordering_holds(1, 2);
    if c1.holds != 1 { return false; }
    if c1.domain != "actor" { return false; }
    if c1.law_name != "message_ordering" { return false; }
    let c2: DomainCert = message_ordering_holds(1, 0);
    if c2.holds != 0 { return false; }
    let c3: DomainCert = message_ordering_holds(0 - 1, 2);
    if c3.holds != 0 { return false; }
    return true;
}
