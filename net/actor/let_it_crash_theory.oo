// # Let it crash supervision theory
//
// Logline: A failed actor is restarted by its supervisor; the strategy chooses whether to restart only the failed child (one-for-one) or all siblings (one-for-all), bounded by a restart intensity.
//
// Setup: Pure Int strategy codes. 0=one_for_one, 1=one_for_all, 2=rest_for_one. Out-of-range codes fail closed (0).
//
// Beats:
//   1. Strategy codes: 0=one_for_one, 1=one_for_all, 2=rest_for_one.
//   2. lic_should_restart returns 1 if the failed child exists and the strategy is recognized.
//   3. one_for_one: restart count after a single failure equals 1.
//   4. one_for_all: restart count after a single failure equals total sibling count.
//   5. Coupled: restart intensity caps restarts within a sliding window.

import "std/core/primitives/domain_cert.oo";

pub fn lic_one_for_one() -> Int {
    return 0;
}

pub fn lic_one_for_all() -> Int {
    return 1;
}

pub fn lic_rest_for_one() -> Int {
    return 2;
}

// 1 if strategy is a recognized supervision strategy; 0 otherwise.
pub fn lic_strategy_recognized(strategy: Int) -> Int {
    if strategy == lic_one_for_one() { return 1; }
    if strategy == lic_one_for_all() { return 1; }
    if strategy == lic_rest_for_one() { return 1; }
    return 0;
}

// 1 if a failed child should be restarted; requires recognized strategy and total >= 1.
pub fn lic_should_restart(strategy: Int, total_children: Int) -> Int {
    if total_children < 1 { return 0; }
    if lic_strategy_recognized(strategy) != 1 { return 0; }
    return 1;
}

// Closed (one-for-one): exactly the failed child is restarted. Returns 1.
pub fn lic_one_for_one_restarts(total_children: Int) -> Int {
    if total_children < 1 { return 0; }
    return 1;
}

// Coupled (one-for-all): all siblings restart together. Returns total_children.
pub fn lic_one_for_all_restarts(total_children: Int) -> Int {
    if total_children < 1 { return 0; }
    return total_children;
}

// 1 if restarts within window_sec is at most max_restarts; out-of-range inputs fail closed.
pub fn lic_intensity_ok(restarts: Int, max_restarts: Int, window_sec: Int) -> Int {
    if restarts < 0 { return 0; }
    if max_restarts < 1 { return 0; }
    if window_sec < 1 { return 0; }
    if restarts <= max_restarts { return 1; }
    return 0;
}

pub fn let_it_crash_holds(strategy: Int, restarts: Int, max_restarts: Int) -> DomainCert {
    let ok: Int = lic_intensity_ok(restarts, max_restarts, 60);
    let recognized: Int = lic_strategy_recognized(strategy);
    if ok == 1 {
        if recognized == 1 {
            return domain_cert("actor", "let_it_crash", 1);
        }
    }
    return domain_cert("actor", "let_it_crash", 0);
}

pub fn verify_let_it_crash_theory() -> Bool {
    if lic_one_for_one() != 0 { return false; }
    if lic_one_for_all() != 1 { return false; }
    if lic_rest_for_one() != 2 { return false; }
    if lic_strategy_recognized(0) != 1 { return false; }
    if lic_strategy_recognized(1) != 1 { return false; }
    if lic_strategy_recognized(2) != 1 { return false; }
    if lic_strategy_recognized(3) != 0 { return false; }
    if lic_strategy_recognized(0 - 1) != 0 { return false; }
    if lic_should_restart(0, 5) != 1 { return false; }
    if lic_should_restart(1, 3) != 1 { return false; }
    if lic_should_restart(2, 4) != 1 { return false; }
    if lic_should_restart(0, 0) != 0 { return false; }
    if lic_should_restart(0 - 1, 5) != 0 { return false; }
    if lic_should_restart(99, 5) != 0 { return false; }
    if lic_one_for_one_restarts(5) != 1 { return false; }
    if lic_one_for_one_restarts(1) != 1 { return false; }
    if lic_one_for_one_restarts(0) != 0 { return false; }
    if lic_one_for_all_restarts(5) != 5 { return false; }
    if lic_one_for_all_restarts(3) != 3 { return false; }
    if lic_one_for_all_restarts(0) != 0 { return false; }
    if lic_intensity_ok(3, 3, 60) != 1 { return false; }
    if lic_intensity_ok(2, 3, 60) != 1 { return false; }
    if lic_intensity_ok(4, 3, 60) != 0 { return false; }
    if lic_intensity_ok(0 - 1, 3, 60) != 0 { return false; }
    if lic_intensity_ok(3, 0, 60) != 0 { return false; }
    if lic_intensity_ok(3, 3, 0) != 0 { return false; }
    let c1: DomainCert = let_it_crash_holds(0, 2, 3);
    if c1.holds != 1 { return false; }
    if c1.domain != "actor" { return false; }
    let c2: DomainCert = let_it_crash_holds(99, 2, 3);
    if c2.holds != 0 { return false; }
    let c3: DomainCert = let_it_crash_holds(0, 4, 3);
    if c3.holds != 0 { return false; }
    return true;
}
