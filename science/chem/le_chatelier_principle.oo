// # Le Chatelier equilibrium response principle
//
// Logline: A system at equilibrium shifts to oppose an applied stress; reaction quotient deviation drives the response direction.
//
// Setup: Pure Float. K_eq and Q are caller-supplied; identity is unit-agnostic. Illegal K_eq or Q returns Err. Equilibrium is Ok(0). Reverse is Ok(-1).
//
// Beats:
//   1. Compare Q and K_eq to classify equilibrium state (forward, reverse, or balanced).
//   2. Apply a stress in concentration and report the predicted shift direction.
//   3. Apply a stress in temperature and report exo or endo response.
//   4. Hostile non-positive K_eq or negative Q returns Err. No concentration stress is Ok(0). Temperature 0 is no-shift.

fn lc_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 2; } }
}

pub fn le_chatelier_state(q: Float, k_eq: Float) -> Result[Int, String] {
    if k_eq <= 0.0 { return Err("ERR\tlc\tdomain"); }
    if q < 0.0 { return Err("ERR\tlc\tdomain"); }
    let tol: Float = k_eq * 0.00001;
    if q < (k_eq - tol) {
        return Ok(1);
    }
    if q > (k_eq + tol) {
        return Ok(0 - 1);
    }
    return Ok(0);
}

pub fn le_chatelier_concentration_shift(
    q_before: Float,
    k_eq: Float,
    reactant_added: Float
) -> Result[Int, String] {
    if k_eq <= 0.0 { return Err("ERR\tlc\tdomain"); }
    if q_before < 0.0 { return Err("ERR\tlc\tdomain"); }
    if reactant_added <= 0.0 { return Ok(0); }
    // Adding reactant raises Q only if Q is below K_eq; the system then shifts forward.
    let sr: Result[Int, String] = le_chatelier_state(q_before, k_eq);
    if sr.is_ok() == false { return sr; }
    let state: Int = lc_got(sr);
    if state == 0 - 1 {
        return Ok(0 - 1);
    }
    return Ok(1);
}

pub fn le_chatelier_temperature_shift(
    delta_h_standard: Float,
    temp_delta_k: Float
) -> Int {
    // Endothermic (delta_h > 0): heating (+T) shifts forward; cooling (-T) shifts reverse.
    // Exothermic (delta_h < 0): heating (+T) shifts reverse; cooling (-T) shifts forward.
    // delta_h == 0 or temp_delta == 0 is no-shift identity 0.
    if delta_h_standard == 0.0 {
        return 0;
    }
    if temp_delta_k == 0.0 {
        return 0;
    }
    let mut h: Float = delta_h_standard;
    if h < 0.0 {
        h = 0.0 - h;
    }
    let mut t: Float = temp_delta_k;
    if t < 0.0 {
        t = 0.0 - t;
    }
    // Sign of response: sign(delta_h) * sign(temp_delta).
    if delta_h_standard > 0.0 {
        if temp_delta_k > 0.0 {
            return 1;
        }
        return 0 - 1;
    }
    if temp_delta_k > 0.0 {
        return 0 - 1;
    }
    return 1;
}

pub fn verify_le_chatelier_principle() -> Bool {
    // Q < K_eq means the system is below equilibrium; reaction must proceed forward.
    if lc_got(le_chatelier_state(0.5, 2.0)) != 1 {
        return false;
    }
    // Q > K_eq means the system is above equilibrium; reaction must proceed in reverse.
    if lc_got(le_chatelier_state(4.0, 2.0)) != 0 - 1 {
        return false;
    }
    // Q == K_eq (within tolerance) is balanced Ok(0).
    let zeq: Result[Int, String] = le_chatelier_state(2.0, 2.0);
    if zeq.is_ok() == false { return false; }
    if lc_got(zeq) != 0 { return false; }
    if lc_got(le_chatelier_state(2.000005, 2.0)) != 0 {
        return false;
    }

    // Adding reactant (Q artificially low) drives a forward shift.
    let shift_fwd: Int = lc_got(le_chatelier_concentration_shift(0.5, 2.0, 1.0));
    if shift_fwd != 1 {
        return false;
    }
    // Already too high; adding more reactant is counteracted by reverse shift.
    let shift_rev: Int = lc_got(le_chatelier_concentration_shift(4.0, 2.0, 1.0));
    if shift_rev != 0 - 1 {
        return false;
    }

    // Endothermic forward reaction: heating shifts forward.
    if le_chatelier_temperature_shift(50000.0, 10.0) != 1 {
        return false;
    }
    // Endothermic forward reaction: cooling shifts reverse.
    if le_chatelier_temperature_shift(50000.0, 0.0 - 10.0) != 0 - 1 {
        return false;
    }
    // Exothermic forward reaction (delta_h < 0): heating shifts reverse.
    if le_chatelier_temperature_shift(0.0 - 50000.0, 10.0) != 0 - 1 {
        return false;
    }
    // Exothermic forward reaction (delta_h < 0): cooling shifts forward.
    if le_chatelier_temperature_shift(0.0 - 50000.0, 0.0 - 10.0) != 1 {
        return false;
    }

    // Hostile: non-positive K_eq returns Err.
    if le_chatelier_state(1.0, 0.0).is_ok() { return false; }
    if le_chatelier_state(1.0, 0.0 - 1.0).is_ok() { return false; }
    // Hostile: negative Q returns Err.
    if le_chatelier_state(0.0 - 1.0, 2.0).is_ok() { return false; }
    if le_chatelier_concentration_shift(1.0, 0.0, 1.0).is_ok() { return false; }
    // Identity: zero reactant added is Ok(0) (no effective stress).
    let zstress: Result[Int, String] = le_chatelier_concentration_shift(1.0, 2.0, 0.0);
    if zstress.is_ok() == false { return false; }
    if lc_got(zstress) != 0 { return false; }
    // Identity: zero enthalpy or zero temperature change is no-shift 0.
    if le_chatelier_temperature_shift(0.0, 10.0) != 0 {
        return false;
    }
    if le_chatelier_temperature_shift(50000.0, 0.0) != 0 {
        return false;
    }
    return true;
}
