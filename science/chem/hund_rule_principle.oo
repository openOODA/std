// # Hund multiplicity rule for orbital electron filling
//
// Logline: Degenerate orbitals fill with parallel spins before pairing; total spin S = n_unpaired / 2.
//
// Setup: Pure Int. n_electrons and n_orbitals are non-negative integers; the identity is unit-agnostic.
//
// Beats:
//   1. Compute number of unpaired electrons given electron count and orbital degeneracy.
//   2. Compute total spin quantum number S = n_unpaired / 2.
//   3. Classify paramagnetic (unpaired > 0) or diamagnetic (unpaired == 0).
//   4. Hostile negative electrons or orbitals returns 0.

fn hun_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

fn hun_fgot(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

pub fn hund_unpaired_count(n_electrons: Int, n_orbitals: Int) -> Result[Int, String] {
    if n_electrons < 0 { return Err("ERR\thun\tdomain"); }
    if n_orbitals <= 0 { return Err("ERR\thun\tdomain"); }
    if n_electrons <= n_orbitals {
        return Ok(n_electrons);
    }
    let extra: Int = n_electrons - n_orbitals;
    if extra >= n_orbitals {
        return Ok(0);
    }
    return Ok(n_orbitals - extra);
}

pub fn hund_total_spin_s(n_electrons: Int, n_orbitals: Int) -> Result[Float, String] {
    let ur: Result[Int, String] = hund_unpaired_count(n_electrons, n_orbitals);
    if ur.is_ok() == false { return Err("ERR\thun\tdomain"); }
    let u: Float = 1.0 * (hun_got(ur));
    return Ok(0.5 * u);
}

pub fn hund_is_paramagnetic(n_electrons: Int, n_orbitals: Int) -> Int {
    let ur: Result[Int, String] = hund_unpaired_count(n_electrons, n_orbitals);
    if ur.is_ok() == false { return 0; }
    if hun_got(ur) > 0 { return 1; }
    return 0;
}

pub fn hund_max_unpaired(n_orbitals: Int) -> Result[Int, String] {
    if n_orbitals <= 0 { return Err("ERR\thun\tdomain"); }
    return Ok(n_orbitals);
}

pub fn verify_hund_rule_principle() -> Bool {
    // 3 electrons in 3 p orbitals: 3 unpaired (parallel spins).
    if hun_got(hund_unpaired_count(3, 3)) != 3 {
        return false;
    }
    if hun_got(hund_unpaired_count(2, 3)) != 2 {
        return false;
    }
    if hun_got(hund_unpaired_count(1, 3)) != 1 {
        return false;
    }
    if hun_got(hund_unpaired_count(4, 3)) != 2 {
        return false;
    }
    if hun_got(hund_unpaired_count(5, 3)) != 1 {
        return false;
    }
    let zpair: Result[Int, String] = hund_unpaired_count(6, 3);
    if zpair.is_ok() == false { return false; }
    if hun_got(zpair) != 0 {
        return false;
    }
    let zel: Result[Int, String] = hund_unpaired_count(0, 3);
    if zel.is_ok() == false { return false; }
    if hun_got(zel) != 0 {
        return false;
    }

    let s: Float = hun_fgot(hund_total_spin_s(3, 3));
    if s != 1.5 {
        return false;
    }
    let s2: Float = hun_fgot(hund_total_spin_s(2, 3));
    if s2 != 1.0 {
        return false;
    }
    let s3: Float = hun_fgot(hund_total_spin_s(6, 3));
    if s3 != 0.0 {
        return false;
    }

    // Paramagnetic when unpaired > 0.
    if hund_is_paramagnetic(3, 3) != 1 {
        return false;
    }
    if hund_is_paramagnetic(6, 3) != 0 {
        return false;
    }
    if hund_is_paramagnetic(0, 3) != 0 {
        return false;
    }

    // Max unpaired equals the number of orbitals.
    if hun_got(hund_max_unpaired(5)) != 5 {
        return false;
    }
    if hund_max_unpaired(0).is_ok() { return false; }

    if hund_unpaired_count(0 - 1, 3).is_ok() { return false; }
    if hund_unpaired_count(2, 0).is_ok() { return false; }
    if hund_unpaired_count(2, 0 - 1).is_ok() { return false; }
    return true;
}
