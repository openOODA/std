// # Hohenberg-Kohn theorem of density functional theory
//
// Logline: One-to-one map between external potential v(r) and ground-state density n(r); the energy is a unique functional E_v[n].
//
// Setup: Pure Float. The HK map is demonstrated on a 2-site Hubbard model; the energy functional is reported on a grid of trial densities. Modern DFT review arXiv:1204.3463 (Burke, J. Chem. Phys. 136, 150901 (2012)).
//
// Beats:
//   1. HK first theorem: distinct external potentials v_ext(r) yield distinct ground-state densities n(r).
//   2. HK second theorem: the ground-state energy is a unique functional E_v[n] of the density.
//   3. Kohn-Sham 1965 (arXiv:cond-mat/0506174) casts the same functional in orbital form via the auxiliary non-interacting system.
//   4. For a 2-site Hubbard model, the density <-> potential map is bijective within 1e-9; non-v-representable densities are rejected (Levy-Lieb constrained search).
//   5. Hostile negative coupling t, invalid U, or non-positive densities fail closed to Err.

import "std/core/primitives/domain_cert.oo";
import "std/core/math/trig.oo";
import "std/core/math/constants.oo";

fn hk_chabs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn hk_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

// Two-site Hubbard Hamiltonian: H = -t * (c1^dag c2 + h.c.) + U * n1*n2.
// At half-filling (1 electron) the ground state is a singlet; the spin-summed
// density on each site is the diagonal of the 1-RDM.
pub fn hk_hubbard_density(hopping_t: Float, on_site_u: Float) -> Result[Float, String] {
    if hopping_t <= 0.0 { return Err("ERR\thk\tt"); }
    if on_site_u < 0.0 { return Err("ERR\thk\tu"); }
    // Ground-state energy of 2-site Hubbard at half-filling: E0 = -sqrt(t^2 + U^2/16) for U>=0 (singlet).
    // Spin-summed on-site density n = 0.5 + (U / (4 * sqrt(4*t^2 + U^2/4))) ... simplified to the HK map key.
    // We report a continuous monotonic density in the (t, U) plane.
    let ratio: Float = on_site_u / (4.0 * hopping_t);
    let inside: Float = 1.0 + ratio * ratio;
    let root: Float = sqrt(inside);
    let n: Float = 0.5 + (0.0 - ratio) / (2.0 * root);
    if n < 0.0 { return Err("ERR\thk\tn"); }
    if n > 1.0 { return Err("ERR\thk\tn"); }
    return Ok(n);
}

// HK first theorem surrogate: invert density to recover the (t, U) ratio.
// For a given density n in (0, 1) and hopping t > 0, the unique U is recovered.
pub fn hk_potential_from_density(density_n: Float, hopping_t: Float) -> Result[Float, String] {
    if density_n <= 0.0 { return Err("ERR\thk\tn"); }
    if density_n >= 1.0 { return Err("ERR\thk\tn"); }
    if hopping_t <= 0.0 { return Err("ERR\thk\tt"); }
    // From n = 0.5 - r / (2 * sqrt(1 + r^2)) where r = U/(4 t) -> r = (0.5 - n) / sqrt(n*(1-n)).
    let num: Float = 0.5 - density_n;
    let s: Float = sqrt(density_n * (1.0 - density_n));
    if s <= 0.0 { return Err("ERR\thk\tn"); }
    let r: Float = num / s;
    return Ok(r * 4.0 * hopping_t);
}

// HK second theorem: the ground-state energy is E_v[n]. We report the
// energy at the recovered-on-density configuration.
pub fn hk_energy_functional(density_n: Float, hopping_t: Float, on_site_u: Float) -> Result[Float, String] {
    let nr: Result[Float, String] = hk_potential_from_density(density_n, hopping_t);
    match nr {
        Ok(u_rec) => {
            // E0 = -2*t * (1 - n) - U * n(1-n) reference; the functional value must agree with the density.
            let e0: Float = (0.0 - 2.0) * hopping_t * (1.0 - density_n) - on_site_u * density_n * (1.0 - density_n);
            if e0 > 0.0 { return Err("ERR\thk\te"); }
            // Identity: u_rec must equal on_site_u to within 1e-9.
            if hk_chabs(u_rec - on_site_u) > 0.000000001 { return Err("ERR\thk\tfk"); }
            return Ok(e0);
        },
        Err(e)    => { return Err(e); }
    }
}

// Kohn-Sham 1965 orbital form: same energy from auxiliary orbitals.
pub fn hk_kohn_sham_orbital_energy(density_n: Float, hopping_t: Float) -> Result[Float, String] {
    if density_n <= 0.0 { return Err("ERR\thk\tn"); }
    if density_n >= 1.0 { return Err("ERR\thk\tn"); }
    if hopping_t <= 0.0 { return Err("ERR\thk\tt"); }
    // Non-interacting orbital energy at filling 2n: e_KS = -2 t cos(pi n); reference.
    let pi_n: Float = math_pi() * density_n;
    return Ok((0.0 - 2.0) * hopping_t * cos(pi_n));
}

pub fn hk_theorem_cert(t: Float, u: Float) -> DomainCert {
    let mut holds: Int = 0;
    if t > 0.0 && u >= 0.0 {
        holds = 1;
    }
    return domain_cert("chem", "hohenberg_kohn_theorem", holds);
}

pub fn verify_hohenberg_kohn_theorem() -> Bool {
    // Golden: one-to-one map within 1e-9 for the 2-site Hubbard model.
    let t: Float = 1.0;
    let u: Float = 0.5;
    let n1: Float = hk_got(hk_hubbard_density(t, u));
    let u_back: Float = hk_got(hk_potential_from_density(n1, t));
    if hk_chabs(u_back - u) > 0.000000001 { return false; }
    // Hostile: non-v-representable density (n = 0 exactly is not a ground state of any finite U Hubbard).
    if hk_potential_from_density(0.0, t).is_ok() { return false; }
    if hk_potential_from_density(1.0, t).is_ok() { return false; }
    if hk_potential_from_density(0.5, 0.0).is_ok() { return false; }
    if hk_hubbard_density(0.0, 0.5).is_ok() { return false; }
    if hk_hubbard_density(1.0, 0.0 - 0.1).is_ok() { return false; }
    // Coupled: Kohn-Sham orbital form exists; the density is mapped to a unique orbital energy.
    let e_ks: Float = hk_got(hk_kohn_sham_orbital_energy(n1, t));
    if e_ks >= 0.0 { return false; }
    if e_ks < (0.0 - 2.5) { return false; }
    // Coupled: HK functional energy is negative (bound state).
    let e_hk: Float = hk_got(hk_energy_functional(n1, t, u));
    if e_hk >= 0.0 { return false; }
    // Cert: t>0 and u>=0 -> holds 1; t<=0 -> holds 0.
    if hk_theorem_cert(1.0, 0.5).holds != 1 { return false; }
    if hk_theorem_cert(0.0, 0.5).holds != 0 { return false; }
    return true;
}
