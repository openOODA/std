// # Microscopic reversibility principle
//
// Logline: At the molecular level every reaction is reversible; K_eq = k_forward / k_reverse.
//
// Setup: Pure Float. Forward and reverse rate constants are caller-supplied. Unit-agnostic
// (works for any rate law obeying mass action).
//
// Beats:
//   1. Equilibrium constant from rate constants: K_eq = k_f / k_b when both > 0.
//   2. Reverse rate recovery: k_b = k_f / K_eq.
//   3. Nernst coupling: K_eq = exp(-n * F * E_standard / (R * T)) (oxidation convention).
//   4. Hostile k_f <= 0, k_b <= 0, n <= 0, or T <= 0 return Err.

import "std/core/primitives/domain_cert.oo";
import "std/core/math/trig.oo";

fn mr_eabs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn mr_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

pub fn mrev_gas_constant() -> Float {
    return 8.314;
}

pub fn mrev_faraday_constant() -> Float {
    return 96485.0;
}

pub fn mrev_equilibrium_constant(k_forward: Float, k_reverse: Float) -> Result[Float, String] {
    if k_forward <= 0.0 { return Err("ERR\tmrev\tkf"); }
    if k_reverse <= 0.0 { return Err("ERR\tmrev\tkb"); }
    return Ok(k_forward / k_reverse);
}

pub fn mrev_reverse_rate(k_forward: Float, k_eq: Float) -> Result[Float, String] {
    if k_forward <= 0.0 { return Err("ERR\tmrev\tkf"); }
    if k_eq <= 0.0 { return Err("ERR\tmrev\tkeq"); }
    return Ok(k_forward / k_eq);
}

pub fn mrev_forward_rate(k_reverse: Float, k_eq: Float) -> Result[Float, String] {
    if k_reverse <= 0.0 { return Err("ERR\tmrev\tkb"); }
    if k_eq <= 0.0 { return Err("ERR\tmrev\tkeq"); }
    return Ok(k_reverse * k_eq);
}

pub fn mrev_keq_from_nernst(
    e_standard_v: Float,
    n_electrons: Float,
    temp_k: Float
) -> Result[Float, String] {
    if n_electrons <= 0.0 { return Err("ERR\tmrev\tn"); }
    if temp_k <= 0.0 { return Err("ERR\tmrev\tt"); }
    let r: Float = mrev_gas_constant();
    let f: Float = mrev_faraday_constant();
    let mut arg: Float = (0.0 - n_electrons) * f * e_standard_v / (r * temp_k);
    if arg > 700.0 { arg = 700.0; }
    if arg < (0.0 - 700.0) { arg = 0.0 - 700.0; }
    return Ok(math_exp(arg));
}

pub fn mrev_nernst_consistent(
    k_forward: Float,
    k_reverse: Float,
    e_standard_v: Float,
    n_electrons: Float,
    temp_k: Float
) -> Int {
    if k_forward <= 0.0 { return 0; }
    if k_reverse <= 0.0 { return 0; }
    if n_electrons <= 0.0 { return 0; }
    if temp_k <= 0.0 { return 0; }
    let k_rates: Float = k_forward / k_reverse;
    let kn: Result[Float, String] = mrev_keq_from_nernst(e_standard_v, n_electrons, temp_k);
    match kn {
        Ok(k_nernst) => {
            if k_nernst <= 0.0 { return 0; }
            let ratio: Float = k_rates / k_nernst;
            if mr_eabs(ratio - 1.0) > 0.01 { return 0; }
            return 1;
        },
        Err(_)       => { return 0; }
    }
}

pub fn mrev_principle_cert(k_forward: Float, k_reverse: Float) -> DomainCert {
    let mut holds: Int = 0;
    if k_forward > 0.0 && k_reverse > 0.0 {
        holds = 1;
    }
    return domain_cert("chem", "microscopic_reversibility", holds);
}

pub fn verify_microscopic_reversibility_principle() -> Bool {
    let k_eq: Float = mr_got(mrev_equilibrium_constant(0.001, 0.00001));
    if mr_eabs(k_eq - 100.0) > 0.0000001 { return false; }
    let k_b_back: Float = mr_got(mrev_reverse_rate(0.001, 100.0));
    if mr_eabs(k_b_back - 0.00001) > 0.0000000001 { return false; }
    let k_f_back: Float = mr_got(mrev_forward_rate(0.00001, 100.0));
    if mr_eabs(k_f_back - 0.001) > 0.0000001 { return false; }
    let k_one: Float = mr_got(mrev_equilibrium_constant(0.5, 0.5));
    if mr_eabs(k_one - 1.0) > 0.0000001 { return false; }
    let k_big: Float = mr_got(mrev_equilibrium_constant(1.0, 0.0001));
    if mr_eabs(k_big - 10000.0) > 0.0000001 { return false; }
    let k_n: Float = mr_got(mrev_keq_from_nernst(1.10, 2.0, 298.0));
    if k_n <= 0.0 { return false; }
    let _consistent: Int = mrev_nernst_consistent(0.001, 0.00001, 1.10, 2.0, 298.0);
    if mrev_equilibrium_constant(0.0, 0.5).is_ok() { return false; }
    if mrev_equilibrium_constant(0.5, 0.0).is_ok() { return false; }
    if mrev_equilibrium_constant(0.0 - 0.1, 0.5).is_ok() { return false; }
    if mrev_reverse_rate(0.0, 1.0).is_ok() { return false; }
    if mrev_forward_rate(0.0, 1.0).is_ok() { return false; }
    return true;
}
