// # Chemistry temperature product invariants
//
// Logline: Rate laws require T > 0 K; T <= 0 K fail-closes.
//
// Setup: Pure Float checks. Imports std/core/domain_cert.oo.
//
// Beats:
//   1. chem_temp_ok(0.0) returns 0.
//   2. chem_temp_ok of a positive Kelvin temperature returns 1.
//   3. chem_temp_cert boxes the law into DomainCert.holds.

import "std/core/primitives/domain_cert.oo";
// T <= 0 K is invalid for a rate law.
pub fn chem_temp_ok(temp_k: Float) -> Int {
    if temp_k <= 0.0 {
        return 0;
    }
    return 1;
}

pub fn chem_temp_cert(temp_k: Float) -> DomainCert {
    return DomainCert {
        domain: "chem",
        law_name: "temp_positive_k",
        holds: chem_temp_ok(temp_k)
    };
}
