// # Raoult vapor pressure law (ideal and non-ideal)
//
// Logline: Ideal P_A = x_A * P_A*. Non-ideal P_A = x_A * gamma_A * P_A*. Non-physical inputs fail closed to 0.
//
// Setup: Pure Float. Mole fraction, activity coefficient, and pure-component pressure are caller-supplied;
// identity is unit-agnostic. At x_A -> 0 the law couples to Henry's law for the dilute limit.
//
// Beats:
//   1. Ideal partial pressure P_A = x_A * P_A* when 0 <= x_A <= 1 and P_A* > 0.
//   2. Non-ideal partial pressure P_A = x_A * gamma_A * P_A* when gamma_A > 0.
//   3. Activity coefficient recovery gamma = P_A / (x_A * P_A*) for inverse queries.
//   4. Henry coupling: at low x_A, P_A = x_A * k_H_eff where k_H_eff = gamma * P_A* (Henry constant coupling).
//   5. Hostile x_A < 0, x_A > 1, P_A* <= 0, or gamma <= 0 returns 0.

import "std/core/primitives/domain_cert.oo";

// Ideal Raoult partial pressure: P_A = x_A * P_A* (mmHg or Pa; identity is unit-agnostic).
pub fn raoult_ideal_partial(x_a: Float, p_a_star: Float) -> Float {
    if x_a < 0.0 {
        return 0.0;
    }
    if x_a > 1.0 {
        return 0.0;
    }
    if p_a_star <= 0.0 {
        return 0.0;
    }
    return x_a * p_a_star;
}

// Non-ideal Raoult partial pressure: P_A = x_A * gamma_A * P_A* with activity coefficient gamma_A.
pub fn raoult_nonideal_partial(x_a: Float, gamma_a: Float, p_a_star: Float) -> Float {
    if x_a < 0.0 {
        return 0.0;
    }
    if x_a > 1.0 {
        return 0.0;
    }
    if p_a_star <= 0.0 {
        return 0.0;
    }
    if gamma_a <= 0.0 {
        return 0.0;
    }
    return x_a * gamma_a * p_a_star;
}

// Recover activity coefficient from observed partial pressure.
// gamma = P_A / (x_A * P_A*); returns 1.0 (ideal reference) on hostile inputs.
pub fn raoult_activity_coefficient(p_a_obs: Float, x_a: Float, p_a_star: Float) -> Float {
    if x_a <= 0.0 {
        return 1.0;
    }
    if p_a_star <= 0.0 {
        return 1.0;
    }
    if p_a_obs < 0.0 {
        return 1.0;
    }
    let denom: Float = x_a * p_a_star;
    if denom <= 0.0 {
        return 1.0;
    }
    let g: Float = p_a_obs / denom;
    if g <= 0.0 {
        return 1.0;
    }
    return g;
}

// Henry coupling: at low x_A, P_A = x_A * (gamma_A * P_A*) = x_A * k_H_eff.
// Effective Henry constant k_H_eff = gamma * P_A* in the Raoult-Henry blend.
pub fn raoult_henry_effective_constant(gamma_a: Float, p_a_star: Float) -> Float {
    if gamma_a <= 0.0 {
        return 0.0;
    }
    if p_a_star <= 0.0 {
        return 0.0;
    }
    return gamma_a * p_a_star;
}

// Domain certificate for the ideal Raoult law.
pub fn raoult_vapor_pressure_cert(x_a: Float, p_a_star: Float) -> DomainCert {
    let mut holds: Int = 0;
    if x_a >= 0.0 && x_a <= 1.0 && p_a_star > 0.0 {
        holds = 1;
    }
    return domain_cert("chem", "raoult_vapor_pressure", holds);
}

pub fn verify_raoult_law_vapor_pressure() -> Bool {
    // Golden: x_A = 0.5, P_A* = 100 mmHg, ideal -> 50 mmHg within 0.1%.
    let p_ideal: Float = raoult_ideal_partial(0.5, 100.0);
    let mut d: Float = p_ideal - 50.0;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > 0.05 {
        return false;
    }

    // Golden non-ideal: gamma = 1.2, x_A = 0.5, P_A* = 100 -> 60 mmHg.
    let p_ni: Float = raoult_nonideal_partial(0.5, 1.2, 100.0);
    d = p_ni - 60.0;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > 0.05 {
        return false;
    }

    // Activity coefficient recovery round-trip: P_A = 60, x = 0.5, P* = 100 -> gamma = 1.2.
    let g: Float = raoult_activity_coefficient(60.0, 0.5, 100.0);
    d = g - 1.2;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > 0.001 {
        return false;
    }

    // Henry coupling: gamma * P_A* acts as effective Henry constant at low x_A.
    let k_h: Float = raoult_henry_effective_constant(1.2, 100.0);
    d = k_h - 120.0;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > 0.0000001 {
        return false;
    }

    // Pure component (x = 1): ideal P = P*, non-ideal P = gamma * P*.
    let pure_ideal: Float = raoult_ideal_partial(1.0, 100.0);
    d = pure_ideal - 100.0;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > 0.0000001 {
        return false;
    }
    let pure_ni: Float = raoult_nonideal_partial(1.0, 1.5, 100.0);
    d = pure_ni - 150.0;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > 0.0000001 {
        return false;
    }

    // Zero mole fraction yields zero partial pressure.
    if raoult_ideal_partial(0.0, 100.0) != 0.0 {
        return false;
    }
    if raoult_nonideal_partial(0.0, 1.2, 100.0) != 0.0 {
        return false;
    }

    // Hostile inputs fail closed to 0.
    if raoult_ideal_partial(0.0 - 0.1, 100.0) != 0.0 {
        return false;
    }
    if raoult_ideal_partial(1.5, 100.0) != 0.0 {
        return false;
    }
    if raoult_ideal_partial(0.5, 0.0) != 0.0 {
        return false;
    }
    if raoult_nonideal_partial(0.5, 0.0, 100.0) != 0.0 {
        return false;
    }
    if raoult_nonideal_partial(0.5, 1.0, 0.0) != 0.0 {
        return false;
    }
    return true;
}
