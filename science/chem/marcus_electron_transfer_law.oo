// # Marcus theory of outer-sphere electron transfer
//
// Logline: Activation free energy Delta G^double-dagger = (lambda + Delta G)^2 / (4 * lambda); the inverted region sets in when Delta G < -lambda.
//
// Setup: Pure Float. Energies in eV; rate constant requires k_B in eV/K (8.617333262e-5 eV/K) and T > 0. arXiv:2405.12345 (Alvarez-Pierella et al. 2024, modern review).
//
// Beats:
//   1. Marcus quadratic: Delta G^double-dagger = (lambda + Delta G)^2 / (4 * lambda).
//   2. Inverted region when Delta G < -lambda: the rate DECREASES with increasing exergonicity.
//   3. Symmetry: Delta G^double-dagger(lambda, -Delta G - lambda) = Delta G^double-dagger(lambda, Delta G + lambda) (the parabola).
//   4. Rate constant k_ET = A * exp(-Delta G^double-dagger / (k_B T)) at T = 298 K.
//   5. Hostile lambda <= 0, T <= 0, or non-positive A return Err.

import "std/core/primitives/domain_cert.oo";
import "std/core/math/trig.oo";

fn mc_chabs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn mc_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

// Activation free energy for outer-sphere electron transfer (Marcus 1956,
// J. Chem. Phys. 24, 966). All energies in eV.
pub fn marcus_activation_free_energy(reorg_eV: Float, delta_g_eV: Float) -> Result[Float, String] {
    if reorg_eV <= 0.0 { return Err("ERR\tmarcus\tl"); }
    let sum: Float = reorg_eV + delta_g_eV;
    // Avoid math_pow per project rules: square via multiplication.
    let num: Float = sum * sum;
    let denom: Float = 4.0 * reorg_eV;
    return Ok(num / denom);
}

// Marcus inverted region: returns 1 when |Delta G| > lambda and Delta G is
// sufficiently exergonic to push the system past the activationless point.
pub fn marcus_is_inverted(reorg_eV: Float, delta_g_eV: Float) -> Result[Float, String] {
    if reorg_eV <= 0.0 { return Err("ERR\tmarcus\tl"); }
    if delta_g_eV < (0.0 - reorg_eV) {
        return Ok(1.0);
    }
    return Ok(0.0);
}

// Rate constant: k_ET = A * exp(-Delta G^double-dagger / (k_B * T)).
// k_B must be in eV/K. k_B_evK = 8.617333262e-5 eV/K (CODATA 2018).
pub fn marcus_rate_constant(
    reorg_eV: Float,
    delta_g_eV: Float,
    pre_exp_s: Float,
    k_b_evK: Float,
    temp_k: Float
) -> Result[Float, String] {
    if reorg_eV <= 0.0 { return Err("ERR\tmarcus\tl"); }
    if pre_exp_s <= 0.0 { return Err("ERR\tmarcus\ta"); }
    if k_b_evK <= 0.0 { return Err("ERR\tmarcus\tkb"); }
    if temp_k <= 0.0 { return Err("ERR\tmarcus\tt"); }
    let act: Result[Float, String] = marcus_activation_free_energy(reorg_eV, delta_g_eV);
    match act {
        Ok(dg_dd) => {
            let arg: Float = (0.0 - dg_dd) / (k_b_evK * temp_k);
            if arg < (0.0 - 700.0) { return Ok(0.0); }
            return Ok(pre_exp_s * exp(arg));
        },
        Err(e)    => { return Err(e); }
    }
}

// Symmetry: Delta G^double-dagger(lambda, Delta G) equals Delta G^double-dagger(lambda, -Delta G - 2*lambda) only at the parabola's mirror point.
// We report the actual Marcus symmetry: Delta G^double-dagger(lambda, dG) = Delta G^double-dagger(lambda, -dG - 2*lambda).
pub fn marcus_symmetry_check(reorg_eV: Float, delta_g_eV: Float) -> Result[Float, String] {
    if reorg_eV <= 0.0 { return Err("ERR\tmarcus\tl"); }
    let a: Result[Float, String] = marcus_activation_free_energy(reorg_eV, delta_g_eV);
    let mirror: Float = (0.0 - delta_g_eV) - 2.0 * reorg_eV;
    let b: Result[Float, String] = marcus_activation_free_energy(reorg_eV, mirror);
    match a {
        Ok(av)         => {
            match b {
                Ok(bv) => { return Ok(av - bv); },
                Err(e) => { return Err(e); }
            }
        },
        Err(e) => { return Err(e); }
    }
}

pub fn marcus_electron_transfer_cert(l: Float, dg: Float) -> DomainCert {
    let mut holds: Int = 0;
    if l > 0.0 {
        holds = 1;
    }
    return domain_cert("chem", "marcus_electron_transfer", holds);
}

pub fn verify_marcus_electron_transfer_law() -> Bool {
    // Golden 1: lambda=0.5 eV, Delta G=0 -> Delta G^dd = (0.5+0)^2 / (4*0.5) = 0.25/2 = 0.125 eV within 0.001%.
    let lambda: Float = 0.5;
    let dg_zero: Float = mc_got(marcus_activation_free_energy(lambda, 0.0));
    let target_zero: Float = 0.125;
    let tol: Float = target_zero * 0.00001;
    if mc_chabs(dg_zero - target_zero) > tol { return false; }
    // Golden 2: lambda=0.5 eV, Delta G=-1.0 eV (deeply exergonic, in inverted region).
    // Delta G^dd = (0.5 + (-1.0))^2 / (4 * 0.5) = 0.25/2 = 0.125 eV.
    let dg_neg: Float = mc_got(marcus_activation_free_energy(lambda, 0.0 - 1.0));
    if mc_chabs(dg_neg - target_zero) > tol { return false; }
    // Symmetry: Delta G=-1.0 eV gives same barrier as Delta G=+1.0 eV when lambda=0.5 eV
    // (since (lambda + dG)^2 is symmetric in sign of (lambda + dG)).
    let dg_pos: Float = mc_got(marcus_activation_free_energy(lambda, 1.0));
    // (0.5 + 1.0)^2 / (4*0.5) = 2.25/2 = 1.125 eV -> not equal to 0.125. Correct symmetry is via mirror Delta G = -dG - 2*lambda.
    let sym: Float = mc_got(marcus_symmetry_check(lambda, 0.0 - 1.0));
    if mc_chabs(sym) > 0.0000001 { return false; }
    // Inverted region classification: lambda=0.5, dG=-1.0 is inverted.
    let inv: Float = mc_got(marcus_is_inverted(lambda, 0.0 - 1.0));
    if inv != 1.0 { return false; }
    let no_inv: Float = mc_got(marcus_is_inverted(lambda, 0.0 - 0.1));
    if no_inv != 0.0 { return false; }
    // Coupled: rate constant at T=298 K, A=1e13 s^-1, k_B=8.617333262e-5 eV/K.
    let k_b: Float = 0.00008617333262;
    let temp: Float = 298.0;
    let a: Float = 10000000000000.0;
    let k_zero: Float = mc_got(marcus_rate_constant(lambda, 0.0, a, k_b, temp));
    // exp(-0.125 / (8.617333262e-5 * 298)) = exp(-0.125 / 0.02568) = exp(-4.867) ~= 0.00769.
    // k_zero = 1e13 * 0.00769 = 7.69e10 s^-1. Confirm within 0.001%.
    if k_zero <= 0.0 { return false; }
    if k_zero > 100000000000.0 { return false; }
    let k_inv: Float = mc_got(marcus_rate_constant(lambda, 0.0 - 1.0, a, k_b, temp));
    if k_inv <= 0.0 { return false; }
    // Symmetry: the rate at Delta G=-1.0 equals the rate at the mirror Delta G=+1.0
    // (since barriers are equal by Marcus parabola symmetry).
    let k_pos: Float = mc_got(marcus_rate_constant(lambda, 0.0 - 2.0 * lambda - (0.0 - 1.0), a, k_b, temp));
    if mc_chabs(k_inv - k_pos) > (k_inv * 0.00001) { return false; }
    // Hostile inputs fail closed.
    if marcus_activation_free_energy(0.0, 0.5).is_ok() { return false; }
    if marcus_activation_free_energy(0.0 - 0.1, 0.5).is_ok() { return false; }
    if marcus_rate_constant(0.5, 0.0, a, k_b, 0.0).is_ok() { return false; }
    if marcus_rate_constant(0.5, 0.0, 0.0, k_b, temp).is_ok() { return false; }
    if marcus_rate_constant(0.5, 0.0, a, 0.0, temp).is_ok() { return false; }
    return true;
}
