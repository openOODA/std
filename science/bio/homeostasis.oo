// # Cellular Homeostasis and Self-Regulating Negative Feedback Loop
//
// Logline: Homeostatic controller maintaining resource equilibrium against internal load spikes and environmental stress.
//
// Setup: Pure feedback controller modeled on biological endocrine and cellular regulation loops.
//
// Beats:
//   1. Construct homeostatic sensor with target setpoint and tolerance margin.
//   2. Observe state variable (memory pressure, thread count, latency).
//   3. Compute regulation delta via negative feedback.
//   4. Apply allostatic adaptation under prolonged stress.
//   5. Quarantine compromised processes to maintain whole-organism integrity.

type Homeostat = struct {
    setpoint: Float,
    margin: Float,
    integral_error: Float,
    is_quarantined: Bool
};

pub fn homeo_new(setpoint: Float, margin: Float) -> Homeostat {
    return Homeostat {
        setpoint: setpoint,
        margin: margin,
        integral_error: 0.0,
        is_quarantined: false
    };
}

// Observe sensor reading and calculate negative feedback adjustment
pub fn homeo_regulate(h: Homeostat, current_val: Float) -> Float {
    if h.is_quarantined {
        return 0.0;
    }
    let error: Float = h.setpoint - current_val;
    // Proportional response
    let p_term: Float = error * 0.5;
    return p_term;
}

// Check if system is in normal homeostatic equilibrium
pub fn homeo_is_balanced(h: Homeostat, current_val: Float) -> Bool {
    let diff: Float = current_val - h.setpoint;
    let mut abs_diff: Float = diff;
    if abs_diff < 0.0 {
        abs_diff = 0.0 - abs_diff;
    }
    if abs_diff <= h.margin {
        return true;
    }
    return false;
}

// Biological immune isolation when critical boundaries are breached
pub fn homeo_trigger_immune_quarantine(h: Homeostat) -> Homeostat {
    return Homeostat {
        setpoint: h.setpoint,
        margin: h.margin,
        integral_error: h.integral_error,
        is_quarantined: true
    };
}

