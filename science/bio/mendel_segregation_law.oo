// # Mendel law of segregation and independent gamete formation
//
// Logline: Each gamete receives one allele per gene; heterozygote Aa produces 50% A and 50% a. Alleles outside {0, 1} return Err on Float kernels.
//
// Setup: Pure Float. Alleles are encoded 0 = A (dominant) or 1 = a (recessive); the identity is unit-agnostic.
//
// Beats:
//   1. Compute gamete frequencies from a parental allele pair.
//   2. Compute offspring genotype frequencies for any parental cross.
//   3. Classify genotype as homozygous dominant (0), heterozygous (1), or homozygous recessive (2).
//   4. Hostile alleles outside {0, 1} return Err on frequencies; class stays -1.
//   5. AA x AA and aa x aa heterozygous frequency is Ok(0).

fn mendel_allele_ok(a: Int) -> Int {
    if a == 0 { return 1; }
    if a == 1 { return 1; }
    return 0;
}

pub fn mendel_allele_freq_dominant(allele1: Int, allele2: Int) -> Result[Float, String] {
    if mendel_allele_ok(allele1) != 1 { return Err("ERR\tmd\tdomain"); }
    if mendel_allele_ok(allele2) != 1 { return Err("ERR\tmd\tdomain"); }
    let mut n: Float = 0.0;
    if allele1 == 0 { n = n + 1.0; }
    if allele2 == 0 { n = n + 1.0; }
    return Ok(0.5 * n);
}

pub fn mendel_allele_freq_recessive(allele1: Int, allele2: Int) -> Result[Float, String] {
    if mendel_allele_ok(allele1) != 1 { return Err("ERR\tmd\tdomain"); }
    if mendel_allele_ok(allele2) != 1 { return Err("ERR\tmd\tdomain"); }
    let mut n: Float = 0.0;
    if allele1 == 1 { n = n + 1.0; }
    if allele2 == 1 { n = n + 1.0; }
    return Ok(0.5 * n);
}

fn md_igot(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn mendel_genotype_class(allele1: Int, allele2: Int) -> Result[Int, String] {
    if mendel_allele_ok(allele1) != 1 { return Err("ERR\tmd\tallele"); }
    if mendel_allele_ok(allele2) != 1 { return Err("ERR\tmd\tallele"); }
    if allele1 == allele2 {
        if allele1 == 0 { return Ok(0); }
        return Ok(2);
    }
    return Ok(1);
}

pub fn mendel_offspring_heterozygous_freq(
    p1_allele1: Int, p1_allele2: Int,
    p2_allele1: Int, p2_allele2: Int
) -> Result[Float, String] {
    if mendel_allele_ok(p1_allele1) != 1 { return Err("ERR\tmd\tdomain"); }
    if mendel_allele_ok(p1_allele2) != 1 { return Err("ERR\tmd\tdomain"); }
    if mendel_allele_ok(p2_allele1) != 1 { return Err("ERR\tmd\tdomain"); }
    if mendel_allele_ok(p2_allele2) != 1 { return Err("ERR\tmd\tdomain"); }
    let mut n_a_p1: Float = 0.0;
    if p1_allele1 == 0 { n_a_p1 = n_a_p1 + 1.0; }
    if p1_allele2 == 0 { n_a_p1 = n_a_p1 + 1.0; }
    let p_a_p1: Float = 0.5 * n_a_p1;
    let mut n_a_p2: Float = 0.0;
    if p2_allele1 == 0 { n_a_p2 = n_a_p2 + 1.0; }
    if p2_allele2 == 0 { n_a_p2 = n_a_p2 + 1.0; }
    let p_a_p2: Float = 0.5 * n_a_p2;
    let p_homo_dominant: Float = p_a_p1 * p_a_p2;
    let p_homo_recessive: Float = (1.0 - p_a_p1) * (1.0 - p_a_p2);
    let p_het: Float = 1.0 - p_homo_dominant - p_homo_recessive;
    if p_het < 0.0 { return Ok(0.0); }
    return Ok(p_het);
}

fn md_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

pub fn verify_mendel_segregation_law() -> Bool {
    let mut d: Float = md_got(mendel_offspring_heterozygous_freq(0, 0, 0, 0));
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0000001 { return false; }

    d = md_got(mendel_offspring_heterozygous_freq(0, 1, 0, 1)) - 0.5;
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0000001 { return false; }

    d = md_got(mendel_offspring_heterozygous_freq(0, 0, 1, 1)) - 1.0;
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0000001 { return false; }

    d = md_got(mendel_offspring_heterozygous_freq(1, 1, 1, 1));
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0000001 { return false; }

    d = md_got(mendel_offspring_heterozygous_freq(0, 1, 1, 1)) - 0.5;
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0000001 { return false; }

    if md_igot(mendel_genotype_class(0, 0)) != 0 { return false; }
    if md_igot(mendel_genotype_class(0, 1)) != 1 { return false; }
    if md_igot(mendel_genotype_class(1, 0)) != 1 { return false; }
    if md_igot(mendel_genotype_class(1, 1)) != 2 { return false; }

    d = md_got(mendel_allele_freq_dominant(0, 1)) - 0.5;
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0000001 { return false; }
    d = md_got(mendel_allele_freq_recessive(0, 1)) - 0.5;
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0000001 { return false; }

    d = md_got(mendel_allele_freq_dominant(0, 0)) - 1.0;
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0000001 { return false; }

    d = md_got(mendel_allele_freq_dominant(1, 1));
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0000001 { return false; }

    if mendel_allele_freq_dominant(0 - 1, 0).is_ok() { return false; }
    if mendel_allele_freq_dominant(2, 0).is_ok() { return false; }
    if mendel_offspring_heterozygous_freq(0, 0, 5, 0).is_ok() { return false; }
    if mendel_genotype_class(0 - 1, 0).is_ok() { return false; }
    if mendel_genotype_class(0, 99).is_ok() { return false; }
    return true;
}
