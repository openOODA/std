// # Optogenetic Photoreceptor Transcriptional Light Switches
//
// Logline: Simulates light-induced photoreceptor activation, dark thermal reversion, and pulsatile optogenetic gene expression.
//
// Setup: Biophysical ODE model of light-oxygen-voltage (LOV2/EL222 or PhyB/PIF) photoswitching kinetics and light-gated transcription.
//
// Beats:
//   1. Define OptoParams, OptoPhotoreceptorState, and OptoResponseResult data structures.
//   2. Compute 3-variable ODE system for dark ground state, light-excited active conformation, and reporter mRNA.
//   3. Advance optogenetic switch dynamics across blue/red illumination pulses and dark recovery intervals.

type OptoParams = struct {
    k_photo_activation: Float, // Photon absorption rate per mW/cm2
    k_thermal_reversion: Float, // Dark relaxation rate s^-1
    k_transcription_max: Float,
    k_transcription_basal: Float,
    d_mrna: Float
};

type OptoPhotoreceptorState = struct {
    dark_inactive_fraction: Float,
    light_active_fraction: Float,
    mrna_output_conc: Float,
    time_seconds: Float
};

type OptoResponseResult = struct {
    active_fraction: Float,
    mrna_production_rate: Float,
    duty_cycle_fraction: Float,
    is_illuminated: Bool
};

pub fn opto_derivatives(
    st: OptoPhotoreceptorState,
    p: OptoParams,
    light_intensity_mw_cm2: Float,
) -> OptoPhotoreceptorState {
    let act_rate: Int = p.k_photo_activation * light_intensity_mw_cm2 * st.dark_inactive_fraction;    let rev_rate: Int = p.k_thermal_reversion * st.light_active_fraction;
    // d[Active]/dt = act_rate - rev_rate
    let d_active: Int = act_rate - rev_rate;    // d[Inactive]/dt = - d_active
    let d_inactive: Int = -d_active;
    // dmRNA/dt = k_basal + k_max * [Active] - d_mrna * [mRNA]
    let tx_rate: Int = p.k_transcription_basal + (p.k_transcription_max * st.light_active_fraction);    let d_mrna: Int = tx_rate - (p.d_mrna * st.mrna_output_conc);
    return OptoPhotoreceptorState {
        dark_inactive_fraction: d_inactive,
        light_active_fraction: d_active,
        mrna_output_conc: d_mrna,
        time_seconds: st.time_seconds
    };
}

pub fn opto_step(
    st: OptoPhotoreceptorState,
    p: OptoParams,
    intensity: Float,
    dt: Float,
) -> OptoPhotoreceptorState {
    let d: OptoPhotoreceptorState = opto_derivatives(st, p, intensity);
    let next_inact: Int = st.dark_inactive_fraction + (d.dark_inactive_fraction * dt);    let next_act: Int = st.light_active_fraction + (d.light_active_fraction * dt);    let next_mrna: Int = st.mrna_output_conc + (d.mrna_output_conc * dt);
    let mut cl_act: Int = next_act;


    if next_act < 0.0 {


        cl_act = 0.0 } else if next_act > 1.0 { 1.0;


    }
    let cl_inact: Float = 1.0 - cl_act;
    return OptoPhotoreceptorState {
        dark_inactive_fraction: cl_inact,
        light_active_fraction: cl_act,
        mrna_output_conc: if next_mrna < 0.0 { 0.0 } else { next_mrna },
        time_seconds: st.time_seconds + dt
    };
}
