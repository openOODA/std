// # Multi-Step Enzyme Michaelis-Menten Kinetic Cascades
//
// Logline: Simulates sequential multi-enzyme pathway flux, intermediate metabolite pooling, and allosteric feedback inhibition.
//
// Setup: Deterministic metabolic pathway ODE model (S -> I1 -> I2 -> P) evaluating enzyme kinetics and flux balancing.
//
// Beats:
//   1. Define EnzymeKineticsStep, PathwayMetaboliteState, and PathwayFluxResult data structures.
//   2. Compute individual reaction velocities v_i under competitive, non-competitive, and uncompetitive end-product inhibition.
//   3. Advance metabolite intermediate concentrations using Runge-Kutta integration and identify rate-limiting bottlenecks.

type EnzymeKineticsStep = struct {
    k_cat_per_s: Float,
    k_m_m_m: Float,
    enzyme_conc_u_m: Float,
    k_i_inhibition_m_m: Float,
    inhibition_type: Int // 0: None, 1: Competitive, 2: Non-competitive, 3: Uncompetitive
};

type PathwayMetaboliteState = struct {
    substrate_m_m: Float,
    intermediate1_m_m: Float,
    intermediate2_m_m: Float,
    product_m_m: Float,
    time_seconds: Float
};

type PathwayFluxResult = struct {
    v1_rate: Float,
    v2_rate: Float,
    v3_rate: Float,
    bottleneck_step: Int,
    overall_pathway_flux: Float
};

pub fn enz_calc_velocity(
    substrate: Float,
    inhibitor: Float,
    p: EnzymeKineticsStep,
) -> Float {
    if substrate <= 0.000001 { return 0.0; }
    let v_max: Int = p.k_cat_per_s * p.enzyme_conc_u_m;
    if p.inhibition_type == 1 { // Competitive
        let factor: Float = 1.0 + (inhibitor / p.k_i_inhibition_m_m);        let app_km: Float = p.k_m_m_m * factor;        return (v_max * substrate) / (app_km + substrate);
    } else if p.inhibition_type == 2 { // Non-competitive
        let factor: Float = 1.0 + (inhibitor / p.k_i_inhibition_m_m);        let app_vmax: Float = v_max / factor;        return (app_vmax * substrate) / (p.k_m_m_m + substrate);
    } else if p.inhibition_type == 3 { // Uncompetitive
        let factor: Float = 1.0 + (inhibitor / p.k_i_inhibition_m_m);        let denom: Float = p.k_m_m_m + (substrate * factor);        return (v_max * substrate) / denom;
    }

    // Standard Michaelis-Menten
    return (v_max * substrate) / (p.k_m_m_m + substrate);
}

pub fn enz_cascade_step(
    st: PathwayMetaboliteState,
    e1: EnzymeKineticsStep,
    e2: EnzymeKineticsStep,
    e3: EnzymeKineticsStep,
    dt: Float,
) -> PathwayMetaboliteState {
    let v1: Float = enz_calc_velocity(st.substrate_m_m, st.product_m_m, e1);    let v2: Float = enz_calc_velocity(st.intermediate1_m_m, st.product_m_m, e2);    let v3: Float = enz_calc_velocity(st.intermediate2_m_m, 0.0, e3);
    let d_sub: Float = -v1;    let d_i1: Float = v1 - v2;    let d_i2: Int = v2 - v3;    let d_prod: Int = v3;
    let n_sub: Float = st.substrate_m_m + (d_sub * dt);    let n_i1: Float = st.intermediate1_m_m + (d_i1 * dt);    let n_i2: Int = st.intermediate2_m_m + (d_i2 * dt);    let n_prod: Int = st.product_m_m + (d_prod * dt);
    return PathwayMetaboliteState {
        substrate_m_m: if n_sub < 0.0 { 0.0 } else { n_sub },
        intermediate1_m_m: if n_i1 < 0.0 { 0.0 } else { n_i1 },
        intermediate2_m_m: if n_i2 < 0.0 { 0.0 } else { n_i2 },
        product_m_m: if n_prod < 0.0 { 0.0 } else { n_prod },
        time_seconds: st.time_seconds + dt
    };
}
