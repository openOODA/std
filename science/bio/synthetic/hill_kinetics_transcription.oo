// # Hill Kinetics for Synthetic Gene Transcription
//
// Logline: Models cooperative transcriptional activation, repression, and multi-input combinatorial regulation.
//
// Setup: Fundamental biophysical transfer function modeling transcription factor binding cooperativity and effective promoter activity.
//
// Beats:
//   1. Define HillParameters, PromoterTransferCurve, and CombinatorialInput data structures.
//   2. Calculate activation and repression Hill response functions with basal leak and maximal expression rates.
//   3. Evaluate multi-ligand synergistic and competitive binding promoter logic transfer curves.

type HillParameters = struct {
    k_half: Float,
    cooperativity_n: Int,
    v_basal: Float,
    v_max: Float
};

type PromoterTransferCurve = struct {
    input_conc: Float,
    transcription_rate: Float,
    fold_induction: Float,
    sensitivity_sens: Float
};

type CombinatorialInput = struct {
    conc_a: Float,
    conc_b: Float,
    k_a: Float,
    k_b: Float,
    n_a: Int,
    n_b: Int
};

pub fn hill_math_pow(base: Float, exp_int: Int) -> Float {
    if base <= 0.0 { return 0.0; }
    if exp_int <= 0 { return 1.0; }
    if exp_int == 1 { return base; }
    if exp_int == 2 { return base * base; }
    if exp_int == 3 { return base * base * base; }
    if exp_int == 4 { return (base * base) * (base * base); }
    let mut res: Float = 1.0;
    let mut i: Int = 0;
    while i < exp_int {
        res = res * base;
        i = i + 1;
    }
    return res;
}

pub fn hill_activation(input_conc: Float, p: HillParameters) -> Float {
    if input_conc <= 0.0 { return p.v_basal; }
    let num: Float = hill_math_pow(input_conc, p.cooperativity_n);    let den_k: Float = hill_math_pow(p.k_half, p.cooperativity_n);    let denom = den_k + num;
    if denom <= 0.0000001 { return p.v_basal; }
    let active_frac: Float = num / denom;    return p.v_basal + ((p.v_max - p.v_basal) * active_frac);
}

pub fn hill_repression(input_conc: Float, p: HillParameters) -> Float {
    if input_conc <= 0.0 { return p.v_max; }
    let num: Float = hill_math_pow(p.k_half, p.cooperativity_n);    let in_n: Float = hill_math_pow(input_conc, p.cooperativity_n);    let denom = num + in_n;
    if denom <= 0.0000001 { return p.v_basal; }
    let rep_frac: Float = num / denom;    return p.v_basal + ((p.v_max - p.v_basal) * rep_frac);
}

pub fn hill_evaluate_transfer(input_conc: Float, p: HillParameters, is_activator: Bool) -> PromoterTransferCurve {
    let mut rate: Int = hill_repression(input_conc, p);

    if is_activator {

        rate = hill_activation(input_conc, p);

    }

    let mut base_rate: Float = 0.000001;


    if p.v_basal > 0.000001 {


        base_rate = p.v_basal;


    }
    let fold: Int = rate / base_rate;
    let sens: Float = if input_conc > 0.0001 {        let delta: Float = input_conc * 0.01;        let mut r_up: Int = hill_repression(input_conc + delta, p);

        if is_activator {

            r_up = hill_activation(input_conc + delta, p);

        }
        let dr: Float = (r_up - rate) / delta;        (dr * input_conc) / rate
    } else {
        0.0
    };

    return PromoterTransferCurve {
        input_conc: input_conc,
        transcription_rate: rate,
        fold_induction: fold,
        sensitivity_sens: sens
    };
}

pub fn hill_and_gate_promoter(inputs: CombinatorialInput, v_max: Float, v_basal: Float) -> Float {
    let num_a: Float = hill_math_pow(inputs.conc_a, inputs.n_a);    let den_a: Float = hill_math_pow(inputs.k_a, inputs.n_a) + num_a;    let num_b: Float = hill_math_pow(inputs.conc_b, inputs.n_b);    let den_b: Float = hill_math_pow(inputs.k_b, inputs.n_b) + num_b;
    if den_a <= 0.000001 || den_b <= 0.000001 { return v_basal; }
    let frac: Float = (num_a / den_a) * (num_b / den_b);    return v_basal + ((v_max - v_basal) * frac);
}

pub fn hill_or_gate_promoter(inputs: CombinatorialInput, v_max: Float, v_basal: Float) -> Float {
    let num_a: Float = hill_math_pow(inputs.conc_a, inputs.n_a);    let den_a: Float = hill_math_pow(inputs.k_a, inputs.n_a) + num_a;    let num_b: Float = hill_math_pow(inputs.conc_b, inputs.n_b);    let den_b: Float = hill_math_pow(inputs.k_b, inputs.n_b) + num_b;
    let mut fa: Float = 0.0;

    if den_a > 0.000001 {

        fa = num_a / den_a;

    }
    let mut fb: Float = 0.0;

    if den_b > 0.000001 {

        fb = num_b / den_b;

    }
    let frac: Int = fa + fb - (fa * fb);    return v_basal + ((v_max - v_basal) * frac);
}
