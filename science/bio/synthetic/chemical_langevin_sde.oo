// # Chemical Langevin Stochastic Differential Equation (CLE)
//
// Logline: Simulates continuous gene expression trajectories with multiplicative intrinsic noise via Ito SDE integration.
//
// Setup: Intermediate stochastic approximation bridge connecting macroscopic deterministic ODEs and discrete master equations.
//
// Beats:
//   1. Define CleParams, CleState, and CleStepResult data structures.
//   2. Compute deterministic drift vector and stochastic diffusion matrix terms.
//   3. Advance continuous state using Euler-Maruyama stochastic numerical integration step.

type CleParams = struct {
    k_transcription: Float,
    d_mrna: Float,
    k_translation: Float,
    d_protein: Float,
    cell_volume_scaling: Float
};

type CleState = struct {
    mrna_conc: Float,
    protein_conc: Float,
    time_min: Float
};

type CleStepResult = struct {
    state: CleState,
    drift_mrna: Float,
    diffusion_mrna: Float,
    drift_protein: Float,
    diffusion_protein: Float
};

pub fn cle_sqrt(val: Float) -> Float {
    if val <= 0.0 { return 0.0; }
    let mut guess: Float = val / 2.0;    if guess < 0.01 { guess = 0.01; }
    let mut iter: Int = 0;    while iter < 8 {
        guess = 0.5 * (guess + (val / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn cle_euler_maruyama_step(
    cur: CleState,
    p: CleParams,
    dt: Float,
    normal_dw1: Float, // Standard Gaussian random variable N(0, 1)
    normal_dw2: Float,
    normal_dw3: Float,
    normal_dw4: Float,
) -> CleStepResult {
    let mut m: Int = cur.mrna_conc;

    if cur.mrna_conc < 0.0 {

        m = 0.0;

    }
    let mut pr: Int = cur.protein_conc;

    if cur.protein_conc < 0.0 {

        pr = 0.0;

    }

    // Propensities:
    // a1: tx, a2: mrna deg, a3: tl, a4: protein deg
    let a1: Int = p.k_transcription;    let a2: Int = p.d_mrna * m;    let a3: Int = p.k_translation * m;    let a4: Int = p.d_protein * pr;
    let sqrt_dt: Float = cle_sqrt(dt);
    // dM = (a1 - a2)*dt + sqrt(a1)*dW1*sqrt(dt) - sqrt(a2)*dW2*sqrt(dt)
    let drift_m: Int = (a1 - a2) * dt;    let diff_m: Float = (cle_sqrt(a1) * normal_dw1 * sqrt_dt) - (cle_sqrt(a2) * normal_dw2 * sqrt_dt);
    // dP = (a3 - a4)*dt + sqrt(a3)*dW3*sqrt(dt) - sqrt(a4)*dW4*sqrt(dt)
    let drift_p: Int = (a3 - a4) * dt;    let diff_p: Float = (cle_sqrt(a3) * normal_dw3 * sqrt_dt) - (cle_sqrt(a4) * normal_dw4 * sqrt_dt);
    let next_m: Float = m + drift_m + diff_m;    let next_p: Float = pr + drift_p + diff_p;
    let res_st: CleState = CleState {        mrna_conc: if next_m < 0.0 { 0.0 } else { next_m },
        protein_conc: if next_p < 0.0 { 0.0 } else { next_p },
        time_min: cur.time_min + dt
    };

    return CleStepResult {
        state: res_st,
        drift_mrna: a1 - a2,
        diffusion_mrna: diff_m,
        drift_protein: a3 - a4,
        diffusion_protein: diff_p
    };
}
