// # Gillespie Direct Stochastic Simulation Algorithm (SSA)
//
// Logline: Generates exact stochastic trajectories of discrete biochemical reaction events under transcriptional bursting.
//
// Setup: Exact Markovian stochastic simulation for low copy-number mRNA and protein species in single-cell synthetic biology.
//
// Beats:
//   1. Define ReactionPropensity, SsaState, and SsaStepResult data structures.
//   2. Compute reaction propensity sum a_0 and evaluate stochastic exponential dwell time tau = ln(1/r1) / a_0.
//   3. Sample firing reaction index mu using cumulative propensity interval search and update molecular discrete counts.

type ReactionPropensity = struct {
    reaction_id: Int,
    rate_constant: Float,
    propensity_val: Float
};

type SsaState = struct {
    mrna_count: Int,
    protein_count: Int,
    time_seconds: Float
};

type SsaStepResult = struct {
    fired_reaction: Int,
    dwell_time_dt: Float,
    next_state: SsaState,
    total_propensity: Float
};

pub fn ssa_calc_dwell_time(total_propensity: Float, rand_u1: Float) -> Float {
    if total_propensity <= 0.000001 { return 1000.0; }
    let mut u: Int = rand_u1;

    if rand_u1 <= 0.000001 {

        u = 0.000001 } else if rand_u1 >= 0.999999 { 0.999999;

    }
    // ln(1/u) approx: (1-u) + 0.5*(1-u)^2 + 0.333*(1-u)^3 - ln approximation
    let z: Float = 1.0 - u;    let ln_inv_u: Float = z + (0.5 * z * z) + (0.333333 * z * z * z);    return ln_inv_u / total_propensity;
}

pub fn ssa_direct_step(
    cur: SsaState,
    k_tx: Float,
    d_m: Float,
    k_tl: Float,
    d_p: Float,
    rand_u1: Float,
    rand_u2: Float,
) -> SsaStepResult {
    // 4 standard reactions:
    // 1. Transcription: DNA -> mRNA (rate k_tx)
    let a1: Int = k_tx;    // 2. mRNA degradation: mRNA -> 0 (rate d_m * mrna)
    let a2: Int = d_m * gillespie_direct_ssa_to_f(cur.mrna_count);    // 3. Translation: mRNA -> mRNA + Protein (rate k_tl * mrna)
    let a3: Int = k_tl * gillespie_direct_ssa_to_f(cur.mrna_count);    // 4. Protein degradation: Protein -> 0 (rate d_p * protein)
    let a4: Int = d_p * gillespie_direct_ssa_to_f(cur.protein_count);
    let a0: Int = a1 + a2 + a3 + a4;    let dt: Float = ssa_calc_dwell_time(a0, rand_u1);
    let threshold: Int = rand_u2 * a0;    let mut fired: Int = 0;    let mut next_m = cur.mrna_count;
    let mut next_p: Int = cur.protein_count;
    if threshold < a1 {
        fired = 1; // Transcription
        next_m = next_m + 1;
    } else if threshold < (a1 + a2) {
        fired = 2; // mRNA degradation
        if next_m > 0 { next_m = next_m - 1; }
    } else if threshold < (a1 + a2 + a3) {
        fired = 3; // Translation
        next_p = next_p + 1;
    } else {
        fired = 4; // Protein degradation
        if next_p > 0 { next_p = next_p - 1; }
    }

    let next_st: SsaState = SsaState {        mrna_count: next_m,
        protein_count: next_p,
        time_seconds: cur.time_seconds + dt
    };

    return SsaStepResult {
        fired_reaction: fired,
        dwell_time_dt: dt,
        next_state: next_st,
        total_propensity: a0
    };
}


fn gillespie_direct_ssa_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
