// # Quorum Sensing LuxI/LuxR Signaling & Threshold Activation
//
// Logline: Models acyl-homoserine lactone (AHL) synthesis by LuxI, LuxR-AHL dimerization, and promoter induction thresholds.
//
// Setup: Canonical Vibrio fischeri quorum sensing circuit quantifying cell-density dependent transcriptional activation.
//
// Beats:
//   1. Define LuxQuorumParams, LuxSensingState, and QuorumInductionResult data structures.
//   2. Compute LuxR-AHL complex dimerization equilibrium [LuxR2-AHL2] and Plux promoter occupancy.
//   3. Determine critical quorum sensing activation threshold concentration and induction fold.

type LuxQuorumParams = struct {
    k_synth_ahl: Float, // LuxI AHL synthesis rate
    kd_luxr_ahl: Float, // LuxR-AHL binding affinity
    kd_dimerization: Float, // Dimerization constant
    basal_promoter_rate: Float,
    induced_promoter_rate: Float,
    degradation_ahl: Float
};

type LuxSensingState = struct {
    lux_i_conc: Float,
    lux_r_conc: Float,
    ahl_conc_nm: Float
};

type QuorumInductionResult = struct {
    active_dimer_conc: Float,
    promoter_output: Float,
    fraction_activated: Float,
    is_above_threshold: Bool
};

pub fn lux_calc_active_complex(
    luxr_conc: Float,
    ahl_conc: Float,
    kd_ahl: Float,
    kd_dimer: Float,
) -> Float {
    if luxr_conc <= 0.0 || ahl_conc <= 0.0 { return 0.0; }
    // Monomer complex: [LuxR-AHL] = (LuxR * AHL) / (Kd + AHL)
    let denom_m: Int = kd_ahl + ahl_conc;    if denom_m <= 0.0001 { return 0.0; }
    let monomer: Int = (luxr_conc * ahl_conc) / denom_m;
    // Dimer: [LuxR2-AHL2] = (monomer^2) / (Kd_dimer + monomer)
    let mon_sq: Int = monomer * monomer;    let denom_d: Int = kd_dimer + monomer;    if denom_d <= 0.0001 { return 0.0; }
    return mon_sq / denom_d;
}

pub fn lux_evaluate_sensing(
    st: LuxSensingState,
    p: LuxQuorumParams,
) -> QuorumInductionResult {
    let dimer: Float = lux_calc_active_complex(st.lux_r_conc, st.ahl_conc_nm, p.kd_luxr_ahl, p.kd_dimerization);
    // Hill-type promoter activation by active dimer
    let dimer_sq: Float = dimer * dimer;    let k_act_sq: Float = 100.0; // Kd^2 for Plux promoter    let frac: Float = dimer_sq / (k_act_sq + dimer_sq);
    let output: Float = p.basal_promoter_rate + ((p.induced_promoter_rate - p.basal_promoter_rate) * frac);    let above_th: Bool = frac > 0.5;
    return QuorumInductionResult {
        active_dimer_conc: dimer,
        promoter_output: output,
        fraction_activated: frac,
        is_above_threshold: above_th
    };
}
