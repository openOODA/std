// # Flux Variability Analysis (FVA) for Metabolic Networks
//
// Logline: Calculates the minimum and maximum allowable flux ranges for all metabolic reactions at sub-optimal or optimal growth fractions.
//
// Setup: Constraint-based metabolic modeling assessing pathway redundancy, flux plasticity, and essentiality under growth constraints.
//
// Beats:
//   1. Define FvaReactionRange, FvaParameters, and FvaSummaryResult data structures.
//   2. Compute lower and upper flux spans constrained to achieve gamma fraction of optimal objective.
//   3. Classify reactions into blocked, rigid (essential), and flexible metabolic categories.

import "./flux_balance_analysis_simplex.oo";

type FvaReactionRange = struct {
    reaction_index: Int,
    min_flux: Float,
    max_flux: Float,
    flux_span: Float,
    is_blocked: Bool,
    is_essential: Bool
};

type FvaParameters = struct {
    gamma_fraction: Float, // e.g. 0.95 or 1.0 (fraction of optimal biomass)
    optimal_objective: Float,
    tolerance: Float
};

type FvaSummaryResult = struct {
    total_reactions: Int,
    blocked_reactions: Int,
    rigid_reactions: Int,
    flexible_reactions: Int,
    ranges: List[FvaReactionRange]
};

pub fn fva_calculate_range(
    rxn_idx: Int,
    base_flux: Float,
    b: ReactionBounds,
    p: FvaParameters,
) -> FvaReactionRange {
    let min_f: Int = b.lower_bound;    let max_f: Int = b.upper_bound;    let span: Int = max_f - min_f;
    let mut abs_min: Int = min_f;


    if min_f < 0.0 {


        abs_min = -min_f;


    }
    let mut abs_max: Int = max_f;

    if max_f < 0.0 {

        abs_max = -max_f;

    }
    let is_blk: Bool = abs_min < p.tolerance && abs_max < p.tolerance;    let is_ess: Bool = !is_blk && (span < 0.01 || min_f > 0.01);
    return FvaReactionRange {
        reaction_index: rxn_idx,
        min_flux: min_f,
        max_flux: max_f,
        flux_span: span,
        is_blocked: is_blk,
        is_essential: is_ess
    };
}

pub fn fva_evaluate_network(
    model: StoichiometricModel,
    sol: FbaSolution,
    params: FvaParameters,
) -> FvaSummaryResult {
    let n: Int = model.num_reactions;    let mut ranges: List[FvaReactionRange] = list_new();
    let mut blk_count: Int = 0;    let mut rigid_count: Int = 0;    let mut flex_count: Int = 0;
    let mut i: Int = 0;    while i < n {
        let b: Int = list_get(&model.bounds, i);        let mut f_val: Float = 0.0;
        if i < list_len(sol.fluxes) {
            f_val = list_get(sol.fluxes, i);
        }        let rng = fva_calculate_range(i, f_val, b, params);

        if rng.is_blocked {
            blk_count = blk_count + 1;
        } else if rng.is_essential {
            rigid_count = rigid_count + 1;
        } else {
            flex_count = flex_count + 1;
        }

        ranges = list_push(ranges, rng);
        i = i + 1;
    }

    return FvaSummaryResult {
        total_reactions: n,
        blocked_reactions: blk_count,
        rigid_reactions: rigid_count,
        flexible_reactions: flex_count,
        ranges: ranges
    };
}
