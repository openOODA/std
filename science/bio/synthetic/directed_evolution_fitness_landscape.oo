// # Directed Evolution & NK Fitness Landscapes
//
// Logline: Models epistatic fitness ruggedness, adaptive mutational walks, and evolutionary trajectories for protein engineering.
//
// Setup: Kauffman NK fitness landscape model predicting enzyme activity improvement and local vs global optima trapping.
//
// Beats:
//   1. Define NkLandscapeParams, ProteinVariantGenotype, and AdaptiveWalkResult data structures.
//   2. Compute site fitness contributions with K epistatic inter-residue interaction couplings.
//   3. Simulate greedy hill-climbing mutational walk and compute evolutionary accessibility probability.

type NkLandscapeParams = struct {
    num_loci_n: Int,
    epistatic_interactions_k: Int, // K = 0 (smooth additive) to K = N-1 (maximally rugged uncorrelated)
    mutation_rate_per_kb: Float,
    screening_library_size: Int
};

type ProteinVariantGenotype = struct {
    variant_id: Int,
    mutation_indices: List[Int],
    fitness_score: Float
};

type AdaptiveWalkResult = struct {
    trajectory_steps: Int,
    initial_fitness: Float,
    final_fitness: Float,
    is_local_optimum_trapped: Bool,
    fitness_improvement_fold: Float
};

pub fn evo_calc_locus_fitness(
    locus_idx: Int,
    has_mutation: Bool,
    k_epistasis: Int,
) -> Float {
    if !has_mutation { return 0.5; }
    // Epistatic modulation based on K
    let k_f: Float = directed_evolution_fitness_landscape_to_f(k_epistasis);
    let epistasis_factor: Float = 1.0 + (0.15 * k_f);
    let base_gain: Float = 0.35;
    return (0.5 + (base_gain * epistasis_factor));
}

pub fn evo_evaluate_variant(
    p: NkLandscapeParams,
    mut_indices: List[Int],
) -> ProteinVariantGenotype {
    let n: Int = p.num_loci_n;    let num_muts: Int = list_len(mut_indices);    let mut total_fit: Float = 0.0;

    let mut i: Int = 0;    while i < n {
        // Check if locus i is mutated
        let mut is_mut: Bool = false;        let mut m: Int = 0;        while m < num_muts {
            if list_get(mut_indices, m) == i {
                is_mut = true;
            }
            m = m + 1;
        }

        let fit_i: Float = evo_calc_locus_fitness(i, is_mut, p.epistatic_interactions_k);        total_fit = total_fit + fit_i;
        i = i + 1;
    }

    let nf: Float = directed_evolution_fitness_landscape_to_f(n);
    let avg_fit: Float = total_fit / nf;
    return ProteinVariantGenotype {
        variant_id: 1,
        mutation_indices: mut_indices,
        fitness_score: avg_fit
    };
}


fn directed_evolution_fitness_landscape_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
