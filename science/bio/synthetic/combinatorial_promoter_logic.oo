// # Combinatorial Multi-Input Promoter Logic
//
// Logline: Models multi-transcription factor operator binding thermodynamics and complex Boolean promoter computation.
//
// Setup: Shea-Ackers statistical mechanical partition function model predicting RNAP recruitment from multiple operator occupancies.
//
// Beats:
//   1. Define OperatorState, PromoterArchitecture, and LogicGateEvaluation data structures.
//   2. Compute Gibbs free energy weights and statistical mechanics partition function Z.
//   3. Evaluate promoter transcription probability for 2-input AND, OR, XOR, and NAND operator topologies.

type OperatorState = struct {
    tf_name: String,
    conc_nm: Float,
    kd_nm: Float,
    is_repressor: Bool
};

type PromoterArchitecture = struct {
    num_operators: Int,
    cooperativity_free_energy_kcal: Float,
    rnap_binding_energy_kcal: Float,
    basal_transcription_rate: Float,
    maximal_transcription_rate: Float
};

type LogicGateEvaluation = struct {
    partition_function_z: Float,
    rnap_bound_probability: Float,
    effective_transcription_rate: Float,
    digital_output_state: Bool
};

pub fn comb_promoter_calc_occupancy(tf_conc: Float, kd: Float) -> Float {
    if tf_conc <= 0.0 { return 0.0; }
    let denom: Float = kd + tf_conc;    if denom <= 0.0001 { return 0.0; }
    return tf_conc / denom;
}

pub fn comb_promoter_eval_and_logic(
    op1: OperatorState,
    op2: OperatorState,
    arch: PromoterArchitecture,
) -> LogicGateEvaluation {
    let occ1: Float = comb_promoter_calc_occupancy(op1.conc_nm, op1.kd_nm);    let occ2: Float = comb_promoter_calc_occupancy(op2.conc_nm, op2.kd_nm);
    // AND gate: both activators must bind to recruit RNAP
    let p_rnap: Float = occ1 * occ2;    let rate: Float = arch.basal_transcription_rate + ((arch.maximal_transcription_rate - arch.basal_transcription_rate) * p_rnap);    let is_high: Float = rate > (arch.maximal_transcription_rate * 0.5);
    let z: Float = 1.0 + occ1 + occ2 + p_rnap;
    return LogicGateEvaluation {
        partition_function_z: z,
        rnap_bound_probability: p_rnap,
        effective_transcription_rate: rate,
        digital_output_state: is_high
    };
}

pub fn comb_promoter_eval_xor_logic(
    op1: OperatorState,
    op2: OperatorState,
    arch: PromoterArchitecture,
) -> LogicGateEvaluation {
    let occ1: Float = comb_promoter_calc_occupancy(op1.conc_nm, op1.kd_nm);    let occ2: Float = comb_promoter_calc_occupancy(op2.conc_nm, op2.kd_nm);
    // XOR gate: active if either TF1 OR TF2 bound, but inactive if BOTH bound (mutual steric hindrance or co-repression)
    let p_only1: Float = occ1 * (1.0 - occ2);    let p_only2: Float = occ2 * (1.0 - occ1);    let p_rnap: Float = p_only1 + p_only2;
    let rate: Float = arch.basal_transcription_rate + ((arch.maximal_transcription_rate - arch.basal_transcription_rate) * p_rnap);    let is_high: Float = rate > (arch.maximal_transcription_rate * 0.4);    let z: Float = 1.0 + occ1 + occ2;
    return LogicGateEvaluation {
        partition_function_z: z,
        rnap_bound_probability: p_rnap,
        effective_transcription_rate: rate,
        digital_output_state: is_high
    };
}
