// # Ribozyme & Aptazyme Self-Cleavage Kinetics
//
// Logline: Models hammerhead and twister catalytic RNA self-cleavage rates, magnesium cofactor dependence, and aptamer gating.
//
// Setup: Kinetic model evaluating catalytic RNA processing for RNA circuit tuning, transcript half-life regulation, and metabolic biosensing.
//
// Beats:
//   1. Define RibozymeKineticsParams, LigandGatingState, and CleavageProgressResult data structures.
//   2. Compute magnesium-dependent observed cleavage rate constant k_obs and ligand-dependent allosteric switching fraction.
//   3. Predict intact full-length RNA fraction remaining over reaction incubation time.

type RibozymeKineticsParams = struct {
    k_cleave_max_per_min: Float, // e.g. 1.5 min^-1 for fast hammerhead
    k_basal_leak_per_min: Float,
    mg_half_saturation_m_m: Float, // Mg2+ requirement ~ 1.0 mM
    kd_ligand_u_m: Float,
    is_cleavage_activated_by_ligand: Bool
};

type LigandGatingState = struct {
    ligand_conc_u_m: Float,
    mg_conc_m_m: Float,
    time_minutes: Float
};

type CleavageProgressResult = struct {
    k_obs_per_min: Float,
    intact_fraction_remaining: Float,
    cleaved_fraction: Float,
    half_life_min: Float
};

pub fn ribozyme_math_exp_neg(val: Float) -> Float {
    if val > 12.0 { return 0.000006; }
    let mut term: Float = 1.0;
    let mut sum: Float = 1.0;
    let x: Float = -val;    let mut i: Int = 1;    while i <= 8 {
        term = term * (x / ribozyme_cleavage_kinetics_to_f(i));
        sum = sum + term;
        i = i + 1;
    }
    return if sum < 0.0 { 0.0 } else { sum };
}

pub fn ribozyme_evaluate_cleavage(
    p: RibozymeKineticsParams,
    st: LigandGatingState,
) -> CleavageProgressResult {
    // Magnesium factor: [Mg2+] / (K_Mg + [Mg2+])
    let mg_frac: Int = st.mg_conc_m_m / (p.mg_half_saturation_m_m + st.mg_conc_m_m);
    // Ligand allosteric factor
    let mut lig_frac: Float = 0.0;

    if st.ligand_conc_u_m > 0.0 {

        lig_frac = st.ligand_conc_u_m / (p.kd_ligand_u_m + st.ligand_conc_u_m);

    }

    let mut active_frac: Float = 1.0 - lig_frac;


    if p.is_cleavage_activated_by_ligand {


        active_frac = lig_frac;


    }

    let k_obs: Int = p.k_basal_leak_per_min + (p.k_cleave_max_per_min * mg_frac * active_frac);
    // Fraction remaining: F(t) = exp(-k_obs * t)
    let f_intact: Float = ribozyme_math_exp_neg(k_obs * st.time_minutes);    let f_cleaved = 1.0 - f_intact;
    let mut t_half: Float = 9999.0;

    if k_obs > 0.0001 {

        t_half = 0.693147 / k_obs;

    }

    return CleavageProgressResult {
        k_obs_per_min: k_obs,
        intact_fraction_remaining: f_intact,
        cleaved_fraction: if f_cleaved < 0.0 { 0.0 } else { f_cleaved },
        half_life_min: t_half
    };
}


fn ribozyme_cleavage_kinetics_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
