// # Serine Integrase DNA Recombination Logic & Memory
//
// Logline: Simulates Bxb1 and phiC31 directional DNA site-specific inversion for digital logic gates and non-volatile genomic memory.
//
// Setup: Permanent genomic register flipping promoter/terminator cassettes between attP/attB and attL/attR attachment sites.
//
// Beats:
//   1. Define IntegraseSite, RecombinaseLatch, and InversionEventResult data structures.
//   2. Model directional recombination kinetics driven by integrase and recombination directionality factors (RDF).
//   3. Compute digital memory flip transition probabilities and Boolean memory gate outputs.

type IntegraseSite = struct {
    site_name: String,
    is_inverted: Bool, // false = attP/attB forward orientation, true = attL/attR flipped
    integrase_type: String // "Bxb1", "phiC31"
};

type RecombinaseLatch = struct {
    latch_id: Int,
    sites: List[IntegraseSite],
    has_rdf_excisionase: Bool,
    promoter_oriented_active: Bool
};

type InversionEventResult = struct {
    transition_occurred: Bool,
    inversion_efficiency: Float,
    is_state_flipped: Bool,
    expression_output_level: Float
};

pub fn integrase_calc_efficiency(
    integrase_conc_nm: Float,
    has_rdf: Bool,
    is_currently_inverted: Bool,
) -> Float {
    if integrase_conc_nm <= 0.1 { return 0.0; }
    // Forward inversion (attP x attB -> attL + attR) occurs with high efficiency (>95%) with integrase alone
    if !is_currently_inverted {
        let denom: Float = 10.0 + integrase_conc_nm;        return (0.98 * integrase_conc_nm) / denom;
    }
    // Reverse excision (attL x attR -> attP + attB) strictly requires RDF (Recombination Directionality Factor)
    if is_currently_inverted && has_rdf {
        let denom: Float = 15.0 + integrase_conc_nm;        return (0.85 * integrase_conc_nm) / denom;
    }
    return 0.0; // Irreversible without RDF
}

pub fn integrase_evaluate_flip(
    latch: RecombinaseLatch,
    integrase_conc: Float,
    has_rdf: Bool,
    rand_u: Float,
) -> InversionEventResult {
    let cur_inv: Bool = !latch.promoter_oriented_active;    let eff = integrase_calc_efficiency(integrase_conc, has_rdf, cur_inv);

    let flipped: Bool = rand_u < eff;    let mut new_state: Int = cur_inv;

    if flipped {

        new_state = !cur_inv;

    }
    let mut expr: Float = 1.0;

    if !new_state {

        expr = 100.0;

    }

    return InversionEventResult {
        transition_occurred: flipped,
        inversion_efficiency: eff,
        is_state_flipped: new_state,
        expression_output_level: expr
    };
}
