// # Salis Ribosome Binding Site (RBS) Thermodynamic Calculator
//
// Logline: Calculates translation initiation rates (TIR) from mRNA folding, Shine-Dalgarno 16S rRNA binding, and spacer thermodynamics.
//
// Setup: Biophysical free energy model predicting translation efficiency based on 5' UTR sequence and ribosome assembly energetics.
//
// Beats:
//   1. Define RbsThermodynamics, RbsSequenceFeatures, and TirPredictionResult data structures.
//   2. Calculate free energy terms for 16S rRNA hybridization, mRNA secondary structure unfolding, and non-optimal spacer penalty.
//   3. Compute total Gibbs free energy dG_total and predict relative translation initiation rate (TIR) in arbitrary units.

type RbsThermodynamics = struct {
    dg_16s_hybridization_kcal: Float,
    dg_mrna_hairpin_kcal: Float,
    dg_start_codon_kcal: Float,
    dg_spacing_penalty_kcal: Float,
    dg_stand_assembly_kcal: Float
};

type RbsSequenceFeatures = struct {
    shine_dalgarno_seq: String,
    spacer_length_nt: Int,
    start_codon: String,
    utr_gc_content: Float
};

type TirPredictionResult = struct {
    dg_total_kcal_per_mol: Float,
    predicted_tir_au: Float,
    translation_tier: Int // 1: Low, 2: Moderate, 3: High, 4: Ultra-high
};

pub fn rbs_math_exp_neg(val: Float) -> Float {
    // Approx exp(-val)
    if val > 15.0 { return 0.0000003; }
    if val < -15.0 { return 3000000.0; }
    let mut term: Float = 1.0;
    let mut sum: Float = 1.0;
    let x: Float = -val;
    let mut i: Int = 1;    while i <= 10 {
        term = term * (x / ribosome_binding_site_rbs_to_f(i));
        sum = sum + term;
        i = i + 1;
    }
    return if sum < 0.0 { 0.0 } else { sum };
}

pub fn rbs_calc_spacing_penalty(spacer_length: Int) -> Float {
    // Optimal spacer is 5-7 nt. Sub-optimal spacer incurs energetic penalty.
    let optimal: Int = 6;    let diff = spacer_length - optimal;
    let mut abs_diff: Int = diff;

    if diff < 0 {

        abs_diff = -diff;

    }

    if abs_diff == 0 { return 0.0; }
    if abs_diff == 1 { return 0.45; }
    if abs_diff == 2 { return 1.2; }
    if abs_diff == 3 { return 2.8; }
    return 4.5 + (((abs_diff - ribosome_binding_site_rbs_to_f(3))) * 1.5);
}

pub fn rbs_evaluate_thermodynamics(
    feat: RbsSequenceFeatures,
    hairpin_dg: Float,
) -> TirPredictionResult {
    let sd_dg: Float = -7.5; // Typical canonical AGGAGGT hybridizing to anti-SD 3'-ACCUCCU-5'    let mut start_dg: Float = 0.5;

    if feat.start_codon == "AUG" {

        start_dg = -1.19 } else if feat.start_codon == "GUG" { -0.07;

    }    let space_dg = rbs_calc_spacing_penalty(feat.spacer_length_nt);
    let stand_dg: Float = 0.5;
    // dG_total = dG_rRNA:mRNA + dG_start + dG_spacing - dG_mRNA - dG_stand
    let dg_total: Float = sd_dg + start_dg + space_dg - hairpin_dg - stand_dg;
    // TIR = K * exp(-beta * dG_total), beta ~ 0.45 mol/kcal
    let exponent: Float = 0.45 * dg_total;    let tir_val: Float = 2500.0 * rbs_math_exp_neg(exponent);
    let tier: Float = if tir_val < 500.0 {        1
    } else if tir_val < 5000.0 {
        2
    } else if tir_val < 30000.0 {
        3
    } else {
        4
    };

    return TirPredictionResult {
        dg_total_kcal_per_mol: dg_total,
        predicted_tir_au: tir_val,
        translation_tier: tier
    };
}


fn ribosome_binding_site_rbs_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
