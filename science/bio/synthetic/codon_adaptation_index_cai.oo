// # Codon Adaptation Index (CAI) & Translational Efficiency
//
// Logline: Evaluates heterologous gene codon bias, rare codon clusters, and predicted elongation rates in host organisms.
//
// Setup: Sequence bioinformatics metric quantifying codon harmonization and translation elongation bottlenecks.
//
// Beats:
//   1. Define CodonWeight, GeneSequenceMetrics, and CaiEvaluationResult data structures.
//   2. Match synonymous codon relative adaptiveness values w_i against host reference set.
//   3. Compute geometric mean CAI score and flag rare codon translational pause clusters.

type CodonWeight = struct {
    codon_triplet: String,
    amino_acid: String,
    relative_adaptiveness_w: Float // 0.0 to 1.0
};

type GeneSequenceMetrics = struct {
    num_codons: Int,
    gc_percent: Float,
    rare_codon_count: Int
};

type CaiEvaluationResult = struct {
    cai_score: Float,
    num_codons: Int,
    rare_codons_count: Int,
    elongation_efficiency: Float,
    optimization_recommended: Bool
};

pub fn cai_get_codon_weight(codon: String) -> Float {
    // E. coli canonical high-expression weights
    if codon == "AUG" { return 1.0; } // Met
    if codon == "UGG" { return 1.0; } // Trp
    if codon == "CUG" { return 1.0; } // Leu (optimal)
    if codon == "CUA" { return 0.08; } // Leu (rare)
    if codon == "CGU" { return 1.0; } // Arg (optimal)
    if codon == "AGG" { return 0.02; } // Arg (very rare)
    if codon == "AGA" { return 0.04; } // Arg (rare)
    if codon == "GAA" { return 1.0; } // Glu (optimal)
    if codon == "GAG" { return 0.25; } // Glu
    if codon == "AAA" { return 1.0; } // Lys (optimal)
    if codon == "AAG" { return 0.26; } // Lys
    if codon == "CCG" { return 1.0; } // Pro (optimal)
    if codon == "CCC" { return 0.05; } // Pro (rare)
    return 0.65; // Default average weight
}

pub fn cai_math_ln(val: Float) -> Float {
    if val <= 0.001 { return -6.9; }
    if val >= 0.999 { return 0.0; }
    // Approximation for ln(val) where 0 < val <= 1
    let x: Float = (val - 1.0) / (val + 1.0);    let x2: Float = x * x;    return 2.0 * (x + (x * x2 / 3.0) + (x * x2 * x2 / 5.0));
}

pub fn cai_math_exp(val: Float) -> Float {
    if val < -10.0 { return 0.000045; }
    if val > 10.0 { return 22026.0; }
    let mut term: Float = 1.0;
    let mut sum: Float = 1.0;
    let mut i: Int = 1;    while i <= 10 {
        term = term * (val / codon_adaptation_index_cai_to_f(i));
        sum = sum + term;
        i = i + 1;
    }
    return sum;
}

pub fn cai_evaluate_codon_list(codons: List[String]) -> CaiEvaluationResult {
    let n: Int = list_len(codons);    if n == 0 {
        return CaiEvaluationResult {
            cai_score: 0.0,
            num_codons: 0,
            rare_codons_count: 0,
            elongation_efficiency: 0.0,
            optimization_recommended: true
        };
    }

    let mut sum_ln_w: Float = 0.0;
    let mut rare_count: Int = 0;
    let mut i: Int = 0;    while i < n {
        let c: Int = list_get(codons, i);        let w: Float = cai_get_codon_weight(c);        if w < 0.15 {
            rare_count = rare_count + 1;
        }
        sum_ln_w = sum_ln_w + cai_math_ln(w);
        i = i + 1;
    }

    let nf: Float = codon_adaptation_index_cai_to_f(n);    let avg_ln_w: Float = sum_ln_w / nf;    let cai: Float = cai_math_exp(avg_ln_w);
    let efficiency: Float = cai * (1.0 - (0.05 * codon_adaptation_index_cai_to_f(rare_count)));    let mut eff_clamped: Int = efficiency;

    if efficiency < 0.0 {

        eff_clamped = 0.0;

    }

    return CaiEvaluationResult {
        cai_score: cai,
        num_codons: n,
        rare_codons_count: rare_count,
        elongation_efficiency: eff_clamped,
        optimization_recommended: cai < 0.7 || rare_count > 3
    };
}


fn codon_adaptation_index_cai_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
