// # Chargaff base composition parity law
//
// Logline: In dsDNA, count of A equals count of T and count of G equals count of C. Invalid bases or length < 4 fail closed.
//
// Setup: Pure String. Bases are 'A', 'T', 'G', 'C'; the law is unit-agnostic.
//
// Beats:
//   1. Count A, T, G, C in a DNA string.
//   2. Check Chargaff parity: |A - T| == 0 and |G - C| == 0.
//   3. Compute GC content fraction (G + C) / total length.
//   4. Hostile length < 4 or invalid base: parity 0, gc_content Err.

pub fn chargaff_count_a(seq: String) -> Int {
    let n: Int = seq.len();
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(seq, i);
        if ch == "A" {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

pub fn chargaff_count_t(seq: String) -> Int {
    let n: Int = seq.len();
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(seq, i);
        if ch == "T" {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

pub fn chargaff_count_g(seq: String) -> Int {
    let n: Int = seq.len();
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(seq, i);
        if ch == "G" {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

pub fn chargaff_count_c(seq: String) -> Int {
    let n: Int = seq.len();
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(seq, i);
        if ch == "C" {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

pub fn chargaff_is_valid_seq(seq: String) -> Int {
    let n: Int = seq.len();
    if n < 4 {
        return 0;
    }
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(seq, i);
        if ch != "A" && ch != "T" && ch != "G" && ch != "C" {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

pub fn chargaff_parity(seq: String) -> Int {
    if chargaff_is_valid_seq(seq) != 1 {
        return 0;
    }
    let a: Int = chargaff_count_a(seq);
    let t: Int = chargaff_count_t(seq);
    let g: Int = chargaff_count_g(seq);
    let c: Int = chargaff_count_c(seq);
    if a == t && g == c {
        return 1;
    }
    return 0;
}

pub fn chargaff_gc_content(seq: String) -> Result[Float, String] {
    if chargaff_is_valid_seq(seq) != 1 {
        return Err("ERR\tch\tdomain");
    }
    let n: Int = seq.len();
    let g: Int = chargaff_count_g(seq);
    let c: Int = chargaff_count_c(seq);
    let n_f: Float = 1.0 * (n);
    let g_f: Float = 1.0 * (g);
    let c_f: Float = 1.0 * (c);
    return Ok((g_f + c_f) / n_f);
}

fn ch_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

pub fn verify_chargaff_law() -> Bool {
    if chargaff_parity("ATGCATGC") != 1 {
        return false;
    }

    if chargaff_parity("AAAATTTTGGGGCCCC") != 1 {
        return false;
    }

    if chargaff_parity("ATATGCGC") != 1 {
        return false;
    }

    if chargaff_parity("AAAA") != 0 {
        return false;
    }

    if chargaff_parity("AAAT") != 0 {
        return false;
    }

    if chargaff_count_a("AAAATTTTGGGGCCCC") != 4 {
        return false;
    }
    if chargaff_count_t("AAAATTTTGGGGCCCC") != 4 {
        return false;
    }
    if chargaff_count_g("AAAATTTTGGGGCCCC") != 4 {
        return false;
    }
    if chargaff_count_c("AAAATTTTGGGGCCCC") != 4 {
        return false;
    }

    if ch_got(chargaff_gc_content("GCGC")) != 1.0 {
        return false;
    }
    if ch_got(chargaff_gc_content("ATAT")) != 0.0 {
        return false;
    }
    if ch_got(chargaff_gc_content("ATGC")) != 0.5 {
        return false;
    }

    if chargaff_parity("") != 0 {
        return false;
    }
    if chargaff_parity("AT") != 0 {
        return false;
    }
    if chargaff_parity("ATBN") != 0 {
        return false;
    }
    if chargaff_parity("ATGCX") != 0 {
        return false;
    }
    if chargaff_gc_content("ATBN").is_ok() {
        return false;
    }
    return true;
}
