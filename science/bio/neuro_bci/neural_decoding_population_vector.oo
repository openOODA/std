// # Georgopoulos Population Vector Motor Directional Decoder
//
// Logline: Decodes 2D reach trajectories and target movement directions from motor cortex directional cosine tuning curves.
//
// Setup: Canonical population vector algorithm weighting preferred directional unit vectors by relative spike firing rates.
//
// Beats:
//   1. Define NeuronCosineTuning (pref_angle_rad, baseline_rate_hz, max_modulation_hz).
//   2. Compute normalized directional weight w_i = (r_i - r0_i) / delta_r.
//   3. Sum ensemble preferred direction vectors to produce population velocity vector P = (P_x, P_y).

type NeuronCosineTuning = struct {
    pref_angle_rad: Float,    // Preferred movement angle theta_i
    baseline_rate_hz: Float,  // Baseline spontaneous firing rate r0
    max_modulation_hz: Float // Modulation depth delta_r
};

type PopulationVector2D = struct {
    pv_x: Float,
    pv_y: Float,
    magnitude: Float,
    decoded_angle_rad: Float
};

pub fn population_vector_weight(rate_hz: Float, tuning: &NeuronCosineTuning) -> Float {
    let delta: Float = tuning.max_modulation_hz;
    let safe_delta: Float = if delta < 0.000001 { 0.000001 } else { delta };
    let normalized: Float = (rate_hz - tuning.baseline_rate_hz) / safe_delta;
    return normalized;
}

pub fn population_vector_decode_4units(
    r0: Float, t0: &NeuronCosineTuning,
    r1: Float, t1: &NeuronCosineTuning,
    r2: Float, t2: &NeuronCosineTuning,
    r3: Float, t3: &NeuronCosineTuning
) -> PopulationVector2D {
    let w0: Float = population_vector_weight(r0, t0);
    let w1: Float = population_vector_weight(r1, t1);
    let w2: Float = population_vector_weight(r2, t2);
    let w3: Float = population_vector_weight(r3, t3);

    let px: Float = (w0 * cos(t0.pref_angle_rad)) + (w1 * cos(t1.pref_angle_rad)) +
             (w2 * cos(t2.pref_angle_rad)) + (w3 * cos(t3.pref_angle_rad));

    let py: Float = (w0 * sin(t0.pref_angle_rad)) + (w1 * sin(t1.pref_angle_rad)) +
             (w2 * sin(t2.pref_angle_rad)) + (w3 * sin(t3.pref_angle_rad));

    let mag_sq: Float = (px * px) + (py * py);
    let mag: Float = sqrt(mag_sq);

    let angle: Float = if px != 0.0 { py / px } else { 0.0 };

    return PopulationVector2D {
        pv_x: px,
        pv_y: py,
        magnitude: mag,
        decoded_angle_rad: angle
    };
}

pub fn neural_decoding_population_vector_probe() -> Int {
    return 0;
}
