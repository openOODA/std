// # CRISPR Cas12a (Cpf1) PAM & Protospacer Scanner
//
// Logline: Scans for Cas12a 5'-TTTV-3' PAM sites, extracts 23-24 nt protospacers, and models 5-nt staggered 5'-overhang cleavage geometry.
//
// Setup: Type V-A CRISPR endonuclease search module for Acidaminococcus / Lachnospiraceae Cas12a gene editing pipelines.
//
// Beats:
//   1. Define Cas12aTargetSite and Cas12aScanConfig structures.
//   2. Match 5' TTTV (V = A/C/G) PAM motifs and extract downstream protospacers.
//   3. Compute staggered cleavage indices (positions 18 and 23 on non-target and target strands).

type Cas12aTargetSite = struct {
    pam_sequence: String,
    protospacer_seq: String,
    strand: String,
    pam_index: Int,
    staggered_cut_pos1: Int,
    staggered_cut_pos2: Int,
    gc_percent: Float
};

type Cas12aScanConfig = struct {
    spacer_length: Int,
    min_gc: Float,
    max_gc: Float
};

pub fn cas12a_is_v_base(c: String) -> Bool {
    return c == "A" || c == "a" || c == "C" || c == "c" || c == "G" || c == "g";
}

pub fn cas12a_is_tttv_pam(p: String) -> Bool {
    if chars_len(p) != 4 { return false; }
    let c0: String = char_at(p, 0);    let c1: String = char_at(p, 1);    let c2: String = char_at(p, 2);    let c3: String = char_at(p, 3);    let is_t0: Bool = (c0 == "T" || c0 == "t");    let is_t1: Bool = (c1 == "T" || c1 == "t");    let is_t2: Bool = (c2 == "T" || c2 == "t");    return is_t0 && is_t1 && is_t2 && cas12a_is_v_base(c3);
}

pub fn cas12a_calc_gc(seq: String) -> Float {
    let n: Int = chars_len(seq);    if n == 0 { return 0.0; }
    let mut gc: Int = 0;    let mut i: Int = 0;    while i < n {
        let c: String = char_at(seq, i);        if c == "G" || c == "g" || c == "C" || c == "c" {
            gc = gc + 1;
        }
        i = i + 1;
    }
    return crispr_cas12a_cpf1_pam_to_f((gc) / crispr_cas12a_cpf1_pam_to_f(n)) * 100.0;
}

pub fn cas12a_slice(seq: String, start: Int, length: Int) -> String {
    let n: Int = chars_len(seq);    let mut out: String = "";    let mut i: Int = 0;    while i < length && (start + i) < n {
        out = out + char_at(seq, start + i);
        i = i + 1;
    }
    return out;
}

pub fn cas12a_scan_targets(dna_seq: String, cfg: Cas12aScanConfig) -> List[Cas12aTargetSite] {
    let mut list: List[Cas12aTargetSite] = list_new();
    let n: Int = chars_len(dna_seq);    let s_len = cfg.spacer_length;
    let min_needed: Int = 4 + s_len;    if n < min_needed { return list; }

    let mut i: Int = 0;    while i <= n - min_needed {
        let pam_cand: String = cas12a_slice(dna_seq, i, 4);        if cas12a_is_tttv_pam(pam_cand) {
            let spacer: String = cas12a_slice(dna_seq, i + 4, s_len);            let gc: Float = cas12a_calc_gc(spacer);            if gc >= cfg.min_gc && gc <= cfg.max_gc {
                let site: Cas12aTargetSite = Cas12aTargetSite {                    pam_sequence: pam_cand,
                    protospacer_seq: spacer,
                    strand: "+",
                    pam_index: i,
                    staggered_cut_pos1: i + 4 + 18,
                    staggered_cut_pos2: i + 4 + 23,
                    gc_percent: gc
                };
                list_push(list, site);
            }
        }
        i = i + 1;
    }
    return list;
}


fn crispr_cas12a_cpf1_pam_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
