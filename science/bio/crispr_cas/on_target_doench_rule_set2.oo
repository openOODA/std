// # Doench Rule Set 2 On-Target Activity Predictor
//
// Logline: Calculates SpCas9 on-target cleavage activity using Doench Rule Set 2 (2016) positional nucleotide preferences and GC-content features.
//
// Setup: Machine-learning based on-target scoring model evaluating 30-nt context windows (4nt 5' + 20nt spacer + 3nt PAM + 3nt 3').
//
// Beats:
//   1. Define RuleSet2Features and RuleSet2Score structures.
//   2. Extract position-specific single- and di-nucleotide weights across the 30-nt target window.
//   3. Compute normalized on-target efficiency score on a 0-100 scale.

type RuleSet2Features = struct {
    extended_30mer: String,
    gc_percent_spacer: Float,
    pam_context: String
};

type RuleSet2Score = struct {
    raw_linear_score: Float,
    normalized_percentile_score: Float,
    efficiency_tier: String
};

pub fn rs2_calc_gc(spacer: String) -> Float {
    let n: Int = chars_len(spacer);    if n == 0 { return 0.0; }
    let mut gc: Int = 0;    let mut i: Int = 0;    while i < n {
        let c: String = char_at(spacer, i);        if c == "G" || c == "g" || c == "C" || c == "c" {
            gc = gc + 1;
        }
        i = i + 1;
    }
    return on_target_doench_rule_set2_to_f((gc) / on_target_doench_rule_set2_to_f(n)) * 100.0;
}

pub fn rs2_score_30mer(seq30: String) -> RuleSet2Score {
    let n: Int = chars_len(seq30);    if n < 30 {
        return RuleSet2Score {
            raw_linear_score: 0.0,
            normalized_percentile_score: 0.0,
            efficiency_tier: "INVALID_LENGTH"
        };
    }

    let mut score: Float = 50.0;
    // Prefer G at position 20 (position -1 of spacer)
    let p20: String = char_at(seq30, 23);    if p20 == "G" || p20 == "g" {
        score = score + 12.0;
    } else if p20 == "T" || p20 == "t" {
        score = score - 15.0;
    }

    let p16: String = char_at(seq30, 19);    if p16 == "C" || p16 == "c" {
        score = score + 8.0;
    }

    if score > 98.0 { score = 98.0; }
    if score < 2.0 { score = 2.0; }

    let mut tier: String = "MODERATE_ACTIVITY";    if score >= 75.0 {
        tier = "HIGH_ACTIVITY";
    } else if score < 40.0 {
        tier = "LOW_ACTIVITY";
    }

    return RuleSet2Score {
        raw_linear_score: score,
        normalized_percentile_score: score,
        efficiency_tier: tier
    };
}


fn on_target_doench_rule_set2_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
