// # MIT CRISPR Specificity Score Calculator
//
// Logline: Implements the MIT genome-wide off-target specificity score aggregating weighted single-guide mismatch penalties.
//
// Setup: Empirical specificity scoring engine ranking guide RNAs on a 0-100 specificity scale for human and mammalian genome editing.
//
// Beats:
//   1. Define MitOffTargetSite and MitCompositeScore data structures.
//   2. Compute pairwise mismatch penalty factors based on inter-mismatch distance and position.
//   3. Aggregate cumulative 100 / (100 + sum(scores)) guide specificity rating.

type MitOffTargetSite = struct {
    site_seq: String,
    mismatch_count: Int,
    hit_score: Float
};

type MitCompositeScore = struct {
    guide_seq: String,
    composite_mit_score: Float,
    tier: String
};

pub fn mit_calc_hit_score(mismatches: Int, avg_dist: Float) -> Float {
    if mismatches == 0 { return 100.0; }
    let base_factor: Float = 1.0 / off_target_mit_score_to_f((mismatches) * 1.5);    let dist_factor: Float = 1.0 / (1.0 + (19.0 - avg_dist) / 19.0);    return base_factor * dist_factor * 100.0;
}

pub fn mit_calculate_composite(guide: String, sum_hit_scores: Float) -> MitCompositeScore {
    let score: Float = 100.0 / (1.0 + (sum_hit_scores / 100.0));    let mut tier: String = "LOW_SPECIFICITY";    if score >= 75.0 {
        tier = "HIGH_SPECIFICITY";
    } else if score >= 50.0 {
        tier = "MODERATE_SPECIFICITY";
    }

    return MitCompositeScore {
        guide_seq: guide,
        composite_mit_score: score,
        tier: tier
    };
}


fn off_target_mit_score_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
