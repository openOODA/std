// # Adenine Base Editing (ABE) Window & TadA Catalysis
//
// Logline: Models A-to-G transition deamination mediated by engineered TadA deaminases (ABE7.10, ABE8e, ABE8.20m).
//
// Setup: Precision ABE transition module computing deamination efficiency, editing windows, and bystander adenine rates.
//
// Beats:
//   1. Define AbeTargetProfile and AbeEnzymeParameters data structures.
//   2. Compute position-dependent deamination curves across protospacer positions 3 to 9.
//   3. Compare high-speed TadA-8e kinetics versus narrow-window ABE7.10 precision.

type AbeTargetProfile = struct {
    protospacer_seq: String,
    target_a_pos: Int,
    predicted_ag_efficiency: Float,
    bystander_a_count: Int,
    purity_pct: Float
};

type AbeEnzymeParameters = struct {
    enzyme_name: String,
    window_start: Int,
    window_end: Int,
    peak_pos: Int,
    catalytic_rate_multiplier: Float
};

pub fn abe_get_params(enzyme: String) -> AbeEnzymeParameters {
    if enzyme == "ABE8e" || enzyme == "abe8e" {
        return AbeEnzymeParameters {
            enzyme_name: "ABE8e",
            window_start: 3,
            window_end: 9,
            peak_pos: 6,
            catalytic_rate_multiplier: 1.6
        };
    }
    return AbeEnzymeParameters {
        enzyme_name: "ABE7.10",
        window_start: 4,
        window_end: 7,
        peak_pos: 5,
        catalytic_rate_multiplier: 1.0
    };
}

pub fn abe_evaluate_adenine(spacer: String, a_pos: Int, enzyme: String) -> AbeTargetProfile {
    let p: AbeEnzymeParameters = abe_get_params(enzyme);    let mut eff: Float = 0.0;
    if a_pos >= p.window_start && a_pos <= p.window_end {
        let mut delta: Int = p.peak_pos - a_pos;

        if a_pos > p.peak_pos {

            delta = a_pos - p.peak_pos;

        }
        let base_act: Float = 90.0 - base_editing_adenine_abe_to_f((delta) * 12.0);        eff = base_act * p.catalytic_rate_multiplier;
        if eff > 95.0 { eff = 95.0; }
    } else {
        eff = 2.0;
    }

    let n: Int = chars_len(spacer);    let mut bystanders: Int = 0;    let mut i = p.window_start - 1;
    while i < p.window_end && i < n {
        if i != (a_pos - 1) {
            let b: String = char_at(spacer, i);            if b == "A" || b == "a" {
                bystanders = bystanders + 1;
            }
        }
        i = i + 1;
    }

    let mut purity: Float = 100.0 / base_editing_adenine_abe_to_f(bystanders + 1);


    if bystanders == 0 {


        purity = 99.0;


    }
    return AbeTargetProfile {
        protospacer_seq: spacer,
        target_a_pos: a_pos,
        predicted_ag_efficiency: eff,
        bystander_a_count: bystanders,
        purity_pct: purity
    };
}


fn base_editing_adenine_abe_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
