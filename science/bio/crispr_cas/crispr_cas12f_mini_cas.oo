// # CRISPR Cas12f (CasMINI) Compact Nuclease Designer
//
// Logline: Models miniature Type V-F Cas12f / CasMINI nucleases requiring 5'-TTTR-3' PAMs for ultra-compact viral vector delivery.
//
// Setup: Compact nuclease design engine optimizing 400-500 amino acid Cas12f effectors and engineered guide scaffolds.
//
// Beats:
//   1. Define Cas12fGuideSpec and Cas12fScoreProfile data structures.
//   2. Validate 5'-TTTR-3' (R = A/G) PAM motifs and engineered sgRNA scaffold compatibility.
//   3. Compute guide truncation tolerance and AAV payload volume conservation.

fn crispr_cas12f_mini_cas_to_f(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

type Cas12fGuideSpec = struct {
    pam_motif: String,
    spacer_seq: String,
    spacer_length: Int,
    gc_content: Float,
    is_aav_compatible: Bool
};

type Cas12fScoreProfile = struct {
    pam_affinity: Float,
    scaffold_stability: Float,
    overall_mini_score: Float
};

pub fn cas12f_is_tttr(pam: String) -> Bool {
    if chars_len(pam) != 4 { return false; }
    let c0: String = char_at(pam, 0);    let c1: String = char_at(pam, 1);    let c2: String = char_at(pam, 2);    let c3: String = char_at(pam, 3);    let t0: Bool = (c0 == "T" || c0 == "t");    let t1: Bool = (c1 == "T" || c1 == "t");    let t2: Bool = (c2 == "T" || c2 == "t");    let r3: Bool = (c3 == "A" || c3 == "a" || c3 == "G" || c3 == "g");    return t0 && t1 && t2 && r3;
}

pub fn cas12f_calc_gc(seq: String) -> Float {
    let n: Int = chars_len(seq);    if n == 0 { return 0.0; }
    let mut gc_count: Int = 0;    let mut i: Int = 0;    while i < n {
        let c: String = char_at(seq, i);        if c == "G" || c == "g" || c == "C" || c == "c" {
            gc_count = gc_count + 1;
        }
        i = i + 1;
    }
    return (crispr_cas12f_mini_cas_to_f(gc_count) / crispr_cas12f_mini_cas_to_f(n)) * 100.0;
}

pub fn cas12f_evaluate_score(gc: Float, pam: String) -> Cas12fScoreProfile {
    let mut pam_aff: Float = 0.5;    if pam == "TTTA" || pam == "ttta" { pam_aff = 0.95; }
    if pam == "TTTG" || pam == "tttg" { pam_aff = 0.85; }

    let mut gc_score: Float = 1.0;    if gc < 35.0 || gc > 65.0 {
        gc_score = 0.7;
    }

    let mini_score: Float = pam_aff * 60.0 + gc_score * 40.0;    return Cas12fScoreProfile {
        pam_affinity: pam_aff,
        scaffold_stability: gc_score,
        overall_mini_score: mini_score
    };
}

pub fn cas12f_create_spec(pam: String, spacer: String) -> Cas12fGuideSpec {
    let gc: Float = cas12f_calc_gc(spacer);    let slen: Int = chars_len(spacer);    let aav_ok: Bool = slen >= 20 && slen <= 24;    return Cas12fGuideSpec {
        pam_motif: pam,
        spacer_seq: spacer,
        spacer_length: slen,
        gc_content: gc,
        is_aav_compatible: aav_ok
    };
}
