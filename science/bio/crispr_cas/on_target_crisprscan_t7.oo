// # Moreno-Mateos CRISPRscan In Vitro T7 sgRNA Evaluator
//
// Logline: Scores in vitro transcribed sgRNAs generated by T7 RNA polymerase, enforcing 5'-GG transcription initiation rules.
//
// Setup: CRISPRscan activity model optimized for vertebrate embryogenesis and in vitro transcribed guide RNA stability.
//
// Beats:
//   1. Define CrisprscanSpec and CrisprscanResult structures.
//   2. Check 5' GG initiation requirement for high-yield T7 in vitro transcription.
//   3. Compute vertebrate in vivo mutagenesis score and guide stability ranking.

type CrisprscanSpec = struct {
    spacer_sequence: String,
    has_5prime_gg: Bool,
    gc_percentage: Float
};

type CrisprscanResult = struct {
    crisprscan_score: Float,
    transcription_yield_tier: String,
    in_vivo_activity_pct: Float
};

pub fn crisprscan_check_gg(seq: String) -> Bool {
    if chars_len(seq) < 2 { return false; }
    let c0: String = char_at(seq, 0);    let c1: String = char_at(seq, 1);    return (c0 == "G" || c0 == "g") && (c1 == "G" || c1 == "g");
}

pub fn crisprscan_calc_gc(seq: String) -> Float {
    let n: Int = chars_len(seq);    if n == 0 { return 0.0; }
    let mut gc: Int = 0;    let mut i: Int = 0;    while i < n {
        let c: String = char_at(seq, i);        if c == "G" || c == "g" || c == "C" || c == "c" {
            gc = gc + 1;
        }
        i = i + 1;
    }
    return on_target_crisprscan_t7_to_f((gc) / on_target_crisprscan_t7_to_f(n)) * 100.0;
}

pub fn crisprscan_evaluate(spacer: String) -> CrisprscanResult {
    let has_gg: Bool = crisprscan_check_gg(spacer);    let gc: Float = crisprscan_calc_gc(spacer);
    let mut score: Float = 55.0;
    if has_gg {
        score = score + 25.0;
    }
    if gc >= 45.0 && gc <= 65.0 {
        score = score + 15.0;
    } else {
        score = score - 10.0;
    }

    if score > 99.0 { score = 99.0; }
    if score < 5.0 { score = 5.0; }

    let mut yield_tier: String = "LOW_INITIATION";


    if has_gg {


        yield_tier = "HIGH_T7_YIELD";


    }
    let in_vivo: Float = score * 0.85;
    return CrisprscanResult {
        crisprscan_score: score,
        transcription_yield_tier: yield_tier,
        in_vivo_activity_pct: in_vivo
    };
}


fn on_target_crisprscan_t7_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
