// # Epigenetic DNA Methylation & CpG Island Penalty Model
//
// Logline: Models 5-methylcytosine (5mC) epigenetic marks across target protospacers, quantifying inhibition of deaminases and nucleases.
//
// Setup: Methylation profiling module integrating whole-genome bisulfite sequencing (WGBS) data for base editing and CRISPR cleavage.
//
// Beats:
//   1. Define CpgMethylationProfile and MethylationImpactScore structures.
//   2. Scan for CpG dinucleotides within the protospacer and PAM sequence.
//   3. Calculate deamination rate suppression and Cas9 binding hindrance.

type CpgMethylationProfile = struct {
    cpg_count_spacer: Int,
    cpg_in_pam: Bool,
    cpg_in_editing_window: Bool,
    avg_methylation_fraction: Float
};

type MethylationImpactScore = struct {
    cas9_cleavage_inhibition_pct: Float,
    base_editing_suppression_pct: Float,
    recommended_compensation: String
};

pub fn cpg_scan_sequence(seq: String) -> Int {
    let n: Int = chars_len(seq);    let mut count: Int = 0;    let mut i: Int = 0;    while i < n - 1 {
        let c0: String = char_at(seq, i);        let c1: String = char_at(seq, i + 1);        if (c0 == "C" || c0 == "c") && (c1 == "G" || c1 == "g") {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn cpg_evaluate_impact(profile: CpgMethylationProfile) -> MethylationImpactScore {
    let frac: Float = profile.avg_methylation_fraction;    let mut cas_inhib: Float = 0.0;    if profile.cpg_in_pam {
        cas_inhib = frac * 15.0;
    }
    let mut be_supp: Float = 0.0;    if profile.cpg_in_editing_window {
        be_supp = frac * 35.0;
    }

    let mut comp: String = "STANDARD_PROTOCOL";


    if be_supp > 20.0 {


        comp = "SWITCH_TO_ABE_OR_ENGINEERED_APOBEC";


    }

    return MethylationImpactScore {
        cas9_cleavage_inhibition_pct: cas_inhib,
        base_editing_suppression_pct: be_supp,
        recommended_compensation: comp
    };
}
