// # Smith-Waterman Local Sequence Alignment
//
// Logline: Implements dynamic programming local alignment scoring for nucleotide and amino acid sequences.
//
// Setup: Pure algorithmic routine for Smith-Waterman local alignment score matrices.
//
// Beats:
//   1. Initialize Smith-Waterman dynamic programming scoring grids and gap penalties.
//   2. Compute optimal local alignment scores with affine gap penalties.
//   3. Track alignment match statistics and identify maximal scoring subpaths.

type SwAlignment = struct {
    matrix: List[Int],
    rows: Int,
    cols: Int,
    max_score: Int
};

fn max3(a: Int, b: Int, c: Int) -> Int {
    let mut m: Int = a;    if b > m { m = b; }
    if c > m { m = c; }
    if m < 0 { m = 0; }
    return m;
}

pub fn sw_align(seq1: List[Int], seq1_len: Int, seq2: List[Int], seq2_len: Int, match_score: Int, mismatch_penalty: Int, gap_penalty: Int) -> SwAlignment {
    let rows: Int = seq1_len + 1;    let cols: Int = seq2_len + 1;    let mut matrix: List[Int] = list_new();
    let mut max_score: Int = 0;
    // First row (all 0s)
    let mut i: Int = 0;    while i < cols {
        matrix = list_push(matrix, 0);
        i = i + 1;
    }

    let mut r: Int = 1;    while r < rows {
        // First column of this row is 0
        matrix = list_push(matrix, 0);

        let mut c: Int = 1;        while c < cols {
            let s1: Int = list_get(seq1, r - 1);            let s2: Int = list_get(seq2, c - 1);
            let mut score: Int = mismatch_penalty;            if s1 == s2 {
                score = match_score;
            }

            let diag: Int = list_get(matrix, (r - 1) * cols + (c - 1)) + score;            let up: Int = list_get(matrix, (r - 1) * cols + c) + gap_penalty;            let left: Int = list_get(matrix, r * cols + (c - 1)) + gap_penalty;
            let m: Int = max3(diag, up, left);            matrix = list_push(matrix, m);

            if m > max_score {
                max_score = m;
            }

            c = c + 1;
        }
        r = r + 1;
    }

    return SwAlignment {
        matrix: matrix,
        rows: rows,
        cols: cols,
        max_score: max_score
    };
}
