// # Augmented Genomic Interval Tree (ITree)
//
// Logline: Implements an augmented interval tree for O(log N + K) genomic feature overlap and intersection queries.
//
// Setup: Fast interval overlap data structure for BED/GFF annotations, ChIP peaks, and structural variant breakpoints.
//
// Beats:
//   1. Define GenomicInterval and IntervalOverlapResult data structures.
//   2. Evaluate 1D interval overlap predicates and calculate reciprocal intersection fractions.
//   3. Merge adjacent or overlapping genomic intervals into contiguous spans.

type GenomicInterval = struct {
    chrom_id: Int,
    start_pos: Int,
    end_pos: Int,
    feature_id: Int
};

type IntervalOverlapResult = struct {
    overlap_len_bp: Int,
    fraction_query: Float,
    fraction_target: Float,
    is_reciprocal_80: Bool
};

pub fn interval_is_overlapping(i1: GenomicInterval, i2: GenomicInterval) -> Bool {
    if i1.chrom_id != i2.chrom_id { return false; }
    return i1.start_pos <= i2.end_pos && i2.start_pos <= i1.end_pos;
}

pub fn interval_calc_overlap_len(i1: GenomicInterval, i2: GenomicInterval) -> Int {
    if !interval_is_overlapping(i1, i2) { return 0; }
    let mut s: Int = i2.start_pos;

    if i1.start_pos > i2.start_pos {

        s = i1.start_pos;

    }
    let mut e: Int = i2.end_pos;

    if i1.end_pos < i2.end_pos {

        e = i1.end_pos;

    }
    return (e - s) + 1;
}

pub fn interval_evaluate_reciprocal(i1: GenomicInterval, i2: GenomicInterval) -> IntervalOverlapResult {
    let ov: Int = interval_calc_overlap_len(i1, i2);    if ov == 0 {
        return IntervalOverlapResult {
            overlap_len_bp: 0,
            fraction_query: 0.0,
            fraction_target: 0.0,
            is_reciprocal_80: false
        };
    }
    let l1: Int = (i1.end_pos - i1.start_pos) + 1;    let l2: Int = (i2.end_pos - i2.start_pos) + 1;    let f1: Float = genomic_interval_tree_to_f(ov) / genomic_interval_tree_to_f(l1);    let f2: Float = genomic_interval_tree_to_f(ov) / genomic_interval_tree_to_f(l2);    let recip: Bool = f1 >= 0.8 && f2 >= 0.8;    return IntervalOverlapResult {
        overlap_len_bp: ov,
        fraction_query: f1,
        fraction_target: f2,
        is_reciprocal_80: recip
    };
}

pub fn genomic_interval_tree_probe() -> Int {
    return 0;
}


fn genomic_interval_tree_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
