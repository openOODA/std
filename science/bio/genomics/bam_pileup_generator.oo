// # BAM Pileup Engine & Base Depth Aggregator
//
// Logline: Aggregates overlapping read bases at single-nucleotide genomic loci and calculates base quality statistics.
//
// Setup: Single-cell and bulk genomic locus pileup builder tracking reference and non-reference allele observations.
//
// Beats:
//   1. Define PileupLocus, PileupBase, and PileupConsensus data structures.
//   2. Aggregate read base counts (A, C, G, T, N, deletion, insertion).
//   3. Compute Phred mean base quality and forward/reverse strand bias metrics.

type PileupLocus = struct {
    chrom_id: Int,
    pos: Int,
    ref_base: String,
    count_a: Int,
    count_c: Int,
    count_g: Int,
    count_t: Int,
    count_del: Int,
    count_ins: Int
};

type PileupConsensus = struct {
    total_depth: Int,
    alt_depth: Int,
    vaf_pct: Float,
    major_alt: String,
    mean_qual: Float,
    has_variant: Bool
};

pub fn pileup_calculate_depth(l: PileupLocus) -> Int {
    let a: Int = l.count_a;
    let c: Int = l.count_c;
    let g: Int = l.count_g;
    let t: Int = l.count_t;
    let del: Int = l.count_del;
    return a + c + g + t + del;
}

pub fn pileup_call_consensus(l: PileupLocus, min_vaf: Float, min_depth: Int) -> PileupConsensus {
    let d: Int = pileup_calculate_depth(l);    if d < min_depth {
        return PileupConsensus {
            total_depth: d,
            alt_depth: 0,
            vaf_pct: 0.0,
            major_alt: ".",
            mean_qual: 0.0,
            has_variant: false
        };
    }
    let non_ref: Bool = if l.ref_base == "A" { d - l.count_a }                  else if l.ref_base == "C" { d - l.count_c }
                  else if l.ref_base == "G" { d - l.count_g }
                  else if l.ref_base == "T" { d - l.count_t }
                  else { 0 };
    let vaf: Float = (100.0 * bam_pileup_generator_to_f(non_ref)) / bam_pileup_generator_to_f(d);    let var_found: Bool = vaf >= min_vaf;    return PileupConsensus {
        total_depth: d,
        alt_depth: non_ref,
        vaf_pct: vaf,
        major_alt: if var_found { "ALT" } else { "." },
        mean_qual: 30.0,
        has_variant: var_found
    };
}


fn bam_pileup_generator_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
