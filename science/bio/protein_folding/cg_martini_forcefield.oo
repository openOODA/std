// # MARTINI Coarse-Grained 4-to-1 Mapping Force Field
//
// Logline: Implements MARTINI 4:1 coarse-grained bead mapping, bead interaction types, and non-bonded parameter matrix.
//
// Setup: Coarse-grained biomolecular simulation model grouping ~4 heavy atoms into discrete polar, non-polar, and charged pseudo-beads.
//
// Beats:
//   1. Define MartiniBeadType, MartiniBead, and MartiniPairInteraction data structures.
//   2. Classify bead interaction subtypes (Q: charged, P: polar, N: intermediate, C: apolar).
//   3. Compute MARTINI 12-6 shifted Lennard-Jones potential with standard sigma = 4.7 Angstroms.

type MartiniBeadType = struct {
    main_type: String, // "Q", "P", "N", "C"
    subtype_index: Int,
    interaction_level: Int // 1 to 10 interaction strength level
};

type MartiniBead = struct {
    bead_id: Int,
    bead_name: String,
    bead_type: MartiniBeadType,
    mass_amu: Float,
    charge_e: Float,
    x: Float,
    y: Float,
    z: Float
};

type MartiniPairInteraction = struct {
    sigma_a: Float,
    epsilon_kj: Float,
    epsilon_kcal: Float,
    potential_energy_kcal: Float
};

pub fn martini_bead_bb_backbone() -> MartiniBeadType {
    return MartiniBeadType {
        main_type: "P",
        subtype_index: 5,
        interaction_level: 6 // Standard semi-polar backbone bead
    };
}

pub fn martini_bead_sc_aliphatic() -> MartiniBeadType {
    return MartiniBeadType {
        main_type: "C",
        subtype_index: 1,
        interaction_level: 1 // Highly apolar sidechain bead
    };
}

pub fn martini_calc_epsilon(level: Int) -> Float {
    // Standard MARTINI interaction levels mapped to epsilon (kJ/mol)
    // Level 1 (super attractive) ~ 5.6 kJ/mol, Level 10 (almost repulsive) ~ 2.0 kJ/mol
    let level_f: Float = (level * 1.0);
    let delta: Float = level_f * 0.36;
    let eps_kj: Float = 5.6 - delta;
    let mut eps_actual: Float = eps_kj;
    if eps_kj < 1.0 {
        eps_actual = 1.0;
    }
    // 1 kJ/mol = 0.239006 kcal/mol
    return eps_actual * 0.239006;
}

pub fn martini_evaluate_pair_lj(dist_a: Float, level: Int) -> MartiniPairInteraction {
    let sigma_std: Float = 4.7; // Standard MARTINI bead diameter 0.47 nm = 4.7 A
    let eps_kcal: Float = martini_calc_epsilon(level);

    if dist_a < 1.0 {
        return MartiniPairInteraction {
            sigma_a: sigma_std,
            epsilon_kj: eps_kcal / 0.239006,
            epsilon_kcal: eps_kcal,
            potential_energy_kcal: 100.0
        };
    }

    let inv_r: Int = 1.0 / dist_a;
    let ratio: Float = sigma_std * inv_r;
    let r2: Float = ratio * ratio;
    let r6: Float = r2 * r2 * r2;
    let r12: Float = r6 * r6;

    let e_lj: Float = 4.0 * eps_kcal * (r12 - r6);

    return MartiniPairInteraction {
        sigma_a: sigma_std,
        epsilon_kj: eps_kcal / 0.239006,
        epsilon_kcal: eps_kcal,
        potential_energy_kcal: e_lj
    };
}
