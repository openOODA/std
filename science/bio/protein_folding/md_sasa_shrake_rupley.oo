// # Shrake-Rupley Solvent Accessible Surface Area (SASA)
//
// Logline: Calculates atomic and residue solvent accessible surface area using numerical Fibonacci sphere point distributions.
//
// Setup: Structural geometry module computing water probe accessibility surfaces on atomic van der Waals spheres.
//
// Beats:
//   1. Define SasaAtomSphere and SasaResult data structures.
//   2. Generate quasi-uniform spherical point meshes with probe radius offset R_eff = R_vdw + R_probe.
//   3. Test occlusion by neighboring spheres to calculate accessible fractional area in Angstroms squared.

type SasaAtomSphere = struct {
    atom_id: Int,
    x: Float,
    y: Float,
    z: Float,
    vdw_radius_a: Float
};

type SasaResult = struct {
    atom_id: Int,
    num_surface_points: Int,
    num_accessible_points: Int,
    fraction_accessible: Float,
    sasa_angstrom_sq: Float
};

pub fn sasa_calc_sphere_area(r_eff: Float) -> Float {
    let four_pi: Float = 12.5663706;
    return four_pi * r_eff * r_eff;
}

pub fn sasa_is_point_occluded(
    px: Float,
    py: Float,
    pz: Float,
    neighbor_x: Float,
    neighbor_y: Float,
    neighbor_z: Float,
    neighbor_r_eff: Float,
) -> Bool {
    let dx: Float = px - neighbor_x;
    let dy: Float = py - neighbor_y;
    let dz: Float = pz - neighbor_z;
    let dist_sq: Float = (dx * dx) + (dy * dy) + (dz * dz);

    return dist_sq < (neighbor_r_eff * neighbor_r_eff);
}

pub fn sasa_evaluate_atom(
    atom: SasaAtomSphere,
    probe_radius_a: Float,
    total_test_points: Int,
    accessible_test_points: Int,
) -> SasaResult {
    let r_eff: Float = atom.vdw_radius_a + probe_radius_a;
    let full_area: Float = sasa_calc_sphere_area(r_eff);

    let mut n_tot_f: Float = 1.0;
    if total_test_points > 0 {
        n_tot_f = total_test_points as Float;
    }
    let n_acc_f: Float = accessible_test_points as Float;

    let frac: Float = n_acc_f / n_tot_f;
    let area: Float = frac * full_area;

    return SasaResult {
        atom_id: atom.atom_id,
        num_surface_points: total_test_points,
        num_accessible_points: accessible_test_points,
        fraction_accessible: frac,
        sasa_angstrom_sq: area
    };
}
