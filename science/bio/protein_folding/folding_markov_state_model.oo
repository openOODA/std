// # Markov State Model (MSM) Kinetics & Implied Timescales
//
// Logline: Implements Markov state model transition probability matrices, row-normalization, and relaxation timescales.
//
// Setup: Conformational kinetics engine converting MD trajectory clusters into discrete master equation jump processes.
//
// Beats:
//   1. Define MsmTransitionMatrix, MsmStatePopulation, and MsmTimescaleResult data structures.
//   2. Compute maximum likelihood transition probability matrix T_ij = C_ij / sum_k(C_ik) from transition counts.
//   3. Calculate implied relaxation timescales t_i = -tau / ln(|lambda_i|) from transition matrix eigenvalues.

type MsmStatePopulation = struct {
    state_id: Int,
    stationary_probability: Float,
    state_name: String
};

type MsmTransitionCount = struct {
    from_state: Int,
    to_state: Int,
    count: Float
};

type MsmTimescaleResult = struct {
    mode_index: Int,
    eigenvalue: Float,
    lag_time_ps: Float,
    implied_timescale_ps: Float
};

pub fn msm_normalize_transition_row(c0: Float, c1: Float, c2: Float) -> MsmTransitionCount {
    let row_sum: Float = c0 + c1 + c2;
    let mut inv_sum: Int = 0.0;
    if row_sum > 0.0001 {
        inv_sum = 1.0 / row_sum;
    }

    return MsmTransitionCount {
        from_state: 0,
        to_state: 0,
        count: c0 * inv_sum
    };
}

pub fn msm_calc_implied_timescale(eigenvalue_lambda: Float, lag_time_ps: Float) -> MsmTimescaleResult {
    // t_i = - tau / ln(lambda_i)
    // For lambda near 1, ln(lambda) ~ lambda - 1
    if eigenvalue_lambda >= 0.9999 || eigenvalue_lambda <= 0.0001 {
        return MsmTimescaleResult {
            mode_index: 2,
            eigenvalue: eigenvalue_lambda,
            lag_time_ps: lag_time_ps,
            implied_timescale_ps: 999999.0
        };
    }

    let diff: Float = 1.0 - eigenvalue_lambda;
    // -ln(lambda) ~ diff + 0.5*diff^2 + 0.333*diff^3
    let neg_ln: Int = diff + (0.5 * diff * diff) + (0.333333 * diff * diff * diff);
    let mut timescale: Float = 999999.0;
    if neg_ln > 0.00001 {
        timescale = lag_time_ps / neg_ln;
    }

    return MsmTimescaleResult {
        mode_index: 2,
        eigenvalue: eigenvalue_lambda,
        lag_time_ps: lag_time_ps,
        implied_timescale_ps: timescale
    };
}

pub fn msm_check_detailed_balance(pi_i: Float, p_ij: Float, pi_j: Float, p_ji: Float) -> Float {
    // Flux equilibrium: |pi_i * P_ij - pi_j * P_ji|
    let flux_forward: Float = pi_i * p_ij;
    let flux_backward: Float = pi_j * p_ji;
    let diff: Float = flux_forward - flux_backward;
    if diff < 0.0 {
        return -1.0 * diff;
    }
    return diff;
}
