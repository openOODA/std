// # CRISPR Prime Editing pegRNA Architecture & Scoring
//
// Logline: Designs prime editing guide RNAs (pegRNAs), optimizing Primer Binding Site (PBS) length and Reverse Transcriptase (RT) template size.
//
// Setup: Precision genome editing module modeling pegRNA extension lengths and melting temperature stability.
//
// Beats:
//   1. Define PegRnaDesign and PrimeEditParams data structures.
//   2. Compute PBS melting temperature (Tm) targeting optimal 30°C to 37°C range.
//   3. Score RT template flap length and secondary structure avoidance metrics.

type PegRnaDesign = struct {
    spacer_seq: String,
    pbs_seq: String,
    pbs_length: Int,
    pbs_tm_celsius: Float,
    rtt_seq: String,
    rtt_length: Int,
    edit_position: Int,
    overall_score: Float
};

type PrimeEditParams = struct {
    optimal_pbs_len_min: Int,
    optimal_pbs_len_max: Int,
    optimal_rtt_len_min: Int,
    optimal_rtt_len_max: Int,
    target_pbs_tm: Float
};

pub fn prime_params_default() -> PrimeEditParams {
    return PrimeEditParams {
        optimal_pbs_len_min: 10,
        optimal_pbs_len_max: 16,
        optimal_rtt_len_min: 10,
        optimal_rtt_len_max: 35,
        target_pbs_tm: 34.0
    };
}

pub fn prime_calc_pbs_tm(pbs: String) -> Float {
    let n: Int = chars_len(pbs);    if n == 0 { return 0.0; }
    let mut w_at: Int = 0;    let mut s_gc: Int = 0;    let mut i: Int = 0;    while i < n {
        let c: String = char_at(pbs, i);        if c == "A" || c == "a" || c == "T" || c == "t" {
            w_at = w_at + 1;
        } else if c == "G" || c == "g" || c == "C" || c == "c" {
            s_gc = s_gc + 1;
        }
        i = i + 1;
    }
    // Basic Wallace formula for oligonucleotides: Tm = 2*(A+T) + 4*(G+C)
    return ((2 * w_at + 4 * crispr_prime_editing_to_f(s_gc)));
}

pub fn prime_score_design(spacer: String, pbs: String, rtt: String, edit_pos: Int) -> PegRnaDesign {
    let pbs_l: Int = chars_len(pbs);    let rtt_l: Int = chars_len(rtt);    let tm = prime_calc_pbs_tm(pbs);

    let mut score: Float = 100.0;
    let mut tm_diff: Float = 34.0 - tm;

    if tm > 34.0 {

        tm_diff = tm - 34.0;

    }
    score = score - (tm_diff * 1.5);

    if pbs_l < 10 || pbs_l > 16 {
        score = score - 15.0;
    }
    if rtt_l < 10 || rtt_l > 35 {
        score = score - 20.0;
    }
    if score < 0.0 { score = 0.0; }

    return PegRnaDesign {
        spacer_seq: spacer,
        pbs_seq: pbs,
        pbs_length: pbs_l,
        pbs_tm_celsius: tm,
        rtt_seq: rtt,
        rtt_length: rtt_l,
        edit_position: edit_pos,
        overall_score: score
    };
}


fn crispr_prime_editing_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
