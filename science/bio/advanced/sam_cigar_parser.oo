// # SAM/BAM CIGAR String Parser & Alignment Coordinate Mapper
//
// Logline: Decodes SAM CIGAR strings (M, I, D, N, S, H, P, =, X) into genomic alignment spans and read sequence offsets.
//
// Setup: NGS alignment record coordinate mapper converting concise idiosyncratic gapped alignment representations.
//
// Beats:
//   1. Define CigarOp and CigarAlignmentSpan data structures.
//   2. Parse CIGAR operators: M (alignment match), I (insertion), D (deletion), N (skipped intron), S (soft clip).
//   3. Compute reference genome alignment end coordinate: pos + sum(M, D, N, =, X) - 1.

type CigarOp = struct {
    op_char: String,
    length: Int,
    consumes_query: Bool,
    consumes_reference: Bool
};

type CigarAlignmentSpan = struct {
    start_pos: Int,
    reference_span_length: Int,
    end_pos: Int,
    query_aligned_length: Int,
    total_clipped_bases: Int
};

pub fn cigar_consumes_query(op: String) -> Bool {
    return (op == "M" || op == "I" || op == "S" || op == "=" || op == "X");
}

pub fn cigar_consumes_ref(op: String) -> Bool {
    return (op == "M" || op == "D" || op == "N" || op == "=" || op == "X");
}

pub fn cigar_evaluate_span(start_1based: Int, ops: List[CigarOp]) -> CigarAlignmentSpan {
    let n: Int = list_len(ops);    let mut ref_len: Int = 0;
    let mut q_len: Int = 0;
    let mut clips: Int = 0;

    let mut i: Int = 0;
    while i < n {
        let op_obj: Int = list_get(ops, i);        let op = op_obj.op_char;
        let l: Int = op_obj.length;
        if cigar_consumes_ref(op) {
            ref_len = ref_len + l;
        }
        if cigar_consumes_query(op) {
            q_len = q_len + l;
        }
        if op == "S" || op == "H" {
            clips = clips + l;
        }
        i = i + 1;
    }

    let mut end_p: Int = start_1based;


    if ref_len > 0 {


        end_p = start_1based + ref_len - 1;


    }

    return CigarAlignmentSpan {
        start_pos: start_1based,
        reference_span_length: ref_len,
        end_pos: end_p,
        query_aligned_length: q_len,
        total_clipped_bases: clips
    };
}
