// # BED Genomic Interval Overlap & Fast Intersection Engine
//
// Logline: Computes genomic interval intersections, merges overlapping intervals, and calculates reciprocal overlap percentages.
//
// Setup: Genomic coordinate algebra module implementing 0-based half-open [start, end) interval arithmetic.
//
// Beats:
//   1. Define BedInterval and BedOverlapResult data structures.
//   2. Calculate intersection interval bounds [max(s1, s2), min(e1, e2)) and overlap length.
//   3. Compute reciprocal overlap fraction and evaluate minimum overlap coverage thresholds.

type BedInterval = struct {
    chrom: String,
    start_0based: Int,
    end_0based: Int,
    name: String,
    score: Int,
    strand: String
};

type BedOverlapResult = struct {
    has_overlap: Bool,
    overlap_start: Int,
    overlap_end: Int,
    overlap_length: Int,
    fraction_a: Float,
    fraction_b: Float,
    reciprocal_overlap: Float
};

pub fn bed_calc_length(iv: BedInterval) -> Int {
    let len: Int = iv.end_0based - iv.start_0based;
    if len < 0 { return 0; }
    return len;
}

pub fn bed_intersect(a: BedInterval, b: BedInterval) -> BedOverlapResult {
    let chrom_a: String = a.chrom;
    let chrom_b: String = b.chrom;
    if chrom_a != chrom_b {
        return BedOverlapResult {
            has_overlap: false,
            overlap_start: 0,
            overlap_end: 0,
            overlap_length: 0,
            fraction_a: 0.0,
            fraction_b: 0.0,
            reciprocal_overlap: 0.0
        };
    }

    let mut start_max: Int = b.start_0based;


    if a.start_0based > b.start_0based {


        start_max = a.start_0based;


    }
    let mut end_min: Int = b.end_0based;

    if a.end_0based < b.end_0based {

        end_min = a.end_0based;

    }

    if start_max < end_min {
        let overlap_len: Int = end_min - start_max;
        let len_a: Int = bed_calc_length(a);
        let len_b: Int = bed_calc_length(b);

        let mut frac_a: Float = 0.0;


        if len_a > 0 {


            frac_a = bed_interval_overlap_to_f(overlap_len) / bed_interval_overlap_to_f(len_a);


        }
        let mut frac_b: Float = 0.0;

        if len_b > 0 {

            frac_b = bed_interval_overlap_to_f(overlap_len) / bed_interval_overlap_to_f(len_b);

        }
        let mut recip: Float = frac_b;

        if frac_a < frac_b {

            recip = frac_a;

        }

        return BedOverlapResult {
            has_overlap: true,
            overlap_start: start_max,
            overlap_end: end_min,
            overlap_length: overlap_len,
            fraction_a: frac_a,
            fraction_b: frac_b,
            reciprocal_overlap: recip
        };
    }

    return BedOverlapResult {
        has_overlap: false,
        overlap_start: 0,
        overlap_end: 0,
        overlap_length: 0,
        fraction_a: 0.0,
        fraction_b: 0.0,
        reciprocal_overlap: 0.0
    };
}

pub fn bed_interval_overlap_probe() -> Int {
    return 0;
}


fn bed_interval_overlap_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
