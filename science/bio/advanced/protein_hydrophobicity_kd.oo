// # Protein Kyte-Doolittle Hydropathy & Transmembrane Predictor
//
// Logline: Calculates Kyte-Doolittle hydropathy index profiles across sliding windows to identify putative transmembrane helices.
//
// Setup: Protein sequence biophysical profiling module assigning hydropathy scores across polypeptide chains.
//
// Beats:
//   1. Define HydropathyProfile and TransmembraneSegment data structures.
//   2. Assign Kyte-Doolittle scale values to standard 20 amino acid residues.
//   3. Compute sliding window averages and detect hydrophobic peaks exceeding +1.6 thresholds.

type HydropathyProfile = struct {
    window_size: Int,
    average_score: Float,
    peak_score: Float,
    peak_position: Int,
    has_transmembrane_domain: Bool
};

type TransmembraneSegment = struct {
    start_pos: Int,
    end_pos: Int,
    length: Int,
    mean_hydropathy: Float
};

pub fn kd_hydropathy_score(aa: String) -> Float {
    if aa == "I" || aa == "i" { return 4.5; }
    if aa == "V" || aa == "v" { return 4.2; }
    if aa == "L" || aa == "l" { return 3.8; }
    if aa == "F" || aa == "f" { return 2.8; }
    if aa == "C" || aa == "c" { return 2.5; }
    if aa == "M" || aa == "m" { return 1.9; }
    if aa == "A" || aa == "a" { return 1.8; }
    if aa == "G" || aa == "g" { return -0.4; }
    if aa == "T" || aa == "t" { return -0.7; }
    if aa == "S" || aa == "s" { return -0.8; }
    if aa == "W" || aa == "w" { return -0.9; }
    if aa == "Y" || aa == "y" { return -1.3; }
    if aa == "P" || aa == "p" { return -1.6; }
    if aa == "H" || aa == "h" { return -3.2; }
    if aa == "E" || aa == "e" { return -3.5; }
    if aa == "Q" || aa == "q" { return -3.5; }
    if aa == "D" || aa == "d" { return -3.5; }
    if aa == "N" || aa == "n" { return -3.5; }
    if aa == "K" || aa == "k" { return -3.9; }
    if aa == "R" || aa == "r" { return -4.5; }
    return 0.0;
}

pub fn kd_scan_profile(seq: String, window: Int) -> HydropathyProfile {
    let n: Int = chars_len(seq);    if n < window || window <= 0 {
        return HydropathyProfile {
            window_size: window,
            average_score: 0.0,
            peak_score: 0.0,
            peak_position: 0,
            has_transmembrane_domain: false
        };
    }

    let mut peak: Float = -10.0;
    let mut peak_pos: Int = 0;    let mut total_window_sum: Float = 0.0;
    let mut num_windows: Int = 0;
    let mut i: Int = 0;    while i <= n - window {
        let mut sum: Float = 0.0;
        let mut j: Int = 0;        while j < window {
            let aa: String = char_at(seq, i + j);            sum = sum + kd_hydropathy_score(aa);
            j = j + 1;
        }
        let avg: Float = sum / protein_hydrophobicity_kd_to_f(window);        total_window_sum = total_window_sum + avg;
        num_windows = num_windows + 1;

        if avg > peak {
            peak = avg;
            peak_pos = i;
        }
        i = i + 1;
    }

    let mut global_avg: Float = 0.0;


    if num_windows > 0 {


        global_avg = total_window_sum / protein_hydrophobicity_kd_to_f(num_windows);


    }
    let is_tm: Bool = peak >= 1.6;
    return HydropathyProfile {
        window_size: window,
        average_score: global_avg,
        peak_score: peak,
        peak_position: peak_pos,
        has_transmembrane_domain: is_tm
    };
}


fn protein_hydrophobicity_kd_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
