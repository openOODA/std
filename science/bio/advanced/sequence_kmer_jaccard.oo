// # Genomic K-mer Spectrum & Jaccard Distance Similarity
//
// Logline: Computes k-mer frequency spectra, intersection cardinality, and Jaccard similarity / distance between genomic sequences.
//
// Setup: Alignment-free sequence comparison module for metagenomic binning and fast evolutionary distance estimation.
//
// Beats:
//   1. Define KmerProfile and JaccardComparison data structures.
//   2. Extract canonical k-mer windows across arbitrary nucleotide lengths (k=3 to k=31).
//   3. Compute set intersection, union, Jaccard similarity index J = |A ^ B| / |A v B|, and MinHash distance.

type KmerProfile = struct {
    k_size: Int,
    total_kmers: Int,
    unique_kmers: Int
};

type JaccardComparison = struct {
    k_size: Int,
    set_a_size: Int,
    set_b_size: Int,
    intersection_size: Int,
    union_size: Int,
    jaccard_similarity: Float,
    jaccard_distance: Float
};

pub fn kmer_substr(seq: String, start: Int, length: Int) -> String {
    let n: Int = chars_len(seq);    let mut out: String = "";    let mut i: Int = 0;
    while i < length {
        if (start + i) < n {
            out = out + char_at(seq, start + i);
        }
        i = i + 1;
    }
    return out;
}

pub fn kmer_calc_jaccard(
    inter_count: Int,
    union_count: Int,
    k_len: Int,
    len_a: Int,
    len_b: Int
) -> JaccardComparison {
    let mut sim: Float = 0.0;

    if union_count > 0 {

        sim = sequence_kmer_jaccard_to_f(inter_count) / sequence_kmer_jaccard_to_f(union_count);

    }
    let dist: Float = 1.0 - sim;

    return JaccardComparison {
        k_size: k_len,
        set_a_size: len_a,
        set_b_size: len_b,
        intersection_size: inter_count,
        union_size: union_count,
        jaccard_similarity: sim,
        jaccard_distance: dist
    };
}


fn sequence_kmer_jaccard_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
