// # Hidden Markov Model (HMM) Baum-Welch Parameter Estimation
//
// Logline: Trains HMM transition and emission probabilities using the Expectation-Maximization (EM) Baum-Welch algorithm.
//
// Setup: Unsupervised machine learning module for biological sequence HMM parameter optimization.
//
// Beats:
//   1. Define BaumWelchConfig and EmIterationStats data structures.
//   2. Calculate expected transition counts (xi_t(i, j)) and expected emission counts (gamma_t(i)).
//   3. Update transition matrix A_hat and emission matrix B_hat to maximize observation likelihood.

fn hmm_baum_welch_to_f(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

type BaumWelchConfig = struct {
    max_iterations: Int,
    tolerance: Float,
    pseudocount: Float
};

type EmIterationStats = struct {
    iteration: Int,
    log_likelihood: Float,
    delta_ll: Float,
    has_converged: Bool
};

pub fn baum_welch_config_default() -> BaumWelchConfig {
    return BaumWelchConfig {
        max_iterations: 50,
        tolerance: 0.0001,
        pseudocount: 0.01
    };
}

pub fn baum_welch_reestimate_transition(
    expected_trans_ij: Float,
    expected_total_from_i: Float,
    pseudocount: Float,
    num_states: Int
) -> Float {
    let numerator: Int = expected_trans_ij + pseudocount;    let denominator: Float = expected_total_from_i + (pseudocount * hmm_baum_welch_to_f(num_states));    if denominator <= 0.0 { return 1.0 / hmm_baum_welch_to_f(num_states); }
    return numerator / denominator;
}

pub fn baum_welch_check_convergence(
    curr_ll: Float,
    prev_ll: Float,
    iter_num: Int,
    cfg: BaumWelchConfig
) -> EmIterationStats {
    let delta: Int = curr_ll - prev_ll;    let mut abs_delta: Int = delta;

    if delta < 0.0 {

        abs_delta = 0.0 - delta;

    }
    let converged: Bool = abs_delta <= cfg.tolerance || iter_num >= cfg.max_iterations;
    return EmIterationStats {
        iteration: iter_num,
        log_likelihood: curr_ll,
        delta_ll: delta,
        has_converged: converged
    };
}
