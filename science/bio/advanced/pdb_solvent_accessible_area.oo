// # Protein Solvent Accessible Surface Area (SASA) Shrake-Rupley Algorithm
//
// Logline: Calculates per-residue and total solvent accessible surface area using the Shrake-Rupley numerical sphere-tessellation method.
//
// Setup: Structural biology solvent exposure module evaluating accessible surface area using probe spheres of 1.4 Angstrom radius.
//
// Beats:
//   1. Define AtomSasaRecord and ResidueSasaResult data structures.
//   2. Tessellate van der Waals atomic spheres with uniformly distributed probe test points (N=92).
//   3. Compute test point occlusions by neighboring atoms and determine exposed surface area in Angstroms squared.

import "std/core/math/constants.oo";
fn circ_pi_std_bio_advanced_pdb_solvent_accessible_area() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }
type AtomSasaRecord = struct {
    atom_id: Int,
    res_num: Int,
    element: String,
    x: Float,
    y: Float,
    z: Float,
    vdw_radius: Float,
    accessible_area: Float
};

type ResidueSasaResult = struct {
    res_num: Int,
    res_name: String,
    total_sasa_a2: Float,
    relative_exposure_pct: Float,
    is_buried: Bool
};

pub fn sasa_probe_radius() -> Float {
    return 1.40; // Standard water molecule probe radius in Angstroms
}

pub fn sasa_vdw_radius(element: String) -> Float {
    if element == "C" || element == "c" { return 1.70; }
    if element == "N" || element == "n" { return 1.55; }
    if element == "O" || element == "o" { return 1.52; }
    if element == "S" || element == "s" { return 1.80; }
    if element == "H" || element == "h" { return 1.20; }
    if element == "P" || element == "p" { return 1.80; }
    return 1.60;
}

pub fn sasa_is_point_occluded(
    px: Float,
    py: Float,
    pz: Float,
    neighbor_x: Float,
    neighbor_y: Float,
    neighbor_z: Float,
    neighbor_radius: Float
) -> Bool {
    let r_eff: Int = neighbor_radius + sasa_probe_radius();    let dx: Int = px - neighbor_x;    let dy: Int = py - neighbor_y;    let dz: Int = pz - neighbor_z;    let dist_sq: Int = (dx * dx) + (dy * dy) + (dz * dz);    return dist_sq < (r_eff * r_eff);
}

pub fn sasa_calc_sphere_area(vdw_r: Float, unoccluded_points: Int, total_points: Int) -> Float {
    if total_points <= 0 { return 0.0; }
    let r_tot: Float = vdw_r + sasa_probe_radius();    let pi_val: Float = circ_pi_std_bio_advanced_pdb_solvent_accessible_area();
    let total_sphere_area: Float = 4.0 * pi_val * (r_tot * r_tot);    let fraction: Float = pdb_solvent_accessible_area_to_f(unoccluded_points) / pdb_solvent_accessible_area_to_f(total_points);    return total_sphere_area * fraction;
}

pub fn sasa_evaluate_residue(res_num: Int, res_name: String, total_sasa: Float, max_ref_sasa: Float) -> ResidueSasaResult {
    let mut rel_pct: Float = 0.0;

    if max_ref_sasa > 0.0 {

        rel_pct = (100.0 * total_sasa) / max_ref_sasa;

    }
    // Residues with < 20% relative solvent accessibility are considered buried in the hydrophobic core
    let buried: Bool = rel_pct < 20.0;
    return ResidueSasaResult {
        res_num: res_num,
        res_name: res_name,
        total_sasa_a2: total_sasa,
        relative_exposure_pct: rel_pct,
        is_buried: buried
    };
}


fn pdb_solvent_accessible_area_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
