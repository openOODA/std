// # CRISPR Base Editing Activity Window & Transition Efficiency
//
// Logline: Models Cytosine Base Editors (CBE: C->T) and Adenine Base Editors (ABE: A->G) within canonical editing deamination windows.
//
// Setup: Precision transition deamination module evaluating positions 4 through 8 within the protospacer.
//
// Beats:
//   1. Define BaseEditorType and BaseEditWindowResult data structures.
//   2. Model Gaussian deamination activity profile across spacer positions 1 to 20.
//   3. Compute bystander editing risk for adjacent editable target nucleotides.

type BaseEditorType = struct {
    name: String, // e.g. "BE4-CBE", "ABE8e"
    target_base: String, // "C" or "A"
    product_base: String, // "T" or "G"
    window_start: Int, // Typically 4
    window_end: Int, // Typically 8
    peak_position: Int // Typically 6
};

type BaseEditWindowResult = struct {
    editable_count: Int,
    bystander_count: Int,
    target_position: Int,
    peak_efficiency_pct: Float,
    bystander_risk_high: Bool
};

pub fn base_editor_cbe_default() -> BaseEditorType {
    return BaseEditorType {
        name: "BE4max-CBE",
        target_base: "C",
        product_base: "T",
        window_start: 4,
        window_end: 8,
        peak_position: 6
    };
}

pub fn base_editor_abe_default() -> BaseEditorType {
    return BaseEditorType {
        name: "ABE8e",
        target_base: "A",
        product_base: "G",
        window_start: 4,
        window_end: 8,
        peak_position: 6
    };
}

pub fn base_edit_evaluate_window(spacer: String, editor: BaseEditorType) -> BaseEditWindowResult {
    let n: Int = chars_len(spacer);    let mut edit_count: Int = 0;    let mut bystander: Int = 0;    let mut peak_eff: Float = 0.0;
    let mut best_pos: Int = 0;
    let mut i: Int = 0;    while i < n {
        let pos_1_indexed: Int = i + 1;        let c: String = char_at(spacer, i);        let matches_base: Bool = (c == editor.target_base || (c == "c" && editor.target_base == "C") || (c == "a" && editor.target_base == "A"));
        if matches_base && pos_1_indexed >= editor.window_start && pos_1_indexed <= editor.window_end {
            edit_count = edit_count + 1;
            let mut dist_from_peak: Int = editor.peak_position - pos_1_indexed;

            if pos_1_indexed > editor.peak_position {

                dist_from_peak = pos_1_indexed - editor.peak_position;

            }

            let mut eff: Float = 35.0;


            if dist_from_peak == 0 {


                eff = 85.0 } else if dist_from_peak == 1 { 65.0;


            }
            if eff > peak_eff {
                peak_eff = eff;
                best_pos = pos_1_indexed;
            }
        }
        i = i + 1;
    }

    if edit_count > 1 {
        bystander = edit_count - 1;
    }

    return BaseEditWindowResult {
        editable_count: edit_count,
        bystander_count: bystander,
        target_position: best_pos,
        peak_efficiency_pct: peak_eff,
        bystander_risk_high: bystander > 0
    };
}
