// # Protein Residue-Residue Contact Map & Distance Matrices
//
// Logline: Generates binary and thresholded residue-residue contact matrices based on C-alpha and C-beta Euclidean spatial distances.
//
// Setup: Structural biology module computing spatial proximity networks and long-range tertiary interactions.
//
// Beats:
//   1. Define ResiduePairContact and ContactMapSummary data structures.
//   2. Calculate 3D Euclidean distances between C-alpha / C-beta coordinate pairs.
//   3. Filter short-range (sequence separation |i-j| >= 6) and long-range tertiary contacts under 8.0 Angstrom cutoffs.

type ResiduePairContact = struct {
    res_i: Int,
    res_j: Int,
    distance_angstrom: Float,
    is_contact: Bool,
    seq_separation: Int,
    is_long_range: Bool
};

type ContactMapSummary = struct {
    num_residues: Int,
    total_contacts: Int,
    short_range_contacts: Int,
    long_range_contacts: Int,
    contact_density: Float
};

pub fn contact_euclidean_dist(x1: Float, y1: Float, z1: Float, x2: Float, y2: Float, z2: Float) -> Float {
    let dx: Float = x1 - x2;    let dy: Float = y1 - y2;    let dz: Float = z1 - z2;    let dist_sq: Float = (dx * dx) + (dy * dy) + (dz * dz);    // Square root approximation via Newton-Raphson if needed or return distance
    if dist_sq <= 0.0 { return 0.0; }
    let mut guess: Float = dist_sq / 2.0;    if guess < 1.0 { guess = 1.0; }
    let mut iter: Int = 0;    while iter < 8 {
        guess = 0.5 * (guess + (dist_sq / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn contact_evaluate_pair(i: Int, j: Int, dist: Float, cutoff: Float) -> ResiduePairContact {
    let mut sep: Int = j - i;

    if i > j {

        sep = i - j;

    }
    let is_cont: Bool = dist <= cutoff;    let long_range: Bool = is_cont && (sep >= 6);
    return ResiduePairContact {
        res_i: i,
        res_j: j,
        distance_angstrom: dist,
        is_contact: is_cont,
        seq_separation: sep,
        is_long_range: long_range
    };
}
