// # PDB Protein Structure RMSD & Kabsch Superposition
//
// Logline: Calculates Root-Mean-Square Deviation (RMSD) between protein 3D structures and computes center-of-mass translation vectors.
//
// Setup: Structural alignment engine comparing atomic coordinate ensembles and evaluating structural homology.
//
// Beats:
//   1. Define CoordinateEnsemble and RmsdResult data structures.
//   2. Compute geometric centroids and translate structures to common origins.
//   3. Calculate C-alpha and all-atom RMSD values in Angstrom units.

type Coord3D = struct {
    x: Float,
    y: Float,
    z: Float
};

type RmsdResult = struct {
    num_atoms: Int,
    centroid_a: Coord3D,
    centroid_b: Coord3D,
    rmsd_angstrom: Float,
    is_identical: Bool
};

pub fn rmsd_sqrt(val: Float) -> Float {
    if val <= 0.0 { return 0.0; }
    let mut guess: Float = val / 2.0;    if guess < 1.0 { guess = 1.0; }
    let mut iter: Int = 0;
    while iter < 10 {
        guess = 0.5 * (guess + (val / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn rmsd_compute_centroid(coords: List[Coord3D]) -> Coord3D {
    let n: Int = list_len(coords);    if n == 0 {
        return Coord3D { x: 0.0, y: 0.0, z: 0.0 };
    }
    let mut sum_x: Float = 0.0;
    let mut sum_y: Float = 0.0;
    let mut sum_z: Float = 0.0;

    let mut idx: Int = 0;
    while idx < n {
        let pt: Int = list_get(coords, idx);        sum_x = sum_x + pt.x;
        sum_y = sum_y + pt.y;
        sum_z = sum_z + pt.z;
        idx = idx + 1;
    }

    let n_f: Float = pdb_rmsd_superposition_to_f(n);    return Coord3D {
        x: sum_x / n_f,
        y: sum_y / n_f,
        z: sum_z / n_f
    };
}

pub fn rmsd_calc_aligned(set_a: List[Coord3D], set_b: List[Coord3D]) -> RmsdResult {
    let na: Int = list_len(set_a);    let nb: Int = list_len(set_b);    let mut n: Int = nb;
    if na < nb {
        n = na;
    }

    let c_a: Coord3D = rmsd_compute_centroid(set_a);    let c_b: Coord3D = rmsd_compute_centroid(set_b);
    if n == 0 {
        return RmsdResult {
            num_atoms: 0,
            centroid_a: c_a,
            centroid_b: c_b,
            rmsd_angstrom: 0.0,
            is_identical: false
        };
    }

    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let pa: Int = list_get(set_a, i);        let pb: Int = list_get(set_b, i);        // Centered coordinates
        let dax: Int = pa.x - c_a.x;        let day: Int = pa.y - c_a.y;        let daz: Int = pa.z - c_a.z;
        let dbx: Int = pb.x - c_b.x;        let dby: Int = pb.y - c_b.y;        let dbz: Int = pb.z - c_b.z;
        let dx: Int = dax - dbx;        let dy: Int = day - dby;        let dz: Int = daz - dbz;
        sum_sq = sum_sq + ((dx * dx) + (dy * dy) + (dz * dz));
        i = i + 1;
    }

    let mean_sq: Float = sum_sq / pdb_rmsd_superposition_to_f(n);    let rmsd_val: Float = rmsd_sqrt(mean_sq);
    return RmsdResult {
        num_atoms: n,
        centroid_a: c_a,
        centroid_b: c_b,
        rmsd_angstrom: rmsd_val,
        is_identical: rmsd_val < 0.001
    };
}


fn pdb_rmsd_superposition_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
