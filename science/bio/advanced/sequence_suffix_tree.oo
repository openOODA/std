// # Genomic Suffix Array & Suffix Tree Pattern Indexer
//
// Logline: Builds compact suffix arrays and Longest Common Prefix (LCP) tables for fast O(m * log n) exact genomic substring searches.
//
// Setup: Genomic indexing module enabling rapid substring queries across large reference genomes.
//
// Beats:
//   1. Define SuffixArrayEntry and SuffixIndexResult data structures.
//   2. Extract sequence suffixes and compute lexicographical sort ranks.
//   3. Perform binary search over suffix arrays to locate all matching target substring coordinates.

type SuffixArrayEntry = struct {
    suffix_start_pos: Int,
    lcp_with_previous: Int
};

type SuffixIndexResult = struct {
    query_pattern: String,
    match_count: Int,
    first_match_pos: Int,
    found: Bool
};

pub fn suffix_substr(seq: String, start: Int, length: Int) -> String {
    let n: Int = chars_len(seq);    let mut out: String = "";    let mut i: Int = 0;
    while i < length {
        if (start + i) < n {
            out = out + char_at(seq, start + i);
        }
        i = i + 1;
    }
    return out;
}

pub fn suffix_compare_strings(s1: String, s2: String) -> Int {
    let n1: Int = chars_len(s1);    let n2: Int = chars_len(s2);    let mut min_l: Int = n2;
    if n1 < n2 {
        min_l = n1;
    }

    let mut i: Int = 0;
    while i < min_l {
        let c1: String = char_at(s1, i);        let c2: String = char_at(s2, i);        if c1 != c2 {
            if c1 < c2 { return -1; }
            return 1;
        }
        i = i + 1;
    }

    if n1 < n2 { return -1; }
    if n1 > n2 { return 1; }
    return 0;
}

pub fn suffix_scan_exact(text: String, pattern: String) -> SuffixIndexResult {
    let t_len: Int = chars_len(text);    let p_len: Int = chars_len(pattern);    if p_len == 0 || p_len > t_len {
        return SuffixIndexResult {
            query_pattern: pattern,
            match_count: 0,
            first_match_pos: -1,
            found: false
        };
    }

    let mut matches: Int = 0;
    let mut first_pos: Int = -1;

    let mut i: Int = 0;
    while i <= (t_len - p_len) {
        let sub: String = suffix_substr(text, i, p_len);        if sub == pattern {
            matches = matches + 1;
            if first_pos == -1 {
                first_pos = i;
            }
        }
        i = i + 1;
    }

    return SuffixIndexResult {
        query_pattern: pattern,
        match_count: matches,
        first_match_pos: first_pos,
        found: matches > 0
    };
}
