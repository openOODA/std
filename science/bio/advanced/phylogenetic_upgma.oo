// # UPGMA Ultrametric Phylogenetic Tree Clustering
//
// Logline: Constructs ultrametric rooted phylogenetic trees using the Unweighted Pair Group Method with Arithmetic Mean (UPGMA).
//
// Setup: Evolutionary tree reconstruction module assuming a constant molecular clock rate across lineages.
//
// Beats:
//   1. Define UpgmaNode and UpgmaCluster data structures.
//   2. Identify minimal pairwise distance clusters (i, j) in symmetric distance matrices.
//   3. Compute average cluster distance updates: d((A U B), C) = (|A|*d(A, C) + |B|*d(B, C)) / (|A| + |B|).

type UpgmaNode = struct {
    node_id: Int,
    name: String,
    height: Float,
    left_child: Int,
    right_child: Int,
    is_leaf: Bool
};

type UpgmaCluster = struct {
    cluster_id: Int,
    member_count: Int,
    node_index: Int,
    is_active: Bool
};

pub fn upgma_leaf_node(id: Int, taxon_name: String) -> UpgmaNode {
    return UpgmaNode {
        node_id: id,
        name: taxon_name,
        height: 0.0,
        left_child: -1,
        right_child: -1,
        is_leaf: true
    };
}

pub fn upgma_internal_node(id: Int, height_val: Float, left_c: Int, right_c: Int) -> UpgmaNode {
    return UpgmaNode {
        node_id: id,
        name: "",
        height: height_val,
        left_child: left_c,
        right_child: right_c,
        is_leaf: false
    };
}

pub fn upgma_merge_distance(d_ac: Float, count_a: Int, d_bc: Float, count_b: Int) -> Float {
    let tot: Int = count_a + count_b;    if tot <= 0 { return 0.0; }
    let num: Float = (d_ac * phylogenetic_upgma_to_f(count_a)) + (d_bc * phylogenetic_upgma_to_f(count_b));    return num / phylogenetic_upgma_to_f(tot);
}

pub fn upgma_branch_length(parent_height: Float, child_height: Float) -> Float {
    let len: Float = parent_height - child_height;    if len < 0.0 { return 0.0; }
    return len;
}


fn phylogenetic_upgma_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
