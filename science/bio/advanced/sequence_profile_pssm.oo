// # Position-Specific Scoring Matrix (PSSM) & Motif Engine
//
// Logline: Converts Position Frequency Matrices (PFM) to log-odds PSSM weight matrices and scores transcription factor binding motifs.
//
// Setup: Regulatory genomics motif analysis module evaluating nucleotide log-likelihood scores.
//
// Beats:
//   1. Define PssmMatrix and MotifScoreResult data structures.
//   2. Add pseudocounts and convert observed counts to background-normalized log-odds weights.
//   3. Score arbitrary sequence windows against PSSM profiles and compute p-value thresholds.

type PssmMatrix = struct {
    motif_id: String,
    motif_length: Int,
    background_prob: Float // Typically 0.25 for equiprobable A/C/G/T
};

type MotifScoreResult = struct {
    start_pos: Int,
    matched_seq: String,
    raw_log_odds_score: Float,
    max_possible_score: Float,
    relative_score_pct: Float,
    is_significant_match: Bool
};

pub fn pssm_log2(p: Float) -> Float {
    if p <= 0.0001 { return -13.2877; }
    if p >= 0.9999 { return 0.0; }
    let z: Float = p - 1.0;    let ln_p: Float = z - (0.5 * z * z) + (0.333333 * z * z * z);    return ln_p / 0.69314718;
}

pub fn pssm_calc_log_odds(count: Int, total_sequences: Int, pseudocount: Float, bg: Float) -> Float {
    let numerator: Float = sequence_profile_pssm_to_f(count) + pseudocount;
    let denominator: Float = sequence_profile_pssm_to_f(total_sequences) + (4.0 * pseudocount);
    let freq: Float = numerator / denominator;
    let ratio: Float = freq / bg;
    return pssm_log2(ratio);
}

pub fn pssm_evaluate_hit(pos: Int, seq_window: String, score: Float, max_score: Float) -> MotifScoreResult {
    let mut rel_pct: Float = 0.0;

    if max_score > 0.0 {

        rel_pct = (score * 100.0) / max_score;

    }
    let is_hit: Bool = rel_pct >= 80.0;
    return MotifScoreResult {
        start_pos: pos,
        matched_seq: seq_window,
        raw_log_odds_score: score,
        max_possible_score: max_score,
        relative_score_pct: rel_pct,
        is_significant_match: is_hit
    };
}


fn sequence_profile_pssm_to_f(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = -1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + d_f * mult;
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}
