// # Huygens-Fresnel Wavefront Construction Principle
//
// Logline: Each point on a wavefront is a secondary spherical wavelet source; the new wavefront is the envelope of wavelets.
//
// Setup: Pure Float. speed > 0 and time >= 0 give positive radius. Hosts snell_law.oo stem.
//
// Beats:
//   1. Wavelet radius r = c * t from a secondary source after time t.
//   2. Wavefront travel time t = d / c across distance d.
//   3. Envelope radius for an expanding circular wavefront.
//   4. Refraction law recovery: sin(theta1)/v1 = sin(theta2)/v2 from wavelet construction.

import "std/science/phys/optics/snell_law.oo";
import "std/core/math/constants.oo";
fn circ_pi_std_phys_optics_huygens_principle() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }

fn hy_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

pub fn huygens_speed_of_light() -> Float {
    return 299792458.0;
}

// Secondary wavelet radius r = c * t (m). Time t < 0 or speed <= 0 returns Err.
pub fn huygens_wavelet_radius(speed: Float, time_seconds: Float) -> Result[Float, String] {
    if speed <= 0.0 { return Err("ERR\thy\tspeed"); }
    if time_seconds < 0.0 { return Err("ERR\thy\tt"); }
    return Ok(speed * time_seconds);
}

// Wavefront travel time t = d / c (s). Zero distance is Ok(0).
pub fn huygens_travel_time(distance_m: Float, speed: Float) -> Result[Float, String] {
    if distance_m < 0.0 { return Err("ERR\thy\td"); }
    if speed <= 0.0 { return Err("ERR\thy\tspeed"); }
    return Ok(distance_m / speed);
}

pub fn huygens_circular_envelope(initial_radius_m: Float, speed: Float, time_seconds: Float) -> Result[Float, String] {
    if initial_radius_m < 0.0 { return Err("ERR\thy\tr0"); }
    let wr: Result[Float, String] = huygens_wavelet_radius(speed, time_seconds);
    match wr {
        Ok(r)  => { return Ok(initial_radius_m + r); },
        Err(e) => { return Err(e); }
    }
}

pub fn huygens_refraction_consistent(n1: Float, n2: Float, theta1_rad: Float, theta2_rad: Float) -> Bool {
    if n1 <= 0.0 || n2 <= 0.0 { return false; }
    let s1: Float = sin(theta1_rad);
    let s2: Float = sin(theta2_rad);
    let lhs: Float = n1 * s1;
    let rhs: Float = n2 * s2;
    let mut d: Float = lhs - rhs;
    if d < 0.0 { d = 0.0 - d; }
    return d <= 0.0001;
}

// Refracted sine from wavelet construction. |sin| > 1 is TIR and returns Err.
pub fn huygens_refraction_sin(theta1_rad: Float, v1: Float, v2: Float) -> Result[Float, String] {
    if v1 <= 0.0 { return Err("ERR\thy\tv1"); }
    if v2 <= 0.0 { return Err("ERR\thy\tv2"); }
    let s1: Float = sin(theta1_rad);
    let s2: Float = (v1 / v2) * s1;
    if s2 > 1.0 { return Err("ERR\thy\ttir"); }
    if s2 < (0.0 - 1.0) { return Err("ERR\thy\ttir"); }
    let snell_r: Result[Float, String] = snell_sin_transmitted(1.0, 1.0, 0.0);
    if snell_r.is_ok() == false { return Err("ERR\thy\tsnell"); }
    return Ok(s2);
}

pub fn verify_huygens_principle() -> Bool {
    let r: Float = hy_got(huygens_wavelet_radius(299792458.0, 1.0));
    let mut d: Float = r - 299792458.0;
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0001 { return false; }
    if hy_got(huygens_wavelet_radius(3.0, 0.0)) != 0.0 { return false; }
    let t_one_meter: Float = hy_got(huygens_travel_time(1.0, 299792458.0));
    let mut dt: Float = t_one_meter - (1.0 / 299792458.0);
    if dt < 0.0 { dt = 0.0 - dt; }
    if dt > 0.000000001 { return false; }
    if hy_got(huygens_travel_time(0.0, 3.0)) != 0.0 { return false; }
    let env: Float = hy_got(huygens_circular_envelope(0.001, 3.0, 2.0));
    let target_e: Float = 0.001 + 6.0;
    let mut de: Float = env - target_e;
    if de < 0.0 { de = 0.0 - de; }
    if de > 0.0001 { return false; }
    let pi: Float = circ_pi_std_phys_optics_huygens_principle();
    if huygens_refraction_consistent(1.0, 1.0, 0.5, 0.5) == false { return false; }
    if huygens_refraction_consistent(1.0, 1.5, 0.0, 0.0) == false { return false; }
    let s: Float = hy_got(huygens_refraction_sin(pi / 6.0, 1.0, 2.0));
    let target_s: Float = 0.25;
    let mut ds: Float = s - target_s;
    if ds < 0.0 { ds = 0.0 - ds; }
    if ds > 0.0001 { return false; }
    if huygens_wavelet_radius(0.0, 1.0).is_ok() { return false; }
    if huygens_wavelet_radius(3.0, 0.0 - 1.0).is_ok() { return false; }
    if huygens_travel_time(0.0 - 1.0, 3.0).is_ok() { return false; }
    if huygens_travel_time(1.0, 0.0).is_ok() { return false; }
    if huygens_circular_envelope(0.0 - 0.1, 3.0, 1.0).is_ok() { return false; }
    if huygens_refraction_consistent(0.0, 1.5, 0.0, 0.0) { return false; }
    if huygens_refraction_sin(pi / 2.0, 2.0, 1.0).is_ok() { return false; }
    if huygens_refraction_sin(0.0, 0.0, 1.0).is_ok() { return false; }
    return true;
}
