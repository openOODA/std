// # Malus's Law for Linear Polarizers
//
// Logline: Transmitted intensity I = I0 * cos^2(theta) for ideal linear polarizers.
//
// Setup: Pure Float. I0 >= 0. I0<0 returns Err. Crossed polarizers are Ok(0).
//
// Beats:
//   1. Transmitted intensity I = I0 * cos^2(theta) (W/m^2).
//   2. Fractional transmission T = cos^2(theta) (dimensionless in [0, 1]).
//   3. Maximum extinction angle theta = pi/2 yields Ok(0).
//   4. Hosts beer_lambert_law.oo stem for chain-of-absorbers modeling.

import "std/science/phys/optics/beer_lambert_law.oo";

fn ml_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

// Transmitted intensity I = I0 * cos^2(theta) (W/m^2). I0 < 0 returns Err.
pub fn malus_intensity(i0: Float, theta_rad: Float) -> Result[Float, String] {
    if i0 < 0.0 { return Err("ERR\tml\ti0"); }
    let cos_t: Float = cos(theta_rad);
    let t: Float = cos_t * cos_t;
    return Ok(i0 * t);
}

// Fractional transmission T = cos^2(theta). Always in [0, 1].
pub fn malus_transmission(theta_rad: Float) -> Float {
    let cos_t: Float = cos(theta_rad);
    let t: Float = cos_t * cos_t;
    if t < 0.0 { return 0.0; }
    if t > 1.0 { return 1.0; }
    return t;
}

// Transmitted intensity through N cascaded polarizers with relative angles (rad).
pub fn malus_cascade_intensity(i0: Float, angles_rad: List[Float]) -> Result[Float, String] {
    if i0 < 0.0 { return Err("ERR\tml\ti0"); }
    let n: Int = list_len(angles_rad);
    if n <= 0 { return Err("ERR\tml\tempty"); }
    let mut total: Float = 1.0;
    let mut i: Int = 0;
    while i < n {
        let a: Float = list_get(angles_rad, i);
        let t: Float = malus_transmission(a);
        total = total * t;
        i = i + 1;
    }
    return Ok(i0 * total);
}

pub fn verify_malus_law() -> Bool {
    let i0: Float = 100.0;
    let i_aligned: Float = ml_got(malus_intensity(i0, 0.0));
    let mut d: Float = i_aligned - 100.0;
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0001 { return false; }
    let i_cross: Float = ml_got(malus_intensity(i0, 1.5707963267948966));
    let mut dcross: Float = i_cross;
    if dcross < 0.0 { dcross = 0.0 - dcross; }
    if dcross > 0.0001 { return false; }
    if ml_got(malus_intensity(0.0, 0.0)) != 0.0 { return false; }
    let i_45: Float = ml_got(malus_intensity(i0, 0.7853981633974483));
    let mut d45: Float = i_45 - 50.0;
    if d45 < 0.0 { d45 = 0.0 - d45; }
    if d45 > 0.0001 { return false; }
    let t_30: Float = malus_transmission(0.5235987755982988);
    let target_t: Float = cos(0.5235987755982988) * cos(0.5235987755982988);
    let mut dt: Float = t_30 - target_t;
    if dt < 0.0 { dt = 0.0 - dt; }
    if dt > 0.0001 { return false; }
    let mut angs: List[Float] = list_new();
    angs = list_push(angs, 0.0);
    angs = list_push(angs, 0.7853981633974483);
    angs = list_push(angs, 0.7853981633974483);
    let cascade: Float = ml_got(malus_cascade_intensity(1000.0, angs));
    let target_c: Float = 1000.0 * 0.5 * 0.5;
    let mut dc: Float = cascade - target_c;
    if dc < 0.0 { dc = 0.0 - dc; }
    if dc > 0.0001 { return false; }
    if malus_intensity(0.0 - 1.0, 0.0).is_ok() { return false; }
    let mut empty_angs: List[Float] = list_new();
    if malus_cascade_intensity(100.0, empty_angs).is_ok() { return false; }
    if malus_transmission(2.5) > 1.0 || malus_transmission(2.5) < 0.0 { return false; }
    let blr: Result[Float, String] = beer_lambert_transmittance(0.0, 1.0);
    if blr.is_ok() == false { return false; }
    return true;
}
