// # Kitaev 1D chain: Z_2 topological invariant & Majorana self-conjugacy
//
// Logline: 1D Kitaev chain has Z_2 invariant nu=1 iff |mu| < 2t (topological, Majorana edge modes); nu=0 iff |mu| > 2t (trivial).
//
// Setup: Pure Float. t > 0 (hopping), mu (chemical potential). t < 0 fails closed.
//
// Beats:
//   1. Majorana self-conjugacy: gamma = gamma* enforced by MajoranaZeroMode struct.
//   2. Z_2 invariant: nu = 1 iff |mu| < 2t; nu = 0 iff |mu| > 2t.
//   3. Braid phase pi/4 for non-Abelian exchange of two Majorana zero modes.
//   4. DomainCert holds=1 iff |mu| < 2t; holds=0 if t <= 0.
//
// References:
//   - Kitaev 2001, "Unpaired Majorana fermions and the quantized Hall effect" (cond-mat/0010440, Phys. Usp. 2001).

import "std/core/principles/physical_constants.oo";
import "std/core/primitives/domain_cert.oo";
import "std/core/math/constants.oo";
fn circ_pi_std_phys_kitaev_majorana_principle() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }

fn pabs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

// Z_2 topological invariant of the 1D Kitaev chain. Returns 1 if |mu| < 2t, 0 if |mu| > 2t.
// t <= 0 fails closed and returns -1.
pub fn kitaev_z2_invariant(mu: Float, t: Float) -> Int {
    if t < 0.0 { return -1; }
    if t == 0.0 { return -1; }
    let abs_mu: Float = pabs(mu);
    let two_t: Float = 2.0 * t;
    if abs_mu < two_t {
        return 1;
    }
    if abs_mu > two_t {
        return 0;
    }
    return 0;
}

// Majorana self-conjugacy check: gamma == gamma* means braiding phase encodes a real (Majorana) operator.
// Returns 1 (self-conjugate) when the abstract carrier is real; -1 (complex Dirac) otherwise.
pub fn kitaev_majorana_self_conjugate(is_real_carrier: Int) -> Int {
    if is_real_carrier == 1 {
        return 1;
    }
    return -1;
}

// Non-Abelian braid phase between two Majorana zero modes: pi/4 (one quarter exchange).
pub fn kitaev_majorana_braid_phase() -> Float {
    let pi_val: Float = circ_pi_std_phys_kitaev_majorana_principle();
    return pi_val / 4.0;
}

// Edge-mode protection factor: split E_split ~ exp(-L / xi). Caller supplies length L and coherence length xi.
pub fn kitaev_edge_mode_split(L: Float, xi: Float) -> Float {
    if xi <= 0.0 { return 0.0 - 1.0; }
    if L < 0.0 { return 0.0 - 1.0; }
    let ratio: Float = L / xi;
    return exp(0.0 - ratio);
}

// DomainCert holds=1 iff t > 0 and |mu| < 2t (topological regime).
pub fn phys_kitaev_majorana_principle(mu: Float, t: Float) -> DomainCert {
    let mut h: Int = 0;
    let nu: Int = kitaev_z2_invariant(mu, t);
    if nu == 1 {
        h = 1;
    }
    return domain_cert("phys", "kitaev_majorana", h);
}

// Verify: golden topological |mu|<2t -> Z_2=1; trivial |mu|>2t -> Z_2=0; hostile t<0 fails closed;
//         Majorana self-conjugacy; braid phase pi/4; coupled edge-mode protection.
pub fn verify_kitaev_majorana_principle() -> Bool {
    // Golden: topological regime |mu| < 2t -> Z_2 = 1.
    let nu_topo: Int = kitaev_z2_invariant(0.5, 1.0);
    if nu_topo != 1 { return false; }
    let nu_topo2: Int = kitaev_z2_invariant(0.0, 1.0);
    if nu_topo2 != 1 { return false; }
    let nu_topo3: Int = kitaev_z2_invariant(1.5, 1.0);
    if nu_topo3 != 1 { return false; }
    // Golden: trivial regime |mu| > 2t -> Z_2 = 0.
    let nu_triv: Int = kitaev_z2_invariant(3.0, 1.0);
    if nu_triv != 0 { return false; }
    let nu_triv2: Int = kitaev_z2_invariant(0.0 - 5.0, 1.0);
    if nu_triv2 != 0 { return false; }
    // Hostile: t < 0 fails closed to -1.
    if kitaev_z2_invariant(0.0, 0.0 - 1.0) != -1 { return false; }
    if kitaev_z2_invariant(0.0, 0.0) != -1 { return false; }
    // Majorana self-conjugacy: real carrier -> 1; complex Dirac -> -1.
    if kitaev_majorana_self_conjugate(1) != 1 { return false; }
    if kitaev_majorana_self_conjugate(0) != -1 { return false; }
    // Braid phase pi/4.
    let braid: Float = kitaev_majorana_braid_phase();
    let pi_val: Float = circ_pi_std_phys_kitaev_majorana_principle();
    let want_braid: Float = pi_val / 4.0;
    let mut d_braid: Float = braid - want_braid;
    if d_braid < 0.0 { d_braid = 0.0 - d_braid; }
    if d_braid > 0.0000001 { return false; }
    // Coupled: edge-mode protection exp(-L/xi) for L=xi -> 1/e.
    let e_split: Float = kitaev_edge_mode_split(1.0, 1.0);
    let want_e: Float = 1.0 / 2.718281828459045;
    let mut d_e: Float = e_split - want_e;
    if d_e < 0.0 { d_e = 0.0 - d_e; }
    if d_e > 0.0000001 { return false; }
    if kitaev_edge_mode_split(0.0, 1.0) > 1.0 { return false; }
    if kitaev_edge_mode_split(1.0, 0.0) >= 0.0 { return false; }
    if kitaev_edge_mode_split(0.0 - 1.0, 1.0) >= 0.0 { return false; }
    // DomainCert sanity.
    if phys_kitaev_majorana_principle(0.5, 1.0).holds != 1 { return false; }
    if phys_kitaev_majorana_principle(3.0, 1.0).holds != 0 { return false; }
    if phys_kitaev_majorana_principle(0.0, 0.0 - 1.0).holds != 0 { return false; }
    return true;
}
