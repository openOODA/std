// # Berry phase, Berry curvature & Chern number law
//
// Logline: gamma = oint_C A . dk; C = (1/2 pi) int F d^2 k in Z; TKNN sigma_xy = (e^2 / h) C.
//
// Setup: Pure Float and Int. Berry phase and Chern number are gauge-invariant quantized (mod 2 pi) topological invariants.
//
// Beats:
//   1. Berry phase from closed loop: gamma = sum_i A_k . dk as List[Float] of 2D vectors.
//   2. Chern number from plaquette Berry fluxes: C = sum F / (2 pi), rounded to nearest integer in Z.
//   3. TKNN Hall conductance sigma_xy = C * (e^2 / h) in natural units of e^2/h.
//   4. DomainCert holds=1 iff loop is closed (start == end) and fluxes sum is integral.
//
// References:
//   - Berry 1984, Proc. R. Soc. Lond. A 392, 45.
//   - Xiao-Bhang-Chen 2010, Rev. Mod. Phys. 82, 1959 (arXiv:0907.2021).
//   - Thouless-Kohmoto-Nightingale-den Nijs 1982, Phys. Rev. Lett. 49, 405 (TKNN).
//   - Haldane 1988, Phys. Rev. Lett. 61, 2015 (Haldane model C = +/- 1).

import "std/core/principles/physical_constants.oo";
import "std/core/primitives/domain_cert.oo";
import "std/core/math/constants.oo";
fn circ_pi_std_phys_berry_curvature_law() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }

fn pabs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn br_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

// Berry phase from a closed loop of 2D (k_x, k_y) samples. start != end returns Err.
// dk is reconstructed as the difference between consecutive samples; A is the Berry connection 1-form component.
// Here we use the 1D path integral: gamma = sum_i A_i * (k_{i+1} - k_i) over the closed loop.
pub fn berry_phase_closed(k_samples: List[Float], a_samples: List[Float]) -> Result[Float, String] {
    let n: Int = list_len(k_samples);
    let m: Int = list_len(a_samples);
    if n < 2 { return Err("ERR\tbr\tloop"); }
    if n != m { return Err("ERR\tbr\tsize"); }
    let k0: Float = list_get(k_samples, 0);
    let kn: Float = list_get(k_samples, n - 1);
    let dk_close: Float = pabs(kn - k0);
    if dk_close > 0.0000001 { return Err("ERR\tbr\topen"); }
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n - 1 {
        let a_i: Float = list_get(a_samples, i);
        let k_i: Float = list_get(k_samples, i);
        let k_next: Float = list_get(k_samples, i + 1);
        let dk: Float = k_next - k_i;
        sum = sum + a_i * dk;
        i = i + 1;
    }
    return Ok(sum);
}

// First Chern number from list of plaquette Berry fluxes. Returns Int in Z.
pub fn berry_chern_number(fluxes: List[Float]) -> Int {
    let n: Int = list_len(fluxes);
    let mut total: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let f: Float = list_get(fluxes, i);
        total = total + f;
        i = i + 1;
    }
    let pi_val: Float = circ_pi_std_phys_berry_curvature_law();
    let two_pi: Float = 2.0 * pi_val;
    let c_float: Float = total / two_pi;
    if c_float >= 0.0 {
        let c_int: Int = (c_float + 0.5) as Int;
        return c_int;
    }
    let neg: Float = 0.0 - c_float;
    let c_neg: Int = (neg + 0.5) as Int;
    return 0 - c_neg;
}

// TKNN Hall conductance sigma_xy in units of e^2 / h. Returns C * (e^2/h).
// Here we return C in units of e^2/h (the dimensionless prefactor).
pub fn berry_tknn_hall_conductance(chern: Int) -> Float {
    if chern >= 0 {
        return (chern as Float);
    }
    let neg: Int = 0 - chern;
    return 0.0 - (neg as Float);
}

// Planck constant h for the e^2/h unit scale (J*s).
pub fn berry_planck_h() -> Float {
    let pc: PhysicalConstants = constants_codata_2022();
    return pc.planck_constant;
}

// DomainCert holds=1 iff Berry phase is well-defined (closed loop, valid sizes).
pub fn phys_berry_curvature_law(k_samples: List[Float], a_samples: List[Float]) -> DomainCert {
    let r: Result[Float, String] = berry_phase_closed(k_samples, a_samples);
    let mut h: Int = 0;
    match r {
        Ok(g)  => { h = 1; },
        Err(_) => { }
    }
    return domain_cert("phys", "berry_curvature", h);
}

// Verify: golden Haldane C=1 and C=-1; open loop fails closed; TKNN C=1 gives 1 e^2/h.
pub fn verify_berry_curvature_law() -> Bool {
    let pi_val: Float = circ_pi_std_phys_berry_curvature_law();
    // Haldane nontrivial phase: Chern number +1 -> sum of fluxes = 2 pi.
    let mut fluxes_pos: List[Float] = list_new();
    fluxes_pos = list_push(fluxes_pos, 2.0 * pi_val);
    let c_pos: Int = berry_chern_number(fluxes_pos);
    if c_pos != 1 { return false; }
    // Haldane other phase: Chern number -1 -> sum of fluxes = -2 pi.
    let mut fluxes_neg: List[Float] = list_new();
    fluxes_neg = list_push(fluxes_neg, 0.0 - 2.0 * pi_val);
    let c_neg: Int = berry_chern_number(fluxes_neg);
    if c_neg != -1 { return false; }
    // Trivial: C = 0 when sum flux = 0.
    let mut fluxes_triv: List[Float] = list_new();
    fluxes_triv = list_push(fluxes_triv, 0.0);
    let c_triv: Int = berry_chern_number(fluxes_triv);
    if c_triv != 0 { return false; }
    // Plaquette sum split across N plaquettes: 4 * (pi/2) = 2 pi -> C = 1.
    let mut fluxes_split: List[Float] = list_new();
    fluxes_split = list_push(fluxes_split, pi_val * 0.5);
    fluxes_split = list_push(fluxes_split, pi_val * 0.5);
    fluxes_split = list_push(fluxes_split, pi_val * 0.5);
    fluxes_split = list_push(fluxes_split, pi_val * 0.5);
    let c_split: Int = berry_chern_number(fluxes_split);
    if c_split != 1 { return false; }
    // Closed Berry phase: A = const, integral = 0 (closed loop returns to start).
    let mut k_loop: List[Float] = list_new();
    k_loop = list_push(k_loop, 0.0);
    k_loop = list_push(k_loop, 0.5);
    k_loop = list_push(k_loop, 1.0);
    k_loop = list_push(k_loop, 0.0);
    let mut a_loop: List[Float] = list_new();
    a_loop = list_push(a_loop, 0.0);
    a_loop = list_push(a_loop, 0.0);
    a_loop = list_push(a_loop, 0.0);
    a_loop = list_push(a_loop, 0.0);
    let g_closed: Float = br_got(berry_phase_closed(k_loop, a_loop));
    if pabs(g_closed) > 0.0000001 { return false; }
    // Hostile: open loop must fail.
    let mut k_open: List[Float] = list_new();
    k_open = list_push(k_open, 0.0);
    k_open = list_push(k_open, 0.5);
    k_open = list_push(k_open, 1.0);
    let mut a_open: List[Float] = list_new();
    a_open = list_push(a_open, 0.0);
    a_open = list_push(a_open, 0.0);
    a_open = list_push(a_open, 0.0);
    if berry_phase_closed(k_open, a_open).is_ok() { return false; }
    // Hostile: size mismatch fails.
    if berry_phase_closed(k_loop, a_open).is_ok() { return false; }
    // Hostile: <2 samples fails.
    let mut k_one: List[Float] = list_new();
    k_one = list_push(k_one, 0.0);
    let mut a_one: List[Float] = list_new();
    a_one = list_push(a_one, 0.0);
    if berry_phase_closed(k_one, a_one).is_ok() { return false; }
    // Coupled: TKNN sigma_xy = C * (e^2/h) units.
    let sigma1: Float = berry_tknn_hall_conductance(1);
    if pabs(sigma1 - 1.0) > 0.0000001 { return false; }
    let sigma_m1: Float = berry_tknn_hall_conductance(-1);
    if pabs(sigma_m1 - (0.0 - 1.0)) > 0.0000001 { return false; }
    // Planck h is positive.
    if berry_planck_h() <= 0.0 { return false; }
    // DomainCert sanity.
    if phys_berry_curvature_law(k_loop, a_loop).holds != 1 { return false; }
    if phys_berry_curvature_law(k_open, a_open).holds != 0 { return false; }
    return true;
}
