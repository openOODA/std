// # Grover Quantum Search Algorithm
//
// Logline: Implements unstructured database search using amplitude amplification, phase oracles, and diffusion inversion.
//
// Setup: Amplitude amplification algorithms importing register, circuit, and execution primitives.
//
// Beats:
//   1. Calculate optimal Grover iteration count R ~ (pi/4) * sqrt(2^N).
//   2. Apply phase inversion oracle flipping amplitudes of marked target states.
//   3. Implement Grover diffusion operator (inversion about the mean) and full search pipeline.

import "./qubit_state.oo";
import "./quantum_register.oo";

type GroverResult = struct {
    target_index: Int,
    found_index: Int,
    success_prob: Float,
    iterations: Int
};

fn int_to_float_grover(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn grover_optimal_iterations(num_qubits: Int) -> Int {
    if num_qubits <= 2 {
        return 1;
    }
    if num_qubits == 3 {
        return 2;
    }
    if num_qubits == 4 {
        return 3;
    }
    let n_states: Int = int_pow2(num_qubits);
    let sqrt_n: Float = sqrt(int_to_float_grover(n_states));
    let r: Float = 0.7853981633974483 * sqrt_n;
    let mut count: Int = 1;
    let mut accum: Float = 1.0;
    while accum + 0.5 < r {
        count = count + 1;
        accum = accum + 1.0;
    }
    return count;
}

pub fn apply_grover_oracle(reg: &mut QuantumRegister, target_idx: Int) {
    let old_amp: Complex = register_get_amp(reg, target_idx);
    let flipped: Complex = complex_scale(old_amp, 0.0 - 1.0);
    register_set_amp(reg, target_idx, flipped);
}

pub fn apply_grover_diffusion(reg: &mut QuantumRegister) {
    let n_states: Int = register_get_num_states(reg);
    let amps: List[Complex] = register_get_amplitudes(reg);

    let mut sum_r: Float = 0.0;
    let mut sum_i: Float = 0.0;
    let mut k: Int = 0;
    while k < n_states {
        let c: Complex = list_get(amps, k);
        let cr: Float = complex_get_real(&c);
        let ci: Float = complex_get_imag(&c);
        sum_r = sum_r + cr;
        sum_i = sum_i + ci;
        k = k + 1;
    }

    let n_flt: Float = int_to_float_grover(n_states);
    let mean_r: Float = sum_r / n_flt;
    let mean_i: Float = sum_i / n_flt;
    let two_mean: Complex = Complex { real: 2.0 * mean_r, imag: 2.0 * mean_i };

    let mut new_amps: List[Complex] = list_new();
    let mut idx: Int = 0;
    while idx < n_states {
        let c: Complex = list_get(amps, idx);
        let new_c: Complex = complex_sub(two_mean, c);
        list_push(new_amps, new_c);
        idx = idx + 1;
    }
    register_set_amplitudes(reg, new_amps);
}

pub fn run_grover_search(num_qubits: Int, marked_target: Int) -> GroverResult {
    let mut reg: QuantumRegister = register_new(num_qubits);
    let n_states: Int = register_get_num_states(&reg);

    // 1. Equal superposition initialization: 1/sqrt(N) for all states
    let inv_sqrt_n: Float = 1.0 / sqrt(int_to_float_grover(n_states));
    let mut init_amps: List[Complex] = list_new();
    let mut k: Int = 0;
    while k < n_states {
        let amp_k: Complex = Complex { real: inv_sqrt_n, imag: 0.0 };
        list_push(init_amps, amp_k);
        k = k + 1;
    }
    register_set_amplitudes(&mut reg, init_amps);

    // 2. Run optimal iterations of (Oracle + Diffusion)
    let iters: Int = grover_optimal_iterations(num_qubits);
    let mut step: Int = 0;
    while step < iters {
        apply_grover_oracle(&mut reg, marked_target);
        apply_grover_diffusion(&mut reg);
        step = step + 1;
    }

    // 3. Measure highest probability outcome
    let final_amps: List[Complex] = register_get_amplitudes(&reg);
    let mut max_prob: Float = 0.0;
    let mut best_idx: Int = 0;
    let mut i: Int = 0;
    while i < n_states {
        let c: Complex = list_get(final_amps, i);
        let p: Float = complex_norm_sq(c);
        if p > max_prob {
            max_prob = p;
            best_idx = i;
        }
        i = i + 1;
    }

    return GroverResult {
        target_index: marked_target,
        found_index: best_idx,
        success_prob: max_prob,
        iterations: iters
    };
}
