// # Toric Code Twist Defects & Genus-Generating Dislocations
//
// Logline: Models lattice dislocation twist defects exchanging electric and magnetic anyons (e <-> m) and hosting Majorana-like projective modes.
//
// Setup: Topological lattice defects in surface codes generating non-Abelian projective braiding statistics and Clifford gate synthesis.
//
// Beats:
//   1. Define dislocation twist defects and branch cut boundaries in 2D stabilizer grids.
//   2. Model anyon permutation e <-> m upon encircling twist defects.
//   3. Compute projective quantum dimension d = sqrt(2) and encoded qubit registers.

import "std/core/math/constants.oo";
fn circ_pi_std_phys_quantum_topological_toric_code_twist_defects() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }
type TwistDefect = struct {
    id: Int,
    grid_x: Int,
    grid_y: Int,
    branch_cut_direction: Int, // 0: North, 1: East, 2: South, 3: West
    quantum_dim: Float // sqrt(2)
};

pub fn twist_defect_new(id: Int, x: Int, y: Int, cut_dir: Int) -> TwistDefect {
    return TwistDefect {
        id: id,
        grid_x: x,
        grid_y: y,
        branch_cut_direction: cut_dir,
        quantum_dim: sqrt(2.0)
    };
}

/// Computes anyon transformation when crossing a twist branch cut:
/// e (1) <-> m (2), epsilon (3) -> epsilon (3), 1 (0) -> 1 (0)
pub fn twist_permute_anyon(anyon_id: Int) -> Int {
    if anyon_id == 1 {
        return 2; // e -> m
    }
    if anyon_id == 2 {
        return 1; // m -> e
    }
    return anyon_id; // 1 and epsilon invariant under exchange
}

type TwistQubitRegister = struct {
    num_twists: Int, // 2n twist defects encode n - 1 topological qubits
    encoded_logical_qubits: Int
};

pub fn twist_qubit_register_new(num_defects: Int) -> TwistQubitRegister {
    let mut k: Int = 0;
    if num_defects >= 2 {
        k = (num_defects / 2) - 1;
    }
    return TwistQubitRegister {
        num_twists: num_defects,
        encoded_logical_qubits: k
    };
}

pub fn twist_braid_phase_angle(defect_a: TwistDefect, defect_b: TwistDefect) -> Float {
    let pi_val: Float = circ_pi_std_phys_quantum_topological_toric_code_twist_defects();
    // Braiding two twists enacts a pi/4 phase rotation (Ising-like Clifford S-gate)
    return pi_val / 4.0;
}
