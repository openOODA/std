// # Logarithmic Negativity & Mixed-State Entanglement in MPS
//
// Logline: Calculates logarithmic negativity $\mathcal{E}(\rho_{AB}) = \ln ||\rho_{AB}^{T_B}||_1$ for disjoint and adjacent subsystems in mixed-state MPS.
//
// Setup: Partial transpose $T_B$ on subsystem $B$ density matrix to quantify genuine quantum entanglement in thermal and mixed states.
//
// Beats:
//   1. Define NegativityBipartition and PartialTransposeConfig data structures.
//   2. Construct partial transposed transfer matrix across boundary regions $A$ and $B$.
//   3. Extract trace norm $||\rho_{AB}^{T_B}||_1$ and compute logarithmic negativity.

type NegativityBipartition = struct {
    subsystem_a_start: Int,
    subsystem_a_end: Int,
    subsystem_b_start: Int,
    subsystem_b_end: Int,
    logarithmic_negativity: Float,
    trace_norm_pt: Float
};

type PartialTransposeConfig = struct {
    max_transfer_bond: Int,
    convergence_tol: Float
};

pub fn partial_transpose_config_default() -> PartialTransposeConfig {
    return PartialTransposeConfig {
        max_transfer_bond: 64,
        convergence_tol: 0.000001
    };
}

pub fn negativity_bipartition_new(a_s: Int, a_e: Int, b_s: Int, b_e: Int, norm_pt: Float) -> NegativityBipartition {
    // E_N = ln ||rho^{T_B}||_1
    let mut log_norm: Float = 0.0;
    if norm_pt > 0.0001 {
        log_norm = (norm_pt - 1.0) / (0.5 * (norm_pt + 1.0));
    }
    let mut e_n: Float = log_norm;
    if log_norm < 0.0 {
        e_n = 0.0;
    }
    return NegativityBipartition {
        subsystem_a_start: a_s,
        subsystem_a_end: a_e,
        subsystem_b_start: b_s,
        subsystem_b_end: b_e,
        logarithmic_negativity: e_n,
        trace_norm_pt: norm_pt
    };
}
