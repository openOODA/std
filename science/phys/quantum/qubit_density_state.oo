// # Quantum State Vectors, Pauli Gates, and Wavefunction Collapse
//
// Logline: Simulates pure single-qubit state vectors, unitary quantum gates (X, Z, Hadamard), and measurement probabilities.
//
// Setup: Pure algebraic quantum state representation tracking complex amplitudes for |0> and |1>.
//
// Beats:
//   1. Define Qubit struct with normalized complex amplitudes (alpha_r, alpha_i, beta_r, beta_i).
//   2. Unitary Pauli-X (Bit-flip / Quantum NOT) gate.
//   3. Unitary Pauli-Z (Phase-flip) gate.
//   4. Unitary Hadamard gate creating equal superposition states.
//   5. Calculate Born rule measurement probabilities P(|0>) and P(|1>).

type Qubit = struct {
    alpha_r: Float,
    alpha_i: Float,
    beta_r: Float,
    beta_i: Float
};

// Construct pure basis state |0>
pub fn qb_zero() -> Qubit {
    return Qubit { alpha_r: 1.0, alpha_i: 0.0, beta_r: 0.0, beta_i: 0.0 };
}

// Construct pure basis state |1>
pub fn qb_one() -> Qubit {
    return Qubit { alpha_r: 0.0, alpha_i: 0.0, beta_r: 1.0, beta_i: 0.0 };
}

// Construct normalized qubit from real amplitudes
pub fn qb_new_real(alpha: Float, beta: Float) -> Qubit {
    let norm_sq: Float = alpha * alpha + beta * beta;
    let mut norm: Float = 1.0;
    if norm_sq > 0.0 { norm = sqrt(norm_sq); }
    return Qubit {
        alpha_r: alpha / norm,
        alpha_i: 0.0,
        beta_r: beta / norm,
        beta_i: 0.0
    };
}

// Born rule probability of measuring |0>: P(|0>) = |alpha|^2
pub fn qb_prob_zero(q: Qubit) -> Float {
    return q.alpha_r * q.alpha_r + q.alpha_i * q.alpha_i;
}

// Born rule probability of measuring |1>: P(|1>) = |beta|^2
pub fn qb_prob_one(q: Qubit) -> Float {
    return q.beta_r * q.beta_r + q.beta_i * q.beta_i;
}

// Pauli-X (Quantum NOT / Bit Flip): swaps alpha and beta
pub fn qb_gate_x(q: Qubit) -> Qubit {
    return Qubit {
        alpha_r: q.beta_r,
        alpha_i: q.beta_i,
        beta_r: q.alpha_r,
        beta_i: q.alpha_i
    };
}

// Pauli-Z (Phase Flip): beta -> -beta
pub fn qb_gate_z(q: Qubit) -> Qubit {
    return Qubit {
        alpha_r: q.alpha_r,
        alpha_i: q.alpha_i,
        beta_r: 0.0 - q.beta_r,
        beta_i: 0.0 - q.beta_i
    };
}

// Hadamard gate: H|0> = (|0> + |1>)/sqrt(2), H|1> = (|0> - |1>)/sqrt(2)
pub fn qb_gate_hadamard(q: Qubit) -> Qubit {
    let inv_sqrt2: Float = 0.7071067811865475;
    let new_ar: Float = (q.alpha_r + q.beta_r) * inv_sqrt2;
    let new_ai: Float = (q.alpha_i + q.beta_i) * inv_sqrt2;
    let new_br: Float = (q.alpha_r - q.beta_r) * inv_sqrt2;
    let new_bi: Float = (q.alpha_i - q.beta_i) * inv_sqrt2;
    return Qubit {
        alpha_r: new_ar,
        alpha_i: new_ai,
        beta_r: new_br,
        beta_i: new_bi
    };
}
