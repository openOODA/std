// # Tensor Network Renormalization (TNR) with Disentanglers
//
// Logline: Implements Evenbly-Vidal TNR inserting unitary disentanglers to eliminate short-range loop entanglement before coarse-graining.
//
// Setup: Proper scale-invariant renormalization group flow removing CDL (corner double line) fixed point artifacts in critical 2D systems.
//
// Beats:
//   1. Define TnrConfig, TnrDisentanglerPair, and TnrFixedPointTensor data structures.
//   2. Implement local loop disentangling optimization via linearized cost functions.
//   3. Extract accurate Conformal Field Theory (CFT) central charges and operator scaling spectra.

type TnrConfig = struct {
    chi_bond: Int,
    disentangler_iterations: Int,
    cost_function_tol: Float
};

type TnrFixedPointReport = struct {
    renorm_step: Int,
    disentangler_loss: Float,
    effective_central_charge: Float,
    is_scale_invariant: Int
};

pub fn tnr_config_default(chi: Int) -> TnrConfig {
    return TnrConfig {
        chi_bond: chi,
        disentangler_iterations: 20,
        cost_function_tol: 0.000001
    };
}

pub fn tnr_fixed_point_report_new(step: Int, loss: Float, c: Float) -> TnrFixedPointReport {
    let mut abs_loss: Float = loss;
    if loss < 0.0 {
        abs_loss = 0.0 - loss;
    }
    let mut scale_inv: Int = 0;
    if abs_loss < 0.0001 {
        scale_inv = 1;
    }
    return TnrFixedPointReport {
        renorm_step: step,
        disentangler_loss: abs_loss,
        effective_central_charge: c,
        is_scale_invariant: scale_inv
    };
}
