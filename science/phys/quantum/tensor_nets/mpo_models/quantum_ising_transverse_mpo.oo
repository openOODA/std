// # Transverse-Field Ising Model (TFIM) MPO & Quantum Criticality
//
// Logline: Generates 3x3 MPO tensors for the 1D transverse-field quantum Ising model $H = -J \sum_i \sigma_i^z \sigma_{i+1}^z - h_x \sum_i \sigma_i^x - h_z \sum_i \sigma_i^z$.
//
// Setup: Canonical quantum critical model exhibiting second-order phase transition at $h_x / J = 1.0$ with $c=1/2$ conformal invariance.
//
// Beats:
//   1. Define TfimConfig and TfimOrderParameter data structures.
//   2. Construct compact 3x3 block upper-triangular MPO tensors for pure TFIM.
//   3. Compute Kramers-Wannier self-dual critical point diagnostics and energy spectrum gap.

type TfimConfig = struct {
    num_sites: Int,
    coupling_j: Float,
    transverse_hx: Float,
    longitudinal_hz: Float
};

type TfimOrderParameter = struct {
    transverse_field_ratio: Float,
    is_ferromagnetic: Int,
    is_paramagnetic: Int,
    is_critical: Int,
    ground_state_energy_exact_inf: Float
};

pub fn tfim_config_new(num_sites: Int, j: Float, hx: Float) -> TfimConfig {
    return TfimConfig {
        num_sites: num_sites,
        coupling_j: j,
        transverse_hx: hx,
        longitudinal_hz: 0.0
    };
}

pub fn tfim_order_parameter_classify(j: Float, hx: Float) -> TfimOrderParameter {
    let mut ratio: Float = 1.0;
    if j > 0.0 {
        ratio = hx / j;
    }
    let diff: Float = ratio - 1.0;
    let mut abs_diff: Float = diff;
    if diff < 0.0 {
        abs_diff = 0.0 - diff;
    }
    let mut is_crit: Int = 0;
    if abs_diff < 0.001 {
        is_crit = 1;
    }
    let mut is_fm: Int = 0;
    if ratio < 0.999 {
        is_fm = 1;
    }
    let mut is_pm: Int = 0;
    if ratio > 1.001 {
        is_pm = 1;
    }

    // At criticality (h_x = J = 1): E_0 / N = - 4 / pi ~ -1.2732395
    let mut exact_e: Float = -1.0 - (ratio * ratio) / 4.0;
    if is_crit == 1 {
        exact_e = -1.2732395;
    }

    return TfimOrderParameter {
        transverse_field_ratio: ratio,
        is_ferromagnetic: is_fm,
        is_paramagnetic: is_pm,
        is_critical: is_crit,
        ground_state_energy_exact_inf: exact_e
    };
}

pub fn tfim_mpo_bond_dim() -> Int {
    // Pure TFIM (J and hx) requires exactly 3x3 MPO matrices
    return 3;
}
