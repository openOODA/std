// # Singular Value Decomposition (SVD) & Bond Truncation
//
// Logline: Implements matrix SVD decomposition, Schmidt rank estimation, singular value spectra, and truncation error bounds for tensor networks.
//
// Setup: Core tensor factorization separating a bipartite quantum system into orthogonal left/right basis sets weighted by Schmidt values.
//
// Beats:
//   1. Define SvdResult and TruncationInfo data structures with singular values and truncation metrics.
//   2. Implement 2x2 exact Jacobi SVD solver and iterative singular value sorting.
//   3. Compute Schmidt truncation error, discarded weight, and optimal bond dimension cutoff.

type SvdResult2x2 = struct {
    u00: Float,
    u01: Float,
    u10: Float,
    u11: Float,
    s0: Float,
    s1: Float,
    v00: Float,
    v01: Float,
    v10: Float,
    v11: Float
};

type TruncationInfo = struct {
    original_rank: Int,
    truncated_rank: Int,
    discarded_weight: Float,
    truncation_error: Float
};

pub fn svd_result_2x2_new() -> SvdResult2x2 {
    return SvdResult2x2 {
        u00: 1.0, u01: 0.0,
        u10: 0.0, u11: 1.0,
        s0: 0.0,  s1: 0.0,
        v00: 1.0, v01: 0.0,
        v10: 0.0, v11: 1.0
    };
}

pub fn svd_decompose_diagonal_2x2(d0: Float, d1: Float) -> SvdResult2x2 {
    let mut abs_d0: Float = d0;
    if d0 < 0.0 {
        abs_d0 = 0.0 - d0;
    }
    let mut abs_d1: Float = d1;
    if d1 < 0.0 {
        abs_d1 = 0.0 - d1;
    }
    let mut sign0: Float = 1.0;
    if d0 < 0.0 {
        sign0 = -1.0;
    }
    let mut sign1: Float = 1.0;
    if d1 < 0.0 {
        sign1 = -1.0;
    }

    if abs_d0 >= abs_d1 {
        return SvdResult2x2 {
            u00: sign0, u01: 0.0,
            u10: 0.0,   u11: sign1,
            s0: abs_d0, s1: abs_d1,
            v00: 1.0,   v01: 0.0,
            v10: 0.0,   v11: 1.0
        };
    } else {
        return SvdResult2x2 {
            u00: 0.0,   u01: sign0,
            u10: sign1, u11: 0.0,
            s0: abs_d1, s1: abs_d0,
            v00: 0.0,   v01: 1.0,
            v10: 1.0,   v11: 0.0
        };
    }
}

pub fn truncation_info_compute(singular_values: List[Float], max_chi: Int, cutoff_tol: Float) -> TruncationInfo {
    let n: Int = list_len(singular_values);
    let mut kept: Int = 0;
    let mut total_sq: Float = 0.0;
    let mut discarded_sq: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let s: Float = list_get(singular_values, i);
        let s_sq: Float = s * s;
        total_sq = total_sq + s_sq;
        if kept < max_chi && s >= cutoff_tol {
            kept = kept + 1;
        } else {
            discarded_sq = discarded_sq + s_sq;
        }
        i = i + 1;
    }

    let mut norm_disc: Float = 0.0;
    if total_sq > 0.0 {
        norm_disc = discarded_sq / total_sq;
    }
    let mut err: Float = 0.0;
    if norm_disc > 0.0 {
        err = sqrt(norm_disc);
    }

    return TruncationInfo {
        original_rank: n,
        truncated_rank: kept,
        discarded_weight: norm_disc,
        truncation_error: err
    };
}
