// # Unified Advanced Physics, CFD, Aerodynamics & Ragdoll Facade
//
// Logline: Master facade re-exporting all 49 advanced computational physics, aerodynamics, continuum mechanics, acoustics, and orbital submodules.
//
// Setup: Pure module shim and unified API importing all companion submodules in physics_advanced.
//
// Beats:
//   1. Import 49 modular CFD, LBM, Aerodynamics, Compressible Gas Dynamics, Soft Body FEM, Ragdoll, Acoustics, and Orbital submodules.
//   2. Re-export public simulation configurations, factory constructors, and physical solver shims.
//   3. Maintain full backwards compatibility and uniform type access for openOODA physics applications.

import "fluid/anchor.oo";
import "aero/anchor.oo";
import "thermo/anchor.oo";
import "rigid/anchor.oo";
import "soft/anchor.oo";
import "ragdoll/anchor.oo";
import "collision/anchor.oo";
import "orbital/anchor.oo";
import "acoustic/anchor.oo";
import "integrators/anchor.oo";
import "foundation/anchor.oo";
import "physics_advanced_stubs.oo";

// -------------------------------------------------------------------
// Unified Physics Advanced Config
// -------------------------------------------------------------------

type AdvancedPhysicsWorld = struct {
    fluid_kinematic_viscosity: Float,
    fluid_density: Float,
    speed_of_sound: Float,
    air_gamma: Float,
    gravity_y: Float
};

pub fn advanced_physics_world_default() -> AdvancedPhysicsWorld {
    return AdvancedPhysicsWorld {
        fluid_kinematic_viscosity: 0.000015, // Air at 20 C (m^2/s)
        fluid_density: 1.204,                // Air at 20 C (kg/m^3)
        speed_of_sound: 343.2,               // m/s
        air_gamma: 1.4,                      // Ideal diatomic gas
        gravity_y: -9.80665
    };
}

// -------------------------------------------------------------------
// Facade Convenience Shims
// -------------------------------------------------------------------

pub fn cfd_create_mac_grid(nx: Int, ny: Int, dx: Float, dy: Float) -> MacGrid2D {
    return mac_grid_2d_new(nx, ny, dx, dy);
}

pub fn aero_create_naca4(m: Float, p: Float, t: Float, chord: Float) -> Naca4Params {
    return naca4_params_new(m, p, t, chord);
}

pub fn softbody_create_spring(rest_len: Float, k: Float, c: Float) -> ViscoelasticSpring {
    return viscoelastic_spring_new(rest_len, k, c);
}

pub fn ragdoll_create_ball_socket(ax: Float, ay: Float, az: Float, bx: Float, by: Float, bz: Float) -> BallSocketJoint {
    return ball_socket_joint_new(ax, ay, az, bx, by, bz);
}

pub fn acoustics_create_medium_air() -> AcousticMedium {
    return acoustic_medium_air();
}

pub fn orbital_create_cr3bp_earth_moon() -> Cr3bpSystem {
    return cr3bp_earth_moon();
}
