// # Universal Physical Constants
//
// Logline: Exact and recommended fundamental physical constants derived from the 2019 SI redefinition and NIST CODATA.
//
// Setup: Pure float expressions representing universal constants in SI base units (m, kg, s, A, K, mol, cd).
//
// Beats:
//   1. Speed of light, Planck constant, and reduced Planck constant.
//   2. Gravitational constant and standard gravity.
//   3. Elementary charge, electron mass, and proton mass.
//   4. Boltzmann constant, Avogadro constant, and universal gas constant.
//   5. Vacuum permittivity, vacuum permeability, and Stefan-Boltzmann constant.

pub fn phys_speed_of_light() -> Float {
    return 299792458.0;
}

pub fn phys_planck_constant() -> Float {
    return 0.000000000000000000000000000000000662607015;
}

pub fn phys_planck_reduced() -> Float {
    return 0.0000000000000000000000000000000001054571817;
}

pub fn phys_gravitational_constant() -> Float {
    return 0.000000000066743;
}

pub fn phys_standard_gravity() -> Float {
    return 9.80665;
}

pub fn phys_elementary_charge() -> Float {
    return 0.0000000000000000001602176634;
}

pub fn phys_electron_mass() -> Float {
    return 0.00000000000000000000000000000091093837;
}

pub fn phys_proton_mass() -> Float {
    return 0.00000000000000000000000000167262192;
}

pub fn phys_boltzmann_constant() -> Float {
    return 0.00000000000000000000001380649;
}

pub fn phys_avogadro_constant() -> Float {
    return 602214076000000000000000.0;
}

pub fn phys_gas_constant() -> Float {
    return 8.314462618;
}

pub fn phys_stefan_boltzmann() -> Float {
    return 0.00000005670374419;
}
