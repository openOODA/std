// # Explicit & Semi-Implicit Symplectic Euler Integrators
//
// Logline: Implements forward explicit and semi-implicit Euler integration schemes for dynamic kinematics and energy preservation.
//
// Setup: First-order numerical integration schemes for 2D and 3D physical states.
//
// Beats:
//   1. Define 2D and 3D kinematic state records with mass and inverse mass properties.
//   2. Implement standard explicit forward Euler integration for baseline comparisons.
//   3. Implement symplectic semi-implicit Euler and backward damped step integrations.

type EulerState2D = struct {
    x: Float,
    y: Float,
    vx: Float,
    vy: Float,
    ax: Float,
    ay: Float,
    mass: Float,
    inv_mass: Float
};

type EulerState3D = struct {
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    ax: Float,
    ay: Float,
    az: Float,
    mass: Float,
    inv_mass: Float
};

type EulerConfig = struct {
    dt: Float,
    linear_damping: Float,
    max_velocity: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn euler_state2d_new(x: Float, y: Float, mass: Float) -> EulerState2D {
    let mut inv_m: Float = 0.0;
    if mass > 0.000001 {
        inv_m = 1.0 / mass;
    }
    return EulerState2D {
        x: x,
        y: y,
        vx: 0.0,
        vy: 0.0,
        ax: 0.0,
        ay: 0.0,
        mass: mass,
        inv_mass: inv_m
    };
}

pub fn euler_state3d_new(x: Float, y: Float, z: Float, mass: Float) -> EulerState3D {
    let mut inv_m: Float = 0.0;
    if mass > 0.000001 {
        inv_m = 1.0 / mass;
    }
    return EulerState3D {
        x: x,
        y: y,
        z: z,
        vx: 0.0,
        vy: 0.0,
        vz: 0.0,
        ax: 0.0,
        ay: 0.0,
        az: 0.0,
        mass: mass,
        inv_mass: inv_m
    };
}

pub fn euler_config_default() -> EulerConfig {
    return EulerConfig {
        dt: 0.0166667,
        linear_damping: 0.999,
        max_velocity: 1000.0
    };
}

// -------------------------------------------------------------------
// 2D Euler Integration Schemes
// -------------------------------------------------------------------

/// Explicit Forward Euler (x += v*dt, then v += a*dt)
pub fn euler_explicit_step_2d(state: EulerState2D, dt: Float) -> EulerState2D {
    let nx: Float = state.x + (state.vx * dt);
    let ny: Float = state.y + (state.vy * dt);
    let nvx: Float = state.vx + (state.ax * dt);
    let nvy: Float = state.vy + (state.ay * dt);

    return EulerState2D {
        x: nx,
        y: ny,
        vx: nvx,
        vy: nvy,
        ax: 0.0,
        ay: 0.0,
        mass: state.mass,
        inv_mass: state.inv_mass
    };
}

/// Semi-Implicit Symplectic Euler (v += a*dt, then x += v*dt)
pub fn euler_semi_implicit_step_2d(
    state: EulerState2D,
    dt: Float,
    damping: Float
) -> EulerState2D {
    let nvx: Float = (state.vx + (state.ax * dt)) * damping;
    let nvy: Float = (state.vy + (state.ay * dt)) * damping;
    let nx: Float = state.x + (nvx * dt);
    let ny: Float = state.y + (nvy * dt);

    return EulerState2D {
        x: nx,
        y: ny,
        vx: nvx,
        vy: nvy,
        ax: 0.0,
        ay: 0.0,
        mass: state.mass,
        inv_mass: state.inv_mass
    };
}

// -------------------------------------------------------------------
// 3D Euler Integration Schemes
// -------------------------------------------------------------------

/// Explicit Forward Euler 3D
pub fn euler_explicit_step_3d(state: EulerState3D, dt: Float) -> EulerState3D {
    let nx: Float = state.x + (state.vx * dt);
    let ny: Float = state.y + (state.vy * dt);
    let nz: Float = state.z + (state.vz * dt);
    let nvx: Float = state.vx + (state.ax * dt);
    let nvy: Float = state.vy + (state.ay * dt);
    let nvz: Float = state.vz + (state.az * dt);

    return EulerState3D {
        x: nx,
        y: ny,
        z: nz,
        vx: nvx,
        vy: nvy,
        vz: nvz,
        ax: 0.0,
        ay: 0.0,
        az: 0.0,
        mass: state.mass,
        inv_mass: state.inv_mass
    };
}

/// Semi-Implicit Symplectic Euler 3D
pub fn euler_semi_implicit_step_3d(
    state: EulerState3D,
    dt: Float,
    damping: Float
) -> EulerState3D {
    let nvx: Float = (state.vx + (state.ax * dt)) * damping;
    let nvy: Float = (state.vy + (state.ay * dt)) * damping;
    let nvz: Float = (state.vz + (state.az * dt)) * damping;
    let nx: Float = state.x + (nvx * dt);
    let ny: Float = state.y + (nvy * dt);
    let nz: Float = state.z + (nvz * dt);

    return EulerState3D {
        x: nx,
        y: ny,
        z: nz,
        vx: nvx,
        vy: nvy,
        vz: nvz,
        ax: 0.0,
        ay: 0.0,
        az: 0.0,
        mass: state.mass,
        inv_mass: state.inv_mass
    };
}

/// Damped Backward Step with velocity clamping
pub fn euler_backward_damped_step_3d(
    state: EulerState3D,
    cfg: EulerConfig
) -> EulerState3D {
    let dt: Float = cfg.dt;
    let damp: Float = cfg.linear_damping;
    let max_v: Float = cfg.max_velocity;

    let mut nvx: Float = (state.vx + (state.ax * dt)) * damp;
    let mut nvy: Float = (state.vy + (state.ay * dt)) * damp;
    let mut nvz: Float = (state.vz + (state.az * dt)) * damp;

    // Velocity clamp
    let speed_sq: Float = (nvx * nvx) + (nvy * nvy) + (nvz * nvz);
    if speed_sq > (max_v * max_v) && speed_sq > 0.000001 {
        let factor: Float = max_v / sqrt(speed_sq);
        nvx = nvx * factor;
        nvy = nvy * factor;
        nvz = nvz * factor;
    }

    let nx: Float = state.x + (nvx * dt);
    let ny: Float = state.y + (nvy * dt);
    let nz: Float = state.z + (nvz * dt);

    return EulerState3D {
        x: nx,
        y: ny,
        z: nz,
        vx: nvx,
        vy: nvy,
        vz: nvz,
        ax: 0.0,
        ay: 0.0,
        az: 0.0,
        mass: state.mass,
        inv_mass: state.inv_mass
    };
}
