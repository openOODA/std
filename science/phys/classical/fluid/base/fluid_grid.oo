// # Eulerian Fluid Grid & Navier-Stokes Cells
//
// Logline: Implements Eulerian staggered grid representations, pressure Poisson solvers, and advection-diffusion.
//
// Setup: Imports fluid_domain.oo for spatial domain boundaries and Vec3 fields.
//
// Beats:
//   1. Construct 3D Eulerian fluid cells and uniform voxel velocity grids.
//   2. Compute finite difference velocity divergence and spatial pressure gradients.
//   3. Execute Gauss-Seidel pressure Poisson relaxation and mass-conserving projection steps.

import "./fluid_domain.oo";

type FluidCell = struct {
    vel: Vec3,
    pressure: Float,
    density: Float,
    temperature: Float,
    divergence: Float,
    is_obstacle: Int,
    active: Int
};

/// Construct a default fluid cell.
pub fn fluid_cell_new() -> FluidCell {
    return FluidCell {
        vel: vec3_zero(),
        pressure: 0.0,
        density: 0.0,
        temperature: 293.15,
        divergence: 0.0,
        is_obstacle: 0,
        active: 1
    };
}

/// Set obstacle status for cell (1 = solid obstacle, 0 = fluid cell).
pub fn fluid_cell_set_obstacle(cell: &mut FluidCell, obstacle: Int) {
    cell.is_obstacle = obstacle;
    if obstacle != 0 {
        cell.vel = vec3_zero();
    }
}

/// Set velocity of a fluid cell.
pub fn fluid_cell_set_velocity(cell: &mut FluidCell, vel: Vec3) {
    if (cell.is_obstacle) == 0 {
        cell.vel = vel;
    }
}

/// Set scalar density of a fluid cell.
pub fn fluid_cell_set_density(cell: &mut FluidCell, density: Float) {
    cell.density = density;
}

/// Set cell temperature.
pub fn fluid_cell_set_temperature(cell: &mut FluidCell, temp: Float) {
    cell.temperature = temp;
}

type FluidGrid = struct {
    dim_x: Int,
    dim_y: Int,
    dim_z: Int,
    dx: Float,
    ambient_temp: Float,
    gravity: Vec3,
    viscosity: Float
};

/// Construct grid configuration properties.
pub fn fluid_grid_new(dim_x: Int, dim_y: Int, dim_z: Int, dx: Float) -> FluidGrid {
    return FluidGrid {
        dim_x: dim_x,
        dim_y: dim_y,
        dim_z: dim_z,
        dx: dx,
        ambient_temp: 293.15,
        gravity: Vec3 { x: 0.0, y: 0.0 - 9.81, z: 0.0 },
        viscosity: 0.001
    };
}

/// Compute 3D central difference velocity divergence:
/// div = ((u_right - u_left) + (v_top - v_bottom) + (w_front - w_back)) / (2 * dx).
pub fn fluid_grid_compute_divergence(c_left: FluidCell, c_right: FluidCell, c_bottom: FluidCell, c_top: FluidCell, c_back: FluidCell, c_front: FluidCell, dx: Float) -> Float {
    let du: Float = ((c_right.vel).x) - ((c_left.vel).x);
    let dv: Float = ((c_top.vel).y) - ((c_bottom.vel).y);
    let dw: Float = ((c_front.vel).z) - ((c_back.vel).z);
    let sum: Float = ((du) + (dv)) + (dw);
    return (sum) / (2.0 * (dx));
}

/// Execute one Jacobi iteration relaxation step for Poisson pressure equation:
/// p_new = (p_left + p_right + p_bottom + p_top + p_back + p_front - div) / 6.0.
pub fn fluid_grid_pressure_jacobi_step(p_center: Float, p_left: Float, p_right: Float, p_bottom: Float, p_top: Float, p_back: Float, p_front: Float, div: Float) -> Float {
    let neighbor_sum: Float = (((((p_left) + (p_right)) + (p_bottom)) + (p_top)) + (p_back)) + (p_front);
    return ((neighbor_sum) - (div)) / 6.0;
}

/// Apply pressure gradient projection to velocity field:
/// u_new = u - (dt / (density * 2 * dx)) * grad(P).
pub fn fluid_grid_apply_pressure_gradient(c: &mut FluidCell, p_left: Float, p_right: Float, p_bottom: Float, p_top: Float, p_back: Float, p_front: Float, dx: Float, dt: Float, density: Float) {
    if (c.is_obstacle) != 0 {
        return;
    }
    let rho: Float = density;
    if (rho) < 0.000001 {
        return;
    }
    let coeff: Float = (dt) / ((rho) * (2.0 * (dx)));

    let grad_px: Float = (p_right) - (p_left);
    let grad_py: Float = (p_top) - (p_bottom);
    let grad_pz: Float = (p_front) - (p_back);

    let new_vx: Float = ((c.vel).x) - ((coeff) * (grad_px));
    let new_vy: Float = ((c.vel).y) - ((coeff) * (grad_py));
    let new_vz: Float = ((c.vel).z) - ((coeff) * (grad_pz));

    c.vel = Vec3 { x: new_vx, y: new_vy, z: new_vz };
}

/// Semi-Lagrangian advection step for scalar quantity (density / temperature).
pub fn fluid_grid_advect_scalar(val_center: Float, val_prev: Float, vel: Vec3, dx: Float, dt: Float) -> Float {
    let speed: Float = vec3_length(vel);
    let alpha: Float = ((speed) * (dt)) / (dx);
    let mut weight: Float = alpha;
    if (weight) > 1.0 { weight = 1.0; }
    if (weight) < 0.0 { weight = 0.0; }
    return (((1.0 - (weight)) * (val_center))) + (((weight) * (val_prev)));
}

/// 3D Laplace diffusion step for scalar quantities (heat / viscosity diffusion):
/// val_new = val_center + diff_coeff * (dt / dx^2) * sum(val_neighbor - val_center).
pub fn fluid_grid_diffuse_scalar(val_center: Float, val_left: Float, val_right: Float, val_bottom: Float, val_top: Float, val_back: Float, val_front: Float, diff_coeff: Float, dt: Float, dx: Float) -> Float {
    let dx2: Float = (dx) * (dx);
    if (dx2) < 0.000001 {
        return val_center;
    }
    let lap: Float = (((((((val_left) + (val_right)) + (val_bottom)) + (val_top)) + (val_back)) + (val_front)) - (6.0 * (val_center)));
    let delta: Float = (((diff_coeff) * (dt)) / (dx2)) * (lap);
    return (val_center) + (delta);
}
