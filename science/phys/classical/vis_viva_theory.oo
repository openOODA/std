// # Vis-viva orbital velocity theory
//
// Logline: v^2 = GM(2/r - 1/a) for a single body. Two-body reduced form uses m1+m2.
//
// Setup: Imports std/principles/constants.oo for G. Pure Float. r<=0 or a<=0 returns Err.
//
// Beats:
//   1. Closed form v = sqrt(GM(2/r - 1/a)).
//   2. Coupled form v_rel^2 = G(m1+m2)(2/r - 1/a) for two-body reduced mass.
//   3. Theory DomainCert holds when input is physical.

import "std/core/principles/physical_constants.oo";
import "std/core/primitives/domain_cert.oo";
import "std/core/math/constants.oo";
fn circ_pi_std_phys_mechanics_vis_viva_theory() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }

fn vv_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

// Closed-form vis-viva: v = sqrt(GM(2/r - 1/a)) in m/s.
pub fn vis_viva_closed(M: Float, r: Float, a: Float) -> Result[Float, String] {
    if M <= 0.0 { return Err("ERR\tvisviva\tm"); }
    if r <= 0.0 { return Err("ERR\tvisviva\tr"); }
    if a <= 0.0 { return Err("ERR\tvisviva\ta"); }
    let pc: PhysicalConstants = constants_codata_2022();
    let g: Float = pc.gravitational_constant;
    let term: Float = (2.0 / r) - (1.0 / a);
    if term < 0.0 { return Err("ERR\tvisviva\tterm"); }
    return Ok(sqrt(g * M * term));
}

// Two-body reduced-mass vis-viva: v_rel^2 = G(m1+m2)(2/r - 1/a).
pub fn vis_viva_two_body(m1: Float, m2: Float, r: Float, a: Float) -> Result[Float, String] {
    if m1 <= 0.0 { return Err("ERR\tvisviva\tm"); }
    if m2 <= 0.0 { return Err("ERR\tvisviva\tm"); }
    if r <= 0.0 { return Err("ERR\tvisviva\tr"); }
    if a <= 0.0 { return Err("ERR\tvisviva\ta"); }
    let pc: PhysicalConstants = constants_codata_2022();
    let g: Float = pc.gravitational_constant;
    let m_total: Float = m1 + m2;
    let term: Float = (2.0 / r) - (1.0 / a);
    if term < 0.0 { return Err("ERR\tvisviva\tterm"); }
    return Ok(sqrt(g * m_total * term));
}

// Eccentricity check: returns 1 when orbit is bound (e < 1), 0 when unbound (e >= 1).
pub fn vis_viva_is_bound(eccentricity: Float) -> Int {
    if eccentricity < 1.0 { return 1; }
    return 0;
}

// DomainCert for the vis-viva theory. holds=1 when M>0, r>0, a>0, e<1.
pub fn phys_vis_viva_theory(M: Float, r: Float, a: Float, e: Float) -> DomainCert {
    let mut h: Int = 0;
    if vis_viva_is_bound(e) == 1 {
        if vis_viva_closed(M, r, a).is_ok() {
            h = 1;
        }
    }
    return domain_cert("phys", "vis_viva", h);
}

// Verify: golden Earth circular, hostile (r<=0, a<=0, e>=1), coupled with Kepler.
pub fn verify_vis_viva_theory() -> Bool {
    let m_earth: Float = 5972000000000000000000000.0;
    let r_earth: Float = 6371000.0;
    let v_circ: Float = vv_got(vis_viva_closed(m_earth, r_earth, r_earth));
    let target: Float = 7905.0;
    let mut d: Float = v_circ - target;
    if d < 0.0 { d = 0.0 - d; }
    let bound: Float = target * 0.005;
    if d > bound { return false; }
    if vis_viva_closed(m_earth, 0.0, r_earth).is_ok() { return false; }
    if vis_viva_closed(m_earth, r_earth, 0.0).is_ok() { return false; }
    if vis_viva_is_bound(1.0) != 0 { return false; }
    if vis_viva_is_bound(1.5) != 0 { return false; }
    let pc: PhysicalConstants = constants_codata_2022();
    let g: Float = pc.gravitational_constant;
    let m_sun: Float = 1989000000000000000000000000000.0;
    let a_earth: Float = 149600000000.0;
    let pi: Float = circ_pi_std_phys_mechanics_vis_viva_theory();
    let gm_sun: Float = g * m_sun;
    let a3: Float = a_earth * a_earth * a_earth;
    let t: Float = 2.0 * pi * sqrt(a3 / gm_sun);
    let v_coupled: Float = vv_got(vis_viva_closed(m_sun, a_earth, a_earth));
    let expected_v: Float = sqrt(g * m_sun / a_earth);
    let mut dv: Float = v_coupled - expected_v;
    if dv < 0.0 { dv = 0.0 - dv; }
    if dv > 0.001 { return false; }
    let v_from_t: Float = (2.0 * pi * a_earth) / t;
    let mut dvt: Float = v_coupled - v_from_t;
    if dvt < 0.0 { dvt = 0.0 - dvt; }
    let dvt_pct: Float = (dvt * 100.0) / v_coupled;
    if dvt_pct > 0.1 { return false; }
    return true;
}
