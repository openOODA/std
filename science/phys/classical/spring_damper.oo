// # Damped Harmonic Oscillator & Spring-Damper System
//
// Logline: Calculates Hooke's elastic restoring forces, viscous damping, critical damping ratios, and shock absorber kinetics.
//
// Setup: 1D and 3D linear and non-linear spring-damper dynamics with critical damping and analytical stepping.
//
// Beats:
//   1. Define SpringDamper and SpringDamper3D force generator structures.
//   2. Evaluate 1D and 3D Hookean elastic restoring and velocity-dependent damping forces.
//   3. Compute critical damping coefficients and analytical decay step solutions.

type SpringDamper1D = struct {
    stiffness: Float,
    damping: Float,
    rest_length: Float
};

type SpringDamper3D = struct {
    stiffness: Float,
    damping: Float,
    rest_length: Float,
    anchor_a_x: Float,
    anchor_a_y: Float,
    anchor_a_z: Float,
    anchor_b_x: Float,
    anchor_b_y: Float,
    anchor_b_z: Float
};

type SpringForce3D = struct {
    fa_x: Float,
    fa_y: Float,
    fa_z: Float,
    fb_x: Float,
    fb_y: Float,
    fb_z: Float,
    current_length: Float,
    stretch: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn spring_damper_1d_new(k: Float, c: Float, rest_len: Float) -> SpringDamper1D {
    return SpringDamper1D {
        stiffness: k,
        damping: c,
        rest_length: rest_len
    };
}

pub fn spring_damper_3d_new(k: Float, c: Float, rest_len: Float) -> SpringDamper3D {
    return SpringDamper3D {
        stiffness: k,
        damping: c,
        rest_length: rest_len,
        anchor_a_x: 0.0,
        anchor_a_y: 0.0,
        anchor_a_z: 0.0,
        anchor_b_x: 0.0,
        anchor_b_y: 0.0,
        anchor_b_z: 0.0
    };
}

/// Critical damping coefficient: c_crit = 2 * sqrt(m * k)
pub fn spring_damper_critical_damping(mass: Float, stiffness: Float) -> Float {
    if mass <= 0.0 || stiffness <= 0.0 {
        return 0.0;
    }
    return 2.0 * sqrt(mass * stiffness);
}

// -------------------------------------------------------------------
// Force Computations
// -------------------------------------------------------------------

/// 1D Hookean Spring Force: F = -k * (x - rest_length) - c * v
pub fn spring_damper_compute_force_1d(
    spring: SpringDamper1D,
    current_length: Float,
    relative_velocity: Float
) -> Float {
    let delta: Float = current_length - spring.rest_length;
    let spring_force: Float = - (spring.stiffness * delta);
    let damp_force: Float = - (spring.damping * relative_velocity);
    return spring_force + damp_force;
}

/// 3D Spring-Damper Force applied between two world points with velocities
pub fn spring_damper_compute_force_3d(
    spring: SpringDamper3D,
    p1_x: Float, p1_y: Float, p1_z: Float,
    p2_x: Float, p2_y: Float, p2_z: Float,
    v1_x: Float, v1_y: Float, v1_z: Float,
    v2_x: Float, v2_y: Float, v2_z: Float
) -> SpringForce3D {
    let dx: Float = p2_x - p1_x;
    let dy: Float = p2_y - p1_y;
    let dz: Float = p2_z - p1_z;

    let len: Float = sqrt((dx * dx) + (dy * dy) + (dz * dz));
    if len < 0.000001 {
        return SpringForce3D {
            fa_x: 0.0, fa_y: 0.0, fa_z: 0.0,
            fb_x: 0.0, fb_y: 0.0, fb_z: 0.0,
            current_length: 0.0,
            stretch: 0.0
        };
    }

    let inv_len: Float = 1.0 / len;
    let dir_x: Float = dx * inv_len;
    let dir_y: Float = dy * inv_len;
    let dir_z: Float = dz * inv_len;

    // Hooke's displacement
    let delta: Float = len - spring.rest_length;
    let spring_mag: Float = spring.stiffness * delta;

    // Relative velocity along spring direction
    let r_vx: Float = v2_x - v1_x;
    let r_vy: Float = v2_y - v1_y;
    let r_vz: Float = v2_z - v1_z;
    let rel_v_proj: Float = (r_vx * dir_x) + (r_vy * dir_y) + (r_vz * dir_z);
    let damp_mag: Float = spring.damping * rel_v_proj;

    let total_force_mag: Float = spring_mag + damp_mag;

    // Force on body 1 is toward body 2; force on body 2 is opposite
    let f1_x: Float = total_force_mag * dir_x;
    let f1_y: Float = total_force_mag * dir_y;
    let f1_z: Float = total_force_mag * dir_z;

    let f2_x: Float = -f1_x;
    let f2_y: Float = -f1_y;
    let f2_z: Float = -f1_z;

    return SpringForce3D {
        fa_x: f1_x, fa_y: f1_y, fa_z: f1_z,
        fb_x: f2_x, fb_y: f2_y, fb_z: f2_z,
        current_length: len,
        stretch: delta
    };
}
