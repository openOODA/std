// # Collision Contact Manifolds & Narrowphase
//
// Logline: Generates contact manifold points, penetration depths, and normal vectors for capsule and OBB pairs.
//
// Setup: Imports collision_types.oo, collision_ops.oo, and collision_narrow.oo for geometric tests.
//
// Beats:
//   1. Evaluate closest points between line segments and capsule cylinders.
//   2. Compute oriented bounding box (OBB) separating axes and face-edge contact points.
//   3. Assemble multi-point contact manifolds with normal penetration depth vectors.

import "./collision_types.oo";
import "./collision_ops.oo";

// -------------------------------------------------------------------
// Capsule vs Sphere
// -------------------------------------------------------------------

pub fn capsule_intersects_sphere(cap: Capsule, s: Sphere) -> Int {
    let cp: Vec3 = closest_point_on_segment(s.centre, cap.a, cap.b);
    let r_sum: Float = cap.radius + s.radius;
    let d2: Float = vec3_length_sq(vec3_sub(s.centre, cp));
    if d2 <= (r_sum * r_sum) {
        return 1;
    }
    return 0;
}

pub fn capsule_collide_sphere(cap: Capsule, s: Sphere) -> ContactPoint {
    let cp: Vec3 = closest_point_on_segment(s.centre, cap.a, cap.b);
    let diff: Vec3 = vec3_sub(s.centre, cp);
    let dist: Float = vec3_length(diff);
    let r_sum: Float = cap.radius + s.radius;

    if dist > r_sum {
        return contact_point_none();
    }

    let norm: Vec3 = vec3_normalize(diff);
    let pen: Float = r_sum - dist;

    return ContactPoint {
        has_contact: 1,
        penetration: pen,
        point:       cp,
        normal:      norm
    };
}

// -------------------------------------------------------------------
// OBB vs Sphere
// -------------------------------------------------------------------

pub fn obb_intersects_sphere(obb: OBB, s: Sphere) -> Int {
    let rel_pos: Vec3 = vec3_sub(s.centre, obb.centre);
    let proj_x: Float = vec3_dot(rel_pos, obb.axis_x);
    let proj_y: Float = vec3_dot(rel_pos, obb.axis_y);
    let proj_z: Float = vec3_dot(rel_pos, obb.axis_z);

    let mut cx: Float = proj_x;
    if cx < (0.0 - (obb.extents).x) { cx = 0.0 - (obb.extents).x; }
    if cx > (obb.extents).x { cx = (obb.extents).x; }

    let mut cy: Float = proj_y;
    if cy < (0.0 - (obb.extents).y) { cy = 0.0 - (obb.extents).y; }
    if cy > (obb.extents).y { cy = (obb.extents).y; }

    let mut cz: Float = proj_z;
    if cz < (0.0 - (obb.extents).z) { cz = 0.0 - (obb.extents).z; }
    if cz > (obb.extents).z { cz = (obb.extents).z; }

    let dx: Float = proj_x - cx;
    let dy: Float = proj_y - cy;
    let dz: Float = proj_z - cz;
    let d2: Float = ((dx * dx) + (dy * dy)) + (dz * dz);

    if d2 <= (s.radius * s.radius) {
        return 1;
    }
    return 0;
}

pub fn collision_contacts_probe() -> Int {
    return 0;
}
