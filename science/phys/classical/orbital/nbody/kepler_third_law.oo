// # Kepler's third law
//
// Logline: T^2 = (4 pi^2 / G M) a^3 for one star, with binary reduced-mass form.
//
// Setup: Imports std/principles/constants.oo for G. Pure Float. a<=0 or M<=0 returns Err.
//
// Beats:
//   1. Ideal period T = 2 pi sqrt(a^3 / (G M)).
//   2. Binary period T = 2 pi sqrt(a^3 / (G (m1+m2))).
//   3. DomainCert holds when a>0 and M>0.

import "std/core/principles/physical_constants.oo";
import "std/core/primitives/domain_cert.oo";
import "std/core/math/constants.oo";
fn circ_pi_std_phys_mechanics_kepler_third_law() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }

fn kp_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

// Single-star orbital period T = 2 pi sqrt(a^3 / (G M)) in seconds.
pub fn kepler_period_single(a: Float, M: Float) -> Result[Float, String] {
    if a <= 0.0 { return Err("ERR\tkepler\ta"); }
    if M <= 0.0 { return Err("ERR\tkepler\tm"); }
    let pc: PhysicalConstants = constants_codata_2022();
    let g: Float = pc.gravitational_constant;
    let pi: Float = circ_pi_std_phys_mechanics_kepler_third_law();
    let a3: Float = a * a * a;
    let gm: Float = g * M;
    return Ok(2.0 * pi * sqrt(a3 / gm));
}

// Binary reduced-mass period T = 2 pi sqrt(a^3 / (G (m1+m2))).
pub fn kepler_period_binary(a: Float, m1: Float, m2: Float) -> Result[Float, String] {
    if a <= 0.0 { return Err("ERR\tkepler\ta"); }
    if m1 <= 0.0 { return Err("ERR\tkepler\tm"); }
    if m2 <= 0.0 { return Err("ERR\tkepler\tm"); }
    let pc: PhysicalConstants = constants_codata_2022();
    let g: Float = pc.gravitational_constant;
    let pi: Float = circ_pi_std_phys_mechanics_kepler_third_law();
    let m_total: Float = m1 + m2;
    let a3: Float = a * a * a;
    return Ok(2.0 * pi * sqrt(a3 / (g * m_total)));
}

// DomainCert holds=1 when a>0 and M>0.
pub fn phys_kepler_third_law(a: Float, M: Float) -> DomainCert {
    let mut h: Int = 0;
    let period: Float = kp_got(kepler_period_single(a, M));
    if period > 0.0 {
        h = 1;
    }
    return domain_cert("phys", "kepler_third", h);
}

// Verify: Earth year, hostile (a<=0, M<=0), coupled with vis-viva.
pub fn verify_kepler_third_law() -> Bool {
    let a_earth: Float = 149600000000.0;
    let m_sun: Float = 1989000000000000000000000000000.0;
    let t: Float = kp_got(kepler_period_single(a_earth, m_sun));
    let days: Float = t / 86400.0;
    let target: Float = 365.25;
    let mut d: Float = days - target;
    if d < 0.0 { d = 0.0 - d; }
    let bound: Float = target * 0.001;
    if d > bound { return false; }
    if kepler_period_single(0.0, m_sun).is_ok() { return false; }
    if kepler_period_single(a_earth, 0.0).is_ok() { return false; }
    if kepler_period_single(0.0 - 1.0, m_sun).is_ok() { return false; }
    if kepler_period_single(a_earth, 0.0 - 1.0).is_ok() { return false; }
    // Coupled: derive v from T, check against vis-viva.
    let v: Float = (2.0 * circ_pi_std_phys_mechanics_kepler_third_law() * a_earth) / t;
    let pc: PhysicalConstants = constants_codata_2022();
    let g: Float = pc.gravitational_constant;
    let v_vis: Float = sqrt((g * m_sun) / a_earth);
    let mut dv: Float = v - v_vis;
    if dv < 0.0 { dv = 0.0 - dv; }
    let dv_pct: Float = (dv * 100.0) / v_vis;
    if dv_pct > 0.1 { return false; }
    // Binary: Sun-Earth as two-body
    let m_earth: Float = 5972000000000000000000000.0;
    let t_bin: Float = kp_got(kepler_period_binary(a_earth, m_sun, m_earth));
    let mut db: Float = t - t_bin;
    if db < 0.0 { db = 0.0 - db; }
    let db_pct: Float = (db * 100.0) / t;
    if db_pct > 0.01 { return false; }
    return true;
}
