// # General Relativistic Perihelion Precession
//
// Logline: Calculates Einsteinian general relativistic perihelion advance for Mercury (43 arcsec/century) and exoplanetary systems.
//
// Setup: Pure Schwarzschild general relativity metric geodesic precession formulation (Einstein, 1915).
//
// Beats:
//   1. Mercury anomalous perihelion precession rate query in arcseconds per century (43 arcsec/century).
//   2. Calculate relativistic perihelion shift per revolution: Delta_phi = 6*pi*G*M / (c^2 * a * (1 - e^2)).
//   3. Convert advance per orbit to arcseconds per Earth century.
//   4. Evaluate strong-field periastron advance for binary pulsars (Hulse-Taylor PSR B1913+16).

import "std/core/math/constants.oo";
fn circ_pi_std_phys_astro_advanced_relativistic_precession() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }
pub fn mercury_precession_as() -> Int {
    return 43;
}

/// Computes general relativistic perihelion advance per orbital revolution in radians: Delta_phi = 6*pi*mu / (c^2 * a * (1 - e^2)).
pub fn relativistic_perihelion_advance_per_orbit(
    semi_major_axis_m: Float,
    eccentricity: Float,
    central_mass_kg: Float
) -> Float {
    let g: Float = 0.000000000066743;
    let c: Float = 299792458.0;
    let pi: Float = circ_pi_std_phys_astro_advanced_relativistic_precession();
    let mu: Float = g * central_mass_kg;
    let p: Float = semi_major_axis_m * (1.0 - (eccentricity * eccentricity));
    return (6.0 * pi * mu) / (c * c * p);
}
