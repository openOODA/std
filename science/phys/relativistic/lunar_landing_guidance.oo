// # Autonomous Lunar Landing Guidance & Powered Descent
//
// Logline: Calculates powered descent guidance trajectories, thrust vectoring, and touchdown state vectors for lunar landers.
//
// Setup: Pure optimal powered descent guidance (E-guidance / Apollo polynomial guidance) for planetary touchdown.
//
// Beats:
//   1. Nominal lunar landing delta-v budget integer query.
//   2. Landing state and waypoint structures.
//   3. Guidance acceleration command calculation for terminal descent.
//   4. Touchdown velocity and propellant consumption tracking.

type LandingWaypoint = struct {
    pos_x: Float,
    pos_y: Float,
    pos_z: Float,
    vel_x: Float,
    vel_y: Float,
    vel_z: Float,
    t_target_sec: Float
};

type LandingState = struct {
    px: Float,
    py: Float,
    pz: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    mass_kg: Float
};

pub fn lunar_land_dv() -> Int {
    return 2000;
}

pub fn landing_state_new(
    px: Float, py: Float, pz: Float,
    vx: Float, vy: Float, vz: Float,
    mass_kg: Float
) -> LandingState {
    return LandingState {
        px: px, py: py, pz: pz,
        vx: vx, vy: vy, vz: vz,
        mass_kg: mass_kg
    };
}

/// Computes commanded guidance acceleration vector (m/s^2) using Apollo polynomial powered descent guidance.
pub fn compute_powered_descent_accel(
    current: LandingState,
    target: LandingWaypoint,
    t_go_sec: Float
) -> Float {
    if t_go_sec <= 0.1 { return 0.0; }
    let t_go_sq: Float = t_go_sec * t_go_sec;
    let delta_r_z: Float = target.pos_z - current.pz;
    let term1: Float = (6.0 * delta_r_z) / t_go_sq;
    let term2: Float = (2.0 * target.vel_z + 4.0 * current.vz) / t_go_sec;
    let g_lunar: Float = 1.62; // m/s^2 lunar surface gravity
    return term1 - term2 + g_lunar;
}
