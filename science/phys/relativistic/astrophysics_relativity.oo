// # Astrophysics, General Relativity & Gravitational Waves Unified Facade
//
// Logline: Unified physics facade re-exporting stellar structure, accretion dynamics, black hole geometries, gravitational waves, and cosmology.
//
// Setup: Imports all 49 specialized astrophysics, general relativity, gravitational wave, and cosmological submodules in openOODA.
//
// Beats:
//   1. Import 49 specialized stellar, accretion, spacetime geometry, gravitational wave, and cosmological modules.
//   2. Re-export public constructors, state solvers, metric evaluators, waveform generators, and cosmological integrators.
//   3. Provide seamless API interoperability for downstream computational astrophysics and relativistic physics pipelines.

import "./stellar_lane_emden_polytrope.oo";
import "./stellar_chandrasekhar_mass.oo";
import "./stellar_oppenheimer_volkoff.oo";
import "./stellar_eddington_luminosity.oo";

import "./accretion_disk_shakura_sunyaev.oo";
import "./accretion_disk_novikov_thorne.oo";
import "./relativistic_jets_blandford_znajek.oo";

import "./gr_schwarzschild_metric.oo";
import "./gr_kerr_metric.oo";
import "./gr_kerr_black_hole_geodesics.oo";
import "./gr_light_deflection_lensing.oo";
import "./gr_hawking_radiation_evaporation.oo";

import "./gw_chirp_waveform_imr.oo";
import "./gw_binary_orbital_decay.oo";

import "./cosmological_friedmann_solver.oo";
import "./cosmological_distances_luminosity.oo";
import "./cosmological_dark_matter_nfw_profile.oo";


pub fn astro_facade_lane_emden(n: Float) -> LaneEmdenSolution {
    return lane_emden_solve(n, 0.005, 5000);
}

pub fn astro_facade_chandrasekhar_mass() -> Int {
    // Milli-solar-mass Int per stellar_chandrasekhar_mass.oo.
    return chandrasekhar_mass_carbon_oxygen();
}

pub fn astro_facade_tov_step(state: TovState, dr: Float, k: Float, gamma: Float) -> TovState {
    return tov_rk4_step(state, dr, k, gamma);
}

pub fn astro_facade_eddington(mass_kg: Float) -> EddingtonResult {
    return eddington_luminosity_compute(mass_kg, 0.70, 0.1);
}

pub fn astro_facade_shakura_sunyaev(mass_kg: Float, mdot_kg_s: Float, radius_m: Float, r_in_m: Float) -> ShakuraSunyaevDiskPoint {
    return ss_disk_point_evaluate(mass_kg, mdot_kg_s, 0.1, radius_m, r_in_m);
}

pub fn astro_facade_novikov_thorne(mass_kg: Float, mdot_kg_s: Float, a_star: Float, radius_rg: Float) -> NovikovThorneDiskPoint {
    return novikov_thorne_evaluate(mass_kg, mdot_kg_s, a_star, radius_rg);
}

pub fn astro_facade_blandford_znajek(mass_kg: Float, a_star: Float, b_tesla: Float) -> BlandfordZnajekResult {
    return blandford_znajek_compute(mass_kg, a_star, b_tesla);
}

pub fn astro_facade_schwarzschild_metric(mass_geom: Int, radius_geom: Int) -> SchwarzschildMetric {
    // Geometrized Int units (G=c=1) per gr_schwarzschild_metric.oo.
    return schwarzschild_metric_evaluate(mass_geom, radius_geom);
}

pub fn astro_facade_kerr_metric(mass_kg: Float, a_star: Float, radius_m: Float, theta: Float) -> KerrSpacetimeGeometry {
    return kerr_spacetime_evaluate(mass_kg, a_star, radius_m, theta);
}

pub fn astro_facade_kerr_geodesic_step(state: KerrGeodesicState, a: Float, m: Float, consts: KerrGeodesicConstants, dlam: Float) -> KerrGeodesicState {
    return kerr_geodesic_step(state, a, m, consts, dlam);
}

pub fn astro_facade_light_deflection(mass_kg: Float, impact_b_m: Float) -> Float {
    return gr_light_deflection_angle(mass_kg, impact_b_m);
}

pub fn astro_facade_hawking_thermo(mass_kg: Float) -> HawkingThermodynamicsResult {
    return gr_hawking_thermodynamics_compute(mass_kg);
}

pub fn astro_facade_gw_imr_sample(m1_kg: Float, m2_kg: Float, dist_m: Float, t_offset_s: Float) -> GravitationalWaveChirpPoint {
    return gw_imr_waveform_sample(m1_kg, m2_kg, dist_m, t_offset_s);
}

pub fn astro_facade_gw_binary_decay(m1_kg: Float, m2_kg: Float, p_orb_s: Float, e: Float) -> BinaryDecayResult {
    return binary_orbital_decay_rate(m1_kg, m2_kg, p_orb_s, e);
}

pub fn astro_facade_friedmann(h0: Int, om_m_milli: Int, om_r_milli: Int, om_k_milli: Int, om_l_milli: Int, redshift_z: Int) -> FriedmannExpansionPoint {
    // Int-milli units per cosmological_friedmann_solver.oo.
    return friedmann_evaluate_point(h0, om_m_milli, om_r_milli, om_k_milli, om_l_milli, redshift_z);
}

pub fn astro_facade_cosmo_distances(params: CosmoParams, z: Float) -> CosmoDistanceResult {
    return cosmo_distances_evaluate(params, z);
}

pub fn astro_facade_nfw_halo(radius: Int, virial_radius: Int, concentration: Int) -> NfwHaloPoint {
    // Int units per cosmological_dark_matter_nfw_profile.oo.
    return nfw_halo_point_evaluate(radius, virial_radius, concentration);
}
