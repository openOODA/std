// # Hawking temperature law — strict (0.001% precision)
//
// Logline: T_H = hbar c^3 / (8 pi G M k_B). For M = M_sun (IAU 2015, 1.98892e30 kg), T_H = 6.1686778e-8 K to 0.001% precision, computed from CODATA 2022 hbar, c, G, k_B. Equivalent form T_H = hbar c / (4 pi k_B r_s) agrees within 1e-7 relative.
//
// Setup: Pure Float. M > 0 in kg. M <= 0 fails closed. This is a NEW file (strict) created because the pre-existing std/phys/hawking_temperature_law.oo uses a 0.5% tolerance (b_sun = want_sun * 0.005) due to a rounding mismatch; the strict version uses the exact formula result and tightens to 0.001%.
//
// RULES.oot 1.7: Under 256 lines; pure Float; uses * and -; no abs_f, close, or pow.
//
// Beats:
//   1. Hawking T_H(M) = hbar * c^3 / (8 * pi * G * M * k_B).
//   2. Schwarzschild radius r_s(M) = 2 * G * M / c^2.
//   3. Equivalent form T_H = hbar * c / (4 * pi * k_B * r_s) agrees numerically.
//   4. Golden: M = M_sun (IAU 2015) -> T_H = 6.1686778e-8 K within 0.001% (1e-5 relative).
//   5. Golden: M = 2e30 kg -> T_H = 6.1345033e-8 K within 0.001%.
//   6. Golden: M = 1e30 kg -> T_H = 1.2269007e-7 K within 0.001%.
//   7. Hostile: M <= 0 -> Err.
//   8. Coupled: equivalent form T_H = hbar c / (4 pi k_B r_s) agrees within 1e-7 relative.
//
// References:
//   - Hawking 1974, Nature 248, 30 ("Black hole explosions?").
//   - Hawking 1975, Commun. Math. Phys. 43, 199.
//   - Wall 2010, Int. J. Mod. Phys. D 19, 2133 (arXiv:1010.5513).
//   - CODATA 2022: hbar = 1.054571817e-34, c = 2.99792458e8, G = 6.67430e-11, k_B = 1.380649e-23.
//   - IAU 2015 Resolution B3: M_sun = 1.98892e30 kg (defining constant).

import "std/core/principles/physical_constants.oo";
import "std/core/primitives/domain_cert.oo";
import "std/core/math/constants.oo";

fn circ_pi_strict_ht() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }

fn hts_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn hts_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

// Hawking temperature T_H = hbar * c^3 / (8 * pi * G * M * k_B) in Kelvin.
// M <= 0 returns Err.
pub fn hts_temperature(M: Float) -> Result[Float, String] {
    if M <= 0.0 { return Err("ERR\thk\tm"); }
    let pc: PhysicalConstants = constants_codata_2022();
    let hbar: Float = pc.planck_reduced;
    let c_val: Float = pc.speed_of_light;
    let g: Float = pc.gravitational_constant;
    let k_b: Float = pc.boltzmann_constant;
    let pi_val: Float = circ_pi_strict_ht();
    let c2: Float = c_val * c_val;
    let c3: Float = c2 * c_val;
    let num: Float = hbar * c3;
    let den: Float = 8.0 * pi_val * g * M * k_b;
    return Ok(num / den);
}

// Schwarzschild radius r_s = 2 * G * M / c^2 in meters. M <= 0 returns Err.
pub fn hts_schwarzschild_radius(M: Float) -> Result[Float, String] {
    if M <= 0.0 { return Err("ERR\thk\tm"); }
    let pc: PhysicalConstants = constants_codata_2022();
    let g: Float = pc.gravitational_constant;
    let c_val: Float = pc.speed_of_light;
    let c2: Float = c_val * c_val;
    return Ok((2.0 * g * M) / c2);
}

// Equivalent form T_H = hbar * c / (4 * pi * k_B * r_s).
pub fn hts_temperature_from_radius(r_s: Float) -> Result[Float, String] {
    if r_s <= 0.0 { return Err("ERR\thk\trs"); }
    let pc: PhysicalConstants = constants_codata_2022();
    let hbar: Float = pc.planck_reduced;
    let c_val: Float = pc.speed_of_light;
    let k_b: Float = pc.boltzmann_constant;
    let pi_val: Float = circ_pi_strict_ht();
    return Ok((hbar * c_val) / (4.0 * pi_val * k_b * r_s));
}

// 0.001% relative comparison: |actual - expected| <= 1e-5 * |expected|.
// Returns 1 if within tolerance, 0 if not.
pub fn hts_close_0p001(actual: Float, expected: Float) -> Int {
    let d: Float = hts_abs(actual - expected);
    let b: Float = expected * 0.00001;
    if d <= b { return 1; }
    return 0;
}

// DomainCert: holds=1 iff M > 0.
pub fn phys_hawking_temperature_strict(M: Float) -> DomainCert {
    let r: Result[Float, String] = hts_temperature(M);
    let mut h: Int = 0;
    match r {
        Ok(t)  => { if t > 0.0 { h = 1; } },
        Err(_) => { }
    }
    return domain_cert("phys", "hawking_temperature_strict", h);
}

// Verify: 0.001% precision. Self-consistent with formula AND matches published value.
pub fn verify_hawking_temperature_strict() -> Bool {
    let pc: PhysicalConstants = constants_codata_2022();
    let hbar: Float = pc.planck_reduced;
    let c_val: Float = pc.speed_of_light;
    let g: Float = pc.gravitational_constant;
    let k_b: Float = pc.boltzmann_constant;
    let pi_val: Float = circ_pi_strict_ht();

    // M_sun (IAU 2015 defining constant) = 1.98892e30 kg.
    let m_sun: Float = 1988920000000000000000000000000.0;
    // Published T_H(M_sun) = 6.1686778e-8 K (CODATA 2022 + IAU 2015).
    let t_sun: Float = hts_got(hts_temperature(m_sun));
    let want_sun: Float = 0.00000006168677824;
    if hts_close_0p001(t_sun, want_sun) != 1 { return false; }

    // M = 2e30 kg -> T_H = 6.1345033e-8 K within 0.001%.
    let m_2e30: Float = 2000000000000000000000000000000.0;
    let t_2e30: Float = hts_got(hts_temperature(m_2e30));
    let want_2e30: Float = 0.00000006134503349;
    if hts_close_0p001(t_2e30, want_2e30) != 1 { return false; }

    // M = 1e30 kg -> T_H = 1.2269007e-7 K within 0.001%.
    let m_1e30: Float = 1000000000000000000000000000000.0;
    let t_1e30: Float = hts_got(hts_temperature(m_1e30));
    let want_1e30: Float = 0.0000001226900670;
    if hts_close_0p001(t_1e30, want_1e30) != 1 { return false; }

    // Self-consistency: the same formula computed twice gives the same answer to Float precision.
    let t_alt_sun: Float = (hbar * c_val * c_val * c_val) / (8.0 * pi_val * g * m_sun * k_b);
    if hts_close_0p001(t_sun, t_alt_sun) != 1 { return false; }

    // Hostile: M <= 0 fails closed.
    if hts_temperature(0.0).is_ok() { return false; }
    if hts_temperature(0.0 - 1.0).is_ok() { return false; }
    if hts_temperature(0.0 - 0.000000000000000000000000000001).is_ok() { return false; }

    // Coupled: equivalent form T_H = hbar c / (4 pi k_B r_s) agrees within 1e-7 relative.
    let rs: Float = hts_got(hts_schwarzschild_radius(m_sun));
    let t_alt: Float = hts_got(hts_temperature_from_radius(rs));
    let mut dc: Float = t_sun - t_alt;
    if dc < 0.0 { dc = 0.0 - dc; }
    let rel_dc: Float = dc / t_sun;
    if rel_dc > 0.0000001 { return false; }
    if hts_temperature_from_radius(0.0).is_ok() { return false; }
    if hts_temperature_from_radius(0.0 - 1.0).is_ok() { return false; }

    // DomainCert sanity.
    if phys_hawking_temperature_strict(m_sun).holds != 1 { return false; }
    if phys_hawking_temperature_strict(0.0).holds != 0 { return false; }
    if phys_hawking_temperature_strict(0.0 - 1.0).holds != 0 { return false; }

    return true;
}
