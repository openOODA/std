// # Spacecraft RCS Thruster Force & Torque Allocation
//
// Logline: Allocates Reaction Control System (RCS) pulse duty cycles for 6-DOF force and attitude torque demands.
//
// Setup: Pure spacecraft actuation allocator mapping commanded 3D forces and torques to discrete thruster firings.
//
// Beats:
//   1. Minimum 6-DOF thruster configuration count query.
//   2. Calculate single-thruster torque contribution tau = r (x) F.
//   3. Compute pulse on-time duration from impulse bit demand.
//   4. Evaluate total propellant consumed during RCS maneuver pulse.

pub fn rcs_thrusters() -> Int {
    return 6;
}

pub fn rcs_min_thrusters() -> Int {
    return 6;
}

/// Computes torque vector generated by a single thruster: tau = r x F.
pub fn rcs_thruster_torque_x(
    pos_y: Float, pos_z: Float,
    force_y: Float, force_z: Float
) -> Float {
    return (pos_y * force_z) - (pos_z * force_y);
}

/// Computes required thruster pulse firing duration in seconds for commanded impulse bit: dt = J_demand / F_thrust.
pub fn rcs_pulse_duration(
    impulse_demand_n_s: Float,
    thruster_nominal_force_n: Float,
    min_pulse_width_s: Float
) -> Float {
    if thruster_nominal_force_n <= 0.0001 { return 0.0; }
    let raw_dt: Float = impulse_demand_n_s / thruster_nominal_force_n;
    if raw_dt < min_pulse_width_s { return 0.0; }
    return raw_dt;
}

/// Computes propellant mass consumed during RCS firing: dm = (F * dt) / (Isp * g0).
pub fn rcs_propellant_consumed(
    thrust_n: Float,
    burn_time_s: Float,
    isp_s: Float
) -> Float {
    let g0: Float = 9.80665;
    let total_impulse: Float = thrust_n * burn_time_s;
    return total_impulse / (isp_s * g0);
}
