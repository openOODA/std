// # Astrodynamics & Spacecraft Mechanics Unified Facade
//
// Logline: Re-exports orbital mechanics, Keplerian solvers, coordinate frames, attitude kinematics, propulsion, and tracking.
//
// Setup: Pure facade module importing all 24 modular astrodynamics, trajectory, and celestial navigation submodules.
//        Every shim below calls a real exported function with real exported types (nothing fictional).
//
// Beats:
//   1. Import 24 specialized spacecraft mechanics, orbital propagation, and attitude dynamics components.
//   2. Re-export public constructors, state propagators, coordinate converters, and trajectory solvers.
//   3. Maintain full API interoperability with downstream openOODA aerospace and physics callers.

import "./kepler_orbit.oo";
import "./kepler_elements.oo";
import "./anomaly_kepler_solver.oo";
import "./hohmann_transfer.oo";
import "./bi_elliptic_transfer.oo";
import "./tle_orbit_math.oo";
import "./sgp4_kepler_components.oo";
import "./gravitational_j2_perturbation.oo";
import "./lagrange_points.oo";
import "./lambert_solver.oo";
import "./patched_conics.oo";
import "./coordinate_eci_ecef.oo";
import "./coordinate_orbital_plane.oo";
import "./julian_date.oo";
import "./sidereal_time.oo";
import "./attitude_quaternion.oo";
import "./attitude_reaction_wheels.oo";
import "./rcs_thruster_allocator.oo";
import "./delta_v_budget.oo";
import "./rocket_tsiolkovsky.oo";
import "./launch_trajectory.oo";
import "./re_entry_thermal_profile.oo";
import "./ground_station_pass.oo";
import "./astro_stubs.oo";

pub fn astro_shim_vec3(x: Float, y: Float, z: Float) -> Vector3 {
    return vec3_new(x, y, z);
}

pub fn astro_shim_orbital_period(a: Float, mu: Float) -> Result[Float, String] {
    return kepler_orbital_period(a, mu);
}

pub fn astro_shim_semi_major_axis(r_mag: Float, v_mag: Float, mu: Float) -> Float {
    return state_to_semi_major_axis(r_mag, v_mag, mu);
}

pub fn astro_shim_solve_anomaly(m_val: Float, e_val: Float) -> Result[Float, String] {
    return kepler_solve_eccentric_anomaly(m_val, e_val, 0.000001, 50);
}

pub fn astro_shim_hohmann(r1_km: Float, r2_km: Float, mu: Float) -> Result[TransferDeltaV, String] {
    return hohmann_calculate_burns(r1_km, r2_km, mu);
}

pub fn astro_shim_bi_elliptic(r1_km: Float, r2_km: Float, rb_km: Float, mu: Float) -> Result[BiEllipticTransferPlan, String] {
    return bi_elliptic_calculate_burns(r1_km, r2_km, rb_km, mu);
}

pub fn astro_shim_tle_period(mean_motion_revs_day: Float) -> Float {
    return tle_mean_motion_to_period(mean_motion_revs_day);
}

pub fn astro_shim_sgp4_mean_anomaly(m0_rad: Float, n0_rad_min: Float, bstar_drag: Float, delta_t_min: Float) -> Float {
    return sgp4_propagate_mean_anomaly(m0_rad, n0_rad_min, bstar_drag, delta_t_min);
}

pub fn astro_shim_j2_rates(a_km: Float, e: Float, inc_rad: Float, mu: Float, re_km: Float, j2: Float) -> Result[J2DriftRate, String] {
    return j2_perturbation_rates(a_km, e, inc_rad, mu, re_km, j2);
}

pub fn astro_shim_lagrange_l1(mass_ratio_mu: Float) -> LagrangePoint2D {
    return lagrange_l1_position(mass_ratio_mu);
}

pub fn astro_shim_lambert(r1: Vector3, r2: Vector3, tof: Float, is_prograde: Bool, mu: Float) -> LambertResult {
    return lambert_solve(r1, r2, tof, is_prograde, mu, 40, 0.0001);
}

pub fn astro_shim_soi_radius(orbital_radius_m: Float, secondary_mass_kg: Float, primary_mass_kg: Float) -> Float {
    return patched_conic_soi_radius(orbital_radius_m, secondary_mass_kg, primary_mass_kg);
}

pub fn astro_shim_eci_to_ecef(r_eci: Vec3, gmst_rad: Float) -> Vec3 {
    return eci_to_ecef_position(r_eci, gmst_rad);
}

pub fn astro_shim_angular_momentum(semi_major_axis: Float, eccentricity: Float, mu: Float) -> Float {
    return orbital_angular_momentum(semi_major_axis, eccentricity, mu);
}

pub fn astro_shim_julian_date(year: Float, month: Float, day: Float, hour: Float, minute: Float, second: Float) -> Float {
    return gregorian_to_julian_date(year, month, day, hour, minute, second);
}

pub fn astro_shim_local_sidereal(jd: Float, lon_rad: Float) -> Float {
    return local_sidereal_time_rad(jd, lon_rad);
}

pub fn astro_shim_quat_new(w: Float, x: Float, y: Float, z: Float) -> Quaternion {
    return quat_new(w, x, y, z);
}

pub fn astro_shim_wheel_momentum(inertia_kg_m2: Float, wheel_speed_rad_s: Float) -> Float {
    return reaction_wheel_momentum(inertia_kg_m2, wheel_speed_rad_s);
}

pub fn astro_shim_rcs_torque_x(pos_y: Float, pos_z: Float, force_y: Float, force_z: Float) -> Float {
    return rcs_thruster_torque_x(pos_y, pos_z, force_y, force_z);
}

pub fn astro_shim_leo_to_gto(r_leo_km: Float, mu_km3_s2: Float) -> Float {
    return delta_v_leo_to_gto(r_leo_km, mu_km3_s2);
}

pub fn astro_shim_tsiolkovsky(isp_seconds: Float, mass_initial_kg: Float, mass_final_kg: Float) -> Float {
    return tsiolkovsky_delta_v(isp_seconds, mass_initial_kg, mass_final_kg);
}

pub fn astro_shim_dyn_pressure(air_density_kg_m3: Float, velocity_m_s: Float) -> Float {
    return launch_dynamic_pressure(air_density_kg_m3, velocity_m_s);
}

pub fn astro_shim_reentry_state(alt: Float, v: Float, gamma: Float, q: Float, g: Float) -> ReEntryState {
    return ReEntryState { altitude_m: alt, velocity_m_s: v, flight_path_angle_rad: gamma, heat_flux_w_m2: q, g_load: g };
}

pub fn astro_shim_pass_elevation(s_south: Float, e_east: Float, z_zenith: Float) -> Float {
    return ground_pass_elevation(s_south, e_east, z_zenith);
}

pub fn astro_shim_stubs_work() -> Int {
    return astro_stubs_work();
}
