// # Bipower Variation and Jump Detection Test
//
// Logline: Separates continuous Brownian volatility from discontinuous jump components using Barndorff-Nielsen and Shephard Bipower Variation (BV).
//
// Setup: Pure high-frequency econometrics module calculating continuous sample path variance and jump test z-statistics.
//
// Beats:
//   1. Define BipowerSeries, JumpTestConfig, and JumpDecompositionResult structures.
//   2. Compute realized bipower variation BV = (pi / 2) * sum(|r_i| * |r_{i-1}|).
//   3. Perform statistical hypothesis test for intraday jumps and isolate continuous variance C = min(RV, BV).

type BipowerSeries = struct {
    returns: List[Float],
    num_returns: Int
};

type JumpTestConfig = struct {
    significance_alpha_z: Float,
    mu1_constant: Float
};

type JumpDecompositionResult = struct {
    realized_variance_rv: Float,
    bipower_variation_bv: Float,
    relative_jump_fraction: Float,
    z_stat_jump_test: Float,
    has_significant_jump: Bool,
    continuous_variance: Float
};

pub fn bipower_series_new() -> BipowerSeries {
    let empty_list: List[Float] = list_new();
    return BipowerSeries {
        returns: empty_list,
        num_returns: 0
    };
}

pub fn bipower_series_push(series: BipowerSeries, r: Float) -> BipowerSeries {
    return BipowerSeries {
        returns: list_push(series.returns, r),
        num_returns: series.num_returns + 1
    };
}

pub fn jump_test_config_default() -> JumpTestConfig {
    return JumpTestConfig {
        significance_alpha_z: 1.96, // 95% confidence level
        mu1_constant: 0.7978846    // sqrt(2/pi) approx 0.7978846
    };
}

pub fn bipower_decompose_jumps(
    series: BipowerSeries,
    config: JumpTestConfig
) -> JumpDecompositionResult {
    let n: Int = series.num_returns;
    if n < 3 {
        return JumpDecompositionResult {
            realized_variance_rv: 0.0,
            bipower_variation_bv: 0.0,
            relative_jump_fraction: 0.0,
            z_stat_jump_test: 0.0,
            has_significant_jump: false,
            continuous_variance: 0.0
        };
    }

    let mut rv: Float = 0.0;
    let mut sum_abs_prod: Float = 0.0;
    let mut i: Int = 1;

    let r0: Float = list_get(series.returns, 0);
    rv = rv + (r0 * r0);

    while i < n {
        let r_t: Float = list_get(series.returns, i);
        let r_prev: Float = list_get(series.returns, i - 1);
        rv = rv + (r_t * r_t);

        let mut abs_t: Float = r_t;
    if r_t < 0.0 {
        abs_t = 0.0 - r_t;
    }
        let mut abs_prev: Float = r_prev;
    if r_prev < 0.0 {
        abs_prev = 0.0 - r_prev;
    }
        sum_abs_prod = sum_abs_prod + (abs_t * abs_prev);
        i = i + 1;
    }

    // pi / 2 approx 1.5707963
    let bv: Float = 1.5707963 * sum_abs_prod;

    // Relative jump fraction: max(0, (RV - BV) / RV)
    let mut jump_frac: Float = 0.0;
    if rv > 0.0 && rv > bv {
        jump_frac = (rv - bv) / rv;
    }

    // Z-test statistic: (1 - BV / RV) / sqrt( ( (pi^2/4) + pi - 3 ) * max(1, TP / BV^2) / n )
    // Asymptotic test statistic approx
    let mut n_f: Float = 0.0;
    let mut cnt: Int = n;
    while cnt >= 10 { n_f = n_f + 10.0; cnt = cnt - 10; }
    while cnt >= 1 { n_f = n_f + 1.0; cnt = cnt - 1; }

    let std_err: Float = sqrt(0.6090 / n_f);
    let mut z_stat: Float = 0.0;
    if std_err > 0.0 && rv > 0.0 {
        z_stat = ((rv - bv) / rv) / std_err;
    }

    let is_jump: Bool = z_stat >= config.significance_alpha_z;
    let mut cont_var: Float = rv;
    if is_jump && bv < rv {
        cont_var = bv;
    }

    return JumpDecompositionResult {
        realized_variance_rv: rv,
        bipower_variation_bv: bv,
        relative_jump_fraction: jump_frac,
        z_stat_jump_test: z_stat,
        has_significant_jump: is_jump,
        continuous_variance: cont_var
    };
}
