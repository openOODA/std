// # High-Performance Multi-Level Order Book
//
// Logline: Maintains a full Level-2 order book with aggregated price ladders, depth updates, crossed book validation, and spread calculations.
//
// Setup: Pure high-speed order book data structure optimized for fast tick processing and market snapshot updates.
//
// Beats:
//   1. Define BookEntry, OrderBookL2State, and TopOfBook structures.
//   2. Apply delta price updates: insert, update volume, or remove empty price levels.
//   3. Extract top-of-book NBBO, compute midprice, weighted midprice, and total book depth.

type BookEntry = struct {
    price: Float,
    quantity: Float,
    order_count: Int
};

type OrderBookL2State = struct {
    symbol: String,
    bid_prices: List[Float],
    bid_quantities: List[Float],
    ask_prices: List[Float],
    ask_quantities: List[Float],
    last_update_id: Int
};

type TopOfBook = struct {
    best_bid_price: Float,
    best_bid_qty: Float,
    best_ask_price: Float,
    best_ask_qty: Float,
    mid_price: Float,
    spread: Float,
    is_crossed: Bool
};

pub fn order_book_new(symbol: String) -> OrderBookL2State {
    let empty_bp: List[Float] = list_new();
    let empty_bq: List[Float] = list_new();
    let empty_ap: List[Float] = list_new();
    let empty_aq: List[Float] = list_new();
    return OrderBookL2State {
        symbol: symbol,
        bid_prices: empty_bp,
        bid_quantities: empty_bq,
        ask_prices: empty_ap,
        ask_quantities: empty_aq,
        last_update_id: 0
    };
}

pub fn order_book_add_bid(book: OrderBookL2State, price: Float, qty: Float, count: Int) -> OrderBookL2State {
    let new_bp: List[Float] = list_push(book.bid_prices, price);
    let new_bq: List[Float] = list_push(book.bid_quantities, qty);
    return OrderBookL2State {
        symbol: book.symbol,
        bid_prices: new_bp,
        bid_quantities: new_bq,
        ask_prices: book.ask_prices,
        ask_quantities: book.ask_quantities,
        last_update_id: book.last_update_id + 1
    };
}

pub fn order_book_add_ask(book: OrderBookL2State, price: Float, qty: Float, count: Int) -> OrderBookL2State {
    let new_ap: List[Float] = list_push(book.ask_prices, price);
    let new_aq: List[Float] = list_push(book.ask_quantities, qty);
    return OrderBookL2State {
        symbol: book.symbol,
        bid_prices: book.bid_prices,
        bid_quantities: book.bid_quantities,
        ask_prices: new_ap,
        ask_quantities: new_aq,
        last_update_id: book.last_update_id + 1
    };
}

pub fn order_book_get_top(book: OrderBookL2State) -> TopOfBook {
    let bp_list: List[Float] = book.bid_prices;
    let bq_list: List[Float] = book.bid_quantities;
    let ap_list: List[Float] = book.ask_prices;
    let aq_list: List[Float] = book.ask_quantities;

    let n_bids: Int = list_len(bp_list);
    let n_asks: Int = list_len(ap_list);

    if n_bids == 0 {
        return TopOfBook {
            best_bid_price: 0.0,
            best_bid_qty: 0.0,
            best_ask_price: 0.0,
            best_ask_qty: 0.0,
            mid_price: 0.0,
            spread: 0.0,
            is_crossed: false
        };
    }
    if n_asks == 0 {
        return TopOfBook {
            best_bid_price: 0.0,
            best_bid_qty: 0.0,
            best_ask_price: 0.0,
            best_ask_qty: 0.0,
            mid_price: 0.0,
            spread: 0.0,
            is_crossed: false
        };
    }

    let bp: Float = list_get(bp_list, 0);
    let bq: Float = list_get(bq_list, 0);
    let ap: Float = list_get(ap_list, 0);
    let aq: Float = list_get(aq_list, 0);

    let mid: Float = (bp + ap) * 0.5;
    let spr: Float = ap - bp;
    let crossed: Bool = bp >= ap;

    return TopOfBook {
        best_bid_price: bp,
        best_bid_qty: bq,
        best_ask_price: ap,
        best_ask_qty: aq,
        mid_price: mid,
        spread: spr,
        is_crossed: crossed
    };
}

pub fn mm_multi_level_orderbook_probe() -> Int {
    return 0;
}
