// # Comparative Advantage Principle (Ricardo)
//
// Logline: Each party specializes in the good for which it has the lower opportunity cost; total output rises.
//
// Setup: Pure Int units of labor. opp_cost_b is the cost of good a in terms of good b. Hosts econ_invariants.oo stem.
//
// Beats:
//   1. Opportunity cost of producing a in terms of b.
//   2. Comparative advantage test: 1 if A's opportunity cost is lower than B's.
//   3. Total output gain from specialization.
//   4. Hosts econ_invariants.oo stem for cross-law correlation.

import "std/science/econ/econ_invariants.oo";

fn ric_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Opportunity cost of producing 1 unit of a. labor_a=0 is Ok(0). labor_b<=0 or labor_a<0 is Err.
pub fn ric_opp_cost(labor_a: Int, labor_b: Int) -> Result[Int, String] {
    if labor_a < 0 { return Err("ERR\tric\tdomain"); }
    if labor_b <= 0 { return Err("ERR\tric\tdomain"); }
    return Ok(labor_a / labor_b);
}

// Cross-multiplied comparison: 1 if a_opp < b_opp, where a_opp = a_cost_a/a_cost_b and b_opp = b_cost_a/b_cost_b.
// Avoids integer division by 1/2 == 0 by using a_cost_a * b_cost_b < b_cost_a * a_cost_b.
pub fn ric_comparative_advantage(
    a_cost_a: Int, a_cost_b: Int,
    b_cost_a: Int, b_cost_b: Int
) -> Int {
    if a_cost_a < 0 { return 0; }
    if a_cost_b <= 0 { return 0; }
    if b_cost_a < 0 { return 0; }
    if b_cost_b <= 0 { return 0; }
    let lhs: Int = a_cost_a * b_cost_b;
    let rhs: Int = b_cost_a * a_cost_b;
    if lhs < rhs { return 1; }
    return 0;
}

// Total output after specialization: sum of total labor / labor_per_unit.
pub fn ric_total_output(
    total_labor_a: Int, labor_per_unit_a: Int,
    total_labor_b: Int, labor_per_unit_b: Int
) -> Result[Int, String] {
    if total_labor_a < 0 { return Err("ERR\tric\tdomain"); }
    if labor_per_unit_a <= 0 { return Err("ERR\tric\tdomain"); }
    if total_labor_b < 0 { return Err("ERR\tric\tdomain"); }
    if labor_per_unit_b <= 0 { return Err("ERR\tric\tdomain"); }
    let units_a: Int = total_labor_a / labor_per_unit_a;
    let units_b: Int = total_labor_b / labor_per_unit_b;
    return Ok(units_a + units_b);
}

// KAT and hostile cases for the comparative-advantage principle.
pub fn verify_comparative_advantage_principle() -> Bool {
    let econ_inv_ok: Int = econ_qty_ok(1);
    if econ_inv_ok != 1 { return false; }
    if ric_got(ric_opp_cost(4, 2)) != 2 { return false; }
    if ric_got(ric_opp_cost(6, 3)) != 2 { return false; }
    let zopp: Result[Int, String] = ric_opp_cost(0, 5);
    if zopp.is_ok() == false { return false; }
    if ric_got(zopp) != 0 { return false; }
    if ric_opp_cost(5, 0).is_ok() { return false; }
    if ric_opp_cost(0 - 1, 5).is_ok() { return false; }
    // A: 1/2 < B: 6/3 = 2; cross-multiply: 1*3=3 < 6*2=12. A has comparative advantage.
    let ca: Int = ric_comparative_advantage(1, 2, 6, 3);
    if ca != 1 { return false; }
    // Reverse: B has advantage.
    let cb: Int = ric_comparative_advantage(6, 3, 1, 2);
    if cb != 0 { return false; }
    // Equal opportunity costs: no advantage.
    let cn: Int = ric_comparative_advantage(2, 4, 1, 2);
    if cn != 0 { return false; }
    if ric_comparative_advantage(5, 1, 1, 1) != 0 { return false; }
    if ric_comparative_advantage(5, 0, 5, 5) != 0 { return false; }
    if ric_comparative_advantage(0 - 1, 5, 5, 5) != 0 { return false; }
    if ric_got(ric_total_output(100, 2, 100, 4)) != 75 { return false; }
    if ric_got(ric_total_output(0, 2, 100, 4)) != 25 { return false; }
    if ric_total_output(0, 0, 100, 4).is_ok() { return false; }
    if ric_total_output(100, 2, 100, 0).is_ok() { return false; }
    if ric_total_output(0 - 1, 2, 100, 4).is_ok() { return false; }
    return true;
}
