// # Kelly Criterion Bet Sizing Principle
//
// Logline: Heuristic optimal bet fraction f* = (bp - q) / b for win probability p, win amount b,
//   loss probability q = 1 - p; equivalently f* = (p*(b+1) - 1) / b. Maximizes expected log growth.
//
// Setup: Pure Float. p in (0, 1) open interval, b > 0. Illegal p or b return Err.
//   Fair coin p=0.5, b=1 yields Ok(0). g(f) = p*ln(1 + b*f) + (1-p)*ln(1 - f) max at f*.
//
// Beats:
//   1. kelly_fraction(p, b) returns (p*(b+1) - 1) / b.
//   2. log_growth(p, b, f) returns p*ln(1 + b*f) + (1-p)*ln(1 - f) for f in (-1/b, 1).
//   3. log_growth is maximized at f* within a sample grid (coupled witness).
//   4. Domain certificate domain_cert("econ", "kelly_criterion", holds).

import "std/core/primitives/domain_cert.oo";
import "std/core/math/trig.oo";

fn kc_eabs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn kc_inputs_valid(p: Float, b: Float) -> Int {
    if p <= 0.0 { return 0; }
    if p >= 1.0 { return 0; }
    if b <= 0.0 { return 0; }
    return 1;
}

fn kc_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

pub fn kelly_fraction(p: Float, b: Float) -> Result[Float, String] {
    if kc_inputs_valid(p, b) != 1 { return Err("ERR\tkelly\tdomain"); }
    let pterm: Float = p * (b + 1.0);
    return Ok((pterm - 1.0) / b);
}

pub fn kelly_loss_prob(p: Float) -> Result[Float, String] {
    if p <= 0.0 { return Err("ERR\tkelly\tp"); }
    if p >= 1.0 { return Err("ERR\tkelly\tp"); }
    return Ok(1.0 - p);
}

pub fn kelly_log_growth(p: Float, b: Float, f: Float) -> Result[Float, String] {
    if kc_inputs_valid(p, b) != 1 { return Err("ERR\tkelly\tdomain"); }
    let q: Float = 1.0 - p;
    let win_term: Float = 1.0 + b * f;
    let loss_term: Float = 1.0 - f;
    if win_term <= 0.0 { return Err("ERR\tkelly\tf"); }
    if loss_term <= 0.0 { return Err("ERR\tkelly\tf"); }
    return Ok(p * math_ln(win_term) + q * math_ln(loss_term));
}

pub fn kelly_log_growth_maximized(p: Float, b: Float, tol: Float) -> Int {
    if kc_inputs_valid(p, b) != 1 { return 0; }
    let fr: Result[Float, String] = kelly_fraction(p, b);
    if fr.is_ok() == false { return 0; }
    let fstar: Float = kc_got(fr);
    if fstar < 0.0 { return 0; }
    let gr: Result[Float, String] = kelly_log_growth(p, b, fstar);
    if gr.is_ok() == false { return 0; }
    let gstar: Float = kc_got(gr);
    let mut best: Float = gstar;
    let mut i: Int = 0;
    while i < 41 {
        let f_i: Float = 0.0125 * (i + 0);
        if f_i >= 0.0 {
            if f_i < 0.5 {
                let gir: Result[Float, String] = kelly_log_growth(p, b, f_i);
                if gir.is_ok() {
                    let g_i: Float = kc_got(gir);
                    if g_i > best { best = g_i; }
                }
            }
        }
        i = i + 1;
    }
    if kc_eabs(best - gstar) <= tol { return 1; }
    return 0;
}

pub fn kelly_criterion_cert(p: Float, b: Float) -> DomainCert {
    let mut h: Int = 0;
    if kc_inputs_valid(p, b) == 1 {
        let fr: Result[Float, String] = kelly_fraction(p, b);
        if fr.is_ok() {
            let fstar: Float = kc_got(fr);
            let expected: Float = (p * (b + 1.0) - 1.0) / b;
            if kc_eabs(fstar - expected) <= 0.000001 {
                if kelly_log_growth_maximized(p, b, 0.0001) == 1 { h = 1; }
            }
        }
    }
    return domain_cert("econ", "kelly_criterion", h);
}

pub fn verify_kelly_criterion_principle() -> Bool {
    if kc_eabs(kc_got(kelly_fraction(0.6, 1.0)) - 0.2) > 0.000001 { return false; }
    if kc_eabs(kc_got(kelly_fraction(0.5, 1.0))) > 0.000001 { return false; }
    if kc_eabs(kc_got(kelly_fraction(0.6, 2.0)) - 0.4) > 0.000001 { return false; }
    if kc_eabs(kc_got(kelly_fraction(0.7, 1.0)) - 0.4) > 0.000001 { return false; }
    if kc_eabs(kc_got(kelly_fraction(0.55, 1.0)) - 0.1) > 0.000001 { return false; }
    if kc_eabs(kc_got(kelly_loss_prob(0.6)) - 0.4) > 0.000001 { return false; }
    if kc_eabs(kc_got(kelly_loss_prob(0.3)) - 0.7) > 0.000001 { return false; }
    let gstar: Float = kc_got(kelly_log_growth(0.6, 1.0, 0.2));
    if gstar <= 0.0 { return false; }
    if kc_eabs(kc_got(kelly_log_growth(0.6, 1.0, 0.0))) > 0.000001 { return false; }
    let g_under: Float = kc_got(kelly_log_growth(0.6, 1.0, 0.1));
    if g_under <= 0.0 { return false; }
    if g_under >= gstar { return false; }
    let g_over: Float = kc_got(kelly_log_growth(0.6, 1.0, 0.3));
    if g_over <= 0.0 { return false; }
    if g_over >= gstar { return false; }
    let g_half: Float = kc_got(kelly_log_growth(0.6, 1.0, 0.5));
    if g_half >= 0.0 { return false; }
    if kelly_log_growth_maximized(0.6, 1.0, 0.0001) != 1 { return false; }
    if kelly_log_growth_maximized(0.7, 1.0, 0.0001) != 1 { return false; }
    if kelly_log_growth_maximized(0.55, 2.0, 0.0001) != 1 { return false; }
    if kelly_log_growth_maximized(0.5, 1.0, 0.0001) != 1 { return false; }
    let cert: DomainCert = kelly_criterion_cert(0.6, 1.0);
    if cert.holds != 1 { return false; }
    if cert.domain != "econ" { return false; }
    if cert.law_name != "kelly_criterion" { return false; }
    if kelly_criterion_cert(0.5, 1.0).holds != 1 { return false; }
    if kelly_criterion_cert(0.0, 1.0).holds != 0 { return false; }
    if kelly_fraction(0.0, 1.0).is_ok() { return false; }
    if kelly_fraction(0.0 - 0.1, 1.0).is_ok() { return false; }
    if kelly_fraction(1.0, 1.0).is_ok() { return false; }
    if kelly_fraction(1.1, 1.0).is_ok() { return false; }
    if kelly_fraction(0.6, 0.0).is_ok() { return false; }
    if kelly_fraction(0.6, 0.0 - 1.0).is_ok() { return false; }
    if kelly_loss_prob(0.0).is_ok() { return false; }
    if kelly_loss_prob(1.0).is_ok() { return false; }
    if kelly_loss_prob(0.0 - 0.5).is_ok() { return false; }
    if kelly_loss_prob(1.5).is_ok() { return false; }
    if kelly_log_growth(0.0, 1.0, 0.2).is_ok() { return false; }
    if kelly_log_growth(0.6, 0.0, 0.2).is_ok() { return false; }
    if kelly_log_growth(0.6, 1.0, 0.0 - 1.0).is_ok() { return false; }
    if kelly_log_growth(0.6, 1.0, 1.0).is_ok() { return false; }
    return true;
}
