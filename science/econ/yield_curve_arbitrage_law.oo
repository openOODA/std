// # Yield Curve No-Arbitrage Law
//
// Logline: For two risk-free one-period bonds paying 1 at maturity, no-arbitrage requires
//   P1 * (1 + y1) = P2 * (1 + y2). Equivalently y2 = P1*(1+y1)/P2 - 1.
//
// Setup: Pure Float. P1, P2 > 0 (bond prices). y1, y2 >= 0 (yields in decimal).
//   Illegal inputs return Err. Arbitrage profit per unit of bond 2 is P1*(1+y1) - P2*(1+y2).
//
// Beats:
//   1. implied_yield(P1, y1, P2) returns P1*(1+y1)/P2 - 1.
//   2. no_arbitrage_holds(P1, y1, P2, y2, tol) is 1 if |P1*(1+y1) - P2*(1+y2)| <= tol.
//   3. arbitrage_profit(P1, y1, P2, y2) returns the positive-or-negative mispricing.
//   4. Domain certificate domain_cert("econ", "yield_curve_arbitrage", holds).

import "std/core/primitives/domain_cert.oo";

fn yca_eabs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn yca_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

fn yca_inputs_valid(p1: Float, y1: Float, p2: Float, y2: Float) -> Int {
    if p1 <= 0.0 { return 0; }
    if p2 <= 0.0 { return 0; }
    if y1 < 0.0 { return 0; }
    if y2 < 0.0 { return 0; }
    return 1;
}

pub fn yca_implied_yield(p1: Float, y1: Float, p2: Float) -> Result[Float, String] {
    if p1 <= 0.0 { return Err("ERR\tyca\tdomain"); }
    if p2 <= 0.0 { return Err("ERR\tyca\tdomain"); }
    if y1 < 0.0 { return Err("ERR\tyca\tdomain"); }
    let num: Float = p1 * (1.0 + y1);
    return Ok(num / p2 - 1.0);
}

pub fn yca_residual(p1: Float, y1: Float, p2: Float, y2: Float) -> Result[Float, String] {
    if yca_inputs_valid(p1, y1, p2, y2) != 1 { return Err("ERR\tyca\tdomain"); }
    let lhs: Float = p1 * (1.0 + y1);
    let rhs: Float = p2 * (1.0 + y2);
    return Ok(lhs - rhs);
}

pub fn yca_no_arbitrage_holds(p1: Float, y1: Float, p2: Float, y2: Float, tol: Float) -> Int {
    if yca_inputs_valid(p1, y1, p2, y2) != 1 { return 0; }
    let rr: Result[Float, String] = yca_residual(p1, y1, p2, y2);
    if rr.is_ok() == false { return 0; }
    if yca_eabs(yca_got(rr)) <= tol { return 1; }
    return 0;
}

pub fn yca_arbitrage_profit(p1: Float, y1: Float, p2: Float, y2: Float) -> Result[Float, String] {
    return yca_residual(p1, y1, p2, y2);
}

pub fn yield_curve_arbitrage_cert(p1: Float, y1: Float, p2: Float, y2: Float) -> DomainCert {
    let mut h: Int = 0;
    if yca_inputs_valid(p1, y1, p2, y2) == 1 {
        let yr: Result[Float, String] = yca_implied_yield(p1, y1, p2);
        if yr.is_ok() {
            let y2_imp: Float = yca_got(yr);
            let want: Float = p1 * (1.0 + y1) / p2 - 1.0;
            if yca_eabs(y2_imp - want) <= 0.000001 {
                if yca_no_arbitrage_holds(p1, y1, p2, y2, 0.000001) == 1 { h = 1; }
            }
        }
    }
    return domain_cert("econ", "yield_curve_arbitrage", h);
}

pub fn verify_yield_curve_arbitrage_law() -> Bool {
    let y2_imp: Float = yca_got(yca_implied_yield(99.0, 0.01, 98.0));
    if yca_eabs(y2_imp - 0.020306) > 0.0001 { return false; }
    if yca_no_arbitrage_holds(99.0, 0.01, 98.0, y2_imp, 0.000000001) != 1 { return false; }
    if yca_no_arbitrage_holds(100.0, 0.05, 100.0, 0.05, 0.0001) != 1 { return false; }
    if yca_no_arbitrage_holds(100.0, 0.05, 100.0, 0.10, 0.0001) != 0 { return false; }
    if yca_eabs(yca_got(yca_residual(100.0, 0.05, 100.0, 0.10)) - (0.0 - 5.0)) > 0.001 { return false; }
    let p2_calc: Float = 100.0 * 1.05 / 1.10;
    if yca_no_arbitrage_holds(100.0, 0.05, p2_calc, 0.10, 0.0001) != 1 { return false; }
    if yca_eabs(yca_got(yca_residual(99.0, 0.01, 99.0, 0.01))) > 0.0001 { return false; }
    if yca_eabs(yca_got(yca_residual(99.0, 0.01, 97.0, 0.01)) - 2.02) > 0.001 { return false; }
    if yca_got(yca_arbitrage_profit(99.0, 0.01, 97.0, 0.01)) <= 0.0 { return false; }
    if yca_eabs(yca_got(yca_residual(99.0, 0.01, 101.0, 0.01)) - (0.0 - 2.02)) > 0.001 { return false; }
    if yca_got(yca_arbitrage_profit(99.0, 0.01, 101.0, 0.01)) >= 0.0 { return false; }
    let cert: DomainCert = yield_curve_arbitrage_cert(99.0, 0.01, 98.0, y2_imp);
    if cert.holds != 1 { return false; }
    if cert.domain != "econ" { return false; }
    if cert.law_name != "yield_curve_arbitrage" { return false; }
    if yield_curve_arbitrage_cert(100.0, 0.05, 100.0, 0.05).holds != 1 { return false; }
    if yield_curve_arbitrage_cert(100.0, 0.05, 100.0, 0.10).holds != 0 { return false; }
    if yield_curve_arbitrage_cert(0.0, 0.01, 98.0, 0.02).holds != 0 { return false; }
    if yca_implied_yield(0.0, 0.01, 98.0).is_ok() { return false; }
    if yca_implied_yield(0.0 - 1.0, 0.01, 98.0).is_ok() { return false; }
    if yca_implied_yield(99.0, 0.01, 0.0).is_ok() { return false; }
    if yca_implied_yield(99.0, 0.01, 0.0 - 1.0).is_ok() { return false; }
    if yca_implied_yield(99.0, 0.0 - 0.01, 98.0).is_ok() { return false; }
    if yca_no_arbitrage_holds(99.0, 0.0 - 0.01, 98.0, 0.02, 1.0) != 0 { return false; }
    if yca_arbitrage_profit(99.0, 0.0 - 0.01, 98.0, 0.02).is_ok() { return false; }
    if yca_residual(99.0, 0.0 - 0.01, 98.0, 0.02).is_ok() { return false; }
    if yca_no_arbitrage_holds(99.0, 0.01, 0.0, 0.02, 1.0) != 0 { return false; }
    if yca_no_arbitrage_holds(0.0, 0.01, 98.0, 0.02, 1.0) != 0 { return false; }
    return true;
}
