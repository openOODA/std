// # Gresham's Law
//
// Logline: When forced to circulate at par, "bad" money drives "good" money out of circulation.
//
// Setup: Pure Int counts and intrinsic values. Returns 1 if bad coin is over-represented. Hosts econ_invariants.oo stem.
//   Negative face or metal on quantity kernels return Err. Zero metal and zero face are Ok(0).
//
// Beats:
//   1. Legal tender parity: each coin type is accepted at face value.
//   2. Intrinsic value ratio: face vs metal content.
//   3. Circulation fraction: holders keep good, spend bad.
//   4. Hosts econ_invariants.oo stem for cross-law correlation.

import "std/science/econ/econ_invariants.oo";

fn gr_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Intrinsic value of a coin (in cents of metal). bad_coin_value < good_coin_value.
pub fn gresham_intrinsic_value(face_value: Int, metal_content_cents: Int) -> Result[Int, String] {
    if face_value < 0 { return Err("ERR\tgresham\tface"); }
    if metal_content_cents < 0 { return Err("ERR\tgresham\tmetal"); }
    return Ok(metal_content_cents);
}

// Face value for a coin: nominal denomination.
pub fn gresham_face_value(face_value: Int) -> Result[Int, String] {
    if face_value < 0 { return Err("ERR\tgresham\tface"); }
    return Ok(face_value);
}

// Overvalued coin: 1 if face_value > metal_content (token money with seigniorage).
pub fn gresham_is_overvalued(face_value: Int, metal_content_cents: Int) -> Int {
    if face_value < 0 { return 0; }
    if metal_content_cents < 0 { return 0; }
    if face_value > metal_content_cents { return 1; }
    return 0;
}

// Undervalued coin: 1 if face_value < metal_content (subsidized money).
pub fn gresham_is_undervalued(face_value: Int, metal_content_cents: Int) -> Int {
    if face_value < 0 { return 0; }
    if metal_content_cents < 0 { return 0; }
    if face_value < metal_content_cents { return 1; }
    return 0;
}

// Gresham's law witness: 1 if at least one bad coin and one good coin exist in circulation.
pub fn gresham_dominates(bad_face: Int, good_face: Int, bad_metal: Int, good_metal: Int) -> Int {
    if gresham_is_overvalued(bad_face, bad_metal) != 1 { return 0; }
    if gresham_is_undervalued(good_face, good_metal) != 1 { return 0; }
    if bad_face <= 0 { return 0; }
    if good_face <= 0 { return 0; }
    return 1;
}

// KAT and hostile cases for Gresham's law.
pub fn verify_greshams_law() -> Bool {
    let econ_inv_ok: Int = econ_qty_ok(1);
    if econ_inv_ok != 1 { return false; }
    if gr_got(gresham_intrinsic_value(100, 100)) != 100 { return false; }
    if gr_got(gresham_intrinsic_value(100, 50)) != 50 { return false; }
    if gresham_intrinsic_value(100, 0).is_ok() == false { return false; }
    if gr_got(gresham_intrinsic_value(100, 0)) != 0 { return false; }
    if gresham_intrinsic_value(0 - 1, 100).is_ok() { return false; }
    if gresham_intrinsic_value(100, 0 - 1).is_ok() { return false; }
    if gr_got(gresham_face_value(100)) != 100 { return false; }
    if gresham_face_value(0).is_ok() == false { return false; }
    if gr_got(gresham_face_value(0)) != 0 { return false; }
    if gresham_face_value(0 - 1).is_ok() { return false; }
    if gresham_is_overvalued(100, 50) != 1 { return false; }
    if gresham_is_overvalued(100, 100) != 0 { return false; }
    if gresham_is_overvalued(50, 100) != 0 { return false; }
    if gresham_is_overvalued(0, 0) != 0 { return false; }
    if gresham_is_overvalued(0 - 1, 100) != 0 { return false; }
    if gresham_is_overvalued(100, 0 - 1) != 0 { return false; }
    if gresham_is_undervalued(50, 100) != 1 { return false; }
    if gresham_is_undervalued(100, 100) != 0 { return false; }
    if gresham_is_undervalued(100, 50) != 0 { return false; }
    if gresham_dominates(100, 100, 50, 200) != 1 { return false; }
    if gresham_dominates(100, 100, 200, 50) != 0 { return false; }
    if gresham_dominates(100, 100, 50, 50) != 0 { return false; }
    if gresham_dominates(0, 100, 50, 200) != 0 { return false; }
    if gresham_dominates(100, 0, 50, 200) != 0 { return false; }
    return true;
}
