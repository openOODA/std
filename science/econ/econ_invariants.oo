// # Economics quantity product invariants
//
// Logline: Negative quantity is invalid; non-negative quantity holds.
//
// Setup: Pure Int checks. DomainCert is local because std/core/domain_cert.oo is absent.
//
// Beats:
//   1. econ_qty_ok of a negative quantity returns 0.
//   2. econ_qty_ok(1) returns 1.
//   3. econ_qty_cert boxes the law into DomainCert.holds.

import "std/core/primitives/domain_cert.oo";
// Negative quantity is invalid.
pub fn econ_qty_ok(qty: Int) -> Int {
    if qty < 0 {
        return 0;
    }
    return 1;
}

pub fn econ_qty_cert(qty: Int) -> DomainCert {
    return DomainCert {
        domain: "econ",
        law_name: "qty_nonneg",
        holds: econ_qty_ok(qty)
    };
}
