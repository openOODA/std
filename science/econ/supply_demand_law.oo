// # Supply and Demand Equilibrium Law
//
// Logline: Market price moves toward the equilibrium at which quantity supplied equals quantity demanded.
//
// Setup: Pure Int quantities and prices. Linear demand Qd = a - b*P, supply Qs = c + d*P. Hosts econ_invariants.oo stem.
//
// Beats:
//   1. Quantity demanded Qd = a - b*P.
//   2. Quantity supplied Qs = c + d*P.
//   3. Equilibrium price P* = (a - c) / (b + d).
//   4. Excess demand D - S at any price.

import "std/science/econ/econ_invariants.oo";

fn sd_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn sd_quantity_demanded(a: Int, b: Int, price: Int) -> Result[Int, String] {
    if a < 0 { return Err("ERR\tsd\ta"); }
    if b < 0 { return Err("ERR\tsd\tb"); }
    if price < 0 { return Err("ERR\tsd\tp"); }
    let bp: Int = b * price;
    let q: Int = a - bp;
    if q < 0 { return Ok(0); }
    return Ok(q);
}

pub fn sd_quantity_supplied(c: Int, d: Int, price: Int) -> Result[Int, String] {
    if c < 0 { return Err("ERR\tsd\tc"); }
    if d < 0 { return Err("ERR\tsd\td"); }
    if price < 0 { return Err("ERR\tsd\tp"); }
    return Ok(c + (d * price));
}

pub fn sd_excess_demand(a: Int, b: Int, c: Int, d: Int, price: Int) -> Result[Int, String] {
    let qdr: Result[Int, String] = sd_quantity_demanded(a, b, price);
    if qdr.is_ok() == false { return Err("ERR\tsd\tqd"); }
    let qsr: Result[Int, String] = sd_quantity_supplied(c, d, price);
    if qsr.is_ok() == false { return Err("ERR\tsd\tqs"); }
    return Ok(sd_got(qdr) - sd_got(qsr));
}

pub fn sd_equilibrium_price(a: Int, b: Int, c: Int, d: Int) -> Result[Int, String] {
    if a < 0 { return Err("ERR\tsd\ta"); }
    if b < 0 { return Err("ERR\tsd\tb"); }
    if c < 0 { return Err("ERR\tsd\tc"); }
    if d < 0 { return Err("ERR\tsd\td"); }
    if a < c { return Err("ERR\tsd\neq"); }
    let denom: Int = b + d;
    if denom <= 0 { return Err("ERR\tsd\neq"); }
    return Ok((a - c) / denom);
}

pub fn verify_supply_demand_law() -> Bool {
    let econ_inv_ok: Int = econ_qty_ok(1);
    if econ_inv_ok != 1 { return false; }
    if sd_got(sd_quantity_demanded(100, 2, 10)) != 80 { return false; }
    if sd_got(sd_quantity_demanded(100, 2, 50)) != 0 { return false; }
    if sd_got(sd_quantity_demanded(100, 2, 0)) != 100 { return false; }
    if sd_got(sd_quantity_supplied(10, 3, 10)) != 40 { return false; }
    if sd_got(sd_quantity_supplied(0, 5, 7)) != 35 { return false; }
    if sd_got(sd_excess_demand(100, 2, 10, 3, 10)) != 40 { return false; }
    if sd_got(sd_excess_demand(100, 2, 10, 3, 18)) != 0 { return false; }
    if sd_got(sd_equilibrium_price(100, 2, 10, 3)) != 18 { return false; }
    if sd_quantity_demanded(0 - 1, 2, 10).is_ok() { return false; }
    if sd_quantity_demanded(100, 0 - 1, 10).is_ok() { return false; }
    if sd_quantity_demanded(100, 2, 0 - 1).is_ok() { return false; }
    if sd_quantity_supplied(0 - 1, 3, 10).is_ok() { return false; }
    if sd_quantity_supplied(10, 0 - 1, 10).is_ok() { return false; }
    if sd_quantity_supplied(10, 3, 0 - 1).is_ok() { return false; }
    if sd_equilibrium_price(0 - 1, 2, 10, 3).is_ok() { return false; }
    if sd_equilibrium_price(100, 0 - 1, 10, 3).is_ok() { return false; }
    if sd_equilibrium_price(10, 2, 100, 3).is_ok() { return false; }
    if sd_equilibrium_price(100, 0, 10, 0).is_ok() { return false; }
    return true;
}
