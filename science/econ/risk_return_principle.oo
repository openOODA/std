// # Risk-Return Tradeoff Principle
//
// Logline: Higher expected return is compensation for bearing higher risk; risk-adjusted return ranks assets fairly.
//
// Setup: Pure Int expected returns and risks (variance or std-dev). Sharpe-like ratio. Hosts econ_invariants.oo stem.
//
// Beats:
//   1. Sharpe-like ratio (return - risk_free) / risk.
//   2. Dominance: 1 if asset A has higher return AND lower risk than asset B.
//   3. Risk parity: weights inverse to risk for balanced contribution.
//   4. Hosts econ_invariants.oo stem for cross-law correlation.

import "std/science/econ/econ_invariants.oo";

fn rr_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Sharpe-like ratio: (return - risk_free) * 100 / risk. Equal return is Ok(0). Bad risk is Err.
pub fn risk_return_sharpe(expected_return: Int, risk_free: Int, risk: Int) -> Result[Int, String] {
    if expected_return < 0 { return Err("ERR\trr\tdomain"); }
    if risk_free < 0 { return Err("ERR\trr\tdomain"); }
    if risk <= 0 { return Err("ERR\trr\tdomain"); }
    if risk_free > expected_return { return Ok(0); }
    let diff: Int = expected_return - risk_free;
    return Ok((diff * 100) / risk);
}

// Dominance: 1 if A has higher return AND lower or equal risk than B.
pub fn risk_return_dominates(a_return: Int, a_risk: Int, b_return: Int, b_risk: Int) -> Int {
    if a_return < 0 { return 0; }
    if a_risk < 0 { return 0; }
    if b_return < 0 { return 0; }
    if b_risk < 0 { return 0; }
    if a_return > b_return {
        if a_risk <= b_risk { return 1; }
    }
    return 0;
}

// Risk-parity weight: proportional to 1 / risk. Floor 0 is Ok. Bad risk or denom is Err.
pub fn risk_return_parity_weight(weight_denominator: Int, risk: Int) -> Result[Int, String] {
    if risk <= 0 { return Err("ERR\trr\tdomain"); }
    if weight_denominator <= 0 { return Err("ERR\trr\tdomain"); }
    return Ok(weight_denominator / risk);
}

// KAT and hostile cases for the risk-return principle.
pub fn verify_risk_return_principle() -> Bool {
    let econ_inv_ok: Int = econ_qty_ok(1);
    if econ_inv_ok != 1 { return false; }
    if rr_got(risk_return_sharpe(10, 2, 5)) != 160 { return false; }
    let zsh: Result[Int, String] = risk_return_sharpe(10, 10, 5);
    if zsh.is_ok() == false { return false; }
    if rr_got(zsh) != 0 { return false; }
    if risk_return_sharpe(10, 2, 0).is_ok() { return false; }
    if risk_return_sharpe(10, 2, 0 - 1).is_ok() { return false; }
    if risk_return_sharpe(0 - 1, 2, 5).is_ok() { return false; }
    if risk_return_sharpe(10, 0 - 1, 5).is_ok() { return false; }
    if risk_return_dominates(10, 5, 8, 7) != 1 { return false; }
    if risk_return_dominates(8, 7, 10, 5) != 0 { return false; }
    if risk_return_dominates(10, 7, 8, 5) != 0 { return false; }
    if risk_return_dominates(8, 5, 10, 7) != 0 { return false; }
    if risk_return_dominates(10, 5, 10, 5) != 0 { return false; }
    if risk_return_dominates(0 - 1, 5, 10, 5) != 0 { return false; }
    if risk_return_dominates(10, 0 - 1, 10, 5) != 0 { return false; }
    if rr_got(risk_return_parity_weight(100, 5)) != 20 { return false; }
    if rr_got(risk_return_parity_weight(100, 10)) != 10 { return false; }
    if risk_return_parity_weight(100, 0).is_ok() { return false; }
    if risk_return_parity_weight(0, 5).is_ok() { return false; }
    if risk_return_parity_weight(100, 0 - 1).is_ok() { return false; }
    return true;
}
