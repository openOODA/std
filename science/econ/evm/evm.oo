// # Sovereign EVM Consensus & State Engine Master Façade
//
// Logline: Unified standard library package providing Ethereum RLP codecs, Keccak-256, and MPT state roots.
//
// Setup: Root EVM package re-exporting serialization, cryptographic hashing, and state trie engines.
//
// Beats:
//   1. Re-export Recursive Length Prefix (RLP) encoders and canonical decoders.
//   2. Re-export Keccak-256 sponge hash permutation functions.
//   3. Re-export Merkle Patricia Trie (MPT) structures and World State root calculators.

import "./rlp_types.oo";
import "./rlp.oo";
import "./keccak.oo";
import "./mpt_types.oo";
import "./mpt.oo";
import "./state_root.oo";

pub fn evm_version() -> String {
    return "openOODA Sovereign EVM v1.0.0";
}

pub fn evm_shim_rlp_types() -> RlpItem {
    return rlp_item_bytes(list_new());
}

pub fn evm_shim_rlp_codec(data: List[Int]) -> List[Int] {
    return rlp_encode_bytes(data);
}

pub fn evm_shim_keccak_hash(data: List[Int]) -> List[Int] {
    return keccak256_hash(data);
}

pub fn evm_shim_mpt_types_account() -> MptAccount {
    return mpt_account_new(0, "0");
}

pub fn evm_shim_mpt_codec(hex_key: String) -> List[Int] {
    return mpt_encode_nibbles(hex_key);
}

pub fn evm_shim_state_root(n: Int) -> Result[String, String] {
    return evm_compute_state_root(n);
}
