// # Persist and Load TokenLedger Snapshots to Disk
//
// Logline: Save a SessionTokenLedger snapshot to a file path under .ooda-cache/ooda-tmp/ and reload it for diffing or replay.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) W2 ledger persistence layer.
//
// Beats:
//   1. Define LedgerSnapshot and SnapshotRecord structures.
//   2. Serialize a snapshot to a stable key=value text format.
//   3. Parse a snapshot file back into a SnapshotRecord.
//   4. Compute a numeric diff between two SnapshotRecords.

type SnapshotRecord = struct {
    session_id: String,
    prompt_tokens: Int,
    completion_tokens: Int,
    tool_payload_bytes: Int,
    thinking_ms: Int,
    cost_micro: Int,
    saved_at_ms: Int
};

type SnapshotDiff = struct {
    session_id: String,
    prompt_delta: Int,
    completion_delta: Int,
    tool_payload_delta: Int,
    thinking_delta: Int,
    cost_delta: Int,
    regressed: Bool
};

pub fn snapshot_record_new(
    sid: String,
    p: Int,
    c: Int,
    t: Int,
    th: Int,
    cost: Int,
    ts: Int
) -> SnapshotRecord {
    return SnapshotRecord {
        session_id: sid,
        prompt_tokens: p,
        completion_tokens: c,
        tool_payload_bytes: t,
        thinking_ms: th,
        cost_micro: cost,
        saved_at_ms: ts
    };
}

pub fn snapshot_serialize(s: SnapshotRecord) -> String {
    let mut out: String = "session_id=";
    out = out + s.session_id;
    out = out + "\nprompt_tokens=";
    out = out + (s).prompt_tokens.to_string();
    out = out + "\ncompletion_tokens=";
    out = out + (s).completion_tokens.to_string();
    out = out + "\ntool_payload_bytes=";
    out = out + (s).tool_payload_bytes.to_string();
    out = out + "\nthinking_ms=";
    out = out + (s).thinking_ms.to_string();
    out = out + "\ncost_micro=";
    out = out + (s).cost_micro.to_string();
    out = out + "\nsaved_at_ms=";
    out = out + (s).saved_at_ms.to_string();
    out = out + "\n";
    return out;
}

pub fn snapshot_parse_field(text: String, key: String) -> String {
    let n: Int = chars_len(text);
    let needle: String = key + "=";
    let klen: Int = chars_len(needle);
    let mut i: Int = 0;
    while i + klen <= n {
        if str_slice(text, i, i + klen) == needle {
            let mut j: Int = i + klen;
            let mut buf: String = "";
            while j < n {
                let c: String = char_at(text, j);
                if c == "\n" {
                    return buf;
                }
                buf = buf + c;
                j = j + 1;
            }
            return buf;
        }
        i = i + 1;
    }
    return "";
}

pub fn snapshot_parse_int_field(text: String, key: String) -> Int {
    let v: String = snapshot_parse_field(text, key);
    let n: Int = v.len();
    if n == 0 {
        return 0;
    }
    return parse_int_safe(v, 0);
}

fn parse_int_safe(s: String, fallback: Int) -> Int {
    let n: Int = chars_len(s);
    if n == 0 {
        return fallback;
    }
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        if !ledger_is_digit_char(ch) {
            return fallback;
        }
        acc = acc * 10 + ledger_digit_to_int(ch);
        i = i + 1;
    }
    return acc;
}

fn ledger_is_digit_char(ch: String) -> Bool {
    if ch == "0" { return true; }
    if ch == "1" { return true; }
    if ch == "2" { return true; }
    if ch == "3" { return true; }
    if ch == "4" { return true; }
    if ch == "5" { return true; }
    if ch == "6" { return true; }
    if ch == "7" { return true; }
    if ch == "8" { return true; }
    if ch == "9" { return true; }
    return false;
}

fn ledger_digit_to_int(ch: String) -> Int {
    if ch == "0" { return 0; }
    if ch == "1" { return 1; }
    if ch == "2" { return 2; }
    if ch == "3" { return 3; }
    if ch == "4" { return 4; }
    if ch == "5" { return 5; }
    if ch == "6" { return 6; }
    if ch == "7" { return 7; }
    if ch == "8" { return 8; }
    if ch == "9" { return 9; }
    return 0;
}

pub fn snapshot_deserialize(text: String) -> SnapshotRecord {
    let sid: String = snapshot_parse_field(text, "session_id");
    let p: Int = snapshot_parse_int_field(text, "prompt_tokens");
    let c: Int = snapshot_parse_int_field(text, "completion_tokens");
    let t: Int = snapshot_parse_int_field(text, "tool_payload_bytes");
    let th: Int = snapshot_parse_int_field(text, "thinking_ms");
    let cost: Int = snapshot_parse_int_field(text, "cost_micro");
    let ts: Int = snapshot_parse_int_field(text, "saved_at_ms");
    return snapshot_record_new(sid, p, c, t, th, cost, ts);
}

pub fn snapshot_diff(
    before: SnapshotRecord,
    after: SnapshotRecord
) -> SnapshotDiff {
    let prompt_d: Int = after.prompt_tokens - before.prompt_tokens;
    let comp_d: Int = after.completion_tokens - before.completion_tokens;
    let tool_d: Int = after.tool_payload_bytes - before.tool_payload_bytes;
    let think_d: Int = after.thinking_ms - before.thinking_ms;
    let cost_d: Int = after.cost_micro - before.cost_micro;
    let mut reg: Bool = false;
    if prompt_d > 0 {
        reg = true;
    }
    if comp_d > 0 {
        reg = true;
    }
    if cost_d > 0 {
        reg = true;
    }
    return SnapshotDiff {
        session_id: after.session_id,
        prompt_delta: prompt_d,
        completion_delta: comp_d,
        tool_payload_delta: tool_d,
        thinking_delta: think_d,
        cost_delta: cost_d,
        regressed: reg
    };
}
