// # Agent Token Ledger — Anchor for Agents
//
// Logline: Library for LLM-context token counts, JSON envelopes, ingest, and budget checks.
//
// Setup: Pure compute plus FsReadCap/FsWriteCap at call sites that load or save a ledger. Not capability tokens.
//
// Beats:
//   1. Envelope and JSON helpers: json_envelope.oo.
//   2. Ledger: token_telemetry.oo, jsonl_strict.oo, ledger_persist.oo, baseline.oo.
//   3. Cost and budget: pricing.oo, cost_project.oo, budget_enforce.oo, token_counterfactual.oo.
//   4. Source scan: token_optimizer.oo, caps_audit.oo, tool_heatmap.oo, ast_minify.oo, auto_fix.oo.

import "json_envelope.oo";
import "jsonl_strict.oo";
import "token_telemetry.oo";
import "ledger_persist.oo";
import "baseline.oo";
import "pricing.oo";
import "cost_project.oo";
import "budget_enforce.oo";
import "token_estimator.oo";
import "token_counterfactual.oo";
