// # Caller Capabilities Map - enforces ooda token subcommand permissions
//
// Logline: Subcommands declare their required capability; the dispatcher rejects calls when the caller's capability set is missing the required one.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) I4 capability enforcement.
//
// Beats:
//   1. Define cap codes (read, write, exec) and a CallerCaps struct.
//   2. Parse caller caps from a string like "read,write".
//   3. Look up the required caps for each ooda token subcommand.
//   4. Return admit=true iff caller caps include the required caps.

type CallerCaps = struct {
    has_read: Bool,
    has_write: Bool,
    has_exec: Bool,
    raw: String
};

pub fn caller_caps_new(has_read: Bool, has_write: Bool, has_exec: Bool, raw: String) -> CallerCaps {
    return CallerCaps {
        has_read: has_read,
        has_write: has_write,
        has_exec: has_exec,
        raw: raw
    };
}

pub fn caller_caps_default() -> CallerCaps {
    return caller_caps_new(true, false, false, "read");
}

pub fn caller_caps_all() -> CallerCaps {
    return caller_caps_new(true, true, true, "all");
}

fn caps_contains_token(s: String, tok: String) -> Bool {
    let n: Int = chars_len(s);
    let tn: Int = chars_len(tok);
    if tn == 0 { return true; }
    if tn > n { return false; }
    let mut i: Int = 0;
    while i + tn <= n {
        if str_slice(s, i, i + tn) == tok {
            let left_ok: Bool = i == 0 || char_at(s, i - 1) == ",";
            let right_end: Int = i + tn;
            let right_ok: Bool = right_end >= n || char_at(s, right_end) == ",";
            if left_ok && right_ok {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn caller_caps_parse(raw: String) -> CallerCaps {
    if raw == "all" || raw == "ALL" || raw == "*" {
        return caller_caps_all();
    }
    let has_read: Bool = caps_contains_token(raw, "read");
    let has_write: Bool = caps_contains_token(raw, "write");
    let has_exec: Bool = caps_contains_token(raw, "exec");
    return caller_caps_new(has_read, has_write, has_exec, raw);
}

pub fn sub_required_caps(sub: String) -> String {
    if sub == "status" { return "read"; }
    if sub == "report" { return "read"; }
    if sub == "query" { return "read"; }
    if sub == "ask" { return "read"; }
    if sub == "schema" { return "read"; }
    if sub == "diff" { return "read"; }
    if sub == "tail" { return "read"; }
    if sub == "audit" { return "read"; }
    if sub == "self_audit" { return "read"; }
    if sub == "heatmap" { return "read"; }
    if sub == "compress" { return "read"; }
    if sub == "fix" { return "write"; }
    if sub == "ingest" { return "write"; }
    if sub == "snapshot" { return "write"; }
    if sub == "enforce" { return "write"; }
    if sub == "calibrate" { return "write"; }
    return "exec";
}

pub fn caller_caps_admits(c: CallerCaps, sub: String) -> Bool {
    let required: String = sub_required_caps(sub);
    if required == "read" { return c.has_read; }
    if required == "write" { return c.has_write && c.has_read; }
    if required == "exec" { return c.has_exec; }
    return false;
}

pub fn caller_caps_denial_reason(c: CallerCaps, sub: String) -> String {
    let required: String = sub_required_caps(sub);
    let caller: String = c.raw;
    if caller_caps_admits(c, sub) {
        return "";
    }
    return "caller_caps=" + caller + " missing required cap='" + required + "' for sub='" + sub + "'";
}
