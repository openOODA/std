// # Token Baseline Store - measured, dated, sourced
//
// Logline: Persist the efficiency multiplier, estimator, and pricing as a single source of truth; every report reads from the store; calibration updates the store.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) I3 measured baseline.
//
// Beats:
//   1. Define BaselineRecord structure with name, value, sample_count, timestamp, source, pricing, estimator.
//   2. Serialize/parse to/from stable key=value text.
//   3. Load from .ooda-cache/ooda-token-baseline.json if it exists; else return default.
//   4. Save the updated baseline; fail-closed on write failure.

type BaselineRecord = struct {
    name: String,
    efficiency_milli: Int,
    sample_count: Int,
    saved_at_ms: Int,
    source: String,
    pricing_name: String,
    pricing_source: String,
    estimator_name: String,
    estimator_bpt_x1000: Int,
    estimator_samples: Int
};

pub fn baseline_default_path() -> String {
    return ".ooda-cache/ooda-token-baseline.ovl";
}

pub fn baseline_default() -> BaselineRecord {
    return BaselineRecord {
        name: "default",
        efficiency_milli: 18500,
        sample_count: 0,
        saved_at_ms: 0,
        source: "default",
        pricing_name: "default",
        pricing_source: "default",
        estimator_name: "char-heuristic",
        estimator_bpt_x1000: 4000,
        estimator_samples: 0
    };
}

pub fn baseline_load_default(fs: &FsReadCap) -> BaselineRecord {
    return baseline_load(fs, baseline_default_path());
}

pub fn baseline_record_new(
    name: String,
    eff: Int,
    count: Int,
    at: Int,
    source: String,
    pricing: Pricing,
    estimator: TokenEstimator
) -> BaselineRecord {
    return BaselineRecord {
        name: name,
        efficiency_milli: eff,
        sample_count: count,
        saved_at_ms: at,
        source: source,
        pricing_name: pricing.name,
        pricing_source: pricing.source,
        estimator_name: estimator.name,
        estimator_bpt_x1000: estimator.bytes_per_token_x1000,
        estimator_samples: estimator.sample_count
    };
}

fn baseline_field(text: String, key: String) -> String {
    let n: Int = chars_len(text);
    let needle: String = key + "=";
    let nn: Int = chars_len(needle);
    let mut i: Int = 0;
    while i + nn <= n {
        if str_slice(text, i, i + nn) == needle {
            let mut j: Int = i + nn;
            let mut buf: String = "";
            while j < n {
                let c: String = char_at(text, j);
                if c == "\n" {
                    return buf;
                }
                buf = buf + c;
                j = j + 1;
            }
            return buf;
        }
        i = i + 1;
    }
    return "";
}

fn baseline_int_field(text: String, key: String) -> Int {
    let v: String = baseline_field(text, key);
    let n: Int = chars_len(v);
    if n == 0 {
        return 0;
    }
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(v, i);
        if c == "0" { acc = acc * 10; }
        else if c == "1" { acc = acc * 10 + 1; }
        else if c == "2" { acc = acc * 10 + 2; }
        else if c == "3" { acc = acc * 10 + 3; }
        else if c == "4" { acc = acc * 10 + 4; }
        else if c == "5" { acc = acc * 10 + 5; }
        else if c == "6" { acc = acc * 10 + 6; }
        else if c == "7" { acc = acc * 10 + 7; }
        else if c == "8" { acc = acc * 10 + 8; }
        else if c == "9" { acc = acc * 10 + 9; }
        else { return acc; }
        i = i + 1;
    }
    return acc;
}

pub fn baseline_serialize(b: BaselineRecord) -> String {
    let mut out: String = "";
    out = out + "name=" + b.name + "\n";
    out = out + "efficiency_milli=" + (b).efficiency_milli.to_string() + "\n";
    out = out + "sample_count=" + (b).sample_count.to_string() + "\n";
    out = out + "saved_at_ms=" + (b).saved_at_ms.to_string() + "\n";
    out = out + "source=" + b.source + "\n";
    out = out + "pricing_name=" + b.pricing_name + "\n";
    out = out + "pricing_source=" + b.pricing_source + "\n";
    out = out + "estimator_name=" + b.estimator_name + "\n";
    out = out + "estimator_bpt_x1000=" + (b).estimator_bpt_x1000.to_string() + "\n";
    out = out + "estimator_samples=" + (b).estimator_samples.to_string() + "\n";
    return out;
}

pub fn baseline_deserialize(text: String) -> BaselineRecord {
    let name: String = baseline_field(text, "name");
    let eff: Int = baseline_int_field(text, "efficiency_milli");
    let count: Int = baseline_int_field(text, "sample_count");
    let at: Int = baseline_int_field(text, "saved_at_ms");
    let source: String = baseline_field(text, "source");
    let pn: String = baseline_field(text, "pricing_name");
    let ps: String = baseline_field(text, "pricing_source");
    let en: String = baseline_field(text, "estimator_name");
    let ebpt: Int = baseline_int_field(text, "estimator_bpt_x1000");
    let es: Int = baseline_int_field(text, "estimator_samples");
    if name == "" {
        return baseline_default();
    }
    if eff <= 0 {
        return baseline_default();
    }
    return BaselineRecord {
        name: name,
        efficiency_milli: eff,
        sample_count: count,
        saved_at_ms: at,
        source: source,
        pricing_name: pn,
        pricing_source: ps,
        estimator_name: en,
        estimator_bpt_x1000: ebpt,
        estimator_samples: es
    };
}

pub fn baseline_load(fs: &FsReadCap, path: String) -> BaselineRecord {
    if path == "" {
        return baseline_default();
    }
    if !path_exists(fs, path) {
        return baseline_default();
    }
    let tr: Result[String, String] = read_file(fs, path);
    if tr.is_err() {
        return baseline_default();
    }
    let text: String = match tr { Ok(s) => s, Err(m) => m };
    return baseline_deserialize(text);
}

pub fn baseline_save(fs_w: &FsWriteCap, path: String, b: BaselineRecord) -> String {
    let text: String = baseline_serialize(b);
    let r: Result[Void, String] = write_file(fs_w, path, text);
    if r.is_err() {
        return "fail";
    }
    return "ok";
}

pub fn baseline_save_ok(fs_w: &FsWriteCap, path: String, b: BaselineRecord) -> Bool {
    let result: String = baseline_save(fs_w, path, b);
    if result == "ok" {
        return true;
    }
    return false;
}

pub fn baseline_to_json(b: BaselineRecord) -> String {
    let mut out: String = "{";
    out = out + "\"name\":\"" + b.name + "\"";
    out = out + ",\"efficiency_milli\":" + (b).efficiency_milli.to_string();
    out = out + ",\"sample_count\":" + (b).sample_count.to_string();
    out = out + ",\"saved_at_ms\":" + (b).saved_at_ms.to_string();
    out = out + ",\"source\":\"" + b.source + "\"";
    out = out + ",\"pricing_name\":\"" + b.pricing_name + "\"";
    out = out + ",\"pricing_source\":\"" + b.pricing_source + "\"";
    out = out + ",\"estimator_name\":\"" + b.estimator_name + "\"";
    out = out + ",\"estimator_bpt_x1000\":" + (b).estimator_bpt_x1000.to_string();
    out = out + ",\"estimator_samples\":" + (b).estimator_samples.to_string();
    out = out + "}";
    return out;
}
