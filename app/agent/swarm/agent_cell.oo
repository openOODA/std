// # Agent Execution Cell Module
//
// Logline: Capability-bounded agent cell maintaining lifecycle states, bounded FIFO inbox, and fuel accounting.
//
// Setup: Isolated agent cell transitions under ThreadCap. Bounded FIFO message buffer and fuel tracking fail closed.
//
// Beats:
//   1. Define lifecycle states: IDLE, OBSERVE, ORIENT, DECIDE, ACT, CRASHED, TERMINATED.
//   2. Define AgentCaps, AgentRole, and AgentCell data structures.
//   3. Implement bounded FIFO inbox queue operations (enqueue, dequeue) failing closed.
//   4. Implement fuel budget allocation, deduction, and exhaustion checks.
//   5. Implement deterministic lifecycle state machine transitions and sub-2ms reset.

import "std/core/primitives/list.oo";

pub type AgentCaps = struct {
    can_read: Bool,
    can_write: Bool,
    can_exec: Bool,
    can_eval: Bool
};

pub type AgentRole = struct {
    name: String,
    caps: AgentCaps,
    max_fuel: Int,
    inbox_cap: Int
};

pub type AgentCell = struct {
    id: Int,
    role: AgentRole,
    state: Int,
    inbox: List[String],
    max_inbox_depth: Int,
    fuel_remaining: Int,
    fuel_consumed: Int,
    last_error: String
};

pub type AgentPopResult = struct {
    cell: AgentCell,
    msg: String
};

pub fn agent_state_idle() -> Int { return 0; }
pub fn agent_state_observe() -> Int { return 1; }
pub fn agent_state_orient() -> Int { return 2; }
pub fn agent_state_decide() -> Int { return 3; }
pub fn agent_state_act() -> Int { return 4; }
pub fn agent_state_crashed() -> Int { return 5; }
pub fn agent_state_terminated() -> Int { return 6; }

pub fn agent_state_name(st: Int) -> String {
    if st == 0 { return "IDLE"; }
    if st == 1 { return "OBSERVE"; }
    if st == 2 { return "ORIENT"; }
    if st == 3 { return "DECIDE"; }
    if st == 4 { return "ACT"; }
    if st == 5 { return "CRASHED"; }
    if st == 6 { return "TERMINATED"; }
    return "UNKNOWN";
}

pub fn agent_caps_new(can_read: Bool, can_write: Bool, can_exec: Bool, can_eval: Bool) -> AgentCaps {
    return AgentCaps {
        can_read: can_read,
        can_write: can_write,
        can_exec: can_exec,
        can_eval: can_eval
    };
}

pub fn agent_role_new(name: String, caps: AgentCaps, max_fuel: Int) -> AgentRole {
    return AgentRole {
        name: name,
        caps: caps,
        max_fuel: max_fuel,
        inbox_cap: 64
    };
}

pub fn agent_role_with_inbox(name: String, caps: AgentCaps, max_fuel: Int, inbox_cap: Int) -> AgentRole {
    let mut cap: Int = inbox_cap;
    if cap < 1 { cap = 64; }
    return AgentRole {
        name: name,
        caps: caps,
        max_fuel: max_fuel,
        inbox_cap: cap
    };
}

pub fn agent_cell_new(id: Int, role: AgentRole, max_inbox: Int) -> AgentCell {
    let mut depth: Int = max_inbox;
    if depth < 1 { depth = role.inbox_cap; }
    if depth < 1 { depth = 64; }
    let empty_inbox: List[String] = list_new();
    return AgentCell {
        id: id,
        role: role,
        state: 0,
        inbox: empty_inbox,
        max_inbox_depth: depth,
        fuel_remaining: role.max_fuel,
        fuel_consumed: 0,
        last_error: ""
    };
}

pub fn agent_cell_push_message(thread: &ThreadCap, cell: AgentCell, msg: String) -> Result[AgentCell, String] {
    let cur_len: Int = list_len(cell.inbox);
    if cur_len >= cell.max_inbox_depth {
        return Err("MAILBOX_FULL");
    }
    let new_inbox: List[String] = list_push(cell.inbox, msg);
    return Ok(AgentCell {
        id: cell.id,
        role: cell.role,
        state: cell.state,
        inbox: new_inbox,
        max_inbox_depth: cell.max_inbox_depth,
        fuel_remaining: cell.fuel_remaining,
        fuel_consumed: cell.fuel_consumed,
        last_error: cell.last_error
    });
}

pub fn agent_cell_send(thread: &ThreadCap, cell: AgentCell, msg: String) -> Result[AgentCell, String] {
    return agent_cell_push_message(thread, cell, msg);
}

pub fn agent_cell_pop_message(thread: &ThreadCap, cell: AgentCell) -> Result[AgentPopResult, String] {
    let cur_len: Int = list_len(cell.inbox);
    if cur_len == 0 {
        return Err("MAILBOX_EMPTY");
    }
    let msg: String = list_get(cell.inbox, 0);
    let mut new_inbox: List[String] = list_new();
    let mut i: Int = 1;
    while i < cur_len {
        new_inbox = list_push(new_inbox, list_get(cell.inbox, i));
        i = i + 1;
    }
    let updated_cell: AgentCell = AgentCell {
        id: cell.id,
        role: cell.role,
        state: cell.state,
        inbox: new_inbox,
        max_inbox_depth: cell.max_inbox_depth,
        fuel_remaining: cell.fuel_remaining,
        fuel_consumed: cell.fuel_consumed,
        last_error: cell.last_error
    };
    return Ok(AgentPopResult {
        cell: updated_cell,
        msg: msg
    });
}

pub fn agent_cell_pop(thread: &ThreadCap, cell: AgentCell) -> Result[AgentPopResult, String] {
    return agent_cell_pop_message(thread, cell);
}

pub fn agent_cell_consume_fuel(cell: AgentCell, cost: Int) -> Result[AgentCell, String] {
    if cost < 0 {
        return Err("INVALID_FUEL_COST");
    }
    if cost > cell.fuel_remaining {
        return Err("OUT_OF_FUEL");
    }
    return Ok(AgentCell {
        id: cell.id,
        role: cell.role,
        state: cell.state,
        inbox: cell.inbox,
        max_inbox_depth: cell.max_inbox_depth,
        fuel_remaining: cell.fuel_remaining - cost,
        fuel_consumed: cell.fuel_consumed + cost,
        last_error: cell.last_error
    });
}

pub fn agent_cell_transition(cell: AgentCell, next_state: Int) -> AgentCell {
    return AgentCell {
        id: cell.id,
        role: cell.role,
        state: next_state,
        inbox: cell.inbox,
        max_inbox_depth: cell.max_inbox_depth,
        fuel_remaining: cell.fuel_remaining,
        fuel_consumed: cell.fuel_consumed,
        last_error: cell.last_error
    };
}

pub fn agent_cell_crash(thread: &ThreadCap, cell: AgentCell, reason: String) -> AgentCell {
    return AgentCell {
        id: cell.id,
        role: cell.role,
        state: 5,
        inbox: cell.inbox,
        max_inbox_depth: cell.max_inbox_depth,
        fuel_remaining: cell.fuel_remaining,
        fuel_consumed: cell.fuel_consumed,
        last_error: reason
    };
}

pub fn agent_cell_reset(cell: AgentCell) -> AgentCell {
    return AgentCell {
        id: cell.id,
        role: cell.role,
        state: 0,
        inbox: cell.inbox,
        max_inbox_depth: cell.max_inbox_depth,
        fuel_remaining: cell.role.max_fuel,
        fuel_consumed: 0,
        last_error: ""
    };
}

pub fn agent_cell_purge_inbox(cell: AgentCell) -> AgentCell {
    let empty_inbox: List[String] = list_new();
    return AgentCell {
        id: cell.id,
        role: cell.role,
        state: cell.state,
        inbox: empty_inbox,
        max_inbox_depth: cell.max_inbox_depth,
        fuel_remaining: cell.fuel_remaining,
        fuel_consumed: cell.fuel_consumed,
        last_error: cell.last_error
    };
}
