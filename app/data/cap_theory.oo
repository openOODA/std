// # CAP Theorem (Brewer)
//
// Logline: A distributed data store can simultaneously provide at most two of Consistency, Availability, Partition tolerance.
//
// Setup: Pure Int. Each property is 1 if held. Sum must be <= 2 for a valid configuration. Hosts data_invariants.oo stem.
//
// Beats:
//   1. CAP witness: 1 if exactly two of {C, A, P} are held.
//   2. CAP rejection: 1 if all three are held (impossible).
//   3. Partition tolerance is mandatory in real distributed systems: a 0 in P combined with C+A is allowed.
//   4. Hosts data_invariants.oo stem for cross-law correlation.

import "std/app/data/data_invariants.oo";

// Property bits: 1 consistent, 2 available, 4 partition-tolerant.
pub fn cap_consistent_bit() -> Int {
    return 1;
}

pub fn cap_available_bit() -> Int {
    return 2;
}

pub fn cap_partition_bit() -> Int {
    return 4;
}

// Count of CAP bits set in mask.
fn capc_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn cap_count(mask: Int) -> Result[Int, String] {
    if mask < 0 { return Err("ERR\tcapc\tdomain"); }
    let mut c: Int = 0;
    if (mask & cap_consistent_bit()) != 0 { c = c + 1; }
    if (mask & cap_available_bit()) != 0 { c = c + 1; }
    if (mask & cap_partition_bit()) != 0 { c = c + 1; }
    return Ok(c);
}

// CAP witness: 1 if exactly two of the three are held (no all-three impossible state).
pub fn cap_two_of_three(mask: Int) -> Int {
    let cr: Result[Int, String] = cap_count(mask);
    if cr.is_ok() == false { return 0; }
    if capc_got(cr) == 2 { return 1; }
    return 0;
}

pub fn cap_three_of_three(mask: Int) -> Int {
    let cr: Result[Int, String] = cap_count(mask);
    if cr.is_ok() == false { return 0; }
    if capc_got(cr) == 3 { return 1; }
    return 0;
}

pub fn cap_ca_pair(mask: Int) -> Int {
    let cr: Result[Int, String] = cap_count(mask);
    if cr.is_ok() == false { return 0; }
    if capc_got(cr) != 2 { return 0; }
    if (mask & cap_consistent_bit()) == 0 { return 0; }
    if (mask & cap_available_bit()) == 0 { return 0; }
    if (mask & cap_partition_bit()) != 0 { return 0; }
    return 1;
}

// KAT and hostile cases for the CAP theorem.
pub fn verify_cap_theory() -> Bool {
    let data_inv_ok: Int = data_table_ok("orders");
    if data_inv_ok != 1 { return false; }
    if cap_two_of_three(3) != 1 { return false; }
    if cap_two_of_three(5) != 1 { return false; }
    if cap_two_of_three(6) != 1 { return false; }
    if cap_two_of_three(7) != 0 { return false; }
    if cap_two_of_three(1) != 0 { return false; }
    if cap_two_of_three(0) != 0 { return false; }
    if cap_two_of_three(0 - 1) != 0 { return false; }
    if cap_three_of_three(7) != 1 { return false; }
    if cap_three_of_three(0) != 0 { return false; }
    if cap_three_of_three(3) != 0 { return false; }
    if cap_three_of_three(0 - 1) != 0 { return false; }
    if cap_ca_pair(3) != 1 { return false; }
    if cap_ca_pair(5) != 0 { return false; }
    if cap_ca_pair(6) != 0 { return false; }
    if cap_ca_pair(7) != 0 { return false; }
    if cap_ca_pair(0) != 0 { return false; }
    if cap_ca_pair(0 - 1) != 0 { return false; }
    let zcap: Result[Int, String] = cap_count(0);
    if zcap.is_ok() == false { return false; }
    if capc_got(zcap) != 0 { return false; }
    if capc_got(cap_count(7)) != 3 { return false; }
    if cap_count(0 - 1).is_ok() { return false; }
    return true;
}
