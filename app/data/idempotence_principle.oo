// # Idempotence Principle
//
// Logline: Performing the same operation multiple times has the same effect as performing it once.
//
// Setup: Pure Int. f applied n times must equal f applied once. Hosts data_invariants.oo stem.
//
// Beats:
//   1. Idempotent composition: apply n times yields the same result as apply once.
//   2. Idempotence witness: 1 if f^n(x) == f(x) for all n >= 1.
//   3. Idempotence violation: 1 if some application changes the result.
//   4. Hosts data_invariants.oo stem for cross-law correlation.

import "std/app/data/data_invariants.oo";

fn idc_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Compose increment by n: x' = x + n*step. n=0 or step=0 is Ok(x). n<0 is Err.
pub fn idem_compose_add(x: Int, n: Int, step: Int) -> Result[Int, String] {
    if n < 0 { return Err("ERR\tidc\tdomain"); }
    if step == 0 { return Ok(x); }
    return Ok(x + (n * step));
}

// Idempotent addition: step == 0 means add-idempotent.
pub fn idem_add_idempotent(x: Int, step: Int) -> Bool {
    if step == 0 { return true; }
    return false;
}

// Idempotence witness for a generic map: 1 if f_n(x) == f(x) for n = 2.
pub fn idem_witness_apply_twice(x: Int, f_x: Int, f_f_x: Int) -> Int {
    if f_x == f_f_x { return 1; }
    return 0;
}

// Idempotence violation: 1 if f changes the state when applied to a fixed point.
pub fn idem_fixed_point_change(fixed_x: Int, f_x: Int) -> Int {
    if fixed_x < 0 { return 0; }
    if f_x != fixed_x { return 1; }
    return 0;
}

// KAT and hostile cases for the idempotence principle.
pub fn verify_idempotence_principle() -> Bool {
    let data_inv_ok: Int = data_table_ok("orders");
    if data_inv_ok != 1 { return false; }
    if idem_add_idempotent(5, 0) == false { return false; }
    if idem_add_idempotent(5, 1) == true { return false; }
    if idem_add_idempotent(5, 0 - 1) == true { return false; }
    let zadd: Result[Int, String] = idem_compose_add(5, 0, 3);
    if zadd.is_ok() == false { return false; }
    if idc_got(zadd) != 5 { return false; }
    if idc_got(idem_compose_add(5, 1, 3)) != 8 { return false; }
    if idc_got(idem_compose_add(5, 2, 3)) != 11 { return false; }
    if idc_got(idem_compose_add(5, 3, 0)) != 5 { return false; }
    if idem_compose_add(5, 0 - 1, 3).is_ok() { return false; }
    if idem_witness_apply_twice(5, 5, 5) != 1 { return false; }
    if idem_witness_apply_twice(5, 6, 5) != 0 { return false; }
    if idem_witness_apply_twice(5, 5, 6) != 0 { return false; }
    if idem_fixed_point_change(7, 7) != 0 { return false; }
    if idem_fixed_point_change(7, 8) != 1 { return false; }
    if idem_fixed_point_change(7, 6) != 1 { return false; }
    if idem_fixed_point_change(0 - 1, 7) != 0 { return false; }
    return true;
}
