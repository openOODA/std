// # Unified Spatial Coordinate Transformation Pipeline
//
// Logline: Transforms coordinates between Geodetic (WGS84), Geocentric (ECEF), and Topocentric (ENU/NED) frames.
//
// Setup: 3D geodesy transformations and 7-parameter Helmert datum transformation models importing wgs84_coords.oo.
//
// Beats:
//   1. Convert geodetic coordinates to Earth-Centered Earth-Fixed (ECEF) Cartesian coordinates.
//   2. Convert ECEF coordinates to local East-North-Up (ENU) topocentric coordinates.
//   3. Apply 7-parameter Helmert transformation for regional datum shifting.

import "./wgs84_coords.oo";

type TransformPoint3D = struct {
    x: Float,
    y: Float,
    z: Float
};

type HelmertParams = struct {
    dx: Float,
    dy: Float,
    dz: Float,
    rx_arcsec: Float,
    ry_arcsec: Float,
    rz_arcsec: Float,
    scale_ppm: Float
};

pub fn transform_point3d_new(x: Float, y: Float, z: Float) -> TransformPoint3D {
    return TransformPoint3D { x: x, y: y, z: z };
}

pub fn transform_wgs84_to_ecef(
    lat_deg: Float,
    lon_deg: Float,
    alt_m: Float
) -> TransformPoint3D {
    let ellip: Wgs84Ellipsoid = wgs84_ellipsoid_default();
    let a: Float = ellip.semi_major_a;
    let e_sq: Float = ellip.ecc_sq;

    let lat_rad: Float = wgs84_deg2rad(lat_deg);
    let lon_rad: Float = wgs84_deg2rad(lon_deg);

    let sin_lat: Float = sin(lat_rad);
    let cos_lat: Float = cos(lat_rad);
    let sin_lon: Float = sin(lon_rad);
    let cos_lon: Float = cos(lon_rad);

    let n_radius: Float = a / sqrt(1.0 - (e_sq * sin_lat * sin_lat));

    let x: Float = (n_radius + alt_m) * cos_lat * cos_lon;
    let y: Float = (n_radius + alt_m) * cos_lat * sin_lon;
    let z: Float = ((n_radius * (1.0 - e_sq)) + alt_m) * sin_lat;

    return TransformPoint3D { x: x, y: y, z: z };
}

pub fn transform_ecef_to_enu(
    dx: Float,
    dy: Float,
    dz: Float,
    ref_lat_deg: Float,
    ref_lon_deg: Float
) -> TransformPoint3D {
    let lat_rad: Float = wgs84_deg2rad(ref_lat_deg);
    let lon_rad: Float = wgs84_deg2rad(ref_lon_deg);

    let sin_lat: Float = sin(lat_rad);
    let cos_lat: Float = cos(lat_rad);
    let sin_lon: Float = sin(lon_rad);
    let cos_lon: Float = cos(lon_rad);

    let east: Float = (0.0 - (sin_lon * dx)) + (cos_lon * dy);
    let north: Float = (0.0 - (sin_lat * cos_lon * dx)) - (sin_lat * sin_lon * dy) + (cos_lat * dz);
    let up: Float = (cos_lat * cos_lon * dx) + (cos_lat * sin_lon * dy) + (sin_lat * dz);

    return TransformPoint3D { x: east, y: north, z: up };
}

pub fn transform_helmert_7param(
    pt: TransformPoint3D,
    p: HelmertParams
) -> TransformPoint3D {
    let s: Float = 1.0 + (p.scale_ppm / 1000000.0);
    let sec2rad: Float = wgs84_math_pi() / (180.0 * 3600.0);
    let rx: Float = p.rx_arcsec * sec2rad;
    let ry: Float = p.ry_arcsec * sec2rad;
    let rz: Float = p.rz_arcsec * sec2rad;

    let x: Float = p.dx + (s * (pt.x - (rz * pt.y) + (ry * pt.z)));
    let y: Float = p.dy + (s * ((rz * pt.x) + pt.y - (rx * pt.z)));
    let z: Float = p.dz + (s * ((0.0 - (ry * pt.x)) + (rx * pt.y) + pt.z));

    return TransformPoint3D { x: x, y: y, z: z };
}
