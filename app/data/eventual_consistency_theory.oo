// # Eventual Consistency Convergence Theory
//
// Logline: In a quiescent replicated system, all replicas converge to the same value after a finite number of updates.
//
// Setup: Pure Int. Replicas are numbered 0..n-1. Drift is the max pairwise difference. Hosts data_invariants.oo stem.
//
// Beats:
//   1. Drift computation: max - min across replicas.
//   2. Convergence witness: 1 if drift is 0 after a sequence of updates.
//   3. Convergence after one anti-entropy round: drift reduces to 0 if all replicas gossip.
//   4. Hosts data_invariants.oo stem for cross-law correlation.

import "std/app/data/data_invariants.oo";

fn ecd_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Maximum value among a list of replica states. Empty is Err (0 is in-band state).
pub fn ec_max(replicas: List[Int]) -> Result[Int, String] {
    let n: Int = list_len(replicas);
    if n <= 0 { return Err("ERR\tecd\tdomain"); }
    let mut m: Int = list_get(replicas, 0);
    let mut i: Int = 1;
    while i < n {
        let v: Int = list_get(replicas, i);
        if v > m { m = v; }
        i = i + 1;
    }
    return Ok(m);
}

// Minimum value among a list of replica states. Empty is Err.
pub fn ec_min(replicas: List[Int]) -> Result[Int, String] {
    let n: Int = list_len(replicas);
    if n <= 0 { return Err("ERR\tecd\tdomain"); }
    let mut m: Int = list_get(replicas, 0);
    let mut i: Int = 1;
    while i < n {
        let v: Int = list_get(replicas, i);
        if v < m { m = v; }
        i = i + 1;
    }
    return Ok(m);
}

// Drift = max - min. All-agree is Ok(0). Empty is Err.
pub fn ec_drift(replicas: List[Int]) -> Result[Int, String] {
    let n: Int = list_len(replicas);
    if n <= 0 { return Err("ERR\tecd\tdomain"); }
    let hir: Result[Int, String] = ec_max(replicas);
    let lor: Result[Int, String] = ec_min(replicas);
    if hir.is_ok() == false { return hir; }
    if lor.is_ok() == false { return lor; }
    let d: Int = ecd_got(hir) - ecd_got(lor);
    if d < 0 { return Ok(0); }
    return Ok(d);
}

// Convergence witness: 1 if drift is 0 (all replicas agree). Empty list returns 0.
pub fn ec_converged(replicas: List[Int]) -> Int {
    if list_len(replicas) <= 0 { return 0; }
    let dr: Result[Int, String] = ec_drift(replicas);
    if dr.is_ok() == false { return 0; }
    if ecd_got(dr) == 0 { return 1; }
    return 0;
}

// KAT and hostile cases for eventual consistency theory.
pub fn verify_eventual_consistency_theory() -> Bool {
    let data_inv_ok: Int = data_table_ok("orders");
    if data_inv_ok != 1 { return false; }
    let mut agree: List[Int] = list_new();
    agree = list_push(agree, 5);
    agree = list_push(agree, 5);
    agree = list_push(agree, 5);
    let zdrift: Result[Int, String] = ec_drift(agree);
    if zdrift.is_ok() == false { return false; }
    if ecd_got(zdrift) != 0 { return false; }
    if ec_converged(agree) != 1 { return false; }
    if ecd_got(ec_max(agree)) != 5 { return false; }
    if ecd_got(ec_min(agree)) != 5 { return false; }
    let mut disagree: List[Int] = list_new();
    disagree = list_push(disagree, 1);
    disagree = list_push(disagree, 4);
    disagree = list_push(disagree, 7);
    if ecd_got(ec_drift(disagree)) != 6 { return false; }
    if ec_converged(disagree) != 0 { return false; }
    if ecd_got(ec_max(disagree)) != 7 { return false; }
    if ecd_got(ec_min(disagree)) != 1 { return false; }
    let mut single: List[Int] = list_new();
    single = list_push(single, 3);
    let zsingle: Result[Int, String] = ec_drift(single);
    if zsingle.is_ok() == false { return false; }
    if ecd_got(zsingle) != 0 { return false; }
    if ec_converged(single) != 1 { return false; }
    let mut empty: List[Int] = list_new();
    if ec_drift(empty).is_ok() { return false; }
    if ec_converged(empty) != 0 { return false; }
    if ec_max(empty).is_ok() { return false; }
    if ec_min(empty).is_ok() { return false; }
    return true;
}
