// # Vector Generalized Minkowski Lp Distance Metric
//
// Logline: Implements generalized Minkowski Lp distance metric evaluation with integer powers.
//
// Setup: Provides parameterized Lp vector distance computation interpolating between Manhattan, Euclidean, and Chebyshev norms.
//
// Beats:
//   1. Define MinkowskiConfig, PowerAccumulator, and MinkowskiDistanceResult structures.
//   2. Implement integer power exponentiation and absolute difference accumulation.
//   3. Implement Minkowski distance comparison for general metric space indexing.

type MinkowskiConfig = struct {
    p_norm_power: Int,
    dimension: Int
};

type PowerAccumulator = struct {
    accumulated_power_sum: Int,
    dimensions_processed: Int
};

type MinkowskiDistanceResult = struct {
    raw_p_sum: Int,
    p_power: Int
};

pub fn minkowski_config_default(p: Int, dim: Int) -> MinkowskiConfig {
    return MinkowskiConfig {
        p_norm_power: p,
        dimension: dim
    };
}

pub fn int_pow(base: Int, exp: Int) -> Int {
    if exp <= 0 {
        return 1;
    }
    let mut res: Int = 1;
    let mut i: Int = 0;
    while i < exp {
        res = res * base;
        i = i + 1;
    }
    return res;
}

pub fn compute_minkowski_p_sum(
    vec_a: List[Int],
    vec_b: List[Int],
    p: Int
) -> MinkowskiDistanceResult {
    let dim: Int = list_len(vec_a);
    let mut sum_p: Int = 0;
    let mut i: Int = 0;

    while i < dim && i < list_len(vec_b) {
        let diff: Int = list_get(vec_a, i) - list_get(vec_b, i);
        let mut abs_diff: Int = 0 - diff;
        if diff >= 0 {
            abs_diff = diff;
        }
        let power_val: Int = int_pow(abs_diff, p);
        sum_p = sum_p + power_val;
        i = i + 1;
    }

    return MinkowskiDistanceResult {
        raw_p_sum: sum_p,
        p_power: p
    };
}
