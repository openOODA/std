// # Product Quantization Asymmetric Distance Engine (ADC/SDC)
//
// Logline: Implements Asymmetric Distance Computation (ADC) and Symmetric Distance Computation (SDC) for PQ.
//
// Setup: Computes exact uncompressed query to quantized database vector distances without decompression overhead.
//
// Beats:
//   1. Define PqDistanceTable, PqSearchQuery, and AdcEngine structures.
//   2. Implement Asymmetric Distance precomputation table from uncompressed query vector.
//   3. Implement fast database candidate scoring with LUT index lookup.

type PqDistanceTable = struct {
    num_subspaces: Int,
    centroids_per_subspace: Int,
    subspace_dimension: Int,
    distance_grid: List[List[Int]]
};

type PqSearchQuery = struct {
    query_id: Int,
    raw_query_vector: List[Int],
    distance_table: PqDistanceTable
};

type AdcEngine = struct {
    num_subspaces: Int,
    subspace_dim: Int,
    is_symmetric_mode: Bool
};

pub fn adc_engine_new(n_sub: Int, sub_d: Int) -> AdcEngine {
    return AdcEngine {
        num_subspaces: n_sub,
        subspace_dim: sub_d,
        is_symmetric_mode: false
    };
}

pub fn pq_build_adc_table(
    query_vec: List[Int],
    codebooks: List[List[List[Int]]],
    n_sub: Int,
    sub_dim: Int
) -> PqDistanceTable {
    let mut grid: List[List[Int]] = list_new();
    let mut m: Int = 0;

    while m < n_sub {
        let mut sub_distances: List[Int] = list_new();
        let mut sub_cents: List[List[Int]] = list_new();
        if m < list_len(codebooks) {
            sub_cents = list_get(codebooks, m);
        }

        let num_c: Int = list_len(sub_cents);
        let mut c: Int = 0;
        while c < num_c {
            let cent: List[Int] = list_get(sub_cents, c);
            let mut l2_sq: Int = 0;
            let mut d: Int = 0;
            while d < sub_dim {
                let q_idx: Int = (m * sub_dim) + d;
                let mut q_val: Int = 0;
                if q_idx < list_len(query_vec) {
                    q_val = list_get(query_vec, q_idx);
                }
                let mut c_val: Int = 0;
                if d < list_len(cent) {
                    c_val = list_get(cent, d);
                }
                let diff: Int = q_val - c_val;
                l2_sq = l2_sq + (diff * diff);
                d = d + 1;
            }
            sub_distances = list_push(sub_distances, l2_sq);
            c = c + 1;
        }

        grid = list_push(grid, sub_distances);
        m = m + 1;
    }

    return PqDistanceTable {
        num_subspaces: n_sub,
        centroids_per_subspace: 256,
        subspace_dimension: sub_dim,
        distance_grid: grid
    };
}

pub fn pq_compute_adc_distance(
    table: PqDistanceTable,
    database_codes: List[Int]
) -> Int {
    let mut total_dist: Int = 0;
    let n_sub: Int = table.num_subspaces;
    let grid: List[List[Int]] = table.distance_grid;

    let mut m: Int = 0;
    while m < n_sub && m < list_len(database_codes) {
        let code: Int = list_get(database_codes, m);
        if m < list_len(grid) {
            let sub_grid: List[Int] = list_get(grid, m);
            if code >= 0 && code < list_len(sub_grid) {
                total_dist = total_dist + list_get(sub_grid, code);
            }
        }
        m = m + 1;
    }

    return total_dist;
}
