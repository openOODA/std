// # Memory-Mapped (mmap) Vector Storage & Page Reader
//
// Logline: Implements memory-mapped sequential vector store and page-aligned binary vector reader.
//
// Setup: Provides low-overhead sequential access to out-of-core disk-backed vector arrays.
//
// Beats:
//   1. Define MmapStoreConfig, VectorPageHeader, and MmapVectorStore structures.
//   2. Implement page index calculation and vector offset resolution.
//   3. Implement sequential page scanning and buffer fetch routines.

type MmapStoreConfig = struct {
    page_size_bytes: Int,
    dimension: Int,
    vectors_per_page: Int
};

type VectorPageHeader = struct {
    page_id: Int,
    start_vector_id: Int,
    num_vectors: Int
};

type MmapVectorStore = struct {
    config: MmapStoreConfig,
    pages: List[VectorPageHeader],
    total_vectors: Int
};

pub fn mmap_store_config_default(dim: Int) -> MmapStoreConfig {
    let bytes_per_vec: Int = dim * 4;
    let mut v_per_p: Int = 1;
    if bytes_per_vec > 0 {
        v_per_p = 4096 / bytes_per_vec;
    }
    let mut final_v: Int = 1;
    if v_per_p > 0 {
        final_v = v_per_p;
    }

    return MmapStoreConfig {
        page_size_bytes: 4096,
        dimension: dim,
        vectors_per_page: final_v
    };
}

pub fn mmap_vector_store_new(cfg: MmapStoreConfig) -> MmapVectorStore {
    return MmapVectorStore {
        config: cfg,
        pages: list_new(),
        total_vectors: 0
    };
}

pub fn mmap_resolve_vector_page(
    store: MmapVectorStore,
    vid: Int
) -> Int {
    let v_per_page: Int = (store.config).vectors_per_page;
    return if v_per_page > 0 { vid / v_per_page } else { 0 };
}
