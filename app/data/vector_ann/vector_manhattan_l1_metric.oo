// # Vector Manhattan L1 / Taxicab Distance Metric
//
// Logline: Implements Manhattan L1 / Taxicab distance calculator for sparse and dense embeddings.
//
// Setup: Computes sum of absolute dimension differences between vectors for robust outlier-resistant similarity.
//
// Beats:
//   1. Define ManhattanMetricConfig, ManhattanDistanceResult, and VectorL1Evaluator structures.
//   2. Implement absolute difference summation kernel.
//   3. Implement early exit threshold evaluation for Manhattan distance.

type ManhattanMetricConfig = struct {
    dimension: Int,
    early_exit_threshold: Int
};

type ManhattanDistanceResult = struct {
    distance_l1: Int,
    is_pruned: Bool
};

type VectorL1Evaluator = struct {
    config: ManhattanMetricConfig,
    total_evaluations: Int
};

pub fn manhattan_metric_config_default(dim: Int) -> ManhattanMetricConfig {
    return ManhattanMetricConfig {
        dimension: dim,
        early_exit_threshold: 2147483647
    };
}

pub fn vector_l1_evaluator_new(cfg: ManhattanMetricConfig) -> VectorL1Evaluator {
    return VectorL1Evaluator {
        config: cfg,
        total_evaluations: 0
    };
}

pub fn compute_manhattan_l1_distance(
    vec_a: List[Int],
    vec_b: List[Int]
) -> Int {
    let dim: Int = list_len(vec_a);
    let mut sum_abs: Int = 0;
    let mut i: Int = 0;

    while i < dim && i < list_len(vec_b) {
        let diff: Int = list_get(vec_a, i) - list_get(vec_b, i);
        let mut abs_diff: Int = 0 - diff;
        if diff >= 0 {
            abs_diff = diff;
        }
        sum_abs = sum_abs + abs_diff;
        i = i + 1;
    }

    return sum_abs;
}

pub fn compute_manhattan_with_threshold(
    vec_a: List[Int],
    vec_b: List[Int],
    max_threshold: Int
) -> ManhattanDistanceResult {
    let dim: Int = list_len(vec_a);
    let mut sum_abs: Int = 0;
    let mut i: Int = 0;
    let mut pruned: Bool = false;

    while i < dim && i < list_len(vec_b) && !pruned {
        let diff: Int = list_get(vec_a, i) - list_get(vec_b, i);
        let mut abs_diff: Int = 0 - diff;
        if diff >= 0 {
            abs_diff = diff;
        }
        sum_abs = sum_abs + abs_diff;
        if sum_abs > max_threshold {
            pruned = true;
        }
        i = i + 1;
    }

    return ManhattanDistanceResult {
        distance_l1: sum_abs,
        is_pruned: pruned
    };
}
