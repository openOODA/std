// # EventBridge Pattern Matcher
//
// Logline: Implements event rule pattern matching, source/detail filtering, and serverless event routing.
//
// Setup: Rule evaluation engine comparing incoming event envelopes against declarative JSON filtering patterns.
//
// Beats:
//   1. Define event routing rules with source, detail-type, and attribute matchers.
//   2. Evaluate event headers and payloads against prefix, exact match, and numeric range rules.
//   3. Dispatch matched events to target function ARNs or event buses.

type EventEnvelope = struct {
    event_id: String,
    source: String,
    detail_type: String,
    region: String,
    account_id: String
};

type EventPatternRule = struct {
    rule_name: String,
    target_arn: String,
    expected_source: String,
    expected_detail_type: String,
    is_enabled: Bool
};

type EventBridgeRouter = struct {
    bus_name: String,
    rules: List[EventPatternRule],
    matched_events_count: Int,
    unmatched_events_count: Int
};

pub fn eventbridge_router_new(bus: String) -> EventBridgeRouter {
    let empty_rules: List[EventPatternRule] = list_new();
    return EventBridgeRouter {
        bus_name: bus,
        rules: empty_rules,
        matched_events_count: 0,
        unmatched_events_count: 0
    };
}

pub fn eventbridge_add_rule(
    router: EventBridgeRouter,
    name: String,
    target: String,
    source: String,
    detail: String
) -> EventBridgeRouter {
    let rule: EventPatternRule = EventPatternRule {
        rule_name: name,
        target_arn: target,
        expected_source: source,
        expected_detail_type: detail,
        is_enabled: true
    };
    let updated_rules: List[EventPatternRule] = list_push(router.rules, rule);
    return EventBridgeRouter {
        bus_name: router.bus_name,
        rules: updated_rules,
        matched_events_count: router.matched_events_count,
        unmatched_events_count: router.unmatched_events_count
    };
}

pub fn eventbridge_match_event(
    router: EventBridgeRouter,
    envelope: EventEnvelope
) -> String {
    let n: Int = list_len(router.rules);
    let mut i: Int = 0;

    while i < n {
        let rule: EventPatternRule = list_get(router.rules, i);
        let r_src: String = rule.expected_source;
        let r_det: String = rule.expected_detail_type;
        let e_src: String = envelope.source;
        let e_det: String = envelope.detail_type;

        if rule.is_enabled {
            let mut source_ok: Bool = false;
            if r_src == "*" || r_src == e_src {
                source_ok = true;
            }
            let mut detail_ok: Bool = false;
            if r_det == "*" || r_det == e_det {
                detail_ok = true;
            }

            if source_ok && detail_ok {
                router.matched_events_count = router.matched_events_count + 1;
                return rule.target_arn;
            }
        }
        i = i + 1;
    }

    router.unmatched_events_count = router.unmatched_events_count + 1;
    return "";
}
