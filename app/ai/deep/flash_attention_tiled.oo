// # Tiled Memory-Efficient FlashAttention-2 Forward Kernel
//
// Logline: Implements tiled FlashAttention-2 with online running-max softmax scaling, causal masking, and multi-head attention under AiCap.
//
// Setup: Requires &AiCap capability token for accelerated neural attention operations.
//
// Beats:
//   1. Maintain running max and normalizer state for online softmax accumulation.
//   2. Compute tiled Query-Key-Value dot products across SRAM tile blocks (Br x Bc).
//   3. Apply causal masking to prevent future token attention leakage.
//   4. Execute full multi-head FlashAttention-2 forward pass under &AiCap.

type AiCap = struct {};

type FlashAttentionConfig = struct {
    seq_len: Int,
    head_dim: Int,
    num_heads: Int,
    block_m: Int,
    block_n: Int,
    scale: Float,
    is_causal: Bool
};

type FlashOnlineState = struct {
    m_val: Float,
    l_val: Float
};

pub fn flash_ai_cap_grant() -> AiCap {
    return AiCap {};
}

pub fn flash_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn flash_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = x;
    if g > 100.0 { g = 10.0; }
    let mut i: Int = 0;
    while i < 10 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn flash_config_new(seq_len: Int, head_dim: Int, num_heads: Int, bm: Int, bn: Int, is_causal: Bool) -> FlashAttentionConfig {
    let scale: Float = 1.0 / flash_sqrt(flash_int_to_float(head_dim));
    return FlashAttentionConfig {
        seq_len: seq_len,
        head_dim: head_dim,
        num_heads: num_heads,
        block_m: bm,
        block_n: bn,
        scale: scale,
        is_causal: is_causal
    };
}

pub fn flash_online_update(m_prev: Float, l_prev: Float, m_curr: Float, l_curr: Float) -> FlashOnlineState {
    let mut m_new: Float = m_curr;
    if m_prev > m_curr {
        m_new = m_prev;
    }
    let term_prev: Float = l_prev * exp(m_prev - m_new);
    let term_curr: Float = l_curr * exp(m_curr - m_new);
    let l_new: Float = term_prev + term_curr;
    return FlashOnlineState {
        m_val: m_new,
        l_val: l_new
    };
}

pub fn flash_attention_tile_forward(
    ai: &AiCap,
    q_tile: List[Float],
    k_tile: List[Float],
    v_tile: List[Float],
    cfg: &FlashAttentionConfig,
    q_len: Int,
    kv_len: Int,
    start_kv: Int
) -> List[Float] {
    let hdim: Int = cfg.head_dim;
    let scale: Float = cfg.scale;
    let is_causal: Bool = cfg.is_causal;

    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < q_len {
        let mut scores: List[Float] = list_new();
        let mut max_s: Float = 0.0 - 100000.0;
        let mut j: Int = 0;
        while j < kv_len {
            let global_kv: Int = start_kv + j;
            if is_causal && (global_kv > i) {
                scores = list_push(scores, 0.0 - 100000.0);
            } else {
                let mut dot: Float = 0.0;
                let mut d: Int = 0;
                while d < hdim {
                    let q_val: Float = list_get(q_tile, (i * hdim) + d);
                    let k_val: Float = list_get(k_tile, (j * hdim) + d);
                    dot = dot + (q_val * k_val);
                    d = d + 1;
                }
                let s: Float = dot * scale;
                if s > max_s {
                    max_s = s;
                }
                scores = list_push(scores, s);
            }
            j = j + 1;
        }

        let mut sum_exp: Float = 0.0;
        let mut exp_scores: List[Float] = list_new();
        let mut j2: Int = 0;
        while j2 < kv_len {
            let s_val: Float = list_get(scores, j2);
            let mut ev: Float = 0.0;
            if s_val > (0.0 - 90000.0) {
                ev = exp(s_val - max_s);
            }
            exp_scores = list_push(exp_scores, ev);
            sum_exp = sum_exp + ev;
            j2 = j2 + 1;
        }

        let mut d_out: Int = 0;
        while d_out < hdim {
            let mut acc: Float = 0.0;
            let mut j3: Int = 0;
            while j3 < kv_len {
                let mut p: Float = 0.0;
                if sum_exp > 0.0 {
                    p = list_get(exp_scores, j3) / sum_exp;
                }
                let v_val: Float = list_get(v_tile, (j3 * hdim) + d_out);
                acc = acc + (p * v_val);
                j3 = j3 + 1;
            }
            out = list_push(out, acc);
            d_out = d_out + 1;
        }
        i = i + 1;
    }
    return out;
}

pub fn flash_attention_tiled_forward_full(
    ai: &AiCap,
    q: List[Float],
    k: List[Float],
    v: List[Float],
    seq_len: Int,
    head_dim: Int,
    is_causal: Bool
) -> List[Float] {
    let cfg: FlashAttentionConfig = flash_config_new(seq_len, head_dim, 1, seq_len, seq_len, is_causal);
    return flash_attention_tile_forward(ai, q, k, v, &cfg, seq_len, seq_len, 0);
}

pub fn flash_attention_mha_forward(
    ai: &AiCap,
    q: List[Float],
    k: List[Float],
    v: List[Float],
    seq_len: Int,
    num_heads: Int,
    head_dim: Int,
    is_causal: Bool
) -> List[Float] {
    let mut full_out: List[Float] = list_new();
    let head_size: Int = seq_len * head_dim;
    let mut h: Int = 0;
    while h < num_heads {
        let mut q_h: List[Float] = list_new();
        let mut k_h: List[Float] = list_new();
        let mut v_h: List[Float] = list_new();
        let mut idx: Int = 0;
        while idx < head_size {
            let global_idx: Int = (h * head_size) + idx;
            q_h = list_push(q_h, list_get(q, global_idx));
            k_h = list_push(k_h, list_get(k, global_idx));
            v_h = list_push(v_h, list_get(v, global_idx));
            idx = idx + 1;
        }
        let out_h: List[Float] = flash_attention_tiled_forward_full(ai, q_h, k_h, v_h, seq_len, head_dim, is_causal);
        idx = 0;
        while idx < head_size {
            full_out = list_push(full_out, list_get(out_h, idx));
            idx = idx + 1;
        }
        h = h + 1;
    }
    return full_out;
}

pub fn flash_dense_reference_attention(
    ai: &AiCap,
    q: List[Float],
    k: List[Float],
    v: List[Float],
    seq_len: Int,
    head_dim: Int,
    is_causal: Bool
) -> List[Float] {
    let cfg: FlashAttentionConfig = flash_config_new(seq_len, head_dim, 1, seq_len, seq_len, is_causal);
    return flash_attention_tile_forward(ai, q, k, v, &cfg, seq_len, seq_len, 0);
}
