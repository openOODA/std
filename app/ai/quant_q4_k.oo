// # 4-Bit Q4_K Super-Block Quantization & Matrix Multiplication
//
// Logline: Implements 256-weight Q4_K super-block quantization, sub-block scales, dot products, and GEMV/GEMM matrix routines.
//
// Setup: Pure arithmetic codec for GGML Q4_K k-quants format with 8 sub-blocks per 256 weights.
//
// Beats:
//   1. Unpack FP16 super-scale d, min-scale dmin, and 6-bit sub-block scale/min factors.
//   2. Dequantize 256 4-bit nibbles across 8 sub-blocks of 32 weights each.
//   3. Compute direct fused multiply-accumulate vector dot products.
//   4. Execute quantized matrix-vector (GEMV) and general matrix multiplication (GEMM).

type BlockQ4_K = struct {
    d: Float,
    dmin: Float,
    scales: List[Int],
    mins: List[Int],
    qs: List[Int]
};

type QuantizedTensorQ4K = struct {
    rows: Int,
    cols: Int,
    raw_data: String,
    block_count: Int
};

pub fn q4k_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 1000000 { f = f + 1000000.0; count = count - 1000000; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn q4k_float_to_int(val: Float) -> Int {
    let mut res: Int = 0;
    let mut temp: Float = val;
    if temp < 0.0 { temp = 0.0 - temp; }
    while temp >= 1000000.0 { res = res + 1000000; temp = temp - 1000000.0; }
    while temp >= 10000.0 { res = res + 10000; temp = temp - 10000.0; }
    while temp >= 100.0 { res = res + 100; temp = temp - 100.0; }
    while temp >= 1.0 { res = res + 1; temp = temp - 1.0; }
    if val < 0.0 { return 0 - res; }
    return res;
}

pub fn q4k_fp16_to_f32(h: Int) -> Float {
    let sign: Int = (h / 32768) % 2;
    let exp: Int = (h / 1024) % 32;
    let mant: Int = h % 1024;
    if exp == 0 {
        if mant == 0 { return 0.0; }
        let mut f: Float = (q4k_int_to_float(mant) / 1024.0) / 16384.0;
        if sign == 1 { f = 0.0 - f; }
        return f;
    }
    if exp == 31 { return 65504.0; }
    let mut f: Float = 1.0 + (q4k_int_to_float(mant) / 1024.0);
    let shift: Int = exp - 15;
    let mut i: Int = 0;
    if shift > 0 {
        while i < shift { f = f * 2.0; i = i + 1; }
    } else if shift < 0 {
        let neg_s: Int = 0 - shift;
        while i < neg_s { f = f / 2.0; i = i + 1; }
    }
    if sign == 1 { f = 0.0 - f; }
    return f;
}

pub fn q4k_f32_to_fp16(f: Float) -> Int {
    if f == 0.0 { return 0; }
    let mut sign: Int = 0;
    let mut val: Float = f;
    if val < 0.0 { sign = 1; val = 0.0 - val; }
    let mut exp: Int = 15;
    while val >= 2.0 && exp < 30 { val = val / 2.0; exp = exp + 1; }
    while val < 1.0 && exp > 0 { val = val * 2.0; exp = exp - 1; }
    let mant: Int = q4k_float_to_int((val - 1.0) * 1024.0);
    return (sign * 32768) + (exp * 1024) + (mant % 1024);
}

pub fn q4k_get_raw_u8(raw: String, idx: Int) -> Int {
    let b: Int = byte_at(raw, idx);
    if b < 0 { return 0; }
    return b;
}

pub fn q4_k_dequantize_block(raw: String, offset: Int) -> List[Float] {
    let b0: Int = q4k_get_raw_u8(raw, offset);
    let b1: Int = q4k_get_raw_u8(raw, offset + 1);
    let d: Float = q4k_fp16_to_f32(b0 + (b1 * 256));
    let b2: Int = q4k_get_raw_u8(raw, offset + 2);
    let b3: Int = q4k_get_raw_u8(raw, offset + 3);
    let dmin: Float = q4k_fp16_to_f32(b2 + (b3 * 256));

    let mut out: List[Float] = list_new();
    let mut sb: Int = 0;
    while sb < 8 {
        let scale_byte: Int = q4k_get_raw_u8(raw, offset + 4 + sb);
        let d_sb: Float = d * q4k_int_to_float(scale_byte % 64);
        let m_sb: Float = dmin * q4k_int_to_float((scale_byte / 64) % 64);
        let mut k: Int = 0;
        while k < 32 {
            let q_byte_idx: Int = offset + 16 + (sb * 16) + (k / 2);
            let qb: Int = q4k_get_raw_u8(raw, q_byte_idx);
            let mut q: Int = qb % 16;
            if k % 2 == 1 { q = (qb / 16) % 16; }
            let w: Float = (d_sb * q4k_int_to_float(q)) - m_sb;
            out = list_push(out, w);
            k = k + 1;
        }
        sb = sb + 1;
    }
    return out;
}

pub fn q4_k_dot_f32(raw: String, block_offset: Int, x: List[Float], x_offset: Int) -> Float {
    let b0: Int = q4k_get_raw_u8(raw, block_offset);
    let b1: Int = q4k_get_raw_u8(raw, block_offset + 1);
    let d: Float = q4k_fp16_to_f32(b0 + (b1 * 256));
    let b2: Int = q4k_get_raw_u8(raw, block_offset + 2);
    let b3: Int = q4k_get_raw_u8(raw, block_offset + 3);
    let dmin: Float = q4k_fp16_to_f32(b2 + (b3 * 256));

    let mut total_dot: Float = 0.0;
    let mut sb: Int = 0;
    while sb < 8 {
        let scale_byte: Int = q4k_get_raw_u8(raw, block_offset + 4 + sb);
        let d_sb: Float = d * q4k_int_to_float(scale_byte % 64);
        let m_sb: Float = dmin * q4k_int_to_float((scale_byte / 64) % 64);
        let mut sum_q_x: Float = 0.0;
        let mut sum_x: Float = 0.0;
        let mut k: Int = 0;
        while k < 32 {
            let elem_idx: Int = x_offset + (sb * 32) + k;
            let xv: Float = list_get(x, elem_idx);
            let q_byte_idx: Int = block_offset + 16 + (sb * 16) + (k / 2);
            let qb: Int = q4k_get_raw_u8(raw, q_byte_idx);
            let mut q: Int = qb % 16;
            if k % 2 == 1 { q = (qb / 16) % 16; }
            sum_q_x = sum_q_x + (q4k_int_to_float(q) * xv);
            sum_x = sum_x + xv;
            k = k + 1;
        }
        total_dot = total_dot + (d_sb * sum_q_x) - (m_sb * sum_x);
        sb = sb + 1;
    }
    return total_dot;
}

pub fn q4_k_matvec_mul(mat: &QuantizedTensorQ4K, x: List[Float]) -> List[Float] {
    let mut y: List[Float] = list_new();
    let blocks_per_row: Int = mat.cols / 256;
    let mut r: Int = 0;
    while r < mat.rows {
        let mut row_sum: Float = 0.0;
        let mut b: Int = 0;
        while b < blocks_per_row {
            let blk_idx: Int = (r * blocks_per_row) + b;
            let blk_offset: Int = blk_idx * 144;
            let x_off: Int = b * 256;
            row_sum = row_sum + q4_k_dot_f32(mat.raw_data, blk_offset, x, x_off);
            b = b + 1;
        }
        y = list_push(y, row_sum);
        r = r + 1;
    }
    return y;
}

pub fn q4_k_matmul(mat_a: &QuantizedTensorQ4K, mat_b: List[Float], b_cols: Int) -> List[Float] {
    let mut out: List[Float] = list_new();
    let k_dim: Int = mat_a.cols;
    let m_rows: Int = mat_a.rows;
    let mut r: Int = 0;
    while r < m_rows {
        let mut c: Int = 0;
        while c < b_cols {
            let mut col_vec: List[Float] = list_new();
            let mut k: Int = 0;
            while k < k_dim {
                col_vec = list_push(col_vec, list_get(mat_b, (k * b_cols) + c));
                k = k + 1;
            }
            let blocks_per_row: Int = k_dim / 256;
            let mut dot_acc: Float = 0.0;
            let mut b: Int = 0;
            while b < blocks_per_row {
                let blk_idx: Int = (r * blocks_per_row) + b;
                let blk_offset: Int = blk_idx * 144;
                let x_off: Int = b * 256;
                dot_acc = dot_acc + q4_k_dot_f32(mat_a.raw_data, blk_offset, col_vec, x_off);
                b = b + 1;
            }
            out = list_push(out, dot_acc);
            c = c + 1;
        }
        r = r + 1;
    }
    return out;
}
