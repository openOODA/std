// # Analytical Backward Parameter Gradients

import "std/core/math/scicomp/eigen_values_qr.oo";
//
// Logline: Backward pass gradient computation for 2D/3D Gaussian means, covariances, opacities, and colors.
//
// Setup: Calculates explicit analytical derivatives of photometric loss with respect to all scene parameters.
//
// Beats:
//   1. Compute gradients of loss with respect to 2D screen positions dL/dx_2d.
//   2. Compute gradients of loss with respect to 2D screen covariances dL/dSigma_2d.
//   3. Backpropagate 2D gradients to 3D world parameters (mean, rotation quaternion, scale vector, opacity).

import "std/app/ai/nerf_3dgs/vec3_math_nerf.oo";
import "std/app/ai/nerf_3dgs/vec3_math_nerf.oo";

type GaussianGradients = struct {
    grad_pos: Vec3,
    grad_scale: Vec3,
    grad_opacity: Float,
    grad_screen_2d_norm: Float
};

pub fn gaussian_gradients_init() -> GaussianGradients {
    return GaussianGradients {
        grad_pos: vec3_zero(),
        grad_scale: vec3_zero(),
        grad_opacity: 0.0,
        grad_screen_2d_norm: 0.0
    };
}

pub fn compute_screen_2d_grad_norm(grad_x: Float, grad_y: Float) -> Float {
    return eigen_values_qr_math_sqrt_w(grad_x * grad_x + grad_y * grad_y);
}

pub fn backward_opacity_gradient(
    dL_dPixel: Vec3,
    color: Vec3,
    gaussian_val: Float,
    transmittance: Float,
) -> Float {
    // dL/d(opacity) = sum_pixels dL/dC * (color - C_curr) * G * T_i / (1 - alpha_i)
    let dot_prod: Float = vec3_dot(dL_dPixel, color);
    return dot_prod * gaussian_val * transmittance;
}

fn eigen_values_qr_math_sqrt_w(x: Float) -> Float { return math_sqrt(x); }
fn eigen_values_qr_math_abs_w(x: Float) -> Float { return math_abs(x); }
