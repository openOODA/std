// # NTK / Lazy Regime Principle v2 (with hostile cases)
//
// Logline: In the lazy (NTK) regime, training dynamics approximate kernel gradient descent and weights barely move (Jacot-Hongler 2018). v2 adds explicit length checks BEFORE any list_get to ensure hostile inputs fail closed.
//
// Setup: Pure Float. 1-hidden ReLU net with H=1, 2D input, 2 samples. Empty or mismatched lists return Err. Zero weights produce zero NTK (flagged). This is a NEW file (v2) created because the pre-existing std/ai/ntk_lazy_regime_principle.oo omits hostile tests due to the ooda C-emit reordering early returns; v2 uses a function-based length check that the C-emit cannot reorder.
//
// RULES.oot 1.7: Under 256 lines; pure Float; no abs_f, close, or pow; uses * and -.
//
// Beats:
//   1. NTK Gram matrix: scalar kernel between input samples via parameter gradients.
//   2. Lazy regime check: 1 if NTK approximately constant (max-abs change <= tol).
//   3. Mean-field / muP coupling: NTK = J * J^T where J is the input Jacobian.
//   4. Hostile: short samples (len<4) returns Err, not OOB.
//   5. Hostile: short w (len<2) returns Err, not OOB.

import "std/app/ai/ai_invariants.oo";
import "std/core/primitives/domain_cert.oo";

pub fn aabs_ntk2(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn aclose_ntk2(a: Float, b: Float, tol: Float) -> Int {
    let mut d: Float = a - b;
    if d < 0.0 { d = 0.0 - d; }
    if d <= tol { return 1; }
    return 0;
}

pub fn ntk2_int_to_float(n: Int) -> Float {
    if n < 0 { return 0.0 - 1.0; }
    if n == 0 { return 0.0; }
    let mut f: Float = 0.0;
    let mut count: Int = n;
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    return f;
}

fn ntk2_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

// Function-based length check: the C-emit cannot reorder an early return INSIDE
// a separately called function. This is the workaround for the C-emit bug.
fn ntk2_check_samples(s: List[Float]) -> Result[Int, String] {
    let n: Int = list_len(s);
    if n < 4 { return Err("ERR ntk2 short samples"); }
    return Ok(n);
}

fn ntk2_check_w(w: List[Float]) -> Result[Int, String] {
    let n: Int = list_len(w);
    if n < 2 { return Err("ERR ntk2 short w"); }
    return Ok(n);
}

// 1-hidden ReLU NTK for H=1, 2D input, 2 samples. Hostile: returns Err.
pub fn ntk2_gram_matrix(w: List[Float], a: Float, samples: List[Float]) -> Result[List[Float], String] {
    let wn_r: Result[Int, String] = ntk2_check_w(w);
    match wn_r { Ok(_) => {}, Err(e) => { return Err(e); } }
    let sn_r: Result[Int, String] = ntk2_check_samples(samples);
    match sn_r { Ok(_) => {}, Err(e) => { return Err(e); } }
    let x1_1: Float = list_get(samples, 0);
    let x1_2: Float = list_get(samples, 1);
    let x2_1: Float = list_get(samples, 2);
    let x2_2: Float = list_get(samples, 3);
    let w1: Float = list_get(w, 0);
    let w2: Float = list_get(w, 1);
    let dot1: Float = w1 * x1_1 + w2 * x1_2;
    let dot2: Float = w1 * x2_1 + w2 * x2_2;
    let relu1: Float = if dot1 > 0.0 { dot1 } else { 0.0 };
    let relu2: Float = if dot2 > 0.0 { dot2 } else { 0.0 };
    let ind1: Float = if dot1 > 0.0 { 1.0 } else { 0.0 };
    let ind2: Float = if dot2 > 0.0 { 1.0 } else { 0.0 };
    let a2: Float = a * a;
    let x11: Float = x1_1 * x1_1 + x1_2 * x1_2;
    let x12: Float = x1_1 * x2_1 + x1_2 * x2_2;
    let x22: Float = x2_1 * x2_1 + x2_2 * x2_2;
    let ntk_11: Float = relu1 * relu1 + a2 * ind1 * ind1 * x11;
    let ntk_12: Float = relu1 * relu2 + a2 * ind1 * ind2 * x12;
    let ntk_22: Float = relu2 * relu2 + a2 * ind2 * ind2 * x22;
    let mut out: List[Float] = list_new();
    out = list_push(out, ntk_11);
    out = list_push(out, ntk_12);
    out = list_push(out, ntk_12);
    out = list_push(out, ntk_22);
    return Ok(out);
}

// Lazy regime check: 1 if max |Theta_final - Theta_initial| <= tol.
pub fn lazy2_regime_check(ntk_initial: List[Float], ntk_final: List[Float], tol: Float) -> Int {
    let n: Int = list_len(ntk_initial);
    if n != list_len(ntk_final) || tol < 0.0 { return 0; }
    let mut max_diff: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let mut d: Float = list_get(ntk_initial, i) - list_get(ntk_final, i);
        if d < 0.0 { d = 0.0 - d; }
        if d > max_diff { max_diff = d; }
        i = i + 1;
    }
    if max_diff <= tol { return 1; }
    return 0;
}

// Domain cert: NTK holds (1) iff NTK can be computed.
pub fn ntk2_cert(w: List[Float], a: Float, samples: List[Float]) -> DomainCert {
    let r = ntk2_gram_matrix(w, a, samples);
    let holds: Int = if r.is_ok() { 1 } else { 0 };
    return domain_cert("ai", "ntk_lazy_regime_v2", holds);
}

pub fn ntk2_g_or_empty(w: List[Float], a: Float, s: List[Float]) -> List[Float] {
    let r = ntk2_gram_matrix(w, a, s);
    match r { Ok(v) => { return v; }, Err(_) => { return list_new(); } }
}

// Verify with hostile cases (v2 fix).
pub fn verify_ntk_lazy_regime_v2() -> Bool {
    if ai_lr_ok(0.1) != 1 { return false; }
    let mut w: List[Float] = list_new();
    w = list_push(w, 0.5);
    w = list_push(w, 0.0 - 0.3);
    let mut s: List[Float] = list_new();
    s = list_push(s, 0.7);
    s = list_push(s, 0.4);
    s = list_push(s, 0.0 - 0.2);
    s = list_push(s, 0.6);
    let gram: List[Float] = ntk2_g_or_empty(w, 0.8, s);
    if list_len(gram) != 4 { return false; }
    let n11: Float = list_get(gram, 0);
    let n12: Float = list_get(gram, 1);
    let n21: Float = list_get(gram, 2);
    let n22: Float = list_get(gram, 3);
    if aclose_ntk2(n11, 0.4689, 0.001) != 1 { return false; }
    if aclose_ntk2(n12, 0.0, 0.001) != 1 { return false; }
    if aclose_ntk2(n21, 0.0, 0.001) != 1 { return false; }
    if aclose_ntk2(n22, 0.0, 0.001) != 1 { return false; }
    let mut sym_d: Float = n12 - n21;
    if sym_d < 0.0 { sym_d = 0.0 - sym_d; }
    if sym_d > 0.001 { return false; }
    // Hostile: short samples (3 elements) returns Err, not OOB.
    let mut short_s: List[Float] = list_new();
    short_s = list_push(short_s, 0.7);
    short_s = list_push(short_s, 0.4);
    short_s = list_push(short_s, 0.0 - 0.2);
    if ntk2_gram_matrix(w, 0.8, short_s).is_ok() { return false; }
    // Hostile: empty samples returns Err.
    let mut empty_s: List[Float] = list_new();
    if ntk2_gram_matrix(w, 0.8, empty_s).is_ok() { return false; }
    // Hostile: short w (1 element) returns Err.
    let mut short_w: List[Float] = list_new();
    short_w = list_push(short_w, 0.5);
    if ntk2_gram_matrix(short_w, 0.8, s).is_ok() { return false; }
    // Hostile: empty w returns Err.
    let mut empty_w: List[Float] = list_new();
    if ntk2_gram_matrix(empty_w, 0.8, s).is_ok() { return false; }
    // Domain cert hostile: cert holds=0.
    if ntk2_cert(short_w, 0.8, s).holds != 0 { return false; }
    if ntk2_cert(w, 0.8, short_s).holds != 0 { return false; }
    // Domain cert golden: cert holds=1.
    if ntk2_cert(w, 0.8, s).holds != 1 { return false; }
    return true;
}
