// # Gradient Descent Update Law
//
// Logline: A parameter is updated in the negative-gradient direction scaled by the learning rate.
//
// Setup: Pure Float. Learning rate > 0, gradient finite, non-NaN. Out-of-range returns 0. Hosts ai_invariants.oo stem.
//
// Beats:
//   1. Standard update: w' = w - lr * grad.
//   2. Update with momentum: v' = beta * v + grad, w' = w - lr * v'.
//   3. Convergence witness: 1 if gradient norm is below tolerance.
//   4. Hosts ai_invariants.oo stem for cross-law correlation.

import "std/app/ai/ai_invariants.oo";

fn gd_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

// Standard update: w' = w - lr * grad. grad=0 is Ok(w). lr<=0 is Err.
pub fn gd_update(weight: Float, lr: Float, gradient: Float) -> Result[Float, String] {
    if ai_lr_ok_int(lr) == 0 { return Err("ERR\tgd\tdomain"); }
    return Ok(weight - (lr * gradient));
}

// Update with momentum. beta in [0,1]. lr<=0 or beta OOR is Err.
pub fn gd_momentum_update(weight: Float, lr: Float, velocity: Float, gradient: Float, beta: Float) -> Result[Float, String] {
    if ai_lr_ok_int(lr) == 0 { return Err("ERR\tgd\tdomain"); }
    if beta < 0.0 { return Err("ERR\tgd\tdomain"); }
    if beta > 1.0 { return Err("ERR\tgd\tdomain"); }
    let new_vel: Float = (beta * velocity) + gradient;
    return Ok(weight - (lr * new_vel));
}

// Convergence witness: 1 if gradient norm (squared) <= tolerance. Negative tolerance returns 0.
pub fn gd_converged(grad_sq: Float, tolerance: Float) -> Int {
    if grad_sq < 0.0 { return 0; }
    if tolerance < 0.0 { return 0; }
    if grad_sq <= tolerance { return 1; }
    return 0;
}

// ai_lr_ok_int adapter: 1 if lr > 0, else 0.
pub fn ai_lr_ok_int(lr: Float) -> Int {
    if lr <= 0.0 { return 0; }
    return 1;
}

// KAT and hostile cases for the gradient-descent law.
pub fn verify_gradient_descent_law() -> Bool {
    let ai_inv_ok: Int = ai_lr_ok(0.1);
    if ai_inv_ok != 1 { return false; }
    let w1: Float = gd_got(gd_update(1.0, 0.1, 0.5));
    let mut d: Float = w1 - 0.95;
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0001 { return false; }
    let zgrad: Float = gd_got(gd_update(2.0, 0.1, 0.0));
    let mut dz: Float = zgrad - 2.0;
    if dz < 0.0 { dz = 0.0 - dz; }
    if dz > 0.0001 { return false; }
    if gd_update(2.0, 0.0, 0.5).is_ok() { return false; }
    if gd_update(1.0, 0.0 - 0.1, 0.5).is_ok() { return false; }
    let w4: Float = gd_got(gd_momentum_update(1.0, 0.1, 0.2, 0.5, 0.9));
    let target: Float = 1.0 - (0.1 * ((0.9 * 0.2) + 0.5));
    let mut d4: Float = w4 - target;
    if d4 < 0.0 { d4 = 0.0 - d4; }
    if d4 > 0.0001 { return false; }
    if gd_converged(0.0001, 0.001) != 1 { return false; }
    if gd_converged(0.01, 0.001) != 0 { return false; }
    if gd_converged(0.0, 0.0) != 1 { return false; }
    if gd_converged(0.0 - 0.1, 0.001) != 0 { return false; }
    if gd_converged(0.01, 0.0 - 0.001) != 0 { return false; }
    if gd_momentum_update(1.0, 0.1, 0.2, 0.5, 0.0 - 0.1).is_ok() { return false; }
    if gd_momentum_update(1.0, 0.1, 0.2, 0.5, 1.5).is_ok() { return false; }
    if ai_lr_ok_int(0.0) != 0 { return false; }
    if ai_lr_ok_int(0.1) != 1 { return false; }
    if ai_lr_ok_int(0.0 - 0.1) != 0 { return false; }
    return true;
}
