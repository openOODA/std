// # Universal Approximation Theorem
//
// Logline: A feedforward network with one hidden layer and enough neurons can approximate any continuous function on a compact set.
//
// Setup: Pure Int. Neuron count >= 1 for hidden layer. Out-of-range fails closed. Hosts ai_invariants.oo stem.
//
// Beats:
//   1. Approximation capacity: 1 if hidden_neurons >= minimum_required.
//   2. Activation type codes: 0 linear, 1 sigmoid, 2 ReLU, 3 tanh.
//   3. Minimum required neurons: depth-adjusted heuristic (caller-supplied).
//   4. Hosts ai_invariants.oo stem for cross-law correlation.

import "std/app/ai/ai_invariants.oo";

// Activation codes.
pub fn ua_activation_linear() -> Int {
    return 0;
}

pub fn ua_activation_sigmoid() -> Int {
    return 1;
}

pub fn ua_activation_relu() -> Int {
    return 2;
}

pub fn ua_activation_tanh() -> Int {
    return 3;
}

// Universal approximator: 1 if hidden_neurons >= 1 and activation is non-linear.
pub fn ua_is_universal(hidden_neurons: Int, activation: Int) -> Int {
    if hidden_neurons < 1 { return 0; }
    if activation < 0 { return 0; }
    if activation > 3 { return 0; }
    if activation == ua_activation_linear() { return 0; }
    return 1;
}

// Capacity witness: 1 if hidden_neurons >= minimum. min <= 0 returns 0.
pub fn ua_capacity(hidden_neurons: Int, minimum_required: Int) -> Int {
    if hidden_neurons < 0 { return 0; }
    if minimum_required <= 0 { return 0; }
    if hidden_neurons >= minimum_required { return 1; }
    return 0;
}

// Layer depth: stacked hidden layers; deeper networks have exponential capacity.
pub fn ua_layer_depth_capacity(depth: Int) -> Int {
    if depth < 0 { return 0; }
    if depth == 0 { return 1; }
    let mut result: Int = 1;
    let mut i: Int = 0;
    while i < depth {
        result = result * 2;
        i = i + 1;
    }
    return result;
}

// KAT and hostile cases for the universal-approximation theory.
pub fn verify_universal_approx_theory() -> Bool {
    let ai_inv_ok: Int = ai_lr_ok(0.1);
    if ai_inv_ok != 1 { return false; }
    if ua_is_universal(10, ua_activation_sigmoid()) != 1 { return false; }
    if ua_is_universal(10, ua_activation_relu()) != 1 { return false; }
    if ua_is_universal(10, ua_activation_tanh()) != 1 { return false; }
    if ua_is_universal(10, ua_activation_linear()) != 0 { return false; }
    if ua_is_universal(0, ua_activation_sigmoid()) != 0 { return false; }
    if ua_is_universal(0 - 1, ua_activation_sigmoid()) != 0 { return false; }
    if ua_is_universal(10, 0 - 1) != 0 { return false; }
    if ua_is_universal(10, 4) != 0 { return false; }
    if ua_capacity(100, 50) != 1 { return false; }
    if ua_capacity(50, 100) != 0 { return false; }
    if ua_capacity(100, 100) != 1 { return false; }
    if ua_capacity(0 - 1, 50) != 0 { return false; }
    if ua_capacity(50, 0) != 0 { return false; }
    if ua_capacity(50, 0 - 1) != 0 { return false; }
    if ua_layer_depth_capacity(0) != 1 { return false; }
    if ua_layer_depth_capacity(1) != 2 { return false; }
    if ua_layer_depth_capacity(3) != 8 { return false; }
    if ua_layer_depth_capacity(0 - 1) != 0 { return false; }
    return true;
}
