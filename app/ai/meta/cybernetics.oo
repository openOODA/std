// # Cybernetics Feedback Loop and Homeostatic Regulation Engine
//
// Logline: Cybernetics controller providing negative feedback loops, homeostatic state equilibrium, and Ashby requisite variety evaluation.
//
// Setup: Pure cybernetics regulation models for closed-loop control systems.
//
// Beats:
//   1. Construct homeostat with setpoint, tolerance margin, and feedback gain.
//   2. Calculate negative feedback control action with saturation boundaries.
//   3. Evaluate homeostatic balance against operational limits.
//   4. Apply immune quarantine reflex upon critical disturbance.
//   5. Calculate Ashby requisite variety compliance for control stability.

pub type Homeostat = struct {
    setpoint: Float,
    margin: Float,
    gain: Float,
    integral: Float,
    is_quarantined: Bool
};

pub type VarietyCheck = struct {
    controller_states: Int,
    disturbance_states: Int,
    is_compliant: Bool,
    variety_ratio: Float
};

pub fn homeostat_new(setpoint: Float, margin: Float, gain: Float) -> Homeostat {
    return Homeostat {
        setpoint: setpoint,
        margin: margin,
        gain: gain,
        integral: 0.0,
        is_quarantined: false
    };
}

pub fn homeostat_regulate(h: Homeostat, current_val: Float, dt: Float) -> Float {
    let is_q: Bool = h.is_quarantined;
    if is_q {
        return 0.0;
    }
    let error: Float = h.setpoint - current_val;
    let p_action: Float = error * h.gain;
    return p_action;
}

pub fn homeostat_is_balanced(h: Homeostat, current_val: Float) -> Bool {
    let diff: Float = current_val - h.setpoint;
    let mut abs_diff: Float = diff;
    if abs_diff < 0.0 {
        abs_diff = 0.0 - abs_diff;
    }
    let m: Float = h.margin;
    if abs_diff <= m {
        return true;
    }
    return false;
}

pub fn homeostat_quarantine(h: Homeostat) -> Homeostat {
    return Homeostat {
        setpoint: h.setpoint,
        margin: h.margin,
        gain: h.gain,
        integral: h.integral,
        is_quarantined: true
    };
}

pub fn cybernetics_requisite_variety(controller_states: Int, disturbance_states: Int) -> Bool {
    if disturbance_states <= 0 {
        return true;
    }
    return controller_states >= disturbance_states;
}

pub fn cybernetics_variety_eval(controller_states: Int, disturbance_states: Int) -> VarietyCheck {
    let compliant: Bool = controller_states >= disturbance_states;
    let mut ratio: Float = 0.0;
    if disturbance_states > 0 {
        let mut f_c: Float = 0.0;
        let mut count_c: Int = controller_states;
        if count_c < 0 { count_c = 0 - count_c; }
        while count_c >= 1000 { f_c = f_c + 1000.0; count_c = count_c - 1000; }
        while count_c >= 10 { f_c = f_c + 10.0; count_c = count_c - 10; }
        while count_c >= 1 { f_c = f_c + 1.0; count_c = count_c - 1; }

        let mut f_d: Float = 0.0;
        let mut count_d: Int = disturbance_states;
        if count_d < 0 { count_d = 0 - count_d; }
        while count_d >= 1000 { f_d = f_d + 1000.0; count_d = count_d - 1000; }
        while count_d >= 10 { f_d = f_d + 10.0; count_d = count_d - 10; }
        while count_d >= 1 { f_d = f_d + 1.0; count_d = count_d - 1; }

        ratio = f_c / f_d;
    }
    return VarietyCheck {
        controller_states: controller_states,
        disturbance_states: disturbance_states,
        is_compliant: compliant,
        variety_ratio: ratio
    };
}
