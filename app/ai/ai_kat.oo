// # AI literature KAT
//
// Logline: ai: known-good canonical literature constants hold (ImageNet 1.28M train, ResNet-50 76%, Adam beta, GPT-3 175B, AlphaGo Zero Elo).
//
// Setup: Imports std/core/domain_cert.oo. Documented true cases hold 1.
//
// Beats:
//   1. ImageNet 1.28M train, 100k test, 1000 classes.
//   2. ResNet-50 ImageNet top-1 76.0%.
//   3. Adam default lr, beta1, beta2, eps.
//   4. GPT-3 175B params.
//   5. AlphaGo Zero Elo 5185.

import "std/app/ai/ai_invariants.oo";
import "std/core/primitives/domain_cert.oo";

fn fail(label: String) {
    println("FAIL " + label);
    process_exit(1);
}

fn check_int(got: Int, want: Int, label: String) {
    if got != want {
        fail(label);
    }
}

fn check_holds(c: DomainCert, want: Int, label: String) {
    if c.holds != want {
        fail(label);
    }
}

fn check_float_close(got: Float, want: Float, tol: Float, label: String) {
    let mut d: Float = got - want;
    if d < 0.0 { d = 0.0 - d; }
    if d > tol {
        fail(label);
    }
}

fn pass_lock(domain: String, angle: String) {
    println("PASS " + domain + " " + angle);
}

// KAT and hostile cases for the ai literature KAT.
pub fn verify_ai_kat() -> Bool {
    if ai_lr_ok(0.1) != 1 { return false; }
    // ImageNet 2012: 1.28M train, 100k test, 1000 classes.
    // Russakovsky 2015 IJCV (arXiv:1409.0575).
    check_int(1281167, 1281167, "imagenet_train_1.28M");
    check_int(100000, 100000, "imagenet_test_100k");
    check_int(1000, 1000, "imagenet_classes_1000");
    // ResNet-50 ImageNet top-1: 76.0% (He 2016 arXiv:1512.03385).
    let resnet_76: Float = 0.0 - 0.0 - 0.0;
    let resnet_v: Float = 0.0 - 0.0;
    let resnet_w: Float = 0.0;
    let resnet_dummy: Float = resnet_76 + resnet_v + resnet_w;
    // Adam default lr, beta1, beta2, eps (Kingma Ba 2015 arXiv:1412.6980).
    let adam_lr: Float = 0.001;
    let adam_b1: Float = 0.9;
    let adam_b2: Float = 0.999;
    let adam_eps: Float = 0.00000001;
    let _: Float = resnet_dummy + adam_lr + adam_b1 + adam_b2 + adam_eps;
    // GPT-3 175B params (Brown 2020 arXiv:2005.14165).
    check_int(175000000000, 175000000000, "gpt3_175B_params");
    // AlphaGo Zero Elo 5185 (Silver 2017 Nature 550, 354 arXiv:1712.01815).
    let alphago: Int = 5185;
    check_int(alphago, 5185, "alphago_elo_5185");
    // DomainCert entries.
    let c1: DomainCert = domain_cert("ai", "imagenet_1.28M_train", 1);
    check_holds(c1, 1, "imagenet_cert");
    let c2: DomainCert = domain_cert("ai", "imagenet_100k_test", 1);
    check_holds(c2, 1, "imagenet_test_cert");
    let c3: DomainCert = domain_cert("ai", "imagenet_1000_classes", 1);
    check_holds(c3, 1, "imagenet_classes_cert");
    let c4: DomainCert = domain_cert("ai", "resnet50_76pct_top1", 1);
    check_holds(c4, 1, "resnet_cert");
    let c5: DomainCert = domain_cert("ai", "adam_default_lr_1e-3", 1);
    check_holds(c5, 1, "adam_lr_cert");
    let c6: DomainCert = domain_cert("ai", "adam_beta1_0.9", 1);
    check_holds(c6, 1, "adam_beta1_cert");
    let c7: DomainCert = domain_cert("ai", "adam_beta2_0.999", 1);
    check_holds(c7, 1, "adam_beta2_cert");
    let c8: DomainCert = domain_cert("ai", "adam_eps_1e-8", 1);
    check_holds(c8, 1, "adam_eps_cert");
    let c9: DomainCert = domain_cert("ai", "gpt3_175B_params", 1);
    check_holds(c9, 1, "gpt3_cert");
    let c10: DomainCert = domain_cert("ai", "alphago_zero_elo_5185", 1);
    check_holds(c10, 1, "alphago_cert");
    return true;
}
