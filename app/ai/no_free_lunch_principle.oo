// # No-Free-Lunch Principle
//
// Logline: No learning algorithm is universally better; average performance across all problems is the same.
//
// Setup: Pure Int. Average error across problem set is invariant for any algorithm. Hosts ai_invariants.oo stem.
//
// Beats:
//   1. Algorithm score: total error over problem set.
//   2. Equal-mean witness: 1 if mean errors are equal.
//   3. Specialization: 1 if algorithm A is better on a subset and worse on the complement.
//   4. Hosts ai_invariants.oo stem for cross-law correlation.

import "std/app/ai/ai_invariants.oo";

fn nfl_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Total error of an algorithm over a problem set. Empty sum is Ok(0). Negative error is Err.
pub fn nfl_total_error(errors: List[Int]) -> Result[Int, String] {
    let n: Int = list_len(errors);
    if n <= 0 { return Ok(0); }
    let mut total: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let e: Int = list_get(errors, i);
        if e < 0 { return Err("ERR\tnfl\tdomain"); }
        total = total + e;
        i = i + 1;
    }
    return Ok(total);
}

// Mean error: floor(total / n). Empty is Err (mean undefined). All-zero is Ok(0).
pub fn nfl_mean_error(errors: List[Int]) -> Result[Int, String] {
    let n: Int = list_len(errors);
    if n <= 0 { return Err("ERR\tnfl\tdomain"); }
    let tr: Result[Int, String] = nfl_total_error(errors);
    if tr.is_ok() == false { return tr; }
    return Ok(nfl_got(tr) / n);
}

// NFL witness: 1 if mean errors of two algorithms are equal. Illegal mean is 0.
pub fn nfl_equal_mean(a_errors: List[Int], b_errors: List[Int]) -> Int {
    let ar: Result[Int, String] = nfl_mean_error(a_errors);
    let br: Result[Int, String] = nfl_mean_error(b_errors);
    if ar.is_ok() == false { return 0; }
    if br.is_ok() == false { return 0; }
    if nfl_got(ar) == nfl_got(br) { return 1; }
    return 0;
}

// Specialization: 1 if A's error is less than B's on a subset and greater on the complement.
// Here we use the total error as a coarse approximation.
pub fn nfl_specialized(a_total: Int, b_total: Int, a_subset: Int, b_subset: Int) -> Int {
    if a_total < 0 { return 0; }
    if b_total < 0 { return 0; }
    if a_subset < 0 { return 0; }
    if b_subset < 0 { return 0; }
    if a_subset < b_subset {
        if a_total > b_total { return 1; }
    }
    return 0;
}

// KAT and hostile cases for the no-free-lunch principle.
pub fn verify_no_free_lunch_principle() -> Bool {
    let ai_inv_ok: Int = ai_lr_ok(0.1);
    if ai_inv_ok != 1 { return false; }
    let mut a: List[Int] = list_new();
    a = list_push(a, 1);
    a = list_push(a, 2);
    a = list_push(a, 3);
    let mut b: List[Int] = list_new();
    b = list_push(b, 2);
    b = list_push(b, 2);
    b = list_push(b, 2);
    if nfl_got(nfl_total_error(a)) != 6 { return false; }
    if nfl_got(nfl_total_error(b)) != 6 { return false; }
    if nfl_got(nfl_mean_error(a)) != 2 { return false; }
    if nfl_got(nfl_mean_error(b)) != 2 { return false; }
    if nfl_equal_mean(a, b) != 1 { return false; }
    let mut c: List[Int] = list_new();
    c = list_push(c, 1);
    c = list_push(c, 1);
    c = list_push(c, 1);
    if nfl_equal_mean(a, c) != 0 { return false; }
    if nfl_specialized(10, 5, 5, 1) != 0 { return false; }
    if nfl_specialized(10, 5, 1, 2) != 1 { return false; }
    if nfl_specialized(10, 5, 2, 1) != 0 { return false; }
    if nfl_specialized(5, 10, 1, 2) != 0 { return false; }
    if nfl_specialized(0 - 1, 5, 1, 5) != 0 { return false; }
    let mut bad: List[Int] = list_new();
    bad = list_push(bad, 1);
    bad = list_push(bad, 0 - 1);
    if nfl_total_error(bad).is_ok() { return false; }
    let mut empty: List[Int] = list_new();
    let zsum: Result[Int, String] = nfl_total_error(empty);
    if zsum.is_ok() == false { return false; }
    if nfl_got(zsum) != 0 { return false; }
    if nfl_mean_error(empty).is_ok() { return false; }
    let mut zeros: List[Int] = list_new();
    zeros = list_push(zeros, 0);
    zeros = list_push(zeros, 0);
    let zerr: Result[Int, String] = nfl_total_error(zeros);
    if zerr.is_ok() == false { return false; }
    if nfl_got(zerr) != 0 { return false; }
    return true;
}
