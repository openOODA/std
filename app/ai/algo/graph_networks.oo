pub fn net_hll_create(p: Int) -> HllRegisterBank {
    return hll_create(p);
}

pub fn net_minhash_create(k: Int) -> MinHashConfig {
    return minhash_config_create(k);
}

pub fn net_cms_create(depth: Int, width: Int) -> CountMinSketch {
    return cms_create(depth, width);
}

pub fn net_topk_create(k: Int) -> SpaceSavingSummary {
    return topk_summary_create(k);
}

pub fn net_cuckoo_create(num_buckets: Int, cap: Int) -> CuckooFilter {
    return cuckoo_filter_create(num_buckets, cap);
}

pub fn net_cbf_create(m: Int, k: Int) -> CountingBloomFilter {
    return cbf_create(m, k);
}

pub fn net_tdigest_create(max_centroids: Int) -> TDigest {
    return tdigest_create(max_centroids);
}

pub fn net_aodv_create(local_ip: Int) -> AodvRoutingTable {
    return aodv_table_create(local_ip);
}

pub fn net_rpl_create(node_id: Int, is_root: Bool, dodag_id: Int) -> RplDodagNode {
    return rpl_node_create(node_id, is_root, dodag_id);
}

pub fn net_chord_create(node_id: Int, m_bits: Int) -> ChordNode {
    return chord_node_create(node_id, m_bits);
}

pub fn net_brandes_compute(num_nodes: Int, adj: List[List[Int]]) -> BrandesResult {
    return brandes_compute(num_nodes, adj);
}
