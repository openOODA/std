// # Complex Networks & Probabilistic Graph Structures Facade
//
// Logline: Re-exports HyperLogLog, MinHash, Count-Min Sketch, Complex Networks, Mesh Routing, and DHT Overlays.
//
// Setup: Pure module shim and facade importing all 49 companion graph network and probabilistic sketch submodules.
//
// Beats:
//   1. Import 49 modular Probabilistic Data Structures, Complex Network Models, Mesh Protocols, and DHT overlays.
//   2. Re-export public constructors, capability-gated interfaces, and routing entry points.
//   3. Maintain full compatibility with downstream openOODA graph and network consumers.

import "std/app/ai/algo/hyperloglog_cardinality.oo";
import "std/app/ai/algo/minhash_lsh_index.oo";
import "std/app/ai/algo/count_min_sketch_heavy.oo";
import "std/app/ai/algo/topk_heavy_hitters.oo";
import "std/app/ai/algo/cuckoo_filter_probabilistic.oo";
import "std/app/ai/algo/bloom_filter_counting.oo";
import "std/app/ai/algo/tdigest_streaming_quantile.oo";
import "std/app/ai/algo/brandes_betweenness_centrality.oo";
import "std/net/protocol/routing/aodv_routing_mesh.oo";
import "std/net/protocol/routing/rpl_dodag_tree.oo";
import "std/net/protocol/routing/chord_dht_finger_table.oo";

pub fn net_hll_create(p: Int) -> HllRegisterBank {
    return hll_create(p);
}

pub fn net_minhash_create(k: Int) -> MinHashConfig {
    return minhash_config_create(k);
}

pub fn net_cms_create(depth: Int, width: Int) -> CountMinSketch {
    return cms_create(depth, width);
}

pub fn net_topk_create(k: Int) -> SpaceSavingSummary {
    return topk_summary_create(k);
}

pub fn net_cuckoo_create(num_buckets: Int, cap: Int) -> CuckooFilter {
    return cuckoo_filter_create(num_buckets, cap);
}

pub fn net_cbf_create(m: Int, k: Int) -> CountingBloomFilter {
    return cbf_create(m, k);
}

pub fn net_tdigest_create(max_centroids: Int) -> TDigest {
    return tdigest_create(max_centroids);
}

pub fn net_aodv_create(local_ip: Int) -> AodvRoutingTable {
    return aodv_table_create(local_ip);
}

pub fn net_rpl_create(node_id: Int, is_root: Bool, dodag_id: Int) -> RplDodagNode {
    return rpl_node_create(node_id, is_root, dodag_id);
}

pub fn net_chord_create(node_id: Int, m_bits: Int) -> ChordNode {
    return chord_node_create(node_id, m_bits);
}

pub fn net_brandes_compute(num_nodes: Int, adj: List[List[Int]]) -> BrandesResult {
    return brandes_compute(num_nodes, adj);
}
