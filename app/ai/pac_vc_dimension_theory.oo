// # PAC/VC Dimension Theory
//
// Logline: Probably Approximately Correct learnability: m >= (1/eps)(VC*ln(2/eps) + ln(1/delta)) samples suffice for error <= eps with prob >= 1-delta.
//
// Setup: Pure Float/Int. eps in (0,1], delta in (0,1], VC >= 0. Out-of-range fails closed. Couples with Rademacher complexity bound. Hosts ai_invariants.oo stem.
//
// Beats:
//   1. PAC sample bound: m = (1/eps)*(VC*ln(2/eps) + ln(1/delta)).
//   2. VC threshold: max VC such that the bound holds for given m and default delta.
//   3. Rademacher coupling: ER <= 2*R_m + sqrt(ln(1/delta)/(2m)).
//   4. Hosts ai_invariants.oo stem for cross-law correlation.

import "std/app/ai/ai_invariants.oo";
import "std/core/primitives/domain_cert.oo";

// Absolute value helper (aabs): |x| = x if x >= 0, else -x.
// Renamed from abs_f to avoid collision with std/math/* built-ins.
pub fn aabs_f(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

// Float close (aclose): 1 if |a-b| <= tol, else 0.
pub fn aclose_f(a: Float, b: Float, tol: Float) -> Int {
    let mut d: Float = a - b;
    if d < 0.0 { d = 0.0 - d; }
    if d <= tol { return 1; }
    return 0;
}

// Local int-to-float conversion for non-negative ints. n < 0 returns -1 sentinel.
pub fn pac_int_to_float(n: Int) -> Float {
    if n < 0 { return 0.0 - 1.0; }
    if n == 0 { return 0.0; }
    let mut f: Float = 0.0;
    let mut count: Int = n;
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    return f;
}

fn pac_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

fn pac_igot(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// PAC sample bound: m = (1/eps)*(VC*ln(2/eps) + ln(1/delta)).
// Valiant 1984 CACM 27, 1134; Shalev-Shwartz Ben-David 2014 Understanding Machine Learning, Cambridge, Theorem 6.8.
pub fn pac_sample_bound(eps: Float, delta: Float, vc: Int) -> Result[Float, String] {
    if eps <= 0.0 { return Err("ERR\tpac\teps"); }
    if eps > 1.0 { return Err("ERR\tpac\teps"); }
    if delta <= 0.0 { return Err("ERR\tpac\tdelta"); }
    if delta > 1.0 { return Err("ERR\tpac\tdelta"); }
    if vc < 0 { return Err("ERR\tpac\tvc"); }
    let one_over_eps: Float = 1.0 / eps;
    let two_over_eps: Float = 2.0 / eps;
    let log_term_1: Float = ln(two_over_eps);
    let log_term_2: Float = ln(1.0 / delta);
    let vc_f: Float = pac_int_to_float(vc);
    let inner: Float = (vc_f * log_term_1) + log_term_2;
    return Ok(one_over_eps * inner);
}

// VC threshold: max VC such that PAC bound holds for (eps, m, delta=0.5).
// delta=0.5 is the standard "one-sigma" confidence convention for the threshold.
pub fn vc_threshold(eps: Float, m: Int) -> Result[Int, String] {
    if eps <= 0.0 { return Err("ERR\tpac\teps"); }
    if eps > 1.0 { return Err("ERR\tpac\teps"); }
    if m <= 0 { return Err("ERR\tpac\tm"); }
    let m_f: Float = pac_int_to_float(m);
    let m_eps: Float = m_f * eps;
    let two_over_eps: Float = 2.0 / eps;
    let log_term_1: Float = ln(two_over_eps);
    // Default delta for threshold = 0.5, ln(1/0.5) = ln(2).
    let log_term_2: Float = ln(2.0);
    let num: Float = m_eps - log_term_2;
    if num < 0.0 { return Ok(0); }
    let vc_f: Float = num / log_term_1;
    let floor_r: Result[Int, String] = float_floor(vc_f);
    match floor_r {
        Ok(v)  => { return Ok(v); },
        Err(e) => { return Err(e); }
    }
}

// Float floor: largest integer <= x. x < 0 is Err.
pub fn float_floor(x: Float) -> Result[Int, String] {
    if x < 0.0 { return Err("ERR\tpac\tfloor"); }
    let mut acc: Int = 0;
    let mut rem: Float = x;
    while rem >= 1.0 {
        rem = rem - 1.0;
        acc = acc + 1;
    }
    return Ok(acc);
}

// Rademacher complexity-based ER bound: ER <= 2*R + sqrt(ln(1/delta)/(2m)).
// Coupled with VC theory via R <= sqrt(2*VC*ln(2*m+1)/m) (Bartlett-Mendelson 2002).
pub fn pac_rademacher(rval: Float, delta: Float, m: Int) -> Result[Float, String] {
    if delta <= 0.0 { return Err("ERR\tpac\tdelta"); }
    if delta > 1.0 { return Err("ERR\tpac\tdelta"); }
    if m <= 0 { return Err("ERR\tpac\tm"); }
    if rval < 0.0 { return Err("ERR\tpac\trademacher"); }
    let m_f: Float = pac_int_to_float(m);
    let m2_f: Float = m_f * 2.0;
    let log_term: Float = ln(1.0 / delta);
    let ratio: Float = log_term / m2_f;
    let sqrt_term: Float = sqrt(ratio);
    return Ok((2.0 * rval) + sqrt_term);
}

// Domain cert: PAC bound holds if pac_sample_bound returns Ok.
pub fn pac_cert(eps: Float, delta: Float, vc: Int) -> DomainCert {
    let r: Result[Float, String] = pac_sample_bound(eps, delta, vc);
    let holds: Int = if r.is_ok() { 1 } else { 0 };
    return domain_cert("ai", "pac_vc_dimension", holds);
}

// KAT and hostile cases for the PAC/VC dimension theory.
pub fn verify_pac_vc_dimension_theory() -> Bool {
    let ai_inv_ok: Int = ai_lr_ok(0.1);
    if ai_inv_ok != 1 { return false; }
    // Golden: eps=0.1, delta=0.05, VC=3 -> m = (1/0.1)*(3*ln(20)+ln(20)) = 10*4*ln(20) ≈ 119.83.
    let m1: Float = pac_got(pac_sample_bound(0.1, 0.05, 3));
    let target1: Float = (3.0 * ln(20.0)) + ln(20.0);
    let expected1: Float = target1 / 0.1;
    if aclose_f(m1, expected1, 0.000001) != 1 { return false; }
    // 142 samples suffice: 142 >= 119.83.
    let m142_f: Float = pac_int_to_float(142);
    if m142_f < m1 - 0.0001 { return false; }
    // VC threshold: with eps=0.1, m=142, default delta=0.5 -> max VC = floor((14.2 - ln2) / ln(20)) ≈ floor(13.507/2.996) = 4.
    let vct: Int = pac_igot(vc_threshold(0.1, 142));
    if vct < 3 { return false; }
    // Smaller m gives smaller VC threshold.
    let vct_small: Int = pac_igot(vc_threshold(0.1, 50));
    let vct_large: Int = pac_igot(vc_threshold(0.1, 1000));
    if vct_small >= vct_large { return false; }
    // Hostile: eps <= 0 or delta <= 0 or eps > 1 or delta > 1 or VC < 0.
    if pac_sample_bound(0.0, 0.05, 3).is_ok() { return false; }
    if pac_sample_bound(0.0 - 0.1, 0.05, 3).is_ok() { return false; }
    if pac_sample_bound(0.1, 0.0, 3).is_ok() { return false; }
    if pac_sample_bound(0.1, 0.0 - 0.05, 3).is_ok() { return false; }
    if pac_sample_bound(0.1, 0.05, 0 - 1).is_ok() { return false; }
    if pac_sample_bound(1.5, 0.05, 3).is_ok() { return false; }
    if pac_sample_bound(0.1, 1.5, 3).is_ok() { return false; }
    if vc_threshold(0.0, 100).is_ok() { return false; }
    if vc_threshold(0.1, 0).is_ok() { return false; }
    if vc_threshold(0.1, 0 - 1).is_ok() { return false; }
    if vc_threshold(1.5, 100).is_ok() { return false; }
    // Coupled Rademacher: R=0.05, delta=0.05, m=100 -> ER = 0.1 + sqrt(ln(20)/200).
    let er: Float = pac_got(pac_rademacher(0.05, 0.05, 100));
    let expected_er: Float = 0.1 + sqrt(ln(20.0) / 200.0);
    if aclose_f(er, expected_er, 0.000001) != 1 { return false; }
    // Coupled hostile: negative R or bad delta.
    if pac_rademacher(0.0 - 0.05, 0.05, 100).is_ok() { return false; }
    if pac_rademacher(0.05, 0.0, 100).is_ok() { return false; }
    if pac_rademacher(0.05, 0.05, 0).is_ok() { return false; }
    // Float floor edge cases.
    if pac_igot(float_floor(0.0)) != 0 { return false; }
    if pac_igot(float_floor(3.7)) != 3 { return false; }
    if float_floor(0.0 - 0.1).is_ok() { return false; }
    // int_to_float edge cases.
    if pac_int_to_float(0) != 0.0 { return false; }
    if pac_int_to_float(0 - 1) >= 0.0 { return false; }
    // Domain cert.
    let c1: DomainCert = pac_cert(0.1, 0.05, 3);
    if c1.holds != 1 { return false; }
    let c2: DomainCert = pac_cert(0.0, 0.05, 3);
    if c2.holds != 0 { return false; }
    return true;
}
