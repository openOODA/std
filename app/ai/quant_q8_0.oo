// # 8-Bit Q8_0 Block Quantization & GEMV Matrix Multiplication
//
// Logline: Implements Q8_0 block quantization, signed int8 dot products, dequantization, and matrix-vector/matrix-matrix multiplications.
//
// Setup: Pure numerical algorithms and bitwise decoders for 8.5-bit Q8_0 quantized neural inference.
//
// Beats:
//   1. Convert FP16 half-precision scale factors to 32-bit floats.
//   2. Extract 32 signed 8-bit integers per block and compute direct dot products.
//   3. Dequantize Q8_0 blocks to 32-bit float vectors.
//   4. Execute high-throughput quantized matrix-vector (GEMV) and matrix-matrix (GEMM) multiplication.

type BlockQ8_0 = struct {
    d: Float,
    qs: List[Int]
};

type QuantizedTensorQ8 = struct {
    rows: Int,
    cols: Int,
    raw_data: String,
    block_count: Int
};

pub fn q8_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 1000000 { f = f + 1000000.0; count = count - 1000000; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn q8_float_to_int(val: Float) -> Int {
    let mut res: Int = 0;
    let mut temp: Float = val;
    if temp < 0.0 { temp = 0.0 - temp; }
    while temp >= 1000000.0 { res = res + 1000000; temp = temp - 1000000.0; }
    while temp >= 10000.0 { res = res + 10000; temp = temp - 10000.0; }
    while temp >= 100.0 { res = res + 100; temp = temp - 100.0; }
    while temp >= 1.0 { res = res + 1; temp = temp - 1.0; }
    if val < 0.0 { return 0 - res; }
    return res;
}

pub fn q8_fp16_to_f32(h: Int) -> Float {
    let sign: Int = (h / 32768) % 2;
    let exp: Int = (h / 1024) % 32;
    let mant: Int = h % 1024;
    if exp == 0 {
        if mant == 0 { return 0.0; }
        let mut f: Float = (q8_int_to_float(mant) / 1024.0) / 16384.0;
        if sign == 1 { f = 0.0 - f; }
        return f;
    }
    if exp == 31 { return 65504.0; }
    let mut f: Float = 1.0 + (q8_int_to_float(mant) / 1024.0);
    let shift: Int = exp - 15;
    let mut i: Int = 0;
    if shift > 0 {
        while i < shift { f = f * 2.0; i = i + 1; }
    } else if shift < 0 {
        let neg_s: Int = 0 - shift;
        while i < neg_s { f = f / 2.0; i = i + 1; }
    }
    if sign == 1 { f = 0.0 - f; }
    return f;
}

pub fn q8_f32_to_fp16(f: Float) -> Int {
    if f == 0.0 { return 0; }
    let mut sign: Int = 0;
    let mut val: Float = f;
    if val < 0.0 { sign = 1; val = 0.0 - val; }
    let mut exp: Int = 15;
    while val >= 2.0 && exp < 30 { val = val / 2.0; exp = exp + 1; }
    while val < 1.0 && exp > 0 { val = val * 2.0; exp = exp - 1; }
    let mant: Int = q8_float_to_int((val - 1.0) * 1024.0);
    return (sign * 32768) + (exp * 1024) + (mant % 1024);
}

pub fn q8_get_raw_u8(raw: String, idx: Int) -> Int {
    let b: Int = byte_at(raw, idx);
    if b < 0 { return 0; }
    return b;
}

pub fn q8_get_raw_i8(raw: String, idx: Int) -> Int {
    let u: Int = q8_get_raw_u8(raw, idx);
    if u >= 128 { return u - 256; }
    return u;
}

pub fn q8_0_block_from_raw(raw: String, offset: Int) -> BlockQ8_0 {
    let b0: Int = q8_get_raw_u8(raw, offset);
    let b1: Int = q8_get_raw_u8(raw, offset + 1);
    let d: Float = q8_fp16_to_f32(b0 + (b1 * 256));
    let mut qs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        qs = list_push(qs, q8_get_raw_i8(raw, offset + 2 + i));
        i = i + 1;
    }
    return BlockQ8_0 { d: d, qs: qs };
}

pub fn q8_0_dequantize_block(raw: String, offset: Int) -> List[Float] {
    let b0: Int = q8_get_raw_u8(raw, offset);
    let b1: Int = q8_get_raw_u8(raw, offset + 1);
    let d: Float = q8_fp16_to_f32(b0 + (b1 * 256));
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        let q: Int = q8_get_raw_i8(raw, offset + 2 + i);
        out = list_push(out, d * q8_int_to_float(q));
        i = i + 1;
    }
    return out;
}

pub fn q8_0_dequantize(blk: BlockQ8_0) -> List[Float] {
    let d: Float = blk.d;
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        let q: Int = list_get(blk.qs, i);
        out = list_push(out, d * q8_int_to_float(q));
        i = i + 1;
    }
    return out;
}

pub fn q8_0_dot_f32(raw: String, block_offset: Int, x: List[Float], x_offset: Int) -> Float {
    let b0: Int = q8_get_raw_u8(raw, block_offset);
    let b1: Int = q8_get_raw_u8(raw, block_offset + 1);
    let d: Float = q8_fp16_to_f32(b0 + (b1 * 256));
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < 32 {
        let q: Int = q8_get_raw_i8(raw, block_offset + 2 + i);
        let xv: Float = list_get(x, x_offset + i);
        sum = sum + (q8_int_to_float(q) * xv);
        i = i + 1;
    }
    return sum * d;
}

pub fn q8_0_dot_block(blk: BlockQ8_0, x: List[Float], x_offset: Int) -> Float {
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < 32 {
        let q: Int = list_get(blk.qs, i);
        let xv: Float = list_get(x, x_offset + i);
        sum = sum + (q8_int_to_float(q) * xv);
        i = i + 1;
    }
    return sum * blk.d;
}

pub fn q8_0_matvec_mul(mat: &QuantizedTensorQ8, x: List[Float]) -> List[Float] {
    let mut y: List[Float] = list_new();
    let blocks_per_row: Int = mat.cols / 32;
    let mut r: Int = 0;
    while r < mat.rows {
        let mut row_sum: Float = 0.0;
        let mut b: Int = 0;
        while b < blocks_per_row {
            let blk_idx: Int = (r * blocks_per_row) + b;
            let blk_offset: Int = blk_idx * 34;
            let x_off: Int = b * 32;
            row_sum = row_sum + q8_0_dot_f32(mat.raw_data, blk_offset, x, x_off);
            b = b + 1;
        }
        y = list_push(y, row_sum);
        r = r + 1;
    }
    return y;
}

pub fn q8_0_matmul(mat_a: &QuantizedTensorQ8, mat_b: List[Float], b_cols: Int) -> List[Float] {
    let mut out: List[Float] = list_new();
    let k_dim: Int = mat_a.cols;
    let m_rows: Int = mat_a.rows;
    let mut r: Int = 0;
    while r < m_rows {
        let mut c: Int = 0;
        while c < b_cols {
            let mut col_vec: List[Float] = list_new();
            let mut k: Int = 0;
            while k < k_dim {
                col_vec = list_push(col_vec, list_get(mat_b, (k * b_cols) + c));
                k = k + 1;
            }
            let blocks_per_row: Int = k_dim / 32;
            let mut dot_acc: Float = 0.0;
            let mut b: Int = 0;
            while b < blocks_per_row {
                let blk_idx: Int = (r * blocks_per_row) + b;
                let blk_offset: Int = blk_idx * 34;
                let x_off: Int = b * 32;
                dot_acc = dot_acc + q8_0_dot_f32(mat_a.raw_data, blk_offset, col_vec, x_off);
                b = b + 1;
            }
            out = list_push(out, dot_acc);
            c = c + 1;
        }
        r = r + 1;
    }
    return out;
}
