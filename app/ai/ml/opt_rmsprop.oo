// # AI/ML RMSprop & AdaGrad Adaptive Optimizers
//
// Logline: Implements Root Mean Square Propagation (RMSprop) and Adaptive Gradient (AdaGrad) optimizers.
//
// Setup: Imports tensor_types.oo and tensor_ops.oo for gradient scaling state updates.
//
// Beats:
//   1. Define RMSprop and AdaGrad configuration parameters and state buffers.
//   2. Implement RMSprop exponentially decaying mean squared gradient tracking with momentum.
//   3. Implement AdaGrad cumulative sum of squared gradients for sparse feature optimization.

import "tensor_types.oo";
import "tensor_ops.oo";


// -------------------------------------------------------------------
// RMSprop Optimizer
// -------------------------------------------------------------------

type RMSpropConfig = struct {
    lr: Float,
    alpha: Float,
    eps: Float,
    weight_decay: Float,
    momentum: Float
};

type RMSpropOptimizer = struct {
    config: RMSpropConfig,
    step_count: Int,
    v: List[Float],
    buf: List[Float]
};

pub fn rmsprop_config_default(lr: Float) -> RMSpropConfig {
    return RMSpropConfig {
        lr: lr,
        alpha: 0.99,
        eps: 0.00000001,
        weight_decay: 0.0,
        momentum: 0.0
    };
}

pub fn rmsprop_optimizer_new(config: RMSpropConfig, param_count: Int) -> RMSpropOptimizer {
    let mut v_list: List[Float] = list_new();
    let mut b_list: List[Float] = list_new();
    let mut i: Int = 0;    while i < param_count {
        v_list = list_push(v_list, 0.0);
        b_list = list_push(b_list, 0.0);
        i = i + 1;
    }
    return RMSpropOptimizer {
        config: config,
        step_count: 0,
        v: v_list,
        buf: b_list
    };
}

pub fn rmsprop_step_1d(opt: RMSpropOptimizer, param: Tensor1D, grad: Tensor1D) -> Tensor1D {
    let opt_buf_list: List[Float] = opt.buf;
    let grad_data_list: List[Float] = grad.data;
    let opt_v_list: List[Float] = opt.v;
    let param_data_list: List[Float] = param.data;
    let n: Int = param.size;    let lr: Float = (opt.config).lr;    let alpha: Float = (opt.config).alpha;    let eps: Float = (opt.config).eps;    let wd: Float = (opt.config).weight_decay;    let mom: Float = (opt.config).momentum;
    let mut new_param: List[Float] = list_new();
    let mut new_v: List[Float] = list_new();
    let mut new_buf: List[Float] = list_new();

    let mut i: Int = 0;    while i < n {
        let p: Float = list_get(param_data_list, i);        let mut g: Float = list_get(grad_data_list, i);
        if wd != 0.0 {
            g = g + (wd * p);
        }

        // v_t = alpha * v_{t-1} + (1 - alpha) * g^2
        let v_prev: Float = list_get(opt_v_list, i);        let v_t: Float = (alpha * v_prev) + ((1.0 - alpha) * (g * g));        new_v = list_push(new_v, v_t);

        let mut delta: Float = g / (sqrt(v_t) + eps);
        if mom > 0.0 {
            let buf_prev: Float = list_get(opt_buf_list, i);            delta = (mom * buf_prev) + delta;
            new_buf = list_push(new_buf, delta);
        } else {
            new_buf = list_push(new_buf, 0.0);
        }

        new_param = list_push(new_param, p - (lr * delta));
        i = i + 1;
    }

    return Tensor1D { data: new_param, size: n };
}

// -------------------------------------------------------------------
// AdaGrad Optimizer Step: G = G + g^2, theta = theta - (lr / sqrt(G + eps)) * g
// -------------------------------------------------------------------

pub fn adagrad_step_1d(lr: Float, eps: Float, accum: List[Float], param: Tensor1D, grad: Tensor1D) -> Tensor1D {
    let grad_data_list: List[Float] = grad.data;
    let param_data_list: List[Float] = param.data;
    let n: Int = param.size;    let mut new_param: List[Float] = list_new();
    let mut new_acc: List[Float] = list_new();

    let mut i: Int = 0;    while i < n {
        let p: Float = list_get(param_data_list, i);        let g: Float = list_get(grad_data_list, i);        let a: Float = list_get(accum, i) + (g * g);
        new_acc = list_push(new_acc, a);
        new_param = list_push(new_param, p - ((lr / (sqrt(a) + eps)) * g));
        i = i + 1;
    }

    return Tensor1D { data: new_param, size: n };
}

