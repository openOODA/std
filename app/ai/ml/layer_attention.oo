// # AI/ML Scaled Dot-Product & Multi-Head Self Attention
//
// Logline: Implements scaled dot-product attention, causal autoregressive masking, and multi-head projection layers.
//
// Setup: Imports tensor_types.oo, tensor_ops.oo, and activation_ops.oo for tensor matrix manipulation.
//
// Beats:
//   1. Calculate scaled dot-product attention matrices with Q, K, V projections and scale normalization.
//   2. Enforce autoregressive causal masking to preserve temporal ordering in autoregressive sequences.
//   3. Execute multi-head attention forward passes with head projection and residual composition.

import "tensor_types.oo";
import "tensor_ops.oo";
import "activation_ops.oo";

type AttentionConfig = struct {
    embed_dim: Int,
    num_heads: Int,
    head_dim: Int,
    is_causal: Bool
};

type MultiHeadAttention = struct {
    config: AttentionConfig,
    w_q: Tensor2D,
    w_k: Tensor2D,
    w_v: Tensor2D,
    w_out: Tensor2D
};

pub fn attention_config_new(dim: Int, heads: Int, is_causal: Bool) -> AttentionConfig {
    let h_dim: Int = dim / heads;
    return AttentionConfig {
        embed_dim: dim,
        num_heads: heads,
        head_dim: h_dim,
        is_causal: is_causal
    };
}

pub fn multi_head_attention_new(dim: Int, heads: Int, is_causal: Bool) -> MultiHeadAttention {
    let cfg: AttentionConfig = attention_config_new(dim, heads, is_causal);
    let total: Int = dim * dim;
    let mut q_data: List[Float] = list_new();
    let mut k_data: List[Float] = list_new();
    let mut v_data: List[Float] = list_new();
    let mut o_data: List[Float] = list_new();
    let mut i: Int = 0;
    while i < total {
        q_data = list_push(q_data, 0.0);
        k_data = list_push(k_data, 0.0);
        v_data = list_push(v_data, 0.0);
        o_data = list_push(o_data, 0.0);
        i = i + 1;
    }
    return MultiHeadAttention {
        config: cfg,
        w_q: Tensor2D { data: q_data, rows: dim, cols: dim },
        w_k: Tensor2D { data: k_data, rows: dim, cols: dim },
        w_v: Tensor2D { data: v_data, rows: dim, cols: dim },
        w_out: Tensor2D { data: o_data, rows: dim, cols: dim }
    };
}

pub fn scaled_dot_product_attention_single_head(
    q: Tensor2D,
    k: Tensor2D,
    v: Tensor2D,
    seq_len: Int,
    head_dim: Int,
    is_causal: Bool
) -> Tensor2D {
    let k_t: Tensor2D = tensor_2d_transpose(k);
    let raw_scores: Tensor2D = tensor_2d_matmul(q, k_t);
    let raw_scores_data: List[Float] = raw_scores.data;
    let scale_factor: Float = 1.0 / sqrt(int_to_float(head_dim));
    let mut attn_weights: List[Float] = list_new();

    let mut i: Int = 0;
    while i < seq_len {
        let mut row_logits: List[Float] = list_new();
        let mut j: Int = 0;
        while j < seq_len {
            let idx: Int = (i * seq_len) + j;
            let mut val: Float = list_get(raw_scores_data, idx) * scale_factor;
            if is_causal && j > i {
                val = 0.0 - 10000.0;
            }
            row_logits = list_push(row_logits, val);
            j = j + 1;
        }
        let row_t: Tensor1D = Tensor1D { data: row_logits, size: seq_len };
        let mut p_idx: Int = 0;
        while p_idx < seq_len {
            attn_weights = list_push(attn_weights, act_softmax_element(row_t, p_idx));
            p_idx = p_idx + 1;
        }
        i = i + 1;
    }

    let attn_matrix: Tensor2D = Tensor2D { data: attn_weights, rows: seq_len, cols: seq_len };
    return tensor_2d_matmul(attn_matrix, v);
}

pub fn attention_forward(mha: MultiHeadAttention, x: Tensor2D, seq_len: Int) -> Tensor2D {
    let q: Tensor2D = tensor_2d_matmul(x, mha.w_q);
    let k: Tensor2D = tensor_2d_matmul(x, mha.w_k);
    let v: Tensor2D = tensor_2d_matmul(x, mha.w_v);
    let cfg: AttentionConfig = mha.config;
    let is_causal: Bool = cfg.is_causal;
    let head_dim: Int = cfg.head_dim;
    let out_context: Tensor2D = scaled_dot_product_attention_single_head(q, k, v, seq_len, head_dim, is_causal);
    return tensor_2d_matmul(out_context, mha.w_out);
}

pub fn layer_attention_marker() -> Int {
    return 1;
}
