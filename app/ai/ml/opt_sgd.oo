// # AI/ML Stochastic Gradient Descent (SGD) Optimizer
//
// Logline: Implements classical SGD with Polyak momentum, Nesterov accelerated gradient (NAG), and L2 weight decay.
//
// Setup: Imports tensor_types.oo and tensor_ops.oo for iterative parameter optimization.
//
// Beats:
//   1. Define SGDOptimizer configuration and velocity accumulator state buffers.
//   2. Update parameter vectors with momentum damping and L2 regularization weight decay.
//   3. Support Nesterov momentum lookahead updates for accelerated convergence.

import "tensor_types.oo";
import "tensor_ops.oo";
import "std/core/math/constants.oo";
fn circ_pi_std_ai_ml_opt_sgd() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }


// -------------------------------------------------------------------
// SGD Configuration & Optimizer State
// -------------------------------------------------------------------

type SGDConfig = struct {
    lr: Float,
    momentum: Float,
    weight_decay: Float,
    dampening: Float,
    nesterov: Bool
};

type SGDOptimizer = struct {
    config: SGDConfig,
    step_count: Int,
    velocity: List[Float]
};

pub fn sgd_config_default(lr: Float) -> SGDConfig {
    return SGDConfig {
        lr: lr,
        momentum: 0.9,
        weight_decay: 0.0001,
        dampening: 0.0,
        nesterov: false
    };
}

pub fn sgd_optimizer_new(config: SGDConfig, param_count: Int) -> SGDOptimizer {
    let mut v: List[Float] = list_new();
    let mut i: Int = 0;    while i < param_count {
        v = list_push(v, 0.0);
        i = i + 1;
    }
    return SGDOptimizer {
        config: config,
        step_count: 0,
        velocity: v
    };
}

// -------------------------------------------------------------------
// Parameter Update Step
// -------------------------------------------------------------------

pub fn sgd_step_1d(opt: SGDOptimizer, param: Tensor1D, grad: Tensor1D) -> Tensor1D {
    let grad_data_list: List[Float] = grad.data;
    let opt_velocity_list: List[Float] = opt.velocity;
    let param_data_list: List[Float] = param.data;
    let n: Int = param.size;
    let lr: Float = (opt.config).lr;
    let mom: Float = (opt.config).momentum;
    let wd: Float = (opt.config).weight_decay;
    let nesterov: Bool = (opt.config).nesterov;
    let mut new_param: List[Float] = list_new();
    let mut new_vel: List[Float] = list_new();

    let mut i: Int = 0;    while i < n {
        let p: Float = list_get(param_data_list, i);        let mut g: Float = list_get(grad_data_list, i);
        // L2 weight decay: g = g + wd * p
        if wd != 0.0 {
            g = g + (wd * p);
        }

        let mut v: Float = list_get(opt_velocity_list, i);        if mom != 0.0 {
            v = (mom * v) + g;
            if nesterov {
                g = g + (mom * v);
            } else {
                g = v;
            }
        }
        new_vel = list_push(new_vel, v);
        new_param = list_push(new_param, p - (lr * g));
        i = i + 1;
    }

    return Tensor1D { data: new_param, size: n };
}

// -------------------------------------------------------------------
// Learning Rate Schedules
// -------------------------------------------------------------------

pub fn sgd_learning_rate_schedule_cosine(base_lr: Float, current_step: Int, max_steps: Int) -> Float {
    if current_step >= max_steps {
        return 0.0;
    }
    let pi_val: Float = circ_pi_std_ai_ml_opt_sgd();    let progress = int_to_float(current_step) / int_to_float(max_steps);
    let cosine_decay: Float = 0.5 * (1.0 + cos(progress * pi_val));    return base_lr * cosine_decay;
}

pub fn opt_sgd_marker() -> Int {
    return 1;
}
