// # AI/ML Tensor Core Types
//
// Logline: Defines core multi-dimensional tensor data structures, shapes, striding metadata, data types, and device configurations.
//
// Setup: Pure data type definitions for 1D, 2D, 3D, and 4D tensor representations and runtime descriptors.
//
// Beats:
//   1. Define DType enum markers and TensorShape structures.
//   2. Define Tensor1D, Tensor2D, Tensor3D, and Tensor4D dense storage records.
//   3. Define TensorDescriptor, DeviceTarget, and GradTensor structures.

// -------------------------------------------------------------------
// Data Types and Device Constants
// -------------------------------------------------------------------

pub fn dtype_float32() -> Int { return 1; }
pub fn dtype_float64() -> Int { return 2; }
pub fn dtype_int32() -> Int { return 3; }
pub fn dtype_int64() -> Int { return 4; }
pub fn dtype_bool() -> Int { return 5; }

pub fn device_cpu() -> Int { return 0; }
pub fn device_cuda() -> Int { return 1; }
pub fn device_metal() -> Int { return 2; }
pub fn device_tpu() -> Int { return 3; }

// -------------------------------------------------------------------
// Core Tensor Structures
// -------------------------------------------------------------------

type TensorShape = struct {
    dim0: Int,
    dim1: Int,
    dim2: Int,
    dim3: Int,
    rank: Int,
    size: Int
};

type Tensor1D = struct {
    data: List[Float],
    size: Int
};

type Tensor2D = struct {
    data: List[Float],
    rows: Int,
    cols: Int
};

type Tensor3D = struct {
    data: List[Float],
    d0: Int,
    d1: Int,
    d2: Int
};

type Tensor4D = struct {
    data: List[Float],
    b: Int,
    c: Int,
    h: Int,
    w: Int
};

type TensorDescriptor = struct {
    shape: TensorShape,
    dtype: Int,
    device: Int,
    requires_grad: Bool
};

type GradTensor = struct {
    data: List[Float],
    grad: List[Float],
    shape: TensorShape,
    requires_grad: Bool
};

// -------------------------------------------------------------------
// Shape Constructors and Helpers
// -------------------------------------------------------------------

pub fn tensor_shape_1d(d0: Int) -> TensorShape {
    return TensorShape {
        dim0: d0,
        dim1: 1,
        dim2: 1,
        dim3: 1,
        rank: 1,
        size: d0
    };
}

pub fn tensor_shape_2d(d0: Int, d1: Int) -> TensorShape {
    return TensorShape {
        dim0: d0,
        dim1: d1,
        dim2: 1,
        dim3: 1,
        rank: 2,
        size: d0 * d1
    };
}

pub fn tensor_shape_3d(d0: Int, d1: Int, d2: Int) -> TensorShape {
    return TensorShape {
        dim0: d0,
        dim1: d1,
        dim2: d2,
        dim3: 1,
        rank: 3,
        size: (d0 * d1) * d2
    };
}

pub fn tensor_shape_4d(d0: Int, d1: Int, d2: Int, d3: Int) -> TensorShape {
    return TensorShape {
        dim0: d0,
        dim1: d1,
        dim2: d2,
        dim3: d3,
        rank: 4,
        size: ((d0 * d1) * d2) * d3
    };
}

pub fn tensor_shape_numel(shape: TensorShape) -> Int {
    return shape.size;
}

pub fn tensor_shape_equals(a: TensorShape, b: TensorShape) -> Bool {
    let eq: Bool = a.rank == b.rank;
    if !eq { return false; }
    let eq0: Bool = a.dim0 == b.dim0;
    if !eq0 { return false; }
    let eq1: Bool = a.dim1 == b.dim1;
    if !eq1 { return false; }
    let eq2: Bool = a.dim2 == b.dim2;
    if !eq2 { return false; }
    let eq3: Bool = a.dim3 == b.dim3;
    if !eq3 { return false; }
    return true;
}

pub fn tensor_1d_new(data: List[Float], size: Int) -> Tensor1D {
    return Tensor1D {
        data: data,
        size: size
    };
}

pub fn tensor_1d_get(t: Tensor1D, idx: Int) -> Float {
    return list_get(t.data, idx);
}

pub fn tensor_2d_new(data: List[Float], rows: Int, cols: Int) -> Tensor2D {
    return Tensor2D {
        data: data,
        rows: rows,
        cols: cols
    };
}

pub fn tensor_2d_get(t: Tensor2D, r: Int, c: Int) -> Float {
    let num_cols: Int = t.cols;
    let row_offset: Int = r * num_cols;
    let idx: Int = row_offset + c;
    return list_get(t.data, idx);
}

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn tensor_types_marker() -> Int {
    return 1;
}

