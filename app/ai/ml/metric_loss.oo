// # Scalar MSE loss
//
// Logline: Integer squared error of one prediction versus one target.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// Implementation: pure discrete integer representations.

import "std/app/ai/ml/tensor_types.oo";

fn tensor_types_marker() -> Int { return dtype_float32(); }

pub fn mse_loss(pred: Int, target: Int) -> Int {
    let d: Int = pred - target;
    return d * d;
}
