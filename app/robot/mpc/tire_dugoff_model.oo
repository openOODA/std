// # Dugoff Combined-Slip Tire Dynamics Model
//
// Logline: Computes analytical combined longitudinal traction and lateral cornering forces under high slip and tire load variations.
//
// Setup: Closed-form tire model providing smooth continuous transitions between linear adhesion and saturated sliding regimes.
//
// Beats:
//   1. Formulate modified longitudinal and lateral slip ratios sigma_x and sigma_y.
//   2. Compute the Dugoff lambda scaling variable balancing friction limit utilization.
//   3. Apply the piecewise parabolic/reciprocal Dugoff traction function f(lambda).
//   4. Calculate resulting combined tire forces Fx and Fy.

type DugoffParams = struct {
    stiff_longitudinal: Float,
    stiff_lateral: Float,
    friction_mu: Float
};

type DugoffOutput = struct {
    fx: Float,
    fy: Float,
    lambda_val: Float
};

pub fn dugoff_params_default() -> DugoffParams {
    return DugoffParams {
        stiff_longitudinal: 120000.0,
        stiff_lateral: 85000.0,
        friction_mu: 0.95
    };
}

pub fn compute_dugoff_forces(
    kappa: Float,
    alpha_rad: Float,
    fz: Float,
    p: DugoffParams
) -> DugoffOutput {
    let mut safe_fz: Float = fz;

    if fz < 10.0 {

        safe_fz = 10.0;

    }
    let denom_slip: Float = 1.0 + kappa;
    let mut safe_denom: Float = denom_slip;

    if denom_slip < 0.1 {

        safe_denom = 0.1;

    }

    let sigma_x: Float = kappa / safe_denom;
    let tan_alpha: Float = sin(alpha_rad) / cos(alpha_rad);
    let sigma_y: Float = tan_alpha / safe_denom;

    let cx_sx: Float = p.stiff_longitudinal * sigma_x;
    let cy_sy: Float = p.stiff_lateral * sigma_y;
    let resultant_stiff: Float = sqrt((cx_sx * cx_sx) + (cy_sy * cy_sy));

    let mu_fz: Float = p.friction_mu * safe_fz;
    let mut lambda_val: Float = 10.0;

    if resultant_stiff > 0.001 {

        lambda_val = mu_fz / (2.0 * resultant_stiff);

    }

    let mut f_lambda: Float = 1.0;


    if lambda_val < 1.0 {


        f_lambda = (2.0 - lambda_val) * lambda_val;


    }

    let fx: Float = cx_sx * f_lambda;
    let fy: Float = (0.0 - cy_sy) * f_lambda;

    return DugoffOutput {
        fx: fx,
        fy: fy,
        lambda_val: lambda_val
    };
}
