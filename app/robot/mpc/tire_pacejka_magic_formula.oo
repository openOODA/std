// # Pacejka Magic Formula 5.2 Tire Force Engine
//
// Logline: Computes nonlinear lateral tire forces, longitudinal traction, and self-aligning torque using empirical Pacejka Magic Formula coefficients.
//
// Setup: High-fidelity nonlinear tire force generator calculating Fy, Fx, and Mz across variable normal loads Fz and slip angles alpha.
//
// Beats:
//   1. Define Pacejka Magic Formula curve parameters (B stiffness, C shape, D peak, E curvature).
//   2. Calculate pure lateral cornering force Fy as a function of slip angle and normal load.
//   3. Calculate pure longitudinal traction/braking force Fx from slip ratio kappa.
//   4. Calculate self-aligning torque Mz using pneumatic trail and residual torque.

type PacejkaCoefficients = struct {
    b_stiff: Float,
    c_shape: Float,
    d_peak: Float,
    e_curve: Float
};

type TireForcesOutput = struct {
    fx: Float,
    fy: Float,
    mz: Float
};

pub fn pacejka_lateral_default() -> PacejkaCoefficients {
    return PacejkaCoefficients {
        b_stiff: 10.0,
        c_shape: 1.3,
        d_peak: 1.0,
        e_curve: 0.97
    };
}

pub fn pacejka_longitudinal_default() -> PacejkaCoefficients {
    return PacejkaCoefficients {
        b_stiff: 12.0,
        c_shape: 1.65,
        d_peak: 1.05,
        e_curve: 0.95
    };
}

pub fn pacejka_eval(slip: Float, fz: Float, coeff: PacejkaCoefficients) -> Float {
    let peak_d: Float = coeff.d_peak * fz;
    let b: Float = coeff.b_stiff;
    let c: Float = coeff.c_shape;
    let e: Float = coeff.e_curve;

    let bx: Float = b * slip;
    // Approximating atan(bx)
    let bx_sq: Float = bx * bx;
    let mut atan_bx: Float = (0.0 - 1.570796) - (1.0 / bx);
    if bx > 0.0 {
        atan_bx = 1.570796 - (1.0 / bx);
    }

    if (bx > 0.0 - 1.0) && (bx < 1.0) {

        atan_bx = bx * (1.0 - (0.33333333 * bx_sq));

    }

    let inner_arg: Float = (b * slip) - (e * ((b * slip) - atan_bx));
    let inner_sq: Float = inner_arg * inner_arg;
    let mut atan_inner: Float = (0.0 - 1.570796) - (1.0 / inner_arg);
    if inner_arg > 0.0 {
        atan_inner = 1.570796 - (1.0 / inner_arg);
    }

    if (inner_arg > 0.0 - 1.0) && (inner_arg < 1.0) {

        atan_inner = inner_arg * (1.0 - (0.33333333 * inner_sq));

    }

    let force: Float = peak_d * sin(c * atan_inner);
    return force;
}

pub fn compute_pacejka_tire_forces(
    slip_angle_rad: Float,
    slip_ratio_kappa: Float,
    fz_n: Float,
    lat_coeff: PacejkaCoefficients,
    long_coeff: PacejkaCoefficients
) -> TireForcesOutput {
    let mut safe_fz: Float = fz_n;

    if fz_n < 10.0 {

        safe_fz = 10.0;

    }
    let fy_pure: Float = pacejka_eval(0.0 - slip_angle_rad, safe_fz, lat_coeff);
    let fx_pure: Float = pacejka_eval(slip_ratio_kappa, safe_fz, long_coeff);

    // Friction ellipse combined scaling
    let combined_slip: Float = sqrt((slip_ratio_kappa * slip_ratio_kappa) + (slip_angle_rad * slip_angle_rad));
    let mut friction_factor: Float = 1.0;

    if combined_slip > 0.15 {

        friction_factor = 0.15 / combined_slip;

    }

    let fx: Float = fx_pure * friction_factor;
    let fy: Float = fy_pure * friction_factor;
    // Self-aligning torque Mz = -Pneumatic_trail * Fy
    let pneumatic_trail: Float = 0.03;
    let mz: Float = (0.0 - pneumatic_trail) * fy;

    return TireForcesOutput { fx: fx, fy: fy, mz: mz };
}
