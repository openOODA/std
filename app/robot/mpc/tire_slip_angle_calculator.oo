// # Tire Slip Angle & Slip Ratio Kinematic Resolver
//
// Logline: Calculates front and rear axle slip angles and longitudinal slip ratios from body velocities and wheel rotation rates.
//
// Setup: Exact kinematic calculator converting chassis velocities (vx, vy, r) and steering angles into tire contact patch slip vectors.
//
// Beats:
//   1. Compute front axle center lateral velocity and front tire slip angle alpha_f.
//   2. Compute rear axle center lateral velocity and rear tire slip angle alpha_r.
//   3. Compute individual wheel longitudinal slip ratios kappa from wheel angular velocities.
//   4. Calculate chassis center of gravity sideslip angle beta.

type AxleSlipAngles = struct {
    alpha_f: Float,
    alpha_r: Float,
    beta_cg: Float
};

pub fn compute_axle_slip_angles(
    vx: Float,
    vy: Float,
    yaw_rate: Float,
    steer_rad: Float,
    dist_front: Float,
    dist_rear: Float
) -> AxleSlipAngles {
    let mut safe_vx: Float = vx;

    if vx < 0.5 {

        safe_vx = 0.5;

    }

    // Front slip angle: delta - atan((vy + lf*r)/vx)
    let vy_front: Float = vy + (dist_front * yaw_rate);
    let ratio_f: Float = vy_front / safe_vx;
    let atan_f: Float = ratio_f * (1.0 - (0.33333333 * ratio_f * ratio_f));
    let alpha_f: Float = steer_rad - atan_f;

    // Rear slip angle: -atan((vy - lr*r)/vx)
    let vy_rear: Float = vy - (dist_rear * yaw_rate);
    let ratio_r: Float = vy_rear / safe_vx;
    let atan_r: Float = ratio_r * (1.0 - (0.33333333 * ratio_r * ratio_r));
    let alpha_r: Float = 0.0 - atan_r;

    // Body sideslip angle beta = atan(vy / vx)
    let ratio_b: Float = vy / safe_vx;
    let beta_cg: Float = ratio_b * (1.0 - (0.33333333 * ratio_b * ratio_b));

    return AxleSlipAngles {
        alpha_f: alpha_f,
        alpha_r: alpha_r,
        beta_cg: beta_cg
    };
}

pub fn compute_wheel_slip_ratio(
    wheel_speed_rad_s: Float,
    wheel_radius_m: Float,
    longitudinal_vx_ms: Float
) -> Float {
    let v_wheel: Float = wheel_speed_rad_s * wheel_radius_m;
    let mut safe_v: Float = 0.1;
    if longitudinal_vx_ms < (0.0 - 0.1) {
        safe_v = 0.0 - longitudinal_vx_ms;
    }

    if longitudinal_vx_ms > 0.1 {

        safe_v = longitudinal_vx_ms;

    }

    return (v_wheel - longitudinal_vx_ms) / safe_v;
}
