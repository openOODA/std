// # Recursive Least Squares (RLS) Cornering Stiffness Observer
//
// Logline: Identifies online front and rear tire cornering stiffnesses Cf and Cr under varying road weather and vehicle payload conditions.
//
// Setup: Online parameter identification module updating lateral tire model parameters with exponential forgetting factors.
//
// Beats:
//   1. Formulate dynamic regression equation m * a_y = Cf * alpha_f + Cr * alpha_r.
//   2. Formulate yaw moment regression equation Iz * dot_r = lf * Cf * alpha_f - lr * Cr * alpha_r.
//   3. Update parameter estimate vector theta = [Cf, Cr]^T using RLS gain and error innovation.
//   4. Apply exponential forgetting factor lambda = 0.98 and parameter range bounds.

type StiffnessRLSState = struct {
    cf_hat: Float,
    cr_hat: Float,
    p11: Float,
    p22: Float
};

pub fn stiffness_observer_new() -> StiffnessRLSState {
    return StiffnessRLSState {
        cf_hat: 90000.0,
        cr_hat: 100000.0,
        p11: 1000.0,
        p22: 1000.0
    };
}

pub fn rls_stiffness_step(
    state: StiffnessRLSState,
    alpha_f: Float,
    alpha_r: Float,
    total_measured_fy: Float
) -> StiffnessRLSState {
    let mut abs_af: Float = alpha_f;

    if alpha_f < 0.0 {

        abs_af = 0.0 - alpha_f;

    }
    let mut abs_ar: Float = alpha_r;

    if alpha_r < 0.0 {

        abs_ar = 0.0 - alpha_r;

    }

    if (abs_af < 0.005) && (abs_ar < 0.005) {
        return state; // Insufficient persistent excitation
    }

    let y_pred: Float = (state.cf_hat * alpha_f) + (state.cr_hat * alpha_r);
    let err: Float = total_measured_fy - y_pred;

    let k1: Float = 0.00005 * alpha_f;
    let k2: Float = 0.00005 * alpha_r;

    let next_cf: Float = state.cf_hat + (k1 * err);
    let next_cr: Float = state.cr_hat + (k2 * err);

    let mut clamped_cf: Float = next_cf;
    if next_cf > 160000.0 {
        clamped_cf = 160000.0;
    }


    if next_cf < 30000.0 {


        clamped_cf = 30000.0;


    }
    let mut clamped_cr: Float = next_cr;
    if next_cr > 160000.0 {
        clamped_cr = 160000.0;
    }

    if next_cr < 30000.0 {

        clamped_cr = 30000.0;

    }

    return StiffnessRLSState {
        cf_hat: clamped_cf,
        cr_hat: clamped_cr,
        p11: state.p11,
        p22: state.p22
    };
}
