// # Control Barrier Function (CBF) Safety Filter QP
//
// Logline: Modifies nominal MPC control commands with minimal intervention to guarantee formal forward safety invariance.
//
// Setup: Safety filter solving a 1D/2D QP to enforce barrier condition dot_h(x, u) + gamma * h(x) >= 0.
//
// Beats:
//   1. Formulate safety barrier function h(x) = d_obs^2 - d_safe^2.
//   2. Compute Lie derivatives L_f h(x) and L_g h(x) along vehicle kinematics.
//   3. Construct QP min ||u - u_nom||^2 subject to linear safety half-space constraint.
//   4. Deliver certified safe control input guaranteeing forward invariance of the safe set.

type CBFConfig = struct {
    safe_margin_m: Float,
    gamma_decay: Float,
    max_steer_rad: Float
};

type CBFFilterResult = struct {
    safe_steer_cmd: Float,
    barrier_value_h: Float,
    is_intervention_active: Bool
};

pub fn cbf_config_default() -> CBFConfig {
    return CBFConfig {
        safe_margin_m: 2.0,
        gamma_decay: 1.5,
        max_steer_rad: 0.6
    };
}

pub fn cbf_filter_steering(
    nominal_steer: Float,
    dist_to_obs: Float,
    closing_rate: Float,
    cfg: CBFConfig
) -> CBFFilterResult {
    let h_val: Float = (dist_to_obs * dist_to_obs) - (cfg.safe_margin_m * cfg.safe_margin_m);
    let cbf_constraint: Float = (0.0 - (2.0 * dist_to_obs * closing_rate)) + (cfg.gamma_decay * h_val);

    if cbf_constraint >= 0.0 {
        return CBFFilterResult {
            safe_steer_cmd: nominal_steer,
            barrier_value_h: h_val,
            is_intervention_active: false
        };
    }

    // Intervention required: push steer to clear barrier
    let intervention: Float = 0.2;
    let mut safe_steer: Float = nominal_steer - intervention;

    if nominal_steer > 0.0 {

        safe_steer = nominal_steer + intervention;

    }

    let mut clamped: Float = safe_steer;
    if safe_steer > cfg.max_steer_rad {
        clamped = cfg.max_steer_rad;
    }


    if safe_steer < (0.0 - cfg.max_steer_rad) {


        clamped = 0.0 - cfg.max_steer_rad;


    }

    return CBFFilterResult {
        safe_steer_cmd: clamped,
        barrier_value_h: h_val,
        is_intervention_active: true
    };
}
