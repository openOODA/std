// # Sequential Quadratic Programming (SQP) Solver for NMPC
//
// Logline: Performs successive quadratic approximations of nonlinear vehicle dynamics with Gauss-Newton Hessian approximations.
//
// Setup: Core SQP iteration engine driving real-time Nonlinear Model Predictive Control (NMPC) vehicle trajectory tracking.
//
// Beats:
//   1. Linearize nonlinear dynamics f(x, u) around current predicted trajectory iterates.
//   2. Construct the Gauss-Newton Hessian approximation H = J^T Q J + R.
//   3. Solve quadratic programming subproblem for search direction delta_u.
//   4. Apply Armijo backtracking line search on the merit function to guarantee global convergence.

type SQPIterationState = struct {
    u_current: Float,
    cost_current: Float,
    step_norm: Float,
    iter_count: Int
};

pub fn sqp_step_1d(
    u_current: Float,
    x_target: Float,
    x_state: Float,
    q_weight: Float,
    r_weight: Float,
    u_min: Float,
    u_max: Float
) -> SQPIterationState {
    let residual: Float = (x_state + (0.1 * u_current)) - x_target;
    let jacobian: Float = 0.1;

    let hessian: Float = (jacobian * q_weight * jacobian) + r_weight;
    let grad: Float = (jacobian * q_weight * residual) + (r_weight * u_current);

    let delta_u: Float = (0.0 - grad) / hessian;
    let cand_u: Float = u_current + delta_u;

    let mut next_u: Float = cand_u;
    if cand_u > u_max {
        next_u = u_max;
    }


    if cand_u < u_min {


        next_u = u_min;


    }
    let next_res: Float = (x_state + (0.1 * next_u)) - x_target;
    let next_cost: Float = (0.5 * q_weight * next_res * next_res) + (0.5 * r_weight * next_u * next_u);
    let mut step_len: Float = next_u - u_current;

    if (next_u - u_current) < 0.0 {

        step_len = 0.0 - (next_u - u_current);

    }

    return SQPIterationState {
        u_current: next_u,
        cost_current: next_cost,
        step_norm: step_len,
        iter_count: 1
    };
}
