// # CUSUM Cumulative Sum Drift Detector
//
// Logline: Implements tabular two-sided CUSUM change-point detection for early sensing of small mean shifts in industrial processes.
//
// Setup: Tracks positive ($S^+$) and negative ($S^-$) cumulative sum excursions beyond slack allowance $k$ against decision threshold $h$.
//
// Beats:
//   1. Define CusumState and CusumStepResult structures.
//   2. Compute one-sided positive and negative cumulative sum accumulations with zero-bounding.
//   3. Trigger shift alarms and report cumulative magnitude when decision interval $h$ is breached.

type CusumState = struct {
    target_mean: Float,
    slack_k: Float,
    threshold_h: Float,
    pos_sum: Float,
    neg_sum: Float,
    samples_since_reset: Int
};

type CusumStepResult = struct {
    pos_sum: Float,
    neg_sum: Float,
    alarm_triggered: Bool,
    drift_direction: Int // 0=None, 1=Upward, -1=Downward
};

pub fn cusum_new(target_mean: Float, slack_k: Float, threshold_h: Float) -> CusumState {
    return CusumState {
        target_mean: target_mean,
        slack_k: slack_k,
        threshold_h: threshold_h,
        pos_sum: 0.0,
        neg_sum: 0.0,
        samples_since_reset: 0
    };
}

pub fn cusum_update(state: CusumState, sample: Float) -> CusumStepResult {
    let mu0: Float = state.target_mean;
    let k: Float = state.slack_k;
    let h: Float = state.threshold_h;

    let s_pos_raw: Float = state.pos_sum + sample - mu0 - k;
    let mut s_pos: Float = 0.0;

    if s_pos_raw > 0.0 {

        s_pos = s_pos_raw;

    }

    let s_neg_raw: Float = state.neg_sum - sample + mu0 - k;
    let mut s_neg: Float = 0.0;

    if s_neg_raw > 0.0 {

        s_neg = s_neg_raw;

    }

    let mut alarm_up: Bool = false;


    if s_pos >= h {


        alarm_up = true;


    }
    let mut alarm_down: Bool = false;

    if s_neg >= h {

        alarm_down = true;

    }
    let mut is_alarm: Bool = false;

    if alarm_up || alarm_down {

        is_alarm = true;

    }

    let mut dir: Int = 0;
    if alarm_up {
        dir = 1;
    } else if alarm_down {
        dir = 0 - 1;
    }

    state.pos_sum = s_pos;
    state.neg_sum = s_neg;
    state.samples_since_reset = state.samples_since_reset + 1;

    return CusumStepResult {
        pos_sum: s_pos,
        neg_sum: s_neg,
        alarm_triggered: is_alarm,
        drift_direction: dir
    };
}
