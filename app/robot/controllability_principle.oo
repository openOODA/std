// # Kalman controllability rank test for 2D linear systems
//
// Logline: A 2D linear system (A, B) is controllable when the controllability matrix [B, A*B] is non-singular; equivalently det([B, A*B]) != 0.
//
// Setup: Pure Float, no FS, net, or env. The matrix and vector fields are caller-supplied; NaN inputs fail closed to 0.
//
// Beats:
//   1. Define Matrix2x2 and Vec2 record types and basic linear-algebra operations (mul, det, dot).
//   2. Compute the 2D controllability matrix [B, A*B] and its determinant.
//   3. Return 1 when the system is controllable, 0 otherwise.
//   4. Hostile NaN, zero, or degenerate inputs return 0.

type Matrix2x2 = struct {
    a: Float,
    b: Float,
    c: Float,
    d: Float
};

type Vec2 = struct {
    x: Float,
    y: Float
};

pub fn mat2x2_new(a: Float, b: Float, c: Float, d: Float) -> Matrix2x2 {
    return Matrix2x2 { a: a, b: b, c: c, d: d };
}

pub fn vec2_new(x: Float, y: Float) -> Vec2 {
    return Vec2 { x: x, y: y };
}

// Matrix-matrix product of two 2x2 matrices. NaN fields propagate.
pub fn mat2x2_mul(m1: Matrix2x2, m2: Matrix2x2) -> Matrix2x2 {
    let r_a: Float = (m1.a * m2.a) + (m1.b * m2.c);
    let r_b: Float = (m1.a * m2.b) + (m1.b * m2.d);
    let r_c: Float = (m1.c * m2.a) + (m1.d * m2.c);
    let r_d: Float = (m1.c * m2.b) + (m1.d * m2.d);
    return Matrix2x2 { a: r_a, b: r_b, c: r_c, d: r_d };
}

// Determinant of a 2x2 matrix.
pub fn mat2x2_det(m: Matrix2x2) -> Float {
    return (m.a * m.d) - (m.b * m.c);
}

// Dot product of two 2D vectors.
pub fn vec2_dot(v1: Vec2, v2: Vec2) -> Float {
    return (v1.x * v2.x) + (v1.y * v2.y);
}

// Apply a 2x2 matrix to a 2D vector.
pub fn mat2x2_apply(m: Matrix2x2, v: Vec2) -> Vec2 {
    let nx: Float = (m.a * v.x) + (m.b * v.y);
    let ny: Float = (m.c * v.x) + (m.d * v.y);
    return Vec2 { x: nx, y: ny };
}

// Kalman rank test for 2D linear system (A, B):
//   C = [B, A*B] (a 2x2 matrix whose columns are B and A*B).
//   The system is controllable iff det(C) != 0.
// Hostile (NaN) inputs and a singular controllability matrix return 0.
pub fn is_controllable_2d(A: Matrix2x2, B: Vec2) -> Int {
    let mut aa: Float = A.a;
    let mut ab_: Float = A.b;
    let mut ac: Float = A.c;
    let mut ad: Float = A.d;
    if aa != aa { return 0; }
    if ab_ != ab_ { return 0; }
    if ac != ac { return 0; }
    if ad != ad { return 0; }
    let mut bx: Float = B.x;
    let mut by: Float = B.y;
    if bx != bx { return 0; }
    if by != by { return 0; }
    let ab_vec: Vec2 = mat2x2_apply(A, B);
    let mut abx: Float = ab_vec.x;
    let mut aby: Float = ab_vec.y;
    if abx != abx { return 0; }
    if aby != aby { return 0; }
    let det_c: Float = (bx * aby) - (by * abx);
    if det_c != det_c { return 0; }
    if det_c == 0.0 { return 0; }
    return 1;
}

pub fn verify_controllability_principle() -> Bool {
    // Golden: 2D double integrator, A = [0 1; 0 0], B = (0, 1).
    // A*B = (1, 0). C = [B, A*B] = |0 1; 1 0|, det = -1. Controllable.
    let a_int: Matrix2x2 = mat2x2_new(0.0, 1.0, 0.0, 0.0);
    let b_int: Vec2 = vec2_new(0.0, 1.0);
    if is_controllable_2d(a_int, b_int) != 1 {
        return false;
    }
    // Golden: A = [1 2; 3 4], B = (1, 1). A*B = (3, 7), det = 1*7 - 1*3 = 4. Controllable.
    let a_full: Matrix2x2 = mat2x2_new(1.0, 2.0, 3.0, 4.0);
    let b_full: Vec2 = vec2_new(1.0, 1.0);
    if is_controllable_2d(a_full, b_full) != 1 {
        return false;
    }
    // Golden: A = [2 0; 0 3], B = (1, 1). A*B = (2, 3), det = 1*3 - 1*2 = 1. Controllable.
    let a_diag: Matrix2x2 = mat2x2_new(2.0, 0.0, 0.0, 3.0);
    let b_diag: Vec2 = vec2_new(1.0, 1.0);
    if is_controllable_2d(a_diag, b_diag) != 1 {
        return false;
    }
    // Hostile: zero B vector -> A*B = 0, det = 0, not controllable.
    let a_id: Matrix2x2 = mat2x2_new(1.0, 0.0, 0.0, 1.0);
    let b_zero: Vec2 = vec2_new(0.0, 0.0);
    if is_controllable_2d(a_id, b_zero) != 0 {
        return false;
    }
    // Hostile: zero A matrix -> A*B = 0, det = 0, not controllable.
    let a_zero: Matrix2x2 = mat2x2_new(0.0, 0.0, 0.0, 0.0);
    let b_e1: Vec2 = vec2_new(1.0, 0.0);
    if is_controllable_2d(a_zero, b_e1) != 0 {
        return false;
    }
    // Hostile: identity A is never controllable (AB = B makes C rank 1).
    let b_e2: Vec2 = vec2_new(0.0, 1.0);
    if is_controllable_2d(a_id, b_e1) != 0 {
        return false;
    }
    if is_controllable_2d(a_id, b_e2) != 0 {
        return false;
    }
    // Hostile: B along the null of A, A*B = 0 even though B != 0.
    // A = [0 0; 0 1], B = (1, 0) -> A*B = (0, 0), det = 0.
    let a_null: Matrix2x2 = mat2x2_new(0.0, 0.0, 0.0, 1.0);
    if is_controllable_2d(a_null, b_e1) != 0 {
        return false;
    }
    // Sanity: mat2x2_mul and mat2x2_det on the identity.
    let id_m: Matrix2x2 = mat2x2_new(1.0, 0.0, 0.0, 1.0);
    let id2: Matrix2x2 = mat2x2_mul(id_m, id_m);
    let d_id: Float = mat2x2_det(id_m);
    let mut d_id_diff: Float = d_id - 1.0;
    if d_id_diff < 0.0 { d_id_diff = 0.0 - d_id_diff; }
    if d_id_diff > 0.0000001 { return false; }
    if id2.a != 1.0 { return false; }
    if id2.d != 1.0 { return false; }
    // vec2_dot checks.
    let v1: Vec2 = vec2_new(1.0, 2.0);
    let v2: Vec2 = vec2_new(3.0, 4.0);
    let dv: Float = vec2_dot(v1, v2);
    let mut ddv: Float = dv - 11.0;
    if ddv < 0.0 { ddv = 0.0 - ddv; }
    if ddv > 0.0000001 { return false; }
    return true;
}
