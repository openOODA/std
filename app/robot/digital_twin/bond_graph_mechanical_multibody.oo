// # Mechanical Multibody & Kinematic Bond Graphs
//
// Logline: 1D/3D translational and rotational multi-body mechanics with springs, dampers, Coulomb stiction, and gear trains.
//
// Setup: Formulates kinetic/potential multi-body junctions, velocity-effort transformations, and nonlinear friction.
//
// Beats:
//   1. Define MechanicalBody1D, GearboxTransformer, and FrictionElement structures.
//   2. Model Karnopp/Coulomb friction with stick-slip zero-velocity boundary conditions.
//   3. Step forward multi-mass spring-damper powertrain dynamics.

type MechanicalBody1D = struct {
    mass_kg: Float,
    stiffness_n_per_m: Float,
    damping_n_s_per_m: Float,
    position_m: Float,
    velocity_m_s: Float
};

type GearboxTransformer = struct {
    gear_ratio: Float, // N = w_in / w_out = tau_out / tau_in
    efficiency: Float,
    backlash_rad: Float
};

type FrictionElement = struct {
    coulomb_force_n: Float,
    static_friction_n: Float,
    viscous_coeff: Float,
    stiction_velocity_threshold: Float
};

pub fn mechanical_body_new(m: Float, k: Float, b: Float, x0: Float, v0: Float) -> MechanicalBody1D {
    return MechanicalBody1D {
        mass_kg: m,
        stiffness_n_per_m: k,
        damping_n_s_per_m: b,
        position_m: x0,
        velocity_m_s: v0
    };
}

pub fn eval_karnopp_friction(fric: FrictionElement, velocity: Float, external_force: Float) -> Float {
    let v_thresh: Float = fric.stiction_velocity_threshold;
    let mut v_abs: Float = velocity;
    if v_abs < 0.0 { v_abs = 0.0 - v_abs; }

    if v_abs < v_thresh {
        // Stiction zone: friction opposes external force up to static limit
        let mut f_ext_abs: Float = external_force;
        if f_ext_abs < 0.0 { f_ext_abs = 0.0 - f_ext_abs; }
        if f_ext_abs <= fric.static_friction_n {
            return 0.0 - external_force;
        } else {
            let mut sign: Float = 0.0 - 1.0;
            if external_force > 0.0 {
                sign = 1.0;
            }
            return 0.0 - (sign * fric.static_friction_n);
        }
    } else {
        // Sliding zone: Coulomb + Viscous friction
        let mut sign: Float = 0.0 - 1.0;
        if velocity > 0.0 {
            sign = 1.0;
        }
        return 0.0 - ((sign * fric.coulomb_force_n) + (fric.viscous_coeff * velocity));
    }
}

pub fn eval_gearbox_tf(gb: GearboxTransformer, w_in: Float, tau_in: Float) -> List[Float] {
    let n: Float = gb.gear_ratio;
    let eta: Float = gb.efficiency;
    let mut w_out: Float = 0.0;
    if n != 0.0 {
        w_out = w_in / n;
    }
    let tau_out: Float = n * tau_in * eta;

    let mut res: List[Float] = list_new();
    res = list_push(res, w_out);
    res = list_push(res, tau_out);
    return res;
}

pub fn step_mass_spring_damper(body: MechanicalBody1D, external_force_n: Float, dt: Float) -> MechanicalBody1D {
    let m: Float = body.mass_kg;
    let k: Float = body.stiffness_n_per_m;
    let b: Float = body.damping_n_s_per_m;
    let x: Float = body.position_m;
    let v: Float = body.velocity_m_s;

    // F_net = F_ext - Kx - Bv
    let f_spring: Float = k * x;
    let f_damper: Float = b * v;
    let f_net: Float = external_force_n - f_spring - f_damper;
    let mut accel: Float = 0.0;
    if m > 0.0 {
        accel = f_net / m;
    }

    let next_v: Float = v + (accel * dt);
    let next_x: Float = x + (next_v * dt);

    return MechanicalBody1D {
        mass_kg: m,
        stiffness_n_per_m: k,
        damping_n_s_per_m: b,
        position_m: next_x,
        velocity_m_s: next_v
    };
}
