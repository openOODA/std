// # CAN 2.0B Bus Structures & DBC Signal Definitions
//
// Logline: Defines CAN 2.0B standard/extended frames and DBC signal specifications with scale and offset mappings.
//
// Setup: Pure automotive and industrial HAL data types with zero struct trailing commas.
//
// Beats:
//   1. Define CanFrame for 11-bit standard and 29-bit extended identifier frames.
//   2. Define CanSignalDef for Intel/Motorola endian bit packing, scaling, and offset parameters.
//   3. Define CanDecodedSignal representing decoded engineering units.

type CanFrame = struct {
    can_id: Int,
    is_extended: Bool,
    is_rtr: Bool,
    is_error: Bool,
    dlc: Int,
    data: List[Int]
};

type CanSignalDef = struct {
    name: String,
    start_bit: Int,
    bit_length: Int,
    is_big_endian: Bool,
    is_signed: Bool,
    scale: Float,
    offset: Float
};

type CanDecodedSignal = struct {
    name: String,
    raw_val: Int,
    physical_val: Float
};

pub fn can_frame_id(f: CanFrame) -> Int {
    return f.can_id;
}
