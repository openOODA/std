// # 6x6 Dense Matrix Operations
//
// Logline: Minimal 6x6 linear algebra helpers for DLS inverse kinematics.
//
// Setup: Pure fixed-size dense matrix ops using flat List[Float] (row-major 36 entries).
//
// Beats:
//   1. Build J * J^T + lambda^2 * I directly from a 6x6 flat Jacobian.
//   2. Solve A x = b with partial-pivot Gaussian elimination.
//   3. Provide vector dot product and J^T * v multiply.
//   4. Stay under 256 lines and avoid dynamic allocation beyond List operations.
// residual: Cholesky, SVD, and sparse block forms are residual.

pub fn mat6_jjt(j: List[Float], lambda_sq: Float) -> List[Float] {
    let mut a: List[Float] = list_new();
    let mut r: Int = 0;
    while r < 6 {
        let mut c: Int = 0;
        while c < 6 {
            let mut s: Float = 0.0;
            let mut k: Int = 0;
            while k < 6 {
                s = s + (list_get(j, (r * 6) + k) * list_get(j, (c * 6) + k));
                k = k + 1;
            }
            if r == c { s = s + lambda_sq; }
            a = list_push(a, s);
            c = c + 1;
        }
        r = r + 1;
    }
    return a;
}

pub fn mat6_solve(a: List[Float], b: List[Float]) -> Result[List[Float], String] {
    let mut m: List[Float] = list_new();
    let mut r: Int = 0;
    while r < 6 {
        let mut c: Int = 0;
        while c < 6 {
            m = list_push(m, list_get(a, (r * 6) + c));
            c = c + 1;
        }
        m = list_push(m, list_get(b, r));
        r = r + 1;
    }
    let n: Int = 6;
    let mut col: Int = 0;
    while col < n {
        let mut pivot: Int = col;
        let mut max_val: Float = 0.0;
        let mut rr: Int = col;
        while rr < n {
            let v: Float = list_get(m, (rr * 7) + col);
            let av: Float = if v < 0.0 { 0.0 - v } else { v };
            if av > max_val {
                max_val = av;
                pivot = rr;
            }
            rr = rr + 1;
        }
        if max_val < 0.0000000001 {
            return Err("ERR\tmat6_solve\tsingular");
        }
        if pivot != col {
            let mut cc: Int = 0;
            while cc < 7 {
                let tmp: Float = list_get(m, (col * 7) + cc);
                m = list_set(m, (col * 7) + cc, list_get(m, (pivot * 7) + cc));
                m = list_set(m, (pivot * 7) + cc, tmp);
                cc = cc + 1;
            }
        }
        let piv: Float = list_get(m, (col * 7) + col);
        let mut cc2: Int = col;
        while cc2 < 7 {
            m = list_set(m, (col * 7) + cc2, list_get(m, (col * 7) + cc2) / piv);
            cc2 = cc2 + 1;
        }
        let mut rr2: Int = 0;
        while rr2 < n {
            if rr2 != col {
                let fac: Float = list_get(m, (rr2 * 7) + col);
                let mut cc3: Int = col;
                while cc3 < 7 {
                    m = list_set(m, (rr2 * 7) + cc3, list_get(m, (rr2 * 7) + cc3) - (fac * list_get(m, (col * 7) + cc3)));
                    cc3 = cc3 + 1;
                }
            }
            rr2 = rr2 + 1;
        }
        col = col + 1;
    }
    let mut x: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        x = list_push(x, list_get(m, (i * 7) + n));
        i = i + 1;
    }
    return Ok(x);
}

pub fn mat6_jt_v(j: List[Float], v: List[Float]) -> List[Float] {
    let mut dq: List[Float] = list_new();
    let mut c: Int = 0;
    while c < 6 {
        let mut s: Float = 0.0;
        let mut r: Int = 0;
        while r < 6 {
            s = s + (list_get(j, (r * 6) + c) * list_get(v, r));
            r = r + 1;
        }
        dq = list_push(dq, s);
        c = c + 1;
    }
    return dq;
}
