// # Hierarchical AABB Tree Broad-Phase Collision Detection
//
// Logline: Accelerates multi-object collision queries using Axis-Aligned Bounding Box (AABB) volume hierarchies.
//
// Setup: Broad-phase spatial acceleration structure culling disjoint robot link and environment geometry.
//
// Beats:
//   1. Define 3D Axis-Aligned Bounding Box (min, max) representations.
//   2. Test bounding box intersection via Separating Axis Theorem (SAT).
//   3. Merge child bounding volumes into hierarchical parent AABBs.
//   4. Compute box volume and surface area heuristics for tree balancing.

type AABB3D = struct {
    min_x: Float, min_y: Float, min_z: Float,
    max_x: Float, max_y: Float, max_z: Float
};

type AABBNode = struct {
    box: AABB3D,
    left_child: Int,
    right_child: Int,
    object_id: Int,
    is_leaf: Bool
};

pub fn aabb_new(
    min_x: Float, min_y: Float, min_z: Float,
    max_x: Float, max_y: Float, max_z: Float
) -> AABB3D {
    return AABB3D {
        min_x: min_x, min_y: min_y, min_z: min_z,
        max_x: max_x, max_y: max_y, max_z: max_z
    };
}

pub fn aabb_overlap(a: AABB3D, b: AABB3D) -> Bool {
    if a.max_x < b.min_x || a.min_x > b.max_x { return false; }
    if a.max_y < b.min_y || a.min_y > b.max_y { return false; }
    if a.max_z < b.min_z || a.min_z > b.max_z { return false; }
    return true;
}

pub fn aabb_merge(a: AABB3D, b: AABB3D) -> AABB3D {
    let mut min_x: Float = b.min_x;

    if a.min_x < b.min_x {

        min_x = a.min_x;

    }
    let mut min_y: Float = b.min_y;

    if a.min_y < b.min_y {

        min_y = a.min_y;

    }
    let mut min_z: Float = b.min_z;

    if a.min_z < b.min_z {

        min_z = a.min_z;

    }

    let mut max_x: Float = b.max_x;


    if a.max_x > b.max_x {


        max_x = a.max_x;


    }
    let mut max_y: Float = b.max_y;

    if a.max_y > b.max_y {

        max_y = a.max_y;

    }
    let mut max_z: Float = b.max_z;

    if a.max_z > b.max_z {

        max_z = a.max_z;

    }

    return AABB3D {
        min_x: min_x, min_y: min_y, min_z: min_z,
        max_x: max_x, max_y: max_y, max_z: max_z
    };
}

pub fn aabb_volume(box: AABB3D) -> Float {
    let dx: Float = box.max_x - box.min_x;
    let dy: Float = box.max_y - box.min_y;
    let dz: Float = box.max_z - box.min_z;
    return dx * dy * dz;
}

pub fn aabb_contains_point(box: AABB3D, px: Float, py: Float, pz: Float) -> Bool {
    return px >= box.min_x && px <= box.max_x
        && py >= box.min_y && py <= box.max_y
        && pz >= box.min_z && pz <= box.max_z;
}
