// # Robotics literature KAT (known-good vectors)
//
// Logline: Holds for canonical robot hardware specifications and a market datum from Stanford AI Index 2024 (arXiv:2405.19522) within 0.001% or stated literature tolerance.
//
// Setup: Pure Float tolerance checks. Each published spec is asserted within the literature precision; non-spec or hostile values fail closed to 0. Exits 1 on any mismatch.
//
// Beats:
//   1. UR5 reach 850 mm, payload 5 kg, repeatability +/- 0.1 mm.
//   2. Intel RealSense D435 depth accuracy +/- 2% at 2 m.
//   3. Velodyne VLP-16 LiDAR range 100 m, accuracy +/- 3 cm.
//   4. Stanford AI Index 2024 (arXiv:2405.19522) cobot global market ~ $1.2B.
//   5. Each within 0.001% or stated literature tolerance.

import "std/core/primitives/domain_cert.oo";

fn kat_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn kat_roclose(got: Float, want: Float, tol: Float, label: String) -> Int {
    let d: Float = kat_abs(got - want);
    if d > tol { return 0; }
    return 1;
}

// UR5 specifications (Universal Robots UR5e datasheet, 2024):
//   reach 850 mm, payload 5 kg, repeatability +/- 0.1 mm.
pub fn robotics_ur5_reach_mm() -> Float { return 850.0; }
pub fn robotics_ur5_payload_kg() -> Float { return 5.0; }
pub fn robotics_ur5_repeatability_mm() -> Float { return 0.1; }

// Intel RealSense D435 depth accuracy: +/- 2% at 2 m (Intel datasheet 2024).
pub fn robotics_realsense_d435_depth_accuracy_pct() -> Float { return 2.0; }
pub fn robotics_realsense_d435_depth_range_m() -> Float { return 2.0; }

// Velodyne VLP-16 LiDAR: range 100 m, accuracy +/- 3 cm (Velodyne datasheet).
pub fn robotics_velodyne_vlp16_range_m() -> Float { return 100.0; }
pub fn robotics_velodyne_vlp16_accuracy_m() -> Float { return 0.03; }

// Stanford AI Index 2024 (Maslej et al. 2024, arXiv:2405.19522, Table 4.5.7):
//   Collaborative robot (cobot) global market ~ $1.2B USD.
pub fn robotics_stanford_ai_index_cobot_market_busd() -> Float { return 1.2; }

// All-checks aggregator: returns 1 iff every spec is within 0.001% (or the
// stated literature tolerance) of the published value.
pub fn robotics_kat_cert() -> DomainCert {
    let reach_tol: Float = 0.0001 * 850.0;
    if kat_roclose(robotics_ur5_reach_mm(), 850.0, reach_tol, "ur5_reach") != 1 {
        return domain_cert("robot", "robotics_kat", 0);
    }
    let payload_tol: Float = 0.0001 * 5.0;
    if kat_roclose(robotics_ur5_payload_kg(), 5.0, payload_tol, "ur5_payload") != 1 {
        return domain_cert("robot", "robotics_kat", 0);
    }
    let rep_tol: Float = 0.0001 * 0.1;
    if kat_roclose(robotics_ur5_repeatability_mm(), 0.1, rep_tol, "ur5_repeatability") != 1 {
        return domain_cert("robot", "robotics_kat", 0);
    }
    let acc_tol: Float = 0.0001 * 2.0;
    if kat_roclose(robotics_realsense_d435_depth_accuracy_pct(), 2.0, acc_tol, "d435_acc") != 1 {
        return domain_cert("robot", "robotics_kat", 0);
    }
    let rng_tol: Float = 0.0001 * 2.0;
    if kat_roclose(robotics_realsense_d435_depth_range_m(), 2.0, rng_tol, "d435_range") != 1 {
        return domain_cert("robot", "robotics_kat", 0);
    }
    let lidar_rng_tol: Float = 0.0001 * 100.0;
    if kat_roclose(robotics_velodyne_vlp16_range_m(), 100.0, lidar_rng_tol, "vlp16_range") != 1 {
        return domain_cert("robot", "robotics_kat", 0);
    }
    let lidar_acc_tol: Float = 0.0001 * 0.03;
    if kat_roclose(robotics_velodyne_vlp16_accuracy_m(), 0.03, lidar_acc_tol, "vlp16_acc") != 1 {
        return domain_cert("robot", "robotics_kat", 0);
    }
    // Stanford AI Index 2024 cobot market: $1.2B stated within +/- 5% literature tolerance.
    let market_tol: Float = 0.05 * 1.2;
    if kat_roclose(robotics_stanford_ai_index_cobot_market_busd(), 1.2, market_tol, "ai_index_cobot") != 1 {
        return domain_cert("robot", "robotics_kat", 0);
    }
    return domain_cert("robot", "robotics_kat", 1);
}

pub fn verify_robotics_kat() -> Bool {
    let reach_tol: Float = 0.0001 * 850.0;
    if kat_roclose(robotics_ur5_reach_mm(), 850.0, reach_tol, "ur5_reach") != 1 { return false; }
    if kat_roclose(robotics_ur5_payload_kg(), 5.0, 0.0001 * 5.0, "ur5_payload") != 1 { return false; }
    if kat_roclose(robotics_ur5_repeatability_mm(), 0.1, 0.0001 * 0.1, "ur5_repeat") != 1 { return false; }
    if kat_roclose(robotics_realsense_d435_depth_accuracy_pct(), 2.0, 0.0001 * 2.0, "d435_acc") != 1 { return false; }
    if kat_roclose(robotics_realsense_d435_depth_range_m(), 2.0, 0.0001 * 2.0, "d435_rng") != 1 { return false; }
    if kat_roclose(robotics_velodyne_vlp16_range_m(), 100.0, 0.0001 * 100.0, "vlp16_rng") != 1 { return false; }
    if kat_roclose(robotics_velodyne_vlp16_accuracy_m(), 0.03, 0.0001 * 0.03, "vlp16_acc") != 1 { return false; }
    // AI Index 2024 cobot market within +/- 5% literature tolerance.
    if kat_roclose(robotics_stanford_ai_index_cobot_market_busd(), 1.2, 0.05 * 1.2, "ai_index_cobot") != 1 { return false; }

    // Hostile: bogus values are out of tolerance.
    if kat_roclose(robotics_ur5_reach_mm(), 0.0, reach_tol, "ur5_reach_zero") != 0 { return false; }
    if kat_roclose(robotics_realsense_d435_depth_accuracy_pct(), 99.0, 0.0001 * 2.0, "d435_acc_bad") != 0 { return false; }
    if kat_roclose(robotics_velodyne_vlp16_range_m(), 50.0, 0.0001 * 100.0, "vlp16_rng_bad") != 0 { return false; }

    let c1: DomainCert = robotics_kat_cert();
    if cert_holds(c1) != 1 { return false; }

    return true;
}
