// # LiDAR Voxel Grid Downsampling Filter
//
// Logline: Subsamples large 3D point clouds into regular spatial voxel grids computing centroid representations.
//
// Setup: Core point cloud preprocessing filter reducing computational burden while preserving spatial geometry.
//
// Beats:
//   1. Configure 3D voxel grid resolution (leaf size along X, Y, Z).
//   2. Compute 3D integer voxel indices and hash spatial keys.
//   3. Accumulate point coordinates and intensities per voxel.
//   4. Calculate voxel centroid points and output downsampled point clouds.

import "point_types.oo";

type VoxelGridConfig = struct {
    leaf_size_x: Float,
    leaf_size_y: Float,
    leaf_size_z: Float,
    min_points_per_voxel: Int
};

type VoxelIndex3D = struct {
    ix: Int,
    iy: Int,
    iz: Int
};

type VoxelAccumulator = struct {
    sum_x: Float,
    sum_y: Float,
    sum_z: Float,
    sum_intensity: Float,
    count: Int
};

pub fn voxel_grid_config_new(lx: Float, ly: Float, lz: Float) -> VoxelGridConfig {
    return VoxelGridConfig {
        leaf_size_x: lx,
        leaf_size_y: ly,
        leaf_size_z: lz,
        min_points_per_voxel: 1
    };
}

pub fn voxel_grid_config_default() -> VoxelGridConfig {
    return VoxelGridConfig {
        leaf_size_x: 0.1,
        leaf_size_y: 0.1,
        leaf_size_z: 0.1,
        min_points_per_voxel: 1
    };
}

pub fn voxel_point_to_index(p: Point3D, cfg: VoxelGridConfig) -> VoxelIndex3D {
    let mut inv_lx: Float = 1.0;

    if cfg.leaf_size_x > 0.00001 {

        inv_lx = 1.0 / cfg.leaf_size_x;

    }
    let mut inv_ly: Float = 1.0;

    if cfg.leaf_size_y > 0.00001 {

        inv_ly = 1.0 / cfg.leaf_size_y;

    }
    let mut inv_lz: Float = 1.0;

    if cfg.leaf_size_z > 0.00001 {

        inv_lz = 1.0 / cfg.leaf_size_z;

    }

    let mut ix: Int = (p.x * inv_lx) as Int;
    let mut iy: Int = (p.y * inv_ly) as Int;
    let mut iz: Int = (p.z * inv_lz) as Int;

    if p.x < 0.0 {
        ix = ix - 1;
    }
    if p.y < 0.0 {
        iy = iy - 1;
    }
    if p.z < 0.0 {
        iz = iz - 1;
    }

    return VoxelIndex3D { ix: ix, iy: iy, iz: iz };
}

pub fn voxel_hash_key(idx: VoxelIndex3D) -> Int {
    let p1: Int = 73856093;
    let p2: Int = 19349663;
    let p3: Int = 83492791;
    return ((idx.ix * p1) + (idx.iy * p2)) + (idx.iz * p3);
}

pub fn voxel_accumulator_new() -> VoxelAccumulator {
    return VoxelAccumulator {
        sum_x: 0.0,
        sum_y: 0.0,
        sum_z: 0.0,
        sum_intensity: 0.0,
        count: 0
    };
}

pub fn voxel_accumulator_add(acc: VoxelAccumulator, p: PointXYZI) -> VoxelAccumulator {
    return VoxelAccumulator {
        sum_x: acc.sum_x + p.x,
        sum_y: acc.sum_y + p.y,
        sum_z: acc.sum_z + p.z,
        sum_intensity: acc.sum_intensity + p.intensity,
        count: acc.count + 1
    };
}

pub fn voxel_accumulator_centroid(acc: VoxelAccumulator) -> PointXYZI {
    if acc.count <= 0 {
        return PointXYZI { x: 0.0, y: 0.0, z: 0.0, intensity: 0.0 };
    }
    let inv_n: Float = 1.0 / (acc.gnn_int_to_float(count));
    return PointXYZI {
        x: acc.sum_x * inv_n,
        y: acc.sum_y * inv_n,
        z: acc.sum_z * inv_n,
        intensity: acc.sum_intensity * inv_n
    };
}

pub fn voxel_grid_filter_is_valid(acc: VoxelAccumulator, cfg: VoxelGridConfig) -> Bool {
    return acc.count >= cfg.min_points_per_voxel;
}

fn gnn_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
