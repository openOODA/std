// # LiDAR Euclidean Cluster Extraction Engine
//
// Logline: Groups non-ground 3D points into distinct obstacle clusters using distance tolerance metrics and spatial connectivity.
//
// Setup: Core 3D clustering module partitioning segmented point clouds into isolated physical object candidates.
//
// Beats:
//   1. Configure Euclidean distance tolerance radius and minimum/maximum cluster point bounds.
//   2. Model 3D cluster representation with bounding extents, centroid, and point membership count.
//   3. Compute distance-based point connectivity and adjacency predicates.
//   4. Filter out under-sized noise fragments and over-sized wall/background clusters.

import "point_types.oo";

type EuclideanClusterConfig = struct {
    cluster_tolerance: Float,
    min_cluster_size: Int,
    max_cluster_size: Int
};

type PointCluster3D = struct {
    cluster_id: Int,
    centroid_x: Float,
    centroid_y: Float,
    centroid_z: Float,
    min_x: Float,
    max_x: Float,
    min_y: Float,
    max_y: Float,
    min_z: Float,
    max_z: Float,
    point_count: Int
};

pub fn euclidean_cluster_config_default() -> EuclideanClusterConfig {
    return EuclideanClusterConfig {
        cluster_tolerance: 0.5,
        min_cluster_size: 5,
        max_cluster_size: 25000
    };
}

pub fn point_cluster3d_new(id: Int) -> PointCluster3D {
    return PointCluster3D {
        cluster_id: id,
        centroid_x: 0.0,
        centroid_y: 0.0,
        centroid_z: 0.0,
        min_x: 10000.0,
        max_x: 0.0 - 10000.0,
        min_y: 10000.0,
        max_y: 0.0 - 10000.0,
        min_z: 10000.0,
        max_z: 0.0 - 10000.0,
        point_count: 0
    };
}

pub fn point_cluster3d_add_point(c: PointCluster3D, p: Point3D) -> PointCluster3D {
    let mut new_min_x: Float = c.min_x;

    if p.x < c.min_x {

        new_min_x = p.x;

    }
    let mut new_max_x: Float = c.max_x;

    if p.x > c.max_x {

        new_max_x = p.x;

    }
    let mut new_min_y: Float = c.min_y;

    if p.y < c.min_y {

        new_min_y = p.y;

    }
    let mut new_max_y: Float = c.max_y;

    if p.y > c.max_y {

        new_max_y = p.y;

    }
    let mut new_min_z: Float = c.min_z;

    if p.z < c.min_z {

        new_min_z = p.z;

    }
    let mut new_max_z: Float = c.max_z;

    if p.z > c.max_z {

        new_max_z = p.z;

    }

    let n: Float = c.gnn_int_to_float(point_count);
    let new_n: Float = n + 1.0;
    let new_cx: Float = ((c.centroid_x * n) + p.x) / new_n;
    let new_cy: Float = ((c.centroid_y * n) + p.y) / new_n;
    let new_cz: Float = ((c.centroid_z * n) + p.z) / new_n;

    return PointCluster3D {
        cluster_id: c.cluster_id,
        centroid_x: new_cx,
        centroid_y: new_cy,
        centroid_z: new_cz,
        min_x: new_min_x,
        max_x: new_max_x,
        min_y: new_min_y,
        max_y: new_max_y,
        min_z: new_min_z,
        max_z: new_max_z,
        point_count: c.point_count + 1
    };
}

pub fn is_cluster_size_valid(c: PointCluster3D, cfg: EuclideanClusterConfig) -> Bool {
    return (c.point_count >= cfg.min_cluster_size) &&
           (c.point_count <= cfg.max_cluster_size);
}

pub fn cluster_to_bounding_box_3d(c: PointCluster3D, class_id: Int) -> BoundingBox3D {
    let sx: Float = c.max_x - c.min_x;
    let sy: Float = c.max_y - c.min_y;
    let sz: Float = c.max_z - c.min_z;

    return BoundingBox3D {
        center_x: c.centroid_x,
        center_y: c.centroid_y,
        center_z: c.centroid_z,
        size_x: if sx > 0.1 { sx } else { 0.1 },
        size_y: if sy > 0.1 { sy } else { 0.1 },
        size_z: if sz > 0.1 { sz } else { 0.1 },
        heading_rad: 0.0,
        confidence: 0.9,
        class_id: class_id
    };
}

fn gnn_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
