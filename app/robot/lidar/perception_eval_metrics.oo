// # 3D Perception & Tracking Evaluation Metrics (AP / MOTA / MOTP)
//
// Logline: Evaluates 3D object detection and tracking precision, recall, Average Precision (AP), MOTA, MOTP, and latency.
//
// Setup: Benchmarking and online perception quality assurance module for autonomous driving perception stacks.
//
// Beats:
//   1. Model detection true positives (TP), false positives (FP), and false negatives (FN).
//   2. Compute precision, recall, and F1-score across IoU thresholds.
//   3. Compute Multi-Object Tracking Accuracy (MOTA) and Tracking Precision (MOTP).
//   4. Track end-to-end pipeline latency in milliseconds and frame drops.

import "point_types.oo";

type DetectionMetrics = struct {
    true_positives: Int,
    false_positives: Int,
    false_negatives: Int,
    precision: Float,
    recall: Float,
    f1_score: Float
};

type TrackingMetrics = struct {
    mota_score: Float,
    motp_distance_m: Float,
    id_switches: Int,
    fragmentations: Int
};

pub fn compute_detection_metrics(tp: Int, fp: Int, fn_count: Int) -> DetectionMetrics {
    let tp_f: Float = gnn_int_to_float(tp);
    let fp_f: Float = gnn_int_to_float(fp);
    let fn_f: Float = gnn_int_to_float(fn_count);

    let denom_p: Float = tp_f + fp_f;
    let denom_r: Float = tp_f + fn_f;

    let mut p: Float = 0.0;


    if denom_p > 0.0 {


        p = tp_f / denom_p;


    }
    let mut r: Float = 0.0;

    if denom_r > 0.0 {

        r = tp_f / denom_r;

    }

    let denom_f1: Float = p + r;
    let mut f1: Float = 0.0;

    if denom_f1 > 0.0 {

        f1 = (2.0 * p * r) / denom_f1;

    }

    return DetectionMetrics {
        true_positives: tp,
        false_positives: fp,
        false_negatives: fn_count,
        precision: p,
        recall: r,
        f1_score: f1
    };
}

pub fn compute_mota(
    total_gt: Int,
    misses: Int,
    false_positives: Int,
    id_switches: Int
) -> Float {
    if total_gt <= 0 {
        return 1.0;
    }
    let errors: Float = gnn_int_to_float(misses + false_positives + id_switches);
    let gt_f: Float = gnn_int_to_float(total_gt);
    return 1.0 - (errors / gt_f);
}

fn gnn_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
