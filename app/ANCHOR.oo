// # App Submodule Hub
//
// Logline: Unified entry point for the standard app domain library. The app
//          domain is composed of 5 sub-hubs:
//
//   app/ai/      (tensors, transformer, quant, GGUF, scaling law; ml_lib/ merged into ml/; cognition+cybernetics merged into meta/; graph_networks split: CS algo -> ai/algo/, network routing -> net/protocol/routing/)
//   app/robot/   (robotics, ros2, mpc, auto, lidar, industrial_iot, predictive, digital_twin, iot_scada, auv)
//   app/ui/      (3d, game_engine, gui, media, media_codecs, media_dsp, multimedia, pbr_raytracing, tui, web_ecosystem, wui)
//   app/data/    (database, dataframe, db, columnar, graph, storage, vector_ann, cloud, cloud_faas, k8s, enterprise, grid, gis_spatial, gis_topo; wire/ moved to core/encoding/wire/)
//   app/agent/   (synthesizer, repair, evolution, pair_programmer, repl_engine)
//
// Setup: Imports the app sub-hubs. No caps required for pure compute. Simulators may take SimCap at the call site.
//
// Beats:
//   1. Re-export the ai, robot, ui, data, and agent surfaces as app_mod_ai_*, app_mod_robot_*, app_mod_ui_*, app_mod_data_*, app_mod_agent_*.

import "ai/ANCHOR.oo";
import "robot/ANCHOR.oo";
import "ui/ANCHOR.oo";
import "data/ANCHOR.oo";
import "agent/ANCHOR.oo";

// Private sibling inventory (DO NOT IMPORT DIRECTLY):
//   _engine files
//   _types files
//   _ops files
//   _stubs files
//   _law files
//   _theory files
//   _principle files
//   _invariants files
//   _kat files
