// # WebAssembly Reactive Application Architecture
//
// Logline: Composable Model-Update-View state machine runtime for single-page WebAssembly browser applications.
//
// Setup: Elm-inspired deterministic state management and reactive UI tree rendering.
//
// Beats:
//   1. Define WuiModel state container and WuiMsg message envelope structures.
//   2. Initialize default application state.
//   3. Implement pure update state transition function.
//   4. Implement reactive view function compiling state to Virtual DOM tree.

import "./wui_vnode.oo";
import "./wui_vdom_builder.oo";

type WuiModel = struct {
    counter: Int,
    title: String,
    is_active: Bool
};

type WuiMsg = struct {
    msg_type: String,
    payload: String
};

pub fn wui_app_init() -> WuiModel { return WuiModel {
        counter: 0,
        title: "openOODA WASM App",
        is_active: true
    }; }

pub fn wui_app_update(model: WuiModel, msg: WuiMsg) -> WuiModel {
    let mtype: String = msg.msg_type;
    if mtype == "increment" {
        return WuiModel {
            counter: model.counter + 1,
            title: model.title,
            is_active: model.is_active
        };
    }
    if mtype == "decrement" {
        return WuiModel {
            counter: model.counter - 1,
            title: model.title,
            is_active: model.is_active
        };
    }
    if mtype == "set_title" {
        return WuiModel {
            counter: model.counter,
            title: msg.payload,
            is_active: model.is_active
        };
    }
    return model;
}

pub fn wui_app_view(model: &WuiModel) -> VNode {
    let mut props: List[VProp] = list_new();
    props = list_push(props, prop_class("app-container"));

    let mut child_ids: List[Int] = list_new();
    let empty_ids: List[Int] = list_new();

    let mut h1_props: List[VProp] = list_new();
    let mut header_node: VNode = h_elem("h1", h1_props, empty_ids);
    header_node.text = model.title;

    let count_text: String = "Counter: " + (model.counter).to_string();
    let mut p_props: List[VProp] = list_new();
    let mut count_node: VNode = h_elem("p", p_props, empty_ids);
    count_node.text = count_text;

    let mut btn_props: List[VProp] = list_new();
    btn_props = list_push(btn_props, prop_on_click("increment"));
    let mut btn_node: VNode = h_button(btn_props, empty_ids);
    btn_node.text = "+1";

    child_ids = list_push(child_ids, 0);
    child_ids = list_push(child_ids, 1);
    child_ids = list_push(child_ids, 2);

    return h_div(props, child_ids);
}

pub fn wui_app_probe() -> Int {
    let m0: WuiModel = wui_app_init();
    let msg: WuiMsg = WuiMsg { msg_type: "increment", payload: "" };
    let m1: WuiModel = wui_app_update(m0, msg);
    let v: VNode = wui_app_view(&m1);
    let c: Int = m1.counter;
    let k: Int = v.node_kind;
    let p: Int = wui_vdom_builder_probe();
    return c + k + p;
}
