// # Declarative Virtual DOM Tree Builder DSL
//
// Logline: Composable element helpers, HTML tag builders, and property decorators for declarative UI composition.
//
// Setup: High-ergonomic DSL for authoring WebAssembly reactive user interfaces.
//
// Beats:
//   1. Implement property helper constructors (class, on_click, attr).
//   2. Implement container and interactive element builders (elem, div, button, input).
//   3. Implement virtual DOM builder verification probe.

import "./wui_vnode.oo";

pub fn prop_class(cls: String) -> VProp { return vprop_new("class", cls); }

pub fn prop_on_click(handler_id: String) -> VProp { return vprop_new("onclick", handler_id); }

pub fn prop_attr(k: String, v: String) -> VProp { return vprop_new(k, v); }

pub fn h_elem(tag: String, props: List[VProp], child_ids: List[Int]) -> VNode {
    return vnode_element(tag, "", props, child_ids);
}

pub fn h_div(props: List[VProp], child_ids: List[Int]) -> VNode {
    return vnode_element("div", "", props, child_ids);
}

pub fn h_button(props: List[VProp], child_ids: List[Int]) -> VNode {
    return vnode_element("button", "", props, child_ids);
}

pub fn h_input(props: List[VProp]) -> VNode {
    let empty_ch: List[Int] = list_new();
    return vnode_element("input", "", props, empty_ch);
}

pub fn wui_vdom_builder_probe() -> Int {
    let p: VProp = prop_class("wui-test");
    let mut empty_ids: List[Int] = list_new();
    let mut props: List[VProp] = list_new();
    props = list_push(props, p);
    let n: VNode = h_div(props, empty_ids);
    return n.node_kind + wui_vnode_probe();
}

