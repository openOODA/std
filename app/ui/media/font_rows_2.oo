// # Font rows K-T: 5x7 bit rows, bit 4 is the left pixel
//
// Logline: Second third of the 5x7 bitmap glyph table.
//
// Setup: Pure compute, no caps. Each glyph is 7 row ints, 0..31.
// font_rows_2 returns an empty list for glyphs it does not hold.

pub fn font_rows_2(ch: String) -> List[Int] {
    if ch == "K" {
        let mut f2_g: List[Int] = list_new();
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 18);
        f2_g = list_push(f2_g, 20);
        f2_g = list_push(f2_g, 24);
        f2_g = list_push(f2_g, 20);
        f2_g = list_push(f2_g, 18);
        f2_g = list_push(f2_g, 17);
        return f2_g;
    }
    if ch == "L" {
        let mut f2_g: List[Int] = list_new();
        f2_g = list_push(f2_g, 16);
        f2_g = list_push(f2_g, 16);
        f2_g = list_push(f2_g, 16);
        f2_g = list_push(f2_g, 16);
        f2_g = list_push(f2_g, 16);
        f2_g = list_push(f2_g, 16);
        f2_g = list_push(f2_g, 31);
        return f2_g;
    }
    if ch == "M" {
        let mut f2_g: List[Int] = list_new();
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 27);
        f2_g = list_push(f2_g, 27);
        f2_g = list_push(f2_g, 27);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        return f2_g;
    }
    if ch == "N" {
        let mut f2_g: List[Int] = list_new();
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 25);
        f2_g = list_push(f2_g, 25);
        f2_g = list_push(f2_g, 21);
        f2_g = list_push(f2_g, 19);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        return f2_g;
    }
    if ch == "O" {
        let mut f2_g: List[Int] = list_new();
        f2_g = list_push(f2_g, 14);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 14);
        return f2_g;
    }
    if ch == "P" {
        let mut f2_g: List[Int] = list_new();
        f2_g = list_push(f2_g, 30);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 30);
        f2_g = list_push(f2_g, 16);
        f2_g = list_push(f2_g, 16);
        f2_g = list_push(f2_g, 16);
        return f2_g;
    }
    if ch == "Q" {
        let mut f2_g: List[Int] = list_new();
        f2_g = list_push(f2_g, 14);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 21);
        f2_g = list_push(f2_g, 18);
        f2_g = list_push(f2_g, 13);
        return f2_g;
    }
    if ch == "R" {
        let mut f2_g: List[Int] = list_new();
        f2_g = list_push(f2_g, 30);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 30);
        f2_g = list_push(f2_g, 20);
        f2_g = list_push(f2_g, 18);
        f2_g = list_push(f2_g, 17);
        return f2_g;
    }
    if ch == "S" {
        let mut f2_g: List[Int] = list_new();
        f2_g = list_push(f2_g, 14);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 16);
        f2_g = list_push(f2_g, 14);
        f2_g = list_push(f2_g, 1);
        f2_g = list_push(f2_g, 17);
        f2_g = list_push(f2_g, 14);
        return f2_g;
    }
    if ch == "T" {
        let mut f2_g: List[Int] = list_new();
        f2_g = list_push(f2_g, 31);
        f2_g = list_push(f2_g, 4);
        f2_g = list_push(f2_g, 4);
        f2_g = list_push(f2_g, 4);
        f2_g = list_push(f2_g, 4);
        f2_g = list_push(f2_g, 4);
        f2_g = list_push(f2_g, 4);
        return f2_g;
    }
    let mut f2_e: List[Int] = list_new();
    return f2_e;
}
