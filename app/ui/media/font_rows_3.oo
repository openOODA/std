// # Font rows U-Z and 0-5: 5x7 bit rows, bit 4 is the left pixel
//
// Logline: Third quarter of the 5x7 bitmap glyph table.
//
// Setup: Pure compute, no caps. Each glyph is 7 row ints, 0..31.
// font_rows_3 returns an empty list for glyphs it does not hold.

pub fn font_rows_3(ch: String) -> List[Int] {
    if ch == "U" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 14);
        return f3_g;
    }
    if ch == "V" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 10);
        f3_g = list_push(f3_g, 4);
        return f3_g;
    }
    if ch == "W" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 27);
        f3_g = list_push(f3_g, 27);
        f3_g = list_push(f3_g, 27);
        f3_g = list_push(f3_g, 17);
        return f3_g;
    }
    if ch == "X" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 10);
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 10);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        return f3_g;
    }
    if ch == "Y" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 10);
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 4);
        return f3_g;
    }
    if ch == "Z" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 31);
        f3_g = list_push(f3_g, 1);
        f3_g = list_push(f3_g, 2);
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 8);
        f3_g = list_push(f3_g, 16);
        f3_g = list_push(f3_g, 31);
        return f3_g;
    }
    if ch == "0" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 14);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 19);
        f3_g = list_push(f3_g, 21);
        f3_g = list_push(f3_g, 25);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 14);
        return f3_g;
    }
    if ch == "1" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 12);
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 14);
        return f3_g;
    }
    if ch == "2" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 14);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 1);
        f3_g = list_push(f3_g, 6);
        f3_g = list_push(f3_g, 8);
        f3_g = list_push(f3_g, 16);
        f3_g = list_push(f3_g, 31);
        return f3_g;
    }
    if ch == "3" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 31);
        f3_g = list_push(f3_g, 2);
        f3_g = list_push(f3_g, 4);
        f3_g = list_push(f3_g, 2);
        f3_g = list_push(f3_g, 1);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 14);
        return f3_g;
    }
    if ch == "4" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 2);
        f3_g = list_push(f3_g, 6);
        f3_g = list_push(f3_g, 10);
        f3_g = list_push(f3_g, 18);
        f3_g = list_push(f3_g, 31);
        f3_g = list_push(f3_g, 2);
        f3_g = list_push(f3_g, 2);
        return f3_g;
    }
    if ch == "5" {
        let mut f3_g: List[Int] = list_new();
        f3_g = list_push(f3_g, 31);
        f3_g = list_push(f3_g, 16);
        f3_g = list_push(f3_g, 30);
        f3_g = list_push(f3_g, 1);
        f3_g = list_push(f3_g, 1);
        f3_g = list_push(f3_g, 17);
        f3_g = list_push(f3_g, 14);
        return f3_g;
    }
    let mut f3_e: List[Int] = list_new();
    return f3_e;
}
