// # Font rows 6-9 plus punctuation and space
//
// Logline: Last quarter of the 5x7 bitmap glyph table.
//
// Setup: Pure compute, no caps. Each glyph is 7 row ints, 0..31.
// font_rows_4 returns an empty list for glyphs it does not hold.
//
// Beats:
//   1. Match glyphs 6-9 plus punctuation to row tables.
//   2. Return empty list for other chars.

pub fn font_rows_4(ch: String) -> List[Int] {
    if ch == "6" {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 6);
        f4_g = list_push(f4_g, 8);
        f4_g = list_push(f4_g, 16);
        f4_g = list_push(f4_g, 30);
        f4_g = list_push(f4_g, 17);
        f4_g = list_push(f4_g, 17);
        f4_g = list_push(f4_g, 14);
        return f4_g;
    }
    if ch == "7" {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 31);
        f4_g = list_push(f4_g, 1);
        f4_g = list_push(f4_g, 2);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 8);
        f4_g = list_push(f4_g, 8);
        f4_g = list_push(f4_g, 8);
        return f4_g;
    }
    if ch == "8" {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 14);
        f4_g = list_push(f4_g, 17);
        f4_g = list_push(f4_g, 17);
        f4_g = list_push(f4_g, 14);
        f4_g = list_push(f4_g, 17);
        f4_g = list_push(f4_g, 17);
        f4_g = list_push(f4_g, 14);
        return f4_g;
    }
    if ch == "9" {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 14);
        f4_g = list_push(f4_g, 17);
        f4_g = list_push(f4_g, 17);
        f4_g = list_push(f4_g, 15);
        f4_g = list_push(f4_g, 1);
        f4_g = list_push(f4_g, 2);
        f4_g = list_push(f4_g, 12);
        return f4_g;
    }
    if ch == " " {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        return f4_g;
    }
    if ch == "." {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 12);
        f4_g = list_push(f4_g, 12);
        return f4_g;
    }
    if ch == "," {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 12);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 8);
        return f4_g;
    }
    if ch == "!" {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 4);
        return f4_g;
    }
    if ch == "?" {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 14);
        f4_g = list_push(f4_g, 17);
        f4_g = list_push(f4_g, 1);
        f4_g = list_push(f4_g, 2);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 4);
        return f4_g;
    }
    if ch == ":" {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 12);
        f4_g = list_push(f4_g, 12);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 12);
        f4_g = list_push(f4_g, 12);
        f4_g = list_push(f4_g, 0);
        return f4_g;
    }
    if ch == "-" {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 14);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 0);
        return f4_g;
    }
    if ch == "+" {
        let mut f4_g: List[Int] = list_new();
        f4_g = list_push(f4_g, 0);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 31);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 4);
        f4_g = list_push(f4_g, 0);
        return f4_g;
    }
    let mut f4_e: List[Int] = list_new();
    return f4_e;
}
