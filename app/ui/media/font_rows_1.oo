// # Font rows A-J: 5x7 bit rows, bit 4 is the left pixel
//
// Logline: First third of the 5x7 bitmap glyph table.
//
// Setup: Pure compute, no caps. Each glyph is 7 row ints, 0..31.
// font_rows_1 returns an empty list for glyphs it does not hold.

pub fn font_rows_1(ch: String) -> List[Int] {
    if ch == "A" {
        let mut f1_g: List[Int] = list_new();
        f1_g = list_push(f1_g, 14);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 31);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        return f1_g;
    }
    if ch == "B" {
        let mut f1_g: List[Int] = list_new();
        f1_g = list_push(f1_g, 30);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 30);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 30);
        return f1_g;
    }
    if ch == "C" {
        let mut f1_g: List[Int] = list_new();
        f1_g = list_push(f1_g, 14);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 14);
        return f1_g;
    }
    if ch == "D" {
        let mut f1_g: List[Int] = list_new();
        f1_g = list_push(f1_g, 30);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 30);
        return f1_g;
    }
    if ch == "E" {
        let mut f1_g: List[Int] = list_new();
        f1_g = list_push(f1_g, 31);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 30);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 31);
        return f1_g;
    }
    if ch == "F" {
        let mut f1_g: List[Int] = list_new();
        f1_g = list_push(f1_g, 31);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 30);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 16);
        return f1_g;
    }
    if ch == "G" {
        let mut f1_g: List[Int] = list_new();
        f1_g = list_push(f1_g, 14);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 16);
        f1_g = list_push(f1_g, 23);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 14);
        return f1_g;
    }
    if ch == "H" {
        let mut f1_g: List[Int] = list_new();
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 31);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        f1_g = list_push(f1_g, 17);
        return f1_g;
    }
    if ch == "I" {
        let mut f1_g: List[Int] = list_new();
        f1_g = list_push(f1_g, 14);
        f1_g = list_push(f1_g, 4);
        f1_g = list_push(f1_g, 4);
        f1_g = list_push(f1_g, 4);
        f1_g = list_push(f1_g, 4);
        f1_g = list_push(f1_g, 4);
        f1_g = list_push(f1_g, 14);
        return f1_g;
    }
    if ch == "J" {
        let mut f1_g: List[Int] = list_new();
        f1_g = list_push(f1_g, 7);
        f1_g = list_push(f1_g, 2);
        f1_g = list_push(f1_g, 2);
        f1_g = list_push(f1_g, 2);
        f1_g = list_push(f1_g, 2);
        f1_g = list_push(f1_g, 18);
        f1_g = list_push(f1_g, 12);
        return f1_g;
    }
    let mut f1_e: List[Int] = list_new();
    return f1_e;
}
