// # Ui Media
//
// Logline: Ui, tui, gui, media, and graphics for std/media.
//
// Setup: Domain module of 14 files under std/media. Pure compute, no caps; ppm_write/qoi_write take &FsWriteCap at the call site.
//
// Beats:
//   1. Qoi family (2 files).
//   2. Wav family (2 files).
//   3. Audio mixer family (1 file).
//   4. Ppm family (1 file): QoiImage to P3 text sink.
//   5. Canvas family (1 file): flat-int 2D raster, QoiImage at the boundary.
//   6. Qoi file family (1 file): QOI binary sink via bytes_to_str.

import "audio_mixer_basic.oo";
import "canvas_2d.oo";
import "h264_nal.oo";
import "h264_sps.oo";
import "h264_types.oo";
import "media.oo";
import "ppm.oo";
import "qoi.oo";
import "qoi_file.oo";
import "qoi_dec.oo";
import "qoi_enc.oo";
import "qoi_types.oo";
import "wav.oo";
import "wav_types.oo";
