// # TUI Flexbox Layout Engine
//
// Logline: Flexible box layout algorithm distributing rectangular areas across rows and columns.
//
// Setup: Declarative 1D flex container dividing screen space proportionally among child widgets.
//
// Beats:
//   1. Define FlexItem sizing constraints (min, max, flex_grow) and FlexContainer properties.
//   2. Compute proportional flex dimension allocations across primary and secondary axes.
//   3. Output resolved BufferArea bounding boxes for each flex child element.

import "std/app/ui/tui/tui_buffer.oo";

type FlexItem = struct {
    min_size: Int,
    max_size: Int,
    flex_grow: Int,
    target_size: Int
};

pub fn flex_item_new(min_size: Int, max_size: Int, flex_grow: Int) -> FlexItem {
    return FlexItem {
        min_size: min_size,
        max_size: max_size,
        flex_grow: flex_grow,
        target_size: 0
    };
}

type FlexContainer = struct {
    area: BufferArea,
    direction: Int, // 0: Row, 1: Column
    justify: Int,   // 0: Start, 1: Center, 2: End, 3: SpaceBetween
    items: List[FlexItem]
};

pub fn flex_container_new(area: BufferArea, direction: Int, justify: Int) -> FlexContainer {
    let items: List[FlexItem] = list_new();
    return FlexContainer {
        area: area,
        direction: direction,
        justify: justify,
        items: items
    };
}

pub fn flex_container_add_item(fc: FlexContainer, item: FlexItem) -> FlexContainer {
    let mut items: List[FlexItem] = fc.items;
    items = list_push(items, item);
    return FlexContainer {
        area: fc.area,
        direction: fc.direction,
        justify: fc.justify,
        items: items
    };
}

pub fn flex_container_get_count(fc: FlexContainer) -> Int {
    return list_len(fc.items);
}

pub fn flex_layout_get_item_row(fc: FlexContainer, idx: Int) -> BufferArea {
    let num_items: Int = list_len(fc.items);
    if idx < 0 || idx >= num_items {
        return BufferArea { x: 0, y: 0, width: 0, height: 0 };
    }

    let a: BufferArea = fc.area;
    let total_w: Int = a.width;
    let mut total_grow: Int = 0;
    let mut i: Int = 0;
    while i < num_items {
        let item: FlexItem = list_get(fc.items, i);
        let g: Int = item.flex_grow;
        let w_val: Int = if g > 0 { g } else { 1 };
        total_grow = total_grow + w_val;
        i = i + 1;
    }

    let mut cur_x: Int = a.x;
    let h: Int = a.height;
    let y: Int = a.y;

    i = 0;
    while i < num_items {
        let item: FlexItem = list_get(fc.items, i);
        let g: Int = item.flex_grow;
        let weight: Int = if g > 0 { g } else { 1 };
        let mut item_w: Int = (total_w * weight) / total_grow;
        if item_w < item.min_size {
            item_w = item.min_size;
        }
        if item.max_size > 0 && item_w > item.max_size {
            item_w = item.max_size;
        }

        if i == idx {
            return BufferArea {
                x: cur_x,
                y: y,
                width: item_w,
                height: h
            };
        }
        cur_x = cur_x + item_w;
        i = i + 1;
    }
    return BufferArea { x: 0, y: 0, width: 0, height: 0 };
}

pub fn flex_layout_get_item_column(fc: FlexContainer, idx: Int) -> BufferArea {
    let num_items: Int = list_len(fc.items);
    if idx < 0 || idx >= num_items {
        return BufferArea { x: 0, y: 0, width: 0, height: 0 };
    }

    let a: BufferArea = fc.area;
    let total_h: Int = a.height;
    let mut total_grow: Int = 0;
    let mut i: Int = 0;
    while i < num_items {
        let item: FlexItem = list_get(fc.items, i);
        let g: Int = item.flex_grow;
        let w_val: Int = if g > 0 { g } else { 1 };
        total_grow = total_grow + w_val;
        i = i + 1;
    }

    let mut cur_y: Int = a.y;
    let w: Int = a.width;
    let x: Int = a.x;

    i = 0;
    while i < num_items {
        let item: FlexItem = list_get(fc.items, i);
        let g: Int = item.flex_grow;
        let weight: Int = if g > 0 { g } else { 1 };
        let mut item_h: Int = (total_h * weight) / total_grow;
        if item_h < item.min_size {
            item_h = item.min_size;
        }
        if item.max_size > 0 && item_h > item.max_size {
            item_h = item.max_size;
        }

        if i == idx {
            return BufferArea {
                x: x,
                y: cur_y,
                width: w,
                height: item_h
            };
        }
        cur_y = cur_y + item_h;
        i = i + 1;
    }
    return BufferArea { x: 0, y: 0, width: 0, height: 0 };
}
