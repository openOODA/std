// # TUI Data Table Widget
//
// Logline: Columnar data grid widget with headers, cell alignment, row selection, and scrolling.
//
// Setup: High-density structured data presentation with automatic column width distribution.
//
// Beats:
//   1. Define TableColumn descriptors and WidgetTable container structure.
//   2. Manage row selection indices and vertical scrolling viewport offsets.
//   3. Render header separator, row highlights, and cell values into screen buffer.

import "std/core/primitives/list.oo";
import "std/app/ui/tui/tui_cell.oo";
import "std/app/ui/tui/tui_buffer.oo";
import "std/app/ui/tui/border_styles.oo";

type TableColumn = struct {
    title: String,
    width: Int,
    align: Int // 0: Left, 1: Center, 2: Right
};

pub fn table_column_new(title: String, width: Int, align: Int) -> TableColumn {
    return TableColumn {
        title: title,
        width: width,
        align: align
    };
}

type WidgetTable = struct {
    id: Int,
    area: BufferArea,
    columns: List[TableColumn],
    cells: List[String],
    num_rows: Int,
    selected_row: Int,
    scroll_offset: Int,
    is_focused: Bool
};

pub fn widget_table_new(id: Int, area: BufferArea) -> WidgetTable {
    let cols: List[TableColumn] = list_new();
    let cls: List[String] = list_new();
    return WidgetTable {
        id: id,
        area: area,
        columns: cols,
        cells: cls,
        num_rows: 0,
        selected_row: 0,
        scroll_offset: 0,
        is_focused: false
    };
}

pub fn widget_table_add_column(tbl: WidgetTable, col: TableColumn) -> WidgetTable {
    let mut cols: List[TableColumn] = tbl.columns;
    cols = list_push(cols, col);
    return WidgetTable {
        id: tbl.id,
        area: tbl.area,
        columns: cols,
        cells: tbl.cells,
        num_rows: tbl.num_rows,
        selected_row: tbl.selected_row,
        scroll_offset: tbl.scroll_offset,
        is_focused: tbl.is_focused
    };
}

pub fn widget_table_add_row(tbl: WidgetTable, row_items: List[String]) -> WidgetTable {
    let mut cls: List[String] = tbl.cells;
    let n: Int = list_len(row_items);
    let mut i: Int = 0;
    while i < n {
        cls = list_push(cls, list_get(row_items, i));
        i = i + 1;
    }
    return WidgetTable {
        id: tbl.id,
        area: tbl.area,
        columns: tbl.columns,
        cells: cls,
        num_rows: tbl.num_rows + 1,
        selected_row: tbl.selected_row,
        scroll_offset: tbl.scroll_offset,
        is_focused: tbl.is_focused
    };
}

pub fn widget_table_select_next(tbl: WidgetTable) -> WidgetTable {
    let total: Int = tbl.num_rows;
    if total == 0 {
        return tbl;
    }
    let mut sel: Int = tbl.selected_row;
    let mut off: Int = tbl.scroll_offset;
    if sel < (total - 1) {
        sel = sel + 1;
        let view_height: Int = (tbl.area).height - 3;
        if (sel - off) >= view_height {
            off = sel - view_height + 1;
        }
    }
    return WidgetTable {
        id: tbl.id,
        area: tbl.area,
        columns: tbl.columns,
        cells: tbl.cells,
        num_rows: tbl.num_rows,
        selected_row: sel,
        scroll_offset: off,
        is_focused: tbl.is_focused
    };
}

pub fn widget_table_select_prev(tbl: WidgetTable) -> WidgetTable {
    let mut sel: Int = tbl.selected_row;
    let mut off: Int = tbl.scroll_offset;
    if sel > 0 {
        sel = sel - 1;
        if sel < off {
            off = sel;
        }
    }
    return WidgetTable {
        id: tbl.id,
        area: tbl.area,
        columns: tbl.columns,
        cells: tbl.cells,
        num_rows: tbl.num_rows,
        selected_row: sel,
        scroll_offset: off,
        is_focused: tbl.is_focused
    };
}

pub fn widget_table_get_selected_index(tbl: WidgetTable) -> Int {
    return tbl.selected_row;
}

pub fn widget_table_render(tbl: WidgetTable, buf: TuiBuffer) -> TuiBuffer {
    let a: BufferArea = tbl.area;
    if a.width < 4 || a.height < 3 {
        return buf;
    }

    // 1. Draw frame border
    let border_fg: Int = if tbl.is_focused { 14 } else { 8 };
    let b_style: BorderStyle = border_style_single(border_fg, 0);
    let mut out: TuiBuffer = border_draw_perimeter(buf, a, b_style, border_sides_all());

    // 2. Render Headers
    let num_cols: Int = list_len(tbl.columns);
    let mut cur_x: Int = a.x + 1;
    let header_y: Int = a.y + 1;
    let mut c_idx: Int = 0;
    while c_idx < num_cols && cur_x < (a.x + a.width - 1) {
        let col: TableColumn = list_get(tbl.columns, c_idx);
        out = tui_buffer_write_string(out, cur_x, header_y, col.title, 15, 0, 1);
        cur_x = cur_x + col.width + 1;
        if cur_x < (a.x + a.width - 1) {
            out = tui_buffer_set_cell(out, cur_x - 1, header_y, tui_cell_new(124, 8, 0));
        }
        c_idx = c_idx + 1;
    }

    // 3. Draw Header Separator
    let sep_y: Int = a.y + 2;
    let mut sx: Int = a.x + 1;
    while sx < (a.x + a.width - 1) {
        out = tui_buffer_set_cell(out, sx, sep_y, tui_cell_new(45, 8, 0));
        sx = sx + 1;
    }

    // 4. Render Rows
    let num_rows: Int = tbl.num_rows;
    let max_display_rows: Int = a.height - 3;
    let mut r_idx: Int = 0;
    while r_idx < max_display_rows {
        let actual_row_idx: Int = tbl.scroll_offset + r_idx;
        if actual_row_idx < num_rows {
            let row_y: Int = a.y + 3 + r_idx;
            let is_sel: Bool = actual_row_idx == tbl.selected_row;
            let fg: Int = if is_sel { 0 } else { 7 };
            let bg: Int = if is_sel { 14 } else { 0 };
            let modifier: Int = if is_sel { 1 } else { 0 };

            // Fill entire row line background if selected
            if is_sel {
                let mut rx: Int = a.x + 1;
                while rx < (a.x + a.width - 1) {
                    out = tui_buffer_set_cell(out, rx, row_y, tui_cell_new(32, fg, bg));
                    rx = rx + 1;
                }
            }

            let mut cell_x: Int = a.x + 1;
            let mut col_i: Int = 0;
            let cell_offset: Int = actual_row_idx * num_cols;
            while col_i < num_cols && cell_x < (a.x + a.width - 1) {
                let idx_in_cells: Int = cell_offset + col_i;
                let mut cell_txt: String = "";
                if idx_in_cells < list_len(tbl.cells) {
                    cell_txt = list_get(tbl.cells, idx_in_cells);
                }
                let col_info: TableColumn = list_get(tbl.columns, col_i);
                out = tui_buffer_write_string(out, cell_x, row_y, cell_txt, fg, bg, modifier);
                cell_x = cell_x + col_info.width + 1;
                col_i = col_i + 1;
            }
        }
        r_idx = r_idx + 1;
    }
    return out;
}
