// # Terminal User Interface (TUI) & Layouts Facade
//
// Logline: Re-exports screen buffers, renderers, widgets, layouts, event models, and themes.
//
// Setup: Pure standard library facade module importing companion TUI submodules.
//
// Beats:
//   1. Import core TUI domain companion submodules.
//   2. Provide typed shim markers exercising symbols across buffers, widgets, layouts, and themes.

import "std/app/ui/tui/tui_buffer.oo";
import "std/app/ui/tui/tui_cell.oo";
import "std/app/ui/tui/tui_renderer.oo";
import "std/app/ui/tui/box_drawing.oo";
import "std/app/ui/tui/border_styles.oo";
import "std/app/ui/tui/widget_window.oo";
import "std/app/ui/tui/layout_flex.oo";
import "std/app/ui/tui/key_events.oo";
import "std/app/ui/tui/theme_dark.oo";
import "std/app/ui/tui/theme_light.oo";

pub fn shim_marker_tui_cell() -> TuiCell {
    return tui_cell_new(65, 15, 0);
}

pub fn shim_marker_tui_buffer() -> TuiBuffer {
    return tui_buffer_new(80, 24);
}

pub fn shim_marker_tui_renderer() -> TuiRenderer {
    return tui_renderer_new(80, 24);
}

pub fn shim_marker_box_glyphs() -> BoxGlyphs {
    return box_glyphs_rounded();
}

pub fn shim_marker_border_styles() -> BorderStyle {
    return border_style_rounded(14, 0);
}

pub fn shim_marker_widget_window() -> WidgetWindow {
    let area: BufferArea = buffer_area_new(0, 0, 40, 15);
    return widget_window_new(1, "Main Window", area);
}

pub fn shim_marker_layout_flex() -> FlexContainer {
    let area: BufferArea = buffer_area_new(0, 0, 80, 24);
    return flex_container_new(area, 0, 0);
}

pub fn shim_marker_key_events() -> KeyEvent {
    return key_event_new(13, "Enter");
}

pub fn shim_marker_theme_dark() -> TuiDarkTheme {
    return theme_dark_default();
}

pub fn shim_marker_theme_light() -> TuiLightTheme {
    return theme_light_default();
}
