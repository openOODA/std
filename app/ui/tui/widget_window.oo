// # TUI Window Container Widget
//
// Logline: Window panel container with title bar, border framing, focus state, and client viewport clipping.
//
// Setup: Modular container widget providing isolated bounds and decor for inner child components.
//
// Beats:
//   1. Define WidgetWindow container structure with positioning, title, and z-index ordering.
//   2. Compute inner client area geometry accounting for border frames and title bars.
//   3. Render outer frame, focused header, and clear client canvas into TuiBuffer.

import "std/app/ui/tui/tui_cell.oo";
import "std/app/ui/tui/tui_buffer.oo";
import "std/app/ui/tui/border_styles.oo";

type WidgetWindow = struct {
    id: Int,
    title: String,
    area: BufferArea,
    border_style: BorderStyle,
    is_focused: Bool,
    is_visible: Bool,
    z_index: Int
};

pub fn widget_window_new(id: Int, title: String, area: BufferArea) -> WidgetWindow {
    return WidgetWindow {
        id: id,
        title: title,
        area: area,
        border_style: border_style_rounded(7, 0),
        is_focused: false,
        is_visible: true,
        z_index: 0
    };
}

pub fn widget_window_set_focus(win: WidgetWindow, focused: Bool) -> WidgetWindow {
    let old_bs: BorderStyle = win.border_style;
    let new_fg: Int = if focused { 14 } else { 7 };
    let new_bs: BorderStyle = BorderStyle {
        kind: old_bs.kind,
        fg: new_fg,
        bg: old_bs.bg,
        glyphs: old_bs.glyphs
    };
    return WidgetWindow {
        id: win.id,
        title: win.title,
        area: win.area,
        border_style: new_bs,
        is_focused: focused,
        is_visible: win.is_visible,
        z_index: win.z_index
    };
}

pub fn widget_window_set_title(win: WidgetWindow, title: String) -> WidgetWindow {
    return WidgetWindow {
        id: win.id,
        title: title,
        area: win.area,
        border_style: win.border_style,
        is_focused: win.is_focused,
        is_visible: win.is_visible,
        z_index: win.z_index
    };
}

pub fn widget_window_set_visible(win: WidgetWindow, visible: Bool) -> WidgetWindow {
    return WidgetWindow {
        id: win.id,
        title: win.title,
        area: win.area,
        border_style: win.border_style,
        is_focused: win.is_focused,
        is_visible: visible,
        z_index: win.z_index
    };
}

pub fn widget_window_set_border_style(win: WidgetWindow, style: BorderStyle) -> WidgetWindow {
    return WidgetWindow {
        id: win.id,
        title: win.title,
        area: win.area,
        border_style: style,
        is_focused: win.is_focused,
        is_visible: win.is_visible,
        z_index: win.z_index
    };
}

pub fn widget_window_get_inner_area(win: WidgetWindow) -> BufferArea {
    let a: BufferArea = win.area;
    let b_offset: Int = if (win.border_style).kind > 0 { 1 } else { 0 };
    let mut w: Int = a.width - (b_offset * 2);
    let mut h: Int = a.height - (b_offset * 2);
    if w < 0 {
        w = 0;
    }
    if h < 0 {
        h = 0;
    }
    return BufferArea {
        x: a.x + b_offset,
        y: a.y + b_offset,
        width: w,
        height: h
    };
}

pub fn widget_window_render(win: WidgetWindow, buf: TuiBuffer) -> TuiBuffer {
    if !(win.is_visible) {
        return buf;
    }
    let a: BufferArea = win.area;
    if a.width < 2 || a.height < 2 {
        return buf;
    }

    let bg_cell: TuiCell = tui_cell_new(32, (win.border_style).fg, (win.border_style).bg);
    let mut out: TuiBuffer = tui_buffer_fill_rect(buf, a, bg_cell);

    let sides: BorderSides = border_sides_all();
    out = border_draw_perimeter(out, a, win.border_style, sides);

    let t: String = win.title;
    let t_len: Int = t.len();
    if t_len > 0 && a.width > (t_len + 4) {
        let title_x: Int = a.x + 2;
        let title_y: Int = a.y;
        let title_fg: Int = if win.is_focused { 15 } else { (win.border_style).fg };
        let title_mod: Int = if win.is_focused { 1 } else { 0 };
        out = tui_buffer_write_string(out, title_x, title_y, " " + t + " ", title_fg, (win.border_style).bg, title_mod);
    }
    return out;
}
