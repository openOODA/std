// # Fitts's Law Skill Transfer Theory
//
// Logline: Practice on a target size/amplitude pair transfers to other pairs with the same index of difficulty.
//
// Setup: Pure Int. distance and width must be positive. Returns 1 if IDs match. Hosts ui_invariants.oo stem.
//
// Beats:
//   1. Compute index of difficulty (in integer millibits) for two target configurations.
//   2. Skill transfer: 1 if IDs are equal, 0 otherwise.
//   3. Practice trial count: required trials for reliable transfer.
//   4. Hosts ui_invariants.oo stem for cross-law correlation.

import "std/app/ui/ui_invariants.oo";

fn fst_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Integer ID millibits: distance*1000/width. D=0 with W>0 is Ok(0). W<=0 or D<0 is Err.
pub fn fst_id_millibits(distance: Int, width: Int) -> Result[Int, String] {
    if distance < 0 { return Err("ERR\tfst\tdomain"); }
    if width <= 0 { return Err("ERR\tfst\tdomain"); }
    if distance == 0 { return Ok(0); }
    let d: Int = distance * 1000;
    let ratio: Int = d / width;
    return Ok(ratio);
}

// Skill transfer: 1 if the two configurations have equal IDs. Illegal ID is 0.
pub fn fst_skill_transfers(d1: Int, w1: Int, d2: Int, w2: Int) -> Int {
    let r1: Result[Int, String] = fst_id_millibits(d1, w1);
    let r2: Result[Int, String] = fst_id_millibits(d2, w2);
    if r1.is_ok() == false { return 0; }
    if r2.is_ok() == false { return 0; }
    if fst_got(r1) == fst_got(r2) { return 1; }
    return 0;
}

// Practice trial count. Negative min_trials is Err. 0..9 clamp to Ok(10).
pub fn fst_required_trials(min_trials: Int) -> Result[Int, String] {
    if min_trials < 0 { return Err("ERR\tfst\tdomain"); }
    if min_trials < 10 { return Ok(10); }
    return Ok(min_trials);
}

// KAT and hostile cases for the Fitts skill transfer theory.
pub fn verify_fitts_skill_transfer_theory() -> Bool {
    let ui_inv_ok: Int = ui_size_ok(8, 8);
    if ui_inv_ok != 1 { return false; }
    if fst_skill_transfers(100, 10, 200, 20) != 1 { return false; }
    if fst_skill_transfers(100, 10, 100, 20) != 0 { return false; }
    if fst_skill_transfers(0, 10, 100, 10) != 0 { return false; }
    if fst_skill_transfers(100, 0, 100, 10) != 0 { return false; }
    if fst_skill_transfers(100, 0 - 1, 100, 10) != 0 { return false; }
    if fst_skill_transfers(0 - 1, 10, 100, 10) != 0 { return false; }
    if fst_got(fst_id_millibits(100, 10)) != 10000 { return false; }
    if fst_got(fst_id_millibits(50, 10)) != 5000 { return false; }
    let zd: Result[Int, String] = fst_id_millibits(0, 10);
    if zd.is_ok() == false { return false; }
    if fst_got(zd) != 0 { return false; }
    if fst_id_millibits(10, 0).is_ok() { return false; }
    if fst_id_millibits(10, 0 - 1).is_ok() { return false; }
    if fst_got(fst_required_trials(0)) != 10 { return false; }
    if fst_got(fst_required_trials(5)) != 10 { return false; }
    if fst_got(fst_required_trials(20)) != 20 { return false; }
    if fst_required_trials(0 - 1).is_ok() { return false; }
    return true;
}
