type PbrSceneConfig = struct {
    max_bounces: Int,
    samples_per_pixel: Int,
    use_mis: Int,
    use_russian_roulette: Int
};

pub fn pbr_scene_config_default() -> PbrSceneConfig {
    return PbrSceneConfig {
        max_bounces: 8,
        samples_per_pixel: 64,
        use_mis: 1,
        use_russian_roulette: 1
    };
}
