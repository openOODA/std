// # User Feedback Principle
//
// Logline: Every user action must produce a visible, timely, and reversible response.
//
// Setup: Pure Int. response_code in [0, 3]. action and response are non-negative. Out-of-range returns 0. Hosts ui_invariants.oo stem.
//
// Beats:
//   1. Response code 0 = none, 1 = visual, 2 = audio/haptic, 3 = full feedback.
//   2. Feedback witness: 1 if response >= visual and latency <= 250ms.
//   3. Reversibility witness: 1 if action is undoable.
//   4. Hosts ui_invariants.oo stem for cross-law correlation.

import "std/app/ui/ui_invariants.oo";

// Response code constants.
pub fn feedback_response_none() -> Int {
    return 0;
}

pub fn feedback_response_visual() -> Int {
    return 1;
}

pub fn feedback_response_audio() -> Int {
    return 2;
}

pub fn feedback_response_full() -> Int {
    return 3;
}

// Default latency threshold (ms): feedback within 250ms.
pub fn feedback_latency_threshold_ms() -> Int {
    return 250;
}

// Feedback witness: 1 if response >= visual and latency <= threshold.
pub fn feedback_satisfied(response_code: Int, latency_ms: Int) -> Int {
    if response_code < 0 { return 0; }
    if response_code > 3 { return 0; }
    if latency_ms < 0 { return 0; }
    if response_code == feedback_response_none() { return 0; }
    if latency_ms > feedback_latency_threshold_ms() { return 0; }
    return 1;
}

// Reversibility witness: 1 if action is undoable.
pub fn feedback_is_undoable(can_undo: Int) -> Int {
    if can_undo == 1 { return 1; }
    return 0;
}

// Combined witness: feedback AND reversibility.
pub fn feedback_full_satisfied(response_code: Int, latency_ms: Int, can_undo: Int) -> Int {
    if feedback_satisfied(response_code, latency_ms) != 1 { return 0; }
    if feedback_is_undoable(can_undo) != 1 { return 0; }
    return 1;
}

// KAT and hostile cases for the feedback principle.
pub fn verify_feedback_principle() -> Bool {
    let ui_inv_ok: Int = ui_size_ok(8, 8);
    if ui_inv_ok != 1 { return false; }
    if feedback_response_none() != 0 { return false; }
    if feedback_response_visual() != 1 { return false; }
    if feedback_response_audio() != 2 { return false; }
    if feedback_response_full() != 3 { return false; }
    if feedback_satisfied(1, 100) != 1 { return false; }
    if feedback_satisfied(3, 250) != 1 { return false; }
    if feedback_satisfied(0, 100) != 0 { return false; }
    if feedback_satisfied(1, 251) != 0 { return false; }
    if feedback_satisfied(0 - 1, 100) != 0 { return false; }
    if feedback_satisfied(4, 100) != 0 { return false; }
    if feedback_satisfied(1, 0 - 1) != 0 { return false; }
    if feedback_is_undoable(1) != 1 { return false; }
    if feedback_is_undoable(0) != 0 { return false; }
    if feedback_is_undoable(2) != 0 { return false; }
    if feedback_is_undoable(0 - 1) != 0 { return false; }
    if feedback_full_satisfied(1, 100, 1) != 1 { return false; }
    if feedback_full_satisfied(1, 100, 0) != 0 { return false; }
    if feedback_full_satisfied(0, 100, 1) != 0 { return false; }
    if feedback_latency_threshold_ms() != 250 { return false; }
    return true;
}
