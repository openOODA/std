// # Hick's Law
//
// Logline: Choice reaction time scales as log2(n + 1) where n is the number of equally probable choices.
//
// Setup: Pure Float. b > 0. n >= 0. n=0 is Ok(0). b<=0 or n<0 return Err. Hosts ui_invariants.oo stem.
//
// Beats:
//   1. Reaction time RT = b * log2(n + 1).
//   2. Choice with non-uniform probabilities: RT = b * H(X) where H is Shannon entropy.
//   3. Doubling choices: RT increases by b (a constant).
//   4. Hosts ui_invariants.oo stem for cross-law correlation.

import "std/app/ui/ui_invariants.oo";

pub fn hicks_min_b() -> Float {
    return 0.1;
}

fn hk_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

// Reaction time RT = b * log2(n + 1). n=0 is Ok(0). b<=0 or n<0 return Err.
pub fn hicks_reaction_time(b: Float, n_choices: Int) -> Result[Float, String] {
    if b <= 0.0 { return Err("ERR\thicks\tb"); }
    if n_choices < 0 { return Err("ERR\thicks\tn"); }
    if n_choices == 0 { return Ok(0.0); }
    let mut acc: Float = 0.0;
    let mut i: Int = 0;
    while i < n_choices {
        acc = acc + 1.0;
        i = i + 1;
    }
    let arg: Float = 1.0 + acc;
    let ln2: Float = 0.6931471805599453;
    return Ok(b * (ln(arg) / ln2));
}

// Doubling witness: 1 if RT for 2n choices is greater than RT for n choices.
pub fn hicks_doubles(b: Float, n_choices: Int) -> Int {
    let r1: Result[Float, String] = hicks_reaction_time(b, n_choices);
    let r2: Result[Float, String] = hicks_reaction_time(b, n_choices * 2);
    if r1.is_ok() == false { return 0; }
    if r2.is_ok() == false { return 0; }
    let rt1: Float = hk_got(r1);
    let rt2: Float = hk_got(r2);
    if rt2 > rt1 { return 1; }
    return 0;
}

// Reaction time with Shannon entropy: RT = b * H(X).
pub fn hicks_entropy_time(b: Float, shannon_entropy_bits: Float) -> Result[Float, String] {
    if b <= 0.0 { return Err("ERR\thicks\tb"); }
    if shannon_entropy_bits < 0.0 { return Err("ERR\thicks\th"); }
    return Ok(b * shannon_entropy_bits);
}

// KAT and hostile cases for Hick's law.
pub fn verify_hicks_law() -> Bool {
    let ui_inv_ok: Int = ui_size_ok(8, 8);
    if ui_inv_ok != 1 { return false; }
    let rt0: Float = hk_got(hicks_reaction_time(0.1, 0));
    if rt0 != 0.0 { return false; }
    if hicks_reaction_time(0.1, 0).is_ok() == false { return false; }
    let rt1: Float = hk_got(hicks_reaction_time(0.1, 1));
    let target_rt1: Float = 0.1;
    let mut drt1: Float = rt1 - target_rt1;
    if drt1 < 0.0 { drt1 = 0.0 - drt1; }
    if drt1 > 0.0001 { return false; }
    let rt7: Float = hk_got(hicks_reaction_time(0.1, 7));
    let target: Float = 0.1 * 3.0;
    let mut d: Float = rt7 - target;
    if d < 0.0 { d = 0.0 - d; }
    if d > 0.0001 { return false; }
    if hicks_doubles(0.1, 4) != 1 { return false; }
    if hicks_doubles(0.1, 1) != 1 { return false; }
    if hicks_reaction_time(0.0, 7).is_ok() { return false; }
    if hicks_reaction_time(0.0 - 0.1, 7).is_ok() { return false; }
    if hicks_reaction_time(0.1, 0 - 1).is_ok() { return false; }
    if hicks_doubles(0.0, 4) != 0 { return false; }
    if hicks_doubles(0.1, 0) != 0 { return false; }
    if hicks_entropy_time(0.0, 1.0).is_ok() { return false; }
    if hicks_entropy_time(0.1, 0.0 - 1.0).is_ok() { return false; }
    let et: Float = hk_got(hicks_entropy_time(0.1, 2.0));
    if et != 0.2 { return false; }
    if hicks_min_b() <= 0.0 { return false; }
    return true;
}
