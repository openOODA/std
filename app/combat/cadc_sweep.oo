// # Central Air Data Computer Wing Sweep Schedule
//
// Logline: Model automated variable wing sweep aerodynamics, aspect ratio variations, and wave drag polar schedules.
//
// Setup: Pure aerodynamic computation with zero ambient authority.
//
// Beats:
//   1. Calculate clamped wing sweep schedules and dynamic aspect ratios.
//   2. Compute transonic wave drag multipliers as a function of wing sweep angle.
//   3. Evaluate complete central air data computer wing sweep telemetry.


import "std/core/math/constants.oo";
fn circ_pi_std_phys_aero_cadc_sweep() -> Float { let pack: CircleConstants = circle_constants(); return pack.pi; }
pub fn cadc_circ_pi_std_phys_aero_cadc_sweep() -> Float {
    return circ_pi_std_phys_aero_cadc_sweep();
}

pub fn cadc_clamp(val: Float, min_val: Float, max_val: Float) -> Float {
    if val < min_val {
        return min_val;
    }
    if val > max_val {
        return max_val;
    }
    return val;
}

type CadcSweepTelemetry = struct {
    sweep_deg: Float,
    aspect_ratio: Float,
    wingspan_ft: Float,
    cd0: Float,
    k_factor: Float,
    oswald_e: Float,
    ac_shift_mac: Float,
    glove_vane: Bool
};

// Computes nominal CADC automated wing sweep angle Lambda in degrees [20.0, 68.0]
// based on Mach number M and dynamic pressure q (psf).
pub fn cadc_compute_wing_sweep(mach: Float, dynamic_pressure_psf: Float) -> Float {
    if mach <= 0.60 {
        return 20.0;
    }
    let mut q_bias: Float = 0.0;
    if dynamic_pressure_psf > 1000.0 {
        q_bias = (dynamic_pressure_psf - 1000.0) * 0.015;
        if q_bias > 8.0 {
            q_bias = 8.0;
        }
    }
    if mach <= 0.70 {
        return cadc_clamp(20.0 + q_bias, 20.0, 68.0);
    }
    if mach >= 1.40 {
        return 68.0;
    }
    let mach_fraction: Float = (mach - 0.70) / (1.40 - 0.70);
    let sweep_linear: Float = 20.0 + (48.0 * mach_fraction) + q_bias;
    return cadc_clamp(sweep_linear, 20.0, 68.0);
}

// Computes dynamic effective aerodynamic aspect ratio AR(Lambda) from sweep angle.
// AR = 7.28 at 20.0 deg (unswept), AR = 2.21 at 68.0 deg (swept), AR = 1.72 at 75.0 deg (over-sweep).
pub fn cadc_compute_aspect_ratio(sweep_deg: Float) -> Float {
    let sweep_clamped: Float = cadc_clamp(sweep_deg, 20.0, 75.0);
    if sweep_clamped > 68.0 {
        let over_fraction: Float = (sweep_clamped - 68.0) / 7.0;
        return 2.21 - (0.49 * over_fraction);
    }
    let xi: Float = (sweep_clamped - 20.0) / 48.0;
    let ar: Float = 7.28 - (5.07 * xi) + (0.12 * xi * (1.0 - xi));
    return ar;
}

// Computes wingspan in feet as function of sweep angle [20.0, 75.0].
// b = 64.125 ft at 20.0 deg down to 38.167 ft at 68.0 deg and 33.29 ft at 75.0 deg.
pub fn cadc_compute_wingspan(sweep_deg: Float) -> Float {
    let sweep_clamped: Float = cadc_clamp(sweep_deg, 20.0, 75.0);
    if sweep_clamped > 68.0 {
        let over_fraction: Float = (sweep_clamped - 68.0) / 7.0;
        return 38.167 - (4.877 * over_fraction);
    }
    let xi: Float = (sweep_clamped - 20.0) / 48.0;
    return 64.125 - (25.958 * xi);
}

// Computes Oswald span efficiency factor e(Lambda) [0.70, 0.85].
pub fn cadc_compute_oswald_efficiency(sweep_deg: Float) -> Float {
    let sweep_clamped: Float = cadc_clamp(sweep_deg, 20.0, 68.0);
    let xi: Float = (sweep_clamped - 20.0) / 48.0;
    return 0.85 - (0.15 * xi);
}

// Computes induced drag factor K = 1 / (pi * AR * e).
pub fn cadc_compute_induced_drag_factor(sweep_deg: Float) -> Float {
    let ar: Float = cadc_compute_aspect_ratio(sweep_deg);
    let e: Float = cadc_compute_oswald_efficiency(sweep_deg);
    let denom: Float = cadc_circ_pi_std_phys_aero_cadc_sweep() * ar * e;
    if denom <= 0.0001 {
        return 0.25;
    }
    return 1.0 / denom;
}

// Computes zero-lift drag coefficient CD0(Lambda, M) including base parasite drag
// and sweep-dependent transonic/supersonic wave drag rise.
pub fn cadc_compute_cd0(sweep_deg: Float, mach: Float) -> Float {
    let sweep_clamped: Float = cadc_clamp(sweep_deg, 20.0, 68.0);
    let xi: Float = (sweep_clamped - 20.0) / 48.0;
    let cd0_base: Float = 0.0195 + (0.0030 * xi);
    let m_cr: Float = 0.74 + (0.18 * xi);
    let m_peak: Float = 1.15;
    let a_wave: Float = 0.042 - (0.034 * xi);

    if mach <= m_cr {
        return cd0_base;
    }
    if mach <= m_peak {
        let tau: Float = (mach - m_cr) / (m_peak - m_cr);
        let hermite: Float = tau * tau * (3.0 - (2.0 * tau));
        return cd0_base + (a_wave * hermite);
    }
    let decay: Float = 1.0 - (0.35 * ((mach - m_peak) / (1.0 + (mach - m_peak))));
    return cd0_base + (a_wave * decay);
}

// Computes total aerodynamic drag coefficient CD = CD0 + K * CL^2.
pub fn cadc_compute_total_drag_coefficient(sweep_deg: Float, mach: Float, cl: Float) -> Float {
    let cd0: Float = cadc_compute_cd0(sweep_deg, mach);
    let k: Float = cadc_compute_induced_drag_factor(sweep_deg);
    return cd0 + (k * cl * cl);
}

// Computes wing aerodynamic center shift (fraction of MAC aft) due to sweep.
pub fn cadc_compute_ac_shift(sweep_deg: Float) -> Float {
    let sweep_clamped: Float = cadc_clamp(sweep_deg, 20.0, 68.0);
    let xi: Float = (sweep_clamped - 20.0) / 48.0;
    return 0.18 * xi;
}

// Evaluates whether auxiliary glove vanes are automatically deployed (M >= 1.4 and sweep >= 67 deg).
pub fn cadc_glove_vane_deployed(mach: Float, sweep_deg: Float) -> Bool {
    if mach >= 1.40 {
        if sweep_deg >= 67.0 {
            return true;
        }
    }
    return false;
}

// Applies hydraulic actuator rate limit (7.5 deg/sec maximum on F-14).
pub fn cadc_rate_limit(current_sweep: Float, target_sweep: Float, dt: Float) -> Float {
    let max_delta: Float = 7.5 * dt;
    let delta: Float = target_sweep - current_sweep;
    if delta > max_delta {
        return current_sweep + max_delta;
    }
    if delta < (0.0 - max_delta) {
        return current_sweep - max_delta;
    }
    return target_sweep;
}

// Full telemetry evaluation snapshot for CADC sweep state.
pub fn cadc_eval_sweep_state(mach: Float, dynamic_pressure_psf: Float, current_sweep: Float, dt: Float) -> CadcSweepTelemetry {
    let target_sweep: Float = cadc_compute_wing_sweep(mach, dynamic_pressure_psf);
    let sweep: Float = cadc_rate_limit(current_sweep, target_sweep, dt);
    let ar: Float = cadc_compute_aspect_ratio(sweep);
    let span: Float = cadc_compute_wingspan(sweep);
    let cd0_val: Float = cadc_compute_cd0(sweep, mach);
    let k_val: Float = cadc_compute_induced_drag_factor(sweep);
    let e_val: Float = cadc_compute_oswald_efficiency(sweep);
    let ac_shift: Float = cadc_compute_ac_shift(sweep);
    let gv: Bool = cadc_glove_vane_deployed(mach, sweep);

    return CadcSweepTelemetry {
        sweep_deg: sweep,
        aspect_ratio: ar,
        wingspan_ft: span,
        cd0: cd0_val,
        k_factor: k_val,
        oswald_e: e_val,
        ac_shift_mac: ac_shift,
        glove_vane: gv
    };
}

pub fn verify_cadc_polar() -> Bool {
    let got: Float = cadc_compute_total_drag_coefficient(20.0, 0.5, 0.4);
    let cd0: Float = cadc_compute_cd0(20.0, 0.5);
    let k: Float = cadc_compute_induced_drag_factor(20.0);
    let want: Float = cd0 + (k * 0.4 * 0.4);
    let mut d: Float = got - want;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > 0.0000001 {
        return false;
    }
    if cadc_compute_wing_sweep(0.50, 400.0) != 20.0 {
        return false;
    }
    if cadc_compute_wing_sweep(1.55, 800.0) != 68.0 {
        return false;
    }
    return true;
}
