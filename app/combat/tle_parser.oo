// # NORAD Two-Line Element (TLE) Parser
//
// Logline: Parses NORAD Two-Line Element strings with Modulo-10 checksum verification into orbital data.
//
// Setup: Imports tle_types.oo and orbital_types.oo for TLE structure definitions and physical constants.
//
// Beats:
//   1. Validate Modulo-10 checksums on 69-character lines 1 and 2.
//   2. Parse floating-point, integer, and compact scientific notation fields.
//   3. Derive physical angles in radians, mean motion in rad/min, and semimajor axis.

import "./tle_types.oo";
import "./orbital_types.oo";

pub fn tle_char_to_digit(c: String) -> Int {
    if c == "0" { return 0; }
    if c == "1" { return 1; }
    if c == "2" { return 2; }
    if c == "3" { return 3; }
    if c == "4" { return 4; }
    if c == "5" { return 5; }
    if c == "6" { return 6; }
    if c == "7" { return 7; }
    if c == "8" { return 8; }
    if c == "9" { return 9; }
    return 0 - 1;
}

pub fn tle_digit_to_float(d: Int) -> Float {
    if d == 0 { return 0.0; }
    if d == 1 { return 1.0; }
    if d == 2 { return 2.0; }
    if d == 3 { return 3.0; }
    if d == 4 { return 4.0; }
    if d == 5 { return 5.0; }
    if d == 6 { return 6.0; }
    if d == 7 { return 7.0; }
    if d == 8 { return 8.0; }
    if d == 9 { return 9.0; }
    return 0.0;
}

pub fn tle_verify_checksum(line: String) -> Bool {
    let n: Int = chars_len(line);
    if n < 69 {
        return false;
    }
    let mut sum: Int = 0;
    let mut j: Int = 0;
    while j < 68 {
        let ch: String = char_at(line, j);
        let d: Int = tle_char_to_digit(ch);
        if d >= 0 {
            sum = sum + d;
        } else if ch == "-" {
            sum = sum + 1;
        }
        j = j + 1;
    }
    let expected: Int = tle_char_to_digit(char_at(line, 68));
    if expected < 0 {
        return false;
    }
    return (sum % 10) == expected;
}

pub fn tle_parse_int(s: String) -> Int {
    let str_t: String = str_trim(s);
    let n: Int = chars_len(str_t);
    if n == 0 { return 0; }
    let mut sign: Int = 1;
    let mut start: Int = 0;
    if char_at(str_t, 0) == "-" {
        sign = 0 - 1;
        start = 1;
    } else if char_at(str_t, 0) == "+" {
        start = 1;
    }
    let mut res: Int = 0;
    let mut j: Int = start;
    while j < n {
        let d: Int = tle_char_to_digit(char_at(str_t, j));
        if d >= 0 {
            res = (res * 10) + d;
        }
        j = j + 1;
    }
    return res * sign;
}

pub fn tle_parse_float(s: String) -> Float {
    let str_t: String = str_trim(s);
    let n: Int = chars_len(str_t);
    if n == 0 { return 0.0; }
    let mut sign: Float = 1.0;
    let mut start: Int = 0;
    if char_at(str_t, 0) == "-" {
        sign = 0.0 - 1.0;
        start = 1;
    } else if char_at(str_t, 0) == "+" {
        start = 1;
    }
    let mut whole: Float = 0.0;
    let mut frac: Float = 0.0;
    let mut frac_div: Float = 1.0;
    let mut in_frac: Bool = false;
    let mut j: Int = start;
    while j < n {
        let ch: String = char_at(str_t, j);
        if ch == "." {
            in_frac = true;
        } else {
            let d: Int = tle_char_to_digit(ch);
            if d >= 0 {
                let df: Float = tle_digit_to_float(d);
                if in_frac {
                    frac_div = frac_div * 10.0;
                    frac = frac + (df / frac_div);
                } else {
                    whole = (whole * 10.0) + df;
                }
            }
        }
        j = j + 1;
    }
    return (whole + frac) * sign;
}

pub fn tle_parse_exp_decimal(s: String) -> Float {
    let str_t: String = str_trim(s);
    let n: Int = chars_len(str_t);
    if n < 3 { return 0.0; }
    let mut sign: Float = 1.0;
    let mut start: Int = 0;
    if char_at(str_t, 0) == "-" {
        sign = 0.0 - 1.0;
        start = 1;
    } else if char_at(str_t, 0) == "+" {
        start = 1;
    }
    let exp_char: String = char_at(str_t, n - 2);
    let exp_digit_ch: String = char_at(str_t, n - 1);
    let exp_digit: Int = tle_char_to_digit(exp_digit_ch);
    let mut exp_mult: Float = 1.0;
    let mut k: Int = 0;
    while k < exp_digit {
        exp_mult = exp_mult * 10.0;
        k = k + 1;
    }
    let mantissa_str: String = str_slice(str_t, start, n - 2);
    let m_len: Int = chars_len(mantissa_str);
    let mut mantissa_val: Float = 0.0;
    let mut m_div: Float = 1.0;
    let mut m_idx: Int = 0;
    while m_idx < m_len {
        let d: Int = tle_char_to_digit(char_at(mantissa_str, m_idx));
        if d >= 0 {
            mantissa_val = (mantissa_val * 10.0) + tle_digit_to_float(d);
            m_div = m_div * 10.0;
        }
        m_idx = m_idx + 1;
    }
    let norm_mantissa: Float = mantissa_val / m_div;
    if exp_char == "-" {
        return (sign * norm_mantissa) / exp_mult;
    }
    return (sign * norm_mantissa) * exp_mult;
}

pub fn sgp4_parse_tle(line1: String, line2: String) -> Result[TLEData, String] {
    if chars_len(line1) < 69 || chars_len(line2) < 69 {
        return Err("InvalidTLELength");
    }
    if !tle_verify_checksum(line1) || !tle_verify_checksum(line2) {
        return Err("InvalidTLEChecksum");
    }
    let sat_num1: Int = tle_parse_int(str_slice(line1, 2, 7));
    let classification: String = str_slice(line1, 7, 8);
    let designator: String = str_trim(str_slice(line1, 9, 17));
    let epoch_year: Int = tle_parse_int(str_slice(line1, 18, 20));
    let epoch_day: Float = tle_parse_float(str_slice(line1, 20, 32));
    let bstar: Float = tle_parse_exp_decimal(str_slice(line1, 53, 61));

    let inc_deg: Float = tle_parse_float(str_slice(line2, 8, 16));
    let raan_deg: Float = tle_parse_float(str_slice(line2, 17, 25));
    let ecc_raw: Float = tle_parse_float(str_slice(line2, 26, 33));
    let ecc: Float = ecc_raw / 10000000.0;
    let argp_deg: Float = tle_parse_float(str_slice(line2, 34, 42));
    let m_deg: Float = tle_parse_float(str_slice(line2, 43, 51));
    let n_revs: Float = tle_parse_float(str_slice(line2, 52, 63));
    let rev_num: Int = tle_parse_int(str_slice(line2, 63, 68));

    let deg_to_rad: Float = const_deg_to_rad();
    let inc_rad: Float = inc_deg * deg_to_rad;
    let raan_rad: Float = raan_deg * deg_to_rad;
    let argp_rad: Float = argp_deg * deg_to_rad;
    let m_rad: Float = m_deg * deg_to_rad;

    let two_pi: Float = const_two_pi();
    let n_rad_min: Float = (n_revs * two_pi) / 1440.0;
    let n_rad_sec: Float = (n_revs * two_pi) / 86400.0;

    let mu_earth: Float = const_mu_earth();
    let n_sq: Float = n_rad_sec * n_rad_sec;
    let a_cubed: Float = mu_earth / n_sq;
    let a_km: Float = pow(a_cubed, 0.3333333333333333);

    let tle: TLEData = tle_data_new(
        sat_num1, classification, designator, epoch_year, epoch_day, bstar,
        inc_deg, inc_rad, raan_deg, raan_rad, ecc, argp_deg, argp_rad,
        m_deg, m_rad, n_revs, n_rad_min, rev_num, a_km
    );
    return Ok(tle);
}
