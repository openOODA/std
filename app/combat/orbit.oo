// # Orbital Mechanics & Astrodynamics Facade
//
// Logline: implemented Int orbit_vec3 facade. Off Float shims and fail-closed stubs.
//
// Setup: Re-exports implemented orbit_types only. No List[Float]. No process_exit.
//
// Beats:
//   1. Construct Vec3 via orbit_vec3_new.
//   2. Read x and y through facade getters.
// residual: kepler/coords/engine/stubs/Float shims implemented; this is the Int vec floor.

import "./orbit_types.oo";

pub fn orbit_state_new(x: Int, y: Int, z: Int) -> OrbitVec3 {
    return orbit_vec3_new(x, y, z);
}

pub fn orbit_state_x(v: OrbitVec3) -> Int {
    return orbit_vec3_x(v);
}

pub fn orbit_state_y(v: OrbitVec3) -> Int {
    return orbit_vec3_y(v);
}

pub fn orbit_state_z(v: OrbitVec3) -> Int {
    return orbit_vec3_z(v);
}
