// # Gun Ballistics and Optical Sight Lead Computation
//
// Logline: Calculates projectile time-of-flight, parabolic gravity drop, and lead angles for aerial gunnery.
//
// Setup: Ballistic kinematic equations and iterative time-of-flight solvers without ambient authority.
//
// Beats:
//   1. Calculate projectile time of flight to target range.
//   2. Compute parabolic vertical gravity drop along trajectory.
//   3. Calculate lead angles and bullet dispersion patterns.

pub fn ballistics_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn ballistics_float_to_int(f: Float) -> Int {
    let mut n: Int = 0;
    let mut rem: Float = f;
    if rem < 0.0 { rem = 0.0 - rem; }
    while rem >= 10000.0 { n = n + 10000; rem = rem - 10000.0; }
    while rem >= 1000.0 { n = n + 1000; rem = rem - 1000.0; }
    while rem >= 100.0 { n = n + 100; rem = rem - 100.0; }
    while rem >= 10.0 { n = n + 10; rem = rem - 10.0; }
    while rem >= 1.0 { n = n + 1; rem = rem - 1.0; }
    if f < 0.0 { return 0 - n; }
    return n;
}

pub fn ballistics_solve_tof(range_m: Float, v_closing_mps: Float, muzzle_vel_mps: Float) -> Float {
    if muzzle_vel_mps <= 0.001 {
        return 0.0;
    }
    let effective_vel: Float = muzzle_vel_mps + v_closing_mps;
    if effective_vel <= 10.0 {
        return range_m / muzzle_vel_mps;
    }
    let t0: Float = range_m / effective_vel;
    let t1: Float = range_m / (effective_vel - (0.5 * 9.80665 * t0 * 0.05));
    return t1;
}

pub fn ballistics_calculate_bullet_drop(tof_s: Float) -> Float {
    return 0.5 * 9.80665 * tof_s * tof_s;
}

pub fn ballistics_compute_lead_angle_deg(los_rate_rad_s: Float, tof_s: Float) -> Float {
    let lead_rad: Float = los_rate_rad_s * tof_s;
    return lead_rad * 57.29577951308232;
}

pub fn ballistics_resolve_burst_hits(
    rounds_fired: Int,
    range_m: Float,
    dispersion_mrad: Float,
    target_area_sqm: Float
) -> Int {
    if range_m <= 0.0 || rounds_fired <= 0 {
        return 0;
    }
    let sigma_m: Float = range_m * (dispersion_mrad * 0.001);
    let area_circle: Float = 3.14159265 * sigma_m * sigma_m;
    if area_circle <= 0.0001 {
        return rounds_fired;
    }
    let p_hit_single: Float = target_area_sqm / area_circle;
    let mut clamped_p: Float = p_hit_single;
    if p_hit_single > 0.85 {
        clamped_p = 0.85;
    }
    let rounds_f: Float = ballistics_int_to_float(rounds_fired);
    let expected_hits: Float = rounds_f * clamped_p;
    return ballistics_float_to_int(expected_hits);
}
