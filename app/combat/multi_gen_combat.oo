pub fn eval_gun_envelope(range_ft: Float, bore_angle_deg: Float, max_range_ft: Float) -> Bool {
    if range_ft <= 0.0 || range_ft > max_range_ft {
        return false;
    }
    if bore_angle_deg < 0.0 {
        if (0.0 - bore_angle_deg) > 6.0 {
            return false;
        }
    } else {
        if bore_angle_deg > 6.0 {
            return false;
        }
    }
    return true;
}

pub fn eval_aim9b_ir_envelope(range_ft: Float, aspect_angle_deg: Float, launch_g: Float) -> Bool {
    if range_ft < 3000.0 || range_ft > 15000.0 {
        return false;
    }
    if launch_g > 2.50 {
        return false;
    }
    if aspect_angle_deg < 0.0 {
        if (0.0 - aspect_angle_deg) > 34.0 {
            return false;
        }
    } else {
        if aspect_angle_deg > 34.0 {
            return false;
        }
    }
    return true;
}

pub fn eval_aim7_sarh_envelope(range_nm: Float, target_in_radar_cone: Bool, radar_lock_maintained: Bool) -> Bool {
    if range_nm < 1.0 || range_nm > 25.0 {
        return false;
    }
    if !target_in_radar_cone || !radar_lock_maintained {
        return false;
    }
    return true;
}

pub fn eval_aim54_phoenix_envelope(range_nm: Float, target_altitude_ft: Float) -> Bool {
    if range_nm < 3.0 || range_nm > 100.0 {
        return false;
    }
    if target_altitude_ft < 100.0 || target_altitude_ft > 85000.0 {
        return false;
    }
    return true;
}

pub fn evaluate_combat_maneuver(
    specs: FighterSpecs,
    altitude_ft: Float,
    velocity_fps: Float,
    mach: Float,
    density_slug_ft3: Float,
    afterburner: Bool,
    load_factor_g: Float
) -> CombatManeuverResult {
    let mut thrust: Float = specs.thrust_dry_lbf;
    if afterburner {
        thrust = specs.thrust_ab_lbf;
    }
    let q: Float = calculate_dynamic_pressure(density_slug_ft3, velocity_fps);
    let cl_val: Float = calculate_lift_coefficient(specs.combat_weight_lbs, load_factor_g, q, specs.wing_area_sqft);
    let cdi_val: Float = calculate_induced_drag(cl_val, specs.aspect_ratio, specs.oswald_e);
    let cdw_val: Float = calculate_wave_drag(mach, specs.m_crit, 1.8);
    let cd_tot: Float = calculate_total_drag_coefficient(specs.cd0, cdi_val, cdw_val);
    let drag_tot: Float = calculate_total_drag_force(q, specs.wing_area_sqft, cd_tot);
    let ps_val: Float = calculate_ps(thrust, drag_tot, specs.combat_weight_lbs, velocity_fps);
    let tr_deg: Float = calculate_turn_rate_deg(velocity_fps, load_factor_g);
    let rad_ft: Float = calculate_turn_radius_ft(velocity_fps, load_factor_g);
    let sustained_g: Float = calculate_max_sustained_g(
        thrust,
        specs.cd0,
        specs.aspect_ratio,
        specs.oswald_e,
        q,
        specs.wing_area_sqft,
        specs.combat_weight_lbs
    );
    let he: Float = calculate_specific_energy(altitude_ft, velocity_fps);
    let is_pos: Bool = ps_val >= 0.0;

    return CombatManeuverResult {
        ps_fps: ps_val,
        drag_lbf: drag_tot,
        turn_rate_deg: tr_deg,
        turn_radius_ft: rad_ft,
        max_sustained_g: sustained_g,
        energy_height_ft: he,
        is_energy_positive: is_pos
    };
}
