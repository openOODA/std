// # Multi-Generation Combat Flight Models (Gen 1 to Gen 4)
//
// Logline: Aerodynamic specifications, weapons envelopes, and E-M combat evaluation across Fighter Generations 1 through 4.
//
// Setup: Pure aerodynamic physics module with zero ambient authority, modeling guns-only to advanced BVR multi-role fighters.
//
// Beats:
//   1. Define multi-generation fighter specifications (Gen 1 to Gen 4).
//   2. Provide standard specifications factories (F-86 Sabre, F-104 Starfighter, F-4 Phantom II, F-14 Tomcat, F-16 Falcon).
//   3. Evaluate weapons engagement envelopes (guns, AIM-9B rear-aspect IR, AIM-7 SARH BVR, AIM-54 Phoenix).
//   4. Compute complete combat maneuver state, Specific Excess Power (Ps), turn rates, and sustained G-limits.
//   5. Evaluate generation superiority metrics and energy conservation flags.

import "std/app/combat/atmosphere.oo";
import "std/app/combat/boyd_em.oo";

type FighterSpecs = struct {
    generation: Int,
    name_code: Int,
    mass_coeff: Float,
    combat_weight_lbs: Float,
    thrust_dry_lbf: Float,
    thrust_ab_lbf: Float,
    wing_area_sqft: Float,
    aspect_ratio: Float,
    oswald_e: Float,
    cd0: Float,
    m_crit: Float,
    max_mach: Float,
    max_g_limit: Float,
    gun_effective_range_ft: Float,
    has_bvr_missiles: Bool,
    ir_seeker_rear_only: Bool,
    ir_seeker_max_aspect_deg: Float
};

type CombatManeuverResult = struct {
    ps_fps: Float,
    drag_lbf: Float,
    turn_rate_deg: Float,
    turn_radius_ft: Float,
    max_sustained_g: Float,
    energy_height_ft: Float,
    is_energy_positive: Bool
};

