// # Tracing Span Law
//
// Logline: A trace span has start_ns <= end_ns; the duration is end_ns - start_ns, and any child span is nested within its parent's [start_ns, end_ns] interval.
//
// Setup: Pure Int nanoseconds. Non-negative inputs. start > end, child out of bounds, or negative inputs fail closed (duration 0, in_tree 0).
//
// Beats:
//   1. trace_span_duration: end_ns - start_ns when start_ns <= end_ns; 0 otherwise.
//   2. trace_span_valid: 1 iff start_ns <= end_ns and both are non-negative.
//   3. trace_span_in_tree: 1 iff parent valid AND child valid AND child_start >= parent_start AND child_end <= parent_end.
//   4. trace_span_depth_ok: 1 iff depth is in [0, 16] (OpenTelemetry practical nesting cap).

import "std/core/primitives/domain_cert.oo";

fn ts_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn trace_span_duration(start_ns: Int, end_ns: Int) -> Result[Int, String] {
    if start_ns < 0 { return Err("ERR\tspan\tstart"); }
    if end_ns < 0 { return Err("ERR\tspan\tend"); }
    if start_ns > end_ns { return Err("ERR\tspan\torder"); }
    return Ok(end_ns - start_ns);
}

// 1 iff the span is well-formed (start_ns and end_ns non-negative and start_ns <= end_ns).
pub fn trace_span_valid(start_ns: Int, end_ns: Int) -> Int {
    if start_ns < 0 { return 0; }
    if end_ns < 0 { return 0; }
    if start_ns > end_ns { return 0; }
    return 1;
}

// 1 iff child span is fully contained within parent span interval.
pub fn trace_span_in_tree(
    child_start_ns: Int,
    child_end_ns: Int,
    parent_start_ns: Int,
    parent_end_ns: Int
) -> Int {
    if trace_span_valid(parent_start_ns, parent_end_ns) != 1 { return 0; }
    if trace_span_valid(child_start_ns, child_end_ns) != 1 { return 0; }
    if child_start_ns < parent_start_ns { return 0; }
    if child_end_ns > parent_end_ns { return 0; }
    return 1;
}

// 1 iff depth is in [0, 16].
pub fn trace_span_depth_ok(depth: Int) -> Int {
    if depth < 0 { return 0; }
    if depth > 16 { return 0; }
    return 1;
}

// Certificate that the span law holds in a tree context.
pub fn tracing_span_law(
    start_ns: Int,
    end_ns: Int,
    p_start_ns: Int,
    p_end_ns: Int,
    depth: Int
) -> DomainCert {
    let mut holds: Int = 0;
    if trace_span_valid(start_ns, end_ns) == 1 {
        if trace_span_in_tree(start_ns, end_ns, p_start_ns, p_end_ns) == 1 {
            if trace_span_depth_ok(depth) == 1 {
                holds = 1;
            }
        }
    }
    return domain_cert("diag", "tracing_span", holds);
}

pub fn verify_tracing_span_law() -> Bool {
    // Golden: span [100, 200] -> duration 100, valid 1.
    if ts_got(trace_span_duration(100, 200)) != 100 { return false; }
    if trace_span_valid(100, 200) != 1 { return false; }
    if ts_got(trace_span_duration(150, 150)) != 0 { return false; }
    if trace_span_valid(150, 150) != 1 { return false; }
    if ts_got(trace_span_duration(0, 1000000000)) != 1000000000 { return false; }
    if trace_span_duration(200, 100).is_ok() { return false; }
    if trace_span_valid(200, 100) != 0 { return false; }
    if trace_span_duration(0 - 1, 100).is_ok() { return false; }
    if trace_span_valid(0 - 1, 100) != 0 { return false; }
    if trace_span_duration(100, 0 - 1).is_ok() { return false; }
    if trace_span_valid(100, 0 - 1) != 0 { return false; }
    if trace_span_duration(0 - 1, 0 - 1).is_ok() { return false; }
    // Coupled: child within parent.
    if trace_span_in_tree(150, 180, 100, 200) != 1 { return false; }
    if trace_span_in_tree(100, 200, 100, 200) != 1 { return false; }
    if trace_span_in_tree(120, 170, 100, 200) != 1 { return false; }
    if trace_span_in_tree(100, 100, 100, 200) != 1 { return false; }
    // Coupled: child starts before parent.
    if trace_span_in_tree(50, 180, 100, 200) != 0 { return false; }
    // Coupled: child ends after parent.
    if trace_span_in_tree(150, 250, 100, 200) != 0 { return false; }
    // Coupled: child fully before parent.
    if trace_span_in_tree(50, 80, 100, 200) != 0 { return false; }
    // Coupled: child fully after parent.
    if trace_span_in_tree(250, 300, 100, 200) != 0 { return false; }
    // Coupled: invalid parent or child fails closed.
    if trace_span_in_tree(150, 180, 200, 100) != 0 { return false; }
    if trace_span_in_tree(200, 100, 100, 200) != 0 { return false; }
    // Depth bound.
    if trace_span_depth_ok(0) != 1 { return false; }
    if trace_span_depth_ok(1) != 1 { return false; }
    if trace_span_depth_ok(16) != 1 { return false; }
    if trace_span_depth_ok(17) != 0 { return false; }
    if trace_span_depth_ok(0 - 1) != 0 { return false; }
    if trace_span_depth_ok(1000) != 0 { return false; }
    // Certificate: golden tree span at depth 2 holds.
    let c1: DomainCert = tracing_span_law(150, 180, 100, 200, 2);
    if c1.holds != 1 { return false; }
    if c1.domain != "diag" { return false; }
    if c1.law_name != "tracing_span" { return false; }
    // Certificate: out-of-tree child fails closed.
    let c2: DomainCert = tracing_span_law(50, 180, 100, 200, 1);
    if c2.holds != 0 { return false; }
    // Certificate: inverted span fails closed.
    let c3: DomainCert = tracing_span_law(200, 100, 100, 200, 1);
    if c3.holds != 0 { return false; }
    // Certificate: depth 17 fails closed.
    let c4: DomainCert = tracing_span_law(150, 180, 100, 200, 17);
    if c4.holds != 0 { return false; }
    return true;
}
