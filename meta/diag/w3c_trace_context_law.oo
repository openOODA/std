// # W3C Trace Context Law
//
// Logline: A W3C traceparent header has the exact format "00-<32 hex>-<16 hex>-<2 hex>" totaling 55 characters and exactly 4 fields; tracestate is a vendor list of at most 31 members in at most 256 bytes.
//
// Setup: Pure Int/String. The traceparent must be exactly 55 chars; 4 fields are split by '-': 2-char version, 32-char trace-id, 16-char parent-id, 2-char flags. Hostile shapes (length != 55, non-hex chars, wrong separators, empty fields) fail closed.
//
// Beats:
//   1. traceparent_length() returns 55 (W3C TC v00, fixed wire length).
//   2. traceparent_parse_count() returns 4 (version, trace-id, parent-id, flags).
//   3. traceparent_valid(tp) is 1 iff length == 55 AND all 4 fields are hex of declared width.
//   4. traceparent_field(tp, i) returns the i-th field (0..3); invalid index or shape returns "".
//   5. tracestate_member_count(ts) counts ','+1 entries clamped to [0, 31].
//   6. diag_is_w3c_trace_context_law certificate bundles length, parse count, and validity.

import "std/core/primitives/domain_cert.oo";
import "std/core/primitives/str.oo";

// W3C Trace Context Recommendation, dated 2020-11-23, status REC.
// Reference: https://www.w3.org/TR/trace-context/ (section 3.2 traceparent).
// Wire length = 2 (version) + 1 + 32 (trace-id) + 1 + 16 (parent-id) + 1 + 2 (flags) = 55.
pub fn traceparent_length() -> Int { return 55; }

// Number of '-' separated fields in traceparent v00: 4.
// Reference: W3C Trace Context 2020-11-23, section 3.2.2.1..3.2.2.4.
pub fn traceparent_parse_count() -> Int { return 4; }

pub fn traceparent_version_len() -> Int { return 2; }
pub fn traceparent_trace_id_len() -> Int { return 32; }
pub fn traceparent_parent_id_len() -> Int { return 16; }
pub fn traceparent_flags_len() -> Int { return 2; }

// Set of hex digits 0-9, a-f, A-F used for membership tests.
fn hex_alphabet() -> String { return "0123456789abcdefABCDEF"; }

// 1 iff c is a single hex digit.
fn hex_digit_ok(c: String) -> Int {
    if c.len() != 1 { return 0; }
    let alpha: String = hex_alphabet();
    let hit: Bool = str_contains(alpha, c);
    if hit == true { return 1; }
    return 0;
}

// 1 iff s has exactly n hex chars. 0 otherwise.
fn hex_field_ok(s: String, n: Int) -> Int {
    if n < 1 { return 0; }
    if s.len() != n { return 0; }
    let mut i: Int = 0;
    while i < n {
        if hex_digit_ok(char_at(s, i)) == 0 { return 0; }
        i = i + 1;
    }
    return 1;
}

// 1 iff s has '-' at offset.
fn sep_at(s: String, offset: Int) -> Int {
    if offset < 0 { return 0; }
    if offset >= s.len() { return 0; }
    if char_at(s, offset) == "-" { return 1; }
    return 0;
}

// Extracts field i (0..3) of a 55-char v00 traceparent. Returns "" on shape error.
pub fn traceparent_field(tp: String, i: Int) -> String {
    if tp.len() != traceparent_length() { return ""; }
    if i < 0 { return ""; }
    if i > 3 { return ""; }
    let v: Int = traceparent_version_len();
    let t: Int = traceparent_trace_id_len();
    let p: Int = traceparent_parent_id_len();
    let f: Int = traceparent_flags_len();
    if i == 0 { return str_slice(tp, 0, v); }
    if i == 1 { return str_slice(tp, v + 1, v + 1 + t); }
    let lo2: Int = v + 1 + t + 1;
    if i == 2 { return str_slice(tp, lo2, lo2 + p); }
    let lo3: Int = lo2 + p + 1;
    return str_slice(tp, lo3, lo3 + f);
}

// 1 iff tp is exactly 55 chars AND split into 4 hex fields of declared widths.
pub fn traceparent_valid(tp: String) -> Int {
    if tp.len() != traceparent_length() { return 0; }
    let v: Int = traceparent_version_len();
    let t: Int = traceparent_trace_id_len();
    let p: Int = traceparent_parent_id_len();
    let f: Int = traceparent_flags_len();
    if sep_at(tp, v) == 0 { return 0; }
    if sep_at(tp, v + 1 + t) == 0 { return 0; }
    if sep_at(tp, v + 1 + t + 1 + p) == 0 { return 0; }
    if hex_field_ok(str_slice(tp, 0, v), v) == 0 { return 0; }
    if hex_field_ok(str_slice(tp, v + 1, v + 1 + t), t) == 0 { return 0; }
    let lo2: Int = v + 1 + t + 1;
    if hex_field_ok(str_slice(tp, lo2, lo2 + p), p) == 0 { return 0; }
    let lo3: Int = lo2 + p + 1;
    if hex_field_ok(str_slice(tp, lo3, lo3 + f), f) == 0 { return 0; }
    return 1;
}

// Reference W3C traceparent (taken from W3C TC section 3.2 example).
pub fn w3c_reference_traceparent() -> String {
    return "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01";
}

// Max members in a tracestate per W3C TC section 3.3.1.1.
pub fn tracestate_max_members() -> Int { return 31; }

// Max byte length of a tracestate per W3C TC section 3.3.1.
pub fn tracestate_max_bytes() -> Int { return 256; }

// Count ',' in s.
fn count_commas(s: String) -> Int {
    let n: Int = s.len();
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(s, i) == "," { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// Number of tracestate members; clamped to [0, 31]. Empty is 0.
pub fn tracestate_member_count(ts: String) -> Int {
    let n: Int = ts.len();
    if n == 0 { return 0; }
    let c: Int = count_commas(ts);
    if c + 1 > tracestate_max_members() { return tracestate_max_members(); }
    return c + 1;
}

// 1 iff ts length is in [0, 256] and member count is in [0, 31].
pub fn tracestate_valid(ts: String) -> Int {
    let n: Int = ts.len();
    if n < 0 { return 0; }
    if n > tracestate_max_bytes() { return 0; }
    let m: Int = tracestate_member_count(ts);
    if m < 0 { return 0; }
    if m > tracestate_max_members() { return 0; }
    return 1;
}

// Coupled: 1 iff traceparent valid AND tracestate valid.
pub fn diag_is_w3c_trace_context_law(tp: String, ts: String) -> Int {
    if traceparent_valid(tp) == 1 {
        if tracestate_valid(ts) == 1 { return 1; }
    }
    return 0;
}

// DomainCert wrapper.
pub fn w3c_trace_context_law(tp: String, ts: String) -> DomainCert {
    let h: Int = diag_is_w3c_trace_context_law(tp, ts);
    return domain_cert("diag", "w3c_trace_context", h);
}

pub fn verify_w3c_trace_context_law() -> Bool {
    // Golden: fixed length and field count.
    if traceparent_length() != 55 { return false; }
    if traceparent_parse_count() != 4 { return false; }
    if traceparent_version_len() != 2 { return false; }
    if traceparent_trace_id_len() != 32 { return false; }
    if traceparent_parent_id_len() != 16 { return false; }
    if traceparent_flags_len() != 2 { return false; }
    // Golden: 2+1+32+1+16+1+2 = 55.
    let v: Int = traceparent_version_len();
    let t: Int = traceparent_trace_id_len();
    let p: Int = traceparent_parent_id_len();
    let f: Int = traceparent_flags_len();
    if v + 1 + t + 1 + p + 1 + f != 55 { return false; }
    // Golden: reference traceparent is valid.
    let r: String = w3c_reference_traceparent();
    if r.len() != 55 { return false; }
    if traceparent_valid(r) != 1 { return false; }
    // Golden: field extraction.
    if traceparent_field(r, 0) != "00" { return false; }
    if traceparent_field(r, 1) != "0af7651916cd43dd8448eb211c80319c" { return false; }
    if traceparent_field(r, 2) != "b7ad6b7169203331" { return false; }
    if traceparent_field(r, 3) != "01" { return false; }
    // Hostile: wrong length.
    if traceparent_valid("00-aabbccdd") != 0 { return false; }
    if traceparent_valid("00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-011") != 0 { return false; }
    if traceparent_valid("") != 0 { return false; }
    // Hostile: wrong separators.
    let bad_sep: String = "00x0af7651916cd43dd8448eb211c80319cx7b6b7169203331x01";
    if traceparent_valid(bad_sep) != 0 { return false; }
    // Hostile: non-hex chars in field 1.
    let bad_hex: String = "00-ZZ7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01";
    if traceparent_valid(bad_hex) != 0 { return false; }
    // Hostile: out-of-range field index.
    if traceparent_field(r, 4) != "" { return false; }
    if traceparent_field(r, 0 - 1) != "" { return false; }
    if traceparent_field("", 0) != "" { return false; }
    if traceparent_field("abc", 0) != "" { return false; }
    // Coupled: tracestate member count.
    if tracestate_member_count("") != 0 { return false; }
    if tracestate_member_count("vendor1=val1") != 1 { return false; }
    if tracestate_member_count("a=1,b=2") != 2 { return false; }
    if tracestate_member_count("a=1,b=2,c=3") != 3 { return false; }
    if tracestate_valid("a=1,b=2,c=3") != 1 { return false; }
    if tracestate_valid("vendor1=val1") != 1 { return false; }
    if tracestate_valid("") != 1 { return false; }
    // Hostile: tracestate over 256 bytes.
    let big: String = "";
    if big.len() <= 256 { return false; }
    if tracestate_valid(big) != 0 { return false; }
    // Coupled cert.
    let c1: DomainCert = w3c_trace_context_law(r, "vendor1=val1");
    if c1.holds != 1 { return false; }
    if c1.domain != "diag" { return false; }
    if c1.law_name != "w3c_trace_context" { return false; }
    if w3c_trace_context_law("garbage", "vendor1=val1").holds != 0 { return false; }
    if w3c_trace_context_law(r, big).holds != 0 { return false; }
    return true;
}
