// # Heartbeat Health Principle
//
// Logline: A heartbeat is healthy iff (now_ns - last_seen_ns) is in [0, timeout_ns]; after threshold missed heartbeats the circuit breaker opens and downstream calls fail closed.
//
// Setup: Pure Int. last_seen_ns and now_ns are non-negative; timeout_ns > 0 and threshold >= 1. now_ns < last_seen_ns or zero/negative inputs fail closed.
//
// Beats:
//   1. heartbeat_healthy: 1 iff delta = now_ns - last_seen_ns is in [0, timeout_ns].
//   2. circuit_breaker_open: 1 iff missed_count >= threshold.
//   3. heartbeat_health_cert: 1 iff healthy AND circuit not open.
//   4. Coupled: default threshold 3; circuit_breaker_open(3, 3) -> 1 (open).

import "std/core/primitives/domain_cert.oo";

// Default circuit-breaker threshold (3 missed heartbeats opens the circuit).
pub fn heartbeat_default_threshold() -> Int {
    return 3;
}

fn hb_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn heartbeat_delta(last_seen_ns: Int, now_ns: Int) -> Result[Int, String] {
    if last_seen_ns < 0 { return Err("ERR\thb\ttime"); }
    if now_ns < 0 { return Err("ERR\thb\ttime"); }
    if now_ns < last_seen_ns { return Err("ERR\thb\torder"); }
    return Ok(now_ns - last_seen_ns);
}

pub fn heartbeat_healthy(last_seen_ns: Int, now_ns: Int, timeout_ns: Int) -> Int {
    if timeout_ns < 1 { return 0; }
    let dr: Result[Int, String] = heartbeat_delta(last_seen_ns, now_ns);
    if dr.is_ok() == false { return 0; }
    let d: Int = hb_got(dr);
    if d <= timeout_ns { return 1; }
    return 0;
}

// 1 iff missed_count >= threshold; 0 otherwise.
pub fn circuit_breaker_open(missed_count: Int, threshold: Int) -> Int {
    if missed_count < 0 { return 0; }
    if threshold < 1 { return 0; }
    if missed_count >= threshold { return 1; }
    return 0;
}

// 1 iff healthy AND circuit not open.
pub fn heartbeat_health_cert(
    last_seen_ns: Int,
    now_ns: Int,
    timeout_ns: Int,
    missed_count: Int,
    threshold: Int
) -> DomainCert {
    let mut holds: Int = 0;
    let h: Int = heartbeat_healthy(last_seen_ns, now_ns, timeout_ns);
    let c: Int = circuit_breaker_open(missed_count, threshold);
    if h == 1 {
        if c == 0 {
            holds = 1;
        }
    }
    return domain_cert("diag", "heartbeat", holds);
}

pub fn verify_heartbeat_principle() -> Bool {
    // Golden: last=100, now=150, timeout=100 -> delta=50, healthy.
    if heartbeat_healthy(100, 150, 100) != 1 { return false; }
    if hb_got(heartbeat_delta(100, 150)) != 50 { return false; }
    if heartbeat_healthy(100, 200, 100) != 1 { return false; }
    if heartbeat_healthy(100, 100, 100) != 1 { return false; }
    if hb_got(heartbeat_delta(100, 100)) != 0 { return false; }
    if heartbeat_healthy(150, 100, 100) != 0 { return false; }
    if heartbeat_delta(150, 100).is_ok() { return false; }
    // Hostile: delta > timeout fails closed.
    if heartbeat_healthy(100, 250, 100) != 0 { return false; }
    if heartbeat_healthy(0, 1000001, 1000000) != 0 { return false; }
    // Hostile: negative inputs fail closed.
    if heartbeat_healthy(0 - 1, 100, 100) != 0 { return false; }
    if heartbeat_healthy(100, 0 - 1, 100) != 0 { return false; }
    if heartbeat_healthy(100, 100, 0) != 0 { return false; }
    if heartbeat_healthy(100, 100, 0 - 1) != 0 { return false; }
    if heartbeat_delta(0 - 1, 100).is_ok() { return false; }
    // Coupled: circuit breaker opens at threshold, stays open above.
    if circuit_breaker_open(0, 3) != 0 { return false; }
    if circuit_breaker_open(1, 3) != 0 { return false; }
    if circuit_breaker_open(2, 3) != 0 { return false; }
    if circuit_breaker_open(3, 3) != 1 { return false; }
    if circuit_breaker_open(4, 3) != 1 { return false; }
    if circuit_breaker_open(100, 3) != 1 { return false; }
    if heartbeat_default_threshold() != 3 { return false; }
    if circuit_breaker_open(heartbeat_default_threshold(), heartbeat_default_threshold()) != 1 { return false; }
    // Coupled: hostile inputs to circuit_breaker_open.
    if circuit_breaker_open(0 - 1, 3) != 0 { return false; }
    if circuit_breaker_open(3, 0) != 0 { return false; }
    if circuit_breaker_open(3, 0 - 1) != 0 { return false; }
    // Certificate: golden healthy with closed circuit.
    let c1: DomainCert = heartbeat_health_cert(100, 150, 100, 0, 3);
    if c1.holds != 1 { return false; }
    if c1.domain != "diag" { return false; }
    if c1.law_name != "heartbeat" { return false; }
    // Certificate: timeout exceeded -> unhealthy.
    let c2: DomainCert = heartbeat_health_cert(100, 250, 100, 0, 3);
    if c2.holds != 0 { return false; }
    // Certificate: open circuit -> unhealthy even within timeout.
    let c3: DomainCert = heartbeat_health_cert(100, 150, 100, 3, 3);
    if c3.holds != 0 { return false; }
    // Certificate: now < last_seen -> unhealthy.
    let c4: DomainCert = heartbeat_health_cert(150, 100, 100, 0, 3);
    if c4.holds != 0 { return false; }
    return true;
}
