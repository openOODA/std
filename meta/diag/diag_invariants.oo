// # Diagnostic explicit-level law
//
// Logline: Panic path must be explicit; empty level is not a valid diagnostic.
//
// Setup: Pure String level names. INFO is explicit; "" is not.
//
// Beats:
//   1. diag_ok_level("INFO") holds=1.
//   2. diag_ok_level("") holds=0.
//   3. domain_cert boxes the holds bit for the diag domain.
//
// residual: name gate only; not a logger

import "std/core/primitives/domain_cert.oo";
pub fn diag_ok_level(level: String) -> Int {
    if level == "" {
        return 0;
    }
    if level == "INFO" {
        return 1;
    }
    if level == "WARN" {
        return 1;
    }
    if level == "ERROR" {
        return 1;
    }
    if level == "PANIC" {
        return 1;
    }
    return 0;
}

pub fn diag_level_law(level: String) -> DomainCert {
    return domain_cert("diag", "ok_level", diag_ok_level(level));
}
