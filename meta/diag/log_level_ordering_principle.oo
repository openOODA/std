// # Log Level Ordering Principle
//
// Logline: A log level at or above a threshold is admitted; a level below is rejected.
//
// Setup: Pure Int. Level and threshold are positive integers; 0 means "no level" and fails closed.
//
// Beats:
//   1. diag_level_at_least returns 1 iff level >= threshold and both are positive.
//   2. diag_levels_monotonic returns 1 iff a three-element sequence is non-decreasing.
//   3. Zero, negative, or out-of-order inputs fail closed to 0.

import "std/core/primitives/domain_cert.oo";

pub fn diag_level_at_least(level: Int, threshold: Int) -> Int {
    if level <= 0 {
        return 0;
    }
    if threshold <= 0 {
        return 0;
    }
    if level >= threshold {
        return 1;
    }
    return 0;
}

pub fn diag_levels_monotonic(a: Int, b: Int, c: Int) -> Int {
    if a <= 0 {
        return 0;
    }
    if b <= 0 {
        return 0;
    }
    if c <= 0 {
        return 0;
    }
    if a <= b {
        if b <= c {
            return 1;
        }
    }
    return 0;
}

pub fn diag_level_ordering_law(level: Int, threshold: Int) -> DomainCert {
    return domain_cert("diag", "log_level_ordering", diag_level_at_least(level, threshold));
}

pub fn verify_log_level_ordering_principle() -> Bool {
    // Golden: level=3 above threshold=2 holds.
    if diag_level_at_least(3, 2) != 1 { return false; }
    // Golden: level equals threshold holds.
    if diag_level_at_least(5, 5) != 1 { return false; }
    // Golden: monotonic 1,2,3 holds.
    if diag_levels_monotonic(1, 2, 3) != 1 { return false; }
    // Golden: monotonic 4,4,4 holds.
    if diag_levels_monotonic(4, 4, 4) != 1 { return false; }
    // Hostile: level=2 below threshold=5 rejects.
    if diag_level_at_least(2, 5) != 0 { return false; }
    // Hostile: level=0 fails closed.
    if diag_level_at_least(0, 1) != 0 { return false; }
    // Hostile: threshold=0 fails closed.
    if diag_level_at_least(3, 0) != 0 { return false; }
    // Hostile: descending 3,2,1 fails closed.
    if diag_levels_monotonic(3, 2, 1) != 0 { return false; }
    // Hostile: zero in sequence fails closed.
    if diag_levels_monotonic(0, 1, 2) != 0 { return false; }
    // DomainCert.holds matches the Int law.
    if diag_level_ordering_law(3, 2).holds != 1 { return false; }
    if diag_level_ordering_law(2, 5).holds != 0 { return false; }
    return true;
}
