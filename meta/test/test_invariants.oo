// # Test assert-equality law
//
// Logline: A test that always returns 1 without asserting is not proof.
//
// Setup: Pure Int compare. Holds only when both sides are equal.
//
// Beats:
//   1. test_assert_eq(1, 2) holds=0.
//   2. test_assert_eq(1, 1) holds=1.
//   3. domain_cert boxes the holds bit for the test domain.
//
// residual: Int equality only; not a suite runner

import "std/core/primitives/domain_cert.oo";
pub fn test_assert_eq(got: Int, want: Int) -> Int {
    if got == want {
        return 1;
    }
    return 0;
}

pub fn test_assert_law(got: Int, want: Int) -> DomainCert {
    return domain_cert("test", "assert_eq", test_assert_eq(got, want));
}
