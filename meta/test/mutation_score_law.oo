// # Mutation score law (Papadakis 2019 IEEE TSE)
//
// Logline: Mutation score equals killed mutants divided by total mutants; a score >= 0.8 is sufficient; mutation subsumes line coverage as a stronger test criterion.
//
// Setup: Pure Int arithmetic. No FS, net, env. Per-mille representation (0..1000) avoids Float.
//
// Beats:
//   1. mutation_score(8, 10) reports 800 (0.8 exact, within 0.001%).
//   2. mutation_score_sufficient(8, 10) reports 1.
//   3. mutation_score fails closed for zero or negative total.
//   4. mutation_score_holds is 1 only on valid inputs.
//   5. Coupled with coverage: mutation score >= line coverage when the test is strong.

import "std/core/primitives/domain_cert.oo";

// Papadakis et al. 2019 IEEE TSE "Mutation Testing Advances: An Analysis and Survey":
// mutation score = killed / total. Modern reduction operators (AOR, ROR, UOI, etc.)
// reduce the operator set while preserving the score's interpretation.
pub fn mutation_score(killed: Int, total: Int) -> Result[Int, String] {
    if total <= 0 { return Err("ERR\tmsl\tdomain"); }
    if killed < 0 { return Err("ERR\tmsl\tdomain"); }
    if killed > total { return Err("ERR\tmsl\tdomain"); }
    // Papadakis 2019: per-mille = (killed * 1000) / total, 0.001% exact.
    return Ok((killed * 1000) / total);
}

// Papadakis 2019: 0.8 is the conventional sufficient threshold for mutation score.
pub fn mutation_score_sufficient(killed: Int, total: Int) -> Int {
    if total <= 0 { return 0; }
    if killed < 0 { return 0; }
    if killed > total { return 0; }
    let pm: Int = (killed * 1000) / total;
    if pm >= 800 {
        return 1;
    }
    return 0;
}

pub fn mutation_score_holds(killed: Int, total: Int) -> DomainCert {
    if total < 0 {
        return domain_cert("test", "mutation_score_law", 0);
    }
    if killed < 0 {
        return domain_cert("test", "mutation_score_law", 0);
    }
    if killed > total {
        return domain_cert("test", "mutation_score_law", 0);
    }
    return domain_cert("test", "mutation_score_law", 1);
}

// Coupled with code coverage: Papadakis 2019 notes mutation is strictly stronger
// than line coverage; a strong test satisfies mutation >= line coverage.
pub fn mutation_stronger_than_coverage(mutation_pm: Int, line_pm: Int) -> Int {
    if mutation_pm < 0 { return 0; }
    if line_pm < 0 { return 0; }
    if mutation_pm > 1000 { return 0; }
    if line_pm > 1000 { return 0; }
    if mutation_pm >= line_pm {
        return 1;
    }
    return 0;
}

fn msl_got(r: Result[Int, String]) -> Int {
    match r {
        Ok(v)  => { return v; },
        Err(_) => { return 0 - 1; }
    }
}

pub fn verify_mutation_score_law() -> Bool {
    // Golden: killed=8, total=10 -> 0.8 (per-mille = 800) within 0.001%.
    if msl_got(mutation_score(8, 10)) != 800 { return false; }
    // Golden: 8/10 sufficient.
    if mutation_score_sufficient(8, 10) != 1 { return false; }
    // Golden: 7/10 insufficient (pm = 700 < 800).
    if mutation_score_sufficient(7, 10) != 0 { return false; }
    // Golden: 10/10 sufficient (full kill).
    if mutation_score_sufficient(10, 10) != 1 { return false; }
    // Golden: 0/10 insufficient (pm = 0).
    if mutation_score_sufficient(0, 10) != 0 { return false; }
    // Golden: 16/20 = 0.8 (per-mille = 800) within 0.001%.
    if msl_got(mutation_score(16, 20)) != 800 { return false; }
    // Hostile: zero total -> Err.
    if mutation_score(5, 0).is_ok() { return false; }
    // Hostile: negative total -> Err.
    if mutation_score(5, 0 - 1).is_ok() { return false; }
    // Hostile: killed < 0 -> Err.
    if mutation_score(0 - 1, 10).is_ok() { return false; }
    // Hostile: killed > total -> Err.
    if mutation_score(11, 10).is_ok() { return false; }
    // Hostile: zero total -> mutation_score_sufficient returns 0.
    if mutation_score_sufficient(5, 0) != 0 { return false; }
    // mutation_score_holds valid -> 1.
    let h1: DomainCert = mutation_score_holds(8, 10);
    if h1.holds != 1 { return false; }
    // mutation_score_holds negative total -> 0.
    let h2: DomainCert = mutation_score_holds(5, 0 - 1);
    if h2.holds != 0 { return false; }
    // mutation_score_holds killed > total -> 0.
    let h3: DomainCert = mutation_score_holds(11, 10);
    if h3.holds != 0 { return false; }
    // Coupled: mutation 800 >= line 800 -> 1.
    let c1: Int = mutation_stronger_than_coverage(800, 800);
    if c1 != 1 { return false; }
    // Coupled: mutation 900 >= line 800 -> 1 (strictly stronger).
    let c2: Int = mutation_stronger_than_coverage(900, 800);
    if c2 != 1 { return false; }
    // Coupled: mutation 700 < line 800 -> 0 (inconsistent with Papadakis 2019).
    let c3: Int = mutation_stronger_than_coverage(700, 800);
    if c3 != 0 { return false; }
    return true;
}
