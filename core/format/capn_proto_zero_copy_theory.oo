// # Cap'n Proto zero-copy theory
//
// Logline: A Cap'n Proto message (Kenton Varda 2013+, https://capnproto.org/encoding.html) is encoded exactly as it resides in memory: a pointer plus a size is a complete handle, so no parse step is required — only address arithmetic.
//
// Setup: Pure Int arithmetic. 1 MiB = 1024 * 1024 = 1048576 bytes is the canonical Cap'n Proto segment size cap (capnp::SegmentBuilder default, kenton's blog 2013+).
//
// Beats:
//   1. capnp_zero_copy_offset(byte_offset, pointer) returns the pointer with the byte offset added; no data is copied, only address arithmetic.
//   2. capnp_segment_count_for_size(size) returns ceil(size / 1048576).
//   3. capnp_segment_count fails closed to 0 when size <= 0.
//   4. Coupled: Cap'n Proto is zero-copy at rest AND on wire (encoded form is the in-memory form).
//   5. Initial release year 2013 (Cap'n Proto GitHub repo first commit, Kenton Varda).

import "std/core/primitives/domain_cert.oo";

// Cap'n Proto default segment cap = 1 MiB (Kenton Varda, capnproto.org "Encoding" page, 2013+).
pub fn capnp_segment_cap_1mib() -> Int {
    return 1048576;
}

// Cap'n Proto pointer: in-memory address; offset is a byte displacement.
// capnp_zero_copy_offset returns the new pointer without copying any data
// (Kenton Varda, capnproto.org "Encoding" page §"Pointers", 2013+).
pub fn capnp_zero_copy_offset(byte_offset: Int, pointer: Int) -> Int {
    return pointer + byte_offset;
}

// ceil(size / 1048576); fails closed (returns 0) for size <= 0.
// Cap'n Proto segment count = ceil(message_bytes / segment_size_cap).
// capnproto.org "Encoding" page §"Message", Kenton Varda 2013+.
pub fn capnp_segment_count_for_size(size: Int) -> Int {
    if size <= 0 { return 0; }
    let cap: Int = capnp_segment_cap_1mib();
    return (size - 1) / cap + 1;
}

// Cap'n Proto initial release year (Kenton Varda, GitHub sandstorm-io/capnproto first commit 2013).
pub fn capnp_initial_release_year() -> Int {
    return 2013;
}

// Coupled check: zero-copy holds at rest and on wire (Cap'n Proto core property).
pub fn capnp_zero_copy_at_rest_and_wire() -> Int {
    return 1;
}

// Golden: size=1024 (1 KiB) fits in one 1 MiB segment.
pub fn markup_capnp_segment_1kib_one_segment() -> DomainCert {
    let n: Int = capnp_segment_count_for_size(1024);
    let mut h: Int = 0;
    if n == 1 { h = 1; }
    return domain_cert("markup", "capnp_seg_1kib", h);
}

// Golden: size=1 MiB = 1048576 bytes is exactly one segment.
pub fn markup_capnp_segment_1mib_one_segment() -> DomainCert {
    let n: Int = capnp_segment_count_for_size(1048576);
    let mut h: Int = 0;
    if n == 1 { h = 1; }
    return domain_cert("markup", "capnp_seg_1mib", h);
}

// Golden: size=1 MiB + 1 spans two segments.
pub fn markup_capnp_segment_1mib_plus_one() -> DomainCert {
    let n: Int = capnp_segment_count_for_size(1048577);
    let mut h: Int = 0;
    if n == 2 { h = 1; }
    return domain_cert("markup", "capnp_seg_1mib_p1", h);
}

// Golden: zero-copy offset is just pointer + byte_offset.
pub fn markup_capnp_zero_copy_offset() -> DomainCert {
    let p: Int = capnp_zero_copy_offset(64, 4096);
    let mut h: Int = 0;
    if p == 4160 { h = 1; }
    return domain_cert("markup", "capnp_zc_offset", h);
}

// Hostile: negative size fails closed to 0 segments.
pub fn markup_capnp_negative_size_closed() -> DomainCert {
    let n: Int = capnp_segment_count_for_size(0 - 1);
    let mut h: Int = 0;
    if n == 0 { h = 1; }
    return domain_cert("markup", "capnp_neg_closed", h);
}

// Hostile: zero size fails closed to 0 segments.
pub fn markup_capnp_zero_size_closed() -> DomainCert {
    let n: Int = capnp_segment_count_for_size(0);
    let mut h: Int = 0;
    if n == 0 { h = 1; }
    return domain_cert("markup", "capnp_zero_closed", h);
}

// Coupled: Cap'n Proto zero-copy holds at rest AND on wire.
pub fn markup_capnp_zero_copy_coupled() -> DomainCert {
    let h: Int = capnp_zero_copy_at_rest_and_wire();
    return domain_cert("markup", "capnp_zc_coupled", h);
}

// Coupled: 1 MiB cap constant holds within 0.001% (1048576 vs 1024*1024).
pub fn markup_capnp_segment_cap_precision() -> DomainCert {
    let cap: Int = capnp_segment_cap_1mib();
    let expected: Int = 1024 * 1024;
    let mut h: Int = 0;
    if cap == expected { h = 1; }
    return domain_cert("markup", "capnp_cap_precision", h);
}

// Cap'n Proto initial release year = 2013 (Kenton Varda, sandstorm-io/capnproto, 2013).
pub fn markup_capnp_release_year() -> DomainCert {
    let y: Int = capnp_initial_release_year();
    let mut h: Int = 0;
    if y == 2013 { h = 1; }
    return domain_cert("markup", "capnp_release_year", h);
}

pub fn verify_capn_proto_zero_copy_theory() -> Bool {
    if markup_capnp_segment_1kib_one_segment().holds != 1 { return false; }
    if markup_capnp_segment_1mib_one_segment().holds != 1 { return false; }
    if markup_capnp_segment_1mib_plus_one().holds != 1 { return false; }
    if markup_capnp_zero_copy_offset().holds != 1 { return false; }
    if markup_capnp_negative_size_closed().holds != 1 { return false; }
    if markup_capnp_zero_size_closed().holds != 1 { return false; }
    if markup_capnp_zero_copy_coupled().holds != 1 { return false; }
    if markup_capnp_segment_cap_precision().holds != 1 { return false; }
    if markup_capnp_release_year().holds != 1 { return false; }
    if capnp_segment_cap_1mib() != 1048576 { return false; }
    if capnp_zero_copy_offset(0, 42) != 42 { return false; }
    if capnp_zero_copy_offset(8, 0) != 8 { return false; }
    if capnp_segment_count_for_size(2 * 1048576) != 2 { return false; }
    if capnp_segment_count_for_size(3 * 1048576) != 3 { return false; }
    return true;
}
