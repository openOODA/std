// # markup literature KAT
//
// Logline: Canonical post-2010 serialization standard publication years hold within 0.001% (exact integer match): CBOR RFC 8949 (Dec 2020), Cap'n Proto (2013), FlatBuffers (2014), Protocol Buffers v3 (2016-07-28), MessagePack spec (2017).
//
// Setup: Imports ../primitives/domain_cert.oo and the three sibling format files (capn_proto_zero_copy_theory.oo, cbor_determinism_law.oo, flatbuffers_forward_backward_principle.oo). All five publication years are cited from the canonical sources and compared exactly (0.001% precision = exact integer match for a year).
//
// Beats:
//   1. CBOR RFC 8949 published December 2020 (Bormann & Hoffman).
//   2. Cap'n Proto initial release 2013 (Kenton Varda).
//   3. FlatBuffers initial release 2014 (Wouter van Oortmerssen, Google).
//   4. Protocol Buffers v3 release 2016-07-28 (Google, protobuf/protobuf v3.0.0).
//   5. MessagePack spec 2017 (Sadayuki Furuhashi, msgpack/msgpack).
//   6. All five years round-trip within 0.001% (exact equality).

import "../primitives/domain_cert.oo";
import "capn_proto_zero_copy_theory.oo";
import "cbor_determinism_law.oo";
import "flatbuffers_forward_backward_principle.oo";

// CBOR RFC 8949 published December 2020 (Bormann & Hoffman, RFC 8949).
pub fn cbor_rfc8949_publish_year_kat() -> Int {
    return 2020;
}

// Cap'n Proto initial release 2013 (Kenton Varda, sandstorm-io/capnproto, 2013).
pub fn capn_proto_initial_year_kat() -> Int {
    return 2013;
}

// FlatBuffers initial release 2014 (Wouter van Oortmerssen, Google, 2014).
pub fn flatbuffers_initial_year_kat() -> Int {
    return 2014;
}

// Protocol Buffers v3 release 2016-07-28 (Google, protobuf/protobuf v3.0.0, 2016).
pub fn protobuf_v3_release_year_kat() -> Int {
    return 2016;
}

// MessagePack spec 2017 (Sadayuki Furuhashi, msgpack/msgpack spec 2017).
pub fn messagepack_spec_year_kat() -> Int {
    return 2017;
}

// 0.001% precision = relative tolerance 1e-5; years are exact integers so equality is required.
// For an integer year Y vs reference Y0, |Y - Y0| / Y0 <= 1e-5 implies Y == Y0 for Y0 >= 10000.
pub fn rel_tol_kat_markup() -> Float {
    return 0.00001;
}

// Year-precision check: |got - target| / target <= 1e-5.
fn check_year_kat(got: Int, target: Int, label: String) -> DomainCert {
    let diff: Int = got - target;
    let abs_d: Int = if diff < 0 { 0 - diff } else { diff };
    let mut h: Int = 0;
    if abs_d == 0 { h = 1; }
    return domain_cert("markup", label, h);
}

// KAT: CBOR RFC 8949 published December 2020.
pub fn markup_kat_cbor_rfc8949_year() -> DomainCert {
    return check_year_kat(cbor_rfc8949_publish_year_kat(), 2020, "kat_cbor_year");
}

// KAT: Cap'n Proto initial release 2013.
pub fn markup_kat_capn_proto_year() -> DomainCert {
    return check_year_kat(capn_proto_initial_year_kat(), 2013, "kat_capnp_year");
}

// KAT: FlatBuffers initial release 2014.
pub fn markup_kat_flatbuffers_year() -> DomainCert {
    return check_year_kat(flatbuffers_initial_year_kat(), 2014, "kat_fb_year");
}

// KAT: Protocol Buffers v3 release 2016-07-28 (year 2016).
pub fn markup_kat_protobuf_v3_year() -> DomainCert {
    return check_year_kat(protobuf_v3_release_year_kat(), 2016, "kat_pb_v3_year");
}

// KAT: MessagePack spec 2017.
pub fn markup_kat_messagepack_year() -> DomainCert {
    return check_year_kat(messagepack_spec_year_kat(), 2017, "kat_msgpack_year");
}

// KAT: all five years hold together (coupled literature set).
pub fn markup_kat_all_years_coupled() -> DomainCert {
    let a: Int = cbor_rfc8949_publish_year_kat();
    let b: Int = capn_proto_initial_year_kat();
    let c: Int = flatbuffers_initial_year_kat();
    let d: Int = protobuf_v3_release_year_kat();
    let e: Int = messagepack_spec_year_kat();
    let mut h: Int = 0;
    if a == 2020 {
        if b == 2013 {
            if c == 2014 {
                if d == 2016 {
                    if e == 2017 { h = 1; }
                }
            }
        }
    }
    return domain_cert("markup", "kat_all_years", h);
}

// KAT: cross-reference CBOR year via the cbor_determinism_law function.
pub fn markup_kat_cbor_crossref() -> DomainCert {
    let a: Int = cbor_rfc8949_publish_year_kat();
    let b: Int = cbor_rfc8949_publish_year();
    let mut h: Int = 0;
    if a == b { h = 1; }
    return domain_cert("markup", "kat_cbor_cross", h);
}

// KAT: cross-reference Cap'n Proto year via the capn_proto_zero_copy_theory function.
pub fn markup_kat_capnp_crossref() -> DomainCert {
    let a: Int = capn_proto_initial_year_kat();
    let b: Int = capnp_initial_release_year();
    let mut h: Int = 0;
    if a == b { h = 1; }
    return domain_cert("markup", "kat_capnp_cross", h);
}

// KAT: cross-reference FlatBuffers year via the flatbuffers_forward_backward_principle function.
pub fn markup_kat_flatbuffers_crossref() -> DomainCert {
    let a: Int = flatbuffers_initial_year_kat();
    let b: Int = flatbuffers_initial_release_year();
    let mut h: Int = 0;
    if a == b { h = 1; }
    return domain_cert("markup", "kat_fb_cross", h);
}

pub fn verify_markup_kat() -> Bool {
    if markup_kat_cbor_rfc8949_year().holds != 1 { return false; }
    if markup_kat_capn_proto_year().holds != 1 { return false; }
    if markup_kat_flatbuffers_year().holds != 1 { return false; }
    if markup_kat_protobuf_v3_year().holds != 1 { return false; }
    if markup_kat_messagepack_year().holds != 1 { return false; }
    if markup_kat_all_years_coupled().holds != 1 { return false; }
    if markup_kat_cbor_crossref().holds != 1 { return false; }
    if markup_kat_capnp_crossref().holds != 1 { return false; }
    if markup_kat_flatbuffers_crossref().holds != 1 { return false; }
    if cbor_rfc8949_publish_year_kat() != 2020 { return false; }
    if capn_proto_initial_year_kat() != 2013 { return false; }
    if flatbuffers_initial_year_kat() != 2014 { return false; }
    if protobuf_v3_release_year_kat() != 2016 { return false; }
    if messagepack_spec_year_kat() != 2017 { return false; }
    return true;
}
