// # Single-line TOML pair
//
// Logline: toml_parse reads one `key = value` line and returns `key\tvalue`.
//
// Setup: This module is pure: no FS, net, or env. Callers import this file.
//
// Beats:
//   1. Reject empty input, newlines, tables, and comments.
//   2. Scan a bare key up to the first equals.
//   3. Take a quoted or bare value; escapes and leftovers fail closed.

fn toml_bad() -> Result[String, String] {
    return Err("UNIMPLEMENTED_RESIDUAL");
}

fn toml_skip_space(raw: String, i: Int) -> Int {
    let n: Int = chars_len(raw);
    let mut j: Int = i;
    while j < n {
        if char_is_space(char_at(raw, j)) {
            j = j + 1;
        } else {
            return j;
        }
    }
    return j;
}

fn toml_is_key_char(ch: String) -> Bool {
    if char_is_alpha(ch) {
        return true;
    }
    if char_is_digit(ch) {
        return true;
    }
    if ch == "_" {
        return true;
    }
    if ch == "-" {
        return true;
    }
    return false;
}

// Real: one line `key = "val"` or `key = bare`. Ok payload "key\tvalue".
pub fn toml_parse(raw: String) -> Result[String, String] {
    if raw.len() == 0 {
        return toml_bad();
    }
    if raw.contains("\n") {
        return toml_bad();
    }
    if raw.contains("\r") {
        return toml_bad();
    }
    if raw.contains("[") {
        return toml_bad();
    }
    if raw.contains("#") {
        return toml_bad();
    }
    let n: Int = chars_len(raw);
    let mut eq: Int = 0 - 1;
    let mut i: Int = 0;
    while i < n {
        if char_at(raw, i) == "=" {
            if eq < 0 {
                eq = i;
            }
        }
        i = i + 1;
    }
    if eq < 0 {
        return toml_bad();
    }
    let ks: Int = toml_skip_space(raw, 0);
    let mut key: String = "";
    let mut ki: Int = ks;
    let mut seen_space: Int = 0;
    while ki < eq {
        let ch: String = char_at(raw, ki);
        if char_is_space(ch) {
            seen_space = 1;
        } else {
            if seen_space == 1 {
                return toml_bad();
            }
            if toml_is_key_char(ch) {
                key = key + ch;
            } else {
                return toml_bad();
            }
        }
        ki = ki + 1;
    }
    if key.len() == 0 {
        return toml_bad();
    }
    let vs: Int = toml_skip_space(raw, eq + 1);
    if vs >= n {
        return toml_bad();
    }
    if char_at(raw, vs) == "\"" {
        let mut val: String = "";
        let mut vi: Int = vs + 1;
        let mut closed: Int = 0;
        let mut endq: Int = vs;
        while vi < n {
            let chv: String = char_at(raw, vi);
            if chv == "\"" {
                closed = 1;
                endq = vi;
                vi = n;
            } else {
                if chv == "\\" {
                    return toml_bad();
                }
                val = val + chv;
                vi = vi + 1;
            }
        }
        if closed == 0 {
            return toml_bad();
        }
        if toml_skip_space(raw, endq + 1) != n {
            return toml_bad();
        }
        return Ok(key + "\t" + val);
    }
    let mut val2: String = "";
    let mut bi: Int = vs;
    while bi < n {
        let ch2: String = char_at(raw, bi);
        if char_is_space(ch2) {
            if toml_skip_space(raw, bi) != n {
                return toml_bad();
            }
            bi = n;
        } else {
            val2 = val2 + ch2;
            bi = bi + 1;
        }
    }
    if val2.len() == 0 {
        return toml_bad();
    }
    return Ok(key + "\t" + val2);
}
