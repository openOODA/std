// # Total function theory
//
// Logline: a function is total when it is defined for every input in its domain; the theory is closed for a single function and coupled with the partial-function view: total ⇒ f(x) defined ∀x.
//
// Setup: Pure Int. Models square (total), sqrt (partial, undefined for x<0), inverse (partial, undefined for x=0), and identity (total). Hostile unknown func_ids or empty sample sets fail closed to 0.
//
// Beats:
//   1. is_total_known(func_id) returns 1 for total functions (square, identity) and 0 for partial or unknown.
//   2. is_total_for_input(func_id, x) returns 1 only when the function is defined at x.
//   3. is_total_function(func_id, n_samples) checks the first n samples and fails closed on n_samples < 1.
//   4. Coupled: total implies defined for every sampled input.

import "std/core/primitives/domain_cert.oo";

// Sample inputs: 1, 0, -1, 100, -100.
pub fn sample_input(sample_id: Int) -> Int {
    if sample_id == 0 { return 1; }
    if sample_id == 1 { return 0; }
    if sample_id == 2 { return 0 - 1; }
    if sample_id == 3 { return 100; }
    if sample_id == 4 { return 0 - 100; }
    return 0;
}

// 1 if the function id is known to be total over its domain.
pub fn is_total_known(func_id: Int) -> Int {
    if func_id == 0 { return 1; }
    if func_id == 3 { return 1; }
    return 0;
}

// 1 if the function id is known to be partial (not defined everywhere).
pub fn is_partial_known(func_id: Int) -> Int {
    if func_id == 1 { return 1; }
    if func_id == 2 { return 1; }
    return 0;
}

// 1 if the function is defined at x; 0 if not defined (partial at x).
pub fn is_total_for_input(func_id: Int, x: Int) -> Int {
    if func_id == 0 { return 1; }
    if func_id == 1 { if x < 0 { return 0; } return 1; }
    if func_id == 2 { if x == 0 { return 0; } return 1; }
    if func_id == 3 { return 1; }
    return 0;
}

// 1 if the function is defined for the first n_samples sample inputs.
// n_samples < 1 fails closed; n_samples > 5 fails closed (only 5 samples).
pub fn is_total_function(func_id: Int, n_samples: Int) -> Int {
    if n_samples < 1 { return 0; }
    if n_samples > 5 { return 0; }
    let mut i: Int = 0;
    let mut ok: Int = 1;
    while i < n_samples {
        let x: Int = sample_input(i);
        let d: Int = is_total_for_input(func_id, x);
        if d == 0 { ok = 0; }
        i = i + 1;
    }
    return ok;
}

// domain_cert wrapper for the total function theory lock.
pub fn total_theory_holds(func_id: Int, n_samples: Int) -> DomainCert {
    let v: Int = is_total_function(func_id, n_samples);
    return domain_cert("core", "total_function_theory", v);
}

pub fn verify_total_function_theory() -> Bool {
    // Golden: square and identity are known total.
    if is_total_known(0) != 1 { return false; }
    if is_total_known(3) != 1 { return false; }

    // Golden: sqrt and inverse are known partial.
    if is_partial_known(1) != 1 { return false; }
    if is_partial_known(2) != 1 { return false; }
    if is_total_known(1) != 0 { return false; }
    if is_total_known(2) != 0 { return false; }

    // Hostile: unknown function ids are not total.
    if is_total_known(99) != 0 { return false; }
    if is_total_known(0 - 1) != 0 { return false; }
    if is_partial_known(0) != 0 { return false; }

    // Golden: square is defined for every sampled input.
    if is_total_for_input(0, 0 - 100) != 1 { return false; }
    if is_total_for_input(0, 0) != 1 { return false; }
    if is_total_for_input(0, 100) != 1 { return false; }

    // Golden: sqrt is defined only for x >= 0.
    if is_total_for_input(1, 0) != 1 { return false; }
    if is_total_for_input(1, 1) != 1 { return false; }
    if is_total_for_input(1, 100) != 1 { return false; }

    // Hostile: sqrt is undefined for x < 0.
    if is_total_for_input(1, 0 - 1) != 0 { return false; }
    if is_total_for_input(1, 0 - 100) != 0 { return false; }

    // Golden: inverse is defined for x != 0.
    if is_total_for_input(2, 0 - 100) != 1 { return false; }
    if is_total_for_input(2, 0 - 1) != 1 { return false; }
    if is_total_for_input(2, 1) != 1 { return false; }
    if is_total_for_input(2, 100) != 1 { return false; }

    // Hostile: inverse is undefined at 0.
    if is_total_for_input(2, 0) != 0 { return false; }

    // Golden: identity is defined everywhere.
    if is_total_for_input(3, 0 - 100) != 1 { return false; }
    if is_total_for_input(3, 0) != 1 { return false; }
    if is_total_for_input(3, 100) != 1 { return false; }

    // Hostile: unknown func_id returns 0 for every input.
    if is_total_for_input(99, 0) != 0 { return false; }
    if is_total_for_input(99, 1) != 0 { return false; }

    // Closed: square is total over the full sample set.
    if is_total_function(0, 5) != 1 { return false; }
    if is_total_function(0, 1) != 1 { return false; }
    if is_total_function(0, 3) != 1 { return false; }

    // Closed: identity is total over the full sample set.
    if is_total_function(3, 5) != 1 { return false; }

    // Coupled: sqrt and inverse are not total (partial at one or more samples).
    if is_total_function(1, 5) != 0 { return false; }
    if is_total_function(2, 5) != 0 { return false; }

    // Coupled partial: a function that is total over a subset is not the same as total over the full set.
    if is_total_function(1, 1) != 1 { return false; }  // sample 0 = 1, sqrt defined
    if is_total_function(1, 2) != 1 { return false; }  // sample 1 = 0, sqrt defined
    if is_total_function(1, 3) != 0 { return false; }  // sample 2 = -1, sqrt undefined
    if is_total_function(2, 1) != 1 { return false; }  // sample 0 = 1, inverse defined
    if is_total_function(2, 2) != 0 { return false; }  // sample 1 = 0, inverse undefined
    if is_total_function(2, 3) != 0 { return false; }  // sample 2 = -1, inverse defined but earlier sample failed

    // Hostile: empty input domain fails closed to 0.
    if is_total_function(0, 0) != 0 { return false; }
    if is_total_function(3, 0) != 0 { return false; }
    if is_total_function(0, 0 - 1) != 0 { return false; }

    // Hostile: too many samples (only 5 available) fails closed.
    if is_total_function(0, 6) != 0 { return false; }
    if is_total_function(0, 100) != 0 { return false; }

    // Coupled: domain_cert boxes the value.
    let c1: DomainCert = total_theory_holds(0, 5);
    if c1.domain != "core" { return false; }
    if c1.law_name != "total_function_theory" { return false; }
    if c1.holds != 1 { return false; }
    let c2: DomainCert = total_theory_holds(1, 5);
    if c2.holds != 0 { return false; }

    return true;
}
