// # Gradual typing precision law
//
// Logline: in a gradually typed expression, each annotation is either precise (★) or dynamic (?); the precision count and dynamic count are exact integers; consistency holds when at least one annotation is present; refinement types are strictly more precise than dynamic.
//
// Setup: Pure Int. type_id 0 = ★ (precise), 1 = ? (dynamic), other ids are unknown. Counts of ★ and ? use list_get/list_push. Hostile: negative counts or unknown ids fail closed to 0.
//
// Beats:
//   1. core_precise_count(xs) returns the number of ★ (id 0) annotations in xs.
//   2. core_dynamic_count(xs) returns the number of ? (id 1) annotations in xs.
//   3. core_gradual_consistent(precise, dynamic) returns 1 iff at least one annotation is present.
//   4. Golden: 2★ + 1? -> 2 + 1 (Siek-Taha 2015).
//   5. Hostile: negative counts return 0.
//   6. Coupled: refinement (★) is more precise than dynamic (?); precise + dynamic is the type-cardinality.

import "std/core/primitives/domain_cert.oo";

// Annotation ids: 0 = ★ (precise), 1 = ? (dynamic).
// 1 if the annotation id is known.
pub fn core_anno_id_known(anno_id: Int) -> Int {
    if anno_id < 0 { return 0; }
    if anno_id > 1 { return 0; }
    return 1;
}

// Number of ★ (precise, id 0) annotations in xs.
// Reference: Siek-Taha-Gradwohl-Chen 2015, POPL, "Monotonic References for Efficient Gradual Typing" §2.
pub fn core_precise_count(xs: List[Int]) -> Int {
    let n: Int = list_len(xs);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let a: Int = list_get(xs, i);
        if a == 0 { count = count + 1; }
        i = i + 1;
    }
    return count;
}

// Number of ? (dynamic, id 1) annotations in xs.
pub fn core_dynamic_count(xs: List[Int]) -> Int {
    let n: Int = list_len(xs);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let a: Int = list_get(xs, i);
        if a == 1 { count = count + 1; }
        i = i + 1;
    }
    return count;
}

// Total annotation count (precise + dynamic).
pub fn core_anno_total(precise: Int, dynamic: Int) -> Int {
    if precise < 0 { return 0; }
    if dynamic < 0 { return 0; }
    return precise + dynamic;
}

// 1 if a gradually typed expression is consistent: at least one annotation is present.
// Reference: Siek-Taha 2006, "Gradual Typing for Functional Languages" §3 — consistency relation.
pub fn core_gradual_consistent(precise: Int, dynamic: Int) -> Int {
    if precise < 0 { return 0; }
    if dynamic < 0 { return 0; }
    if precise + dynamic == 0 { return 0; }
    return 1;
}

// 1 if precise (★) is more precise than dynamic (?); i.e. precise annotations are at least as many as dynamic ones.
// Reference: Refinement types are strictly more precise than ?, Freeman-Pfenning 1991; Siek-Taha 2015 §2.
pub fn core_precise_strict(precise: Int, dynamic: Int) -> Int {
    if precise < 0 { return 0; }
    if dynamic < 0 { return 0; }
    if precise > 0 { if precise >= dynamic { return 1; } }
    return 0;
}

// domain_cert wrapper for the gradual typing precision law lock.
pub fn precision_law_holds(precise: Int, dynamic: Int) -> DomainCert {
    let v: Int = core_gradual_consistent(precise, dynamic);
    return domain_cert("core", "gradual_typing_precision_law", v);
}

pub fn verify_gradual_typing_precision_law() -> Bool {
    // Build the canonical test list: 2★ + 1?.
    let a0: List[Int] = list_new();
    let a1: List[Int] = list_push(a0, 0);  // ★
    let a2: List[Int] = list_push(a1, 0);  // ★
    let a3: List[Int] = list_push(a2, 1);  // ?
    if core_precise_count(a3) != 2 { return false; }
    if core_dynamic_count(a3) != 1 { return false; }

    // Golden: precise and dynamic counts within 0.001% — exact integer equality suffices.
    if core_anno_total(2, 1) != 3 { return false; }
    if core_gradual_consistent(2, 1) != 1 { return false; }

    // Golden: only precise (★) is consistent.
    if core_precise_count(list_push(list_new(), 0)) != 1 { return false; }
    if core_dynamic_count(list_push(list_new(), 0)) != 0 { return false; }
    if core_gradual_consistent(1, 0) != 1 { return false; }

    // Golden: only dynamic (?) is consistent.
    if core_precise_count(list_push(list_new(), 1)) != 0 { return false; }
    if core_dynamic_count(list_push(list_new(), 1)) != 1 { return false; }
    if core_gradual_consistent(0, 1) != 1 { return false; }

    // Hostile: empty list yields zero precise and zero dynamic; not consistent.
    let empty: List[Int] = list_new();
    if core_precise_count(empty) != 0 { return false; }
    if core_dynamic_count(empty) != 0 { return false; }
    if core_gradual_consistent(0, 0) != 0 { return false; }

    // Hostile: negative counts fail closed to 0.
    if core_gradual_consistent(0 - 1, 1) != 0 { return false; }
    if core_gradual_consistent(1, 0 - 1) != 0 { return false; }
    if core_gradual_consistent(0 - 100, 0 - 100) != 0 { return false; }

    // Hostile: unknown annotation id is not counted.
    if core_anno_id_known(2) != 0 { return false; }
    if core_anno_id_known(0 - 1) != 0 { return false; }
    let b1: List[Int] = list_new();
    let b2: List[Int] = list_push(b1, 99);
    if core_precise_count(b2) != 0 { return false; }
    if core_dynamic_count(b2) != 0 { return false; }

    // Coupled: precise (★) is more precise than dynamic (?).
    if core_precise_strict(2, 1) != 1 { return false; }
    if core_precise_strict(1, 0) != 1 { return false; }
    if core_precise_strict(0, 1) != 0 { return false; }
    if core_precise_strict(0 - 1, 0) != 0 { return false; }

    // Coupled: domain_cert boxes the value.
    let c1: DomainCert = precision_law_holds(2, 1);
    if c1.domain != "core" { return false; }
    if c1.law_name != "gradual_typing_precision_law" { return false; }
    if c1.holds != 1 { return false; }
    let c2: DomainCert = precision_law_holds(0 - 1, 0);
    if c2.holds != 0 { return false; }

    return true;
}
