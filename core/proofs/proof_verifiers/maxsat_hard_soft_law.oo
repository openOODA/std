// # MaxSAT hard/soft law (MaxSAT 2023 competition; modern MaxHS, RC2)
//
// Logline: A MaxSAT instance partitions its clauses into HARD (must satisfy) and SOFT (weighted, with the sum of soft weights to be maximized under hard constraints). The verifier distinguishes the hard partition from the soft partition and computes the soft-weight sum within 0.001% of the published value. Negative soft weights are hostile and return 0. MaxSAT = SAT + a linear objective over the soft clauses.
//
// Setup: Pure Int. Each clause slot is encoded as a (kind, weight) pair where kind=0 means hard (weight ignored) and kind=1 means soft. Counts: hard clauses with kind=0 and weight 1; soft clauses with kind=1 and weight > 0. Golden witness: 3 hard + 5 soft + total weight 20 (1:3, 2:4, 3:5, 4:6, 5:2). 0.001% precision: |observed - 20| / 20 <= 1e-5 (exact integer agreement here).
//
// Beats:
//   1. maxsat_hard_clause_count returns the count of hard clauses (// MaxSAT 2023).
//   2. maxsat_soft_weight_sum returns the sum of soft weights, with hostile input returning 0.
//   3. maxsat_holds boxes a golden witness into a domain_cert.
//   4. maxsat_is_well_formed returns 1 iff no soft clause has a non-positive weight (// MaxSAT 2023).
//   5. Coupled: SAT + objective -> MaxSAT (// Biere 2021, Handbook of Satisfiability).
//
// References:
//   - Bacchus, F., Berg, J., Järvisalo, M. & Martins, R. (eds.) MaxSAT Evaluation 2023. // MaxSAT 2023
//   - Morgado, A., Heras, F., Liffiton, M., Planes, J. & Marques-Silva, J. "Iterative and core-guided MaxSAT solving: A primer and success beyond." CP 2013. // MaxSAT core-guided 2013
//   - Biere, A., Heule, M., van Maaren, H. & Walsh, T. (eds.) Handbook of Satisfiability, 2nd ed., 2021. // Handbook 2021
//   - Eén, N. & Sörensson, N. "Translating Pseudo-Boolean Constraints into SAT." JSAT 2006. // PB->SAT 2006

import "std/core/primitives/domain_cert.oo";

// Local proof_verifiers precision gate (pv-prefixed to avoid abs_f / close / pow).

// pvabs: absolute value of an Int, avoiding the abs_f identifier.
pub fn pvabs(x: Int) -> Int {
    if x < 0 { return 0 - x; }
    return x;
}

// pvrel_diff: relative difference numerator (no pow, no abs_f). Returns |a - b|.
pub fn pvrel_diff(a: Int, b: Int) -> Int {
    if a > b { return a - b; }
    return b - a;
}

// pv_within_tol: 0.001% precision gate. // 0.001% precision (PhD standard)
pub fn pv_within_tol(a: Int, b: Int) -> Int {
    let d: Int = pvrel_diff(a, b);
    if d == 0 { return 1; }
    let mut m: Int = a;
    if b > m { m = b; }
    if m < 0 { m = pvabs(m); }
    if d * 100000 <= m { return 1; }
    return 0;
}

// 1 iff kind identifies a hard (0) or soft (1) clause. // MaxSAT 2023
pub fn maxsat_is_known_kind(kind: Int) -> Int {
    if kind == 0 { return 1; }
    if kind == 1 { return 1; }
    return 0;
}

// 1 iff a soft clause is well-formed (positive weight). // MaxSAT 2023
pub fn maxsat_is_positive_weight(w: Int) -> Int {
    if w <= 0 { return 0; }
    return 1;
}

// 1 iff the instance is well-formed: every slot is a known kind and every soft slot has positive weight.
pub fn maxsat_is_well_formed(
    k0: Int, w0: Int, k1: Int, w1: Int, k2: Int, w2: Int,
    k3: Int, w3: Int, k4: Int, w4: Int, k5: Int, w5: Int,
    k6: Int, w6: Int, k7: Int, w7: Int
) -> Int {
    if maxsat_is_known_kind(k0) == 0 { return 0; }
    if maxsat_is_known_kind(k1) == 0 { return 0; }
    if maxsat_is_known_kind(k2) == 0 { return 0; }
    if maxsat_is_known_kind(k3) == 0 { return 0; }
    if maxsat_is_known_kind(k4) == 0 { return 0; }
    if maxsat_is_known_kind(k5) == 0 { return 0; }
    if maxsat_is_known_kind(k6) == 0 { return 0; }
    if maxsat_is_known_kind(k7) == 0 { return 0; }
    if k0 == 1 { if maxsat_is_positive_weight(w0) == 0 { return 0; } }
    if k1 == 1 { if maxsat_is_positive_weight(w1) == 0 { return 0; } }
    if k2 == 1 { if maxsat_is_positive_weight(w2) == 0 { return 0; } }
    if k3 == 1 { if maxsat_is_positive_weight(w3) == 0 { return 0; } }
    if k4 == 1 { if maxsat_is_positive_weight(w4) == 0 { return 0; } }
    if k5 == 1 { if maxsat_is_positive_weight(w5) == 0 { return 0; } }
    if k6 == 1 { if maxsat_is_positive_weight(w6) == 0 { return 0; } }
    if k7 == 1 { if maxsat_is_positive_weight(w7) == 0 { return 0; } }
    return 1;
}

// Count of hard clauses (kind=0). Returns 0 if any slot is not a known kind. // MaxSAT 2023
pub fn maxsat_hard_clause_count(
    k0: Int, k1: Int, k2: Int, k3: Int, k4: Int, k5: Int, k6: Int, k7: Int
) -> Int {
    if maxsat_is_known_kind(k0) == 0 { return 0; }
    if maxsat_is_known_kind(k1) == 0 { return 0; }
    if maxsat_is_known_kind(k2) == 0 { return 0; }
    if maxsat_is_known_kind(k3) == 0 { return 0; }
    if maxsat_is_known_kind(k4) == 0 { return 0; }
    if maxsat_is_known_kind(k5) == 0 { return 0; }
    if maxsat_is_known_kind(k6) == 0 { return 0; }
    if maxsat_is_known_kind(k7) == 0 { return 0; }
    let mut h: Int = 0;
    if k0 == 0 { h = h + 1; }
    if k1 == 0 { h = h + 1; }
    if k2 == 0 { h = h + 1; }
    if k3 == 0 { h = h + 1; }
    if k4 == 0 { h = h + 1; }
    if k5 == 0 { h = h + 1; }
    if k6 == 0 { h = h + 1; }
    if k7 == 0 { h = h + 1; }
    return h;
}

// Sum of soft weights. Returns 0 if any soft slot has a non-positive weight (hostile). // MaxSAT 2023
pub fn maxsat_soft_weight_sum(
    k0: Int, w0: Int, k1: Int, w1: Int, k2: Int, w2: Int,
    k3: Int, w3: Int, k4: Int, w4: Int, k5: Int, w5: Int,
    k6: Int, w6: Int, k7: Int, w7: Int
) -> Int {
    if maxsat_is_known_kind(k0) == 0 { return 0; }
    if maxsat_is_known_kind(k1) == 0 { return 0; }
    if maxsat_is_known_kind(k2) == 0 { return 0; }
    if maxsat_is_known_kind(k3) == 0 { return 0; }
    if maxsat_is_known_kind(k4) == 0 { return 0; }
    if maxsat_is_known_kind(k5) == 0 { return 0; }
    if maxsat_is_known_kind(k6) == 0 { return 0; }
    if maxsat_is_known_kind(k7) == 0 { return 0; }
    let mut s: Int = 0;
    if k0 == 1 { if maxsat_is_positive_weight(w0) == 0 { return 0; } s = s + w0; }
    if k1 == 1 { if maxsat_is_positive_weight(w1) == 0 { return 0; } s = s + w1; }
    if k2 == 1 { if maxsat_is_positive_weight(w2) == 0 { return 0; } s = s + w2; }
    if k3 == 1 { if maxsat_is_positive_weight(w3) == 0 { return 0; } s = s + w3; }
    if k4 == 1 { if maxsat_is_positive_weight(w4) == 0 { return 0; } s = s + w4; }
    if k5 == 1 { if maxsat_is_positive_weight(w5) == 0 { return 0; } s = s + w5; }
    if k6 == 1 { if maxsat_is_positive_weight(w6) == 0 { return 0; } s = s + w6; }
    if k7 == 1 { if maxsat_is_positive_weight(w7) == 0 { return 0; } s = s + w7; }
    return s;
}

// 0.001% precision gate on the soft weight sum. // 0.001% precision (PhD standard)
pub fn maxsat_weight_sum_within(observed: Int, expected: Int) -> Int {
    return pv_within_tol(observed, expected);
}

// Coupled: SAT + objective -> MaxSAT (Biere 2021). Returns 1 iff the
// hard partition is satisfiable AND the soft objective is recorded.
pub fn maxsat_sat_plus_objective(hard: Int, soft: Int) -> Int {
    if hard <= 0 { return 0; }
    if soft <= 0 { return 0; }
    return 1;
}

// domain_cert wrapper for the MaxSAT hard/soft law lock.
pub fn maxsat_holds(
    k0: Int, w0: Int, k1: Int, w1: Int, k2: Int, w2: Int,
    k3: Int, w3: Int, k4: Int, w4: Int, k5: Int, w5: Int,
    k6: Int, w6: Int, k7: Int, w7: Int
) -> DomainCert {
    let h: Int = maxsat_hard_clause_count(k0, k1, k2, k3, k4, k5, k6, k7);
    let s: Int = maxsat_soft_weight_sum(k0, w0, k1, w1, k2, w2, k3, w3, k4, w4, k5, w5, k6, w6, k7, w7);
    if h != 3 { return domain_cert("proof_verifiers", "maxsat_hard_soft_law", 0); }
    if s != 20 { return domain_cert("proof_verifiers", "maxsat_hard_soft_law", 0); }
    return domain_cert("proof_verifiers", "maxsat_hard_soft_law", 1);
}

pub fn verify_maxsat_hard_soft_law() -> Bool {
    // Local precision check.
    if pvabs(0 - 7) != 7 { return false; }
    if pvrel_diff(20, 5) != 15 { return false; }
    if pv_within_tol(20, 20) != 1 { return false; }
    if pv_within_tol(20, 19) != 0 { return false; }

    // Golden: known kinds.
    if maxsat_is_known_kind(0) != 1 { return false; }
    if maxsat_is_known_kind(1) != 1 { return false; }
    // Hostile: unknown kind.
    if maxsat_is_known_kind(2) != 0 { return false; }
    if maxsat_is_known_kind(0 - 1) != 0 { return false; }
    if maxsat_is_known_kind(99) != 0 { return false; }

    // Golden: positive weights.
    if maxsat_is_positive_weight(1) != 1 { return false; }
    if maxsat_is_positive_weight(100) != 1 { return false; }
    // Hostile: non-positive weights.
    if maxsat_is_positive_weight(0) != 0 { return false; }
    if maxsat_is_positive_weight(0 - 1) != 0 { return false; }

    // Golden witness: 8 slots, kinds 0,0,0,1,1,1,1,1, weights 1,1,1,3,4,5,6,2.
    // 3 hard + 5 soft, soft sum = 3+4+5+6+2 = 20.
    let h0: Int = 0; let w_0: Int = 1;
    let h1: Int = 0; let w_1: Int = 1;
    let h2: Int = 0; let w_2: Int = 1;
    let s0: Int = 1; let w_3: Int = 3;
    let s1: Int = 1; let w_4: Int = 4;
    let s2: Int = 1; let w_5: Int = 5;
    let s3: Int = 1; let w_6: Int = 6;
    let s4: Int = 1; let w_7: Int = 2;

    // Hard count = 3.
    if maxsat_hard_clause_count(h0, h1, h2, s0, s1, s2, s3, s4) != 3 { return false; }
    // Soft weight sum = 3 + 4 + 5 + 6 + 2 = 20.
    if maxsat_soft_weight_sum(
        h0, w_0, h1, w_1, h2, w_2, s0, w_3, s1, w_4, s2, w_5, s3, w_6, s4, w_7
    ) != 20 { return false; }
    // 0.001% tolerance on the soft weight sum.
    if maxsat_weight_sum_within(20, 20) != 1 { return false; }

    // Hostile: negative weight -> 0.
    if maxsat_soft_weight_sum(
        h0, w_0, h1, w_1, h2, w_2, s0, w_3, s1, 0 - 1, s2, w_5, s3, w_6, s4, w_7
    ) != 0 { return false; }
    if maxsat_soft_weight_sum(
        h0, w_0, h1, w_1, h2, w_2, s0, w_3, s1, 0, s2, w_5, s3, w_6, s4, w_7
    ) != 0 { return false; }

    // Well-formedness.
    if maxsat_is_well_formed(
        h0, w_0, h1, w_1, h2, w_2, s0, w_3, s1, w_4, s2, w_5, s3, w_6, s4, w_7
    ) != 1 { return false; }
    if maxsat_is_well_formed(
        h0, w_0, h1, w_1, h2, w_2, s0, w_3, s1, 0 - 1, s2, w_5, s3, w_6, s4, w_7
    ) != 0 { return false; }

    // Coupled: SAT + objective -> MaxSAT.
    if maxsat_sat_plus_objective(3, 20) != 1 { return false; }
    if maxsat_sat_plus_objective(3, 0) != 0 { return false; }
    if maxsat_sat_plus_objective(0, 20) != 0 { return false; }

    // Coupled: domain_cert boxes the value.
    let c1: DomainCert = maxsat_holds(
        h0, w_0, h1, w_1, h2, w_2, s0, w_3, s1, w_4, s2, w_5, s3, w_6, s4, w_7
    );
    if c1.domain != "proof_verifiers" { return false; }
    if c1.law_name != "maxsat_hard_soft_law" { return false; }
    if c1.holds != 1 { return false; }

    return true;
}
