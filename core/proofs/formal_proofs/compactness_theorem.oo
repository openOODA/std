// # Compactness theorem of first-order logic (Godel, Malcev, 1930s)
//
// Logline: A first-order theory T is satisfiable iff every finite subset of T is satisfiable. Ideal case: countable T via Konig's lemma. Non-ideal case: uncountable T with the axiom of choice.
//
// Setup: Pure Int. A 4-clause theory is encoded as a list of truth values (1=true, 0=false). A finite subset is represented by a 4-bit inclusion mask (1=keep, 0=drop). The sub-theory is satisfiable iff at least one kept clause is true. Hostile: empty mask means empty sub-theory (vacuously true). The 4-clause theory is satisfiable iff any clause is true.
//
// Beats:
//   1. theory_subset_sat checks a single sub-theory for satisfiability.
//   2. theory_all_finite_sat checks every non-empty sub-theory (2^4 - 1 of them).
//   3. theory_sat returns 1 iff the theory is satisfiable.
//   4. Ideal (countable): satisfiable ⇔ every finite subset is satisfiable.
//   5. Non-ideal (uncountable): same witness for the countable certificate.
//   6. Coupled: consistent theory has a model (completeness + compactness).

import "std/core/primitives/domain_cert.oo";

// 1 iff at least one kept clause is true. mask_i = 1 means "include clause i".
// mask=0 for all slots means the empty sub-theory, which is vacuously true (1).
pub fn theory_subset_sat(
    c0: Int, c1: Int, c2: Int, c3: Int,
    m0: Int, m1: Int, m2: Int, m3: Int
) -> Int {
    let mut any_kept: Int = 0;
    if m0 == 1 {
        if c0 == 1 { any_kept = 1; }
    }
    if m1 == 1 {
        if c1 == 1 { any_kept = 1; }
    }
    if m2 == 1 {
        if c2 == 1 { any_kept = 1; }
    }
    if m3 == 1 {
        if c3 == 1 { any_kept = 1; }
    }
    // Empty sub-theory: vacuously satisfiable.
    if m0 == 0 {
        if m1 == 0 {
            if m2 == 0 {
                if m3 == 0 { return 1; }
            }
        }
    }
    if any_kept == 1 { return 1; }
    return 0;
}

// Enumerate every non-empty subset of the in-theory clause indices and check
// each sub-theory for satisfiability. A clause ci=1 means "in the theory and
// satisfiable" (it is a witness in the chosen model). A sub-theory T_S is
// satisfiable iff every clause in S is satisfiable (ci=1 for all i in S).
// Returns 1 iff every non-empty finite subset of the in-theory clauses is sat.
// Equivalent to: at least one clause is in the theory.
pub fn theory_all_finite_sat(c0: Int, c1: Int, c2: Int, c3: Int) -> Int {
    let mut any_clause: Int = 0;
    if c0 == 1 { any_clause = 1; }
    if c1 == 1 { any_clause = 1; }
    if c2 == 1 { any_clause = 1; }
    if c3 == 1 { any_clause = 1; }
    if any_clause == 0 { return 0; }
    // Every non-empty sub-theory of a non-empty theory of satisfied clauses
    // is also satisfiable (the same model witnesses each sub-theory).
    return 1;
}

// 1 iff the theory is satisfiable (at least one clause is true).
// By compactness, this is equivalent to "every non-empty finite subset is sat".
pub fn theory_sat(c0: Int, c1: Int, c2: Int, c3: Int) -> Int {
    if c0 == 1 { return 1; }
    if c1 == 1 { return 1; }
    if c2 == 1 { return 1; }
    if c3 == 1 { return 1; }
    return 0;
}

// 1 iff the encoding is consistent (no clause is malformed).
// Coupled with compactness: consistent theory has a model.
pub fn theory_consistent(c0: Int, c1: Int, c2: Int, c3: Int) -> Int {
    if c0 != 0 {
        if c0 != 1 { return 0; }
    }
    if c1 != 0 {
        if c1 != 1 { return 0; }
    }
    if c2 != 0 {
        if c2 != 1 { return 0; }
    }
    if c3 != 0 {
        if c3 != 1 { return 0; }
    }
    return 1;
}

// Ideal (countable) compactness: 1 iff the theory satisfies the compactness
// certificate (every finite subset sat ⇒ whole theory sat). For the 4-clause
// witness this collapses to theory_sat.
pub fn compactness_ideal(c0: Int, c1: Int, c2: Int, c3: Int) -> Int {
    let finite: Int = theory_all_finite_sat(c0, c1, c2, c3);
    let whole: Int = theory_sat(c0, c1, c2, c3);
    if finite == 1 {
        if whole == 1 { return 1; }
    }
    return 0;
}

// Non-ideal (uncountable) compactness: same certificate as the ideal case for
// the countable witness. The uncountable extension requires the axiom of
// choice; the verifier just records the countable certificate.
pub fn compactness_nonideal(c0: Int, c1: Int, c2: Int, c3: Int) -> Int {
    return compactness_ideal(c0, c1, c2, c3);
}

// Coupled: consistent theory has a model.
pub fn compactness_coupled(c0: Int, c1: Int, c2: Int, c3: Int) -> Int {
    let con: Int = theory_consistent(c0, c1, c2, c3);
    let sat: Int = theory_sat(c0, c1, c2, c3);
    if con == 1 {
        if sat == 1 { return 1; }
    }
    return 0;
}

// domain_cert wrapper for the compactness theorem lock.
pub fn compactness_holds(c0: Int, c1: Int, c2: Int, c3: Int) -> DomainCert {
    let v: Int = theory_sat(c0, c1, c2, c3);
    return domain_cert("formal_proofs", "compactness_theorem", v);
}

pub fn verify_compactness_theorem() -> Bool {
    // Golden: every non-empty finite subset of {¬P ∨ Q, P} is satisfiable.
    // P=true, Q=true satisfies both clauses.
    if theory_subset_sat(1, 1, 0, 0, 1, 1, 0, 0) != 1 { return false; }
    if theory_subset_sat(1, 1, 0, 0, 1, 0, 0, 0) != 1 { return false; }
    if theory_subset_sat(1, 1, 0, 0, 0, 1, 0, 0) != 1 { return false; }
    if theory_subset_sat(1, 1, 0, 0, 1, 1, 1, 1) != 1 { return false; }

    // Golden: full theory {¬P ∨ Q, P} is satisfiable.
    if theory_sat(1, 1, 0, 0) != 1 { return false; }

    // Golden: trivial theories are satisfiable.
    if theory_sat(1, 0, 0, 0) != 1 { return false; }
    if theory_sat(0, 1, 0, 0) != 1 { return false; }
    if theory_sat(0, 0, 1, 0) != 1 { return false; }
    if theory_sat(0, 0, 0, 1) != 1 { return false; }

    // Golden: all four clauses true is satisfiable.
    if theory_sat(1, 1, 1, 1) != 1 { return false; }

    // Golden: every non-empty finite subset of the all-1 theory is satisfiable.
    if theory_all_finite_sat(1, 1, 1, 1) != 1 { return false; }

    // Golden: every non-empty finite subset of the {¬P ∨ Q, P} theory is sat.
    if theory_all_finite_sat(1, 1, 0, 0) != 1 { return false; }

    // Golden: 3-of-4 true witnesses are satisfiable.
    if theory_sat(1, 1, 1, 0) != 1 { return false; }
    if theory_sat(0, 1, 1, 1) != 1 { return false; }

    // Hostile: empty theory (no true clause anywhere) is unsatisfiable.
    if theory_sat(0, 0, 0, 0) != 0 { return false; }
    if theory_all_finite_sat(0, 0, 0, 0) != 0 { return false; }

    // Hostile: empty sub-theory is vacuously true.
    if theory_subset_sat(0, 0, 0, 0, 0, 0, 0, 0) != 1 { return false; }
    if theory_subset_sat(1, 1, 1, 1, 0, 0, 0, 0) != 1 { return false; }

    // Hostile: sub-theory containing only false clauses is unsat.
    if theory_subset_sat(0, 0, 0, 0, 1, 0, 0, 0) != 0 { return false; }
    if theory_subset_sat(0, 0, 0, 0, 0, 1, 1, 1) != 0 { return false; }

    // Golden: 3-of-4 subset sat for the right theories.
    if theory_subset_sat(1, 1, 1, 0, 1, 1, 1, 0) != 1 { return false; }

    // Ideal: compactness_ideal collapses to (theory_all_finite_sat ⇒ theory_sat).
    if compactness_ideal(1, 1, 0, 0) != 1 { return false; }
    if compactness_ideal(0, 0, 0, 0) != 0 { return false; }
    if compactness_ideal(1, 0, 1, 0) != 1 { return false; }

    // Non-ideal: same witness.
    if compactness_nonideal(1, 1, 0, 0) != 1 { return false; }
    if compactness_nonideal(0, 0, 0, 0) != 0 { return false; }

    // Consistency.
    if theory_consistent(1, 0, 0, 0) != 1 { return false; }
    if theory_consistent(1, 1, 1, 1) != 1 { return false; }

    // Hostile: garbage values for consistency.
    if theory_consistent(2, 0, 0, 0) != 0 { return false; }
    if theory_consistent(0, 0 - 1, 0, 0) != 0 { return false; }

    // Coupled: consistent implies satisfiable for valid encodings.
    if compactness_coupled(1, 1, 0, 0) != 1 { return false; }
    if compactness_coupled(0, 0, 0, 0) != 0 { return false; }
    if compactness_coupled(2, 0, 0, 0) != 0 { return false; }

    // Coupled: domain_cert boxes the value.
    let c1: DomainCert = compactness_holds(1, 1, 0, 0);
    if c1.domain != "formal_proofs" { return false; }
    if c1.law_name != "compactness_theorem" { return false; }
    if c1.holds != 1 { return false; }
    let c2: DomainCert = compactness_holds(0, 0, 0, 0);
    if c2.holds != 0 { return false; }

    return true;
}
