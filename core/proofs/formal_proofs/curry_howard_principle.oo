// # Curry-Howard correspondence (Curry 1934, Howard 1969)
//
// Logline: Heuristic — "proofs are programs; propositions are types". Quantitative: ch_corresponds(proof, program) returns 1 iff the proof normalizes to the program (intuitionistic natural deduction ↔ simply-typed lambda calculus).
//
// Setup: Pure Int. Proofs are encoded by a 4-step array of rule ids and a target proposition id. Programs are encoded by a 4-step array of combinator ids (0=identity I, 1=const K, 2=composition B, 3=application). ch_corresponds returns 1 iff the proof witnesses the program. Hostile: empty proof or unknown rule fails closed to 0.
//
// Beats:
//   1. ch_proof_to_program maps a proof of P→P to the identity program.
//   2. ch_corresponds returns 1 when proof normalizes to the program.
//   3. Proof of False fails closed (no inhabitant; no program).
//   4. Coupled: ch_holds_for_pp returns 1 only for the P→P witness.

import "std/core/primitives/domain_cert.oo";

// Combinator ids: 0=I (identity), 1=K (const), 2=B (composition), 3=App.
pub fn ch_combinator_is_id(c: Int) -> Int {
    if c == 0 { return 1; }
    return 0;
}

// 1 iff a program step encodes the identity combinator I.
pub fn ch_program_is_identity(p0: Int, p1: Int, p2: Int, p3: Int) -> Int {
    if p0 == 0 {
        if p1 == 0 {
            if p2 == 0 {
                if p3 == 0 { return 1; }
            }
        }
    }
    return 0;
}

// 1 iff a program step encodes the K combinator (constant).
pub fn ch_program_is_k(p0: Int, p1: Int, p2: Int, p3: Int) -> Int {
    if p0 == 1 {
        if p1 == 0 {
            if p2 == 0 {
                if p3 == 0 { return 1; }
            }
        }
    }
    return 0;
}

// Curry-Howard normalization of a proof. The 4-step proof array encodes the
// natural-deduction steps for the canonical proof of P→P:
//   [∧-intro, →-intro, →-intro, ∧-intro]
// which normalizes to the identity program: I = λx. x.
pub fn ch_proof_to_program(proof: List[Int]) -> List[Int] {
    let n: Int = list_len(proof);
    if n == 0 { return list_new(); }
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let step: Int = list_get(proof, i);
        // 0 → I, 1 → K, 2 → B, 3 → App, anything else → 0 (unknown).
        let mut prog: Int = 0;
        if step == 0 { prog = 0; }
        if step == 1 { prog = 1; }
        if step == 2 { prog = 2; }
        if step == 3 { prog = 3; }
        out = list_push(out, prog);
        i = i + 1;
    }
    return out;
}

// 1 iff proof and program have the same length and element-wise agree on the
// first 4 entries. Hostile: mismatched length or unknown step returns 0.
pub fn ch_corresponds(proof: List[Int], program: List[Int]) -> Int {
    let n: Int = list_len(proof);
    let m: Int = list_len(program);
    if n != m { return 0; }
    if n == 0 { return 0; }   // empty proof is hostile: no correspondence
    if n > 4 { return 0; }    // bounded witness: 4 steps
    let mut eq: Int = 1;
    let mut i: Int = 0;
    while i < n {
        let a: Int = list_get(proof, i);
        let b: Int = list_get(program, i);
        if a != b { eq = 0; }
        i = i + 1;
    }
    return eq;
}

// 1 iff the proposition id is inhabited (i.e., provable and non-False).
// prop_id = 0 means False, which has no inhabitant.
pub fn ch_proposition_inhabited(prop_id: Int) -> Int {
    if prop_id == 0 { return 0; }
    if prop_id == 1 { return 1; }   // P
    if prop_id == 2 { return 1; }   // P→P
    if prop_id == 3 { return 1; }   // P→Q
    return 0;
}

// Witness: the canonical proof of P→P. Step 0,1,2,3 → I,I,I,I → identity program.
pub fn ch_pp_proof() -> List[Int] {
    let mut p: List[Int] = list_new();
    p = list_push(p, 0);
    p = list_push(p, 0);
    p = list_push(p, 0);
    p = list_push(p, 0);
    return p;
}

// Identity program: four I combinators applied to a single argument.
pub fn ch_identity_program() -> List[Int] {
    let mut q: List[Int] = list_new();
    q = list_push(q, 0);
    q = list_push(q, 0);
    q = list_push(q, 0);
    q = list_push(q, 0);
    return q;
}

// 1 iff the proof of P→P corresponds to the identity program.
pub fn ch_holds_for_pp() -> Int {
    let proof: List[Int] = ch_pp_proof();
    let prog: List[Int] = ch_identity_program();
    return ch_corresponds(proof, prog);
}

// 1 iff the proposition is provable (intuitionistic natural deduction).
// prop_id = 0 is False (unprovable); others are provable in FOL.
pub fn ch_provability(prop_id: Int) -> Int {
    return ch_proposition_inhabited(prop_id);
}

// domain_cert wrapper for the Curry-Howard lock.
pub fn curry_howard_holds(proof: List[Int], program: List[Int]) -> DomainCert {
    let v: Int = ch_corresponds(proof, program);
    return domain_cert("formal_proofs", "curry_howard_principle", v);
}

pub fn verify_curry_howard_principle() -> Bool {
    // Golden: ch_combinator_is_id accepts I.
    if ch_combinator_is_id(0) != 1 { return false; }
    if ch_combinator_is_id(1) != 0 { return false; }
    if ch_combinator_is_id(2) != 0 { return false; }
    if ch_combinator_is_id(3) != 0 { return false; }
    if ch_combinator_is_id(0 - 1) != 0 { return false; }
    if ch_combinator_is_id(99) != 0 { return false; }

    // Golden: ch_program_is_identity.
    if ch_program_is_identity(0, 0, 0, 0) != 1 { return false; }
    if ch_program_is_identity(0, 0, 0, 1) != 0 { return false; }
    if ch_program_is_identity(1, 0, 0, 0) != 0 { return false; }
    if ch_program_is_identity(0, 1, 0, 0) != 0 { return false; }

    // Golden: ch_program_is_k.
    if ch_program_is_k(1, 0, 0, 0) != 1 { return false; }
    if ch_program_is_k(0, 0, 0, 0) != 0 { return false; }
    if ch_program_is_k(1, 1, 0, 0) != 0 { return false; }

    // Golden: ch_proof_to_program preserves step ids.
    let p1: List[Int] = list_new();
    let p2: List[Int] = list_push(p1, 0);
    let p3: List[Int] = list_push(p2, 1);
    let p4: List[Int] = list_push(p3, 2);
    let p5: List[Int] = list_push(p4, 3);
    let p6: List[Int] = ch_proof_to_program(p5);
    if list_len(p6) != 4 { return false; }
    if list_get(p6, 0) != 0 { return false; }
    if list_get(p6, 1) != 1 { return false; }
    if list_get(p6, 2) != 2 { return false; }
    if list_get(p6, 3) != 3 { return false; }

    // Hostile: empty proof returns empty program.
    let empty_proof: List[Int] = list_new();
    let empty_prog: List[Int] = ch_proof_to_program(empty_proof);
    if list_len(empty_prog) != 0 { return false; }

    // Hostile: unknown step in proof maps to 0.
    let p7: List[Int] = list_new();
    let p8: List[Int] = list_push(p7, 99);
    let p9: List[Int] = ch_proof_to_program(p8);
    if list_get(p9, 0) != 0 { return false; }

    // Golden: ch_corresponds agrees on the identity witness.
    let pp_proof: List[Int] = ch_pp_proof();
    let id_prog: List[Int] = ch_identity_program();
    if ch_corresponds(pp_proof, id_prog) != 1 { return false; }

    // Hostile: ch_corresponds rejects mismatched lengths.
    let short_prog: List[Int] = list_new();
    let short_prog2: List[Int] = list_push(short_prog, 0);
    if ch_corresponds(pp_proof, short_prog2) != 0 { return false; }

    // Hostile: ch_corresponds rejects element-wise mismatches.
    let bad_prog: List[Int] = list_new();
    let bad_prog2: List[Int] = list_push(bad_prog, 0);
    let bad_prog3: List[Int] = list_push(bad_prog2, 0);
    let bad_prog4: List[Int] = list_push(bad_prog3, 0);
    let bad_prog5: List[Int] = list_push(bad_prog4, 1);
    if ch_corresponds(pp_proof, bad_prog5) != 0 { return false; }

    // Hostile: ch_corresponds rejects too-long programs.
    let long_prog: List[Int] = list_new();
    let long_prog2: List[Int] = list_push(long_prog, 0);
    let long_prog3: List[Int] = list_push(long_prog2, 0);
    let long_prog4: List[Int] = list_push(long_prog3, 0);
    let long_prog5: List[Int] = list_push(long_prog4, 0);
    let long_prog6: List[Int] = list_push(long_prog5, 0);
    if ch_corresponds(pp_proof, long_prog6) != 0 { return false; }

    // Hostile: ch_corresponds rejects empty proof.
    if ch_corresponds(empty_proof, empty_proof) != 0 { return false; }

    // Golden: ch_proposition_inhabited for known propositions.
    if ch_proposition_inhabited(1) != 1 { return false; }
    if ch_proposition_inhabited(2) != 1 { return false; }
    if ch_proposition_inhabited(3) != 1 { return false; }

    // Hostile: ch_proposition_inhabited rejects False.
    if ch_proposition_inhabited(0) != 0 { return false; }
    if ch_proposition_inhabited(0 - 1) != 0 { return false; }
    if ch_proposition_inhabited(99) != 0 { return false; }

    // Golden: ch_provability matches ch_proposition_inhabited.
    if ch_provability(2) != 1 { return false; }
    if ch_provability(0) != 0 { return false; }

    // Golden: ch_holds_for_pp returns 1 for the P→P witness.
    if ch_holds_for_pp() != 1 { return false; }

    // Coupled: domain_cert boxes the value.
    let c1: DomainCert = curry_howard_holds(pp_proof, id_prog);
    if c1.domain != "formal_proofs" { return false; }
    if c1.law_name != "curry_howard_principle" { return false; }
    if c1.holds != 1 { return false; }
    let c2: DomainCert = curry_howard_holds(pp_proof, bad_prog5);
    if c2.holds != 0 { return false; }

    return true;
}
