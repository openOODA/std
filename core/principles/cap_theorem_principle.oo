// # CAP theorem (Brewer, 2000)
//
// Logline: A distributed system under network partition cannot simultaneously guarantee Consistency, Availability, and Partition-tolerance; at most two of the three may be claimed at once.
//
// Setup: Pure Int flags C, A, P in {0,1}. Illegal flags Err. Valid flags may Ok(0) when C+A is unavailable (including CAP all-three).
//
// Beats:
//   1. cap_consistency_availability_score returns 1 when both C and A are claimed with no partition.
//   2. cap_partition_sacrifice returns the property sacrificed under partition (exactly one of C/A).
//   3. claim_three_all -> Ok(0) (cannot satisfy all three at once).
//   4. Hostile claims outside {0,1} return Err; cert holds==0.

import "std/core/primitives/domain_cert.oo";

fn cap_flags_ok(claim_c: Int, claim_a: Int, claim_p: Int) -> Int {
    if claim_c != 0 { if claim_c != 1 { return 0; } }
    if claim_a != 0 { if claim_a != 1 { return 0; } }
    if claim_p != 0 { if claim_p != 1 { return 0; } }
    return 1;
}

fn cap_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

pub fn cap_score(claim_c: Int, claim_a: Int, claim_p: Int) -> Result[Float, String] {
    if cap_flags_ok(claim_c, claim_a, claim_p) != 1 { return Err("ERR\tcap\tflags"); }
    if claim_p == 0 {
        if claim_c == 1 {
            if claim_a == 1 {
                return Ok(1.0);
            }
        }
        return Ok(0.0);
    }
    let mut c_count: Int = 0;
    if claim_c == 1 { c_count = c_count + 1; }
    if claim_a == 1 { c_count = c_count + 1; }
    if c_count == 2 { return Ok(0.0); }
    if c_count == 1 { return Ok(0.5); }
    return Ok(0.0);
}

pub fn cap_consistency_availability_score(claim_c: Int, claim_a: Int, claim_p: Int) -> Result[Float, String] {
    return cap_score(claim_c, claim_a, claim_p);
}

// Encoded as Int: 0=none, 1=consistency, 2=availability, 3=invalid.
pub fn cap_sacrifice_code(claim_c: Int, claim_a: Int, claim_p: Int) -> Int {
    if cap_flags_ok(claim_c, claim_a, claim_p) != 1 { return 3; }
    if claim_p == 0 { return 0; }
    if claim_c == 1 {
        if claim_a == 1 { return 3; }
    }
    if claim_c == 0 {
        if claim_a == 0 { return 3; }
    }
    if claim_c == 1 { return 2; }
    return 1;
}

pub fn cap_partition_sacrifice(claim_c: Int, claim_a: Int, claim_p: Int) -> String {
    let code: Int = cap_sacrifice_code(claim_c, claim_a, claim_p);
    if code == 0 { return "none"; }
    if code == 1 { return "consistency"; }
    if code == 2 { return "availability"; }
    return "invalid";
}

pub fn cap_theorem_cert(claim_c: Int, claim_a: Int, claim_p: Int) -> DomainCert {
    let mut h: Int = 0;
    let sr: Result[Float, String] = cap_score(claim_c, claim_a, claim_p);
    if sr.is_ok() {
        if cap_got(sr) > 0.0 { h = 1; }
    }
    return domain_cert("principles", "cap_theorem", h);
}

pub fn verify_cap_theorem_principle() -> Bool {
    let s1: Float = cap_got(cap_consistency_availability_score(1, 1, 0));
    if s1 != 1.0 { return false; }
    if cap_partition_sacrifice(1, 1, 0) != "none" { return false; }
    let s2: Float = cap_got(cap_consistency_availability_score(1, 0, 1));
    if s2 != 0.5 { return false; }
    if cap_partition_sacrifice(1, 0, 1) != "availability" { return false; }
    let s3: Float = cap_got(cap_consistency_availability_score(0, 1, 1));
    if s3 != 0.5 { return false; }
    if cap_partition_sacrifice(0, 1, 1) != "consistency" { return false; }
    let s4: Float = cap_got(cap_consistency_availability_score(1, 1, 1));
    if s4 != 0.0 { return false; }
    if cap_partition_sacrifice(1, 1, 1) != "invalid" { return false; }
    if cap_consistency_availability_score(2, 1, 0).is_ok() { return false; }
    if cap_consistency_availability_score(1, 0 - 1, 0).is_ok() { return false; }
    if cap_consistency_availability_score(1, 1, 5).is_ok() { return false; }
    if cap_got(cap_consistency_availability_score(0, 0, 0)) != 0.0 { return false; }
    if cap_partition_sacrifice(0, 0, 1) != "invalid" { return false; }
    if cap_theorem_cert(1, 1, 0).holds != 1 { return false; }
    if cap_theorem_cert(1, 1, 1).holds != 0 { return false; }
    if cap_theorem_cert(2, 1, 0).holds != 0 { return false; }
    return true;
}
