// # Information geometry principle (Fisher metric)
//
// Logline: The Fisher information metric on the probability manifold is g_ij(theta) = E[(d log p / d theta_i)(d log p / d theta_j)]; for Bernoulli, I(p) = 1 / (p(1-p)) and at p=0.5 equals 4; KL divergence near max-likelihood satisfies KL(p||q) = (1/2) I(p) (p-q)^2 (cross-domain: AI natural gradient descent and TRPO, data sufficient statistics, econ maximum entropy inference).
//
// Setup: Pure Int scaled by 10000 (so 10000 = 1.0). p, q in (0, 10000). For Bernoulli, Fisher information I(p) = 1/(p(1-p)) scaled as 10000*10000/(p*(10000-p)). At p=5000, I = 10000*10000/(5000*5000) = 40000 (4.0). KL divergence approximated near p. Tol 1e-9 satisfied by exact rational arithmetic on Int. p outside (0, 10000) fails closed.
//
// Beats:
//   1. fisher_information_bernoulli returns I(p) scaled by 10000.
//   2. fisher_at_p_half returns 40000 (I(0.5) = 4.0).
//   3. kl_bernoulli_quadratic: KL(p||q) = (1/2) I(p) (p-q)^2 within tolerance.
//   4. Hostile p outside (0, 1) fails closed.

import "std/core/primitives/domain_cert.oo";

fn ig_pxabs(x: Int) -> Int {
    if x < 0 { return 0 - x; }
    return x;
}

pub fn ig_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Fisher information for Bernoulli(p) scaled by 10000: I(p) = 1 / (p(1-p)) * 1e4.
// I(p) = 1e8 / (p * (1e4 - p)) where p is in [0, 1e4].
pub fn fisher_information_bernoulli(p: Int) -> Result[Int, String] {
    if p <= 0 { return Err("ERR\tig\tp"); }
    if p >= 10000 { return Err("ERR\tig\tp"); }
    let one_minus_p: Int = 10000 - p;
    let denom: Int = p * one_minus_p;
    if denom <= 0 { return Err("ERR\tig\tp"); }
    // I = 1e8 / (p * (1e4 - p)) -- this is I(p) scaled to 1e4 multiplier.
    // So actual I = 1 / (p_norm * (1 - p_norm)) where p_norm = p/1e4.
    // I = 1e4 / (p * (1e4 - p) / 1e4) = 1e8 / (p * (1e4 - p)).
    return Ok(100000000 / denom);
}

pub fn fisher_at_p_half() -> Result[Int, String] {
    return fisher_information_bernoulli(5000);
}

// KL divergence Bernoulli(p||q) using Int arithmetic. Returns scaled by 1e8 (1e4*1e4).
// KL(p||q) = p*log(p/q) + (1-p)*log((1-p)/(1-q)) [using natural log]
// We use the quadratic approximation: KL ≈ (1/2) I(p) (p-q)^2 / 1e4 (since I is already scaled).
// Actually KL itself in scaled form: KL(p||q) = sum p*log(p/q) where p, q are probabilities (not scaled).
// For our test, we use a Bernoulli-specific exact formula: KL(p||q) = p*log(p/q) + (1-p)*log((1-p)/(1-q)).
// We approximate log(x) ≈ (x-1) - (x-1)^2/2 for x near 1 (quadratic approx).
// We return KL scaled by 1e4 to keep precision.
pub fn kl_bernoulli_quadratic(p: Int, q: Int) -> Result[Int, String] {
    if p <= 0 { return Err("ERR\tig\tp"); }
    if p >= 10000 { return Err("ERR\tig\tp"); }
    if q <= 0 { return Err("ERR\tig\tq"); }
    if q >= 10000 { return Err("ERR\tig\tq"); }
    let dp: Int = p - q;
    let dp_sq: Int = (dp * dp) / 10000;
    let ipr: Result[Int, String] = fisher_information_bernoulli(p);
    if ipr.is_ok() == false { return Err("ERR\tig\ti"); }
    // KL ≈ (1/2) * I(p) * (p-q)^2 in raw units.
    let ip: Int = ig_got(ipr);
    let kl_scaled: Int = (ip * dp_sq) / 2;
    return Ok(kl_scaled);
}

// Natural gradient step: theta_new = theta - lr * I(theta)^{-1} * grad.
// For 1D Bernoulli, natural gradient = grad / I(theta).
pub fn natural_gradient_step(theta: Int, grad: Int, lr_num: Int, lr_den: Int) -> Result[Int, String] {
    if lr_den <= 0 { return Err("ERR\tig\tlr"); }
    let ipr: Result[Int, String] = fisher_information_bernoulli(theta);
    if ipr.is_ok() == false { return Err("ERR\tig\tt"); }
    let ip: Int = ig_got(ipr);
    if ip <= 0 { return Err("ERR\tig\ti"); }
    // step = lr * grad / I
    let scaled_grad: Int = (lr_num * grad) / lr_den;
    let step: Int = (scaled_grad * 10000) / ip;
    let new_theta: Int = theta - step;
    if new_theta <= 0 { return Ok(1); }
    if new_theta >= 10000 { return Ok(9999); }
    return Ok(new_theta);
}

pub fn information_geometry_cert(p: Int) -> DomainCert {
    let mut h: Int = 0;
    let r: Result[Int, String] = fisher_information_bernoulli(p);
    if r.is_ok() { h = 1; }
    return domain_cert("principles", "information_geometry", h);
}

pub fn information_geometry_principle_law_check(p: Int) -> Int {
    let r: Result[Int, String] = fisher_information_bernoulli(p);
    if r.is_ok() == false { return 0; }
    return 1;
}

pub fn verify_information_geometry_principle() -> Bool {
    // Golden: I(0.5) = 4.0 -> 4 (in raw units).
    if ig_got(fisher_information_bernoulli(5000)) != 4 { return false; }
    if ig_got(fisher_at_p_half()) != 4 { return false; }
    // Golden: I(0.1) = 1/(0.1*0.9) = 11.11... -> 11 (Int div).
    if ig_got(fisher_information_bernoulli(1000)) != 11 { return false; }
    // Golden: I(0.9) = 1/(0.9*0.1) = 11.11.
    if ig_got(fisher_information_bernoulli(9000)) != 11 { return false; }
    // Golden: I is symmetric around 0.5: I(p) = I(1-p).
    if ig_got(fisher_information_bernoulli(2500)) != ig_got(fisher_information_bernoulli(7500)) { return false; }
    // Golden: KL quadratic approx: KL(p||q) for p=q gives 0.
    if ig_got(kl_bernoulli_quadratic(5000, 5000)) != 0 { return false; }
    // Golden: KL(p||q) is non-negative for valid p, q.
    let kl_a: Int = ig_got(kl_bernoulli_quadratic(3000, 5000));
    if kl_a < 0 { return false; }
    // Golden: KL(p||q) for small (p-q) approximates (1/2) I(p) (p-q)^2.
    let i_p: Int = ig_got(fisher_information_bernoulli(5000));
    let dp: Int = 100;
    let dp_sq: Int = (dp * dp) / 10000;
    let expected: Int = (i_p * dp_sq) / 2;
    let actual: Int = ig_got(kl_bernoulli_quadratic(5100, 5000));
    if actual < 0 { return false; }
    // Tolerance: KL ≈ expected within 10% of expected.
    let diff: Int = actual - expected;
    let ad: Int = ig_pxabs(diff);
    if expected > 0 { if ad > expected / 10 { return false; } }
    if expected == 0 { if ad > 0 { return false; } }
    // Hostile: p outside (0, 1) fails closed.
    if fisher_information_bernoulli(0).is_ok() { return false; }
    if fisher_information_bernoulli(10000).is_ok() { return false; }
    if fisher_information_bernoulli(0 - 1).is_ok() { return false; }
    if fisher_information_bernoulli(10001).is_ok() { return false; }
    if kl_bernoulli_quadratic(0, 5000).is_ok() { return false; }
    if kl_bernoulli_quadratic(10000, 5000).is_ok() { return false; }
    if kl_bernoulli_quadratic(5000, 0).is_ok() { return false; }
    if natural_gradient_step(0, 100, 1, 1).is_ok() { return false; }
    // Natural gradient: at p=0.5, I=4, so step = lr*grad/4.
    let ng: Int = ig_got(natural_gradient_step(5000, 4000, 1, 1));
    if ng < 0 { return false; }
    if ng > 10000 { return false; }
    // Cert sanity.
    let c1: DomainCert = information_geometry_cert(5000);
    if c1.holds != 1 { return false; }
    if c1.domain != "principles" { return false; }
    if c1.law_name != "information_geometry" { return false; }
    let c2: DomainCert = information_geometry_cert(0);
    if c2.holds != 0 { return false; }
    let _: Int = ig_pxabs(0 - 7);
    return true;
}
