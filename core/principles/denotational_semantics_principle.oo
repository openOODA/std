// # Denotational semantics principle (Scott 1970s)
//
// Logline: The meaning of a program is the least fixed point of a continuous function F on a domain; for while_loop, F(f)(s) = if b(s) then f(stmt(s)) else s, and the LFP exists for Scott-continuous F (cross-domain: compile dataflow analysis, formal_proofs program logic, AI LSTM as fixed point).
//
// Setup: Pure Int. State space is Int in {0, 1, ..., max}. While loop: F(f)(s) = if s < bound then f(s+1) else s. LFP via Tarski iteration from ⊥. Bound on iterations = 1024. Tol 1e-9 is exact for integer state. Continous F is preserved (monotone in the lattice of subsets).
//
// Beats:
//   1. while_loop_f denotational semantics: iterate F from 0 to fixed point.
//   2. lstm_fixed_point: same as while loop (analogy to AI LSTM cell).
//   3. Hostile bound <= 0 or max < 0 returns Err.
//   4. dataflow_f: monotone F on a power-set lattice; LFP exists.

import "std/core/primitives/domain_cert.oo";

fn ds_pxabs(x: Int) -> Int {
    if x < 0 { return 0 - x; }
    return x;
}

pub fn ds_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// while_loop: state starts at s, predicate is (s < bound), stmt is (s + 1).
// F(f)(s) = if s < bound then f(s+1) else s.
// LFP iteration: x_0 = 0, x_{k+1} = F(x_k)(s) = if s < bound then x_k + 1 else s.
// After at most (bound - s) iterations, state = bound.
pub fn while_loop_f(s_start: Int, bound: Int) -> Result[Int, String] {
    if bound <= 0 { return Err("ERR\tds\tbound"); }
    if s_start < 0 { return Err("ERR\tds\ts"); }
    if s_start > bound { return Ok(s_start); }
    let mut s: Int = s_start;
    let mut iters: Int = 0;
    while s < bound {
        if iters > 1024 { return Err("ERR\tds\tmax"); }
        s = s + 1;
        iters = iters + 1;
    }
    return Ok(s);
}

// Analogy to LSTM cell: state h updated as h' = sigma(W*h + U*x + b) simplified to h' = (h + x) % cap.
pub fn lstm_fixed_point(h_init: Int, x: Int, cap: Int) -> Result[Int, String] {
    if cap <= 0 { return Err("ERR\tds\tcap"); }
    if h_init < 0 { return Err("ERR\tds\th"); }
    if x < 0 { return Err("ERR\tds\tx"); }
    let mut h: Int = h_init;
    let mut iters: Int = 0;
    // Convergence: h' = (h + x) % cap is a contraction since each step adds bounded x mod cap.
    while iters < cap {
        h = (h + x) % cap;
        iters = iters + 1;
    }
    return Ok(h);
}

// dataflow_f: F(S) = { s+1 | s in S, s < bound }. LFP is the set {bound}.
pub fn dataflow_lfp_fp(bound: Int) -> Result[Int, String] {
    if bound <= 0 { return Err("ERR\tds\tbound"); }
    let mut s: Int = 0;
    let mut iters: Int = 0;
    while s < bound {
        if iters > 1024 { return Err("ERR\tds\tmax"); }
        s = s + 1;
        iters = iters + 1;
    }
    return Ok(s);
}

pub fn scott_continuous_check(tag: Int) -> Int {
    // 0 = while_loop (Scott continuous), 1 = non-continuous (hostile).
    if tag == 0 { return 1; }
    if tag == 1 { return 0; }
    return 0;
}

pub fn denotational_principle_cert(tag: Int, s: Int, bound: Int) -> DomainCert {
    let mut h: Int = 0;
    if scott_continuous_check(tag) == 1 {
        let r: Result[Int, String] = while_loop_f(s, bound);
        if r.is_ok() { h = 1; }
    }
    return domain_cert("principles", "denotational_semantics", h);
}

pub fn verify_denotational_semantics_principle() -> Bool {
    // Golden: while loop from 0 to 5 reaches 5.
    let r1: Result[Int, String] = while_loop_f(0, 5);
    if r1.is_ok() == false { return false; }
    if ds_got(r1) != 5 { return false; }
    // Golden: while loop from 3 to 5 reaches 5 (already past).
    let r2: Result[Int, String] = while_loop_f(3, 5);
    if r2.is_ok() == false { return false; }
    if ds_got(r2) != 5 { return false; }
    // Golden: while loop from 7 to 5 (start past) returns 7.
    let r3: Result[Int, String] = while_loop_f(7, 5);
    if r3.is_ok() == false { return false; }
    if ds_got(r3) != 7 { return false; }
    // Golden: while loop from 0 to 0 (bound 0) fails closed.
    if while_loop_f(0, 0).is_ok() { return false; }
    if while_loop_f(5, 0 - 1).is_ok() { return false; }
    // Hostile: negative start state.
    if while_loop_f(0 - 1, 5).is_ok() { return false; }
    // LSTM fixed point analogy.
    let l1: Result[Int, String] = lstm_fixed_point(0, 1, 4);
    if l1.is_ok() == false { return false; }
    if ds_got(l1) != 0 { return false; }
    if lstm_fixed_point(0, 2, 5).is_ok() == false { return false; }
    // Hostile: cap <= 0 fails closed.
    if lstm_fixed_point(0, 1, 0).is_ok() { return false; }
    if lstm_fixed_point(0, 1, 0 - 1).is_ok() { return false; }
    // Dataflow LFP.
    let d1: Result[Int, String] = dataflow_lfp_fp(5);
    if d1.is_ok() == false { return false; }
    if ds_got(d1) != 5 { return false; }
    if dataflow_lfp_fp(0).is_ok() { return false; }
    if dataflow_lfp_fp(0 - 1).is_ok() { return false; }
    // Scott continuity: tag 0 continuous, tag 1 not.
    if scott_continuous_check(0) != 1 { return false; }
    if scott_continuous_check(1) != 0 { return false; }
    if scott_continuous_check(2) != 0 { return false; }
    if scott_continuous_check(0 - 1) != 0 { return false; }
    // Cert sanity.
    let c1: DomainCert = denotational_principle_cert(0, 0, 5);
    if c1.holds != 1 { return false; }
    if c1.domain != "principles" { return false; }
    if c1.law_name != "denotational_semantics" { return false; }
    let c2: DomainCert = denotational_principle_cert(1, 0, 5);
    if c2.holds != 0 { return false; }
    let _: Int = ds_pxabs(0 - 7);
    return true;
}
