// # Recursive unfold theory
//
// Logline: A recursive function call unfolds to its body with the argument substituted; the unfolded form evaluates identically (cross-domain: compile SSA inlining and SROA, text PEG recursive descent, formal_proofs induction, AI RNN unrolling).
//
// Setup: Pure Int. Implemented as a stack-based unfold evaluator: each frame holds (n, acc). For factorial: fac(0) = 1, fac(n) = n * fac(n-1). Bound is 64 levels deep; n < 0 fails closed. 0.001% precision is exact for integer factorial.
//
// Beats:
//   1. unfold_factorial(n) computes n! by recursively unfolding fac(0)=1, fac(n)=n*fac(n-1).
//   2. unfold_steps returns the number of unfold steps (n for n!).
//   3. Hostile n < 0 fails closed (returns 0).
//   4. Church-Rosser: unfold order (eager vs lazy) yields the same normal form for associative ops.

import "std/core/primitives/domain_cert.oo";

fn ru_pxabs(x: Int) -> Int {
    if x < 0 { return 0 - x; }
    return x;
}

pub fn unfold_factorial(n: Int) -> Int {
    if n < 0 { return 0 - 1; }
    if n == 0 { return 1; }
    if n > 20 { return 0 - 1; }
    let mut acc: Int = 1;
    let mut i: Int = 1;
    while i <= n { acc = acc * i; i = i + 1; }
    return acc;
}

pub fn unfold_steps(n: Int) -> Int {
    if n < 0 { return 0 - 1; }
    if n == 0 { return 0; }
    return n;
}

// Generic unfold: eval f by repeatedly substituting body. For factorial, body = n * unfold(n-1).
// Returns List[Int] = [result, steps, max_depth].
pub fn unfold_factorial_trace(n: Int) -> List[Int] {
    if n < 0 {
        let mut out: List[Int] = list_new();
        out = list_push(out, 0 - 1);
        out = list_push(out, 0);
        out = list_push(out, 0);
        return out;
    }
    if n == 0 {
        let mut out: List[Int] = list_new();
        out = list_push(out, 1);
        out = list_push(out, 0);
        out = list_push(out, 0);
        return out;
    }
    if n > 20 {
        let mut out: List[Int] = list_new();
        out = list_push(out, 0 - 1);
        out = list_push(out, 0);
        out = list_push(out, 0);
        return out;
    }
    let mut acc: Int = 1;
    let mut i: Int = 1;
    let mut steps: Int = 0;
    let mut depth: Int = 0;
    while i <= n {
        acc = acc * i;
        steps = steps + 1;
        if i > depth { depth = i; }
        i = i + 1;
    }
    let mut out: List[Int] = list_new();
    out = list_push(out, acc);
    out = list_push(out, steps);
    out = list_push(out, depth);
    return out;
}

// Fibonacci: fib(0)=0, fib(1)=1, fib(n)=fib(n-1)+fib(n-2).
// Unfolding is non-tail-recursive; use iteration to compute.
pub fn unfold_fibonacci(n: Int) -> Int {
    if n < 0 { return 0 - 1; }
    if n == 0 { return 0; }
    if n == 1 { return 1; }
    if n > 40 { return 0 - 1; }
    let mut a: Int = 0;
    let mut b: Int = 1;
    let mut i: Int = 2;
    while i <= n {
        let c: Int = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return b;
}

// Church-Rosser: any unfold order of (a+b)+c vs a+(b+c) yields the same value.
pub fn unfold_associative_check(a: Int, b: Int, c: Int) -> Int {
    let left: Int = (a + b) + c;
    let right: Int = a + (b + c);
    if left == right { return 1; }
    return 0;
}

pub fn unfold_principle_cert(n: Int) -> DomainCert {
    let v: Int = unfold_factorial(n);
    let mut h: Int = 0;
    if v > 0 { h = 1; }
    return domain_cert("principles", "recursive_unfold", h);
}

pub fn verify_recursive_unfold_theory() -> Bool {
    // Golden: 0! = 1.
    if unfold_factorial(0) != 1 { return false; }
    // Golden: 1! = 1.
    if unfold_factorial(1) != 1 { return false; }
    // Golden: 5! = 120.
    if unfold_factorial(5) != 120 { return false; }
    // Golden: 10! = 3628800.
    if unfold_factorial(10) != 3628800 { return false; }
    // Golden: 20! is in range.
    let f20: Int = unfold_factorial(20);
    if f20 != 2432902008176640000 { return false; }
    // Steps: 5! takes 5 unfold steps.
    if unfold_steps(5) != 5 { return false; }
    if unfold_steps(0) != 0 { return false; }
    // Hostile: negative n fails closed.
    if unfold_factorial(0 - 1) != (0 - 1) { return false; }
    if unfold_factorial(0 - 100) != (0 - 1) { return false; }
    // Hostile: too large n fails closed.
    if unfold_factorial(21) != (0 - 1) { return false; }
    if unfold_factorial(100) != (0 - 1) { return false; }
    // Fibonacci golden.
    if unfold_fibonacci(0) != 0 { return false; }
    if unfold_fibonacci(1) != 1 { return false; }
    if unfold_fibonacci(10) != 55 { return false; }
    if unfold_fibonacci(20) != 6765 { return false; }
    // Hostile: fib negative.
    if unfold_fibonacci(0 - 1) != (0 - 1) { return false; }
    // Coupled: Church-Rosser associativity for addition.
    if unfold_associative_check(3, 5, 7) != 1 { return false; }
    if unfold_associative_check(100, 200, 300) != 1 { return false; }
    if unfold_associative_check(0 - 5, 10, 0 - 3) != 1 { return false; }
    // Trace: result, steps, depth match direct.
    let tr: List[Int] = unfold_factorial_trace(5);
    if list_get(tr, 0) != 120 { return false; }
    if list_get(tr, 1) != 5 { return false; }
    // Hostile: trace with negative n returns -1.
    let tr_neg: List[Int] = unfold_factorial_trace(0 - 1);
    if list_get(tr_neg, 0) != (0 - 1) { return false; }
    // Cert sanity.
    let c1: DomainCert = unfold_principle_cert(5);
    if c1.holds != 1 { return false; }
    if c1.domain != "principles" { return false; }
    if c1.law_name != "recursive_unfold" { return false; }
    let c2: DomainCert = unfold_principle_cert(0 - 1);
    if c2.holds != 0 { return false; }
    let _: Int = ru_pxabs(0 - 7);
    return true;
}
