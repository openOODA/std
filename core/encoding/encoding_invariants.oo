// # Encoding hex-nibble law
//
// Logline: An invalid hex nibble is not a hex digit. Byte G fails closed.
//
// Setup: Pure. Imports domain_cert.oo. ASCII 0-9, A-F, a-f only.
//
// Beats:
//   1. encoding_hex_nibble("A") holds 1.
//   2. encoding_hex_nibble("G") holds 0.
//   3. encoding_hex_byte of byte G holds 0.

import "std/core/primitives/domain_cert.oo";

pub fn encoding_is_hex_digit(c: String) -> Int {
    if chars_len(c) != 1 {
        return 0;
    }
    let digits: String = "0123456789abcdefABCDEF";
    if str_index_of(digits, c) < 0 {
        return 0;
    }
    return 1;
}

pub fn encoding_hex_nibble(c: String) -> DomainCert {
    return domain_cert("encoding", "hex_nibble", encoding_is_hex_digit(c));
}

pub fn encoding_is_hex_byte(b: Int) -> Int {
    if b >= 48 {
        if b <= 57 {
            return 1;
        }
    }
    if b >= 65 {
        if b <= 70 {
            return 1;
        }
    }
    if b >= 97 {
        if b <= 102 {
            return 1;
        }
    }
    return 0;
}

pub fn encoding_hex_byte(b: Int) -> DomainCert {
    return domain_cert("encoding", "hex_nibble", encoding_is_hex_byte(b));
}
