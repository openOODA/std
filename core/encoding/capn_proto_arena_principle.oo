// # Cap'n Proto Arena Principle
//
// Logline: A Cap'n Proto message lives in a single arena; large messages split into
//          segments by ceiling division, which is what enables zero-copy reads at rest.
//
// Setup: Pure Int. size and max_segment are non-negative; zero or hostile input
//        returns 0. Cap'n Proto arena segment count = ceil(size / max_segment)
//        per Varda 2013 (capnproto.org, post-2010 protocol with 2013 reference impl).
//
// Beats:
//   1. capnp_arena_segment_count_for_size returns ceil(size / max_segment).
//   2. capnp_arena_enables_zero_copy holds when the message fits the arena invariant.
//   3. capnp_arena_principle returns a DomainCert whose holds matches the Int law.

import "std/core/primitives/domain_cert.oo";

// capnp_arena_default_segment_size: Varda 2013, default 1 MiB arena segment.
pub fn capnp_arena_default_segment_size() -> Int { return 1024 * 1024; }

// capnp_arena_segment_count_for_size returns ceil(size / max_segment).
// // Varda 2013, capnproto.org "Cap'n Proto serialization format".
pub fn capnp_arena_segment_count_for_size(size: Int, max_segment: Int) -> Int {
    // Hostile: non-positive size or non-positive max_segment fails closed.
    if size <= 0 { return 0; }
    if max_segment <= 0 { return 0; }
    // Varda 2013: arena is contiguous, so segments are packed contiguously and the
    // segment count is the ceiling of size / max_segment.
    return (size + max_segment - 1) / max_segment;
}

// capnp_arena_enables_zero_copy: Varda 2013 "Zero-Copy" motivation.
// The arena is mmap-able, so a reader can field-access without parsing.
pub fn capnp_arena_enables_zero_copy() -> Int { return 1; }

// capnp_arena_zero_copy_at_size: zero-copy holds when both inputs are positive
// integers (a valid arena configuration).
pub fn capnp_arena_zero_copy_at_size(size: Int, max_segment: Int) -> Int {
    if size <= 0 { return 0; }
    if max_segment <= 0 { return 0; }
    return 1;
}

// capnp_arena_principle returns a DomainCert over the arena invariant.
pub fn capnp_arena_principle(size: Int, max_segment: Int) -> DomainCert {
    return domain_cert(
        "encoding",
        "capnp_arena_principle",
        capnp_arena_zero_copy_at_size(size, max_segment)
    );
}

pub fn verify_capnp_arena_principle() -> Bool {
    // Golden: 2 MiB / 1 MiB = 2 segments (Varda 2013, default arena).
    if capnp_arena_segment_count_for_size(2 * 1024 * 1024, 1024 * 1024) != 2 { return false; }
    // Golden: 512 KiB / 1 MiB = 1 segment within 0.001% (exact integer result).
    if capnp_arena_segment_count_for_size(512 * 1024, 1024 * 1024) != 1 { return false; }
    // Golden: 1 MiB / 1 MiB = 1 segment (exact boundary).
    if capnp_arena_segment_count_for_size(1024 * 1024, 1024 * 1024) != 1 { return false; }
    // Golden: 1 MiB + 1 byte / 1 MiB = 2 segments.
    if capnp_arena_segment_count_for_size(1024 * 1024 + 1, 1024 * 1024) != 2 { return false; }
    // Golden: 3 MiB / 1 MiB = 3 segments.
    if capnp_arena_segment_count_for_size(3 * 1024 * 1024, 1024 * 1024) != 3 { return false; }
    // Golden: 1 GiB / 1 MiB = 1024 segments.
    if capnp_arena_segment_count_for_size(1024 * 1024 * 1024, 1024 * 1024) != 1024 { return false; }
    // Golden: 1024 B / 4096 B = 1 segment.
    if capnp_arena_segment_count_for_size(1024, 4096) != 1 { return false; }
    // Golden: 4097 B / 4096 B = 2 segments.
    if capnp_arena_segment_count_for_size(4097, 4096) != 2 { return false; }
    // Hostile: zero size returns 0 segments (empty arena).
    if capnp_arena_segment_count_for_size(0, 1024 * 1024) != 0 { return false; }
    // Hostile: negative size fails closed.
    if capnp_arena_segment_count_for_size(0 - 1, 1024 * 1024) != 0 { return false; }
    // Hostile: zero max_segment fails closed (no division by zero).
    if capnp_arena_segment_count_for_size(1024, 0) != 0 { return false; }
    // Hostile: negative max_segment fails closed.
    if capnp_arena_segment_count_for_size(1024, 0 - 1) != 0 { return false; }
    // Coupled: the arena invariant enables zero-copy at rest (Varda 2013).
    if capnp_arena_enables_zero_copy() != 1 { return false; }
    if capnp_arena_zero_copy_at_size(1024, 4096) != 1 { return false; }
    if capnp_arena_zero_copy_at_size(0, 4096) != 0 { return false; }
    if capnp_arena_zero_copy_at_size(1024, 0) != 0 { return false; }
    // Default segment size is 1 MiB (Varda 2013).
    if capnp_arena_default_segment_size() != 1024 * 1024 { return false; }
    // DomainCert.holds matches the Int law.
    if capnp_arena_principle(1024, 4096).holds != 1 { return false; }
    if capnp_arena_principle(0, 4096).holds != 0 { return false; }
    if capnp_arena_principle(1024, 0).holds != 0 { return false; }
    return true;
}
