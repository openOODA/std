// # MessagePack type-tag decoder
//
// Logline: Parses one MessagePack item and rejects unknown tags and truncated payloads across the standard type tag set.
//
// Setup: Pure. Called from msgpack_pure.oo. Bytes are List[Int] 0..255.
//
// Beats:
//   1. Read the leading type tag.
//   2. Decode fixint, fixstr, int8/16/32/64, uint8/16/32, nil, bool, str8/16/32, bin8/16/32, fixarray, array16/32, fixmap, and map16/32.
//   3. Fail closed on a short buffer or an unknown tag.

type MsgOut = struct {
    flag: Int,
    err: String,
    kind: Int,
    n: Int,
    bytes: List[Int]
};

fn mp_err(m: String) -> MsgOut {
    return MsgOut { flag: 0, err: m, kind: 0, n: 0, bytes: list_new() };
}

fn mp_ok(kind: Int, n: Int, b: List[Int]) -> MsgOut {
    return MsgOut { flag: 1, err: "", kind: kind, n: n, bytes: b };
}

fn mp_need(buf: List[Int], i: Int, k: Int) -> Int {
    if i < 0 {
        return 0;
    }
    if i + k > list_len(buf) {
        return 0;
    }
    return 1;
}

fn mp_i8(b: Int) -> Int {
    if b >= 128 {
        return b - 256;
    }
    return b;
}

fn mp_i16(hi: Int, lo: Int) -> Int {
    let u: Int = hi * 256 + lo;
    if u >= 32768 {
        return u - 65536;
    }
    return u;
}

fn mp_i32(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    let u: Int = ((b0 * 256 + b1) * 256 + b2) * 256 + b3;
    if b0 >= 128 {
        return u - 4294967296;
    }
    return u;
}

fn mp_tail(buf: List[Int], i: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let n: Int = list_len(buf);
    while i < n {
        o = list_push(o, list_get(buf, i));
        i = i + 1;
    }
    return o;
}

fn mp_slice(buf: List[Int], i: Int, n: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut k: Int = 0;
    while k < n {
        o = list_push(o, list_get(buf, i + k));
        k = k + 1;
    }
    return o;
}

pub fn msgpack_pure_dec_parse(buf: List[Int]) -> MsgOut {
    if mp_need(buf, 0, 1) < 1 {
        return mp_err("ERR\tmsgpack_pure_dec\ttruncated");
    }
    let t: Int = list_get(buf, 0);
    if t <= 127 {
        return mp_ok(0, t, mp_tail(buf, 1));
    }
    if t >= 224 {
        return mp_ok(0, t - 256, mp_tail(buf, 1));
    }
    if t == 192 {
        return mp_ok(1, 0, mp_tail(buf, 1));
    }
    if t == 194 {
        return mp_ok(2, 0, mp_tail(buf, 1));
    }
    if t == 195 {
        return mp_ok(2, 1, mp_tail(buf, 1));
    }
    if t == 208 {
        if mp_need(buf, 1, 1) < 1 {
            return mp_err("ERR\tmsgpack_pure_dec\ttruncated");
        }
        return mp_ok(0, mp_i8(list_get(buf, 1)), mp_tail(buf, 2));
    }
    if t == 209 {
        if mp_need(buf, 1, 2) < 1 {
            return mp_err("ERR\tmsgpack_pure_dec\ttruncated");
        }
        return mp_ok(0, mp_i16(list_get(buf, 1), list_get(buf, 2)), mp_tail(buf, 3));
    }
    if t == 210 {
        if mp_need(buf, 1, 4) < 1 {
            return mp_err("ERR\tmsgpack_pure_dec\ttruncated");
        }
        return mp_ok(0, mp_i32(list_get(buf, 1), list_get(buf, 2), list_get(buf, 3), list_get(buf, 4)), mp_tail(buf, 5));
    }
    if t == 196 {
        if mp_need(buf, 1, 1) < 1 {
            return mp_err("ERR\tmsgpack_pure_dec\ttruncated");
        }
        let n: Int = list_get(buf, 1);
        if mp_need(buf, 2, n) < 1 {
            return mp_err("ERR\tmsgpack_pure_dec\ttruncated");
        }
        return mp_ok(3, n, mp_slice(buf, 2, n));
    }
    if t == 197 {
        if mp_need(buf, 1, 2) < 1 {
            return mp_err("ERR\tmsgpack_pure_dec\ttruncated");
        }
        let n2: Int = list_get(buf, 1) * 256 + list_get(buf, 2);
        if mp_need(buf, 3, n2) < 1 {
            return mp_err("ERR\tmsgpack_pure_dec\ttruncated");
        }
        return mp_ok(3, n2, mp_slice(buf, 3, n2));
    }
    if t >= 144 {
        if t <= 159 {
            return mp_ok(4, t - 144, mp_tail(buf, 1));
        }
    }
    if t >= 128 {
        if t <= 143 {
            return mp_ok(5, t - 128, mp_tail(buf, 1));
        }
    }
    // fixstr 0xa0..0xbf: 1 byte header, length = t - 0xa0.
    if t >= 160 {
        if t <= 191 {
            let ns: Int = t - 160;
            if mp_need(buf, 1, ns) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
            return mp_ok(3, ns, mp_slice(buf, 1, ns));
        }
    }
    // str8 0xd9: 1 byte length; str16 0xda: 2 byte length; str32 0xdb: 4 byte length.
    if t == 217 {
        if mp_need(buf, 1, 1) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        let ns2: Int = list_get(buf, 1);
        if mp_need(buf, 2, ns2) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        return mp_ok(3, ns2, mp_slice(buf, 2, ns2));
    }
    if t == 218 {
        if mp_need(buf, 1, 2) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        let ns3: Int = list_get(buf, 1) * 256 + list_get(buf, 2);
        if mp_need(buf, 3, ns3) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        return mp_ok(3, ns3, mp_slice(buf, 3, ns3));
    }
    if t == 219 {
        if mp_need(buf, 1, 4) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        let b1: Int = list_get(buf, 1);
        let b2: Int = list_get(buf, 2);
        let b3: Int = list_get(buf, 3);
        let b4: Int = list_get(buf, 4);
        let ns4: Int = ((b1 * 256 + b2) * 256 + b3) * 256 + b4;
        if mp_need(buf, 5, ns4) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        return mp_ok(3, ns4, mp_slice(buf, 5, ns4));
    }
    // bin32 0xc6: 4 byte length.
    if t == 198 {
        if mp_need(buf, 1, 4) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        let b1b: Int = list_get(buf, 1);
        let b2b: Int = list_get(buf, 2);
        let b3b: Int = list_get(buf, 3);
        let b4b: Int = list_get(buf, 4);
        let nb: Int = ((b1b * 256 + b2b) * 256 + b3b) * 256 + b4b;
        if mp_need(buf, 5, nb) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        return mp_ok(6, nb, mp_slice(buf, 5, nb));
    }
    // uint8 0xcc, uint16 0xcd, uint32 0xce: 1, 2, 4 byte unsigned ints.
    if t == 204 {
        if mp_need(buf, 1, 1) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        return mp_ok(0, list_get(buf, 1), mp_tail(buf, 2));
    }
    if t == 205 {
        if mp_need(buf, 1, 2) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        return mp_ok(0, list_get(buf, 1) * 256 + list_get(buf, 2), mp_tail(buf, 3));
    }
    if t == 206 {
        if mp_need(buf, 1, 4) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        let u1: Int = list_get(buf, 1);
        let u2: Int = list_get(buf, 2);
        let u3: Int = list_get(buf, 3);
        let u4: Int = list_get(buf, 4);
        let u32: Int = ((u1 * 256 + u2) * 256 + u3) * 256 + u4;
        return mp_ok(0, u32, mp_tail(buf, 5));
    }
    // int64 0xd3: 8 bytes.
    if t == 211 {
        if mp_need(buf, 1, 8) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        let v64: Int = mp_i32(list_get(buf, 1), list_get(buf, 2), list_get(buf, 3), list_get(buf, 4));
        let l1: Int = list_get(buf, 5);
        let l2: Int = list_get(buf, 6);
        let l3: Int = list_get(buf, 7);
        let l4: Int = list_get(buf, 8);
        let lo4: Int = ((l1 * 256 + l2) * 256 + l3) * 256 + l4;
        if v64 == 0 - 1 {
            if lo4 != 0 { return mp_ok(0, lo4, mp_tail(buf, 9)); }
        }
        return mp_ok(0, v64, mp_tail(buf, 9));
    }
    // array16 0xdc, array32 0xdd: 2/4 byte length.
    if t == 220 {
        if mp_need(buf, 1, 2) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        let na: Int = list_get(buf, 1) * 256 + list_get(buf, 2);
        return mp_ok(4, na, mp_tail(buf, 3));
    }
    if t == 221 {
        if mp_need(buf, 1, 4) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        let a1: Int = list_get(buf, 1);
        let a2: Int = list_get(buf, 2);
        let a3: Int = list_get(buf, 3);
        let a4: Int = list_get(buf, 4);
        let na2: Int = ((a1 * 256 + a2) * 256 + a3) * 256 + a4;
        return mp_ok(4, na2, mp_tail(buf, 5));
    }
    // map16 0xde, map32 0xdf: 2/4 byte length.
    if t == 222 {
        if mp_need(buf, 1, 2) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        let nm: Int = list_get(buf, 1) * 256 + list_get(buf, 2);
        return mp_ok(5, nm, mp_tail(buf, 3));
    }
    if t == 223 {
        if mp_need(buf, 1, 4) < 1 { return mp_err("ERR\tmsgpack_pure_dec\ttruncated"); }
        let m1: Int = list_get(buf, 1);
        let m2: Int = list_get(buf, 2);
        let m3: Int = list_get(buf, 3);
        let m4: Int = list_get(buf, 4);
        let nm2: Int = ((m1 * 256 + m2) * 256 + m3) * 256 + m4;
        return mp_ok(5, nm2, mp_tail(buf, 5));
    }
    return mp_err("ERR\tmsgpack_pure_dec\tunknown_tag");
}
