// # URL Percent-Encoding and Query String Module
//
// Logline: RFC 3986 percent-encoding, decoding, application/x-www-form-urlencoded parsing, and query string construction.
//
// Setup: Pure character classification and %HH escaping without ambient network or browser context.
//
// Beats:
//   1. Percent-encode unreserved and reserved characters into %HH escape sequences.
//   2. Decode %HH hex pairs back to original UTF-8/ASCII characters with '+' to space translation.
//   3. Parse and serialize structured key=value URL query strings.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/primitives/result.oo";
import "std/core/primitives/str.oo";
import "std/core/primitives/byte.oo";
import "std/core/encoding/hex.oo";

type QueryParam = struct {
    key: String,
    value: String
};

pub fn url_is_unreserved(c: String) -> Bool {
    return char_is_alpha(c) || char_is_digit(c) || c == "-" || c == "_" || c == "." || c == "~";
}

pub fn url_is_unreserved_byte(b: Int) -> Bool {
    if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) {
        return true;
    }
    return b == 45 || b == 95 || b == 46 || b == 126;
}

pub fn url_encode_component(s: String) -> String {
    let blen: Int = byte_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < blen {
        let b: Int = byte_get(s, i);
        if url_is_unreserved_byte(b) {
            out = out + chr(b);
        } else {
            let h: String = hex_byte_to_str(b, true);
            out = out + "%" + h;
        }
        i = i + 1;
    }
    return out;
}

pub fn url_encode(s: String) -> String {
    return url_encode_component(s);
}

pub fn url_decode(s: String) -> Result[String, String] {
    let n: Int = chars_len(s);
    let mut buf: List[Int] = byte_buf_new();
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "+" {
            buf = byte_buf_push(buf, 32);
            i = i + 1;
        } else if c == "%" {
            if i + 2 >= n {
                return Err("ERR\turl_decode\tincomplete_percent");
            }
            let c1: String = char_at(s, i + 1);
            let c2: String = char_at(s, i + 2);
            let v1: Int = hex_nibble_val(c1);
            let v2: Int = hex_nibble_val(c2);
            if v1 < 0 || v2 < 0 {
                return Err("ERR\turl_decode\tinvalid_hex");
            }
            let b: Int = (v1 * 16) + v2;
            buf = byte_buf_push(buf, b);
            i = i + 3;
        } else {
            let b: Int = ord(c);
            buf = byte_buf_push(buf, b);
            i = i + 1;
        }
    }
    let res_str: String = byte_buf_to_str(buf);
    return Ok(res_str);
}

pub fn url_build_query(keys: List[String], values: List[String]) -> String {
    let mut out: String = "";
    let n_keys: Int = list_len(keys);
    let n_vals: Int = list_len(values);
    let mut i: Int = 0;
    while i < n_keys && i < n_vals {
        let k: String = list_get(keys, i);
        let v: String = list_get(values, i);
        let pair: String = url_encode_component(k) + "=" + url_encode_component(v);
        if i > 0 {
            out = out + "&" + pair;
        } else {
            out = out + pair;
        }
        i = i + 1;
    }
    return out;
}

pub fn url_get_param(query_string: String, key_name: String) -> Result[String, String] {
    let mut cur: String = query_string;
    if chars_len(cur) > 0 && char_at(cur, 0) == "?" {
        cur = str_slice(cur, 1, chars_len(cur));
    }
    while chars_len(cur) > 0 {
        let mut pair: String = cur;
        let amp_pos: Int = str_index_of(cur, "&");
        if amp_pos >= 0 {
            pair = str_slice(cur, 0, amp_pos);
            cur = str_slice(cur, amp_pos + 1, chars_len(cur));
        } else {
            cur = "";
        }
        let eq_pos: Int = str_index_of(pair, "=");
        if eq_pos >= 0 {
            let raw_k: String = str_slice(pair, 0, eq_pos);
            let raw_v: String = str_slice(pair, eq_pos + 1, chars_len(pair));
            let k_res: Result[String, String] = url_decode(raw_k);
            let mut k: String = raw_k;
            match k_res {
                Ok(val) => { k = val; }
                Err(e)  => { k = raw_k; }
            }
            if k == key_name {
                let v_res: Result[String, String] = url_decode(raw_v);
                return v_res;
            }
        }
    }
    return Err("ERR\turl_get_param\tnot_found");
}
