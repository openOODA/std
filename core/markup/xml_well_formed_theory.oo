// # XML well-formedness theory
//
// Logline: A well-formed XML document has matching start/end tags, no overlapping siblings in the same namespace, and either a single root (closed) or multiple roots from distinct namespaces (coupled).
//
// Setup: Pure byte scan. ASCII '<' is 60, '>' is 62, '/' is 47, ':' is 58, '=' is 61, '"' is 34. Stack depth capped at 16. Self-closing tags like <x/> do not push.
//
// Beats:
//   1. xml_well_closed holds 1 only on balanced nesting with exactly one root element.
//   2. xml_well_coupled holds 1 when tag nesting is balanced per namespace and a single namespace has at most one active root.
//   3. xml_parse_tag_attrs returns the local-name byte and 1 when attribute syntax is recognized.
//   4. Empty input or stray close tags fail closed to 0.

import "std/core/primitives/domain_cert.oo";

pub fn xml_is_name_start(b: Int) -> Int {
    if b >= 97 { if b <= 122 { return 1; } }
    if b >= 65 { if b <= 90 { return 1; } }
    if b == 95 { return 1; }
    return 0;
}

pub fn xml_is_name_cont(b: Int) -> Int {
    if xml_is_name_start(b) == 1 { return 1; }
    if b >= 48 { if b <= 57 { return 1; } }
    if b == 45 { return 1; }
    if b == 46 { return 1; }
    return 0;
}

pub fn xml_find_tag_end(raw: String, start: Int, n: Int) -> Int {
    let mut i: Int = start;
    let mut in_dq: Int = 0;
    let mut in_sq: Int = 0;
    while i < n {
        let b: Int = byte_at(raw, i);
        if in_dq == 1 {
            if b == 34 { in_dq = 0; }
        } else if in_sq == 1 {
            if b == 39 { in_sq = 0; }
        } else if b == 34 {
            in_dq = 1;
        } else if b == 39 {
            in_sq = 1;
        } else if b == 62 {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Encoded tag id: local + 256*(ns+1) if prefixed, local if no namespace. 0 = invalid.
pub fn xml_parse_tag(raw: String, body_start: Int, body_end: Int) -> Int {
    let n: Int = raw.len();
    if body_start >= body_end { return 0; }
    if body_start >= n { return 0; }
    if body_end > n { return 0; }
    let first: Int = byte_at(raw, body_start);
    if xml_is_name_start(first) == 0 { if first != 47 { return 0; } }
    let mut i: Int = body_start;
    let mut local: Int = 0;
    let mut prefix: Int = 0;
    let mut has_prefix: Int = 0;
    let mut saw_name: Int = 0;
    if xml_is_name_start(first) == 1 {
        local = first;
        saw_name = 1;
        i = i + 1;
        while i < body_end {
            let c: Int = byte_at(raw, i);
            if xml_is_name_cont(c) == 0 { break; }
            i = i + 1;
        }
        if i < body_end {
            if byte_at(raw, i) == 58 {
                prefix = local;
                has_prefix = 1;
                local = 0;
                saw_name = 0;
                i = i + 1;
                if i >= body_end { return 0; }
                let ln: Int = byte_at(raw, i);
                if xml_is_name_start(ln) == 0 { return 0; }
                local = ln;
                saw_name = 1;
                i = i + 1;
                while i < body_end {
                    let c: Int = byte_at(raw, i);
                    if xml_is_name_cont(c) == 0 { break; }
                    i = i + 1;
                }
            }
        }
    }
    if saw_name == 0 { return 0; }
    if has_prefix == 1 { return local + 256 * (prefix + 1); }
    return local;
}

// Extract namespace byte from encoded tag id; 0 means no namespace.
pub fn xml_tag_ns(enc: Int) -> Int {
    if enc < 256 { return 0; }
    return (enc / 256) - 1;
}

// Extract local byte from encoded tag id.
pub fn xml_tag_local(enc: Int) -> Int {
    if enc < 256 { return enc; }
    return enc % 256;
}

pub fn xml_well_core(raw: String, fail_closed: Int) -> Int {
    let n: Int = raw.len();
    if n <= 0 { return 0; }
    let mut s0: Int = 0; let mut s1: Int = 0; let mut s2: Int = 0; let mut s3: Int = 0;
    let mut s4: Int = 0; let mut s5: Int = 0; let mut s6: Int = 0; let mut s7: Int = 0;
    let mut s8: Int = 0; let mut s9: Int = 0; let mut s10: Int = 0; let mut s11: Int = 0;
    let mut s12: Int = 0; let mut s13: Int = 0; let mut s14: Int = 0; let mut s15: Int = 0;
    let mut depth: Int = 0;
    let mut i: Int = 0;
    let mut root_count: Int = 0;
    let mut root_enc: Int = 0;
    while i < n {
        let b: Int = byte_at(raw, i);
        if b == 60 {
            if i + 1 >= n { return 0; }
            let n1b: Int = byte_at(raw, i + 1);
            let mut is_end: Int = 0;
            if n1b == 47 { is_end = 1; }
            let tag_end: Int = xml_find_tag_end(raw, i + 1, n);
            if tag_end < 0 { return 0; }
            let mut body_start: Int = i + 1;
            if is_end == 1 { body_start = i + 2; }
            let enc: Int = xml_parse_tag(raw, body_start, tag_end);
            if enc == 0 { return 0; }
            let mut self_close: Int = 0;
            if tag_end > body_start {
                let last: Int = byte_at(raw, tag_end - 1);
                if last == 47 { self_close = 1; }
            }
            if is_end == 1 {
                if depth == 0 { return 0; }
                let top: Int = if depth == 1 { s0 } else if depth == 2 { s1 } else if depth == 3 { s2 }
                    else if depth == 4 { s3 } else if depth == 5 { s4 } else if depth == 6 { s5 }
                    else if depth == 7 { s6 } else if depth == 8 { s7 } else if depth == 9 { s8 }
                    else if depth == 10 { s9 } else if depth == 11 { s10 } else if depth == 12 { s11 }
                    else if depth == 13 { s12 } else if depth == 14 { s13 } else if depth == 15 { s14 }
                    else { s15 };
                if top != enc { return 0; }
                if depth == 1 { s0 = 0; } else if depth == 2 { s1 = 0; } else if depth == 3 { s2 = 0; }
                else if depth == 4 { s3 = 0; } else if depth == 5 { s4 = 0; } else if depth == 6 { s5 = 0; }
                else if depth == 7 { s6 = 0; } else if depth == 8 { s7 = 0; } else if depth == 9 { s8 = 0; }
                else if depth == 10 { s9 = 0; } else if depth == 11 { s10 = 0; } else if depth == 12 { s11 = 0; }
                else if depth == 13 { s12 = 0; } else if depth == 14 { s13 = 0; } else { s15 = 0; }
                depth = depth - 1;
            } else if self_close == 0 {
                depth = depth + 1;
                if depth > 16 { return 0; }
                if depth == 1 { s0 = enc; } else if depth == 2 { s1 = enc; } else if depth == 3 { s2 = enc; }
                else if depth == 4 { s3 = enc; } else if depth == 5 { s4 = enc; } else if depth == 6 { s5 = enc; }
                else if depth == 7 { s6 = enc; } else if depth == 8 { s7 = enc; } else if depth == 9 { s8 = enc; }
                else if depth == 10 { s9 = enc; } else if depth == 11 { s10 = enc; } else if depth == 12 { s11 = enc; }
                else if depth == 13 { s12 = enc; } else if depth == 14 { s13 = enc; } else { s15 = enc; }
            }
            if depth == 0 {
                root_count = root_count + 1;
                if fail_closed == 1 {
                    if root_count > 1 { return 0; }
                } else {
                    if root_count == 1 { root_enc = enc; }
                    if root_count > 1 {
                        if xml_tag_ns(root_enc) == xml_tag_ns(enc) { return 0; }
                    }
                }
            }
            i = tag_end + 1;
        } else {
            i = i + 1;
        }
    }
    if depth != 0 { return 0; }
    if fail_closed == 1 {
        if root_count != 1 { return 0; }
    }
    return 1;
}

pub fn xml_well_closed(raw: String) -> Int {
    return xml_well_core(raw, 1);
}

pub fn xml_well_coupled(raw: String) -> Int {
    return xml_well_core(raw, 0);
}

pub fn xml_parse_tag_attrs(raw: String, body_start: Int, body_end: Int) -> Int {
    return xml_parse_tag(raw, body_start, body_end);
}

pub fn xml_well_formed_holds(raw: String) -> DomainCert {
    let h: Int = xml_well_closed(raw);
    return domain_cert("markup", "xml_well_formed", h);
}

pub fn verify_xml_well_formed_theory() -> Bool {
    if xml_well_closed("<a><b/></a>") != 1 { return false; }
    if xml_well_closed("<a><b></a></b>") != 0 { return false; }
    if xml_well_closed("") != 0 { return false; }
    if xml_well_closed("</a>") != 0 { return false; }
    if xml_well_closed("<a>") != 0 { return false; }
    if xml_well_closed("<a><b><c/></b></a>") != 1 { return false; }
    if xml_well_closed("<a x=\"1\"><b/></a>") != 1 { return false; }
    if xml_well_closed("<a><b/></a><c/>") != 0 { return false; }
    if xml_well_coupled("<a x=\"1\"><b/></a>") != 1 { return false; }
    if xml_well_coupled("") != 0 { return false; }
    if xml_well_coupled("<a/><b/>") != 0 { return false; }
    if xml_well_coupled("<a><b/></a><c/>") != 0 { return false; }
    if xml_well_coupled("<x:a/><y:b/>") != 1 { return false; }
    if xml_well_coupled("<x:a><y:b/></x:a>") != 1 { return false; }
    if xml_well_coupled("<x:a><y:b></x:a></y:b>") != 0 { return false; }
    if xml_parse_tag_attrs("<a x=\"1\">", 1, 9) != 97 { return false; }
    if xml_parse_tag_attrs("<a x='1' y=\"2\">", 1, 15) != 97 { return false; }
    if xml_tag_ns(97) != 0 { return false; }
    if xml_tag_ns(256 * 121 + 97) != 120 { return false; }
    if xml_tag_local(256 * 121 + 97) != 97 { return false; }
    let c1: DomainCert = xml_well_formed_holds("<a><b/></a>");
    if c1.holds != 1 { return false; }
    if c1.domain != "markup" { return false; }
    let c2: DomainCert = xml_well_formed_holds("<a><b></a></b>");
    if c2.holds != 0 { return false; }
    return true;
}
