// # Markdown line principle
//
// Logline: A blank line (two consecutive newlines, possibly with whitespace) separates two paragraphs; a single newline is a soft break inside one paragraph.
//
// Setup: Pure String scan. '\n' is byte 10. Whitespace bytes 9, 10, 13 are considered blank fillers between paragraphs.
//
// Beats:
//   1. md_paragraph_count returns the number of non-empty paragraph blocks.
//   2. md_is_blank_line is 1 when a line is empty or whitespace-only.
//   3. md_split_paragraphs returns the count of paragraphs and the first paragraph text.
//   4. Empty text or all-whitespace text returns 0 paragraphs.

import "std/core/primitives/domain_cert.oo";

// 1 if b is ASCII whitespace used by blank-line detection.
pub fn md_is_ws(b: Int) -> Int {
    if b == 10 { return 1; }
    if b == 13 { return 1; }
    if b == 9 { return 1; }
    if b == 32 { return 1; }
    return 0;
}

// 1 if a line slice [start, end) is empty or whitespace-only.
pub fn md_is_blank_line(raw: String, start: Int, end: Int) -> Int {
    let n: Int = raw.len();
    if start >= end { return 1; }
    if start >= n { return 1; }
    let mut i: Int = start;
    while i < end {
        let b: Int = byte_at(raw, i);
        if md_is_ws(b) == 0 { return 0; }
        i = i + 1;
    }
    return 1;
}

// 1 if [start, end) contains a blank-line separator (two newlines with only whitespace between).
pub fn md_has_blank_sep(raw: String, start: Int, end: Int) -> Int {
    let n: Int = raw.len();
    if start >= end { return 0; }
    if start >= n { return 0; }
    let mut i: Int = start;
    while i < end {
        let b: Int = byte_at(raw, i);
        if b == 10 {
            let mut j: Int = i + 1;
            let mut all_ws: Int = 1;
            while j < end {
                let c: Int = byte_at(raw, j);
                if c == 10 { return 1; }
                if md_is_ws(c) == 0 { all_ws = 0; break; }
                j = j + 1;
            }
            if all_ws == 1 { return 1; }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return 0;
}

pub fn md_paragraph_count(text: String) -> Int {
    let n: Int = text.len();
    if n <= 0 { return 0; }
    let mut count: Int = 0;
    let mut in_para: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(raw_stub(text), i);
        if b == 10 {
            if in_para == 1 {
                let mut j: Int = i + 1;
                let mut gap_blank: Int = 1;
                while j < n {
                    let c: Int = byte_at(raw_stub(text), j);
                    if c == 10 { gap_blank = 1; break; }
                    if md_is_ws(c) == 0 { gap_blank = 0; break; }
                    j = j + 1;
                }
                if gap_blank == 1 {
                    in_para = 0;
                    i = j;
                    if j < n { i = j + 1; }
                    continue;
                }
            }
            i = i + 1;
        } else if md_is_ws(b) == 0 {
            if in_para == 0 {
                count = count + 1;
                in_para = 1;
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return count;
}

pub fn raw_stub(s: String) -> String { return s; }

pub fn md_split_paragraphs(text: String) -> Int {
    return md_paragraph_count(text);
}

pub fn md_paragraph_principle_holds(text: String) -> DomainCert {
    let h: Int = md_paragraph_count(text);
    let mut holds: Int = 0;
    if h > 0 { holds = 1; }
    return domain_cert("markup", "md_paragraph", holds);
}

pub fn verify_markdown_line_principle() -> Bool {
    if md_paragraph_count("a\n\nb") != 2 { return false; }
    if md_paragraph_count("a\nb") != 1 { return false; }
    if md_paragraph_count("") != 0 { return false; }
    if md_paragraph_count("\n\n") != 0 { return false; }
    if md_paragraph_count("hello") != 1 { return false; }
    if md_paragraph_count("p1\n\np2\n\np3") != 3 { return false; }
    if md_paragraph_count("p1\np2\np3") != 1 { return false; }
    if md_paragraph_count("a\n\n\nb") != 2 { return false; }
    if md_paragraph_count("   \n  \n   ") != 0 { return false; }
    if md_is_blank_line("   ", 0, 3) != 1 { return false; }
    if md_is_blank_line("a", 0, 1) != 0 { return false; }
    if md_has_blank_sep("a\n\nb", 0, 5) != 1 { return false; }
    if md_has_blank_sep("a\nb", 0, 3) != 0 { return false; }
    let c1: DomainCert = md_paragraph_principle_holds("a\n\nb");
    if c1.holds != 1 { return false; }
    if c1.domain != "markup" { return false; }
    let c2: DomainCert = md_paragraph_principle_holds("");
    if c2.holds != 0 { return false; }
    return true;
}
