// # Markup angle-bracket balance law
//
// Logline: Unclosed "<a" is not well-formed; count of < must equal count of >.
//
// Setup: Pure byte scan. ASCII '<' is 60, '>' is 62.
//
// Beats:
//   1. markup_balanced("<a>") holds=1.
//   2. markup_balanced("<a") holds=0.
//   3. domain_cert boxes the holds bit for the markup domain.
//
// residual: angle counts only; not a full XML/HTML parser

import "std/core/primitives/domain_cert.oo";
pub fn markup_balanced(raw: String) -> Int {
    let n: Int = raw.len();
    let mut i: Int = 0;
    let mut open_n: Int = 0;
    let mut close_n: Int = 0;
    while i < n {
        let b: Int = byte_at(raw, i);
        if b == 60 {
            open_n = open_n + 1;
        }
        if b == 62 {
            close_n = close_n + 1;
        }
        i = i + 1;
    }
    if open_n == close_n {
        return 1;
    }
    return 0;
}

pub fn markup_balance_law(raw: String) -> DomainCert {
    return domain_cert("markup", "balanced", markup_balanced(raw));
}
