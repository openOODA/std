// # Markup brace balance and tag nesting law
//
// Logline: Brace and bracket counts must balance, and tags must close in LIFO order so the close tag matches the most recent open tag.
//
// Setup: Pure ASCII byte scan. ASCII '{' is 123, '}' is 125, '[' is 91, ']' is 93, '<' is 60, '>' is 62, '/' is 47.
//
// Beats:
//   1. markup_balance holds 1 only when open and close brace and bracket counts match.
//   2. tag_stack_close_lifo holds 1 only when each close tag matches the most recent open tag and the stack returns to empty.
//   3. Empty input and unclosed or out-of-order tags fail closed to 0.

import "std/core/primitives/domain_cert.oo";

pub fn markup_balance(raw: String) -> Int {
    let n: Int = raw.len();
    if n <= 0 {
        return 0;
    }
    let mut i: Int = 0;
    let mut brace_open: Int = 0;
    let mut brace_close: Int = 0;
    let mut brack_open: Int = 0;
    let mut brack_close: Int = 0;
    while i < n {
        let b: Int = byte_at(raw, i);
        if b == 123 {
            brace_open = brace_open + 1;
        }
        if b == 125 {
            brace_close = brace_close + 1;
        }
        if b == 91 {
            brack_open = brack_open + 1;
        }
        if b == 93 {
            brack_close = brack_close + 1;
        }
        i = i + 1;
    }
    if brace_open == brace_close {
        if brack_open == brack_close {
            return 1;
        }
    }
    return 0;
}

pub fn tag_stack_close_lifo(raw: String) -> Int {
    let n: Int = raw.len();
    if n <= 0 {
        return 0;
    }
    let mut i: Int = 0;
    let mut s0: Int = 0;
    let mut s1: Int = 0;
    let mut s2: Int = 0;
    let mut s3: Int = 0;
    let mut depth: Int = 0;
    while i < n {
        let b: Int = byte_at(raw, i);
        if b == 60 {
            if i + 1 < n {
                let n1: Int = byte_at(raw, i + 1);
                if n1 == 47 {
                    if depth == 0 {
                        return 0;
                    }
                    if i + 2 >= n {
                        return 0;
                    }
                    let tag_id: Int = byte_at(raw, i + 2);
                    let mut ok: Int = 0;
                    if depth == 1 {
                        if s0 == tag_id {
                            ok = 1;
                        }
                    } else if depth == 2 {
                        if s1 == tag_id {
                            ok = 1;
                        }
                    } else if depth == 3 {
                        if s2 == tag_id {
                            ok = 1;
                        }
                    } else {
                        if s3 == tag_id {
                            ok = 1;
                        }
                    }
                    if ok == 0 {
                        return 0;
                    }
                    if depth == 1 { s0 = 0; }
                    else if depth == 2 { s1 = 0; }
                    else if depth == 3 { s2 = 0; }
                    else { s3 = 0; }
                    depth = depth - 1;
                } else {
                    if n1 == 62 {
                        return 0;
                    }
                    let tag_id: Int = n1;
                    if depth == 0 { s0 = tag_id; }
                    else if depth == 1 { s1 = tag_id; }
                    else if depth == 2 { s2 = tag_id; }
                    else { s3 = tag_id; }
                    depth = depth + 1;
                    if depth > 4 {
                        return 0;
                    }
                }
            }
        }
        i = i + 1;
    }
    if depth == 0 {
        return 1;
    }
    return 0;
}

pub fn verify_markup_balance_nest_law() -> Bool {
    if markup_balance("{\"a\":[1,2,3]}") != 1 {
        return false;
    }
    if markup_balance("{\"a\":[1,2}") != 0 {
        return false;
    }
    if markup_balance("[[[]]]") != 1 {
        return false;
    }
    if markup_balance("") != 0 {
        return false;
    }
    if tag_stack_close_lifo("<a><b></b></a>") != 1 {
        return false;
    }
    if tag_stack_close_lifo("<a><b></a></b>") != 0 {
        return false;
    }
    if tag_stack_close_lifo("</a>") != 0 {
        return false;
    }
    if tag_stack_close_lifo("") != 0 {
        return false;
    }
    if tag_stack_close_lifo("<a>") != 0 {
        return false;
    }
    if tag_stack_close_lifo("<a><b><c></c></b></a>") != 1 {
        return false;
    }
    return true;
}
