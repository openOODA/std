// # Welford online variance theory
//
// Logline: Numerically stable one-pass variance via Welford. Combine two
//   partial Welford states and recover the single-pass result.
//
// Setup: Pure Float. combine fails closed if either count<0. variance
//   is m2/n for n>=2; count<2 is Err (0 variance is only a constant n>=2 identity).
//
// Beats:
//   1. welford_update_* on a fresh state advance count, mean, m2 by one.
//   2. variance(m2, count) = m2 / n for n>=2; Err for n<2.
//   3. welford_combine merges two Welford states by parallel-merge.
//   4. Constant nonempty sample with n>=2 has variance 0.

import "std/core/primitives/domain_cert.oo";

type WelfordState = struct {
    count: Int,
    mean: Float,
    m2: Float
};

fn pabs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn wf_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

pub fn welford_update_count(c: Int) -> Int {
    return c + 1;
}

pub fn welford_update_mean(c: Int, m: Float, x: Float) -> Float {
    let n: Float = 1.0 * (c) + 1.0;
    return m + (x - m) / n;
}

pub fn welford_update_m2(c: Int, m: Float, m2: Float, x: Float) -> Float {
    let n: Float = 1.0 * (c) + 1.0;
    let delta: Float = x - m;
    return m2 + delta * (x - (m + delta / n));
}

pub fn welford_state_new() -> WelfordState {
    return WelfordState { count: 0, mean: 0.0, m2: 0.0 };
}

pub fn welford_state_update(s: WelfordState, x: Float) -> WelfordState {
    let nm: Float = welford_update_mean(s.count, s.mean, x);
    let nm2: Float = welford_update_m2(s.count, s.mean, s.m2, x);
    return WelfordState { count: welford_update_count(s.count), mean: nm, m2: nm2 };
}

pub fn welford_variance(s: WelfordState) -> Result[Float, String] {
    if s.count < 2 { return Err("ERR\twelford\tn"); }
    let n: Float = 1.0 * (s.count);
    return Ok(s.m2 / n);
}

pub fn welford_combine(a: WelfordState, b: WelfordState) -> Result[WelfordState, String] {
    if a.count < 0 { return Err("ERR\twelford\tcount"); }
    if b.count < 0 { return Err("ERR\twelford\tcount"); }
    let n: Int = a.count + b.count;
    if n == 0 { return Ok(welford_state_new()); }
    let naf: Float = 1.0 * (a.count);
    let nbf: Float = 1.0 * (b.count);
    let nf: Float = naf + nbf;
    let delta: Float = b.mean - a.mean;
    return Ok(WelfordState {
        count: n,
        mean: a.mean + delta * nbf / nf,
        m2: a.m2 + b.m2 + delta * delta * (naf * nbf / nf)
    });
}

fn check_welford_close(s: WelfordState) -> Int {
    let v: Float = wf_got(welford_variance(s));
    let m: Float = s.mean;
    if pabs(m - 5.5) <= 0.000000001 {
        if pabs(v - 8.25) <= 0.000000001 { return 1; }
    }
    return 0;
}

pub fn math_welford_sequence_1_to_10() -> DomainCert {
    let mut s: WelfordState = welford_state_new();
    let mut i: Int = 1;
    while i <= 10 {
        s = welford_state_update(s, 1.0 * (i));
        i = i + 1;
    }
    return domain_cert("math", "welford_seq_1_10", check_welford_close(s));
}

pub fn math_welford_combine_parity() -> DomainCert {
    let mut s1: WelfordState = welford_state_new();
    let mut s2: WelfordState = welford_state_new();
    let mut i: Int = 1;
    while i <= 5 {
        s1 = welford_state_update(s1, 1.0 * (i));
        i = i + 1;
    }
    let mut j: Int = 6;
    while j <= 10 {
        s2 = welford_state_update(s2, 1.0 * (j));
        j = j + 1;
    }
    let scr: Result[WelfordState, String] = welford_combine(s1, s2);
    match scr {
        Ok(sc) => { return domain_cert("math", "welford_combine_parity", check_welford_close(sc)); },
        Err(_) => { return domain_cert("math", "welford_combine_parity", 0); }
    }
}

pub fn math_welford_bad_count_fails_closed() -> DomainCert {
    let bad: WelfordState = WelfordState { count: 0 - 1, mean: 0.0, m2: 0.0 };
    let r: Result[WelfordState, String] = welford_combine(bad, welford_state_new());
    let mut h: Int = 0;
    if r.is_err() { h = 1; }
    return domain_cert("math", "welford_bad_count_closed", h);
}

pub fn math_welford_n_lt_2_fails_closed() -> DomainCert {
    let r0: Result[Float, String] = welford_variance(welford_state_new());
    let r1: Result[Float, String] = welford_variance(welford_state_update(welford_state_new(), 1.0));
    let mut h: Int = 0;
    if r0.is_err() {
        if r1.is_err() { h = 1; }
    }
    return domain_cert("math", "welford_n_lt_2_closed", h);
}

pub fn math_welford_constant_zero_var(x: Float, n: Int) -> DomainCert {
    let mut s: WelfordState = welford_state_new();
    let mut i: Int = 0;
    while i < n {
        s = welford_state_update(s, x);
        i = i + 1;
    }
    let r: Result[Float, String] = welford_variance(s);
    let mut h: Int = 0;
    match r {
        Ok(v)  => { if pabs(v) <= 0.000000001 { h = 1; } },
        Err(_) => { h = 0; }
    }
    return domain_cert("math", "welford_const_zero_var", h);
}

pub fn verify_welford_online_variance_theory() -> Bool {
    let a: DomainCert = math_welford_sequence_1_to_10();
    let b: DomainCert = math_welford_combine_parity();
    let c: DomainCert = math_welford_bad_count_fails_closed();
    let d: DomainCert = math_welford_n_lt_2_fails_closed();
    let e: DomainCert = math_welford_constant_zero_var(5.0, 4);
    if a.holds != 1 { return false; }
    if b.holds != 1 { return false; }
    if c.holds != 1 { return false; }
    if d.holds != 1 { return false; }
    if e.holds != 1 { return false; }
    if math_welford_constant_zero_var(5.0, 1).holds != 0 { return false; }
    if math_welford_constant_zero_var(5.0, 0).holds != 0 { return false; }
    if welford_variance(welford_state_new()).is_ok() { return false; }
    if welford_variance(welford_state_update(welford_state_new(), 1.0)).is_ok() { return false; }
    return true;
}
