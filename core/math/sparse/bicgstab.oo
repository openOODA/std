// # BiCGSTAB Sparse Linear Solver
//
// Logline: Solves non-symmetric sparse Ax = b with van der Vorst BiCGSTAB on CSR arrays.
//
// Setup: Pure math module. Zero ambient effects.
//
// Beats:
//   1. Seed r = b, rhat = r, and zero search vectors with x = 0.
//   2. Update p, v = A p, s = r - alpha v, then t = A s and omega.
//   3. Fail closed on rhat·v = 0, t·t = 0, or max_iter without ||r|| < tol.

import "std/core/primitives/result.oo";
import "std/core/math/sparse/csr_matrix.oo";

fn bs_zeros(n: Int) -> List[Float] {
    let mut v: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        v = list_push(v, 0.0);
        i = i + 1;
    }
    return v;
}

fn bs_dot(a: List[Float], b: List[Float]) -> Float {
    let n: Int = list_len(a);
    let mut s: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        s = s + list_get(a, i) * list_get(b, i);
        i = i + 1;
    }
    return s;
}

fn bs_axpy(a: Float, x: List[Float], y: List[Float]) -> List[Float] {
    let n: Int = list_len(y);
    let mut o: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        o = list_push(o, a * list_get(x, i) + list_get(y, i));
        i = i + 1;
    }
    return o;
}

fn bs_nrm(x: List[Float]) -> Float {
    return sqrt(bs_dot(x, x));
}

pub fn bicgstab_solve(row_ptr: List[Int], col_idx: List[Int], values: List[Float], n: Int, b: List[Float], max_iter: Int, tol: Float) -> Result[List[Float], String] {
    if n < 1 { return Err("ERR\tbicgstab\tn"); }
    if max_iter < 1 { return Err("ERR\tbicgstab\tmax_iter"); }
    if list_len(b) != n { return Err("ERR\tbicgstab\tb"); }
    if list_len(row_ptr) != n + 1 { return Err("ERR\tbicgstab\trow_ptr"); }
    if list_len(col_idx) != list_len(values) { return Err("ERR\tbicgstab\tnnz"); }
    let mut x: List[Float] = bs_zeros(n);
    let mut rk: List[Float] = b;
    if bs_nrm(rk) < tol { return Ok(x); }
    let rhat: List[Float] = rk;
    let mut pk: List[Float] = bs_zeros(n);
    let mut vk: List[Float] = bs_zeros(n);
    let mut rho: Float = 1.0;
    let mut alpha: Float = 1.0;
    let mut omega: Float = 1.0;
    let mut it: Int = 0;
    while it < max_iter {
        let rho_new: Float = bs_dot(rhat, rk);
        if rho_new == 0.0 { return Err("ERR\tbicgstab\tbreakdown"); }
        if omega == 0.0 { return Err("ERR\tbicgstab\tbreakdown"); }
        let beta: Float = (rho_new / rho) * (alpha / omega);
        let pwo: List[Float] = bs_axpy(0.0 - omega, vk, pk);
        pk = bs_axpy(beta, pwo, rk);
        let vr: Result[List[Float], String] = csr_spmv(row_ptr, col_idx, values, n, pk);
        vk = match vr {
            Ok(v)  => v,
            Err(e) => { return Err(e); }
        };
        let rhatv: Float = bs_dot(rhat, vk);
        if rhatv == 0.0 { return Err("ERR\tbicgstab\tbreakdown"); }
        alpha = rho_new / rhatv;
        let sk: List[Float] = bs_axpy(0.0 - alpha, vk, rk);
        if bs_nrm(sk) < tol {
            x = bs_axpy(alpha, pk, x);
            return Ok(x);
        }
        let tr: Result[List[Float], String] = csr_spmv(row_ptr, col_idx, values, n, sk);
        let tk: List[Float] = match tr {
            Ok(v)  => v,
            Err(e) => { return Err(e); }
        };
        let tt: Float = bs_dot(tk, tk);
        if tt == 0.0 { return Err("ERR\tbicgstab\tbreakdown"); }
        omega = bs_dot(tk, sk) / tt;
        x = bs_axpy(alpha, pk, x);
        x = bs_axpy(omega, sk, x);
        rk = bs_axpy(0.0 - omega, tk, sk);
        if bs_nrm(rk) < tol { return Ok(x); }
        rho = rho_new;
        it = it + 1;
    }
    return Err("ERR\tbicgstab\tmax_iter");
}
