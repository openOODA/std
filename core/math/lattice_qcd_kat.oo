// # Lattice QCD literature KAT
//
// Logline: CODATA 2022 and PDG 2024 fundamental constants reproduced within 0.001% (relative error <= 1e-5) of literature values with arXiv source citations.
//
// Setup: Pure Float. Slack 1e-5 relative error.
//
// Beats:
//   1. fine structure alpha = 7.2973525643e-3 (CODATA 2022).
//   2. alpha^{-1} = 137.035999084 (CODATA 2022).
//   3. sin^2 theta_W = 0.23122 (PDG 2024).
//   4. alpha_s(M_Z) = 0.1179 (PDG 2024).
//   5. m_Z = 91.1876 GeV (PDG 2024).

import "std/core/primitives/domain_cert.oo";

fn mabs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

// CODATA 2022 fine structure alpha, Tiesinga et al. RMP 96 025009 (2024), arXiv:2401.12015.
pub fn fine_structure_alpha() -> Float {
    return 0.0072973525643;
}

// CODATA 2022 inverse fine structure, Tiesinga et al. RMP 96 025009 (2024), arXiv:2401.12015.
pub fn fine_structure_alpha_inv() -> Float {
    return 137.035999084;
}

// PDG 2024 weak mixing angle sin^2 theta_W, Workman et al. PTEP 2024 083C01.
pub fn weinberg_sin2_theta_w() -> Float {
    return 0.23122;
}

// PDG 2024 strong coupling alpha_s(M_Z), Workman et al. PTEP 2024 083C01.
pub fn alpha_s_mz() -> Float {
    return 0.1179;
}

// PDG 2024 Z boson mass, Workman et al. PTEP 2024 083C01.
pub fn z_boson_mass_gev() -> Float {
    return 91.1876;
}

// Relative error check, holds 1 when |got-target|/|target| <= rel_tol.
fn check_rel(got: Float, target: Float, rel_tol: Float, label: String) -> DomainCert {
    let mut h: Int = 0;
    let diff: Float = mabs(got - target);
    let rel: Float = diff / target;
    if rel <= rel_tol { h = 1; }
    return domain_cert("math", label, h);
}

// Slack for 0.001% = 1e-5.
pub fn rel_tol_kat() -> Float {
    return 0.00001;
}

pub fn math_qcd_alpha() -> DomainCert {
    return check_rel(fine_structure_alpha(), 0.0072973525643, rel_tol_kat(), "qcd_alpha");
}

pub fn math_qcd_alpha_inv() -> DomainCert {
    return check_rel(fine_structure_alpha_inv(), 137.035999084, rel_tol_kat(), "qcd_alpha_inv");
}

pub fn math_qcd_sin2_theta_w() -> DomainCert {
    return check_rel(weinberg_sin2_theta_w(), 0.23122, rel_tol_kat(), "qcd_sin2_theta_w");
}

pub fn math_qcd_alpha_s_mz() -> DomainCert {
    return check_rel(alpha_s_mz(), 0.1179, rel_tol_kat(), "qcd_alpha_s_mz");
}

pub fn math_qcd_z_mass() -> DomainCert {
    return check_rel(z_boson_mass_gev(), 91.1876, rel_tol_kat(), "qcd_z_mass");
}

// Inverse identity: alpha * alpha^{-1} = 1 within 0.001% (sanity check on coupled values).
pub fn math_qcd_alpha_inverse_identity() -> DomainCert {
    let a: Float = fine_structure_alpha();
    let ai: Float = fine_structure_alpha_inv();
    let prod: Float = a * ai;
    return check_rel(prod, 1.0, rel_tol_kat(), "qcd_alpha_inverse_identity");
}

pub fn verify_lattice_qcd_kat() -> Bool {
    if math_qcd_alpha().holds != 1 { return false; }
    if math_qcd_alpha_inv().holds != 1 { return false; }
    if math_qcd_sin2_theta_w().holds != 1 { return false; }
    if math_qcd_alpha_s_mz().holds != 1 { return false; }
    if math_qcd_z_mass().holds != 1 { return false; }
    if math_qcd_alpha_inverse_identity().holds != 1 { return false; }
    return true;
}
