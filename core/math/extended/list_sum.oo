// # List Sum
//
// Logline: Standard library verification and domain capabilities for List Sum.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn verify_list_sum() -> Bool {
    let mut xs: List[Int] = list_new();
    xs = xs.push(1);
    xs = xs.push(2);
    xs = xs.push(3);
    let mut s = 0;
    for x in xs {
        s = s + x;
    }
    println(s);
    return true;
}
