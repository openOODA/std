// # Libfloor Tcp
//
// Logline: Standard library verification and domain capabilities for Libfloor Tcp.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn verify_libfloor_tcp() -> Bool {
    let r: Result[String, String] = tcp_connect(net, "127.0.0.1", 1);
    if r.is_ok() {
        println("tcp-connected");
    } else {
        // connection refused / resolve fail are product Err (not residual stub)
        println("tcp-err-ok");
    }
    let b: Result[String, String] = tcp_bind(net, 0);
    // port 0 is bad in path A (1..65535)
    if b.is_err() {
        println("tcp-bind-badport-ok");
    }
    return true;
}
