pub fn pack() -> List[String] {
    let mut r: List[String] = list_new();
    r = list_push(r, "TOK");
    return r;
}
pub fn verify_list_string_return_ann() -> Bool {
    let x = pack();
    println(list_len(x));
    return true;
}
