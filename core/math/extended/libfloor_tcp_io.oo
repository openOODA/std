// # Libfloor Tcp Io
//
// Logline: Standard library verification and domain capabilities for Libfloor Tcp Io.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn verify_libfloor_tcp_io() -> Bool {
    let c: Result[String, String] = tcp_connect(net, "127.0.0.1", 1);
    if c.is_err() {
        println("tcp-io-connect-err-ok");
    } else {
        // unexpected listener on :1 — still exercise close on slot 0
        let w: Result[String, String] = tcp_write(net, 0, "ping");
        let r: Result[String, String] = tcp_read(net, 0, 64);
        let x: Result[String, String] = tcp_close(net, 0);
        if w.is_ok() {
            if r.is_ok() {
                if x.is_ok() {
                    println("tcp-io-ok");
                } else {
                    println("tcp-io-close-fail");
                }
            } else {
                println("tcp-io-read-fail");
            }
        } else {
            println("tcp-io-write-fail");
        }
    }
    let raw: Result[String, String] = sock_raw(net, 0);
    if raw.is_err() {
        println("sock-raw-residual-ok");
    }
    return true;
}
