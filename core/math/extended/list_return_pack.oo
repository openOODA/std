// # List Return Pack
//
// Logline: Standard library verification and domain capabilities for List Return Pack.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn pack_ints() -> List[Int] {
    let mut xs = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 2);
    return xs;
}
pub fn pack_strs() -> List[String] {
    let mut xs = list_new();
    xs = list_push(xs, "a");
    xs = list_push(xs, "b");
    return xs;
}
pub fn verify_list_return_pack() -> Bool {
    let a = pack_ints();
    let b = pack_strs();
    println(list_len(a));
    println(list_len(b));
    return true;
}
