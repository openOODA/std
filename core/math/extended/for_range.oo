// # For Range
//
// Logline: Standard library verification and domain capabilities for For Range.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn verify_for_range() -> Bool {
    let mut s = 0;
    for i in 0..5 {
        s = s + i;
    }
    println(s);
    return true;
}
