// # Libfloor Sys Spawn
//
// Logline: Standard library verification and domain capabilities for Libfloor Sys Spawn.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn verify_libfloor_sys_spawn() -> Bool {
    match sys_spawn(sys, "true") {
        Ok(s)          => {
            match sys_wait(sys, -1) {
                Ok(st) => println("ok"),
                Err(e) => println(e) }
        }
        Err(e) => println(e) }
    match sys_kill(sys, 0, 9) {
        Ok(s)  => println("unexpected-kill-ok"),
        Err(e) => println("kill-zero-refused") }
    return true;
}
