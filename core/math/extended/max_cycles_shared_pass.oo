//   2. Verify invariants and return typed results.

pub fn verify_max_cycles_shared_pass() -> Bool {
    let mut a = 0;
    while a < 2 {
        a = a + 1;
    }
    let mut b = 0;
    while b < 2 {
        b = b + 1;
    }
    println(a + b);
    return true;
}
