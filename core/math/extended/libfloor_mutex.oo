// # Libfloor Mutex
//
// Logline: Standard library verification and domain capabilities for Libfloor Mutex.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

pub fn verify_libfloor_mutex() -> Bool {
    let lk: Result[String, String] = mutex_lock(thread, 1);
    if lk.is_ok() {
        println("mutex-lock-ok");
    } else {
        println("mutex-lock-fail");
    }
    let uk: Result[String, String] = mutex_unlock(thread, 1);
    if uk.is_ok() {
        println("mutex-unlock-ok");
    } else {
        println("mutex-unlock-fail");
    }
    return true;
}
