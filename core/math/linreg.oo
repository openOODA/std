// # Linear Regression and Least Squares Fitting Module
//
// Logline: Two-point ordinary least squares slope, intercept, and predict.
//
// Setup: Pure math. Emit-c lowers List[Float] add as string concat, so fit is two points.
//
// Beats:
//   1. Slope (y1-y0)/(x1-x0) and intercept y0 - slope*x0.
//   2. Predict y = slope*x + intercept.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: List[Float] OLS / Pearson r emit concat

pub fn linreg_slope2(x0: Float, y0: Float, x1: Float, y1: Float) -> Result[Float, String] {
    let dx: Float = x1 - x0;
    if dx == 0.0 {
        return Err("ERR\tlinreg\tvertical");
    }
    return Ok((y1 - y0) / dx);
}

pub fn linreg_intercept2(x0: Float, y0: Float, x1: Float, y1: Float) -> Result[Float, String] {
    let sr: Result[Float, String] = linreg_slope2(x0, y0, x1, y1);
    match sr {
        Ok(s)  => { return Ok(y0 - s * x0); },
        Err(e) => { return Err(e); }
    }
}

pub fn linreg_predict2(slope: Float, intercept: Float, x: Float) -> Float {
    return slope * x + intercept;
}
