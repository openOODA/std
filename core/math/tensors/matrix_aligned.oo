// # Cache-Line Aligned Integer Matrix Buffer
//
// Logline: 64-byte cache-line aligned 2D integer matrix buffers padded so each row starts on a cache-line boundary for SIMD vectorization and GPU kernel launches.
//
// Setup: Pure module. Stores Int cells in a flat row-major List[Int] sized at rows * padded_cols, where padded_cols is the smallest multiple of 16 that is greater than or equal to cols. The total byte count is always a multiple of 64.
//
// Beats:
//   1. Expose cache-line constants (64 bytes, 16 ints, padded column rounding).
//   2. Allocate zero-initialized MatrixAligned buffers via Result constructors.
//   3. Provide row-major element access with immutable setter rebuilds.
//   4. Report shape, padded stride, total bytes, alignment, row offset, and a string dump.
//
// residual: GPU device memory upload and direct AVX-512 intrinsics remain in backend C; this file is the pure shape.

import "std/hw/runtime/rt_str_format.oo";

type MatrixAligned = struct {
    rows: Int,
    cols: Int,
    padded_cols: Int,
    stride: Int,
    data: List[Int]
};

// Cache line size in bytes for x86_64, ARMv8, and RISC-V.
pub fn matrix_aligned_cache_line() -> Int {
    return 64;
}

// Number of 8-byte ints that fit in one cache line (64 / 8 == 16).
pub fn matrix_aligned_int_per_line() -> Int {
    return 16;
}

// Round cols up to the smallest multiple of 16.
pub fn matrix_aligned_max_cols_padded(rows: Int, cols: Int) -> Int {
    let sixteen: Int = matrix_aligned_int_per_line();
    let rem: Int = cols - (cols / sixteen) * sixteen;
    if rem == 0 {
        return cols;
    }
    return cols + (sixteen - rem);
}

// Allocate an uninitialized buffer shape descriptor. Data is empty until ma_zero.
pub fn ma_new(rows: Int, cols: Int) -> Result[MatrixAligned, String] {
    if rows < 1 {
        return Err("ERR\tmatrix_aligned: rows must be >= 1");
    }
    if cols < 1 {
        return Err("ERR\tmatrix_aligned: cols must be >= 1");
    }
    let padded: Int = matrix_aligned_max_cols_padded(rows, cols);
    return Ok(MatrixAligned {
        rows: rows,
        cols: cols,
        padded_cols: padded,
        stride: padded,
        data: list_new()
    });
}

// Allocate a zero-initialized MatrixAligned buffer of given logical rows and cols.
pub fn ma_zero(rows: Int, cols: Int) -> Result[MatrixAligned, String] {
    if rows < 1 {
        return Err("ERR\tmatrix_aligned: rows must be >= 1");
    }
    if cols < 1 {
        return Err("ERR\tmatrix_aligned: cols must be >= 1");
    }
    let padded: Int = matrix_aligned_max_cols_padded(rows, cols);
    let total: Int = rows * padded;
    let mut buf: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        buf = list_push(buf, 0);
        i = i + 1;
    }
    return Ok(MatrixAligned {
        rows: rows,
        cols: cols,
        padded_cols: padded,
        stride: padded,
        data: buf
    });
}

// Read element at logical (r, c). Padded cells stay invisible.
pub fn ma_get(m: MatrixAligned, r: Int, c: Int) -> Int {
    let base: Int = r * m.padded_cols;
    let idx: Int = base + c;
    return list_get(m.data, idx);
}

// Replace element at logical (r, c) returning a new MatrixAligned.
pub fn ma_set(m: MatrixAligned, r: Int, c: Int, v: Int) -> MatrixAligned {
    let padded: Int = m.padded_cols;
    let target: Int = r * padded + c;
    let total: Int = list_len(m.data);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        if i == target {
            out = list_push(out, v);
        } else {
            out = list_push(out, list_get(m.data, i));
        }
        i = i + 1;
    }
    return MatrixAligned {
        rows: m.rows,
        cols: m.cols,
        padded_cols: padded,
        stride: padded,
        data: out
    };
}

// Logical row count.
pub fn ma_rows(m: MatrixAligned) -> Int {
    return m.rows;
}

// Logical column count.
pub fn ma_cols(m: MatrixAligned) -> Int {
    return m.cols;
}

// Padded column count (smallest multiple of 16 >= cols).
pub fn ma_padded_cols(m: MatrixAligned) -> Int {
    return m.padded_cols;
}

// Row pitch in bytes (padded_cols * 8).
pub fn ma_pitch_bytes(m: MatrixAligned) -> Int {
    return m.padded_cols * 8;
}

// Total backing buffer size in bytes (rows * padded_cols * 8).
pub fn ma_total_bytes(m: MatrixAligned) -> Int {
    return m.rows * m.padded_cols * 8;
}

// 1 when total buffer is a multiple of 64 bytes, 0 otherwise.
pub fn ma_is_aligned(m: MatrixAligned) -> Int {
    let total: Int = ma_total_bytes(m);
    let line: Int = matrix_aligned_cache_line();
    let rem: Int = total - (total / line) * line;
    if rem == 0 {
        return 1;
    }
    return 0;
}

// Starting byte offset of row r in the conceptual buffer.
pub fn ma_row_offset(m: MatrixAligned, r: Int) -> Int {
    return r * m.padded_cols;
}

// Render a human-readable dump of the logical matrix.
pub fn ma_dump(m: MatrixAligned) -> String {
    let r: Int = m.rows;
    let c: Int = m.cols;
    let mut out: String = "MatrixAligned(" + int_to_str(r) + "x" + int_to_str(c) + ", padded_cols=" + int_to_str(m.padded_cols) + ")\n";
    let mut i: Int = 0;
    while i < r {
        out = out + "  [";
        let mut j: Int = 0;
        while j < c {
            let cell: Int = ma_get(m, i, j);
            if j > 0 {
                out = out + ", ";
            }
            out = out + int_to_str(cell);
            j = j + 1;
        }
        out = out + "]\n";
        i = i + 1;
    }
    return out;
}
