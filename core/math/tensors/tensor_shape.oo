// # Multidimensional Tensor Shape & Strides Engine
//
// Logline: Computes row-major contiguous strides, flat index projections, and multidimensional shape broadcasting.
//
// Setup: Pure geometric tensor indexing engine ensuring dimensional safety and boundary checks.
//
// Beats:
//   1. Define TensorShape with dimension bounds, row-major strides, rank, and element count.
//   2. Compute standard C-contiguous stride vectors from dimension lists.
//   3. Project multidimensional coordinates [i, j, k] to contiguous flat buffer offsets.
//   4. Infer broadcast target shapes following NumPy/PyTorch broadcasting rules.

type TensorShape = struct {
    dims: List[Int],
    strides: List[Int],
    rank: Int,
    numel: Int,
    is_contiguous: Bool
};

// Calculate row-major contiguous strides from dimensions list.
pub fn tensor_shape_calc_strides(dims: List[Int]) -> List[Int] {
    let r: Int = list_len(dims);
    let mut strides: List[Int] = list_new();
    if r == 0 {
        return strides;
    }
    // Initialize array of length r
    let mut i: Int = 0;
    while i < r {
        strides = list_push(strides, 1);
        i = i + 1;
    }
    let mut acc: Int = 1;
    let mut j: Int = r - 1;
    while j >= 0 {
        let d: Int = list_get(dims, j);
        // Replace stride at j
        let mut updated: List[Int] = list_new();
        let mut k: Int = 0;
        while k < r {
            if k == j {
                updated = list_push(updated, acc);
            } else {
                updated = list_push(updated, list_get(strides, k));
            }
            k = k + 1;
        }
        strides = updated;
        acc = acc * d;
        j = j - 1;
    }
    return strides;
}

// Create a new TensorShape from dimension list.
pub fn tensor_shape_new(dims: List[Int]) -> Result[TensorShape, String] {
    let r: Int = list_len(dims);
    if r == 0 {
        return Err("ERR\ttensor_shape: empty dimensions list");
    }
    let mut total: Int = 1;
    let mut i: Int = 0;
    while i < r {
        let d: Int = list_get(dims, i);
        if d <= 0 {
            return Err("ERR\ttensor_shape: non-positive dimension size");
        }
        total = total * d;
        i = i + 1;
    }
    let strds: List[Int] = tensor_shape_calc_strides(dims);
    return Ok(TensorShape {
        dims: dims,
        strides: strds,
        rank: r,
        numel: total,
        is_contiguous: true
    });
}

// Project multi-index coordinates to 1D flat offset.
pub fn tensor_shape_flat_idx(shape: TensorShape, indices: List[Int]) -> Result[Int, String] {
    let r: Int = shape.rank;
    if list_len(indices) != r {
        return Err("ERR\ttensor_flat_idx: index rank mismatch");
    }
    let mut flat: Int = 0;
    let mut i: Int = 0;
    while i < r {
        let idx: Int = list_get(indices, i);
        let bound: Int = list_get(shape.dims, i);
        if idx < 0 || idx >= bound {
            return Err("ERR\ttensor_flat_idx: index out of bounds");
        }
        let st: Int = list_get(shape.strides, i);
        flat = flat + idx * st;
        i = i + 1;
    }
    return Ok(flat);
}

// Total number of elements in a tensor shape.
pub fn tensor_shape_numel(shape: TensorShape) -> Int {
    return shape.numel;
}

// Build a 2D TensorShape directly. Inputs must be positive; returns an empty shape on invalid input.
pub fn tensor_shape_2d(d0: Int, d1: Int) -> TensorShape {
    let mut dims: List[Int] = list_new();
    dims = list_push(dims, d0);
    dims = list_push(dims, d1);
    let res: Result[TensorShape, String] = tensor_shape_new(dims);
    match res {
        Ok(sh) => { return sh; }
        Err(_) => {
            return TensorShape {
                dims: dims,
                strides: list_new(),
                rank: 2,
                numel: 0,
                is_contiguous: true
            };
        }
    }
}
