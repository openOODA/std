// # SIMD-Friendly Operations on Cache-Aligned Matrices
//
// Logline: Element-wise arithmetic, dot products, and cache-line move cost estimators on MatrixAligned buffers for SIMD and GPU dispatch preparation.
//
// Setup: Pure module. Reuses MatrixAligned from std/math/tensors/matrix_aligned.oo. All operations are deterministic and shape-checked; mismatched shapes fail closed via Result.
//
// Beats:
//   1. Element-wise add returning a new MatrixAligned, or Err on shape mismatch.
//   2. Scalar scale producing a fresh MatrixAligned and flat dot product.
//   3. Row-wise and column-wise dot products using the logical (unpadded) extents.
//   4. Sum, Frobenius-squared, and cache-line-aligned transpose cost estimators.

import "./matrix_aligned.oo";

// Element-wise add. Returns Err on shape mismatch.
pub fn ao_add(a: MatrixAligned, b: MatrixAligned) -> Result[MatrixAligned, String] {
    if a.rows != b.rows {
        return Err("ERR\tao_add: row count mismatch");
    }
    if a.cols != b.cols {
        return Err("ERR\tao_add: col count mismatch");
    }
    if a.padded_cols != b.padded_cols {
        return Err("ERR\tao_add: padded column count mismatch");
    }
    let total: Int = list_len(a.data);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        let va: Int = list_get(a.data, i);
        let vb: Int = list_get(b.data, i);
        out = list_push(out, va + vb);
        i = i + 1;
    }
    return Ok(MatrixAligned {
        rows: a.rows,
        cols: a.cols,
        padded_cols: a.padded_cols,
        stride: a.padded_cols,
        data: out
    });
}

// Scalar scale. Returns a fresh MatrixAligned.
pub fn ao_scale(a: MatrixAligned, k: Int) -> MatrixAligned {
    let total: Int = list_len(a.data);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        let v: Int = list_get(a.data, i);
        out = list_push(out, v * k);
        i = i + 1;
    }
    return MatrixAligned {
        rows: a.rows,
        cols: a.cols,
        padded_cols: a.padded_cols,
        stride: a.padded_cols,
        data: out
    };
}

// Flat dot product of two aligned buffers over the full padded length.
pub fn ao_dot(a: MatrixAligned, b: MatrixAligned) -> Result[Int, String] {
    if a.rows != b.rows {
        return Err("ERR\tao_dot: row count mismatch");
    }
    if a.cols != b.cols {
        return Err("ERR\tao_dot: col count mismatch");
    }
    if a.padded_cols != b.padded_cols {
        return Err("ERR\tao_dot: padded column count mismatch");
    }
    let total: Int = list_len(a.data);
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < total {
        let va: Int = list_get(a.data, i);
        let vb: Int = list_get(b.data, i);
        acc = acc + va * vb;
        i = i + 1;
    }
    return Ok(acc);
}

// Dot product of logical row r of a and logical row r of b.
pub fn ao_row_dot(a: MatrixAligned, b: MatrixAligned, r: Int) -> Int {
    let cols: Int = a.cols;
    let padded: Int = a.padded_cols;
    let base: Int = r * padded;
    let mut acc: Int = 0;
    let mut j: Int = 0;
    while j < cols {
        let va: Int = list_get(a.data, base + j);
        let vb: Int = list_get(b.data, base + j);
        acc = acc + va * vb;
        j = j + 1;
    }
    return acc;
}

// Dot product of logical column c of a and logical column c of b.
pub fn ao_col_dot(a: MatrixAligned, b: MatrixAligned, c: Int) -> Int {
    let rows: Int = a.rows;
    let cols_a: Int = a.cols;
    let cols_b: Int = b.cols;
    let padded_a: Int = a.padded_cols;
    let padded_b: Int = b.padded_cols;
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < rows {
        if c < cols_a && c < cols_b {
            let va: Int = list_get(a.data, i * padded_a + c);
            let vb: Int = list_get(b.data, i * padded_b + c);
            acc = acc + va * vb;
        }
        i = i + 1;
    }
    return acc;
}

// Sum of all cells including the padded tail.
pub fn ao_sum(a: MatrixAligned) -> Int {
    let total: Int = list_len(a.data);
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < total {
        acc = acc + list_get(a.data, i);
        i = i + 1;
    }
    return acc;
}

// Sum of squares of all cells including the padded tail.
pub fn ao_frobenius_sq(a: MatrixAligned) -> Int {
    let total: Int = list_len(a.data);
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < total {
        let v: Int = list_get(a.data, i);
        acc = acc + v * v;
        i = i + 1;
    }
    return acc;
}

// Transpose cost expressed in 64-byte cache-line-aligned moves.
pub fn ao_transpose_bytes(a: MatrixAligned) -> Int {
    let total: Int = ma_total_bytes(a);
    let line: Int = matrix_aligned_cache_line();
    return total / line;
}

// 1 if padded_cols is a multiple of 16 (always true for well-formed matrices).
pub fn ao_is_simd_ready(a: MatrixAligned) -> Int {
    let padded: Int = a.padded_cols;
    let sixteen: Int = matrix_aligned_int_per_line();
    let rem: Int = padded - (padded / sixteen) * sixteen;
    if rem == 0 {
        return 1;
    }
    return 0;
}
