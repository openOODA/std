// # BLAS Level 1 Vector Linear Algebra Module
//
// Logline: BLAS Level 1 vector-vector linear algebra routines (dot product, axpy, norm2, absolute sum, scale, copy, and argmax).
//
// Setup: Pure math module. Implements standard BLAS-1 operations over continuous flat List[Float] vectors with 8-lane and 4-lane SIMD vectorization.
//
// Beats:
//   1. Vector dot product (blas_dot, blas_dot_f64) via 8-lane f32x8_fma and 4-lane f64x4_fma chunked loops with scalar peeling.
//   2. Fused multiply-accumulate vector addition (blas_axpy) and scalar scaling (blas_scal).
//   3. Euclidean 2-norm (blas_nrm2) and 1-norm absolute sum (blas_asum).
//   4. Index of maximum absolute value (blas_iamax), vector copy (blas_copy), and vector cloning.

import "std/sec/simd/simd_vec8f.oo";
import "std/sec/simd/simd_vec4d.oo";

type Blas1Vec = struct {
    n: Int,
    s0: Float
};

fn blas1_pack(v: List[Float]) -> Blas1Vec {
    let n: Int = list_len(v);
    let mut s0: Float = 0.0;
    if n > 0 {
        s0 = list_get(v, 0);
    }
    return Blas1Vec {
        n: n,
        s0: s0
    };
}

// 8-lane SIMD Dot product of two vectors: sum(x[i] * y[i]) with scalar peeling.
pub fn blas_dot(x: List[Float], y: List[Float]) -> Float {
    let nx: Int = list_len(x);
    let ny: Int = list_len(y);
    let mut n: Int = nx;
    if ny < n {
        n = ny;
    }
    let mut i: Int = 0;
    let mut vec_acc: f32x8 = f32x8_zero();
    while (i + 8) <= n {
        let vx: f32x8 = f32x8_new(
            list_get(x, i),
            list_get(x, i + 1),
            list_get(x, i + 2),
            list_get(x, i + 3),
            list_get(x, i + 4),
            list_get(x, i + 5),
            list_get(x, i + 6),
            list_get(x, i + 7)
        );
        let vy: f32x8 = f32x8_new(
            list_get(y, i),
            list_get(y, i + 1),
            list_get(y, i + 2),
            list_get(y, i + 3),
            list_get(y, i + 4),
            list_get(y, i + 5),
            list_get(y, i + 6),
            list_get(y, i + 7)
        );
        vec_acc = f32x8_fma(vx, vy, vec_acc);
        i = i + 8;
    }
    let mut acc: Float = f32x8_reduce_sum(vec_acc);
    while i < n {
        let sx: Float = list_get(x, i);
        let sy: Float = list_get(y, i);
        acc = acc + sx * sy;
        i = i + 1;
    }
    return acc;
}

// 4-lane SIMD Double-precision Dot product: sum(x[i] * y[i]) with scalar peeling.
pub fn blas_dot_f64(x: List[Float], y: List[Float]) -> Float {
    let nx: Int = list_len(x);
    let ny: Int = list_len(y);
    let mut n: Int = nx;
    if ny < n {
        n = ny;
    }
    let mut i: Int = 0;
    let mut vec_acc: f64x4 = f64x4_zero();
    while (i + 4) <= n {
        let vx: f64x4 = f64x4_new(
            list_get(x, i),
            list_get(x, i + 1),
            list_get(x, i + 2),
            list_get(x, i + 3)
        );
        let vy: f64x4 = f64x4_new(
            list_get(y, i),
            list_get(y, i + 1),
            list_get(y, i + 2),
            list_get(y, i + 3)
        );
        vec_acc = f64x4_fma(vx, vy, vec_acc);
        i = i + 4;
    }
    let mut acc: Float = f64x4_reduce_sum(vec_acc);
    while i < n {
        let sx: Float = list_get(x, i);
        let sy: Float = list_get(y, i);
        acc = acc + sx * sy;
        i = i + 1;
    }
    return acc;
}

// AXPY: y = alpha * x + y.
pub fn blas_axpy(alpha: Float, x: List[Float], y: List[Float]) -> Blas1Vec {
    let nx: Int = list_len(x);
    let ny: Int = list_len(y);
    let mut n: Int = nx;
    if ny < n {
        n = ny;
    }
    let mut res: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(x, i);
        let vy: Float = list_get(y, i);
        res = list_push(res, alpha * vx + vy);
        i = i + 1;
    }
    return blas1_pack(res);
}

// SCAL: res = alpha * x.
pub fn blas_scal(alpha: Float, x: List[Float]) -> Blas1Vec {
    let n: Int = list_len(x);
    let mut res: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(x, i);
        res = list_push(res, vx * alpha);
        i = i + 1;
    }
    return blas1_pack(res);
}

// NRM2: Euclidean 2-norm: sqrt(sum(x[i]^2)).
pub fn blas_nrm2(x: List[Float]) -> Float {
    let sq: Float = blas_dot(x, x);
    return sqrt(sq);
}

// ASUM: Sum of absolute values: sum(|x[i]|).
pub fn blas_asum(x: List[Float]) -> Float {
    let n: Int = list_len(x);
    let mut acc: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(x, i);
        let mut abs_v: Float = vx;
        if abs_v < 0.0 {
            abs_v = 0.0 - abs_v;
        }
        acc = acc + abs_v;
        i = i + 1;
    }
    return acc;
}

// IAMAX: Index of maximum absolute value (0-based).
pub fn blas_iamax(x: List[Float]) -> Int {
    let n: Int = list_len(x);
    if n == 0 {
        return 0;
    }
    let mut max_idx: Int = 0;
    let mut v0: Float = list_get(x, 0);
    if v0 < 0.0 {
        v0 = 0.0 - v0;
    }
    let mut max_val: Float = v0;
    let mut i: Int = 1;
    while i < n {
        let vx: Float = list_get(x, i);
        let mut abs_v: Float = vx;
        if abs_v < 0.0 {
            abs_v = 0.0 - abs_v;
        }
        if abs_v > max_val {
            max_val = abs_v;
            max_idx = i;
        }
        i = i + 1;
    }
    return max_idx;
}

// COPY: Copy vector x into a new list.
pub fn blas_copy(x: List[Float]) -> Blas1Vec {
    let n: Int = list_len(x);
    let mut res: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(x, i);
        res = list_push(res, vx);
        i = i + 1;
    }
    return blas1_pack(res);
}

pub fn blas_level1_probe() -> Int {
    return 0;
}
