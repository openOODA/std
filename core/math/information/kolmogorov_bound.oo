// # Kolmogorov complexity upper-bound estimator
//
// Logline: Structural ceiling log2(distinct values). General K(x) is uncomputable; this is not K(x).
//
// Setup: Pure list scan. Empty or one distinct value returns 0.
//
// Beats:
//   1. Count distinct Ints in the list.
//   2. Return ln(distinct) / ln(2) when distinct > 1.
//   3. Fail closed to 0 on empty or a single symbol.

fn kb_contains(xs: List[Int], v: Int) -> Bool {
    let n: Int = list_len(xs);
    let mut i: Int = 0;
    while i < n {
        if list_get(xs, i) == v {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn kolmogorov_upper_bound(data: List[Int]) -> Float {
    let n: Int = list_len(data);
    if n == 0 {
        return 0.0;
    }
    let mut distinct: Int = 0;
    let mut seen: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let v: Int = list_get(data, i);
        if kb_contains(seen, v) == false {
            seen = list_push(seen, v);
            distinct = distinct + 1;
        }
        i = i + 1;
    }
    if distinct <= 1 {
        return 0.0;
    }
    let d_f: Float = 1.0 * (distinct);
    return ln(d_f) / 0.6931471805599453;
}
