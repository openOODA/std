// # Special Beta and Incomplete Beta Functions Module
//
// Logline: Euler Beta function (Beta), log-beta (lbeta), and regularized incomplete beta (Ix) via continued fraction expansion.
//
// Setup: Pure math module. Evaluates continuous probability priors and statistical distributions.
//
// Beats:
//   1. Log-Beta function ln(Beta(a, b)) via Gamma identities.
//   2. Complete Euler Beta function Beta(a, b) evaluation.
//   3. Incomplete Beta continued fraction series.
//   4. Regularized incomplete beta distribution Ix(a, b).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Higher hypergeometric reductions lower via analytical math package.

import "std/core/math/trig.oo";
import "std/core/math/special_gamma.oo";

pub fn math_lbeta(a: Float, b: Float) -> Result[Float, String] {
    let ra: Result[Float, String] = math_lgamma(a);
    let rb: Result[Float, String] = math_lgamma(b);
    let rab: Result[Float, String] = math_lgamma(a + b);
    match ra {
        Ok(lga)                  => {
            match rb {
                Ok(lgb)          => {
                    match rab {
                        Ok(lgab) => { return Ok((lga + lgb) - lgab); },
                        Err(e)   => { return Err(e); }
                    }
                },
                Err(e) => { return Err(e); }
            }
        },
        Err(e) => { return Err(e); }
    }
}

pub fn math_beta(a: Float, b: Float) -> Result[Float, String] {
    let lbr: Result[Float, String] = math_lbeta(a, b);
    match lbr {
        Ok(lb) => { return Ok(math_exp(lb)); },
        Err(e) => { return Err(e); }
    }
}

// Continued fraction approximation for incomplete beta Ix(a, b)
pub fn math_beta_inc_reg(a: Float, b: Float, x: Float) -> Result[Float, String] {
    if a <= 0.0 { return Err("ERR\tbeta\ta"); }
    if b <= 0.0 { return Err("ERR\tbeta\tb"); }
    if x <= 0.0 { return Ok(0.0); }
    if x >= 1.0 { return Ok(1.0); }

    let lbr: Result[Float, String] = math_lbeta(a, b);
    let mut lb: Float = 0.0;
    match lbr {
        Ok(v)  => { lb = v; },
        Err(e) => { return Err(e); }
    }
    let factor: Float = math_exp((a * math_ln(x)) + (b * math_ln(1.0 - x)) - lb) / a;

    // Continued fraction evaluation (Lentz method)
    let mut c: Float = 1.0;
    let mut d: Float = 1.0 - (a + b) * x / (a + 1.0);
    if d == 0.0 { d = 0.00001; }
    d = 1.0 / d;
    let mut h: Float = d;

    let mut mf: Float = 1.0;
    while mf <= 20.0 {
        // Even step
        let numerator_even: Float = (mf * (b - mf) * x) / ((a + 2.0 * mf - 1.0) * (a + 2.0 * mf));
        d = 1.0 + numerator_even * d;
        if d == 0.0 { d = 0.00001; }
        c = 1.0 + numerator_even / c;
        if c == 0.0 { c = 0.00001; }
        d = 1.0 / d;
        h = h * d * c;

        // Odd step
        let numerator_odd: Float = 0.0 - ((a + mf) * (a + b + mf) * x) / ((a + 2.0 * mf) * (a + 2.0 * mf + 1.0));
        d = 1.0 + numerator_odd * d;
        if d == 0.0 { d = 0.00001; }
        c = 1.0 + numerator_odd / c;
        if c == 0.0 { c = 0.00001; }
        d = 1.0 / d;
        h = h * d * c;

        mf = mf + 1.0;
    }

    return Ok(factor * h);
}
