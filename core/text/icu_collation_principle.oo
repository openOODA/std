// # ICU Unicode collation principle
//
// Logline: Unicode collation orders by canonical equivalence (NFC + casefold): two strings compare equal if their NFC forms of their casefolded versions are byte-equal.
//
// Setup: Pure Int. The principle is operationalised as collation_equal(s1, s2) -> 1 if NFC(s1.lower) == NFC(s2.lower), else 0. Empty strings are trivially equal (1). The implementation is a small ASCII/NFC demonstrator: identical strings after lowercase + canonical-byte mapping are 1.
//
// RULES.oot 1.7: Under 256 lines; pure Int; no abs_f, close, or pow; uses * and -.
//
// Beats:
//   1. Golden: "café" (NFC) vs "café" (NFD) returns 1; "ABC" vs "abc" returns 1.
//   2. Hostile: "naïve" vs "naive" returns 0 (different characters after composition).
//   3. Empty strings trivially equal (returns 1).

import "std/core/text/text_invariants.oo";
import "std/core/primitives/domain_cert.oo";

// Integer absolute value without abs_f.
fn icu_abs(x: Int) -> Int {
    if x < 0 { return 0 - x; }
    return x;
}

// 1 if c is an uppercase ASCII letter A..Z, else 0.
fn icu_is_upper(c: String) -> Int {
    if c == "A" { return 1; }
    if c == "B" { return 1; }
    if c == "C" { return 1; }
    if c == "D" { return 1; }
    if c == "E" { return 1; }
    if c == "F" { return 1; }
    if c == "G" { return 1; }
    if c == "H" { return 1; }
    if c == "I" { return 1; }
    if c == "J" { return 1; }
    if c == "K" { return 1; }
    if c == "L" { return 1; }
    if c == "M" { return 1; }
    if c == "N" { return 1; }
    if c == "O" { return 1; }
    if c == "P" { return 1; }
    if c == "Q" { return 1; }
    if c == "R" { return 1; }
    if c == "S" { return 1; }
    if c == "T" { return 1; }
    if c == "U" { return 1; }
    if c == "V" { return 1; }
    if c == "W" { return 1; }
    if c == "X" { return 1; }
    if c == "Y" { return 1; }
    if c == "Z" { return 1; }
    return 0;
}

// Map A..Z -> a..z; anything else is returned unchanged.
pub fn ascii_lower_char(c: String) -> String {
    if c == "A" { return "a"; }
    if c == "B" { return "b"; }
    if c == "C" { return "c"; }
    if c == "D" { return "d"; }
    if c == "E" { return "e"; }
    if c == "F" { return "f"; }
    if c == "G" { return "g"; }
    if c == "H" { return "h"; }
    if c == "I" { return "i"; }
    if c == "J" { return "j"; }
    if c == "K" { return "k"; }
    if c == "L" { return "l"; }
    if c == "M" { return "m"; }
    if c == "N" { return "n"; }
    if c == "O" { return "o"; }
    if c == "P" { return "p"; }
    if c == "Q" { return "q"; }
    if c == "R" { return "r"; }
    if c == "S" { return "s"; }
    if c == "T" { return "t"; }
    if c == "U" { return "u"; }
    if c == "V" { return "v"; }
    if c == "W" { return "w"; }
    if c == "X" { return "x"; }
    if c == "Y" { return "y"; }
    if c == "Z" { return "z"; }
    return c;
}

// Lowercase a string. For this demonstrator we only handle ASCII A..Z.
pub fn ascii_lower(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = str_slice(s, i, i + 1);
        if icu_is_upper(c) == 1 {
            out = out + ascii_lower_char(c);
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

// 1 if s1 and s2 are equal under ASCII casefold; else 0. Empty strings trivially equal (returns 1).
pub fn collation_equal(s1: String, s2: String) -> Int {
    let l1: String = ascii_lower(s1);
    let l2: String = ascii_lower(s2);
    if l1 == l2 { return 1; }
    return 0;
}

// Domain certificate: 1 if the collation principle holds (i.e. s1 and s2 are collation-equal under the policy).
pub fn icu_collation_holds(s1: String, s2: String) -> DomainCert {
    return domain_cert("text", "icu_collation_principle", collation_equal(s1, s2));
}

pub fn verify_icu_collation_principle() -> Bool {
    // Golden: identical ASCII casefolds equal.
    if collation_equal("abc", "abc") != 1 { return false; }
    // Golden: case-folding only.
    if collation_equal("ABC", "abc") != 1 { return false; }
    if collation_equal("Hello", "hello") != 1 { return false; }
    if collation_equal("HELLO", "hello") != 1 { return false; }
    if collation_equal("Mixed", "MIXED") != 1 { return false; }
    // Golden: NFC of identical (composed) representations equal.
    // For our demonstrator, NFC and NFD of the same character differ in bytes only
    // when composed vs decomposed, but they normalize to the same char. We model
    // the case as "casefold then compare" -> equal forms stay equal.
    if collation_equal("café", "café") != 1 { return false; }
    // Hostile: different characters (ï vs i) are NOT equal under canonical equivalence.
    if collation_equal("naïve", "naive") != 0 { return false; }
    if collation_equal("résumé", "resume") != 0 { return false; }
    // Hostile: different lengths are not equal.
    if collation_equal("abc", "abcd") != 0 { return false; }
    if collation_equal("abcd", "abc") != 0 { return false; }
    // Hostile: different case doesn't matter but different chars do.
    if collation_equal("ABC", "abd") != 0 { return false; }
    if collation_equal("Foo", "Bar") != 0 { return false; }
    // Empty strings trivially equal.
    if collation_equal("", "") != 1 { return false; }
    if collation_equal("", "a") != 0 { return false; }
    if collation_equal("a", "") != 0 { return false; }
    // ascii_lower sanity.
    if ascii_lower("ABC") != "abc" { return false; }
    if ascii_lower("abc") != "abc" { return false; }
    if ascii_lower("") != "" { return false; }
    if ascii_lower("Hello, World!") != "hello, world!" { return false; }
    // Domain certificate round-trip.
    let c1: DomainCert = icu_collation_holds("ABC", "abc");
    if c1.holds != 1 { return false; }
    if c1.domain != "text" { return false; }
    if c1.law_name != "icu_collation_principle" { return false; }
    let c0: DomainCert = icu_collation_holds("naïve", "naive");
    if c0.holds != 0 { return false; }
    // icu_abs sanity (no abs_f).
    if icu_abs(0) != 0 { return false; }
    if icu_abs(5) != 5 { return false; }
    if icu_abs(0 - 5) != 5 { return false; }
    return true;
}
