// # Pattern-string regex matcher
//
// Logline: Recursive scan for literals, [ab] classes, concatenation, *, +, ?, and | alternation.
//
// Setup: Walks the pattern string against text. Not a compiled Thompson state graph.
//
// Beats:
//   1. Keep NfaState/NfaGraph records for later graph work.
//   2. Match literals, [class], and *, +, ? on the pattern string, folding ASCII case when asked.
//   3. Split on | outside classes and try each alternative.
// rules.oot 1.4: Pure data module, zero ambient effects.
// rules.oot 1.7: Under 256 lines.
import "case_converter.oo";

type NfaState = struct {
    id: Int,
    match_type: String,
    match_val: String,
    out1: Int,
    out2: Int,
    is_terminal: Bool
};

type NfaGraph = struct {
    state_count: Int,
    start_id: Int,
    end_id: Int
};

pub fn nfa_state_new(id: Int, match_type: String, match_val: String, out1: Int, out2: Int, is_terminal: Bool) -> NfaState {
    return NfaState {
        id: id,
        match_type: match_type,
        match_val: match_val,
        out1: out1,
        out2: out2,
        is_terminal: is_terminal
    };
}

pub fn nfa_graph_new(start_id: Int, end_id: Int) -> NfaGraph {
    return NfaGraph {
        state_count: end_id + 1,
        start_id: start_id,
        end_id: end_id
    };
}

fn fold_eq(a: String, b: String, fold: Bool) -> Bool {
    if !fold {
        return a == b;
    }
    return char_to_lower(a) == char_to_lower(b);
}

fn nfa_char_matches(pattern_char: String, text_char: String, fold: Bool) -> Bool {
    if pattern_char == "." {
        return text_char != "\n";
    }
    if pattern_char == "\\d" {
        return char_is_digit(text_char);
    }
    if pattern_char == "\\w" {
        return char_is_alpha(text_char) || char_is_digit(text_char) || text_char == "_";
    }
    if pattern_char == "\\s" {
        return char_is_space(text_char);
    }
    return fold_eq(pattern_char, text_char, fold);
}

fn nfa_class_end(pattern: String, open_idx: Int) -> Int {
    let n: Int = chars_len(pattern);
    let mut i: Int = open_idx + 1;
    while i < n {
        if char_at(pattern, i) == "]" {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn nfa_in_class(class: String, ch: String, fold: Bool) -> Bool {
    let n: Int = chars_len(class);
    let mut start: Int = 0;
    let mut neg: Bool = false;
    if n > 0 && char_at(class, 0) == "^" {
        neg = true;
        start = 1;
    }
    let needle: Int = if fold { ord(char_to_lower(ch)) } else { ord(ch) };
    let mut hit: Bool = false;
    let mut i: Int = start;
    while i < n && !hit {
        let c: String = char_at(class, i);
        let leading_dash: Bool = c == "-" && i == start;
        if !leading_dash && i + 2 < n && char_at(class, i + 1) == "-" {
            let mut lo: Int = ord(c);
            let mut hi: Int = ord(char_at(class, i + 2));
            if fold {
                lo = ord(char_to_lower(c));
                hi = ord(char_to_lower(char_at(class, i + 2)));
            }
            if needle >= lo && needle <= hi {
                hit = true;
            }
            i = i + 3;
        } else {
            if fold_eq(c, ch, fold) {
                hit = true;
            }
            i = i + 1;
        }
    }
    if neg {
        return !hit;
    }
    return hit;
}

fn nfa_atom_end(pattern: String, p_idx: Int) -> Int {
    if char_at(pattern, p_idx) == "[" {
        let cl: Int = nfa_class_end(pattern, p_idx);
        if cl >= 0 {
            return cl + 1;
        }
    }
    return p_idx + 1;
}

fn nfa_atom_matches(pattern: String, p_idx: Int, atom_end: Int, ch: String, fold: Bool) -> Bool {
    if char_at(pattern, p_idx) == "[" {
        if atom_end > p_idx + 1 {
            return nfa_in_class(str_slice(pattern, p_idx + 1, atom_end - 1), ch, fold);
        }
    }
    return nfa_char_matches(char_at(pattern, p_idx), ch, fold);
}

fn nfa_match_here(pattern: String, p_idx: Int, text: String, t_idx: Int, fold: Bool) -> Bool {
    let p_len: Int = chars_len(pattern);
    let t_len: Int = chars_len(text);
    if p_idx >= p_len {
        return true;
    }
    if char_at(pattern, p_idx) == "$" && p_idx + 1 == p_len {
        return t_idx >= t_len;
    }
    let atom_end: Int = nfa_atom_end(pattern, p_idx);
    let mut q: String = "";
    if atom_end < p_len {
        q = char_at(pattern, atom_end);
    }
    let mut rest: Int = atom_end;
    let mut min_n: Int = 1;
    let mut max_n: Int = 1;
    if q == "*" || q == "+" || q == "?" {
        rest = atom_end + 1;
        if q == "*" {
            min_n = 0;
            max_n = t_len - t_idx + 1;
        } else if q == "+" {
            max_n = t_len - t_idx + 1;
        } else {
            min_n = 0;
        }
    }
    let mut taken: Int = 0;
    let mut cur: Int = t_idx;
    while taken < max_n {
        if taken >= min_n {
            if nfa_match_here(pattern, rest, text, cur, fold) {
                return true;
            }
        }
        if cur >= t_len {
            break;
        }
        if !nfa_atom_matches(pattern, p_idx, atom_end, char_at(text, cur), fold) {
            break;
        }
        cur = cur + 1;
        taken = taken + 1;
    }
    if taken >= min_n {
        return nfa_match_here(pattern, rest, text, cur, fold);
    }
    return false;
}

fn nfa_find_alt(pattern: String, from: Int) -> Int {
    let n: Int = chars_len(pattern);
    let mut i: Int = from;
    let mut in_class: Bool = false;
    while i < n {
        let c: String = char_at(pattern, i);
        if c == "[" {
            in_class = true;
        } else if c == "]" {
            in_class = false;
        } else if c == "|" && !in_class {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn nfa_simulate_inner(pattern: String, text: String, fold: Bool) -> Bool {
    let p_len: Int = chars_len(pattern);
    let t_len: Int = chars_len(text);
    if p_len == 0 {
        return true;
    }
    let bar: Int = nfa_find_alt(pattern, 0);
    if bar >= 0 {
        if nfa_simulate_inner(str_slice(pattern, 0, bar), text, fold) {
            return true;
        }
        return nfa_simulate_inner(str_slice(pattern, bar + 1, p_len), text, fold);
    }
    if char_at(pattern, 0) == "^" {
        return nfa_match_here(pattern, 1, text, 0, fold);
    }
    let mut i: Int = 0;
    while i <= t_len {
        if nfa_match_here(pattern, 0, text, i, fold) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn nfa_simulate(pattern: String, text: String) -> Bool {
    return nfa_simulate_inner(pattern, text, false);
}

pub fn nfa_simulate_ci(pattern: String, text: String) -> Bool {
    return nfa_simulate_inner(pattern, text, true);
}
