// # Vector push-grows-length law
//
// Logline: vec_push increases the vector size by exactly one.
//
// Setup: Pure Int. No alloc, no FS, no runtime state.
//
// Beats:
//   1. vec_push_grows_ok(n, n+1) holds when the post-push size minus the pre-push size equals 1.
//   2. vec_push_grows_ok(0, 1) holds; vec_push_grows_ok(99, 100) holds.
//   3. Differences other than 1 (0, 2, negative) fail closed.

pub fn vec_push_grows_ok(before: Int, after: Int) -> Int {
    let diff: Int = after - before;
    if diff == 1 {
        return 1;
    }
    return 0;
}

pub fn verify_collections_vec_push_law() -> Bool {
    // golden: a single push grows the size by exactly 1.
    if vec_push_grows_ok(0, 1) != 1 {
        return false;
    }
    if vec_push_grows_ok(3, 4) != 1 {
        return false;
    }
    if vec_push_grows_ok(99, 100) != 1 {
        return false;
    }
    // hostile: 0 (no change), 2 (skip), and negative diffs (shrink) fail closed.
    if vec_push_grows_ok(3, 3) != 0 {
        return false;
    }
    if vec_push_grows_ok(3, 5) != 0 {
        return false;
    }
    if vec_push_grows_ok(3, 2) != 0 {
        return false;
    }
    if vec_push_grows_ok(0, 0) != 0 {
        return false;
    }
    return true;
}
