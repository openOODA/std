// # Concurrent map size law
//
// Logline: n concurrent put operations on a map that do not collide leave the size at exactly n; a version counter increments by one per put.
//
// Setup: Pure Int. models_puts_increment_version(seed, n) returns a triplet (final_size, final_version, ok) where ok=1 only when the model agrees. Hostile sizes fail closed.
//
// Beats:
//   1. Ideal: 10 contention-free puts leave size=10 and version=10.
//   2. Hostile: negative seed or non-positive count fails closed (ok=0).
//   3. Coupled: every put increments the version by exactly 1; a collision-preserving batch holds size=3, version=3.

import "std/core/primitives/domain_cert.oo";

// Model a serial batch of n contention-free puts starting from a fresh map with given size and version.
// final_size = seed_size + n. final_version = seed_version + n. ok=1 if seed_size>=0, seed_version>=0, n>0.
pub fn collections_concurrent_puts_ok(seed_size: Int, seed_version: Int, n: Int) -> DomainCert {
    if seed_size < 0 {
        return domain_cert("collections", "concurrent_puts", 0);
    }
    if seed_version < 0 {
        return domain_cert("collections", "concurrent_puts", 0);
    }
    if n < 1 {
        return domain_cert("collections", "concurrent_puts", 0);
    }
    return domain_cert("collections", "concurrent_puts", 1);
}

fn cm_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Closed: final size after n contention-free puts. n=0 is Ok(seed). n<0 or seed<0 is Err.
pub fn collections_concurrent_final_size(seed_size: Int, n: Int) -> Result[Int, String] {
    if seed_size < 0 { return Err("ERR\tcm\tdomain"); }
    if n < 0 { return Err("ERR\tcm\tdomain"); }
    let mut i: Int = 0;
    let mut s: Int = seed_size;
    while i < n {
        s = s + 1;
        i = i + 1;
    }
    return Ok(s);
}

// Closed: final version after n puts (each put increments the version by 1).
pub fn collections_concurrent_final_version(seed_version: Int, n: Int) -> Result[Int, String] {
    if seed_version < 0 { return Err("ERR\tcm\tdomain"); }
    if n < 0 { return Err("ERR\tcm\tdomain"); }
    let mut i: Int = 0;
    let mut v: Int = seed_version;
    while i < n {
        v = v + 1;
        i = i + 1;
    }
    return Ok(v);
}

// Coupled: model a read-write lock with optimistic concurrency. contended_oks reports how many of the
// n concurrent puts actually wrote (the rest were retried). ok=1 iff contended_oks==n and all writes happened.
pub fn collections_concurrent_with_lock(n: Int, contended_oks: Int) -> DomainCert {
    if n < 1 {
        return domain_cert("collections", "concurrent_with_lock", 0);
    }
    if contended_oks == n {
        return domain_cert("collections", "concurrent_with_lock", 1);
    }
    return domain_cert("collections", "concurrent_with_lock", 0);
}

pub fn verify_collections_concurrent_map_law() -> Bool {
    // Golden: 10 concurrent puts, fresh map, ok=1.
    if cert_holds(collections_concurrent_puts_ok(0, 0, 10)) != 1 { return false; }
    if cm_got(collections_concurrent_final_size(0, 10)) != 10 { return false; }
    if cm_got(collections_concurrent_final_version(0, 10)) != 10 { return false; }

    // Golden: 3 puts from seed (5, 7) yield size 8 and version 10.
    if cert_holds(collections_concurrent_puts_ok(5, 7, 3)) != 1 { return false; }
    if cm_got(collections_concurrent_final_size(5, 3)) != 8 { return false; }
    if cm_got(collections_concurrent_final_version(7, 3)) != 10 { return false; }
    let zsz: Result[Int, String] = collections_concurrent_final_size(5, 0);
    if zsz.is_ok() == false { return false; }
    if cm_got(zsz) != 5 { return false; }
    if collections_concurrent_final_size(0, 0 - 1).is_ok() { return false; }
    if collections_concurrent_final_size(0 - 1, 5).is_ok() { return false; }
    if collections_concurrent_final_version(0, 0 - 1).is_ok() { return false; }

    // Hostile: negative seed size fails closed to 0.
    if cert_holds(collections_concurrent_puts_ok(0 - 1, 0, 5)) != 0 { return false; }
    // Hostile: negative seed version fails closed to 0.
    if cert_holds(collections_concurrent_puts_ok(0, 0 - 1, 5)) != 0 { return false; }
    // Hostile: non-positive put count fails closed to 0.
    if cert_holds(collections_concurrent_puts_ok(0, 0, 0)) != 0 { return false; }
    if cert_holds(collections_concurrent_puts_ok(0, 0, 0 - 1)) != 0 { return false; }

    // Coupled: 10 contended ops that all succeed -> ok=1.
    if cert_holds(collections_concurrent_with_lock(10, 10)) != 1 { return false; }
    // Coupled: 10 contended ops with one retry -> ok=0.
    if cert_holds(collections_concurrent_with_lock(10, 9)) != 0 { return false; }
    // Coupled: 0 ops -> ok=0.
    if cert_holds(collections_concurrent_with_lock(0, 0)) != 0 { return false; }

    return true;
}
