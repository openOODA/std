// # Flat Hash Set (String)
//
// Logline: Open-addressed string hash set with FNV-1a 64-bit hashing, linear probing, and backward-shift deletion.
//
// Setup: Parallel List[String] for keys and parallel List[Int] for the used flag (0 = empty, 1 = occupied). Capacity is fixed at construction.
//
// Beats:
//   1. Build an empty set with a fixed capacity, all slots marked empty.
//   2. Hash a string with FNV-1a 64-bit and reduce mod capacity.
//   3. Insert a key with linear probing; no-op on duplicates.
//   4. Test membership with linear probing and PSL-aware early exit.
//   5. Report current entry count.
//   6. Remove a key by backward-shifting downstream entries into the freed slot.

import "std/core/primitives/list.oo";

fn fhs_list_set_str(l: List[String], idx: Int, v: String) -> List[String] {
    let n: Int = list_len(l);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx { out = list_push(out, v); }
        else { out = list_push(out, list_get(l, i)); }
        i = i + 1;
    }
    return out;
}

type FlatHashSet = struct {
    capacity: Int,
    count: Int,
    keys: List[String],
    used: List[Int]
};

pub fn fhs_new(capacity: Int) -> FlatHashSet {
    let mut keys: List[String] = list_new();
    let mut used: List[Int] = list_new();
    let mut i: Int = 0;
    while i < capacity {
        keys = list_push(keys, "");
        used = list_push(used, 0);
        i = i + 1;
    }
    return FlatHashSet {
        capacity: capacity,
        count: 0,
        keys: keys,
        used: used
    };
}

// FNV-1a 64-bit string hash, reduced to [0, cap).
pub fn fhs_hash(key: String, cap: Int) -> Int {
    let prime: Int = 1099511628211;
    let mut h: Int = 14695981039346656037;
    let n: Int = chars_len(key);
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(key, i);
        h = ((h ^ b) * prime);
        i = i + 1;
    }
    if h < 0 { h = 0 - h; }
    return h % cap;
}

// Linear probing insert: walk forward until an empty slot is found, or
// update the slot if the same key already exists.
pub fn fhs_insert(s: FlatHashSet, key: String) -> FlatHashSet {
    let cap: Int = s.capacity;
    if cap < 1 { return s; }
    let mut k: List[String] = s.keys;
    let mut u: List[Int] = s.used;
    let mut idx: Int = fhs_hash(key, cap);
    let mut probe: Int = 0;
    let mut new_count: Int = s.count;
    let mut done: Bool = false;
    while probe < cap {
        let flag: Int = list_get(u, idx);
        if flag == 0 {
            k = fhs_list_set_str(k, idx, key);
            u = list_set(u, idx, 1);
            new_count = new_count + 1;
            done = true;
            break;
        }
        if list_get(k, idx) == key {
            done = true;
            break;
        }
        probe = probe + 1;
        idx = (idx + 1) % cap;
    }
    if !done { return s; }
    return FlatHashSet {
        capacity: cap,
        count: new_count,
        keys: k,
        used: u
    };
}

pub fn fhs_contains(s: FlatHashSet, key: String) -> Bool {
    let cap: Int = s.capacity;
    if cap < 1 { return false; }
    if s.count == 0 { return false; }
    let mut idx: Int = fhs_hash(key, cap);
    let mut probe: Int = 0;
    while probe < cap {
        let flag: Int = list_get(s.used, idx);
        if flag == 0 { return false; }
        if list_get(s.keys, idx) == key { return true; }
        probe = probe + 1;
        idx = (idx + 1) % cap;
    }
    return false;
}

pub fn fhs_len(s: FlatHashSet) -> Int {
    return s.count;
}

// Backward shift deletion: locate the key, then walk forward and shift each
// downstream entry back by one slot. The shift stops as soon as we hit an
// empty slot or a key whose home is not in the freed probe path.
pub fn fhs_remove(s: FlatHashSet, key: String) -> FlatHashSet {
    let cap: Int = s.capacity;
    if cap < 1 { return s; }
    if s.count == 0 { return s; }
    let mut idx: Int = fhs_hash(key, cap);
    let mut probe: Int = 0;
    let mut found: Bool = false;
    while probe < cap {
        let flag: Int = list_get(s.used, idx);
        if flag == 0 { return s; }
        if list_get(s.keys, idx) == key {
            found = true;
            break;
        }
        probe = probe + 1;
        idx = (idx + 1) % cap;
    }
    if !found { return s; }
    let mut k: List[String] = s.keys;
    let mut u: List[Int] = s.used;
    let mut cur: Int = idx;
    let mut stop: Bool = false;
    while !stop {
        let next: Int = (cur + 1) % cap;
        let next_flag: Int = list_get(u, next);
        if next_flag == 0 {
            k = fhs_list_set_str(k, cur, "");
            u = list_set(u, cur, 0);
            stop = true;
        } else {
            let next_key: String = list_get(k, next);
            let next_home: Int = fhs_hash(next_key, cap);
            let dist_to_next: Int = (next - next_home + cap) % cap;
            let dist_to_cur: Int = (cur - next_home + cap) % cap;
            if dist_to_next < 1 || dist_to_cur >= dist_to_next {
                k = fhs_list_set_str(k, cur, "");
                u = list_set(u, cur, 0);
                stop = true;
            } else {
                k = fhs_list_set_str(k, cur, next_key);
                u = list_set(u, cur, 1);
                cur = next;
            }
        }
    }
    return FlatHashSet {
        capacity: cap,
        count: s.count - 1,
        keys: k,
        used: u
    };
}
