// # Standard Consolidated Set Collection
//
// Logline: Consolidated set container for managing unique elements without duplicates.
//
// Setup: Pure collection module wrapping hash set distinct element operations.
//
// Beats:
//   1. Construct empty set and query size.
//   2. Insert unique elements idempotently.
//   3. Test element containment.
//   4. Clear set elements.

import "hash_set.oo";

pub fn col_set_new() -> HashSet {
    return hash_set_new();
}

pub fn col_set_len(s: HashSet) -> Int {
    return hash_set_len(s);
}

pub fn col_set_is_empty(s: HashSet) -> Bool {
    return hash_set_is_empty(s);
}

pub fn col_set_clear() -> HashSet {
    return hash_set_clear();
}

pub fn col_set_insert(s: HashSet, val: Int) -> HashSet {
    return hash_set_insert(s, val);
}

pub fn col_set_contains(s: HashSet, val: Int) -> Bool {
    return hash_set_contains(s, val);
}
