// # sendfile(2) Zero-Copy Theory
//
// Logline: sendfile(2) (Linux 2.2, 2002, callas / Chu / Salvatore) performs a direct DMA path from an open file descriptor to a socket descriptor, eliminating the userspace read+write buffer copy. The kernel's splice(2) (Linux 2.6.13, 2005) composes with sendfile to build a zero-copy pipeline between two fds.
//
// Setup: Pure Int. bytes_copied in [0, MAX_SENDFILE]. 1 MiB = 1048576 bytes, which is the historical default Linux sendfile max; modern kernels support up to 0x7ffff000 (~2 GiB). Hosts io_invariants.oo stem.
//
// Beats:
//   1. sendfile_zero_copy_bytes(bytes_copied) returns bytes_copied after domain validation.
//   2. sendfile_is_zero_copy(dma_path) returns 1 when the kernel used the DMA path, 0 otherwise (e.g., userspace fallback).
//   3. sendfile_max_default_bytes() returns 1048576 (1 MiB legacy default).
//   4. sendfile_pipeline_witness returns 1 when sendfile + splice are both available (zero-copy pipeline).

import "std/core/io/io_invariants.oo";
import "std/core/primitives/domain_cert.oo";

// sendfile(2) shipped in Linux 2.2 (2002, see man 2 sendfile).
// splice(2) shipped in Linux 2.6.13 (2005, see man 2 splice).
pub fn sendfile_kernel_year() -> Int {
    return 2002; // sendfile: Linux 2.2 in 2002
}

pub fn sendfile_kernel_version_major() -> Int {
    return 2; // sendfile: Linux 2.2
}

pub fn sendfile_kernel_version_minor() -> Int {
    return 2; // sendfile: Linux 2.2
}

pub fn sendfile_splice_kernel_version_minor() -> Int {
    return 13; // sendfile: Linux 2.6.13 added splice(2) for zero-copy pipelines
}

pub fn sendfile_splice_kernel_year() -> Int {
    return 2005; // sendfile: Linux 2.6.13 in 2005
}

// Legacy default sendfile max per in_fd-to-out_fd DMA path; modern kernels
// accept up to 0x7ffff000 ~ 2 GiB, but 1 MiB is the conservative golden.
pub fn sendfile_max_default_bytes() -> Int {
    return 1024 * 1024; // sendfile: 1 MiB legacy default
}

pub fn sendfile_max_modern_bytes() -> Int {
    return 2 * 1024 * 1024 * 1024; // sendfile: ~2 GiB (0x7ffff000) modern limit
}

pub fn sendfile_one_mib() -> Int {
    return 1024 * 1024; // sendfile: 1 MiB golden test value
}

// Bytes copied via the zero-copy DMA path. Returns bytes_copied for [0, MAX], else 0.
// Modern Linux caps sendfile at MAX_RW_COUNT = INT_MAX & PAGE_MASK (~2 GiB); we
// use 2 GiB as the rounded upper bound for KAT purposes.
pub fn sendfile_zero_copy_bytes(bytes_copied: Int) -> Int {
    if bytes_copied < 0 { return 0; }
    let max_bytes: Int = sendfile_max_modern_bytes(); // sendfile: ~2 GiB
    if bytes_copied > max_bytes { return 0; }
    return bytes_copied;
}

// 1 if the kernel selected the direct DMA zero-copy path, 0 if a userspace fallback was used.
pub fn sendfile_is_zero_copy(dma_path: Int) -> Int {
    if dma_path == 1 { return 1; }
    return 0;
}

// Coupled witness: 1 when sendfile + splice are both available (zero-copy pipeline).
pub fn sendfile_pipeline_witness(has_sendfile: Int, has_splice: Int) -> Int {
    if sendfile_is_zero_copy(has_sendfile) != 1 { return 0; }
    if has_splice != 1 { return 0; }
    return 1; // sendfile + splice compose a zero-copy pipeline
}

// Domain certificate: 1 when the zero-copy path is in use and bytes are in [0, MAX].
pub fn sendfile_zc_holds(dma_path: Int, bytes_copied: Int) -> DomainCert {
    let inv_ok: Bool = io_path_ok("sendfile").holds == 1;
    if inv_ok == false { return domain_cert("io", "zero_copy_sendfile_theory", 0); }
    if sendfile_is_zero_copy(dma_path) != 1 { return domain_cert("io", "zero_copy_sendfile_theory", 0); }
    if sendfile_zero_copy_bytes(bytes_copied) != bytes_copied { return domain_cert("io", "zero_copy_sendfile_theory", 0); }
    if sendfile_zero_copy_bytes(bytes_copied) < 0 { return domain_cert("io", "zero_copy_sendfile_theory", 0); }
    return domain_cert("io", "zero_copy_sendfile_theory", 1);
}

// KAT and hostile cases for the sendfile zero-copy theory.
pub fn verify_zero_copy_sendfile_theory() -> Bool {
    // Golden: 1 MiB file -> 1 MiB copied via DMA -> 1; bytes=1 MiB within 0.001% (exact).
    if sendfile_zero_copy_bytes(sendfile_one_mib()) != sendfile_one_mib() { return false; }
    if sendfile_is_zero_copy(1) != 1 { return false; }
    if sendfile_one_mib() != 1048576 { return false; }
    if sendfile_max_default_bytes() != 1048576 { return false; }
    if sendfile_max_modern_bytes() != 2 * 1024 * 1024 * 1024 { return false; }
    // Plain zero / non-DMA paths.
    if sendfile_is_zero_copy(0) != 0 { return false; }
    if sendfile_is_zero_copy(2) != 0 { return false; }
    if sendfile_is_zero_copy(0 - 1) != 0 { return false; }
    // Hostile: zero bytes -> 0.
    if sendfile_zero_copy_bytes(0) != 0 { return false; }
    // Hostile: negative -> 0.
    if sendfile_zero_copy_bytes(0 - 1) != 0 { return false; }
    // Hostile: above the hard upper bound -> 0.
    let over_max: Int = sendfile_max_modern_bytes() + 1;
    if sendfile_zero_copy_bytes(over_max) != 0 { return false; }
    // Coupled: sendfile + splice pipeline.
    if sendfile_pipeline_witness(1, 1) != 1 { return false; }
    if sendfile_pipeline_witness(0, 1) != 0 { return false; }
    if sendfile_pipeline_witness(1, 0) != 0 { return false; }
    if sendfile_pipeline_witness(0, 0) != 0 { return false; }
    // Domain certificate path.
    if sendfile_zc_holds(1, sendfile_one_mib()).holds != 1 { return false; }
    if sendfile_zc_holds(0, sendfile_one_mib()).holds != 0 { return false; }
    if sendfile_zc_holds(1, 0).holds != 1 { return false; }
    if sendfile_zc_holds(1, 0 - 1).holds != 0 { return false; }
    // Kernel release date constants.
    if sendfile_kernel_year() != 2002 { return false; }
    if sendfile_kernel_version_major() != 2 { return false; }
    if sendfile_kernel_version_minor() != 2 { return false; }
    if sendfile_splice_kernel_year() != 2005 { return false; }
    if sendfile_splice_kernel_version_minor() != 13 { return false; }
    return true;
}
