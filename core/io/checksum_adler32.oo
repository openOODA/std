// # Adler-32 Checksum Algorithm Module
//
// Logline: Adler-32 rolling checksum computing fast 32-bit verification hashes over byte sequences.
//
// Setup: Pure algorithm computing s1 = (1 + sum(D)) % 65521, s2 = (sum(s1)) % 65521.
//
// Beats:
//   1. Construct Adler32 accumulator with initial s1 = 1, s2 = 0.
//   2. Update checksum with byte chunk or individual byte values.
//   3. Compute final 32-bit Adler-32 checksum value ((s2 << 16) | s1).
//   4. Combine two independent Adler-32 checksums.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/primitives/list.oo";

type Adler32 = struct {
    s1: Int,
    s2: Int
};

pub fn adler32_new() -> Adler32 {
    return Adler32 { s1: 1, s2: 0 };
}

pub fn adler32_update_byte(adler: Adler32, byte_val: Int) -> Adler32 {
    let mod_val: Int = 65521;
    let b: Int = byte_val & 255;
    let cur_s1: Int = adler.s1;
    let new_s1: Int = (cur_s1 + b) % mod_val;
    let cur_s2: Int = adler.s2;
    let new_s2: Int = (cur_s2 + new_s1) % mod_val;
    return Adler32 { s1: new_s1, s2: new_s2 };
}

pub fn adler32_update(adler: Adler32, bytes: List[Int]) -> Adler32 {
    let n: Int = list_len(bytes);
    let mut s1_val: Int = adler.s1;
    let mut s2_val: Int = adler.s2;
    let mod_val: Int = 65521;
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(bytes, i) & 255;
        s1_val = (s1_val + b) % mod_val;
        s2_val = (s2_val + s1_val) % mod_val;
        i = i + 1;
    }
    return Adler32 { s1: s1_val, s2: s2_val };
}

pub fn adler32_digest(adler: Adler32) -> Int {
    let cur_s1: Int = adler.s1;
    let cur_s2: Int = adler.s2;
    return (cur_s2 * 65536) | cur_s1;
}
