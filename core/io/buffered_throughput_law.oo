// # I/O Buffered Throughput Law
//
// Logline: Buffered I/O throughput equals buffer size divided by per-syscall overhead; one syscall per buffer is the ideal, per-byte syscalls are the worst case.
//
// Setup: Pure Int (bytes per second). buffer_size > 0, overhead_seconds > 0. Illegal inputs return Err. Hosts io_invariants.oo stem.
//
// Beats:
//   1. Ideal throughput: buffer_size bytes per (1 syscall * overhead) seconds.
//   2. Non-ideal throughput: per-byte syscalls degrade to (1 byte / overhead) B/s.
//   3. Throughput ratio: ideal / non_ideal = buffer_size. Propagates Err.

import "std/core/io/io_invariants.oo";
import "std/core/primitives/domain_cert.oo";

fn bt_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Ideal throughput in bytes per second: buffer_size / overhead_seconds.
// buffer_size<=0 or overhead_seconds<=0 return Err.
pub fn bt_ideal_throughput(buffer_size: Int, overhead_seconds: Int) -> Result[Int, String] {
    if buffer_size <= 0 { return Err("ERR\tbt\tbuf"); }
    if overhead_seconds <= 0 { return Err("ERR\tbt\toh"); }
    return Ok(buffer_size / overhead_seconds);
}

// Non-ideal throughput: per-byte syscalls; 1 byte per overhead_seconds.
pub fn bt_non_ideal_throughput(overhead_seconds: Int) -> Result[Int, String] {
    if overhead_seconds <= 0 { return Err("ERR\tbt\toh"); }
    return Ok(1 / overhead_seconds);
}

// Throughput ratio ideal / non_ideal. Propagates Err from either kernel.
pub fn bt_throughput_ratio(buffer_size: Int, overhead_seconds: Int) -> Result[Int, String] {
    let ir: Result[Int, String] = bt_ideal_throughput(buffer_size, overhead_seconds);
    if ir.is_ok() == false { return Err("ERR\tbt\tideal"); }
    let nr: Result[Int, String] = bt_non_ideal_throughput(overhead_seconds);
    if nr.is_ok() == false { return Err("ERR\tbt\tni"); }
    let non_ideal: Int = bt_got(nr);
    if non_ideal == 0 { return Ok(0); }
    return Ok(bt_got(ir) / non_ideal);
}

// Domain certificate: 1 if both throughputs are Ok and positive.
pub fn bt_holds(buffer_size: Int, overhead_seconds: Int) -> DomainCert {
    let inv_ok: Bool = io_path_ok("bt").holds == 1;
    if inv_ok == false { return domain_cert("io", "buffered_throughput_law", 0); }
    let ir: Result[Int, String] = bt_ideal_throughput(buffer_size, overhead_seconds);
    let nr: Result[Int, String] = bt_non_ideal_throughput(overhead_seconds);
    if ir.is_ok() {
        if nr.is_ok() {
            if bt_got(ir) > 0 {
                if bt_got(nr) > 0 {
                    return domain_cert("io", "buffered_throughput_law", 1);
                }
            }
        }
    }
    return domain_cert("io", "buffered_throughput_law", 0);
}

// Within-tolerance (5%) check for the ideal throughput expectation.
// Returns 1 if within 5%. Classifiers keep 0 as false.
pub fn bt_within_5pct(actual: Int, expectation: Int) -> Int {
    if actual <= 0 { return 0; }
    if expectation <= 0 { return 0; }
    let mut diff: Int = actual - expectation;
    if diff < 0 { diff = 0 - diff; }
    let tol: Int = expectation / 20;
    if diff <= tol { return 1; }
    return 0;
}

// KAT and hostile cases for the I/O buffered throughput law.
pub fn verify_buffered_throughput_law() -> Bool {
    if bt_holds(8192, 1).holds != 1 { return false; }
    let ideal_8k: Int = bt_got(bt_ideal_throughput(8192, 1));
    if ideal_8k != 8192 { return false; }
    let non_ideal: Int = bt_got(bt_non_ideal_throughput(1));
    if non_ideal != 1 { return false; }
    let ratio: Int = bt_got(bt_throughput_ratio(8192, 1));
    if ratio != 8192 { return false; }
    if bt_ideal_throughput(0, 1).is_ok() { return false; }
    if bt_ideal_throughput(8192, 0).is_ok() { return false; }
    if bt_ideal_throughput(0 - 1, 1).is_ok() { return false; }
    if bt_ideal_throughput(8192, 0 - 1).is_ok() { return false; }
    if bt_non_ideal_throughput(0).is_ok() { return false; }
    if bt_non_ideal_throughput(0 - 1).is_ok() { return false; }
    if bt_throughput_ratio(0, 1).is_ok() { return false; }
    if bt_throughput_ratio(8192, 0).is_ok() { return false; }
    if bt_holds(0, 1).holds != 0 { return false; }
    if bt_holds(8192, 0).holds != 0 { return false; }
    if bt_within_5pct(8192, 8192) != 1 { return false; }
    if bt_within_5pct(8000, 8192) != 1 { return false; }
    if bt_within_5pct(10000, 8192) != 0 { return false; }
    if bt_within_5pct(0, 8192) != 0 { return false; }
    return true;
}
