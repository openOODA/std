// # Ring Buffer Theory
//
// Logline: A ring buffer keeps read and write indices modulo capacity so a single fixed-size buffer can stream FIFO data without shifting.
//
// Setup: Pure Int. capacity > 0. Indices live in [0, cap-1] and wrap modulo capacity. Hosts io_invariants.oo stem.
//
// Beats:
//   1. read_idx and write_idx advance modulo capacity; size is (write - read) mod capacity, 0 when equal (empty).
//   2. Closed (single producer/consumer): state preserved across write N then read M where 0 <= M <= N <= cap.
//   3. Coupled (concurrent producers/consumers): independent advancement of read and write preserves FIFO when write fits free and read fits size.

import "std/core/io/io_invariants.oo";
import "std/core/primitives/domain_cert.oo";

fn rb_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Advance idx by n positions modulo cap. cap <= 0 or n < 0 returns Err. Wrap to 0 is Ok(0).
pub fn rb_advance(idx: Int, n: Int, cap: Int) -> Result[Int, String] {
    if cap <= 0 { return Err("ERR\trb\tdomain"); }
    if n < 0 { return Err("ERR\trb\tdomain"); }
    let m: Int = n % cap;
    let mut out: Int = idx + m;
    while out >= cap {
        out = out - cap;
    }
    return Ok(out);
}

// Bytes currently stored: (write - read) mod cap. Empty (write == read) is Ok(0). Illegal is Err.
pub fn rb_size(read_idx: Int, write_idx: Int, cap: Int) -> Result[Int, String] {
    if cap <= 0 { return Err("ERR\trb\tdomain"); }
    if read_idx < 0 { return Err("ERR\trb\tdomain"); }
    if read_idx >= cap { return Err("ERR\trb\tdomain"); }
    if write_idx < 0 { return Err("ERR\trb\tdomain"); }
    if write_idx >= cap { return Err("ERR\trb\tdomain"); }
    if write_idx == read_idx { return Ok(0); }
    if write_idx > read_idx { return Ok(write_idx - read_idx); }
    return Ok(write_idx + cap - read_idx);
}

// Free slots: cap - size. Full buffer is Ok(0). Illegal is Err.
pub fn rb_free(read_idx: Int, write_idx: Int, cap: Int) -> Result[Int, String] {
    let sr: Result[Int, String] = rb_size(read_idx, write_idx, cap);
    if sr.is_ok() == false { return sr; }
    return Ok(cap - rb_got(sr));
}

// Empty when write == read.
pub fn rb_is_empty(read_idx: Int, write_idx: Int, cap: Int) -> Int {
    if cap <= 0 { return 0; }
    if read_idx < 0 { return 0; }
    if read_idx >= cap { return 0; }
    if write_idx < 0 { return 0; }
    if write_idx >= cap { return 0; }
    if read_idx == write_idx { return 1; }
    return 0;
}

// Full when next write position equals read (sentinel slot).
pub fn rb_is_full(read_idx: Int, write_idx: Int, cap: Int) -> Int {
    if cap <= 0 { return 0; }
    if read_idx < 0 { return 0; }
    if read_idx >= cap { return 0; }
    if write_idx < 0 { return 0; }
    if write_idx >= cap { return 0; }
    let nwr: Result[Int, String] = rb_advance(write_idx, 1, cap);
    if nwr.is_ok() == false { return 0; }
    if rb_got(nwr) == read_idx { return 1; }
    return 0;
}

// Closed witness: 1 if write N then read M is well-formed (0 <= M <= N <= cap).
pub fn rb_closed_witness(cap: Int, write_n: Int, read_m: Int) -> Int {
    if cap <= 0 { return 0; }
    if write_n < 0 { return 0; }
    if read_m < 0 { return 0; }
    if write_n > cap { return 0; }
    if read_m > write_n { return 0; }
    return 1;
}

// Coupled witness: 1 if independent read/write advance keeps the FIFO invariant
// (write_adv fits free, read_adv fits size, new size in [0, cap]).
pub fn rb_coupled_witness(cap: Int, read_idx: Int, write_idx: Int, read_adv: Int, write_adv: Int) -> Int {
    if cap <= 0 { return 0; }
    if read_idx < 0 { return 0; }
    if read_idx >= cap { return 0; }
    if write_idx < 0 { return 0; }
    if write_idx >= cap { return 0; }
    if read_adv < 0 { return 0; }
    if write_adv < 0 { return 0; }
    let s0r: Result[Int, String] = rb_size(read_idx, write_idx, cap);
    if s0r.is_ok() == false { return 0; }
    let s0: Int = rb_got(s0r);
    if write_adv > cap - s0 { return 0; }
    if read_adv > s0 { return 0; }
    let new_size: Int = s0 + write_adv - read_adv;
    if new_size < 0 { return 0; }
    if new_size > cap { return 0; }
    return 1;
}

// Host stem witness via domain certificate.
pub fn rb_holds() -> DomainCert {
    let inv_ok: Bool = io_path_ok("rb").holds == 1;
    if inv_ok == false { return domain_cert("io", "ring_buffer_theory", 0); }
    return domain_cert("io", "ring_buffer_theory", 1);
}

// KAT and hostile cases for the ring buffer theory.
pub fn verify_ring_buffer_theory() -> Bool {
    if rb_holds().holds != 1 { return false; }
    if rb_got(rb_advance(0, 1, 4)) != 1 { return false; }
    let wrap: Result[Int, String] = rb_advance(0, 4, 4);
    if wrap.is_ok() == false { return false; }
    if rb_got(wrap) != 0 { return false; }
    if rb_got(rb_advance(3, 1, 4)) != 0 { return false; }
    if rb_got(rb_advance(2, 5, 4)) != 3 { return false; }
    if rb_got(rb_advance(0, 0, 4)) != 0 { return false; }
    if rb_advance(0, 1, 0).is_ok() { return false; }
    if rb_advance(0, 0 - 1, 4).is_ok() { return false; }
    if rb_got(rb_size(0, 3, 4)) != 3 { return false; }
    if rb_got(rb_size(3, 0, 4)) != 1 { return false; }
    let zempty: Result[Int, String] = rb_size(2, 2, 4);
    if zempty.is_ok() == false { return false; }
    if rb_got(zempty) != 0 { return false; }
    if rb_got(rb_size(0, 0, 4)) != 0 { return false; }
    if rb_got(rb_size(0, 1, 4)) != 1 { return false; }
    if rb_size(0, 0, 0).is_ok() { return false; }
    if rb_size(0 - 1, 0, 4).is_ok() { return false; }
    if rb_size(0, 4, 4).is_ok() { return false; }
    if rb_got(rb_free(0, 0, 4)) != 4 { return false; }
    if rb_got(rb_free(0, 3, 4)) != 1 { return false; }
    if rb_got(rb_free(2, 2, 4)) != 4 { return false; }
    if rb_is_empty(0, 0, 4) != 1 { return false; }
    if rb_is_empty(0, 1, 4) != 0 { return false; }
    if rb_is_empty(0, 0, 0) != 0 { return false; }
    if rb_is_full(0, 3, 4) != 1 { return false; }
    if rb_is_full(0, 2, 4) != 0 { return false; }
    if rb_is_full(0, 0, 4) != 0 { return false; }
    if rb_closed_witness(4, 3, 1) != 1 { return false; }
    if rb_closed_witness(4, 4, 4) != 1 { return false; }
    if rb_closed_witness(4, 2, 0) != 1 { return false; }
    if rb_closed_witness(0, 1, 0) != 0 { return false; }
    if rb_closed_witness(4, 0 - 1, 0) != 0 { return false; }
    if rb_closed_witness(4, 5, 0) != 0 { return false; }
    if rb_closed_witness(4, 2, 3) != 0 { return false; }
    if rb_coupled_witness(4, 0, 3, 1, 0) != 1 { return false; }
    if rb_coupled_witness(4, 1, 1, 0, 2) != 1 { return false; }
    if rb_coupled_witness(4, 2, 0, 0, 2) != 1 { return false; }
    if rb_coupled_witness(0, 0, 0, 1, 1) != 0 { return false; }
    if rb_coupled_witness(4, 0 - 1, 0, 0, 0) != 0 { return false; }
    return true;
}
