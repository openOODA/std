// # Vectored Scatter/Gather I/O Module
//
// Logline: Vectored scatter/gather of Int buffer chunks (iovec style).
//
// Setup: Pure in-memory I/O with List[Int] buffer chunks.
//
// Beats:
//   1. Construct IoVecArray collections of Int chunks.
//   2. Append chunks and compute aggregate totals.
//   3. Gather chunks into a sum up to max_count.
// Technical Note: Vectored buffer collector. This module performs non-ambient scatter and gather operations on sequential integer buffer chunks.

type IoVecArray = struct {
    buffers: List[Int],
    total_len: Int,
    count: Int
};

pub fn iovec_array_new() -> IoVecArray {
    let empty_bufs: List[Int] = list_new();
    return IoVecArray {
        buffers: empty_bufs,
        total_len: 0,
        count: 0
    };
}

pub fn iovec_array_count(arr: IoVecArray) -> Int {
    return arr.count;
}

pub fn iovec_array_total_bytes(arr: IoVecArray) -> Int {
    return arr.total_len;
}

pub fn iovec_array_add(arr: IoVecArray, data: Int) -> IoVecArray {
    let mut new_bufs: List[Int] = list_new();
    let n: Int = list_len(arr.buffers);
    let mut i: Int = 0;
    while i < n {
        new_bufs = list_push(new_bufs, list_get(arr.buffers, i));
        i = i + 1;
    }
    new_bufs = list_push(new_bufs, data);
    let cur_tot: Int = arr.total_len;
    let cur_cnt: Int = arr.count;
    let mut add_len: Int = data;
    if add_len < 0 {
        add_len = 0 - add_len;
    }
    return IoVecArray {
        buffers: new_bufs,
        total_len: cur_tot + add_len,
        count: cur_cnt + 1
    };
}

pub fn iovec_gather_sum(arr: IoVecArray, max_count: Int) -> Int {
    let n: Int = list_len(arr.buffers);
    let mut lim: Int = max_count;
    if lim > n {
        lim = n;
    }
    if lim < 0 {
        lim = 0;
    }
    let mut out: Int = 0;
    let mut i: Int = 0;
    while i < lim {
        out = out + list_get(arr.buffers, i);
        i = i + 1;
    }
    return out;
}

pub fn iovec_array_get(arr: IoVecArray, i: Int) -> Int {
    let n: Int = list_len(arr.buffers);
    if i < 0 || i >= n {
        return 0;
    }
    return list_get(arr.buffers, i);
}
