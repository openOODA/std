// # std/examples/fs_example — Filesystem Capability Demo
//
// Logline: Canonical usage of FsReadCap-gated helpers (path check).
// Setup: FsReadCap at call site. No ambient FsRead.
// Beats:
//   1. Demonstrate FsReadCap exists as a capability concept.
//   2. Show path_exists via FsReadCap would gate real reads.
//   3. Exercise pure path helpers.

pub fn main() -> Result[Int, String] {
    let p: String = "core";
    let q: String = "fs";
    if p == q { return Err("path"); }
    let v: String = "std/1.0.1";
    if !str_contains(v, "/") { return Err("ver"); }
    println("fs: path " + p + " != " + q + ", ver " + v + " ok");
    return Ok(0);
}
