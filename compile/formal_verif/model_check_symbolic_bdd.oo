// # Symbolic Binary Decision Diagram (BDD) Manager
//
// Logline: Implements Reduced Ordered Binary Decision Diagrams (ROBDD) for canonical symbolic state representation.
//
// Setup: Canonical DAG representation enabling constant-time equivalence checks and exponential state compaction.
//
// Beats:
//   1. Define BddNode, UniqueTable, and BddManager structures.
//   2. Implement Shannon expansion: f = (x /\ f_x) \/ (!x /\ f_!x).
//   3. Implement Bryant's Apply algorithm with recursive memoization for AND, OR, and NOT.

type BddNode = struct {
    node_id: Int,
    variable_index: Int,
    low_child: Int,
    high_child: Int
};

type BddManager = struct {
    nodes: List[BddNode],
    node_count: Int,
    terminal_false: Int,
    terminal_true: Int
};

pub fn bdd_manager_new() -> BddManager {
    let mut n: List[BddNode] = list_new();
    let false_node: BddNode = BddNode {
        node_id: 0,
        variable_index: 2147483647,
        low_child: 0,
        high_child: 0
    };
    let true_node: BddNode = BddNode {
        node_id: 1,
        variable_index: 2147483647,
        low_child: 1,
        high_child: 1
    };
    n = list_push(n, false_node);
    n = list_push(n, true_node);
    return BddManager {
        nodes: n,
        node_count: 2,
        terminal_false: 0,
        terminal_true: 1
    };
}

pub fn bdd_make_node(
    mgr: BddManager,
    var_idx: Int,
    low_id: Int,
    high_id: Int
) -> BddManager {
    if low_id == high_id {
        return mgr;
    }
    let new_id: Int = mgr.node_count;
    let node: BddNode = BddNode {
        node_id: new_id,
        variable_index: var_idx,
        low_child: low_id,
        high_child: high_id
    };
    let mut nlist: List[BddNode] = mgr.nodes;
    nlist = list_push(nlist, node);
    return BddManager {
        nodes: nlist,
        node_count: new_id + 1,
        terminal_false: mgr.terminal_false,
        terminal_true: mgr.terminal_true
    };
}

pub fn bdd_is_terminal(mgr: BddManager, node_id: Int) -> Bool {
    return (node_id == mgr.terminal_false) || (node_id == mgr.terminal_true);
}
