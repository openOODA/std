// # Fuzz Int Multi3 Fail
//
// Logline: Standard library verification and domain capabilities for Fuzz Int Multi3 Fail.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

fn multi3_bad(x: Int, y: Int, z: Int) -> Int {
    requires x >= 0;
    requires y >= 0;
    requires z >= 0;
    ensures result == x + y + z;
    return x + y + z + 1;
}

pub fn verify_fuzz_int_multi3_fail() -> Bool {
    return true;
}
