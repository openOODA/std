// # Code Coverage Bitmap Tracker
//
// Logline: Edge transition tracking and branch coverage bitmap analysis referencing feedback-directed fuzzing engines.
//
// Setup: Pure coverage bitmap analyzing branch transition pairs (prev_loc ^ cur_loc).
//
// Beats:
//   1. Allocate coverage bitmap array initialized to zero hits.
//   2. Record edge branch transition computing hashed edge index.
//   3. Increment edge execution counter with saturating 8-bit arithmetic.
//   4. Detect new coverage bits against baseline virgin map.

type CoverageMap = struct {
    map_size: Int,
    hit_count: Int,
    bitmap: List[Int]
};

pub fn cov_map_new(size: Int) -> Result[CoverageMap, String] {
    if size <= 0 {
        return Err("ERR\tcov_map_new\tsize_must_be_positive");
    }
    let mut bm: List[Int] = list_new();
    let mut i: Int = 0;
    while i < size {
        bm = list_push(bm, 0);
        i = i + 1;
    }
    return Ok(CoverageMap {
        map_size: size,
        hit_count: 0,
        bitmap: bm
    });
}

type CovEdgeResult = struct {
    map: CoverageMap,
    is_new: Bool
};

pub fn cov_record_edge(map: CoverageMap, prev_loc: Int, cur_loc: Int) -> CovEdgeResult {
    let edge_idx: Int = ((prev_loc >> 1) ^ cur_loc) % map.map_size;
    let old_val: Int = list_get(map.bitmap, edge_idx);
    let is_new_path: Bool = old_val == 0;
    let mut updated_bm: List[Int] = list_new();
    let mut i: Int = 0;
    while i < map.map_size {
        if i == edge_idx {
            let next_val: Int = if old_val < 255 { old_val + 1 } else { 255 };
            updated_bm = list_push(updated_bm, next_val);
        } else {
            updated_bm = list_push(updated_bm, list_get(map.bitmap, i));
        }
        i = i + 1;
    }
    let new_hits: Int = if is_new_path { map.hit_count + 1 } else { map.hit_count };
    let next_map: CoverageMap = CoverageMap {
        map_size: map.map_size,
        hit_count: new_hits,
        bitmap: updated_bm
    };
    return CovEdgeResult {
        map: next_map,
        is_new: is_new_path
    };
}
