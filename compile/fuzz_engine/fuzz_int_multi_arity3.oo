fn triple_add(x: Int, y: Int, z: Int) -> Int {
    requires x >= 0;
    requires y >= 0;
    requires z >= 0;
    ensures result == x + y + z;
    return x + y + z;
}

pub fn verify_fuzz_int_multi_arity3() -> Bool {
    return true;
}
