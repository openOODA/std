// # Informational Energy-Maneuverability Engine
//
// Logline: Codify Colonel John Boyd's Informational Energy-Maneuverability equation, calculating specific excess power, semantic thrust, systemic drag, entropy weight, and loop velocity.
//
// Setup: Pure mathematical formulation of informational E-M physics. Landauer joules from std/principles/landauer_principle.oo.
//
// Beats:
//   1. Calculate Informational Specific Excess Power (Ps,info = ((T - D) / W) * V).
//   2. Derive systemic drag components (rebuild, token burn, allocation, cognitive thrash, verification).
//   3. Compute Landauer bit erasure thermodynamic dissipation bound.
//   4. Calculate LLM RadixAttention KV-cache prefix divergence token waste.
//   5. Evaluate complete informational E-M state and net-positive power status.

import "std/principles/landauer_principle.oo";

type DragBreakdown = struct {
    rebuild_drag: Float,
    token_drag: Float,
    alloc_drag: Float,
    cognitive_drag: Float,
    verify_drag: Float,
    total_drag: Float
};

type InfoEmState = struct {
    thrust: Float,
    drag: Float,
    weight: Float,
    velocity: Float,
    ps_info: Float,
    landauer_energy_joules: Float,
    is_net_positive: Bool
};

pub fn em_int_to_float(n: Int) -> Float {
    if n == 0 { return 0.0; }
    if n == 1 { return 1.0; }
    if n == 2 { return 2.0; }
    if n == 3 { return 3.0; }
    if n == 4 { return 4.0; }
    if n == 5 { return 5.0; }
    if n == 6 { return 6.0; }
    if n == 10 { return 10.0; }
    if n == 100 { return 100.0; }
    let mut sign: Float = 1.0;
    let mut val: Int = n;
    if val < 0 { sign = 0.0 - 1.0; val = 0 - val; }
    let mut f: Float = 0.0;
    let mut mult: Float = 1.0;
    while val > 0 {
        let digit: Int = val % 10;
        let mut d_f: Float = 0.0;
        if digit == 1 { d_f = 1.0; }
        else if digit == 2 { d_f = 2.0; }
        else if digit == 3 { d_f = 3.0; }
        else if digit == 4 { d_f = 4.0; }
        else if digit == 5 { d_f = 5.0; }
        else if digit == 6 { d_f = 6.0; }
        else if digit == 7 { d_f = 7.0; }
        else if digit == 8 { d_f = 8.0; }
        else if digit == 9 { d_f = 9.0; }
        f = f + (d_f * mult);
        mult = mult * 10.0;
        val = val / 10;
    }
    return f * sign;
}

// Col. John Boyd's Informational Specific Excess Power: Ps,info = ((T - D) / W) * V
pub fn energy_maneuverability_ps(thrust: Float, drag: Float, weight: Float, velocity: Float) -> Float {
    if weight <= 0.0 {
        return 0.0;
    }
    let excess_thrust: Float = thrust - drag;
    return (excess_thrust / weight) * velocity;
}

// Instruction and Semantic Thrust (T,semantic)
pub fn calculate_semantic_thrust(ast_lines_per_sec: Float, simd_vector_throughput: Float, mono_chunk_count: Int) -> Float {
    let chunk_f: Float = em_int_to_float(mono_chunk_count);
    let chunk_thrust: Float = chunk_f * 100.0;
    let base_thrust: Float = ast_lines_per_sec + simd_vector_throughput;
    return base_thrust + chunk_thrust;
}

// Rebuild Drag: tau,build = eta * tau,hit + (1 - eta) * tau,compile
pub fn calculate_rebuild_drag(cache_hit_ratio: Float, tau_hit_sec: Float, tau_compile_sec: Float) -> Float {
    let mut eta: Float = cache_hit_ratio;
    if eta < 0.0 {
        eta = 0.0;
    }
    if eta > 1.0 {
        eta = 1.0;
    }
    let hit_term: Float = eta * tau_hit_sec;
    let miss_weight: Float = 1.0 - eta;
    let compile_term: Float = miss_weight * tau_compile_sec;
    return hit_term + compile_term;
}

// Token Burn Drag: D,token_burn = (1 - rho) * R,tokens
pub fn calculate_token_burn_drag(token_rate: Float, sparing_ratio: Float) -> Float {
    let mut rho: Float = sparing_ratio;
    if rho < 0.0 {
        rho = 0.0;
    }
    if rho > 1.0 {
        rho = 1.0;
    }
    let uncompressed_fraction: Float = 1.0 - rho;
    return uncompressed_fraction * token_rate;
}

// Memory Allocation Drag: Allocator contention + GC/ARC pause latency
pub fn calculate_alloc_drag(heap_allocs: Float, gc_pause_sec: Float, arena_ratio: Float) -> Float {
    let mut ar: Float = arena_ratio;
    if ar < 0.0 {
        ar = 0.0;
    }
    if ar > 1.0 {
        ar = 1.0;
    }
    let heap_fraction: Float = 1.0 - ar;
    let alloc_penalty: Float = heap_allocs * heap_fraction;
    let pause_penalty: Float = gc_pause_sec * 1000.0;
    return alloc_penalty + pause_penalty;
}

// Approximate natural logarithm ln(x) using series expansion for positive x
pub fn approx_ln(x: Float) -> Float {
    if x <= 0.0 {
        return 0.0;
    }
    if x == 1.0 {
        return 0.0;
    }
    let mut val: Float = x;
    let mut count: Float = 0.0;
    while val > 2.718281828459045 {
        val = val / 2.718281828459045;
        count = count + 1.0;
    }
    let z: Float = (val - 1.0) / (val + 1.0);
    let z2: Float = z * z;
    let term1: Float = z;
    let term3: Float = (z * z2) / 3.0;
    let term5: Float = (z * z2 * z2) / 5.0;
    let approx: Float = 2.0 * (term1 + term3 + term5);
    return count + approx;
}

// Cognitive Thrash Drag: D,cognitive = kappa * M * K * ln(N)
pub fn calculate_cognitive_drag(agent_count: Int, file_count: Int, path_mutations: Int, kappa: Float) -> Float {
    if agent_count <= 0 || path_mutations <= 0 {
        return 0.0;
    }
    let mut n_files: Float = em_int_to_float(file_count);
    if n_files < 2.0 {
        n_files = 2.0;
    }
    let log_files: Float = approx_ln(n_files);
    let agents_f: Float = em_int_to_float(agent_count);
    let mutations_f: Float = em_int_to_float(path_mutations);
    return kappa * agents_f * mutations_f * log_files;
}

// Verification Drag: D,verify = tau,lint + tau,double_run
pub fn calculate_verify_drag(lint_sec: Float, double_run_sec: Float) -> Float {
    return lint_sec + double_run_sec;
}

// Total Systemic Drag: D,systemic = D,rebuild + D,token + D,alloc + D,cognitive + D,verify
pub fn calculate_systemic_drag(d_rebuild: Float, d_token: Float, d_alloc: Float, d_cognitive: Float, d_verify: Float) -> Float {
    return d_rebuild + d_token + d_alloc + d_cognitive + d_verify;
}

// Entropy Weight: W,entropy = Binary size + AST nodes + Context token mass
pub fn calculate_entropy_weight(binary_size_kb: Float, ast_node_count: Float, context_tokens: Float) -> Float {
    let bin_w: Float = binary_size_kb * 0.01;
    let ast_w: Float = ast_node_count * 0.001;
    let ctx_w: Float = context_tokens * 0.0001;
    let total_w: Float = 1.0 + bin_w + ast_w + ctx_w;
    return total_w;
}

// Loop Velocity: V,ooda = 1.0 / (tau,obs + tau,orient + tau,decide + tau,act)
pub fn calculate_loop_velocity(tau_obs: Float, tau_orient: Float, tau_decide: Float, tau_act: Float) -> Float {
    let tau_total: Float = tau_obs + tau_orient + tau_decide + tau_act;
    if tau_total <= 0.000001 {
        return 0.0;
    }
    return 1.0 / tau_total;
}

fn em_ld_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

pub fn calculate_landauer_dissipation(erased_bits: Float, temp_kelvin: Float) -> Result[Float, String] {
    return landauer_energy_for_erased_bits(erased_bits, temp_kelvin);
}

// LLM KV-Cache Prefix Divergence Token Waste: Delta_Tokens = M * Q * (C - L,cached)
pub fn calculate_kv_prefix_waste(agent_count: Int, turns: Int, context_tokens: Int, cached_prefix_tokens: Int) -> Int {
    if context_tokens <= cached_prefix_tokens {
        return 0;
    }
    let wasted_per_turn: Int = context_tokens - cached_prefix_tokens;
    return agent_count * turns * wasted_per_turn;
}

// Evaluates complete Informational E-M state
pub fn evaluate_informational_em(thrust: Float, drag_breakdown: DragBreakdown, weight: Float, velocity: Float, erased_bits: Float, temp_k: Float) -> InfoEmState {
    let tot_drag: Float = drag_breakdown.total_drag;
    let ps: Float = energy_maneuverability_ps(thrust, tot_drag, weight, velocity);
    let landauer_joules: Float = em_ld_got(calculate_landauer_dissipation(erased_bits, temp_k));
    let net_pos: Bool = ps > 0.0;
    return InfoEmState {
        thrust: thrust,
        drag: tot_drag,
        weight: weight,
        velocity: velocity,
        ps_info: ps,
        landauer_energy_joules: landauer_joules,
        is_net_positive: net_pos
    };
}
