// # SSA phi-function law
//
// Logline: At a join point, a phi-function merges one definition per variable per incoming predecessor; placement follows the iterated dominance frontier for reducible CFGs.
//
// Setup: Pure Int. preds is the list of predecessor block ids at the join. vars is the list of SSA variable names (1 = "x", 2 = "y"). defs is a flat list length = preds*vars: 1 means defined on that edge, 0 means not.
//
// Beats:
//   1. Ideal: one phi per variable at the join (1 phi per var).
//   2. Non-ideal: reducible CFGs may need parallel copies or phi-of-phi (returned as a count of nested joins).
//   3. Hostile: 0 predecessors fails closed to 0 phis.
//   4. Coupled: phi count == number of variables that have a def on every predecessor edge.

import "std/core/domain_cert.oo";

// Number of phi-functions inserted at a join: one per variable that is defined
// on every incoming edge. preds is the list of predecessor ids; defs is a flat
// list length preds * vars where vars is the number of SSA names. Bad shapes
// fail closed to 0.
fn phi_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn compile_ssa_phi_count(preds: List[Int], defs: List[Int], vars: Int) -> Result[Int, String] {
    let p: Int = list_len(preds);
    if p <= 0 { return Err("ERR\tphi\tdomain"); }
    if vars <= 0 { return Err("ERR\tphi\tdomain"); }
    if list_len(defs) != p * vars { return Err("ERR\tphi\tdomain"); }
    let mut phis: Int = 0;
    let mut v: Int = 0;
    while v < vars {
        let mut all_def: Int = 1;
        let mut e: Int = 0;
        while e < p {
            let d: Int = list_get(defs, e * vars + v);
            if d == 0 { all_def = 0; }
            e = e + 1;
        }
        if all_def == 1 { phis = phis + 1; }
        v = v + 1;
    }
    return Ok(phis);
}

// Incoming edges at a join: equal to the number of predecessors.
pub fn compile_ssa_incoming_edges(preds: List[Int]) -> Int {
    return list_len(preds);
}

// Parallel-copies / phi-of-phi nesting depth for a reducible CFG.
// A nesting depth of 1 means one level of phi-of-phi; 0 means flat.
// Bad input returns 0.
pub fn compile_ssa_phi_nesting(loops: Int) -> Result[Int, String] {
    if loops < 0 { return Err("ERR\tphi\tdomain"); }
    if loops == 0 { return Ok(0); }
    return Ok(1);
}

pub fn compile_ssa_phi_idf_ok(preds: List[Int], defs: List[Int], vars: Int) -> Int {
    let nr: Result[Int, String] = compile_ssa_phi_count(preds, defs, vars);
    if nr.is_ok() == false { return 0; }
    return 1;
}

// Golden builder: 2 predecessors, 2 variables, both defined on both edges.
fn compile_ssa_golden_preds() -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 0);
    out = list_push(out, 1);
    return out;
}

fn compile_ssa_golden_defs() -> List[Int] {
    // rows = 2 preds, cols = 2 vars, all 1s.
    let mut out: List[Int] = list_new();
    out = list_push(out, 1);
    out = list_push(out, 1);
    out = list_push(out, 1);
    out = list_push(out, 1);
    return out;
}

// Domain certificate for the SSA phi-function law.
pub fn compile_ssa_phi_cert(holds: Int) -> DomainCert {
    return domain_cert("compile", "ssa_phi", holds);
}

// KAT and hostile cases for the SSA phi-function law.
pub fn verify_ssa_phi_law() -> Bool {
    let preds: List[Int] = compile_ssa_golden_preds();
    let defs: List[Int] = compile_ssa_golden_defs();
    // Golden: 2 predecessors, 2 vars defined everywhere -> 2 phis, 2 incoming edges.
    if phi_got(compile_ssa_phi_count(preds, defs, 2)) != 2 { return false; }
    if compile_ssa_incoming_edges(preds) != 2 { return false; }
    if compile_ssa_phi_idf_ok(preds, defs, 2) != 1 { return false; }
    // Golden: 1 variable defined on both edges -> 1 phi.
    let mut one_def: List[Int] = list_new();
    one_def = list_push(one_def, 1);
    one_def = list_push(one_def, 1);
    if phi_got(compile_ssa_phi_count(preds, one_def, 1)) != 1 { return false; }
    // Golden: 3 predecessors, 1 var defined everywhere -> 1 phi, 3 edges.
    let mut p3: List[Int] = list_new();
    p3 = list_push(p3, 0);
    p3 = list_push(p3, 1);
    p3 = list_push(p3, 2);
    let mut d3: List[Int] = list_new();
    d3 = list_push(d3, 1);
    d3 = list_push(d3, 1);
    d3 = list_push(d3, 1);
    if phi_got(compile_ssa_phi_count(p3, d3, 1)) != 1 { return false; }
    if compile_ssa_incoming_edges(p3) != 3 { return false; }
    // Hostile: 0 predecessors fails closed.
    let empty: List[Int] = list_new();
    if compile_ssa_phi_count(empty, empty, 0).is_ok() { return false; }
    let mut short: List[Int] = list_new();
    short = list_push(short, 1);
    if compile_ssa_phi_count(preds, short, 2).is_ok() { return false; }
    if compile_ssa_phi_count(preds, defs, 0 - 1).is_ok() { return false; }
    // Non-ideal: variable not defined on every edge -> 0 phis for that var.
    let mut partial: List[Int] = list_new();
    partial = list_push(partial, 1);
    partial = list_push(partial, 0);
    partial = list_push(partial, 1);
    partial = list_push(partial, 1);
    if phi_got(compile_ssa_phi_count(preds, partial, 2)) != 1 { return false; }
    if phi_got(compile_ssa_phi_nesting(2)) != 1 { return false; }
    let znest: Result[Int, String] = compile_ssa_phi_nesting(0);
    if znest.is_ok() == false { return false; }
    if phi_got(znest) != 0 { return false; }
    if compile_ssa_phi_nesting(0 - 1).is_ok() { return false; }
    // Certificate round-trip.
    let c1: DomainCert = compile_ssa_phi_cert(1);
    if cert_holds(c1) != 1 { return false; }
    let c0: DomainCert = compile_ssa_phi_cert(0);
    if cert_holds(c0) != 0 { return false; }
    let c5: DomainCert = compile_ssa_phi_cert(5);
    if cert_holds(c5) != 0 { return false; }
    return true;
}
