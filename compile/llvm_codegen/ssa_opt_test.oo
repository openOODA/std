// # SSA Optimizer Test Suite
//
// Logline: Unit tests for SSA constant folding and dead code elimination passes.
//
// Setup: Validates constant folding transformations on synthetic SSA functions.
//
// Beats:
//   1. Test constant folding addition with zero identity.
//   2. Test constant folding multiplication identity.
//   3. Test dead block elimination.
//   4. Export test runner function.
pub fn ssa_opt_const_fold_test() -> Int {
    let op_fadd_test: Int = 25;
    let mut pass_count: Int = 0;
    let empty_names: List[String] = list_new();

    // Test 1: add 5 0 -> const 0
    let mut t1_ops: List[Int] = list_new();
    let mut t1_res: List[Int] = list_new();
    let mut t1_imm: List[Int] = list_new();
    let mut t1_bid: List[Int] = list_new();
    let mut t1_lhss: List[Int] = list_new();
    t1_ops = list_push(t1_ops, ssa_op_add());
    t1_res = list_push(t1_res, 5);
    t1_imm = list_push(t1_imm, 0);
    t1_bid = list_push(t1_bid, 0);
    t1_lhss = list_push(t1_lhss, 0);
    let f1: SsaFunction = ssa_opt_const_fold(SsaFunction {
        name: "t1",
        return_type: 0,
        block_count: 1,
        block_names: empty_names,
        inst_opcodes: t1_ops,
        inst_results: t1_res,
        inst_imm_vals: t1_imm,
        inst_lhs_vals: t1_lhss,
        inst_block_ids: t1_bid
    });
    if list_get(f1.inst_opcodes, 0) == ssa_op_const() && list_get(f1.inst_imm_vals, 0) == 0 && list_get(f1.inst_results, 0) == 5 {
        pass_count = pass_count + 1;
    }

    // Test 2: mul 7 1 -> identity (op dropped)
    let mut t2_ops: List[Int] = list_new();
    let mut t2_res: List[Int] = list_new();
    let mut t2_imm: List[Int] = list_new();
    let mut t2_bid: List[Int] = list_new();
    let mut t2_lhss: List[Int] = list_new();
    t2_ops = list_push(t2_ops, ssa_op_mul());
    t2_res = list_push(t2_res, 7);
    t2_imm = list_push(t2_imm, 1);
    t2_bid = list_push(t2_bid, 0);
    t2_lhss = list_push(t2_lhss, 0);
    let f2: SsaFunction = ssa_opt_const_fold(SsaFunction {
        name: "t2",
        return_type: 0,
        block_count: 1,
        block_names: empty_names,
        inst_opcodes: t2_ops,
        inst_results: t2_res,
        inst_imm_vals: t2_imm,
        inst_lhs_vals: t2_lhss,
        inst_block_ids: t2_bid
    });
    if list_len(f2.inst_opcodes) == 0 {
        pass_count = pass_count + 1;
    }

    // Test 3: mul 7 0 -> const 0
    let mut t3_ops: List[Int] = list_new();
    let mut t3_res: List[Int] = list_new();
    let mut t3_imm: List[Int] = list_new();
    let mut t3_bid: List[Int] = list_new();
    let mut t3_lhss: List[Int] = list_new();
    t3_ops = list_push(t3_ops, ssa_op_mul());
    t3_res = list_push(t3_res, 7);
    t3_imm = list_push(t3_imm, 0);
    t3_bid = list_push(t3_bid, 0);
    t3_lhss = list_push(t3_lhss, 0);
    let f3: SsaFunction = ssa_opt_const_fold(SsaFunction {
        name: "t3",
        return_type: 0,
        block_count: 1,
        block_names: empty_names,
        inst_opcodes: t3_ops,
        inst_results: t3_res,
        inst_imm_vals: t3_imm,
        inst_lhs_vals: t3_lhss,
        inst_block_ids: t3_bid
    });
    if list_len(f3.inst_opcodes) == 1 && list_get(f3.inst_opcodes, 0) == ssa_op_const() && list_get(f3.inst_imm_vals, 0) == 0 {
        pass_count = pass_count + 1;
    }

    // Test 4: fadd 3 0.0 -> identity (op dropped; 0.0 encoded as Int 0)
    let mut t4_ops: List[Int] = list_new();
    let mut t4_res: List[Int] = list_new();
    let mut t4_imm: List[Int] = list_new();
    let mut t4_bid: List[Int] = list_new();
    let mut t4_lhss: List[Int] = list_new();
    t4_ops = list_push(t4_ops, op_fadd_test);
    t4_res = list_push(t4_res, 3);
    t4_imm = list_push(t4_imm, 0);
    t4_bid = list_push(t4_bid, 0);
    t4_lhss = list_push(t4_lhss, 0);
    let f4: SsaFunction = ssa_opt_const_fold(SsaFunction {
        name: "t4",
        return_type: 0,
        block_count: 1,
        block_names: empty_names,
        inst_opcodes: t4_ops,
        inst_results: t4_res,
        inst_imm_vals: t4_imm,
        inst_lhs_vals: t4_lhss,
        inst_block_ids: t4_bid
    });
    if list_len(f4.inst_opcodes) == 0 {
        pass_count = pass_count + 1;
    }

    if pass_count >= 3 { return 0; }
    return 1;
}

// main: Test driver. Calls ssa_opt_const_fold_test and prints PASS/FAIL plus
// the number of passing fold cases. Exit code 0 on PASS, 1 on FAIL.
pub fn main() {
    let r: Int = ssa_opt_const_fold_test();
    if r == 0 {
        println("ssa_opt_const_fold_test: PASS");
    } else {
        println("ssa_opt_const_fold_test: FAIL (returned " + r.to_string() + ")");
    }
}
