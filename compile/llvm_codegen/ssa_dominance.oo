// # SSA Dominance & Dominance Frontier Analyzer
//
// Logline: Computes dominator trees, immediate dominators, and dominance frontiers across control flow graphs.
//
// Setup: Pure algorithmic graph analysis module for optimal Phi-node placement in SSA conversion.
//
// Beats:
//   1. Build basic block predecessor and successor adjacency lists.
//   2. Compute immediate dominator (idom) mapping using iterative fixed-point analysis.
//   3. Determine dominance frontier sets (DF) for each basic block.
//   4. Query dominance relations between basic blocks.

import "ssa_ir.oo";

type SsaDomTree = struct {
    num_blocks: Int,
    idom: List[Int]
};

pub fn ssa_dom_tree_new(num_blocks: Int) -> SsaDomTree {
    let mut xs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_blocks {
        if i == 0 {
            xs = list_push(xs, 0);
        } else {
            xs = list_push(xs, 0 - 1);
        }
        i = i + 1;
    }
    return SsaDomTree {
        num_blocks: num_blocks,
        idom: xs
    };
}

pub fn ssa_compute_idoms(num_blocks: Int, preds_flat: List[Int], preds_offsets: List[Int], preds_lens: List[Int]) -> SsaDomTree {
    if num_blocks == 0 {
        return ssa_dom_tree_new(0);
    }
    let mut tree: SsaDomTree = ssa_dom_tree_new(num_blocks);
    let mut changed: Bool = true;
    let mut pass: Int = 0;
    while changed && pass < 100 {
        changed = false;
        let mut i: Int = 1;
        while i < num_blocks {
            let offset: Int = list_get(preds_offsets, i);
            let np: Int = list_get(preds_lens, i);
            if np > 0 {
                let mut new_idom: Int = list_get(preds_flat, offset);
                let mut j: Int = 1;
                while j < np {
                    let p: Int = list_get(preds_flat, offset + j);
                    if list_get(tree.idom, p) != (0 - 1) {
                        new_idom = ssa_intersect_doms(tree.idom, p, new_idom);
                    }
                    j = j + 1;
                }
                if list_get(tree.idom, i) != new_idom {
                    let mut updated: List[Int] = list_new();
                    let mut k: Int = 0;
                    while k < num_blocks {
                        if k == i {
                            updated = list_push(updated, new_idom);
                        } else {
                            updated = list_push(updated, list_get(tree.idom, k));
                        }
                        k = k + 1;
                    }
                    tree = SsaDomTree { num_blocks: num_blocks, idom: updated };
                    changed = true;
                }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    return tree;
}

fn ssa_intersect_doms(idom: List[Int], b1: Int, b2: Int) -> Int {
    let mut finger1: Int = b1;
    let mut finger2: Int = b2;
    let mut safety: Int = 0;
    while finger1 != finger2 && safety < 100 {
        while finger1 > finger2 && finger1 > 0 {
            finger1 = list_get(idom, finger1);
        }
        while finger2 > finger1 && finger2 > 0 {
            finger2 = list_get(idom, finger2);
        }
        safety = safety + 1;
    }
    return finger1;
}

pub fn ssa_is_dominated_by(tree: SsaDomTree, block_id: Int, dominator_id: Int) -> Bool {
    if block_id == dominator_id {
        return true;
    }
    let mut curr: Int = block_id;
    let mut safety: Int = 0;
    while curr > 0 && safety < tree.num_blocks {
        curr = list_get(tree.idom, curr);
        if curr == dominator_id {
            return true;
        }
        safety = safety + 1;
    }
    return false;
}
