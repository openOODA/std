// # LLVM IR Textual Instruction Emitter
//
// Logline: Formats textual LLVM IR statements for SSA variables, basic block labels, arithmetic instructions, and terminators.
//
// Setup: Pure code generation module synthesizing valid LLVM IR strings.
//
// Beats:
//   1. Format typed variable names (%t0, %t1).
//   2. Format binary arithmetic instructions (add, sub, mul, sdiv).
//   3. Format memory operations (alloca, load, store).
//   4. Format control flow terminators (br label, br i1, ret).

pub fn llvm_emit_var(id: Int) -> String {
    return "%t" + id.to_string();
}

pub fn llvm_emit_label(block_id: Int) -> String {
    return "bb" + block_id.to_string() + ":";
}

pub fn llvm_emit_add_i64(dst: Int, src1: Int, src2: Int) -> String {
    return llvm_emit_var(dst) + " = add i64 " + llvm_emit_var(src1) + ", " + llvm_emit_var(src2);
}

pub fn llvm_emit_sub_i64(dst: Int, src1: Int, src2: Int) -> String {
    return llvm_emit_var(dst) + " = sub i64 " + llvm_emit_var(src1) + ", " + llvm_emit_var(src2);
}

pub fn llvm_emit_mul_i64(dst: Int, src1: Int, src2: Int) -> String {
    return llvm_emit_var(dst) + " = mul i64 " + llvm_emit_var(src1) + ", " + llvm_emit_var(src2);
}

pub fn llvm_emit_ret_i64(src: Int) -> String {
    return "ret i64 " + llvm_emit_var(src);
}

pub fn llvm_emit_br(target_block: Int) -> String {
    return "br label %bb" + target_block.to_string();
}
