// # Basic Block Topological Scheduler
//
// Logline: Basic block layout scheduling, fall-through branch optimization, and loop block contiguous placement.
//
// Setup: Pure code layout module arranging basic blocks to maximize linear execution throughput.
//
// Beats:
//   1. Represent basic block layout order list.
//   2. Insert blocks into scheduled layout sequence.
//   3. Check fall-through adjacency between successive blocks.
//   4. Validate that all blocks are scheduled exactly once.

type BlockScheduler = struct {
    num_scheduled: Int,
    block_order: List[Int]
};

pub fn block_scheduler_new() -> BlockScheduler {
    let empty: List[Int] = list_new();
    return BlockScheduler {
        num_scheduled: 0,
        block_order: empty
    };
}

pub fn block_schedule_append(sched: BlockScheduler, block_id: Int) -> BlockScheduler {
    let mut xs: List[Int] = sched.block_order;
    xs = list_push(xs, block_id);
    return BlockScheduler {
        num_scheduled: sched.num_scheduled + 1,
        block_order: xs
    };
}

pub fn block_is_fallthrough(sched: BlockScheduler, from_block: Int, to_block: Int) -> Bool {
    let n: Int = sched.num_scheduled;
    let mut i: Int = 0;
    while i < (n - 1) {
        let b1: Int = list_get(sched.block_order, i);
        let b2: Int = list_get(sched.block_order, i + 1);
        if b1 == from_block && b2 == to_block {
            return true;
        }
        i = i + 1;
    }
    return false;
}
