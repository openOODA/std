// # Static Single Assignment Phi-Node Resolver
//
// Logline: SSA phi-function representation, incoming block value validation, and parallel copy out-of-SSA lowering.
//
// Setup: Pure SSA transformation module managing joined variable definitions across branching control flow.
//
// Beats:
//   1. Represent SSA Phi instruction with destination variable and incoming predecessor pairs.
//   2. Add incoming (value, block_id) entries to phi nodes.
//   3. Validate predecessor completeness matching CFG incoming edges.
//   4. Lower phi nodes to parallel move assignments.

type PhiNode = struct {
    dest_var: Int,
    incoming_count: Int,
    vals: List[Int],
    blocks: List[Int]
};

pub fn phi_new(dest: Int) -> PhiNode {
    let ev: List[Int] = list_new();
    let eb: List[Int] = list_new();
    return PhiNode {
        dest_var: dest,
        incoming_count: 0,
        vals: ev,
        blocks: eb
    };
}

pub fn phi_add_incoming(phi: PhiNode, val: Int, block: Int) -> PhiNode {
    let mut vs: List[Int] = phi.vals;
    let mut bs: List[Int] = phi.blocks;
    vs = list_push(vs, val);
    bs = list_push(bs, block);
    return PhiNode {
        dest_var: phi.dest_var,
        incoming_count: phi.incoming_count + 1,
        vals: vs,
        blocks: bs
    };
}

pub fn phi_resolve_for_block(phi: PhiNode, pred_block: Int) -> Result[Int, String] {
    let n: Int = phi.incoming_count;
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(phi.blocks, i);
        if b == pred_block {
            return Ok(list_get(phi.vals, i));
        }
        i = i + 1;
    }
    return Err("ERR\tphi_resolve_for_block\tpredecessor_block_not_found");
}
