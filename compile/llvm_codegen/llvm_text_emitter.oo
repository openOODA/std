// # Canonical LLVM IR Text Emitter
//
// Logline: Lowers SSA intermediate representations into standard LLVM IR (.ll) text format for all 55 opcodes.
//
// Setup: Pure code generation emitter formatting target headers, types, virtual registers, and instructions.
//
// Beats:
//   1. Emit module header, target datalayout, and triple.
//   2. Format function signatures, basic block labels, and Phi nodes.
//   3. Emit typed arithmetic, comparison, memory, control flow, calls, casts, and aggregate ops.
//   4. Generate complete validated LLVM IR text buffer.

import "ssa_ir.oo";

pub fn llvm_emit_module(fn_data: SsaFunction) -> String {
    let mut out: String = "; ModuleID = 'openOODA_ssa_module'\n";
    out = out + "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128\"\n";
    out = out + "target triple = \"x86_64-unknown-linux-gnu\"\n\n";
    out = out + "define i64 @" + fn_data.name + "() {\n";

    let n_blocks: Int = fn_data.block_count;
    let n_insts: Int = ssa_fn_inst_count(fn_data);
    let names: List[String] = fn_data.block_names;

    let mut b: Int = 0;
    while b < n_blocks {
        let bname: String = list_get(names, b);
        out = out + bname + ":\n";

        let mut i: Int = 0;
        while i < n_insts {
            let bid: Int = list_get(fn_data.inst_block_ids, i);
            if bid == b {
                let op: Int = list_get(fn_data.inst_opcodes, i);
                let res: Int = list_get(fn_data.inst_results, i);
                let imm: Int = list_get(fn_data.inst_imm_vals, i);
                let lhs: Int = list_get(fn_data.inst_lhs_vals, i);
                out = out + "  " + llvm_format_inst(op, res, lhs, imm) + "\n";
            }
            i = i + 1;
        }
        b = b + 1;
    }

    out = out + "}\n";
    return out;
}

fn llvm_format_inst(op: Int, res: Int, lhs: Int, imm: Int) -> String {
    let r_str: String = "%v" + res.to_string();
    let l_str: String = "%v" + lhs.to_string();
    let i_str: String = imm.to_string();

    // Integer arithmetic (1-5).
    if op == ssa_op_add() { return r_str + " = add nsw i64 " + l_str + ", " + i_str; }
    if op == ssa_op_sub() { return r_str + " = sub nsw i64 " + l_str + ", " + i_str; }
    if op == ssa_op_mul() { return r_str + " = mul nsw i64 " + l_str + ", " + i_str; }
    if op == ssa_op_sdiv() { return r_str + " = sdiv i64 " + l_str + ", " + i_str; }
    if op == ssa_op_srem() { return r_str + " = srem i64 " + l_str + ", " + i_str; }

    // Bitwise (6-10).
    if op == ssa_op_and() { return r_str + " = and i64 " + l_str + ", " + i_str; }
    if op == ssa_op_or() { return r_str + " = or i64 " + l_str + ", " + i_str; }
    if op == ssa_op_xor() { return r_str + " = xor i64 " + l_str + ", " + i_str; }
    if op == ssa_op_shl() { return r_str + " = shl i64 " + l_str + ", " + i_str; }
    if op == ssa_op_shr() { return r_str + " = lshr i64 " + l_str + ", " + i_str; }

    // Integer compare (11-12, 36-40).
    if op == ssa_op_icmp_eq() { return r_str + " = icmp eq i64 " + l_str + ", " + i_str; }
    if op == ssa_op_icmp_slt() { return r_str + " = icmp slt i64 " + l_str + ", " + i_str; }
    if op == ssa_op_icmp_ult() { return r_str + " = icmp ult i64 " + l_str + ", " + i_str; }
    if op == ssa_op_icmp_ule() { return r_str + " = icmp ule i64 " + l_str + ", " + i_str; }
    if op == ssa_op_icmp_sgt() { return r_str + " = icmp sgt i64 " + l_str + ", " + i_str; }
    if op == ssa_op_icmp_sge() { return r_str + " = icmp sge i64 " + l_str + ", " + i_str; }
    if op == ssa_op_icmp_ne() { return r_str + " = icmp ne i64 " + l_str + ", " + i_str; }

    // Phi (13).
    if op == ssa_op_phi() { return r_str + " = phi i64 [" + i_str + ", %entry]"; }

    // Memory (14-16, 21).
    if op == ssa_op_alloca() { return r_str + " = alloca i64"; }
    if op == ssa_op_load() { return r_str + " = load i64, i64* %slot." + i_str; }
    if op == ssa_op_store() { return "store i64 " + l_str + ", i64* %slot." + i_str; }
    if op == ssa_op_store_lit() { return "store i64 " + i_str + ", i64* %slot." + res.to_string(); }

    // Control flow (17-19, 53-54).
    if op == ssa_op_br() { return "br label %block" + i_str; }
    if op == ssa_op_cond_br() { return "br i1 " + l_str + ", label %block" + i_str + ", label %block" + (imm + 1).to_string(); }
    if op == ssa_op_ret() { return "ret i64 " + l_str; }
    if op == ssa_op_switch() { return "switch i64 " + l_str + ", label %default [i64 " + i_str + ", label %block" + i_str + "]"; }
    if op == ssa_op_unreachable() { return "unreachable"; }

    // Constant (20, 22).
    if op == ssa_op_const() { return r_str + " = add i64 0, " + i_str; }
    if op == ssa_op_const_forced() { return r_str + " = add i64 0, " + i_str; }

    // Print (23-24).
    if op == ssa_op_println_int() { return "call void @print_int(i64 " + l_str + ")"; }
    if op == ssa_op_println_str() { return "call void @print_str(%OoStr* " + l_str + ")"; }

    // Float arithmetic (25-29).
    if op == ssa_op_fadd() { return r_str + " = fadd double " + l_str + ", " + i_str; }
    if op == ssa_op_fsub() { return r_str + " = fsub double " + l_str + ", " + i_str; }
    if op == ssa_op_fmul() { return r_str + " = fmul double " + l_str + ", " + i_str; }
    if op == ssa_op_fdiv() { return r_str + " = fdiv double " + l_str + ", " + i_str; }
    if op == ssa_op_frem() { return r_str + " = frem double " + l_str + ", " + i_str; }

    // Float compare (30-35).
    if op == ssa_op_fcmp_oeq() { return r_str + " = fcmp oeq double " + l_str + ", " + i_str; }
    if op == ssa_op_fcmp_olt() { return r_str + " = fcmp olt double " + l_str + ", " + i_str; }
    if op == ssa_op_fcmp_ole() { return r_str + " = fcmp ole double " + l_str + ", " + i_str; }
    if op == ssa_op_fcmp_ogt() { return r_str + " = fcmp ogt double " + l_str + ", " + i_str; }
    if op == ssa_op_fcmp_oge() { return r_str + " = fcmp oge double " + l_str + ", " + i_str; }
    if op == ssa_op_fcmp_une() { return r_str + " = fcmp une double " + l_str + ", " + i_str; }

    // Integer casts (41-43).
    if op == ssa_op_sext() { return r_str + " = sext i32 " + l_str + " to i64"; }
    if op == ssa_op_zext() { return r_str + " = zext i32 " + l_str + " to i64"; }
    if op == ssa_op_trunc() { return r_str + " = trunc i64 " + l_str + " to i32"; }

    // Float casts (44-45).
    if op == ssa_op_sitofp() { return r_str + " = sitofp i64 " + l_str + " to double"; }
    if op == ssa_op_fptosi() { return r_str + " = fptosi double " + l_str + " to i64"; }

    // Call (46). For now, single-arg form: imm carries #args.
    if op == ssa_op_call() { return r_str + " = call i64 @" + l_str + "(i64 " + i_str + ")"; }

    // GEP (47). imm carries index.
    if op == ssa_op_getelementptr() { return r_str + " = getelementptr i64, i64* " + l_str + ", i64 " + i_str; }

    // Aggregate (48-49).
    if op == ssa_op_extractvalue() { return r_str + " = extractvalue { i64, i64 } " + l_str + ", " + i_str; }
    if op == ssa_op_insertvalue() { return "insertvalue { i64, i64 } " + l_str + ", i64 " + i_str + ", 0"; }

    // Bitcast (50).
    if op == ssa_op_bitcast() { return r_str + " = bitcast i64 " + l_str + " to i64*"; }

    // Pointer / integer casts (51-52).
    if op == ssa_op_ptrtoint() { return r_str + " = ptrtoint i64* " + l_str + " to i64"; }
    if op == ssa_op_inttoptr() { return r_str + " = inttoptr i64 " + l_str + " to i64*"; }

    // Landingpad stub (55).
    if op == ssa_op_landingpad() { return "landingpad { i8*, i32 } cleanup"; }

    return "; nop (op " + i_str + ")";
}
