// # LLVM v0.225.19 Feature Unit Test Suite
//
// Logline: Unit tests for PGO branch_weights strings, SIMD FMA intrinsics, IDF mem2reg, inline !llvm.loop metadata, and LTO pipeline dispatch.
//
// Setup: Hand-built inputs and string assertions on emitted IR; no external tools required.
//
// Beats:
//   1. PGO branch_weights string syntax.
//   2. SIMD type mapper round-trips for all 5 vector types.
//   3. IDF mem2reg on diamond and linear CFGs.
//   4. LTO pipeline dispatch flag detection.
//   5. !llvm.loop metadata string syntax.

import "ssa_ir.oo";
import "ssa_mem2reg.oo";
import "ssa_dominance_frontier.oo";
import "oodac/emit/llvm/llvm_emit_simd.oo";

fn v019_is_aggrlto_opt(opt: String) -> Bool {
    if opt == "aggrlto" { return true; }
    if opt == "-Oaggrlto" { return true; }
    if opt == "lto+vec" { return true; }
    return false;
}

fn v019_assert(name: String, cond: Bool) -> Int {
    if cond { println("PASS\t" + name); return 1; }
    println("FAIL\t" + name);
    return 0;
}

fn v019_contains(h: String, n: String) -> Bool {
    return str_index_of(h, n) >= 0;
}

pub fn test_v019_pgo_string() -> Int {
    let s: String = "!prof !{!\"branch_weights\", i32 100, i32 1}";
    return v019_assert("test_v019_pgo_string",
        v019_contains(s, "branch_weights") && v019_contains(s, "i32 100") && v019_contains(s, "i32 1"));
}

pub fn test_v019_loop_meta() -> Int {
    let s: String = "!{!\"llvm.loop.vectorize.enable\", i1 true, !\"llvm.loop.unroll.count\", i32 4}";
    return v019_assert("test_v019_loop_meta",
        v019_contains(s, "llvm.loop.vectorize.enable") && v019_contains(s, "i1 true")
        && v019_contains(s, "llvm.loop.unroll.count") && v019_contains(s, "i32 4"));
}

pub fn test_v019_simd_types() -> Int {
    let p1: Bool = llvm_simd_ty_map("Vec4f") == "<4 x float>";
    let p2: Bool = llvm_simd_ty_map("Vec8f") == "<8 x float>";
    let p3: Bool = llvm_simd_ty_map("Vec4d") == "<4 x double>";
    let p4: Bool = llvm_simd_ty_map("Vec4i") == "<4 x i32>";
    let p5: Bool = llvm_simd_ty_map("Vec16b") == "<16 x i8>";
    let p6: Bool = llvm_simd_elem_ty("<4 x float>") == "float";
    let p7: Bool = llvm_simd_elem_ty("<4 x double>") == "double";
    let p8: Bool = llvm_simd_lane_count("<8 x float>") == 8;
    let p9: Bool = llvm_simd_lane_count("<4 x double>") == 4;
    return v019_assert("test_v019_simd_types", p1 && p2 && p3 && p4 && p5 && p6 && p7 && p8 && p9);
}

pub fn test_v019_lto_dispatch() -> Int {
    let p1: Bool = v019_is_aggrlto_opt("aggrlto");
    let p2: Bool = v019_is_aggrlto_opt("-Oaggrlto");
    let p3: Bool = v019_is_aggrlto_opt("lto+vec");
    let p4: Bool = !v019_is_aggrlto_opt("lto");
    let p5: Bool = !v019_is_aggrlto_opt("pgo");
    return v019_assert("test_v019_lto_dispatch", p1 && p2 && p3 && p4 && p5);
}

fn v019_count_op(ops: List[Int], op: Int) -> Int {
    let mut c: Int = 0;
    let mut i: Int = 0;
    let n: Int = list_len(ops);
    while i < n { if list_get(ops, i) == op { c = c + 1; } i = i + 1; }
    return c;
}

pub fn test_v019_mem2reg_linear() -> Int {
    let mut ops: List[Int] = list_new(); let mut res: List[Int] = list_new(); let mut imms: List[Int] = list_new(); let mut lhss: List[Int] = list_new(); let mut bids: List[Int] = list_new();
    ops = list_push(ops, ssa_op_alloca()); res = list_push(res, 1); imms = list_push(imms, 0); lhss = list_push(lhss, 0); bids = list_push(bids, 0);
    ops = list_push(ops, ssa_op_store()); res = list_push(res, 0); imms = list_push(imms, 1); lhss = list_push(lhss, 5); bids = list_push(bids, 0);
    ops = list_push(ops, ssa_op_load()); res = list_push(res, 2); imms = list_push(imms, 1); lhss = list_push(lhss, 0); bids = list_push(bids, 0);
    ops = list_push(ops, ssa_op_ret()); res = list_push(res, 0); imms = list_push(imms, 2); lhss = list_push(lhss, 0); bids = list_push(bids, 0);
    let mut names: List[String] = list_new(); names = list_push(names, "entry");
    let f: SsaFunction = SsaFunction {
        name: "linear", return_type: 0, block_count: 1, block_names: names,
        inst_opcodes: ops, inst_results: res, inst_imm_vals: imms,
        inst_lhs_vals: lhss, inst_block_ids: bids
    };
    let promoted: SsaFunction = ssa_mem2reg_promote(f);
    let allocas: Int = v019_count_op(promoted.inst_opcodes, ssa_op_alloca());
    let phis: Int = v019_count_op(promoted.inst_opcodes, ssa_op_phi());
    return v019_assert("test_v019_mem2reg_linear", allocas == 0 && phis == 0);
}

pub fn test_v019_mem2reg_diamond() -> Int {
    let mut ops: List[Int] = list_new(); let mut res: List[Int] = list_new(); let mut imms: List[Int] = list_new(); let mut lhss: List[Int] = list_new(); let mut bids: List[Int] = list_new();
    ops = list_push(ops, ssa_op_alloca()); res = list_push(res, 1); imms = list_push(imms, 0); lhss = list_push(lhss, 0); bids = list_push(bids, 0);
    ops = list_push(ops, ssa_op_store()); res = list_push(res, 0); imms = list_push(imms, 1); lhss = list_push(lhss, 42); bids = list_push(bids, 0);
    ops = list_push(ops, ssa_op_br()); res = list_push(res, 0); imms = list_push(imms, 1); lhss = list_push(lhss, 0); bids = list_push(bids, 0);
    ops = list_push(ops, ssa_op_store()); res = list_push(res, 0); imms = list_push(imms, 1); lhss = list_push(lhss, 99); bids = list_push(bids, 1);
    ops = list_push(ops, ssa_op_br()); res = list_push(res, 0); imms = list_push(imms, 3); lhss = list_push(lhss, 0); bids = list_push(bids, 1);
    ops = list_push(ops, ssa_op_store()); res = list_push(res, 0); imms = list_push(imms, 1); lhss = list_push(lhss, 7); bids = list_push(bids, 2);
    ops = list_push(ops, ssa_op_br()); res = list_push(res, 0); imms = list_push(imms, 3); lhss = list_push(lhss, 0); bids = list_push(bids, 2);
    ops = list_push(ops, ssa_op_load()); res = list_push(res, 4); imms = list_push(imms, 1); lhss = list_push(lhss, 0); bids = list_push(bids, 3);
    ops = list_push(ops, ssa_op_ret()); res = list_push(res, 0); imms = list_push(imms, 4); lhss = list_push(lhss, 0); bids = list_push(bids, 3);
    let mut names: List[String] = list_new();
    names = list_push(names, "entry"); names = list_push(names, "then1"); names = list_push(names, "then2"); names = list_push(names, "merge");
    let f: SsaFunction = SsaFunction {
        name: "diamond", return_type: 0, block_count: 4, block_names: names,
        inst_opcodes: ops, inst_results: res, inst_imm_vals: imms,
        inst_lhs_vals: lhss, inst_block_ids: bids
    };
    let promoted: SsaFunction = ssa_mem2reg_promote(f);
    let allocas: Int = v019_count_op(promoted.inst_opcodes, ssa_op_alloca());
    let phis: Int = v019_count_op(promoted.inst_opcodes, ssa_op_phi());
    return v019_assert("test_v019_mem2reg_diamond", allocas == 0 && phis >= 1);
}

pub fn test_v019_dom_linear() -> Int {
    let mut ops: List[Int] = list_new(); let mut res: List[Int] = list_new(); let mut imms: List[Int] = list_new(); let mut lhss: List[Int] = list_new(); let mut bids: List[Int] = list_new();
    ops = list_push(ops, ssa_op_br()); res = list_push(res, 0); imms = list_push(imms, 1); lhss = list_push(lhss, 0); bids = list_push(bids, 0);
    ops = list_push(ops, ssa_op_br()); res = list_push(res, 0); imms = list_push(imms, 2); lhss = list_push(lhss, 0); bids = list_push(bids, 1);
    ops = list_push(ops, ssa_op_ret()); res = list_push(res, 0); imms = list_push(imms, 0); lhss = list_push(lhss, 0); bids = list_push(bids, 2);
    let mut names: List[String] = list_new();
    names = list_push(names, "entry"); names = list_push(names, "mid"); names = list_push(names, "exit");
    let f: SsaFunction = SsaFunction {
        name: "linear", return_type: 0, block_count: 3, block_names: names,
        inst_opcodes: ops, inst_results: res, inst_imm_vals: imms,
        inst_lhs_vals: lhss, inst_block_ids: bids
    };
    let idom: List[Int] = ssa_compute_dominators(&f);
    let i0: Int = list_get(idom, 0); let i1: Int = list_get(idom, 1); let i2: Int = list_get(idom, 2);
    return v019_assert("test_v019_dom_linear", i0 == 0 && i1 == 0 && i2 == 1);
}

pub fn test_v019_dom_diamond() -> Int {
    let mut ops: List[Int] = list_new(); let mut res: List[Int] = list_new(); let mut imms: List[Int] = list_new(); let mut lhss: List[Int] = list_new(); let mut bids: List[Int] = list_new();
    ops = list_push(ops, ssa_op_cond_br()); res = list_push(res, 1); imms = list_push(imms, 2); lhss = list_push(lhss, 0); bids = list_push(bids, 0);
    ops = list_push(ops, ssa_op_br()); res = list_push(res, 0); imms = list_push(imms, 3); lhss = list_push(lhss, 0); bids = list_push(bids, 1);
    ops = list_push(ops, ssa_op_br()); res = list_push(res, 0); imms = list_push(imms, 3); lhss = list_push(lhss, 0); bids = list_push(bids, 2);
    ops = list_push(ops, ssa_op_ret()); res = list_push(res, 0); imms = list_push(imms, 0); lhss = list_push(lhss, 0); bids = list_push(bids, 3);
    let mut names: List[String] = list_new();
    names = list_push(names, "entry"); names = list_push(names, "then1"); names = list_push(names, "then2"); names = list_push(names, "merge");
    let f: SsaFunction = SsaFunction {
        name: "diamond", return_type: 0, block_count: 4, block_names: names,
        inst_opcodes: ops, inst_results: res, inst_imm_vals: imms,
        inst_lhs_vals: lhss, inst_block_ids: bids
    };
    let idom: List[Int] = ssa_compute_dominators(&f);
    let i0: Int = list_get(idom, 0); let i1: Int = list_get(idom, 1); let i2: Int = list_get(idom, 2); let i3: Int = list_get(idom, 3);
    return v019_assert("test_v019_dom_diamond", i0 == 0 && i1 == 0 && i2 == 0 && i3 == 0);
}

pub fn test_v019_dom_loop() -> Int {
    let mut ops: List[Int] = list_new(); let mut res: List[Int] = list_new(); let mut imms: List[Int] = list_new(); let mut lhss: List[Int] = list_new(); let mut bids: List[Int] = list_new();
    ops = list_push(ops, ssa_op_cond_br()); res = list_push(res, 1); imms = list_push(imms, 3); lhss = list_push(lhss, 0); bids = list_push(bids, 0);
    ops = list_push(ops, ssa_op_cond_br()); res = list_push(res, 2); imms = list_push(imms, 1); lhss = list_push(lhss, 0); bids = list_push(bids, 1);
    ops = list_push(ops, ssa_op_br()); res = list_push(res, 0); imms = list_push(imms, 1); lhss = list_push(lhss, 0); bids = list_push(bids, 2);
    ops = list_push(ops, ssa_op_ret()); res = list_push(res, 0); imms = list_push(imms, 0); lhss = list_push(lhss, 0); bids = list_push(bids, 3);
    let mut names: List[String] = list_new();
    names = list_push(names, "entry"); names = list_push(names, "loop_head"); names = list_push(names, "loop_body"); names = list_push(names, "exit");
    let f: SsaFunction = SsaFunction {
        name: "loop", return_type: 0, block_count: 4, block_names: names,
        inst_opcodes: ops, inst_results: res, inst_imm_vals: imms,
        inst_lhs_vals: lhss, inst_block_ids: bids
    };
    let idom: List[Int] = ssa_compute_dominators(&f);
    let i0: Int = list_get(idom, 0); let i1: Int = list_get(idom, 1); let i2: Int = list_get(idom, 2); let i3: Int = list_get(idom, 3);
    return v019_assert("test_v019_dom_loop", i0 == 0 && i1 == 0 && i2 == 1 && i3 == 0);
}

pub fn test_v019_simd_fma_emit() -> Int {
    let mut env: List[String] = list_new();
    env = list_push(env, "0"); env = list_push(env, "s1"); env = list_push(env, "s2"); env = list_push(env, "s3"); env = list_push(env, "s4");
    let r: List[String] = llvm_emit_simd_fma("<4 x float>", "%v0", "%v1", "%v2", env);
    let n: Int = list_len(r); let treg: String = list_get(r, 0); let lty: String = list_get(r, 1); let nctr: String = list_get(r, 2);
    let p1: Bool = n == 7; let p2: Bool = v019_contains(treg, "%t"); let p3: Bool = lty == "<4 x float>"; let p4: Bool = nctr == "1";
    return v019_assert("test_v019_simd_fma_emit", p1 && p2 && p3 && p4);
}

pub fn test_v019_simd_fadd_emit() -> Int {
    let mut env: List[String] = list_new();
    env = list_push(env, "0"); env = list_push(env, "s1"); env = list_push(env, "s2"); env = list_push(env, "s3"); env = list_push(env, "s4");
    let r: List[String] = llvm_emit_simd_fadd("<8 x float>", "%a", "%b", env);
    let n: Int = list_len(r); let treg: String = list_get(r, 0); let lty: String = list_get(r, 1); let nctr: String = list_get(r, 2);
    let p1: Bool = n == 7; let p2: Bool = v019_contains(treg, "%t"); let p3: Bool = lty == "<8 x float>"; let p4: Bool = nctr == "1";
    return v019_assert("test_v019_simd_fadd_emit", p1 && p2 && p3 && p4);
}

pub fn test_v019_suite() -> Int {
    let mut total: Int = 0;
    total = total + test_v019_pgo_string();
    total = total + test_v019_loop_meta();
    total = total + test_v019_simd_types();
    total = total + test_v019_lto_dispatch();
    total = total + test_v019_mem2reg_linear();
    total = total + test_v019_mem2reg_diamond();
    total = total + test_v019_dom_linear();
    total = total + test_v019_dom_diamond();
    total = total + test_v019_dom_loop();
    total = total + test_v019_simd_fma_emit();
    total = total + test_v019_simd_fadd_emit();
    if total == 11 { println("OK\tllvm_v019_suite\t11/11 tests passed"); }
    else { println("FAIL\tllvm_v019_suite\t" + total.to_string() + "/11 tests passed"); }
    return total;
}

pub fn main() {
    test_v019_suite();
}
