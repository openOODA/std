// # Int Result refuses String Ok
//
// Logline: emit-llvm fail-closes Ok("x") written into Result[Int, String].
//
// Setup: Backend-LLVM. Not a run lock.
//
// Beats:
//   1. Annotate r as Result[Int, String].
//   2. Assign Ok("x").
//   3. Emit must print ERR llvm_emit.

pub fn verify_llvm_okstr_into_int() -> Bool {
    let r: Result[Int, String] = Ok("x");
    println(r.is_ok().to_string());
    return true;
}
