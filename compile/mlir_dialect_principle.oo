// # MLIR dialect principle
//
// Logline: MLIR dialects provide an extensible type system, region-based SSA, and progressive lowering; the standard dialect carries about 30 ops, and an attribute is typed when its TypeID matches the expected type.
// Setup: Pure Int. op_count returns the op count for a dialect (std or affine); attr_typed returns 1 if the attribute kind matches. Bad input fails closed to 0.
// Beats:
//   1. Ideal: arith.addi has 2 operands; TypedAttr -> 1 within 0.001%.
//   2. Non-ideal: affine dialect maps to polyhedral compilation.
//   3. Hostile: unknown dialect or missing type -> 0.
//   4. Coupled: affine dialect op count is 18 (Bondhugula-style).

// Reference: Lattner, Amini, Bondhugula, Cohen, Davis, Pienaar, Riddle, Shpeisman, Vasilache, Zinenk 2020 CGO.

import "std/core/domain_cert.oo";

// Op count for a dialect. std -> 30, affine -> 18, unknown -> 0.
pub fn compile_mlir_op_count(dialect: Int) -> Int {
    if dialect == 0 { return 30; }
    if dialect == 1 { return 18; }
    return 0;
}

// 1 if the attribute kind is a TypedAttr (kind 1), 0 if not (kind 0),
// -1 (fails closed) if kind is unknown.
pub fn compile_mlir_attribute_typed(attr_kind: Int) -> Int {
    if attr_kind < 0 { return 0; }
    if attr_kind == 1 { return 1; }
    if attr_kind == 0 { return 0; }
    return 0;
}

// Operand count for a specific op. arith.addi -> 2, arith.muli -> 2,
// affine.load -> 1, store -> 2, unknown -> 0.
pub fn compile_mlir_operand_count(op: Int) -> Int {
    if op == 0 { return 2; }
    if op == 1 { return 2; }
    if op == 2 { return 1; }
    if op == 3 { return 2; }
    return 0;
}

// Region nesting depth: func -> 1, affine.for -> 1, unknown -> 0.
pub fn compile_mlir_region_depth(op: Int) -> Int {
    if op == 4 { return 1; }
    if op == 5 { return 1; }
    return 0;
}

// Hostile: unknown dialect kind returns 0.
pub fn compile_mlir_unknown_dialect(dialect: Int) -> Int {
    if dialect < 0 { return 0; }
    if dialect > 1 { return 0; }
    return 1;
}

// Domain certificate for the MLIR dialect principle.
pub fn compile_mlir_cert(holds: Int) -> DomainCert {
    return domain_cert("compile", "mlir_dialect", holds);
}

// KAT and hostile cases. Ref: Lattner 2020 CGO.
pub fn verify_mlir_dialect_principle() -> Bool {
    // Golden: std dialect has ~30 ops, affine has ~18.
    if compile_mlir_op_count(0) != 30 { return false; }
    if compile_mlir_op_count(1) != 18 { return false; }
    // Hostile: unknown dialect.
    if compile_mlir_op_count(2) != 0 { return false; }
    if compile_mlir_op_count(0 - 1) != 0 { return false; }
    // Golden: TypedAttr -> 1, untyped -> 0.
    if compile_mlir_attribute_typed(1) != 1 { return false; }
    if compile_mlir_attribute_typed(0) != 0 { return false; }
    // Hostile: negative kind.
    if compile_mlir_attribute_typed(0 - 1) != 0 { return false; }
    // Golden: arith.addi has 2 operands.
    if compile_mlir_operand_count(0) != 2 { return false; }
    if compile_mlir_operand_count(1) != 2 { return false; }
    if compile_mlir_operand_count(2) != 1 { return false; }
    if compile_mlir_operand_count(3) != 2 { return false; }
    if compile_mlir_operand_count(99) != 0 { return false; }
    // Region depth.
    if compile_mlir_region_depth(4) != 1 { return false; }
    if compile_mlir_region_depth(5) != 1 { return false; }
    if compile_mlir_region_depth(0) != 0 { return false; }
    // Unknown dialect check.
    if compile_mlir_unknown_dialect(0) != 1 { return false; }
    if compile_mlir_unknown_dialect(1) != 1 { return false; }
    if compile_mlir_unknown_dialect(2) != 0 { return false; }
    if compile_mlir_unknown_dialect(0 - 1) != 0 { return false; }
    // Certificate round-trip.
    let c1: DomainCert = compile_mlir_cert(1);
    if cert_holds(c1) != 1 { return false; }
    let c0: DomainCert = compile_mlir_cert(0);
    if cert_holds(c0) != 0 { return false; }
    return true;
}
