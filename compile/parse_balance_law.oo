// # Parser balance law
//
// Logline: A delimiter stream of +1 (open) and -1 (close) is balanced when the running sum is non-negative and the final sum is 0.
//
// Setup: Pure Int. deltas is a List[Int] of +1 and -1 only. Other values fail closed.
//
// Beats:
//   1. parse_fold returns the running sum or a hostile -1 marker when balance would go negative.
//   2. parse_is_balanced holds when the fold is 0 and never negative.
//   3. parse_max_balance reports the peak running sum seen.
//   4. Empty stream is balanced by definition (0 == 0 and never went negative).

// Fold a sequence of +1 / -1 deltas into a running balance.
// Returns -1 (hostile marker) the first time the running sum would go below 0.
pub fn compile_parse_fold(deltas: List[Int]) -> Int {
    let n: Int = list_len(deltas);
    let mut b: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let d: Int = list_get(deltas, i);
        let next: Int = b + d;
        if next < 0 {
            return 0 - 1;
        }
        b = next;
        i = i + 1;
    }
    return b;
}

// True (1) when the stream is balanced: fold returns 0 and the stream was not hostile.
pub fn compile_parse_is_balanced(deltas: List[Int]) -> Int {
    let n: Int = list_len(deltas);
    if n == 0 {
        return 1;
    }
    if n % 2 != 0 {
        return 0;
    }
    let b: Int = compile_parse_fold(deltas);
    if b == 0 {
        return 1;
    }
    return 0;
}

fn pbal_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Peak running sum across the fold. Empty peak is Ok(0). A negative running sum is Err.
pub fn compile_parse_max_balance(deltas: List[Int]) -> Result[Int, String] {
    let n: Int = list_len(deltas);
    let mut b: Int = 0;
    let mut peak: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let d: Int = list_get(deltas, i);
        let next: Int = b + d;
        if next < 0 {
            return Err("ERR\tpbal\tdomain");
        }
        b = next;
        if b > peak {
            peak = b;
        }
        i = i + 1;
    }
    return Ok(peak);
}

// Build a balanced ()() stream.
fn compile_parse_ab() -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 1);
    out = list_push(out, 0 - 1);
    out = list_push(out, 1);
    out = list_push(out, 0 - 1);
    return out;
}

// Build a balanced ((())) stream with peak 3.
fn compile_parse_deep() -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 1);
    out = list_push(out, 1);
    out = list_push(out, 1);
    out = list_push(out, 0 - 1);
    out = list_push(out, 0 - 1);
    out = list_push(out, 0 - 1);
    return out;
}

// Build a hostile )( stream.
fn compile_parse_bad() -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 0 - 1);
    out = list_push(out, 1);
    return out;
}

// Build an unbalanced (() stream.
fn compile_parse_unbal() -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 1);
    out = list_push(out, 1);
    out = list_push(out, 0 - 1);
    return out;
}

// Build an odd-length stream that cannot balance.
fn compile_parse_odd() -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 1);
    out = list_push(out, 0 - 1);
    out = list_push(out, 1);
    return out;
}

pub fn verify_parse_balance_law() -> Bool {
    // Golden: empty stream is balanced with peak 0.
    let empty: List[Int] = list_new();
    if compile_parse_is_balanced(empty) != 1 { return false; }
    let zpeak: Result[Int, String] = compile_parse_max_balance(empty);
    if zpeak.is_ok() == false { return false; }
    if pbal_got(zpeak) != 0 { return false; }

    // Golden: ()() -> balanced, fold 0, peak 1.
    let ab: List[Int] = compile_parse_ab();
    if compile_parse_is_balanced(ab) != 1 { return false; }
    if compile_parse_fold(ab) != 0 { return false; }
    if pbal_got(compile_parse_max_balance(ab)) != 1 { return false; }

    // Golden: ((())) -> peak 3, balanced.
    let deep: List[Int] = compile_parse_deep();
    if compile_parse_is_balanced(deep) != 1 { return false; }
    if pbal_got(compile_parse_max_balance(deep)) != 3 { return false; }

    // Hostile: )( goes negative mid-fold, so fold is -1 and balanced is 0.
    let bad: List[Int] = compile_parse_bad();
    if compile_parse_fold(bad) != 0 - 1 { return false; }
    if compile_parse_is_balanced(bad) != 0 { return false; }
    if compile_parse_max_balance(bad).is_ok() { return false; }

    // Hostile: (() has fold 1, balanced is 0, peak 2.
    let unbal: List[Int] = compile_parse_unbal();
    if compile_parse_fold(unbal) != 1 { return false; }
    if compile_parse_is_balanced(unbal) != 0 { return false; }
    if pbal_got(compile_parse_max_balance(unbal)) != 2 { return false; }

    // Hostile: odd length cannot be balanced.
    let odd: List[Int] = compile_parse_odd();
    if compile_parse_is_balanced(odd) != 0 { return false; }

    return true;
}
