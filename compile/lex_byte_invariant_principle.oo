// # Lexer byte invariant principle
//
// Logline: A byte at source position i is an Int in [0, 255] and equals the input byte masked to 8 bits.
//
// Setup: Pure Int. Mirrors std/core/byte.oo invariant. Lexer reads one byte at a time.
//
// Beats:
//   1. lex_byte_value(raw) returns (raw & 255), in range 0..255.
//   2. lex_is_ascii(v) holds when v is non-negative and v & 255 < 128.
//   3. lex_byte_eq(a, b) holds when both masked bytes match exactly.
//   4. Negative raw fails closed: byte value is 0 and is_ascii returns 0.

fn lexb_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Mask a source byte to 8 bits. raw=0 is Ok(0). 256 wraps to Ok(0). Negative is Err.
pub fn compile_lex_byte_value(raw: Int) -> Result[Int, String] {
    if raw < 0 { return Err("ERR\tlexb\tdomain"); }
    return Ok(raw & 255);
}

// ASCII range check. Hostile negative input fails closed to 0.
pub fn compile_lex_is_ascii(v: Int) -> Int {
    if v < 0 {
        return 0;
    }
    if (v & 255) < 128 {
        return 1;
    }
    return 0;
}

// Byte equality after masking. Both args are masked to 8 bits.
pub fn compile_lex_byte_eq(a: Int, b: Int) -> Int {
    let ar: Result[Int, String] = compile_lex_byte_value(a);
    let br: Result[Int, String] = compile_lex_byte_value(b);
    if ar.is_ok() == false { return 0; }
    if br.is_ok() == false { return 0; }
    if lexb_got(ar) == lexb_got(br) { return 1; }
    return 0;
}

pub fn verify_lex_byte_invariant_principle() -> Bool {
    // Golden: ASCII 'A' (65) is ASCII and matches itself.
    if lexb_got(compile_lex_byte_value(65)) != 65 { return false; }
    if compile_lex_is_ascii(65) != 1 { return false; }
    if compile_lex_byte_eq(65, 65) != 1 { return false; }
    // Golden: hi-bit byte 200 is not ASCII but still in 8-bit range.
    if lexb_got(compile_lex_byte_value(200)) != 200 { return false; }
    if compile_lex_is_ascii(200) != 0 { return false; }
    if lexb_got(compile_lex_byte_value(255)) != 255 { return false; }
    let zbyte: Result[Int, String] = compile_lex_byte_value(0);
    if zbyte.is_ok() == false { return false; }
    if lexb_got(zbyte) != 0 { return false; }
    let wrap: Result[Int, String] = compile_lex_byte_value(256);
    if wrap.is_ok() == false { return false; }
    if lexb_got(wrap) != 0 { return false; }
    if lexb_got(compile_lex_byte_value(257)) != 1 { return false; }
    if lexb_got(compile_lex_byte_value(511)) != 255 { return false; }
    // Golden: 65 and 321 (65+256) compare equal after masking.
    if compile_lex_byte_eq(65, 321) != 1 { return false; }
    // Hostile: negative input fails closed to 0.
    if compile_lex_byte_value(0 - 1).is_ok() { return false; }
    if compile_lex_is_ascii(0 - 5) != 0 { return false; }
    // Hostile: 65 vs 66 do not match.
    if compile_lex_byte_eq(65, 66) != 0 { return false; }
    // Hostile: 128 is not ASCII.
    if compile_lex_is_ascii(128) != 0 { return false; }
    return true;
}
