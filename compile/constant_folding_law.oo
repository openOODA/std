// # Constant folding law
//
// Logline: Constant folding evaluates a postorder tree of compile-time Ints and returns Ok of the result, or Err on empty, malformed, div-zero, or unknown-op input.
//
// Setup: Pure Int. AST is a flat postorder list: ops[i] is the op code (-1 = LEAF, 0 = +, 1 = -, 2 = *, 3 = /). leaves[i] is the value when ops[i] = LEAF. n_nodes > 0 or Err domain.
//
// Beats:
//   1. Ideal (binary): 3 + 5 -> 8, 2 * 3 -> 6, 10 / 2 -> 5.
//   2. Non-ideal (n-ary): tree with mixed leaves and ops reduces left to right; ((1+2)-3)*4 is Ok(0).
//   3. Hostile: empty, length mismatch, and stack underflow return Err domain; div0 and unknown op return distinct Err.
//   4. Coupled: strength reduction turns 2 * x into x + x.

import "std/core/domain_cert.oo";

// Op codes.
pub fn compile_cf_add() -> Int { return 0; }
pub fn compile_cf_sub() -> Int { return 1; }
pub fn compile_cf_mul() -> Int { return 2; }
pub fn compile_cf_div() -> Int { return 3; }
pub fn compile_cf_leaf() -> Int { return 0 - 1; }

fn cf_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Evaluate a constant expression tree in postorder. ops[i] is the op code
// for the i-th visited node; leaves[i] holds the value when ops[i] is LEAF.
// On a non-LEAF op, the top of stack is the right child and the next is the
// left child. Empty, malformed, or bad-arity input returns Err domain.
pub fn compile_cf_fold(ops: List[Int], leaves: List[Int], n_nodes: Int) -> Result[Int, String] {
    if n_nodes <= 0 { return Err("ERR\tcf\tdomain"); }
    if list_len(ops) != n_nodes { return Err("ERR\tcf\tdomain"); }
    if list_len(leaves) != n_nodes { return Err("ERR\tcf\tdomain"); }
    let mut stack: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n_nodes {
        let op: Int = list_get(ops, i);
        if op == 0 - 1 {
            let v: Int = list_get(leaves, i);
            stack = list_push(stack, v);
        } else {
            let slen: Int = list_len(stack);
            if slen < 2 { return Err("ERR\tcf\tdomain"); }
            let r: Int = list_get(stack, slen - 1);
            stack = compile_cf_pop(stack);
            let l: Int = list_get(stack, list_len(stack) - 1);
            stack = compile_cf_pop(stack);
            let applied: Result[Int, String] = compile_cf_apply(op, l, r);
            match applied {
                Ok(res) => { stack = list_push(stack, res); },
                Err(e)  => { return Err(e); }
            }
        }
        i = i + 1;
    }
    if list_len(stack) != 1 { return Err("ERR\tcf\tdomain"); }
    return Ok(list_get(stack, 0));
}

// Apply a binary op. Division by zero returns Err div0; unknown op returns Err op.
pub fn compile_cf_apply(op: Int, l: Int, r: Int) -> Result[Int, String] {
    if op == 0 { return Ok(l + r); }
    if op == 1 { return Ok(l - r); }
    if op == 2 { return Ok(l * r); }
    if op == 3 {
        if r == 0 { return Err("ERR\tcf\div0"); }
        return Ok(l / r);
    }
    return Err("ERR\tcf\top");
}

// Pop the last element of a list and return the rest.
fn compile_cf_pop(xs: List[Int]) -> List[Int] {
    let n: Int = list_len(xs);
    if n <= 0 { return xs; }
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n - 1 {
        out = list_push(out, list_get(xs, i));
        i = i + 1;
    }
    return out;
}

// Strength reduction: replace 2 * x with x + x. Returns the new value
// when the input encodes "2 * x"; otherwise returns the original.
pub fn compile_cf_strength_reduce_two_mul_x(leaves: List[Int], x: Int) -> Int {
    if list_len(leaves) != 3 { return x; }
    if list_get(leaves, 1) != 2 { return x; }
    return x + x;
}

// Domain certificate for the constant folding law.
pub fn compile_cf_cert(holds: Int) -> DomainCert {
    return domain_cert("compile", "constant_folding", holds);
}

// KAT and hostile cases for the constant folding law.
pub fn verify_constant_folding_law() -> Bool {
    // Golden: 3 + 5 = 8 (binary). postorder: LEAF, LEAF, +
    let mut ops1: List[Int] = list_new();
    ops1 = list_push(ops1, 0 - 1);
    ops1 = list_push(ops1, 0 - 1);
    ops1 = list_push(ops1, 0);
    let mut leaves1: List[Int] = list_new();
    leaves1 = list_push(leaves1, 3);
    leaves1 = list_push(leaves1, 5);
    leaves1 = list_push(leaves1, 0);
    if cf_got(compile_cf_fold(ops1, leaves1, 3)) != 8 { return false; }
    // Golden: 2 * 3 = 6. postorder: LEAF, LEAF, *
    let mut ops2: List[Int] = list_new();
    ops2 = list_push(ops2, 0 - 1);
    ops2 = list_push(ops2, 0 - 1);
    ops2 = list_push(ops2, 2);
    let mut leaves2: List[Int] = list_new();
    leaves2 = list_push(leaves2, 2);
    leaves2 = list_push(leaves2, 3);
    leaves2 = list_push(leaves2, 0);
    if cf_got(compile_cf_fold(ops2, leaves2, 3)) != 6 { return false; }
    // Golden: 10 / 2 = 5. postorder: LEAF, LEAF, /
    let mut ops3: List[Int] = list_new();
    ops3 = list_push(ops3, 0 - 1);
    ops3 = list_push(ops3, 0 - 1);
    ops3 = list_push(ops3, 3);
    let mut leaves3: List[Int] = list_new();
    leaves3 = list_push(leaves3, 10);
    leaves3 = list_push(leaves3, 2);
    leaves3 = list_push(leaves3, 0);
    if cf_got(compile_cf_fold(ops3, leaves3, 3)) != 5 { return false; }
    // Non-ideal n-ary: ((1 + 2) - 3) * 4 = 0.
    // postorder: 1, 2, +, 3, -, 4, *  -> 7 nodes.
    let mut ops4: List[Int] = list_new();
    ops4 = list_push(ops4, 0 - 1);
    ops4 = list_push(ops4, 0 - 1);
    ops4 = list_push(ops4, 0);
    ops4 = list_push(ops4, 0 - 1);
    ops4 = list_push(ops4, 1);
    ops4 = list_push(ops4, 0 - 1);
    ops4 = list_push(ops4, 2);
    let mut leaves4: List[Int] = list_new();
    leaves4 = list_push(leaves4, 1);
    leaves4 = list_push(leaves4, 2);
    leaves4 = list_push(leaves4, 0);
    leaves4 = list_push(leaves4, 3);
    leaves4 = list_push(leaves4, 0);
    leaves4 = list_push(leaves4, 4);
    leaves4 = list_push(leaves4, 0);
    if cf_got(compile_cf_fold(ops4, leaves4, 7)) != 0 { return false; }
    // Hostile: empty tree fails closed.
    let empty: List[Int] = list_new();
    if compile_cf_fold(empty, empty, 0).is_ok() { return false; }
    // Hostile: division by zero fails closed.
    let mut ops5: List[Int] = list_new();
    ops5 = list_push(ops5, 0 - 1);
    ops5 = list_push(ops5, 0 - 1);
    ops5 = list_push(ops5, 3);
    let mut leaves5: List[Int] = list_new();
    leaves5 = list_push(leaves5, 10);
    leaves5 = list_push(leaves5, 0);
    leaves5 = list_push(leaves5, 0);
    if compile_cf_fold(ops5, leaves5, 3).is_ok() { return false; }
    // Hostile: malformed (op with no children) fails closed.
    let mut ops6: List[Int] = list_new();
    ops6 = list_push(ops6, 0);
    let mut leaves6: List[Int] = list_new();
    leaves6 = list_push(leaves6, 0);
    if compile_cf_fold(ops6, leaves6, 1).is_ok() { return false; }
    // Hostile: ops length mismatch.
    if compile_cf_fold(empty, leaves1, 3).is_ok() { return false; }
    // Hostile: leaves length mismatch.
    if compile_cf_fold(ops1, empty, 3).is_ok() { return false; }
    // Hostile: unknown op and apply-level div0.
    if compile_cf_apply(4, 1, 1).is_ok() { return false; }
    if compile_cf_apply(3, 1, 0).is_ok() { return false; }
    if cf_got(compile_cf_apply(1, 3, 3)) != 0 { return false; }
    // Coupled strength reduction: 2 * 7 = 14; 2 * x -> x + x.
    let mut sr: List[Int] = list_new();
    sr = list_push(sr, 0);
    sr = list_push(sr, 2);
    sr = list_push(sr, 7);
    if compile_cf_strength_reduce_two_mul_x(sr, 7) != 14 { return false; }
    if compile_cf_strength_reduce_two_mul_x(empty, 7) != 7 { return false; }
    // Op-code accessors.
    if compile_cf_add() != 0 { return false; }
    if compile_cf_sub() != 1 { return false; }
    if compile_cf_mul() != 2 { return false; }
    if compile_cf_div() != 3 { return false; }
    if compile_cf_leaf() != 0 - 1 { return false; }
    // Certificate round-trip.
    let c1: DomainCert = compile_cf_cert(1);
    if cert_holds(c1) != 1 { return false; }
    let c0: DomainCert = compile_cf_cert(0);
    if cert_holds(c0) != 0 { return false; }
    let c2: DomainCert = compile_cf_cert(2);
    if cert_holds(c2) != 0 { return false; }
    return true;
}
