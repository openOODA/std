// # Hermetic build sandbox orchestrator
//
// Logline: Run the compiler child in a private work directory inside user/mount/PID namespaces when unshare works.
//
// Setup: SysCap runs unshare and the wrapped command. Namespace failure returns Err and does not skip env strip.
//
// Beats:
//   1. Pin SOURCE_DATE_EPOCH to 1700000000, TZ to UTC, and PATH to /usr/bin:/bin.
//   2. Drop ambient USER, HOSTNAME, and RANDOM, and set TMPDIR under the write dir.
//   3. After make-rprivate, exec ooda __hermetic_landlock then the compile; unshare failure is ERR.

pub fn hermetic_epoch() -> String {
    return "1700000000";
}

pub fn hermetic_path() -> String {
    return "/usr/bin:/bin";
}

pub fn hermetic_sq(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    let mut out: String = "'";
    while i < n {
        let c: String = char_at(s, i);
        if c == "'" {
            out = out + "'\\''";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out + "'";
}

pub fn hermetic_env_prefix() -> String {
    let epoch: String = hermetic_epoch();
    let path: String = hermetic_path();
    return "env -i SOURCE_DATE_EPOCH=" + epoch + " PATH=" + path + " HOME=/nonexistent LC_ALL=C TZ=UTC TMPDIR=\"${OODA_FS_WRITEDIR:-/tmp/ooda-repro}/repro-tmp\" OODA_FS_WRITEDIR=\"${OODA_FS_WRITEDIR:-/tmp/ooda-repro}\" OODA_FS_READDIR=\"$OODA_FS_READDIR\" OODA_SRC_ROOT=\"$OODA_SRC_ROOT\"";
}

pub fn hermetic_wrap_cmd(inner: String) -> String {
    let body: String = "mkdir -p \"$TMPDIR\" && " + inner;
    return hermetic_env_prefix() + " sh -c " + hermetic_sq(body);
}

pub fn hermetic_unshare_prefix() -> String {
    return "/usr/bin/unshare --user --map-root-user --pid --fork --mount --net --ipc --uts -- ";
}

pub fn hermetic_wrap_unshare(inner: String) -> String {
    let jail: String = "mount --make-rprivate / || exit 1; printf %s " + hermetic_sq(inner) + " > \"$TMPDIR/jail.sh\" || exit 1; exec ./bin/ooda __hermetic_landlock \"$TMPDIR/jail.sh\"";
    return hermetic_unshare_prefix() + hermetic_wrap_cmd(jail);
}

pub fn hermetic_unshare_probe_cmd() -> String {
    return hermetic_unshare_prefix() + "sh -c " + hermetic_sq("mount --make-rprivate / || exit 1; true");
}

pub fn hermetic_apply_namespaces(proc: &ProcessCap) -> Result[String, String] {
    let r: Result[String, String] = sys_exec(proc, "sh", "-c", hermetic_unshare_probe_cmd());
    if r.is_err() {
        return Err("ERR\thermetic\tnamespace unavailable");
    }
    return Ok("ok");
}

pub fn hermetic_run(proc: &ProcessCap, inner: String) -> Result[String, String] {
    let ns: Result[String, String] = hermetic_apply_namespaces(proc);
    if ns.is_err() {
        return Err("ERR\thermetic\tnamespace unavailable");
    }
    let r: Result[String, String] = sys_exec(proc, "sh", "-c", hermetic_wrap_unshare(inner));
    if r.is_err() {
        return Err("ERR\thermetic\tnamespace unavailable");
    }
    return r;
}

pub fn hermetic_writedir(proc: &ProcessCap, fs: &FsReadCap) -> Result[String, String] {
    let ptr: String = "/tmp/ooda-repro-wd-ptr.txt";
    let cmd: String = "test -n \"$OODA_FS_WRITEDIR\" && mkdir -p \"$OODA_FS_WRITEDIR\" && printf %s \"$OODA_FS_WRITEDIR\" > \"$OODA_FS_WRITEDIR/repro-wd.txt\" && printf %s \"$OODA_FS_WRITEDIR\" > " + hermetic_sq(ptr);
    let w: Result[String, String] = sys_exec(proc, "sh", "-c", cmd);
    if w.is_err() {
        return Err("ERR\thermetic\twritedir");
    }
    let p: Result[String, String] = read_file(fs, ptr);
    if p.is_err() {
        return Err("ERR\thermetic\twritedir");
    }
    let s: String = match p { Ok(v) => v, Err(_) => "" };
    if chars_len(s) <= 0 {
        return Err("ERR\thermetic\twritedir");
    }
    if str_slice(s, 0, 1) != "/" {
        return Err("ERR\thermetic\twritedir");
    }
    return Ok(s);
}

pub fn hermetic_ns_stat_cmd(path: String) -> String {
    return "stat -c %i /proc/self/ns/pid /proc/self/ns/mnt /proc/self/ns/user /proc/self/ns/net /proc/self/ns/ipc /proc/self/ns/uts > " + path + " && pwd >> " + path;
}

pub fn hermetic_bind_or_copy(proc: &ProcessCap, src: String, dest: String) -> Result[String, String] {
    let mk: Result[String, String] = hermetic_prepare(proc, dest);
    if mk.is_err() {
        return Err("ERR\thermetic\tbind mkdir");
    }
    let b: Result[String, String] = sys_exec(proc, "sh", "-c", "mount --bind " + hermetic_sq(src) + " " + hermetic_sq(dest));
    if b.is_ok() {
        return Ok(dest);
    }
    let cp: Result[String, String] = sys_exec(proc, "sh", "-c", "rmdir " + hermetic_sq(dest) + " 2>/dev/null; cp -a " + hermetic_sq(src) + " " + hermetic_sq(dest));
    if cp.is_ok() {
        return Ok(dest);
    }
    return Err("ERR\thermetic\tbind");
}

pub fn hermetic_apply_landlock(sys: &SysCap, writedir: String) -> Result[String, String] {
    if str_slice(writedir, 0, 1) != "/" {
        return Err("ERR\thermetic\tlandlock");
    }
    let avail: Int = oo_landlock_is_available();
    if avail == 0 {
        return Ok("unavailable");
    }
    let r: Result[String, String] = landlock_restrict(sys, "/", writedir);
    if r.is_err() {
        return Err("ERR\thermetic\tlandlock");
    }
    return Ok("ok");
}

pub fn hermetic_ns_host(proc: &ProcessCap, path: String) -> Result[String, String] {
    return sys_exec(proc, "sh", "-c", hermetic_ns_stat_cmd(path));
}

pub fn hermetic_ns_child(proc: &ProcessCap, path: String) -> Result[String, String] {
    return hermetic_run(proc, hermetic_ns_stat_cmd(path));
}

pub fn hermetic_prepare(proc: &ProcessCap, dir: String) -> Result[String, String] {
    let mk: Result[String, String] = sys_exec(proc, "sh", "-c", "mkdir -p " + hermetic_sq(dir));
    if mk.is_err() {
        return Err("ERR\thermetic\tmkdir");
    }
    return Ok(dir);
}

pub fn hermetic_run_in(proc: &ProcessCap, dir: String, inner: String) -> Result[String, String] {
    let prep: Result[String, String] = hermetic_prepare(proc, dir);
    if prep.is_err() {
        return Err("ERR\thermetic\tmkdir");
    }
    let tmpd: String = dir + "/.tmp";
    let _t: Result[String, String] = hermetic_prepare(proc, tmpd);
    let body: String = "cd " + hermetic_sq(dir) + " && export TMPDIR=" + hermetic_sq(tmpd) + " && " + inner;
    return hermetic_run(proc, body);
}
