// # Dual-run reproducibility verifier
//
// Logline: Compile one target twice under different sandbox paths and fail closed unless the two .bin SHA-256 digests match.
//
// Setup: SysCap runs oodac and gcc. Fs caps read and write sandbox files. Hash is crypto_sha256_internal.
//
// Beats:
//   1. Emit C twice into two sandbox directories and gcc with pinned epoch and prefix-map flags.
//   2. Compare SHA-256 of the two .bin files and return Ok only when they match.
//   3. A planted byte difference returns ERR and does not skip-PASS.

import "std/sec/hash/sha256.oo";
import "std/compile/reproducible_build/build_hermetic_sandbox.oo";

pub fn repro_gcc_flags(sandbox: String) -> String {
    return "-O0 -g0 -fno-ident -frandom-seed=1 -Wl,--build-id=none -ffile-prefix-map=" + sandbox + "=/ooda -fdebug-prefix-map=" + sandbox + "=/ooda -fmacro-prefix-map=" + sandbox + "=/ooda";
}

pub fn repro_file_sha(fs: &FsReadCap, path: String) -> Result[String, String] {
    if !path_exists(fs, path) {
        return Err("ERR\trepro\tmissing bin");
    }
    let body: Result[String, String] = read_file(fs, path);
    if body.is_err() {
        return Err("ERR\trepro\tread bin");
    }
    let b: String = match body { Ok(s) => s, Err(_) => "" };
    return Ok(sha256(b));
}

pub fn repro_verify_equal(ha: String, hb: String) -> Result[String, String] {
    if ha == hb {
        return Ok(ha);
    }
    return Err("ERR\trepro\tmismatch");
}

fn repro_join_hp(p: String) -> String {
    if chars_len(p) > 0 {
        if str_slice(p, 0, 1) == "/" {
            return p;
        }
    }
    return "$HP/" + p;
}

pub fn repro_compile_c(sys: &ProcessCap, src_c: String, out_bin: String, sandbox: String, rt: String) -> Result[String, String] {
    let flags: String = repro_gcc_flags(sandbox);
    let inner: String = "gcc " + flags + " -I" + rt + " " + rt + "/chs_rt.c " + src_c + " -o " + out_bin + " -lm -ldl -lpthread";
    return hermetic_run_in(sys, sandbox, inner);
}

pub fn repro_emit_c(sys: &ProcessCap, oodac: String, src: String, out_c: String) -> Result[String, String] {
    return hermetic_run(sys, oodac + " emit-c " + src + " > " + out_c + " 2> " + out_c + ".err");
}

pub fn repro_build_one(sys: &ProcessCap, src: String, sandbox: String, oodac: String, rt: String, dest: String) -> Result[String, String] {
    let prep: Result[String, String] = hermetic_prepare(sys, sandbox);
    if prep.is_err() {
        return Err("ERR\trepro\tmkdir");
    }
    let cp: Result[String, String] = sys_exec(sys, "sh", "-c", "cp " + hermetic_sq(src) + " " + hermetic_sq(sandbox + "/in.oo") + " && pwd > " + hermetic_sq(sandbox + "/host.pwd") + " && printf %s " + hermetic_sq(rt) + " > " + hermetic_sq(sandbox + "/host.rt"));
    if cp.is_err() {
        return Err("ERR\trepro\tcopy");
    }
    let flags: String = repro_gcc_flags(sandbox);
    let ood: String = repro_join_hp(oodac);
    let outp: String = repro_join_hp(dest);
    let inner: String = "HP=$(cat host.pwd); HRT=$(cat host.rt); case \"$HRT\" in /*) R=\"$HRT\";; *) R=\"$HP/$HRT\";; esac; mkdir -p rt; if ! mount --bind \"$R\" rt > bind.err 2>&1; then rm -rf rt; cp -a \"$R\" rt || exit 1; fi; " + ood + " emit-c in.oo > t.c 2> t.err && gcc " + flags + " -Irt rt/chs_rt.c t.c -o " + outp + " -lm -ldl -lpthread";
    let br: Result[String, String] = hermetic_run_in(sys, sandbox, inner);
    if br.is_err() {
        return Err("ERR\trepro\tbuild");
    }
    return Ok(dest);
}

pub fn repro_dual_run(sys: &ProcessCap, fs: &FsReadCap, src: String, dir_a: String, dir_b: String, oodac: String, rt: String) -> Result[String, String] {
    let ba: String = dir_a + "/t.bin";
    let bb: String = dir_b + "/t.bin";
    let ga: Result[String, String] = repro_build_one(sys, src, dir_a, oodac, rt, ba);
    let gb: Result[String, String] = repro_build_one(sys, src, dir_b, oodac, rt, bb);
    if ga.is_err() || gb.is_err() {
        return Err("ERR\trepro\tbuild");
    }
    let ha: Result[String, String] = repro_file_sha(fs, ba);
    let hb: Result[String, String] = repro_file_sha(fs, bb);
    if ha.is_err() || hb.is_err() {
        return Err("ERR\trepro\thash");
    }
    let sa: String = match ha { Ok(s) => s, Err(_) => "" };
    let sb: String = match hb { Ok(s) => s, Err(_) => "" };
    return repro_verify_equal(sa, sb);
}
