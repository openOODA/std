// # Hostile Probes and Double-Run Determinism Proof
//
// Logline: Run the parser twice over the same input and assert byte-identical stats; run hostile inputs and assert fail-closed behavior.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) D1/D3 negative-trust probe harness.
//
// Beats:
//   1. Define HostileCase and HostileReport structures.
//   2. Run a double-run determinism check.
//   3. Run a battery of malformed inputs (empty, unterminated, unbalanced, garbage).
//   4. Assert each hostile input returns a fail-closed ParseStats, never a crash.

import "jsonl_strict.oo";

type HostileCase = struct {
    name: String,
    input: String,
    expect_lines_parsed: Int,
    expect_lines_failed: Int
};

type HostileReport = struct {
    cases_total: Int,
    cases_passed: Int,
    cases_failed: Int,
    determinism_ok: Bool,
    first_run_signature: Int,
    second_run_signature: Int
};

pub fn hostile_case_new(
    name: String,
    input: String,
    parsed: Int,
    failed: Int
) -> HostileCase {
    return HostileCase {
        name: name,
        input: input,
        expect_lines_parsed: parsed,
        expect_lines_failed: failed
    };
}

pub fn hostile_report_new() -> HostileReport {
    return HostileReport {
        cases_total: 0,
        cases_passed: 0,
        cases_failed: 0,
        determinism_ok: true,
        first_run_signature: 0,
        second_run_signature: 0
    };
}

pub fn parse_stats_signature(s: ParseStats) -> Int {
    let mut h: Int = 5381;
    h = ((h * 33) + s.lines_total) % 2147483647;
    h = ((h * 33) + s.lines_parsed) % 2147483647;
    h = ((h * 33) + s.lines_failed) % 2147483647;
    h = ((h * 33) + s.fields_total) % 2147483647;
    return h;
}

pub fn double_run_determinism_check(text: String) -> Bool {
    let r1: ParseStats = jsonl_strict_parse_transcript(text);
    let r2: ParseStats = jsonl_strict_parse_transcript(text);
    let s1: Int = parse_stats_signature(r1);
    let s2: Int = parse_stats_signature(r2);
    if s1 == s2 {
        if r1.lines_parsed == r2.lines_parsed {
            if r1.lines_failed == r2.lines_failed {
                return true;
            }
        }
    }
    return false;
}

pub fn hostile_run_case(c: HostileCase) -> Bool {
    let s: ParseStats = jsonl_strict_parse_transcript(c.input);
    if s.lines_parsed != c.expect_lines_parsed {
        return false;
    }
    if s.lines_failed != c.expect_lines_failed {
        return false;
    }
    return true;
}

pub fn hostile_run_battery() -> HostileReport {
    let mut report: HostileReport = hostile_report_new();
    let good: String = "{\"step\":0,\"type\":\"USER_INPUT\",\"prompt\":\"hi\"}\n{\"step\":1,\"type\":\"PLANNER_RESPONSE\",\"prompt\":\"ctx\",\"completion\":\"do it\"}\n";
    let det_ok: Bool = double_run_determinism_check(good);
    report.determinism_ok = det_ok;
    let r1: ParseStats = jsonl_strict_parse_transcript(good);
    let r2: ParseStats = jsonl_strict_parse_transcript(good);
    report.first_run_signature = parse_stats_signature(r1);
    report.second_run_signature = parse_stats_signature(r2);

    let mut cases: List[HostileCase] = list_new();
    cases = list_push(cases, hostile_case_new("valid_two_lines", good, 2, 0));
    cases = list_push(cases, hostile_case_new("unterminated_string", "{\"step\":0,\"type\":\"USER_INPUT\n", 0, 1));
    cases = list_push(cases, hostile_case_new("unbalanced_brace", "{\"step\":0,\"type\":\"USER_INPUT\"\n", 0, 1));
    cases = list_push(cases, hostile_case_new("missing_brace", "\"step\":0,\"type\":\"USER_INPUT\"}\n", 0, 1));
    cases = list_push(cases, hostile_case_new("garbage", "this is not json at all\n", 0, 1));
    cases = list_push(cases, hostile_case_new("nested_object", "{\"step\":0,\"meta\":{\"src\":\"x\"},\"type\":\"USER_INPUT\"}\n", 1, 0));
    cases = list_push(cases, hostile_case_new("single_char", "{\n", 0, 1));
    cases = list_push(cases, hostile_case_new("blank_line_mixed", "\n{\"step\":0,\"type\":\"USER_INPUT\"}\n\n", 1, 0));

    report.cases_total = list_len(cases);
    let n: Int = list_len(cases);
    let mut k: Int = 0;
    while k < n {
        let c: HostileCase = list_get(cases, k);
        if hostile_run_case(c) {
            report.cases_passed = report.cases_passed + 1;
        } else {
            report.cases_failed = report.cases_failed + 1;
        }
        k = k + 1;
    }
    return report;
}
