// # Lossless Semantic Code Minification and Token Pruning
//
// Logline: Strips comments, blank lines, and trailing whitespace while preserving every non-comment, non-blank line and every string literal; token reduction is the input/output diff over the standard (chars/4)+1 estimator.
//
// Setup: Pure source text and token minifier for context window optimization. Operates line-by-line; never touches the inside of a string literal.
//
// Beats:
//   1. Define MinifyOptions and MinifyResult structures.
//   2. Skip lines that are entirely comments or entirely blank.
//   3. Trim trailing whitespace; preserve at least one space between tokens; preserve the comment-free prefix of code lines that carry trailing comments.
//   4. Compute token reduction ratio and prove non-empty code preservation.

type MinifyOptions = struct {
    strip_comments: Bool,
    strip_blank_lines: Bool,
    compact_spaces: Bool,
    preserve_string_literals: Bool
};

type MinifyResult = struct {
    original_chars: Int,
    minified_chars: Int,
    original_estimated_tokens: Int,
    minified_estimated_tokens: Int,
    tokens_saved: Int,
    reduction_pct_x100: Int,
    output_text: String
};

pub fn minify_options_default() -> MinifyOptions {
    return MinifyOptions {
        strip_comments: true,
        strip_blank_lines: true,
        compact_spaces: true,
        preserve_string_literals: true
    };
}

pub fn minify_trim_right(s: String) -> String {
    let n: Int = chars_len(s);
    let mut end: Int = n;
    let mut i: Int = n;
    while i > 0 {
        let prev_i: Int = i - 1;
        let c: String = char_at(s, prev_i);
        if c == " " || c == "\t" {
            end = prev_i;
            i = prev_i;
        } else {
            i = 0;
        }
    }
    if end == n { return s; }
    return str_slice(s, 0, end);
}

pub fn minify_is_blank(s: String) -> Bool {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c != " " && c != "\t" { return false; }
        i = i + 1;
    }
    return true;
}

pub fn minify_strip_line_comment(s: String) -> String {
    let n: Int = chars_len(s);
    let mut in_string: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\"" {
            in_string = !in_string;
        } else if !in_string {
            if c == "/" && i + 1 < n {
                let nxt: String = char_at(s, i + 1);
                if nxt == "/" {
                    return minify_trim_right(str_slice(s, 0, i));
                }
            }
        }
        i = i + 1;
    }
    return minify_trim_right(s);
}

pub fn minify_compact_spaces(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut in_string: Bool = false;
    let mut i: Int = 0;
    let mut last_was_space: Bool = false;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\"" {
            in_string = !in_string;
            out = out + c;
            last_was_space = false;
        } else if in_string {
            out = out + c;
            last_was_space = false;
        } else if c == " " || c == "\t" {
            if !last_was_space {
                out = out + " ";
                last_was_space = true;
            }
        } else {
            out = out + c;
            last_was_space = false;
        }
        i = i + 1;
    }
    return out;
}

pub fn minify_estimate_tokens(s: String) -> Int {
    let n: Int = chars_len(s);
    if n <= 0 { return 0; }
    return (n / 4) + 1;
}

pub fn minify_split_lines(s: String) -> List[String] {
    let out: List[String] = list_new();
    let n: Int = chars_len(s);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(s, i) == "\n" {
            out = list_push(out, str_slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if start < n {
        out = list_push(out, str_slice(s, start, n));
    } else if n == 0 || char_at(s, n - 1) == "\n" {
        out = list_push(out, "");
    }
    return out;
}

pub fn minify_join_lines(lines: List[String]) -> String {
    let n: Int = list_len(lines);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        if i > 0 { out = out + "\n"; }
        out = out + list_get(lines, i);
        i = i + 1;
    }
    return out;
}

pub fn ast_minify_source(source: String, opts: MinifyOptions) -> MinifyResult {
    let orig_chars: Int = chars_len(source);
    let orig_tok: Int = minify_estimate_tokens(source);
    let lines: List[String] = minify_split_lines(source);
    let ln: Int = list_len(lines);
    let mut out_lines: List[String] = list_new();
    let mut i: Int = 0;
    while i < ln {
        let mut line: String = list_get(lines, i);
        let blank: Bool = minify_is_blank(line);
        if blank {
            if opts.strip_blank_lines {
                i = i + 1;
            } else {
                out_lines = list_push(out_lines, line);
                i = i + 1;
            }
        } else {
            if opts.strip_comments {
                line = minify_strip_line_comment(line);
            }
            if minify_is_blank(line) {
                if opts.strip_blank_lines {
                    i = i + 1;
                } else {
                    out_lines = list_push(out_lines, line);
                    i = i + 1;
                }
            } else {
                if opts.compact_spaces {
                    line = minify_compact_spaces(line);
                }
                if chars_len(line) > 0 {
                    out_lines = list_push(out_lines, line);
                }
                i = i + 1;
            }
        }
    }
    let out_text: String = minify_join_lines(out_lines);
    let min_chars: Int = chars_len(out_text);
    let min_tok: Int = minify_estimate_tokens(out_text);
    let mut saved: Int = 0;
    if orig_tok > min_tok { saved = orig_tok - min_tok; }
    let mut pct: Int = 0;
    if orig_tok > 0 {
        pct = (saved * 10000) / orig_tok;
    }
    return MinifyResult {
        original_chars: orig_chars,
        minified_chars: min_chars,
        original_estimated_tokens: orig_tok,
        minified_estimated_tokens: min_tok,
        tokens_saved: saved,
        reduction_pct_x100: pct,
        output_text: out_text
    };
}

pub fn minify_format_json(r: MinifyResult) -> String {
    let mut out: String = "{";
    out = out + "\"original_chars\":" + (r).original_chars.to_string();
    out = out + ",\"minified_chars\":" + (r).minified_chars.to_string();
    out = out + ",\"original_estimated_tokens\":" + (r).original_estimated_tokens.to_string();
    out = out + ",\"minified_estimated_tokens\":" + (r).minified_estimated_tokens.to_string();
    out = out + ",\"tokens_saved\":" + (r).tokens_saved.to_string();
    out = out + ",\"reduction_pct_x100\":" + (r).reduction_pct_x100.to_string();
    out = out + "}";
    return out;
}
