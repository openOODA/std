// # Tool Footprint Heatmap with Bar Rendering
//
// Logline: Render per-tool payload sizes as aligned ASCII bars, sorted by total bytes desc.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) W9 per-tool heatmap.
//
// Beats:
//   1. Store names, call counts, and byte totals in parallel lists (not List[HeatmapEntry]).
//   2. Sort rows by total payload bytes desc.
//   3. Render an aligned bar with a width-normalized fill.

type HeatmapEntry = struct {
    tool_name: String,
    call_count: Int,
    total_payload_bytes: Int
};

type Heatmap = struct {
    names: List[String],
    calls: List[Int],
    bytes: List[Int],
    bar_width: Int,
    max_payload: Int
};

pub fn heatmap_entry_new(
    name: String,
    call_cnt: Int,
    byte_cnt: Int
) -> HeatmapEntry {
    return HeatmapEntry {
        tool_name: name,
        call_count: call_cnt,
        total_payload_bytes: byte_cnt
    };
}

pub fn heatmap_new(width: Int) -> Heatmap {
    let ns: List[String] = list_new();
    let cs: List[Int] = list_new();
    let bs: List[Int] = list_new();
    return Heatmap {
        names: ns,
        calls: cs,
        bytes: bs,
        bar_width: width,
        max_payload: 0
    };
}

pub fn heatmap_ingest(h: Heatmap, e: HeatmapEntry) -> Heatmap {
    return Heatmap {
        names: list_push(h.names, e.tool_name),
        calls: list_push(h.calls, e.call_count),
        bytes: list_push(h.bytes, e.total_payload_bytes),
        bar_width: h.bar_width,
        max_payload: h.max_payload
    };
}

fn heatmap_swap_s(arr: List[String], i: Int, j: Int) -> List[String] {
    let n: Int = list_len(arr);
    let mut res_strs: List[String] = list_new();
    let mut k: Int = 0;
    while k < n {
        let item_s: String = list_get(arr, k);
        if k == i {
            res_strs = list_push(res_strs, list_get(arr, j));
        } else if k == j {
            res_strs = list_push(res_strs, list_get(arr, i));
        } else {
            res_strs = list_push(res_strs, item_s);
        }
        k = k + 1;
    }
    return res_strs;
}

fn heatmap_swap_i(arr: List[Int], i: Int, j: Int) -> List[Int] {
    let n: Int = list_len(arr);
    let mut res_ints: List[Int] = list_new();
    let mut k: Int = 0;
    while k < n {
        let item_i: Int = list_get(arr, k);
        if k == i {
            res_ints = list_push(res_ints, list_get(arr, j));
        } else if k == j {
            res_ints = list_push(res_ints, list_get(arr, i));
        } else {
            res_ints = list_push(res_ints, item_i);
        }
        k = k + 1;
    }
    return res_ints;
}

pub fn heatmap_sort_desc(h: Heatmap) -> Heatmap {
    let n: Int = list_len(h.bytes);
    let mut cur_names: List[String] = h.names;
    let mut cur_calls: List[Int] = h.calls;
    let mut cur_bytes: List[Int] = h.bytes;
    let mut i: Int = 0;
    while i < n {
        let mut j: Int = i + 1;
        while j < n {
            let val_a: Int = list_get(cur_bytes, i);
            let val_b: Int = list_get(cur_bytes, j);
            if val_a < val_b {
                cur_names = heatmap_swap_s(cur_names, i, j);
                cur_calls = heatmap_swap_i(cur_calls, i, j);
                cur_bytes = heatmap_swap_i(cur_bytes, i, j);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return Heatmap {
        names: cur_names,
        calls: cur_calls,
        bytes: cur_bytes,
        bar_width: h.bar_width,
        max_payload: h.max_payload
    };
}

pub fn heatmap_finalize(h_in: Heatmap) -> Heatmap {
    let n: Int = list_len(h_in.bytes);
    let mut max: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(h_in.bytes, i);
        if b > max {
            max = b;
        }
        i = i + 1;
    }
    return Heatmap {
        names: h_in.names,
        calls: h_in.calls,
        bytes: h_in.bytes,
        bar_width: h_in.bar_width,
        max_payload: max
    };
}

pub fn heatmap_render(h: Heatmap) -> String {
    let mut buf: String = "";
    buf = buf + "tool                  calls   bytes   bar\n";
    buf = buf + "-------------------- ------ ------- --------------------\n";
    let max_pay: Int = h.max_payload;
    let b_width: Int = h.bar_width;
    let n: Int = list_len(h.names);
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(h.names, i);
        let calls: Int = list_get(h.calls, i);
        let nbytes: Int = list_get(h.bytes, i);
        let mut filled: Int = 0;
        if max_pay > 0 {
            filled = (nbytes * b_width) / max_pay;
        }
        if filled > b_width {
            filled = b_width;
        }
        let mut bar: String = "[";
        let mut kk: Int = 0;
        while kk < filled {
            bar = bar + "#";
            kk = kk + 1;
        }
        while kk < b_width {
            bar = bar + "-";
            kk = kk + 1;
        }
        bar = bar + "]";
        buf = buf + name;
        let mut pad: Int = 20 - name.len();
        while pad > 0 {
            buf = buf + " ";
            pad = pad - 1;
        }
        buf = buf + " " + calls.to_string();
        buf = buf + " " + nbytes.to_string();
        buf = buf + " " + bar + "\n";
        i = i + 1;
    }
    return buf;
}
