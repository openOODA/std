// # Per-Slice Token Breakdown Mapped to std/ Categories
//
// Logline: Attribute token usage to the std slice directories (ai_ml, collections, token_opt, etc.) by file path prefix.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) W3 per-slice breakdown.
//
// Beats:
//   1. Define SliceBucket and SliceBreakdown structures.
//   2. Scan a directory and attribute bytes per slice.
//   3. Compute total tokens per slice and rank by usage.
//   4. Emit a deterministic breakdown string.

type SliceBucket = struct {
    slice_id: String,
    file_count: Int,
    total_bytes: Int,
    total_tokens: Int
};

type SliceBreakdown = struct {
    slices: List[SliceBucket],
    files_total: Int,
    slices_total: Int
};

pub fn slice_bucket_new(sid: String) -> SliceBucket {
    return SliceBucket {
        slice_id: sid,
        file_count: 0,
        total_bytes: 0,
        total_tokens: 0
    };
}

pub fn slice_breakdown_new() -> SliceBreakdown {
    let empty: List[SliceBucket] = list_new();
    return SliceBreakdown {
        slices: empty,
        files_total: 0,
        slices_total: 0
    };
}

pub fn slice_extract_id(path: String) -> String {
    let needle: String = "std/";
    let n: Int = chars_len(path);
    let klen: Int = chars_len(needle);
    let mut i: Int = 0;
    while i + klen <= n {
        if str_slice(path, i, i + klen) == needle {
            let mut j: Int = i + klen;
            let mut buf: String = "";
            while j < n {
                let c: String = char_at(path, j);
                if c == "/" {
                    return buf;
                }
                if c == "." {
                    return buf;
                }
                buf = buf + c;
                j = j + 1;
            }
            return buf;
        }
        i = i + 1;
    }
    return "other";
}

pub fn slice_breakdown_ingest(
    b_in: SliceBreakdown,
    path: String,
    bytes: Int
) -> SliceBreakdown {
    let sid: String = slice_extract_id(path);
    let mut found: Int = -1;
    let n: Int = list_len(b_in.slices);
    let mut i: Int = 0;
    while i < n {
        let sb: SliceBucket = list_get(b_in.slices, i);
        if sb.slice_id == sid {
            found = i;
            i = n;
        }
        i = i + 1;
    }
    let mut new_list: List[SliceBucket] = list_new();
    let mut k: Int = 0;
    while k < n {
        let sb: SliceBucket = list_get(b_in.slices, k);
        if k == found {
            let old_count: Int = sb.file_count;
            let old_bytes: Int = sb.total_bytes;
            let old_tokens: Int = sb.total_tokens;
            let new_count: Int = old_count + 1;
            let new_bytes: Int = old_bytes + bytes;
            let mut half: Int = bytes / 4;
            let new_tokens: Int = old_tokens + half + 1;
            let nb: SliceBucket = SliceBucket {
                slice_id: sb.slice_id,
                file_count: new_count,
                total_bytes: new_bytes,
                total_tokens: new_tokens
            };
            new_list = list_push(new_list, nb);
        } else {
            new_list = list_push(new_list, sb);
        }
        k = k + 1;
    }
    if found == -1 {
        let nb: SliceBucket = SliceBucket {
            slice_id: sid,
            file_count: 1,
            total_bytes: bytes,
            total_tokens: (bytes / 4) + 1
        };
        new_list = list_push(new_list, nb);
    }
    let b: SliceBreakdown = SliceBreakdown {
        slices: new_list,
        files_total: b_in.files_total + 1,
        slices_total: b_in.slices_total
    };
    return b;
}

pub fn slice_breakdown_finalize(b_in: SliceBreakdown) -> SliceBreakdown {
    let b: SliceBreakdown = SliceBreakdown {
        slices: b_in.slices,
        files_total: b_in.files_total,
        slices_total: list_len(b_in.slices)
    };
    return b;
}

pub fn slice_breakdown_top_n(b: SliceBreakdown, n: Int) -> String {
    let mut out: String = "";
    let total: Int = list_len(b.slices);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < total {
        if count >= n {
            i = total;
        } else {
            let sb: SliceBucket = list_get(b.slices, i);
            out = out + sb.slice_id + ":" + (sb).total_tokens.to_string() + " ";
            count = count + 1;
        }
        i = i + 1;
    }
    return out;
}
