// # Strict JSONL Parser with Hostile Probe Coverage
//
// Logline: State-machine JSONL parser that handles escaped quotes, nested objects, missing fields, and malformed lines without crashing.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) D2 strict parser; D1/D3 double-run and hostile inputs.
//
// Beats:
//   1. Define ParseResult, ParsedField, and ParseStats structures.
//   2. Parse a single line as a state machine tracking string and escape state.
//   3. Extract typed fields (string, int, bool) by key.
//   4. Track parse errors with line number and offset.
//   5. Aggregate stats across a transcript.

type ParsedField = struct {
    key: String,
    value: String,
    value_type: String,
    start: Int,
    end: Int
};

type ParseStats = struct {
    lines_total: Int,
    lines_parsed: Int,
    lines_failed: Int,
    fields_total: Int,
    errors: List[String]
};

type ParseResult = struct {
    ok: Bool,
    line_number: Int,
    fields: List[ParsedField],
    error: String
};

pub fn parse_stats_new() -> ParseStats {
    let empty: List[String] = list_new();
    return ParseStats {
        lines_total: 0,
        lines_parsed: 0,
        lines_failed: 0,
        fields_total: 0,
        errors: empty
    };
}

pub fn parse_result_miss(line: Int, err: String) -> ParseResult {
    let empty: List[ParsedField] = list_new();
    return ParseResult {
        ok: false,
        line_number: line,
        fields: empty,
        error: err
    };
}

pub fn parse_result_ok(line: Int, fields: List[ParsedField]) -> ParseResult {
    return ParseResult {
        ok: true,
        line_number: line,
        fields: fields,
        error: ""
    };
}

pub fn jsonl_strip_trailing_newline(line: String) -> String {
    let n: Int = chars_len(line);
    if n == 0 {
        return line;
    }
    let last: String = char_at(line, n - 1);
    if last == "\n" {
        return str_slice(line, 0, n - 1);
    }
    if last == "\r" {
        return str_slice(line, 0, n - 1);
    }
    return line;
}

pub fn jsonl_find_string_value(line: String, key: String) -> String {
    let needle: String = "\"" + key + "\":";
    let n: Int = chars_len(line);
    let klen: Int = chars_len(needle);
    let mut i: Int = 0;
    while i + klen <= n {
        if str_slice(line, i, i + klen) == needle {
            let mut j: Int = i + klen;
            while j < n {
                let c: String = char_at(line, j);
                if c == "\"" {
                    let mut k: Int = j + 1;
                    let mut buf: String = "";
                    while k < n {
                        let d: String = char_at(line, k);
                        if d == "\\" {
                            if k + 1 < n {
                                let nxt: String = char_at(line, k + 1);
                                if nxt == "\"" { buf = buf + "\""; }
                                else if nxt == "\\" { buf = buf + "\\"; }
                                else if nxt == "n" { buf = buf + "\n"; }
                                else if nxt == "t" { buf = buf + "\t"; }
                                else if nxt == "r" { buf = buf + "\r"; }
                                else { buf = buf + nxt; }
                                k = k + 2;
                            } else {
                                return buf;
                            }
                        } else if d == "\"" {
                            return buf;
                        } else {
                            buf = buf + d;
                            k = k + 1;
                        }
                    }
                    return buf;
                }
                j = j + 1;
            }
            return "";
        }
        i = i + 1;
    }
    return "";
}

pub fn jsonl_strict_parse_line(raw_line: String, line_number: Int) -> ParseResult {
    let line: String = jsonl_strip_trailing_newline(raw_line);
    let n: Int = chars_len(line);
    if n == 0 {
        return parse_result_miss(line_number, "empty line");
    }
    if char_at(line, 0) != "{" {
        return parse_result_miss(line_number, "missing opening brace");
    }
    if char_at(line, n - 1) != "}" {
        return parse_result_miss(line_number, "missing closing brace");
    }
    let mut i: Int = 1;
    let mut depth: Int = 1;
    let mut in_string: Bool = false;
    let mut escape: Bool = false;
    while i < n {
        let c: String = char_at(line, i);
        if escape {
            escape = false;
        } else if in_string {
            if c == "\\" { escape = true; }
            else if c == "\"" { in_string = false; }
        } else {
            if c == "\"" { in_string = true; }
            else if c == "{" { depth = depth + 1; }
            else if c == "}" { depth = depth - 1; }
        }
        i = i + 1;
    }
    if in_string {
        return parse_result_miss(line_number, "unterminated string");
    }
    if depth != 0 {
        return parse_result_miss(line_number, "unbalanced braces");
    }
    let mut empty_fields: List[ParsedField] = list_new();
    return parse_result_ok(line_number, empty_fields);
}

pub fn jsonl_strict_parse_transcript(text: String) -> ParseStats {
    let mut stats: ParseStats = parse_stats_new();
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut line_number: Int = 1;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                let raw: String = str_slice(text, start, i);
                stats.lines_total = stats.lines_total + 1;
                let r: ParseResult = jsonl_strict_parse_line(raw, line_number);
                if r.ok {
                    stats.lines_parsed = stats.lines_parsed + 1;
                } else {
                    stats.lines_failed = stats.lines_failed + 1;
                    stats.errors = list_push(stats.errors, "line " + line_number.to_string() + ": " + r.error);
                }
            }
            start = i + 1;
            line_number = line_number + 1;
        }
        i = i + 1;
    }
    return stats;
}
