// # Statistical Distribution for Token Telemetry Multipliers
//
// Logline: Compute mean, p50, p99, min, max, and a confidence band over N efficiency trials to replace single-point estimates.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) D8 statistical distribution.
//
// Beats:
//   1. Define TrialSample and DistributionStats structures.
//   2. Build a sample set of efficiency multipliers across N synthetic runs.
//   3. Sort the sample and compute percentiles.
//   4. Emit a DistributionStats record with mean, p50, p99, min, max, and stddev estimate.

type TrialSample = struct {
    efficiency_x1000: Int,
    tokens_saved: Int
};

type DistributionStats = struct {
    sample_count: Int,
    mean_x1000: Int,
    p50_x1000: Int,
    p99_x1000: Int,
    min_x1000: Int,
    max_x1000: Int,
    confidence_low_x1000: Int,
    confidence_high_x1000: Int,
    total_tokens_saved: Int
};

pub fn trial_sample_new(eff: Int, saved: Int) -> TrialSample {
    return TrialSample {
        efficiency_x1000: eff,
        tokens_saved: saved
    };
}

pub fn distribution_stats_new() -> DistributionStats {
    return DistributionStats {
        sample_count: 0,
        mean_x1000: 0,
        p50_x1000: 0,
        p99_x1000: 0,
        min_x1000: 0,
        max_x1000: 0,
        confidence_low_x1000: 0,
        confidence_high_x1000: 0,
        total_tokens_saved: 0
    };
}

pub fn distribution_sort_swap(
    arr: List[TrialSample],
    i: Int,
    j: Int
) -> List[TrialSample] {
    let mut out: List[TrialSample] = list_new();
    let n: Int = list_len(arr);
    let mut k: Int = 0;
    while k < n {
        let a: TrialSample = list_get(arr, k);
        if k == i {
            let b: TrialSample = list_get(arr, j);
            out = list_push(out, b);
        } else if k == j {
            let b: TrialSample = list_get(arr, i);
            out = list_push(out, b);
        } else {
            out = list_push(out, a);
        }
        k = k + 1;
    }
    return out;
}

pub fn distribution_sort(arr: List[TrialSample]) -> List[TrialSample] {
    let mut out: List[TrialSample] = list_new();
    let n: Int = list_len(arr);
    let mut k: Int = 0;
    while k < n {
        let a: TrialSample = list_get(arr, k);
        out = list_push(out, a);
        k = k + 1;
    }
    let mut i: Int = 0;
    while i < n {
        let mut j: Int = i + 1;
        while j < n {
            let a: TrialSample = list_get(out, i);
            let b: TrialSample = list_get(out, j);
            if a.efficiency_x1000 > b.efficiency_x1000 {
                out = distribution_sort_swap(out, i, j);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

pub fn distribution_percentile(
    sorted: List[TrialSample],
    pct: Int
) -> Int {
    let n: Int = list_len(sorted);
    if n == 0 {
        return 0;
    }
    let mut idx: Int = (n * pct) / 100;
    if idx >= n {
        idx = n - 1;
    }
    let s: TrialSample = list_get(sorted, idx);
    return s.efficiency_x1000;
}

pub fn distribution_compute(samples: List[TrialSample]) -> DistributionStats {
    let mut stats: DistributionStats = distribution_stats_new();
    let n: Int = list_len(samples);
    if n == 0 {
        return stats;
    }
    let sorted: List[TrialSample] = distribution_sort(samples);
    let mut sum: Int = 0;
    let mut min_v: Int = 2147483647;
    let mut max_v: Int = 0;
    let mut total_saved: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let s: TrialSample = list_get(sorted, i);
        sum = sum + s.efficiency_x1000;
        if s.efficiency_x1000 < min_v { min_v = s.efficiency_x1000; }
        if s.efficiency_x1000 > max_v { max_v = s.efficiency_x1000; }
        total_saved = total_saved + s.tokens_saved;
        i = i + 1;
    }
    stats.sample_count = n;
    stats.mean_x1000 = sum / n;
    stats.p50_x1000 = distribution_percentile(sorted, 50);
    stats.p99_x1000 = distribution_percentile(sorted, 99);
    stats.min_x1000 = min_v;
    stats.max_x1000 = max_v;
    stats.total_tokens_saved = total_saved;
    let band: Int = (max_v - min_v) / 10;
    stats.confidence_low_x1000 = stats.mean_x1000 - band;
    stats.confidence_high_x1000 = stats.mean_x1000 + band;
    return stats;
}

pub fn distribution_synthetic_run(seed: Int) -> TrialSample {
    let mut eff: Int = 18500;
    let mut k: Int = 0;
    while k < (seed % 7) {
        eff = eff - 250;
        k = k + 1;
    }
    let saved: Int = 1500000 + (seed * 1000);
    return trial_sample_new(eff, saved);
}
