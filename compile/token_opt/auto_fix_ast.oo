// # AST-Aware Token-Saving Auto-Fix Rewriter
//
// Logline: Read a source file, identify a token-waste pattern, and emit a minimal-diff rewrite that preserves semantics.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) W6 AST-aware rewriter.
//
// Beats:
//   1. Define RewritePlan and RewriteResult structures.
//   2. Collapse consecutive banner lines into a single header.
//   3. Replace monolithic read_file calls with outline/reflect directives.
//   4. Compute a token-diff between original and rewritten text.

type RewritePlan = struct {
    original: String,
    rewritten: String,
    original_chars: Int,
    rewritten_chars: Int,
    patterns_applied: Int
};

type RewriteResult = struct {
    file_path: String,
    ok: Bool,
    plans: List[RewritePlan],
    tokens_saved_total: Int
};

pub fn rewrite_plan_new(orig: String, rew: String, applied: Int) -> RewritePlan {
    return RewritePlan {
        original: orig,
        rewritten: rew,
        original_chars: orig.len(),
        rewritten_chars: rew.len(),
        patterns_applied: applied
    };
}

pub fn rewrite_result_new(path: String) -> RewriteResult {
    let empty: List[RewritePlan] = list_new();
    return RewriteResult {
        file_path: path,
        ok: true,
        plans: empty,
        tokens_saved_total: 0
    };
}

pub fn is_banner_line(line: String) -> Bool {
    if str_ends_with(line, "##########") { return true; }
    if str_ends_with(line, "==========") { return true; }
    if str_ends_with(line, "----------") { return true; }
    return false;
}

pub fn collapse_banners(text: String) -> RewritePlan {
    let orig_len: Int = text.len();
    let n: Int = chars_len(text);
    let mut out: String = "";
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut in_banner: Bool = false;
    let mut banner_count: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                let line: String = str_slice(text, start, i);
                if is_banner_line(line) {
                    if !in_banner {
                        out = out + "# --- token_opt header ---";
                        in_banner = true;
                    }
                    banner_count = banner_count + 1;
                } else {
                    in_banner = false;
                    out = out + line;
                }
                if i < n {
                    out = out + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    let applied: Int = 1;
    if banner_count < 2 {
        return rewrite_plan_new(text, text, 0);
    }
    return rewrite_plan_new(text, out, applied);
}

pub fn rewrite_apply_to_file(path: String, text: String) -> RewriteResult {
    let mut r: RewriteResult = rewrite_result_new(path);
    let p1: RewritePlan = collapse_banners(text);
    if p1.patterns_applied > 0 {
        let new_list: List[RewritePlan] = list_push(r.plans, p1);
        r.plans = new_list;
    }
    let total_orig: Int = text.len();
    let mut total_rew: Int = 0;
    let n: Int = list_len(r.plans);
    let mut i: Int = 0;
    while i < n {
        let p: RewritePlan = list_get(r.plans, i);
        total_rew = total_rew + p.rewritten_chars;
        i = i + 1;
    }
    if total_rew == 0 {
        total_rew = total_orig;
    }
    let saved: Int = total_orig - total_rew;
    if saved < 0 {
        r.tokens_saved_total = 0;
    } else {
        r.tokens_saved_total = saved;
    }
    return r;
}

pub fn rewrite_format_report(r: RewriteResult) -> String {
    let mut out: String = "file:                " + r.file_path + "\n";
    out = out + "plans_applied:       " + list_len(r.plans).to_string() + "\n";
    out = out + "tokens_saved:        " + (r).tokens_saved_total.to_string() + "\n";
    return out;
}
