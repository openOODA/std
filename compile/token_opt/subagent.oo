// # Subagent Token Attribution (Planner / Coder / Reviewer)
//
// Logline: Tag each tool footprint with a subagent role and roll up per-role totals for fan-out cost views.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) W4 subagent attribution.
//
// Beats:
//   1. Define SubagentRole and SubagentRollup structures.
//   2. Attribute a step to a subagent role.
//   3. Aggregate prompt, completion, and tool bytes per role.
//   4. Emit a deterministic per-role rollup.

type SubagentRole = struct {
    role: String,
    prompt_tokens: Int,
    completion_tokens: Int,
    tool_bytes: Int,
    step_count: Int
};

type SubagentRollup = struct {
    roles: List[SubagentRole],
    steps_total: Int
};

pub fn subagent_role_new(role: String) -> SubagentRole {
    return SubagentRole {
        role: role,
        prompt_tokens: 0,
        completion_tokens: 0,
        tool_bytes: 0,
        step_count: 0
    };
}

pub fn subagent_rollup_new() -> SubagentRollup {
    let empty: List[SubagentRole] = list_new();
    return SubagentRollup {
        roles: empty,
        steps_total: 0
    };
}

pub fn subagent_guess_role(stype: String) -> String {
    if stype == "USER_INPUT" {
        return "user";
    }
    if stype == "PLANNER_RESPONSE" {
        return "planner";
    }
    if stype == "TOOL_CALL" {
        return "coder";
    }
    if stype == "REVIEWER_RESPONSE" {
        return "reviewer";
    }
    return "other";
}

pub fn subagent_rollup_ingest(
    r_in: SubagentRollup,
    stype: String,
    prompt_b: Int,
    completion_b: Int,
    tool_b: Int
) -> SubagentRollup {
    let role: String = subagent_guess_role(stype);
    let n: Int = list_len(r_in.roles);
    let mut found: Int = -1;
    let mut i: Int = 0;
    while i < n {
        let rr: SubagentRole = list_get(r_in.roles, i);
        if rr.role == role {
            found = i;
            i = n;
        }
        i = i + 1;
    }
    let mut new_list: List[SubagentRole] = list_new();
    let mut k: Int = 0;
    while k < n {
        let rr: SubagentRole = list_get(r_in.roles, k);
        if k == found {
            let old_p: Int = rr.prompt_tokens;
            let old_c: Int = rr.completion_tokens;
            let old_t: Int = rr.tool_bytes;
            let old_s: Int = rr.step_count;
            let p_increment: Int = (prompt_b / 4) + 1;
            let c_increment: Int = (completion_b / 4) + 1;
            let new_p: Int = old_p + p_increment;
            let new_c: Int = old_c + c_increment;
            let new_t: Int = old_t + tool_b;
            let new_s: Int = old_s + 1;
            let nb: SubagentRole = SubagentRole {
                role: rr.role,
                prompt_tokens: new_p,
                completion_tokens: new_c,
                tool_bytes: new_t,
                step_count: new_s
            };
            new_list = list_push(new_list, nb);
        } else {
            new_list = list_push(new_list, rr);
        }
        k = k + 1;
    }
    if found == -1 {
        let nb: SubagentRole = SubagentRole {
            role: role,
            prompt_tokens: (prompt_b / 4) + 1,
            completion_tokens: (completion_b / 4) + 1,
            tool_bytes: tool_b,
            step_count: 1
        };
        new_list = list_push(new_list, nb);
    }
    let r: SubagentRollup = SubagentRollup {
        roles: new_list,
        steps_total: r_in.steps_total + 1
    };
    return r;
}

pub fn subagent_rollup_total_tokens(r: SubagentRollup) -> Int {
    let n: Int = list_len(r.roles);
    let mut sum: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let rr: SubagentRole = list_get(r.roles, i);
        sum = sum + rr.prompt_tokens + rr.completion_tokens;
        i = i + 1;
    }
    return sum;
}
