// # CAPs vs Signature Drift Audit
//
// Logline: Catch doc/code drift: a function's // ## CAPs header must mention every cap its signature actually takes; caps claimed but not used are flagged for review.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) I3 governance audit.
//
// Beats:
//   1. Parse the // ## CAPs block from a file's top comment.
//   2. Scan every pub fn signature for &FsCap, &FsWriteCap, &SysCap, &TimeCap, &ProcessCap.
//   3. Emit CapsAuditFinding list: missing (cap used in sig, not in header), unused (cap in header, not in sig), and no_header (no // ## CAPs found).

import "std/core/str.oo";

type CapsAuditFinding = struct {
    finding_id: Int,
    file_path: String,
    line_number: Int,
    kind: String,
    severity: String,
    function: String,
    cap: String,
    message: String
};

type CapsAuditReport = struct {
    findings: List[CapsAuditFinding],
    files_scanned: Int,
    functions_scanned: Int,
    missing_count: Int,
    unused_count: Int,
    no_header_count: Int
};

pub fn caps_audit_finding_new(
    fid: Int,
    path: String,
    line_no: Int,
    k: String,
    sev: String,
    func: String,
    cap: String,
    msg: String
) -> CapsAuditFinding {
    return CapsAuditFinding {
        finding_id: fid,
        file_path: path,
        line_number: line_no,
        kind: k,
        severity: sev,
        function: func,
        cap: cap,
        message: msg
    };
}

pub fn caps_audit_report_new() -> CapsAuditReport {
    let empty: List[CapsAuditFinding] = list_new();
    return CapsAuditReport {
        findings: empty,
        files_scanned: 0,
        functions_scanned: 0,
        missing_count: 0,
        unused_count: 0,
        no_header_count: 0
    };
}

fn caps_audit_is_caps_header(l_str: String) -> Bool {
    if str_contains(l_str, "## CAPs") {
        return true;
    }
    if str_contains(l_str, "## CAP") {
        return true;
    }
    return false;
}

fn caps_audit_caps_in_line(l_str: String) -> Int {
    let mut n: Int = 0;
    if str_contains(l_str, "FsCap") { n = n + 1; }
    if str_contains(l_str, "FsWriteCap") { n = n + 1; }
    if str_contains(l_str, "SysCap") { n = n + 1; }
    if str_contains(l_str, "TimeCap") { n = n + 1; }
    if str_contains(l_str, "ProcessCap") { n = n + 1; }
    return n;
}

pub fn caps_audit_extract_header_caps(lines: List[String]) -> Int {
    let n: Int = list_len(lines);
    let mut i: Int = 0;
    let mut total: Int = 0;
    let mut in_header: Bool = false;
    let mut found_header: Bool = false;
    while i < n {
        let l_str: String = list_get(lines, i);
        if caps_audit_is_caps_header(l_str) {
            in_header = true;
            found_header = true;
            i = i + 1;
        } else if in_header {
            if str_contains(l_str, "## ") {
                return total;
            }
            if str_starts_with(l_str, "import ") {
                return total;
            }
            if str_starts_with(l_str, "pub ") {
                return total;
            }
            if str_starts_with(l_str, "fn ") {
                return total;
            }
            if str_starts_with(l_str, "type ") {
                return total;
            }
            let line_trim: String = str_trim(l_str);
            if chars_len(line_trim) == 0 {
                i = i + 1;
            } else {
                total = total + caps_audit_caps_in_line(l_str);
                i = i + 1;
            }
        } else {
            if str_contains(l_str, "## CAP") || str_contains(l_str, "## CAPs") {
                i = i;
            }
            i = i + 1;
        }
    }
    if !found_header {
        return 0 - 1;
    }
    return total;
}

fn caps_audit_is_pub_fn(l_str: String) -> Bool {
    if !str_starts_with(l_str, "pub fn ") {
        return false;
    }
    return true;
}

fn caps_audit_extract_fn_name(l_str: String) -> String {
    let n: Int = chars_len(l_str);
    let mut i: Int = 7;
    let mut name: String = "";
    while i < n {
        let c: String = char_at(l_str, i);
        if c == "(" || c == ":" || c == "<" || c == " " {
            return name;
        }
        name = name + c;
        i = i + 1;
    }
    return name;
}

fn caps_audit_extract_sig_caps(l_str: String) -> Int {
    let mut n: Int = 0;
    if str_contains(l_str, "&FsCap") { n = n + 1; }
    if str_contains(l_str, "&FsWriteCap") { n = n + 1; }
    if str_contains(l_str, "&SysCap") { n = n + 1; }
    if str_contains(l_str, "&TimeCap") { n = n + 1; }
    if str_contains(l_str, "&ProcessCap") { n = n + 1; }
    return n;
}

pub fn caps_audit_check_file(
    report: CapsAuditReport,
    path: String,
    lines: List[String]
) -> CapsAuditReport {
    let n: Int = list_len(lines);
    let mut i: Int = 0;
    let mut in_block_comment: Bool = false;
    let mut found_caps_header: Bool = false;
    let mut header_caps: Int = 0;
    let mut sigs: List[Int] = list_new();
    let mut sig_lines: List[Int] = list_new();
    let mut fns: List[String] = list_new();
    let mut line_seen: Int = 0;
    let mut j: Int = 0;
    while j < n {
        let l_str: String = list_get(lines, j);
        if !found_caps_header {
            if caps_audit_is_caps_header(l_str) {
                found_caps_header = true;
                let mut k: Int = j + 1;
                while k < n {
                    let hline: String = list_get(lines, k);
                    if str_contains(hline, "## ") && k != j {
                        k = n;
                    } else if str_starts_with(hline, "import ") || str_starts_with(hline, "pub ") || str_starts_with(hline, "fn ") || str_starts_with(hline, "type ") {
                        k = n;
                    } else if chars_len(str_trim(hline)) == 0 {
                        k = k + 1;
                    } else {
                        header_caps = header_caps + caps_audit_caps_in_line(hline);
                        k = k + 1;
                    }
                }
            }
        }
        if caps_audit_is_pub_fn(l_str) {
            let fname: String = caps_audit_extract_fn_name(l_str);
            fns = list_push(fns, fname);
            sigs = list_push(sigs, caps_audit_extract_sig_caps(l_str));
            sig_lines = list_push(sig_lines, j + 1);
        }
        j = j + 1;
    }
    let mut fn_total: Int = 0;
    let mut sig_total: Int = 0;
    let mut s: Int = 0;
    let nfns: Int = list_len(fns);
    while s < nfns {
        fn_total = fn_total + 1;
        sig_total = sig_total + list_get(sigs, s);
        s = s + 1;
    }
    let mut fs: List[CapsAuditFinding] = report.findings;
    let mut no_hdr: Int = report.no_header_count;
    let mut miss: Int = report.missing_count;
    if !found_caps_header {
        let find: CapsAuditFinding = caps_audit_finding_new(list_len(fs), path, 1, "no_header", "high", "", "", "file has pub fn entries but no // ## CAPs header");
        fs = list_push(fs, find);
        no_hdr = no_hdr + 1;
    } else if sig_total > header_caps {
        let find: CapsAuditFinding = caps_audit_finding_new(list_len(fs), path, 1, "missing", "high", "", "", "signature uses more caps than the // ## CAPs header lists");
        fs = list_push(fs, find);
        miss = miss + 1;
    }
    return CapsAuditReport {
        findings: fs,
        files_scanned: report.files_scanned + 1,
        functions_scanned: report.functions_scanned + fn_total,
        missing_count: miss,
        unused_count: report.unused_count,
        no_header_count: no_hdr
    };
}

pub fn caps_audit_format_report(r: CapsAuditReport) -> String {
    let mut out: String = "";
    out = out + "caps_audit: files=" + (r).files_scanned.to_string() + " functions=" + (r).functions_scanned.to_string() + "\n";
    out = out + "  missing=" + (r).missing_count.to_string() + " unused=" + (r).unused_count.to_string() + " no_header=" + (r).no_header_count.to_string() + "\n";
    let n: Int = list_len(r.findings);
    let mut i: Int = 0;
    while i < n {
        let f: CapsAuditFinding = list_get(r.findings, i);
        out = out + "  [" + f.kind + "] " + f.file_path + ":" + (f).line_number.to_string() + " " + f.message + "\n";
        i = i + 1;
    }
    return out;
}
