// # Optimizer dry-run planner
//
// Logline: Walk a directory and build a list of would-be sidecar paths plus the projected tokens-wasted, without writing anything to disk.
//
// Setup: Pure .oo. No FsWriteCap required.
//
// Beats:
//   1. Define DryRunPlan structure.
//   2. List the directory and find every .oo file.
//   3. Run the optimizer rules per file and aggregate.
//   4. Return a deterministic plan.

import "token_optimizer.oo";
import "auto_fix.oo";

type DryRunPlan = struct {
    dir: String,
    sidecars: List[String],
    sidecar_count: Int,
    projected_tokens_wasted: Int,
    would_write: Bool
};

pub fn dry_run_plan_new(dir: String) -> DryRunPlan {
    let empty: List[String] = list_new();
    return DryRunPlan {
        dir: dir,
        sidecars: empty,
        sidecar_count: 0,
        projected_tokens_wasted: 0,
        would_write: true
    };
}

pub fn optimizer_dry_run_plan(fs: &FsReadCap, dir: String) -> DryRunPlan {
    let mut plan: DryRunPlan = dry_run_plan_new(dir);
    let entries: List[String] = oo_fs_read_dir(fs, dir);
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(entries, i);
        if str_ends_with(name, ".oo") {
            let full: String = dir + "/" + name;
            let tr: Result[String, String] = read_file(fs, full);
            if tr.is_ok() {
                let text: String = match tr { Ok(s) => s, Err(m) => m };
                let mut lines: List[String] = list_new();
                let len: Int = chars_len(text);
                let mut start: Int = 0;
                let mut j: Int = 0;
                while j <= len {
                    if j == len {
                        if j > start {
                            lines = list_push(lines, str_slice(text, start, j));
                        }
                    } else {
                        let ch: String = char_at(text, j);
                        if ch == "\n" {
                            if j > start {
                                lines = list_push(lines, str_slice(text, start, j));
                            }
                            start = j + 1;
                        }
                    }
                    j = j + 1;
                }
                let mut report: OptimizationReport = optimization_report_new();
                report = optimization_check_verbose_headers(report, full, lines);
                report = optimization_check_monolithic_reads(report, full, lines, 256);
                report = optimization_check_redundant_diags(report, full, lines);
                report = optimization_finalize(report, 1);
                if report.suggestions_count > 0 {
                    let wasted: Int = report.total_tokens_wasted;
                    plan.sidecars = list_push(plan.sidecars, full + ".suggested.oo");
                    let current: Int = plan.projected_tokens_wasted;
                    let next: Int = current + wasted;
                    plan.projected_tokens_wasted = next;
                }
            }
        }
        i = i + 1;
    }
    plan.sidecar_count = list_len(plan.sidecars);
    return plan;
}
