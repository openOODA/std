// # Token Budget Enforcer for Session Admission Control
//
// Logline: Refuse to admit a session whose estimated prompt exceeds the configured cap; return a fail-closed decision.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) W10 budget enforcer.
//
// Beats:
//   1. Define BudgetCap and BudgetDecision structures.
//   2. Compute estimated tokens for an incoming session.
//   3. Compare against the cap and return admit or refuse.
//   4. Surface the headroom or shortfall for the LLM to act on.

type BudgetCap = struct {
    max_prompt_tokens: Int,
    max_total_tokens: Int,
    estimated_cost_micro: Int
};

type BudgetDecision = struct {
    admit: Bool,
    reason: String,
    estimated_prompt_tokens: Int,
    estimated_total_tokens: Int,
    headroom_tokens: Int,
    shortfall_tokens: Int
};

pub fn budget_cap_new(
    max_p: Int,
    max_t: Int,
    cost: Int
) -> BudgetCap {
    return BudgetCap {
        max_prompt_tokens: max_p,
        max_total_tokens: max_t,
        estimated_cost_micro: cost
    };
}

pub fn budget_decision_new(
    admit: Bool,
    reason: String,
    ep: Int,
    et: Int,
    h: Int,
    s: Int
) -> BudgetDecision {
    return BudgetDecision {
        admit: admit,
        reason: reason,
        estimated_prompt_tokens: ep,
        estimated_total_tokens: et,
        headroom_tokens: h,
        shortfall_tokens: s
    };
}

pub fn budget_check(
    cap: BudgetCap,
    est_prompt_tokens: Int,
    est_completion_tokens: Int
) -> BudgetDecision {
    let total: Int = est_prompt_tokens + est_completion_tokens;
    let max_p: Int = cap.max_prompt_tokens;
    let max_t: Int = cap.max_total_tokens;
    let mut admit: Bool = true;
    let mut reason: String = "within budget";
    let mut headroom: Int = 0;
    let mut shortfall: Int = 0;
    if est_prompt_tokens > max_p {
        admit = false;
        reason = "prompt exceeds cap";
        shortfall = est_prompt_tokens - max_p;
    } else if total > max_t {
        admit = false;
        reason = "total exceeds cap";
        shortfall = total - max_t;
    } else {
        headroom = max_t - total;
    }
    return budget_decision_new(admit, reason, est_prompt_tokens, total, headroom, shortfall);
}

pub fn budget_decision_to_json(d: BudgetDecision) -> String {
    let mut out: String = "{";
    out = out + "\"admit\":";
    if d.admit { out = out + "true"; } else { out = out + "false"; }
    out = out + ",\"reason\":\"" + d.reason + "\"";
    out = out + ",\"estimated_prompt_tokens\":" + (d).estimated_prompt_tokens.to_string();
    out = out + ",\"estimated_total_tokens\":" + (d).estimated_total_tokens.to_string();
    out = out + ",\"headroom_tokens\":" + (d).headroom_tokens.to_string();
    out = out + ",\"shortfall_tokens\":" + (d).shortfall_tokens.to_string();
    out = out + "}";
    return out;
}
