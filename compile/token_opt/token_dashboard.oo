// # Interactive ASCII Token Dashboard Renderer
//
// Logline: Format tabular token usage, thinking efficiency, and subagent resource consumption as an ASCII dashboard.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) sovereign visualization.
//
// Beats:
//   1. Define DashboardRow and DashboardSpec structures.
//   2. Render header, separator, and aligned row lines.
//   3. Format thinking overhead ratio as a percent bar.
//   4. Compose full dashboard text with per-step and per-tool rows.

type DashboardRow = struct {
    label: String,
    prompt_tokens: Int,
    completion_tokens: Int,
    tool_bytes: Int,
    thinking_ms: Int
};

type DashboardSpec = struct {
    title: String,
    session_id: String,
    rows: List[DashboardRow],
    total_prompt_tokens: Int,
    total_completion_tokens: Int,
    total_tool_bytes: Int,
    total_thinking_ms: Int,
    efficiency_multiplier_x1000: Int
};

pub fn dashboard_row_new(
    label: String,
    p: Int,
    c: Int,
    tb: Int,
    tm: Int
) -> DashboardRow {
    return DashboardRow {
        label: label,
        prompt_tokens: p,
        completion_tokens: c,
        tool_bytes: tb,
        thinking_ms: tm
    };
}

pub fn dashboard_spec_new(
    title: String,
    sid: String,
    rows: List[DashboardRow]
) -> DashboardSpec {
    let mut sum_p: Int = 0;
    let mut sum_c: Int = 0;
    let mut sum_tb: Int = 0;
    let mut sum_tm: Int = 0;
    let n: Int = list_len(rows);
    let mut i: Int = 0;
    while i < n {
        let r: DashboardRow = list_get(rows, i);
        sum_p = sum_p + r.prompt_tokens;
        sum_c = sum_c + r.completion_tokens;
        sum_tb = sum_tb + r.tool_bytes;
        sum_tm = sum_tm + r.thinking_ms;
        i = i + 1;
    }
    return DashboardSpec {
        title: title,
        session_id: sid,
        rows: rows,
        total_prompt_tokens: sum_p,
        total_completion_tokens: sum_c,
        total_tool_bytes: sum_tb,
        total_thinking_ms: sum_tm,
        efficiency_multiplier_x1000: 0
    };
}

pub fn dashboard_format_bar(pct_x10: Int, width: Int) -> String {
    let mut bar: String = "[";
    let mut filled: Int = (pct_x10 * width) / 1000;
    if filled > width {
        filled = width;
    }
    if filled < 0 {
        filled = 0;
    }
    let mut i: Int = 0;
    while i < filled {
        bar = bar + "#";
        i = i + 1;
    }
    while i < width {
        bar = bar + "-";
        i = i + 1;
    }
    bar = bar + "]";
    return bar;
}

pub fn dashboard_format_pct(pct_x10: Int) -> String {
    let whole: Int = pct_x10 / 10;
    let frac: Int = pct_x10 - (whole * 10);
    return whole.to_string() + "." + frac.to_string() + "%";
}

pub fn dashboard_pad_right(s: String, width: Int) -> String {
    let n: Int = s.len();
    let mut out: String = s;
    if n < width {
        let mut i: Int = 0;
        while i < (width - n) {
            out = out + " ";
            i = i + 1;
        }
    }
    return out;
}

pub fn dashboard_pad_left_num(n: Int, width: Int) -> String {
    let s: String = n.to_string();
    let len: Int = s.len();
    let mut out: String = "";
    if len < width {
        let mut i: Int = 0;
        while i < (width - len) {
            out = out + " ";
            i = i + 1;
        }
    }
    out = out + s;
    return out;
}

pub fn dashboard_render_header(spec: DashboardSpec) -> String {
    let mut out: String = "";
    out = out + "================================================================\n";
    out = out + "  " + spec.title + "  [session: " + spec.session_id + "]\n";
    out = out + "================================================================\n";
    return out;
}

pub fn dashboard_render_column_header() -> String {
    let mut out: String = "";
    out = out + dashboard_pad_right("agent", 14);
    out = out + dashboard_pad_left_num(0, 0);
    out = out + " | ";
    out = out + dashboard_pad_right("prompt", 10);
    out = out + " | ";
    out = out + dashboard_pad_right("completion", 12);
    out = out + " | ";
    out = out + dashboard_pad_right("tool B", 10);
    out = out + " | ";
    out = out + dashboard_pad_right("think ms", 10);
    out = out + " | bar\n";
    out = out + "---------------+------------+--------------+------------+------------+-------\n";
    return out;
}

pub fn dashboard_render_row(r: DashboardRow, total_tok: Int) -> String {
    let mut out: String = "";
    out = out + dashboard_pad_right(r.label, 14);
    out = out + " | ";
    out = out + dashboard_pad_left_num(r.prompt_tokens, 10);
    out = out + " | ";
    out = out + dashboard_pad_left_num(r.completion_tokens, 12);
    out = out + " | ";
    out = out + dashboard_pad_left_num(r.tool_bytes, 10);
    out = out + " | ";
    out = out + dashboard_pad_left_num(r.thinking_ms, 10);
    out = out + " | ";
    let row_tok: Int = r.prompt_tokens + r.completion_tokens;
    let mut pct: Int = 0;
    if total_tok > 0 {
        pct = (row_tok * 1000) / total_tok;
    }
    out = out + dashboard_format_bar(pct, 20);
    out = out + " " + dashboard_format_pct(pct) + "\n";
    return out;
}

pub fn dashboard_render_footer(spec: DashboardSpec) -> String {
    let mut out: String = "";
    out = out + "---------------+------------+--------------+------------+------------+-------\n";
    out = out + dashboard_pad_right("TOTAL", 14);
    out = out + " | ";
    out = out + dashboard_pad_left_num(spec.total_prompt_tokens, 10);
    out = out + " | ";
    out = out + dashboard_pad_left_num(spec.total_completion_tokens, 12);
    out = out + " | ";
    out = out + dashboard_pad_left_num(spec.total_tool_bytes, 10);
    out = out + " | ";
    out = out + dashboard_pad_left_num(spec.total_thinking_ms, 10);
    out = out + " |\n";
    out = out + "================================================================\n";
    out = out + "  efficiency: " + (spec).efficiency_multiplier_x1000.to_string() + "x (tokens_saved / ooda_total)\n";
    out = out + "================================================================\n";
    return out;
}

pub fn dashboard_render(spec: DashboardSpec) -> String {
    let total: Int = spec.total_prompt_tokens + spec.total_completion_tokens;
    let mut out: String = "";
    out = out + dashboard_render_header(spec);
    out = out + dashboard_render_column_header();
    let n: Int = list_len(spec.rows);
    let mut i: Int = 0;
    while i < n {
        let r: DashboardRow = list_get(spec.rows, i);
        out = out + dashboard_render_row(r, total);
        i = i + 1;
    }
    out = out + dashboard_render_footer(spec);
    return out;
}
