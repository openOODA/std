// # Pricing loader from env or file
//
// Logline: Load the per-million-token cost constants from OODA_TOKEN_PRICING env var, ~/.ooda-cache/ooda.pricing, or a named default; every report records which pricing was applied.
//
// Setup: Pure .oo standard library module — Chronos (Mcode #2) I2 pricing adapter.
//
// Beats:
//   1. Define Pricing struct with name, prompt_per_million, completion_per_million, source.
//   2. Parse a JSON object line into a Pricing.
//   3. Load from env, then file, then default.
//   4. Format the pricing provenance for envelope inclusion.

type Pricing = struct {
    name: String,
    prompt_per_million: Int,
    completion_per_million: Int,
    source: String
};

pub fn pricing_default() -> Pricing {
    return Pricing {
        name: "default",
        prompt_per_million: 1500000,
        completion_per_million: 6000000,
        source: "default"
    };
}

pub fn pricing_new(name: String, prompt: Int, completion: Int, source: String) -> Pricing {
    return Pricing {
        name: name,
        prompt_per_million: prompt,
        completion_per_million: completion,
        source: source
    };
}

fn pricing_skip_ws(s: String, idx: Int) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = idx;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" {
            i = i + 1;
        } else {
            return i;
        }
    }
    return i;
}

fn pricing_find_key(s: String, key: String, idx: Int) -> Int {
    let needle: String = "\"" + key + "\"";
    let n: Int = chars_len(s);
    let nn: Int = chars_len(needle);
    let mut i: Int = pricing_skip_ws(s, idx);
    while i + nn <= n {
        if str_slice(s, i, i + nn) == needle {
            let mut j: Int = i + nn;
            j = pricing_skip_ws(s, j);
            if j < n {
                if char_at(s, j) == ":" {
                    return j + 1;
                }
            }
        }
        i = i + 1;
    }
    return -1;
}

fn pricing_read_string(s: String, idx: Int) -> String {
    let n: Int = chars_len(s);
    if idx < 0 {
        return "";
    }
    if idx >= n {
        return "";
    }
    let mut start: Int = pricing_skip_ws(s, idx);
    if start >= n {
        return "";
    }
    if char_at(s, start) != "\"" {
        return "";
    }
    let mut i: Int = start + 1;
    let mut buf: String = "";
    while i < n {
        let c: String = char_at(s, i);
        if c == "\"" {
            return buf;
        }
        if c == "\\" {
            if i + 1 < n {
                let nxt: String = char_at(s, i + 1);
                if nxt == "\"" { buf = buf + "\""; }
                else if nxt == "\\" { buf = buf + "\\"; }
                else if nxt == "n" { buf = buf + "\n"; }
                else if nxt == "t" { buf = buf + "\t"; }
                else { buf = buf + nxt; }
                i = i + 1;
            }
        } else {
            buf = buf + c;
        }
        i = i + 1;
    }
    return buf;
}

fn pricing_read_int(s: String, key: String) -> Int {
    let after: Int = pricing_find_key(s, key, 0);
    if after < 0 {
        return 0;
    }
    let n: Int = chars_len(s);
    let mut i: Int = pricing_skip_ws(s, after);
    if i >= n {
        return 0;
    }
    let mut acc: Int = 0;
    let mut saw_digit: Bool = false;
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { acc = acc * 10; saw_digit = true; }
        else if c == "1" { acc = acc * 10 + 1; saw_digit = true; }
        else if c == "2" { acc = acc * 10 + 2; saw_digit = true; }
        else if c == "3" { acc = acc * 10 + 3; saw_digit = true; }
        else if c == "4" { acc = acc * 10 + 4; saw_digit = true; }
        else if c == "5" { acc = acc * 10 + 5; saw_digit = true; }
        else if c == "6" { acc = acc * 10 + 6; saw_digit = true; }
        else if c == "7" { acc = acc * 10 + 7; saw_digit = true; }
        else if c == "8" { acc = acc * 10 + 8; saw_digit = true; }
        else if c == "9" { acc = acc * 10 + 9; saw_digit = true; }
        else {
            if saw_digit {
                return acc;
            }
            if c == "," || c == "}" {
                return acc;
            }
            return 0;
        }
        i = i + 1;
    }
    return acc;
}

pub fn pricing_parse_json(line: String) -> Pricing {
    let name: String = pricing_read_string(line, pricing_find_key(line, "name", 0));
    let prompt: Int = pricing_read_int(line, "prompt");
    let completion: Int = pricing_read_int(line, "completion");
    if prompt == 0 {
        if completion == 0 {
            return pricing_default();
        }
    }
    return pricing_new(name, prompt, completion, "parsed");
}

pub fn pricing_load(fs: &FsReadCap, env_value: String, file_path: String) -> Pricing {
    if env_value != "" {
        return pricing_parse_json(env_value);
    }
    if file_path != "" {
        if path_exists(fs, file_path) {
            let tr: Result[String, String] = read_file(fs, file_path);
            if tr.is_ok() {
                let text: String = match tr { Ok(s) => s, Err(m) => m };
                let p: Pricing = pricing_parse_json(text);
                let named: Pricing = pricing_new(p.name, p.prompt_per_million, p.completion_per_million, "file");
                return named;
            }
        }
    }
    return pricing_default();
}

pub fn pricing_to_json(p: Pricing) -> String {
    let mut out: String = "{";
    let prompt: Int = p.prompt_per_million;
    let comp: Int = p.completion_per_million;
    out = out + "\"name\":\"" + p.name + "\"";
    out = out + ",\"prompt\":" + prompt.to_string();
    out = out + ",\"completion\":" + comp.to_string();
    out = out + ",\"source\":\"" + p.source + "\"";
    out = out + "}";
    return out;
}
