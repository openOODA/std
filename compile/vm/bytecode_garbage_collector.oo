// # Virtual Machine Generational Garbage Collector
//
// Logline: Generational mark-sweep garbage collector, nursery semi-spaces, promotion aging, and card table write barriers.
//
// Setup: Manages young generation copying collector and old generation mark-sweep heap with generational write barriers.
//
// Beats:
//   1. Define GcHeader, NurserySemiSpace, TenuredHeap, and CardTable structures.
//   2. Allocate objects in young generation nursery space.
//   3. Mark dirty card table bytes on cross-generational old-to-young pointer writes.

type GcHeader = struct {
    object_id: Int,
    size_bytes: Int,
    age_cycles: Int,
    is_marked: Int,
    is_tenured: Int
};

type NurserySpace = struct {
    capacity_bytes: Int,
    used_bytes: Int,
    objects: List[GcHeader],
    object_count: Int
};

type TenuredHeap = struct {
    capacity_bytes: Int,
    used_bytes: Int,
    objects: List[GcHeader],
    object_count: Int
};

type CardTable = struct {
    card_count: Int,
    cards: List[Int] // 0: CLEAN, 1: DIRTY
};

type GenerationalGcState = struct {
    nursery: NurserySpace,
    tenured: TenuredHeap,
    card_table: CardTable,
    tenure_age_threshold: Int,
    total_collections: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn gc_header_new(id: Int, size: Int) -> GcHeader {
    return GcHeader {
        object_id: id,
        size_bytes: size,
        age_cycles: 0,
        is_marked: 0,
        is_tenured: 0
    };
}

pub fn nursery_space_new(cap: Int) -> NurserySpace {
    let empty_objs: List[GcHeader] = list_new();
    return NurserySpace {
        capacity_bytes: cap,
        used_bytes: 0,
        objects: empty_objs,
        object_count: 0
    };
}

pub fn tenured_heap_new(cap: Int) -> TenuredHeap {
    let empty_objs: List[GcHeader] = list_new();
    return TenuredHeap {
        capacity_bytes: cap,
        used_bytes: 0,
        objects: empty_objs,
        object_count: 0
    };
}

pub fn card_table_new(num_cards: Int) -> CardTable {
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_cards {
        c = list_push(c, 0); // CLEAN
        i = i + 1;
    }
    return CardTable {
        card_count: num_cards,
        cards: c
    };
}

pub fn generational_gc_new(nursery_cap: Int, tenured_cap: Int) -> GenerationalGcState {
    return GenerationalGcState {
        nursery: nursery_space_new(nursery_cap),
        tenured: tenured_heap_new(tenured_cap),
        card_table: card_table_new(512),
        tenure_age_threshold: 4,
        total_collections: 0
    };
}

// -------------------------------------------------------------------
// Allocation & Write Barrier
// -------------------------------------------------------------------

pub fn gc_allocate_young(gc: GenerationalGcState, id: Int, size_bytes: Int) -> GenerationalGcState {
    let obj: GcHeader = gc_header_new(id, size_bytes);
    let mut objs: List[GcHeader] = (gc.nursery).objects;
    objs = list_push(objs, obj);
    let cap: Int = (gc.nursery).capacity_bytes;
    let used: Int = (gc.nursery).used_bytes + size_bytes;
    let cnt: Int = (gc.nursery).object_count + 1;
    let new_nursery: NurserySpace = NurserySpace {
        capacity_bytes: cap,
        used_bytes: used,
        objects: objs,
        object_count: cnt
    };
    let ten: TenuredHeap = gc.tenured;
    let ct: CardTable = gc.card_table;
    let thresh: Int = gc.tenure_age_threshold;
    let total: Int = gc.total_collections;
    return GenerationalGcState {
        nursery: new_nursery,
        tenured: ten,
        card_table: ct,
        tenure_age_threshold: thresh,
        total_collections: total
    };
}

pub fn gc_write_barrier_mark_card(gc: GenerationalGcState, card_index: Int) -> GenerationalGcState {
    if card_index >= 0 && card_index < (gc.card_table).card_count {
        let mut new_cards: List[Int] = list_new();
        let mut i: Int = 0;
        let limit: Int = (gc.card_table).card_count;
        while i < limit {
            if i == card_index {
                new_cards = list_push(new_cards, 1);
            } else {
                new_cards = list_push(new_cards, list_get((gc.card_table).cards, i));
            }
            i = i + 1;
        }
        let new_table: CardTable = CardTable {
            card_count: limit,
            cards: new_cards
        };
        let nur: NurserySpace = gc.nursery;
        let ten: TenuredHeap = gc.tenured;
        let thresh: Int = gc.tenure_age_threshold;
        let total: Int = gc.total_collections;
        return GenerationalGcState {
            nursery: nur,
            tenured: ten,
            card_table: new_table,
            tenure_age_threshold: thresh,
            total_collections: total
        };
    }
    return gc;
}
