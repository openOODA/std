// # Finite State Machine Typestate Engine
//
// Logline: Deterministic state machine verifying allowable state transitions and rejecting illegal state jumps.
//
// Setup: Pure transition validation engine enforcing explicit graph edge transitions.
//
// Beats:
//   1. Define state machine with initial state and transition table.
//   2. Register valid directed transition edges with action identifiers.
//   3. Execute step transition verifying edge presence.
//   4. Fail closed on illegal transition attempts.

type StateMachine = struct {
    current_state: Int,
    edge_count: Int,
    from_states: List[Int],
    to_states: List[Int],
    actions: List[Int]
};

pub fn fsm_new(initial_state: Int) -> StateMachine {
    let ef: List[Int] = list_new();
    let et: List[Int] = list_new();
    let ea: List[Int] = list_new();
    return StateMachine {
        current_state: initial_state,
        edge_count: 0,
        from_states: ef,
        to_states: et,
        actions: ea
    };
}

pub fn fsm_add_transition(fsm: StateMachine, from_st: Int, to_st: Int, action: Int) -> StateMachine {
    let mut fs: List[Int] = fsm.from_states;
    let mut ts: List[Int] = fsm.to_states;
    let mut as: List[Int] = fsm.actions;
    fs = list_push(fs, from_st);
    ts = list_push(ts, to_st);
    as = list_push(as, action);
    return StateMachine {
        current_state: fsm.current_state,
        edge_count: fsm.edge_count + 1,
        from_states: fs,
        to_states: ts,
        actions: as
    };
}

pub fn fsm_step(fsm: StateMachine, action: Int) -> Result[StateMachine, String] {
    let cur: Int = fsm.current_state;
    let n: Int = fsm.edge_count;
    let mut i: Int = 0;
    while i < n {
        let f: Int = list_get(fsm.from_states, i);
        let a: Int = list_get(fsm.actions, i);
        if f == cur && a == action {
            let next_st: Int = list_get(fsm.to_states, i);
            return Ok(StateMachine {
                current_state: next_st,
                edge_count: fsm.edge_count,
                from_states: fsm.from_states,
                to_states: fsm.to_states,
                actions: fsm.actions
            });
        }
        i = i + 1;
    }
    return Err("ERR\tfsm_step\tillegal_transition_from_" + cur.to_string() + "_action_" + action.to_string());
}

pub fn fsm_get_state(fsm: StateMachine) -> Int {
    return fsm.current_state;
}
