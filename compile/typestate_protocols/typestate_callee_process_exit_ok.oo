fn open_sock() -> Int { return 1; }
fn send(s: Int) { let x = s; }

fn wrap(s: Int) {
    let t = open_sock();
    process_exit(1);
}

pub fn verify_typestate_callee_process_exit_ok() -> Bool {
    let s = open_sock();
    wrap(s);
    send(s);
    return true;
}
