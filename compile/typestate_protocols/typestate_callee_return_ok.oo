// # Typestate Callee Return Ok
//
// Logline: Standard library verification and domain capabilities for Typestate Callee Return Ok.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

fn open_sock() -> Int { return 1; }
fn actually(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

fn wrap(s: Int) {
    actually(s);
    return;
}

pub fn verify_typestate_callee_return_ok() -> Bool {
    let s = open_sock();
    wrap(s);
    send(s);
    return true;
}
