// # Typestate Field Ok
//
// Logline: Standard library verification and domain capabilities for Typestate Field Ok.
//
// Setup: Pure .oo standard library module.
//
// Beats:
//   1. Execute domain operations.
//   2. Verify invariants and return typed results.

type Box = struct { s: Int }

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

pub fn verify_typestate_field_ok() -> Bool {
    let mut p = Box { s: 0 };
    p.s = open_sock();
    connect(p.s);
    send(p.s);
    return true;
}
