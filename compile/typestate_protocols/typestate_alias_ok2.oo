fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

pub fn verify_typestate_alias_ok2() -> Bool {
    let s = open_sock();
    let t = s;
    connect(t);
    send(s);
    return true;
}
