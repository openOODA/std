// # Sequential Typestate Protocol Guard
//
// Logline: Validates strictly monotonic session phases preventing out-of-order execution in network and IPC protocols.
//
// Setup: Pure linear session verifier guaranteeing strict phase progression.
//
// Beats:
//   1. Define standard protocol phase sequence: Init (0), Handshake (1), Ready (2), Active (3), Closed (4).
//   2. Advance protocol phase asserting strictly sequential progression.
//   3. Block illegal skips and backwards transitions.
//   4. Confirm terminal closed state.

pub fn phase_init() -> Int { return 0; }
pub fn phase_handshake() -> Int { return 1; }
pub fn phase_ready() -> Int { return 2; }
pub fn phase_active() -> Int { return 3; }
pub fn phase_closed() -> Int { return 4; }

type ProtocolGuard = struct {
    current_phase: Int,
    is_terminal: Bool
};

pub fn proto_guard_new() -> ProtocolGuard {
    return ProtocolGuard {
        current_phase: phase_init(),
        is_terminal: false
    };
}

pub fn proto_guard_advance(g: ProtocolGuard, target_phase: Int) -> Result[ProtocolGuard, String] {
    if g.is_terminal {
        return Err("ERR\tproto_guard_advance\tsession_already_closed");
    }
    let cur: Int = g.current_phase;
    if target_phase != (cur + 1) {
        return Err("ERR\tproto_guard_advance\tillegal_phase_jump_from_" + cur.to_string() + "_to_" + target_phase.to_string());
    }
    let is_term: Bool = target_phase == phase_closed();
    return Ok(ProtocolGuard {
        current_phase: target_phase,
        is_terminal: is_term
    });
}

pub fn proto_guard_is_ready(g: ProtocolGuard) -> Bool {
    return g.current_phase >= phase_ready() && !g.is_terminal;
}
