fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }

fn wrap(s: Int) {
    let t = open_sock();
    connect(t);
}

pub fn verify_typestate_callee_other_obj_bad() -> Bool {
    let s = open_sock();
    wrap(s);
    return true;
}
