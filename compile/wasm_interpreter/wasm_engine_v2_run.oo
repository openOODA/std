// # WebAssembly Engine V2 Run Entry
//
// Logline: Initialize locals, entry body, and host runtime then delegate to wasm_engine_v2_step.
//
// Setup: Imports wasm_engine_v2 types and the recursive step function.
//
// Beats:
//   1. Reject modules with no user functions.
//   2. Allocate zeroed locals for the entry function.
//   3. Skip the locals-count immediate prefix in the entry body.
//   4. Call wasm_engine_v2_step with an empty call stack.

import "std/compile/wasm_interpreter/wasm_stack.oo";
import "std/compile/wasm_interpreter/wasm_engine_v2.oo";
import "std/compile/wasm_interpreter/wasm_engine_v2_step.oo";
import "std/compile/wasm_interpreter/wasm_host_runtime.oo";

pub fn wasm_engine_v2_run(mod: WasmModuleV2) -> Result[PairRuntimeInt, String] {
    let user_count: Int = mod.user_count;
    if user_count <= 0 { return Err("ERR\twasm_module_v2_run\tno_user_functions"); }
    let entry: Int = mod.entry;
    let r_st: Result[WasmStack, String] = wasm_stack_new(256);
    let st0: WasmStack = r_st.val;
    let entry_locals: Int = list_get(mod.user_local_count, entry);
    let mut locs: List[Int] = list_new();
    let mut li: Int = 0;
    while li < entry_locals { locs = list_push(locs, 0); li = li + 1; }
    let entry_body: List[Int] = wasm_module_v2_get_user_body(mod,  entry);
    let body_len: Int = list_len(entry_body);
    let mut pc: Int = 0;
    if body_len > 0 { let lv: Int = wasm_engine_v2_decode_imm(entry_body, 0); pc = 1 + lv * 2; }
    let call_stack: List[Int] = list_new();
    let rt: WasmHostRuntime = mod.host_runtime;
    let entry_labels: List[Int] = list_new();
    return wasm_engine_v2_step(mod, entry_body, body_len, pc, st0, locs, 0, entry_locals, 0, 0, call_stack, entry, rt, entry_labels);
}
