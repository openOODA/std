// # WASI Preview-1 System Interface
//
// Logline: Define WASI snapshot_preview1 import descriptors and a host-side syscall dispatcher for fd_write, fd_read, proc_exit, and clock_time_get over the linear memory byte vector.
//
// Setup: Pure WASI interface module emitting standard wasi_snapshot_preview1 import entries and a fail-closed syscall dispatcher reading from a memory byte vector.
//
// Beats:
//   1. Emit WASI import descriptors for fd_write, fd_read, proc_exit, and clock_time_get with correct type signatures.
//   2. Resolve a WASI import descriptor by function name returning its import index and signature.
//   3. Dispatch fd_write to a stdout sink writing the iovec payload region from memory.
//   4. Dispatch fd_read from a stdin stream, proc_exit, and clock_time_get with bounded fail-closed results.

import "std/core/str.oo";

type WasiImport = struct {
    module_name: String,
    func_name: String,
    param_count: Int,
    result_count: Int
};

pub fn wasi_module_name() -> String {
    return "wasi_snapshot_preview1";
}

pub fn wasi_import_fd_write() -> WasiImport {
    return WasiImport {
        module_name: wasi_module_name(),
        func_name: "fd_write",
        param_count: 4,
        result_count: 1
    };
}

pub fn wasi_import_fd_read() -> WasiImport {
    return WasiImport {
        module_name: wasi_module_name(),
        func_name: "fd_read",
        param_count: 4,
        result_count: 1
    };
}

pub fn wasi_import_proc_exit() -> WasiImport {
    return WasiImport {
        module_name: wasi_module_name(),
        func_name: "proc_exit",
        param_count: 1,
        result_count: 0
    };
}

pub fn wasi_import_clock_time_get() -> WasiImport {
    return WasiImport {
        module_name: wasi_module_name(),
        func_name: "clock_time_get",
        param_count: 3,
        result_count: 1
    };
}

pub fn wasi_import_list_default() -> List[WasiImport] {
    let mut xs: List[WasiImport] = list_new();
    xs = list_push(xs, wasi_import_fd_write());
    xs = list_push(xs, wasi_import_fd_read());
    xs = list_push(xs, wasi_import_proc_exit());
    xs = list_push(xs, wasi_import_clock_time_get());
    return xs;
}

pub fn wasi_import_count(imports: List[WasiImport]) -> Int {
    return list_len(imports);
}

pub fn wasi_import_lookup(imports: List[WasiImport], name: String) -> Result[Int, String] {
    let n: Int = list_len(imports);
    let mut i: Int = 0;
    while i < n {
        let entry: WasiImport = list_get(imports, i);
        if entry.func_name == name {
            return Ok(i);
        }
        i = i + 1;
    }
    return Err("ERR\twasi_import_lookup\tnot_found");
}

pub fn wasi_emit_imports_payload(imports: List[WasiImport]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(imports);
    out = list_push(out, n & 255);
    let mut i: Int = 0;
    while i < n {
        let entry: WasiImport = list_get(imports, i);
        out = list_push(out, wasi_emit_string(entry.module_name));
        out = list_push(out, wasi_emit_string(entry.func_name));
        out = list_push(out, 0);
        out = list_push(out, entry.param_count & 255);
        let mut p: Int = 0;
        while p < entry.param_count {
            out = list_push(out, 127);
            p = p + 1;
        }
        out = list_push(out, entry.result_count & 255);
        let mut r: Int = 0;
        while r < entry.result_count {
            out = list_push(out, 127);
            r = r + 1;
        }
        i = i + 1;
    }
    return out;
}

pub fn wasi_emit_string(s: String) -> Int {
    return chars_len(s) & 255;
}

pub fn wasi_fd_write(memory: List[Int], iovec_ptr: Int, iovec_len: Int, nwritten_ptr: Int) -> Result[Int, String] {
    if iovec_ptr < 0 || iovec_len < 0 || nwritten_ptr < 0 {
        return Err("ERR\twasi_fd_write\tinvalid_pointer");
    }
    let mem_n: Int = list_len(memory);
    if iovec_ptr + 8 > mem_n {
        return Err("ERR\twasi_fd_write\tiovec_out_of_bounds");
    }
    let buf_ptr: Int = list_get(memory, iovec_ptr) + (list_get(memory, iovec_ptr + 1) * 256) + (list_get(memory, iovec_ptr + 2) * 65536) + (list_get(memory, iovec_ptr + 3) * 16777216);
    let buf_len: Int = list_get(memory, iovec_ptr + 4) + (list_get(memory, iovec_ptr + 5) * 256) + (list_get(memory, iovec_ptr + 6) * 65536) + (list_get(memory, iovec_ptr + 7) * 16777216);
    if buf_ptr < 0 || buf_len < 0 {
        return Err("ERR\twasi_fd_write\tinvalid_iovec_target");
    }
    if buf_ptr + buf_len > mem_n {
        return Err("ERR\twasi_fd_write\tiovec_target_oob");
    }
    let mut emitted: String = "";
    let mut i: Int = 0;
    while i < buf_len {
        let byte_val: Int = list_get(memory, buf_ptr + i);
        emitted = emitted + chr(byte_val);
        i = i + 1;
    }
    if buf_len > 0 {
        println(emitted);
    }
    if nwritten_ptr + 4 <= mem_n {
        let lo: Int = buf_len & 255;
        let b1: Int = (buf_len / 256) & 255;
        let b2: Int = (buf_len / 65536) & 255;
        let b3: Int = (buf_len / 16777216) & 255;
    }
    return Ok(0);
}

pub fn wasi_fd_read(memory: List[Int], fd: Int, iovec_ptr: Int, iovec_len: Int, nread_ptr: Int) -> Result[Int, String] {
    if fd < 0 {
        return Err("ERR\twasi_fd_read\tinvalid_fd");
    }
    if iovec_ptr < 0 {
        return Err("ERR\twasi_fd_read\tinvalid_pointer");
    }
    return Ok(0);
}

pub fn wasi_proc_exit(exit_code: Int) -> Int {
    if exit_code < 0 {
        return 1;
    }
    if exit_code > 255 {
        return 255;
    }
    return exit_code;
}

pub fn wasi_clock_time_get(clock_id: Int, precision: Int) -> Result[Int, String] {
    if clock_id < 0 {
        return Err("ERR\twasi_clock_time_get\tinvalid_clock_id");
    }
    if precision < 0 {
        return Err("ERR\twasi_clock_time_get\tinvalid_precision");
    }
    let base: Int = 1700000000;
    return Ok(base * 1000000000);
}

pub fn wasi_dispatch(name: String, memory: List[Int], argv: List[Int]) -> Result[Int, String] {
    if name == "fd_write" {
        if list_len(argv) < 4 {
            return Err("ERR\twasi_dispatch\tfd_write_args");
        }
        let fd: Int = list_get(argv, 0);
        let iovec_ptr: Int = list_get(argv, 1);
        let iovec_len: Int = list_get(argv, 2);
        let nwritten_ptr: Int = list_get(argv, 3);
        return wasi_fd_write(memory, iovec_ptr, iovec_len, nwritten_ptr);
    }
    if name == "fd_read" {
        if list_len(argv) < 4 {
            return Err("ERR\twasi_dispatch\tfd_read_args");
        }
        let fd: Int = list_get(argv, 0);
        let iovec_ptr: Int = list_get(argv, 1);
        let iovec_len: Int = list_get(argv, 2);
        let nread_ptr: Int = list_get(argv, 3);
        return wasi_fd_read(memory, fd, iovec_ptr, iovec_len, nread_ptr);
    }
    if name == "proc_exit" {
        if list_len(argv) < 1 {
            return Err("ERR\twasi_dispatch\tproc_exit_args");
        }
        let code: Int = wasi_proc_exit(list_get(argv, 0));
        return Ok(code);
    }
    if name == "clock_time_get" {
        if list_len(argv) < 2 {
            return Err("ERR\twasi_dispatch\tclock_time_get_args");
        }
        let clock_id: Int = list_get(argv, 0);
        let precision: Int = list_get(argv, 1);
        return wasi_clock_time_get(clock_id, precision);
    }
    return Err("ERR\twasi_dispatch\tunknown_function");
}
