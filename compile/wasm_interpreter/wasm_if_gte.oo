// # Const if 2 >= 1 println
//
// Logline: Print gte-then when the condition is 2 >= 1.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If 2 >= 1 print gte-then else print gte-else.
//   3. Leave no other statements.

pub fn verify_wasm_if_gte() -> Bool {
    if 2 >= 1 {
        println("gte-then");
    } else {
        println("gte-else");
    }
    return true;
}
