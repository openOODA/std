// # If-false else println for WASI emit
//
// Logline: Take the else branch of if false and print else-yes.
//
// Setup: No imports. One public main. The body is only if false then println then-no else println else-yes.
//
// Beats:
//   1. Declare public main.
//   2. If false, print then-no.
//   3. Else print else-yes.

pub fn verify_wasm_if_false() -> Bool {
    if false {
        println("then-no");
    } else {
        println("else-yes");
    }
    return true;
}
