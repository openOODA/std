// # Const if (1 < 2) println no else
//
// Logline: Print plt-ne when (1 < 2) and there is no else branch.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If (1 < 2) print plt-ne.
//   3. Leave no else and no other statements.

pub fn verify_wasm_if_paren_lt_noelse() -> Bool {
    if (1 < 2) {
        println("plt-ne");
    }
    return true;
}
