// # WebAssembly Engine V2 Step Continuation
//
// Logline: Continuation record for one opcode of wasm_engine_v2_step. done=1 returns Ok/Err; done=0 tail-calls with new state.
//
// Setup: Imports stack and host runtime types.
//
// Beats:
//   1. wasm_step_cont_go continues at a new PC.
//   2. wasm_step_cont_ok and wasm_step_cont_err finish the step.

import "std/compile/wasm_interpreter/wasm_stack.oo";
import "std/compile/wasm_interpreter/wasm_host_runtime.oo";

type WasmStepCont = struct {
    done: Int,
    ok: Int,
    err: String,
    pair: PairRuntimeInt,
    body: List[Int],
    body_len: Int,
    pc: Int,
    st: WasmStack,
    locs: List[Int],
    local_base: Int,
    locals_top: Int,
    skip_depth: Int,
    block_depth: Int,
    call_stack: List[Int],
    func_idx: Int,
    rt: WasmHostRuntime,
    labels: List[Int]
};

pub fn wasm_step_cont_go(body: List[Int], body_len: Int, pc: Int, st: WasmStack, locs: List[Int], local_base: Int, locals_top: Int, skip_depth: Int, block_depth: Int, call_stack: List[Int], func_idx: Int, rt: WasmHostRuntime, labels: List[Int]) -> WasmStepCont {
    return WasmStepCont {
        done: 0,
        ok: 1,
        err: "",
        pair: PairRuntimeInt { rt: rt, value: 0 },
        body: body,
        body_len: body_len,
        pc: pc,
        st: st,
        locs: locs,
        local_base: local_base,
        locals_top: locals_top,
        skip_depth: skip_depth,
        block_depth: block_depth,
        call_stack: call_stack,
        func_idx: func_idx,
        rt: rt,
        labels: labels
    };
}

pub fn wasm_step_cont_ok(rt: WasmHostRuntime, value: Int) -> WasmStepCont {
    let empty: List[Int] = list_new();
    let dummy_st: WasmStack = WasmStack { depth: 0, max_depth: 1, items: empty };
    return WasmStepCont {
        done: 1,
        ok: 1,
        err: "",
        pair: PairRuntimeInt { rt: rt, value: value },
        body: empty,
        body_len: 0,
        pc: 0,
        st: dummy_st,
        locs: empty,
        local_base: 0,
        locals_top: 0,
        skip_depth: 0,
        block_depth: 0,
        call_stack: empty,
        func_idx: 0,
        rt: rt,
        labels: empty
    };
}

pub fn wasm_step_cont_err(msg: String, rt: WasmHostRuntime) -> WasmStepCont {
    let empty: List[Int] = list_new();
    let dummy_st: WasmStack = WasmStack { depth: 0, max_depth: 1, items: empty };
    return WasmStepCont {
        done: 1,
        ok: 0,
        err: msg,
        pair: PairRuntimeInt { rt: rt, value: 0 },
        body: empty,
        body_len: 0,
        pc: 0,
        st: dummy_st,
        locs: empty,
        local_base: 0,
        locals_top: 0,
        skip_depth: 0,
        block_depth: 0,
        call_stack: empty,
        func_idx: 0,
        rt: rt,
        labels: empty
    };
}
