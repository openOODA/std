// # Const if 1==1 || 0==1 println no else
//
// Logline: Print eqor-ne when 1==1 || 0==1 and there is no else branch.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If 1==1 || 0==1 print eqor-ne.
//   3. Leave no else and no other statements.

pub fn verify_wasm_if_eq_or_noelse() -> Bool {
    if 1 == 1 || 0 == 1 {
        println("eqor-ne");
    }
    return true;
}
