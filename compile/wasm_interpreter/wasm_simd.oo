// # WebAssembly 128-Bit SIMD Vector Operations
//
// Logline: Implements Wasm v128 vector structure with 4x32-bit integer lane arithmetic, bitwise logic, and lane manipulation.
//
// Setup: Pure SIMD vector module for WebAssembly vector operations.
//
// Beats:
//   1. Define v128 vector representation with 4 integer lanes (l0, l1, l2, l3).
//   2. Implement i32x4 lane-wise vector addition, subtraction, and multiplication.
//   3. Implement v128 bitwise and, or, xor, and not operations.
//   4. Implement extract_lane and replace_lane with bounds checking.

type V128 = struct {
    l0: Int,
    l1: Int,
    l2: Int,
    l3: Int
};

pub fn v128_new(v0: Int, v1: Int, v2: Int, v3: Int) -> V128 {
    return V128 {
        l0: v0,
        l1: v1,
        l2: v2,
        l3: v3
    };
}

pub fn v128_i32x4_add(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 + b.l0,
        l1: a.l1 + b.l1,
        l2: a.l2 + b.l2,
        l3: a.l3 + b.l3
    };
}

pub fn v128_i32x4_sub(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 - b.l0,
        l1: a.l1 - b.l1,
        l2: a.l2 - b.l2,
        l3: a.l3 - b.l3
    };
}

pub fn v128_i32x4_mul(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 * b.l0,
        l1: a.l1 * b.l1,
        l2: a.l2 * b.l2,
        l3: a.l3 * b.l3
    };
}

pub fn v128_and(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 & b.l0,
        l1: a.l1 & b.l1,
        l2: a.l2 & b.l2,
        l3: a.l3 & b.l3
    };
}

pub fn v128_or(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 | b.l0,
        l1: a.l1 | b.l1,
        l2: a.l2 | b.l2,
        l3: a.l3 | b.l3
    };
}

pub fn v128_extract_lane(v: V128, lane: Int) -> Result[Int, String] {
    if lane == 0 { return Ok(v.l0); }
    if lane == 1 { return Ok(v.l1); }
    if lane == 2 { return Ok(v.l2); }
    if lane == 3 { return Ok(v.l3); }
    return Err("ERR\tv128_extract_lane\tlane_index_out_of_bounds");
}

pub fn v128_replace_lane(v: V128, lane: Int, val: Int) -> Result[V128, String] {
    if lane == 0 { return Ok(V128 { l0: val, l1: v.l1, l2: v.l2, l3: v.l3 }); }
    if lane == 1 { return Ok(V128 { l0: v.l0, l1: val, l2: v.l2, l3: v.l3 }); }
    if lane == 2 { return Ok(V128 { l0: v.l0, l1: v.l1, l2: val, l3: v.l3 }); }
    if lane == 3 { return Ok(V128 { l0: v.l0, l1: v.l1, l2: v.l2, l3: val }); }
    return Err("ERR\tv128_replace_lane\tlane_index_out_of_bounds");
}
