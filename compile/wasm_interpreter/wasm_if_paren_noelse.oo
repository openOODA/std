// # Const if (true) println no else
//
// Logline: Print paren-ne when (true) and there is no else branch.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If (true) print paren-ne.
//   3. Leave no else and no other statements.

pub fn verify_wasm_if_paren_noelse() -> Bool {
    if (true) {
        println("paren-ne");
    }
    return true;
}
