// # Hostile IDENT sixth println
//
// Logline: Print five strings then IDENT x so emit-wasm must miss a six-string fold.
//
// Setup: One public main. Sixth print is IDENT, not STRING.
//
// Beats:
//   1. Let x be fold-me.
//   2. Print line-a through line-e, then x.
//   3. A fold-me-only module is a lie.

pub fn verify_wasm_six_hostile() -> Bool {
    let x = "fold-me";
    println("line-a");
    println("line-b");
    println("line-c");
    println("line-d");
    println("line-e");
    println(x);
    return true;
}
