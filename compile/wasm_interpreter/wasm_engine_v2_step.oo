// # WebAssembly Multi-Function Step Function
//
// Logline: Recursive step wrapper. Decodes one opcode via wasm_engine_v2_step_once and tail-calls until Ok or Err.
//
// Setup: Imports the continuation helpers and the once dispatcher. Opcode behavior is unchanged.
//
// Beats:
//   1. wasm_engine_v2_step applies one continuation and recurses if not done.
//   2. Callers keep importing this file.

import "std/compile/wasm_interpreter/wasm_stack.oo";
import "std/compile/wasm_interpreter/wasm_host_runtime.oo";
import "std/compile/wasm_interpreter/wasm_engine_v2.oo";
import "std/compile/wasm_interpreter/wasm_step_cont.oo";
import "std/compile/wasm_interpreter/wasm_engine_v2_step_once.oo";

pub fn wasm_engine_v2_step(mod: WasmModuleV2, body: List[Int], body_len: Int, pc: Int, st: WasmStack, locs: List[Int], local_base: Int, locals_top: Int, skip_depth: Int, block_depth: Int, call_stack: List[Int], func_idx: Int, rt: WasmHostRuntime, labels: List[Int]) -> Result[PairRuntimeInt, String] {
    let cont: WasmStepCont = wasm_engine_v2_step_once(mod, body, body_len, pc, st, locs, local_base, locals_top, skip_depth, block_depth, call_stack, func_idx, rt, labels);
    if cont.done == 1 {
        if cont.ok == 1 {
            return Ok(cont.pair);
        }
        return Err(cont.err);
    }
    return wasm_engine_v2_step(mod, cont.body, cont.body_len, cont.pc, cont.st, cont.locs, cont.local_base, cont.locals_top, cont.skip_depth, cont.block_depth, cont.call_stack, cont.func_idx, cont.rt, cont.labels);
}
