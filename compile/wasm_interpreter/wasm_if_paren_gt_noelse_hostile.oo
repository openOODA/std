// # Hostile if (2 > x) no-else fold
//
// Logline: Print fold-me from if (2 > x) with no else so emit-wasm must miss a const-paren-gt no-else fold.
//
// Setup: One public main. Right operand is IDENT x.
//
// Beats:
//   1. Let x be 1.
//   2. If (2 > x) print fold-me.
//   3. A fold-me-only module is a lie.

pub fn verify_wasm_if_paren_gt_noelse_hostile() -> Bool {
    let x = 1;
    if (2 > x) {
        println("fold-me");
    }
    return true;
}
