// # WebAssembly Stack Codegen & Opcode Emitter
//
// Logline: Lower .oo integer arithmetic, bitwise, comparison, structured control flow, locals, and memory access expressions to canonical WebAssembly stack machine instructions.
//
// Setup: Pure codegen module producing section 10 Code body bytes from a local variable type list and a typed instruction stream backed by std/compile/wasm_interpreter/wasm_opcodes.oo and std/compile/wasm_interpreter/wasm_binary_builder.oo.
//
// Beats:
//   1. Maintain a typed local list and a code byte buffer for accumulating emitted opcodes and LEB128 operands.
//   2. Emit i64 and i32 arithmetic, bitwise, shift, and comparison opcodes with optional constant operand.
//   3. Emit local.get, local.set, local.tee with LEB128 index operand and bounds-checked fail-closed semantics.
//   4. Emit i32.load, i64.load, i32.store, i64.store with LEB128 alignment and offset operands.
//   5. Emit structured control flow block, loop, if, else, end, br, br_if with conditional branches.
//   6. Encode the final function body with the locals vector prefix and trailing end opcode.

import "std/compile/wasm_interpreter/wasm_opcodes.oo";
import "std/compile/wasm_interpreter/wasm_binary_builder.oo";
import "std/compile/wasm_interpreter/wasm_stack.oo";

type WasmCodeGen = struct {
    code_bytes: List[Int],
    locals: List[Int]
};

pub fn wasm_codegen_new() -> WasmCodeGen {
    let empty_bytes: List[Int] = list_new();
    let empty_locals: List[Int] = list_new();
    return WasmCodeGen {
        code_bytes: empty_bytes,
        locals: empty_locals
    };
}

pub fn wasm_codegen_local_count(cg: WasmCodeGen) -> Int {
    return list_len(cg.locals);
}

pub fn wasm_codegen_code_size(cg: WasmCodeGen) -> Int {
    return list_len(cg.code_bytes);
}
pub fn wasm_codegen_declare_local(cg: WasmCodeGen, val_type: Int) -> WasmCodeGen {
    return WasmCodeGen {
        code_bytes: cg.code_bytes,
        locals: list_push(cg.locals, val_type)
    };
}

fn cg_push_byte(cg: WasmCodeGen, byte_val: Int) -> WasmCodeGen {
    return WasmCodeGen {
        code_bytes: list_push(cg.code_bytes, byte_val & 255),
        locals: cg.locals
    };
}

fn cg_push_bytes(cg: WasmCodeGen, bytes: List[Int]) -> WasmCodeGen {
    let n: Int = list_len(bytes);
    let mut next: WasmCodeGen = cg;
    let mut i: Int = 0;
    while i < n {
        next = cg_push_byte(next, list_get(bytes, i));
        i = i + 1;
    }
    return next;
}

pub fn wasm_codegen_emit_i64_const(cg: WasmCodeGen, val: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_i64_const());
    let leb: List[Int] = wasm_binary_encode_i64_leb128(val);
    return cg_push_bytes(next, leb);
}

pub fn wasm_codegen_emit_i32_const(cg: WasmCodeGen, val: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_i32_const());
    let leb: List[Int] = wasm_binary_encode_i32_leb128(val);
    return cg_push_bytes(next, leb);
}

pub fn wasm_codegen_emit_i64_add(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, wasm_op_i64_add());
}

pub fn wasm_codegen_emit_i64_sub(cg: WasmCodeGen) -> WasmCodeGen {
