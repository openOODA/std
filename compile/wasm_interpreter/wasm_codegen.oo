pub fn wasm_codegen_emit_local_get(cg: WasmCodeGen, idx: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_local_get());
    let leb: List[Int] = wasm_binary_encode_u32_leb128(idx);
    return cg_push_bytes(next, leb);
}

pub fn wasm_codegen_emit_local_set(cg: WasmCodeGen, idx: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_local_set());
    let leb: List[Int] = wasm_binary_encode_u32_leb128(idx);
    return cg_push_bytes(next, leb);
}

pub fn wasm_codegen_emit_local_tee(cg: WasmCodeGen, idx: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_local_tee());
    let leb: List[Int] = wasm_binary_encode_u32_leb128(idx);
    return cg_push_bytes(next, leb);
}

pub fn wasm_codegen_emit_i32_load(cg: WasmCodeGen, align: Int, offset: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_i32_load());
    next = cg_push_bytes(next, wasm_binary_encode_u32_leb128(align));
    return cg_push_bytes(next, wasm_binary_encode_u32_leb128(offset));
}

pub fn wasm_codegen_emit_i64_load(cg: WasmCodeGen, align: Int, offset: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_i64_load());
    next = cg_push_bytes(next, wasm_binary_encode_u32_leb128(align));
    return cg_push_bytes(next, wasm_binary_encode_u32_leb128(offset));
}

pub fn wasm_codegen_emit_i32_store(cg: WasmCodeGen, align: Int, offset: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_i32_store());
    next = cg_push_bytes(next, wasm_binary_encode_u32_leb128(align));
    return cg_push_bytes(next, wasm_binary_encode_u32_leb128(offset));
