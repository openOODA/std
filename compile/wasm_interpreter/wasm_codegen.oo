pub fn wasm_codegen_emit_i64_store(cg: WasmCodeGen, align: Int, offset: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_i64_store());
    next = cg_push_bytes(next, wasm_binary_encode_u32_leb128(align));
    return cg_push_bytes(next, wasm_binary_encode_u32_leb128(offset));
}

pub fn wasm_codegen_emit_block(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, wasm_op_block());
}

pub fn wasm_codegen_emit_loop(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, wasm_op_loop());
}

pub fn wasm_codegen_emit_if(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, wasm_op_if());
}

pub fn wasm_codegen_emit_else(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, wasm_op_else());
}

pub fn wasm_codegen_emit_end(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, wasm_op_end());
}

pub fn wasm_codegen_emit_br(cg: WasmCodeGen, label_idx: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_br());
    let leb: List[Int] = wasm_binary_encode_u32_leb128(label_idx);
    return cg_push_bytes(next, leb);
}

pub fn wasm_codegen_emit_br_if(cg: WasmCodeGen, label_idx: Int) -> WasmCodeGen {
    let mut next: WasmCodeGen = cg_push_byte(cg, wasm_op_br_if());
    let leb: List[Int] = wasm_binary_encode_u32_leb128(label_idx);
    return cg_push_bytes(next, leb);
}

pub fn wasm_codegen_emit_return(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, wasm_op_return());
}

pub fn wasm_codegen_emit_drop(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, wasm_op_drop());
}

pub fn wasm_codegen_emit_nop(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, wasm_op_nop());
}

pub fn wasm_codegen_emit_block_type(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, 64);
}

pub fn wasm_codegen_to_code_bytes(cg: WasmCodeGen) -> List[Int] {
    return cg.code_bytes;
}

pub fn wasm_codegen_build_function_body(cg: WasmCodeGen) -> List[Int] {
    let mut out: List[Int] = list_new();
    let local_n: Int = list_len(cg.locals);
    if local_n == 0 {
        out = list_push(out, 0);
    } else {
        out = list_push(out, 1);
        out = list_push(out, local_n & 255);
        out = list_push(out, 127);
    }
    let n: Int = list_len(cg.code_bytes);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(cg.code_bytes, i));
        i = i + 1;
    }
    out = list_push(out, 11);
    return out;
}
pub fn wasm_codegen_emit_i32_mul(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte(cg, 108);
}
