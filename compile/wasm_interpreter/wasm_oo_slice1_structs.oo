// # .oo Source Compiler for slice1: Struct Support
//
// Logline: Struct type tracking, struct literal lowering, and field-access lowering. The S1CC carries three parallel int lists: struct_name_ids (interned string ids, one per declared type), struct_field_name_ids (interned string ids, flat across all structs), and struct_field_starts (start index in field_name_ids for each struct). Field types are encoded as s1_rt_int/string/bool (1/2/3).
//
// Setup: import compile, types, and str modules.
//
// Beats:
//   1. Map primitive type names to runtime types.
//   2. Intern struct names and record field identifiers.
//   3. Parse struct definitions and register layouts.
//   4. Lower struct field accesses and mutations.

import "std/compile/wasm_interpreter/wasm_oo_slice1_compile.oo";
import "std/compile/wasm_interpreter/wasm_oo_slice1_types.oo";
import "std/core/str.oo";

pub fn s1_type_to_rt(name: String) -> Int {
    if name == "Int" { return 1; }
    if name == "String" { return 2; }
    if name == "Bool" { return 3; }
    if name == "List" { return 10; }
    return 0;
}

pub fn s1_intern_or_add(s: S1CC, name: String) -> S1CC {
    let n: Int = wasm_host_intern_count(s.rt);
    let mut i: Int = 0;
    while i < n {
        if wasm_host_get_string(s.rt, i) == name { return s; }
        i = i + 1;
    }
    return s1cc_setrt(s, wasm_host_intern(s.rt, name));
}

pub fn s1_lookup_string_id(rt: WasmHostRuntime, name: String) -> Int {
    let n: Int = wasm_host_intern_count(rt);
    let mut i: Int = 0;
    while i < n {
        if wasm_host_get_string(rt, i) == name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn s1cc_add_struct_def(s: S1CC, name: String) -> S1CC {
    let s1: S1CC = s1_intern_or_add(s, name);
    let nid: Int = s1_lookup_string_id(s1.rt, name);
    let new_ids: List[Int] = list_push(s1.struct_name_ids, nid);
    let new_starts: List[Int] = list_push(s1.struct_field_starts, list_len(s1.struct_field_name_ids));
    return S1CC {
        kinds: s1.kinds, texts: s1.texts, pos: s1.pos, code: s1.code,
        rt: s1.rt, locals: s1.locals, fns: s1.fns, fns_count: s1.fns_count,
        errs: s1.errs, last_ret: s1.last_ret, local_types: s1.local_types,
        struct_name_ids: new_ids, struct_field_name_ids: s1.struct_field_name_ids,
        struct_field_starts: new_starts, local_struct_ids: s1.local_struct_ids,
        last_struct_id: s1.last_struct_id, struct_field_types: s1.struct_field_types
    };
}

pub fn s1cc_append_field_typed(s: S1CC, fname: String, ftype: Int) -> S1CC {
    let s1: S1CC = s1_intern_or_add(s, fname);
    let fid: Int = s1_lookup_string_id(s1.rt, fname);
    let new_fields: List[Int] = list_push(s1.struct_field_name_ids, fid);
    let new_types: List[Int] = list_push(s1.struct_field_types, ftype);
    return S1CC {
        kinds: s1.kinds, texts: s1.texts, pos: s1.pos, code: s1.code,
        rt: s1.rt, locals: s1.locals, fns: s1.fns, fns_count: s1.fns_count,
        errs: s1.errs, last_ret: s1.last_ret, local_types: s1.local_types,
        struct_name_ids: s1.struct_name_ids, struct_field_name_ids: new_fields,
        struct_field_starts: s1.struct_field_starts, local_struct_ids: s1.local_struct_ids,
        last_struct_id: s1.last_struct_id, struct_field_types: new_types
    };
}

pub fn s1cc_lookup_struct(s: S1CC, name: String) -> Int {
    let nid: Int = s1_lookup_string_id(s.rt, name);
    if nid < 0 { return 0 - 1; }
    let n: Int = list_len(s.struct_name_ids);
    let mut i: Int = 0;
    while i < n {
        if list_get(s.struct_name_ids, i) == nid { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn s1cc_struct_field_count(s: S1CC, struct_idx: Int) -> Int {
    let n: Int = list_len(s.struct_name_ids);
    let start: Int = list_get(s.struct_field_starts, struct_idx);
    let next_start: Int = if struct_idx + 1 < n { list_get(s.struct_field_starts, struct_idx + 1) } else { list_len(s.struct_field_name_ids) };
    return next_start - start;
}

pub fn s1cc_struct_field_idx(s: S1CC, struct_idx: Int, fname: String) -> Int {
    let fid: Int = s1_lookup_string_id(s.rt, fname);
    if fid < 0 { return 0 - 1; }
    let start: Int = list_get(s.struct_field_starts, struct_idx);
    let fc: Int = s1cc_struct_field_count(s, struct_idx);
    let mut i: Int = 0;
    while i < fc {
        if list_get(s.struct_field_name_ids, start + i) == fid { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn s1cc_struct_field_type(s: S1CC, struct_idx: Int, fidx: Int) -> Int {
    let start: Int = list_get(s.struct_field_starts, struct_idx);
    return list_get(s.struct_field_types, start + fidx);
}

pub fn s1_top_level_is_struct_decl(s: S1CC) -> Bool {
    if s1cc_t(s) == "type" { return true; }
    if s1cc_t(s) == "pub" {
        let s2: S1CC = s1cc_adv(s);
        if s1cc_t(s2) == "type" { return true; }
    }
    return false;
}

pub fn s1_parse_struct_decl(s: S1CC) -> S1CC {
    let mut cur: S1CC = s;
    if s1cc_t(cur) == "pub" { cur = s1cc_adv(cur); }
    if s1cc_t(cur) != "type" { return cur; }
    cur = s1cc_adv(cur);
    let name: String = s1cc_t(cur);
    cur = s1cc_adv(cur);
    if s1cc_t(cur) != "=" { return s1cc_err(cur, "ERR\tcompile\tsyntax_error\tstruct_decl_expected_equals"); }
    cur = s1cc_adv(cur);
    if s1cc_t(cur) != "struct" { return s1cc_err(cur, "ERR\tcompile\tsyntax_error\tstruct_decl_expected_struct"); }
    cur = s1cc_adv(cur);
    if s1cc_t(cur) != "{" { return s1cc_err(cur, "ERR\tcompile\tsyntax_error\tstruct_decl_expected_lbrace"); }
    cur = s1cc_adv(cur);
    let mut s2: S1CC = s1cc_add_struct_def(cur, name);
    while s1cc_t(s2) != "}" {
        let fname: String = s1cc_t(s2);
        s2 = s1cc_adv(s2);
        if s1cc_t(s2) != ":" { return s1cc_err(s2, "ERR\tcompile\tsyntax_error\tstruct_field_expected_colon"); }
        s2 = s1cc_adv(s2);
        let ftype_name: String = s1cc_t(s2);
        let ftype: Int = s1_parse_param_type(ftype_name);
        s2 = s1cc_adv(s2);
        s2 = s1cc_append_field_typed(s2, fname, ftype);
        if s1cc_t(s2) == "," { s2 = s1cc_adv(s2); }
    }
    s2 = s1cc_adv(s2);
    if s1cc_t(s2) != ";" { return s1cc_err(s2, "ERR\tcompile\tsyntax_error\tstruct_decl_expected_semi"); }
    s2 = s1cc_adv(s2);
    return s2;
}

pub fn s1_field_name_exists(s: S1CC, fname: String) -> Bool {
    let nf: Int = list_len(s.struct_field_name_ids);
    let mut i: Int = 0;
    while i < nf {
        let fid: Int = list_get(s.struct_field_name_ids, i);
        if wasm_host_get_string(s.rt, fid) == fname { return true; }
        i = i + 1;
    }
    return false;
}

pub fn s1_lower_field_access(s: S1CC, recv_idx: Int, total_user_count: Int) -> S1CC {
    let s_recv: S1CC = s1cc_emit_get(s, recv_idx);
    let s_dot: S1CC = s1cc_adv(s_recv);
    let s_fname: S1CC = s1cc_adv(s_dot);
    let fname: String = s1cc_t(s_fname);
    let s_after: S1CC = s1cc_adv(s_fname);
    let recv_sid: Int = if recv_idx >= 0 && recv_idx < list_len(s.local_struct_ids) { list_get(s.local_struct_ids, recv_idx) } else { 0 - 1 };
    if recv_sid >= 0 {
        let fidx: Int = s1cc_struct_field_idx(s_after, recv_sid, fname);
        if fidx < 0 {
            let err_msg: String = "ERR\tcompile\tunknown_field_for_struct\t" + fname;
            return s1cc_err(s_after, err_msg);
        }
        let s_push: S1CC = s1cc_emit_i32(s_after, fidx);
        let s_call: S1CC = s1cc_emit_call(s_push, total_user_count + 17);
        let ftype: Int = s1cc_struct_field_type(s_after, recv_sid, fidx);
        return s1cc_setret(s_call, ftype);
    }
    if !s1_field_name_exists(s_after, fname) {
        let err_msg: String = "ERR\tcompile\tunknown_field\t?\t" + fname;
        return s1cc_err(s_after, err_msg);
    }
    let err_msg2: String = "ERR\tcompile\tfield_on_non_struct\t" + fname;
    return s1cc_err(s_after, err_msg2);
}
