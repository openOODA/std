// # .oo Source Compiler for slice1: Program-Level Helpers
//
// Logline: Program-walking utilities: skip `import "...";` lines, count function arities, skip past a function body, count user-defined functions, and emit the canonical host-name list. Used by s1_compile_program to drive the 2-pass lowering (count user fns first, then lower with correct host call offsets).
//
// Setup: Pure .oo. No state — these helpers are pure functions over S1CC and strings.
//
// Beats:
//   1. Skip import declarations and parse top-level function headers.
//   2. Compute arities and build canonical host name lookup tables.

import "std/compile/wasm_interpreter/wasm_oo_slice1_compile.oo";

pub fn s1cc_skip_import(s: S1CC) -> S1CC {
    let mut cur: S1CC = s;
    while !s1cc_end(cur) && s1cc_t(cur) != ";" { cur = s1cc_adv(cur); }
    if !s1cc_end(cur) { cur = s1cc_adv(cur); }
    return cur;
}

pub fn s1_count_arity(s: S1CC) -> Int {
    let mut cur: S1CC = s;
    let mut arity: Int = 0;
    if s1cc_t(cur) == "pub" { cur = s1cc_adv(cur); }
    if s1cc_t(cur) == "fn" { cur = s1cc_adv(cur); }
    cur = s1cc_adv(cur);
    if s1cc_t(cur) == "(" { cur = s1cc_adv(cur); }
    while !s1cc_end(cur) && s1cc_t(cur) != ")" {
        if s1cc_match(cur, 5, "") { arity = arity + 1; }
        cur = s1cc_adv(cur);
        if s1cc_t(cur) == "," { cur = s1cc_adv(cur); }
    }
    return arity;
}

pub fn s1_wrap_body_with_locals(code: List[Int], locals_n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    if locals_n == 0 {
        out = list_push(out, 0);
    } else {
        out = list_push(out, 1);
        out = list_push(out, locals_n & 255);
        out = list_push(out, 127);
    }
    let n: Int = list_len(code);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(code, i));
        i = i + 1;
    }
    return out;
}

pub fn s1_count_functions(s: S1CC) -> Int {
    let mut cur: S1CC = s;
    let mut count: Int = 0;
    while !s1cc_end(cur) {
        if s1cc_t(cur) == "import" {
            cur = s1cc_skip_import(cur);
        } else if s1cc_t(cur) == "pub" || s1cc_t(cur) == "fn" {
            count = count + 1;
            cur = s1_skip_past_function(cur);
        } else { cur = s1cc_adv(cur); }
    }
    return count;
}

pub fn s1_skip_past_function(s: S1CC) -> S1CC {
    let mut cur: S1CC = s;
    if s1cc_t(cur) == "pub" { cur = s1cc_adv(cur); }
    if s1cc_t(cur) == "fn" { cur = s1cc_adv(cur); }
    cur = s1cc_adv(cur);
    if s1cc_t(cur) == "(" { cur = s1cc_adv(cur); }
    let mut pd: Bool = false;
    while !pd {
        if s1cc_end(cur) { pd = true; }
        else if s1cc_t(cur) == ")" { pd = true; cur = s1cc_adv(cur); }
        else { cur = s1cc_adv(cur); }
    }
    while !s1cc_end(cur) && s1cc_t(cur) != "{" { cur = s1cc_adv(cur); }
    if s1cc_t(cur) == "{" { cur = s1cc_adv(cur); }
    let mut depth: Int = 1;
    while !s1cc_end(cur) && depth > 0 {
        if s1cc_t(cur) == "{" { depth = depth + 1; }
        if s1cc_t(cur) == "}" { depth = depth - 1; }
        cur = s1cc_adv(cur);
    }
    return cur;
}

pub fn s1_host_name_list() -> List[String] {
    let mut hn: List[String] = list_new();
    hn = list_push(hn, "list_new");
    hn = list_push(hn, "list_push");
    hn = list_push(hn, "list_first");
    hn = list_push(hn, "list_last");
    hn = list_push(hn, "list_length");
    hn = list_push(hn, "byte_in_range");
    hn = list_push(hn, "parse_int");
    hn = list_push(hn, "int_to_string");
    hn = list_push(hn, "string_concat");
    hn = list_push(hn, "string_contains");
    hn = list_push(hn, "result_is_ok");
    hn = list_push(hn, "result_unwrap_int");
    hn = list_push(hn, "result_unwrap_str");
    hn = list_push(hn, "println");
    hn = list_push(hn, "process_exit");
    hn = list_push(hn, "struct_new");
    hn = list_push(hn, "struct_set");
    hn = list_push(hn, "struct_get");
    return hn;
}
