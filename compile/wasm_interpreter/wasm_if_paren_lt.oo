// # Const if (1 < 2) println
//
// Logline: Print plt-then when the condition is (1 < 2).
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If (1 < 2) print plt-then else print plt-else.
//   3. Leave no other statements.

pub fn verify_wasm_if_paren_lt() -> Bool {
    if (1 < 2) {
        println("plt-then");
    } else {
        println("plt-else");
    }
    return true;
}
