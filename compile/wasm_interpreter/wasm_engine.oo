// # WebAssembly Core Execution Engine
//
// Logline: Stack-based bytecode virtual machine executing WebAssembly instruction sequences with memory and locals.
//
// Setup: Pure interpreter engine executing integer arithmetic, bitwise logic, and local storage.
//
// Beats:
//   1. Initialize VM instance with operand stack and local variable storage.
//   2. Step instruction stream decoding opcodes and updating stack state.
//   3. Handle arithmetic binary operations with division-by-zero checks.
//   4. Return final evaluation result or fail closed on traps.

import "std/compile/wasm_interpreter/wasm_stack.oo";
import "std/compile/wasm_interpreter/wasm_opcodes.oo";

type WasmEngine = struct {
    stack: WasmStack,
    locals: List[Int],
    pc: Int,
    is_halted: Bool
};

pub fn wasm_engine_new(max_stack_depth: Int, num_locals: Int) -> Result[WasmEngine, String] {
    let r_st: Result[WasmStack, String] = wasm_stack_new(max_stack_depth);
    match r_st {
        Ok(st) => {
            let mut locs: List[Int] = list_new();
            let mut i: Int = 0;
            while i < num_locals {
                locs = list_push(locs, 0);
                i = i + 1;
            }
            let eng: WasmEngine = WasmEngine {
                stack: st,
                locals: locs,
                pc: 0,
                is_halted: false
            };
            return Ok(eng);
        }
        Err(e) => {
            return Err(e);
        }
    }
}

pub fn wasm_engine_set_local(eng: WasmEngine, idx: Int, val: Int) -> Result[WasmEngine, String] {
    let n: Int = list_len(eng.locals);
    if idx < 0 || idx >= n {
        return Err("ERR\twasm_engine_set_local\tindex_out_of_bounds");
    }
    let mut updated: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            updated = list_push(updated, val);
        } else {
            updated = list_push(updated, list_get(eng.locals, i));
        }
        i = i + 1;
    }
    let next_eng: WasmEngine = WasmEngine {
        stack: eng.stack,
        locals: updated,
        pc: eng.pc,
        is_halted: eng.is_halted
    };
    return Ok(next_eng);
}

pub fn wasm_engine_eval_binary_op(st: WasmStack, op: Int) -> Result[WasmStack, String] {
    let r_b: Result[WasmPopResult, String] = wasm_stack_pop(st);
    match r_b {
        Ok(res_b)         => {
            let b_val: Int = res_b.val;
            let r_a: Result[WasmPopResult, String] = wasm_stack_pop(res_b.stack);
            match r_a {
                Ok(res_a) => {
                    let a_val: Int = res_a.val;
                    let mut res_val: Int = 0;
                    if op == wasm_op_i32_add() {
                        res_val = a_val + b_val;
                    } else if op == wasm_op_i32_sub() {
                        res_val = a_val - b_val;
                    } else if op == wasm_op_i32_mul() {
                        res_val = a_val * b_val;
                    } else if op == wasm_op_i32_div_s() {
                        if b_val == 0 {
                            return Err("ERR\twasm_trap_integer_divide_by_zero");
                        }
                        res_val = a_val / b_val;
                    } else if op == wasm_op_i32_and() {
                        res_val = a_val & b_val;
                    } else if op == wasm_op_i32_or() {
                        res_val = a_val | b_val;
                    } else if op == wasm_op_i32_xor() {
                        res_val = a_val ^ b_val;
                    } else if op == wasm_op_i32_eq() {
                        if a_val == b_val { res_val = 1; } else { res_val = 0; }
                    } else if op == wasm_op_i32_lt_s() {
                        if a_val < b_val { res_val = 1; } else { res_val = 0; }
                    } else {
                        return Err("ERR\twasm_unknown_binary_op");
                    }
                    return wasm_stack_push(res_a.stack, res_val);
                }
                Err(ea) => { return Err(ea); }
            }
        }
        Err(eb) => { return Err(eb); }
    }
}
