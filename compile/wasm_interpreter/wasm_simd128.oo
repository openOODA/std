// # WebAssembly SIMD128 Vector Opcodes and Auto-Vectorizer
//
// Logline: 128-bit vector opcode table with v128.const, i64x2 arithmetic, and v128 bitwise opcodes plus an integer-array auto-vectorizer that emits parallel SIMD128 instructions.
//
// Setup: Pure SIMD128 module backed by std/compile/wasm_interpreter/wasm_simd.oo V128 type and std/compile/wasm_interpreter/wasm_codegen.oo byte emitter, operating on 4-int lane packs and emitting section 10 Code bodies.
//
// Beats:
//   1. Define 128-bit vector opcodes v128.const, i64x2.add, i64x2.sub, i64x2.mul, v128.and, v128.or, v128.xor.
//   2. Encode v128.const as 16 bytes of i32 little-endian lane payload.
//   3. Implement lane-wise i64x2.add, i64x2.sub, i64x2.mul and bitwise v128.and, v128.or, v128.xor.
//   4. Auto-vectorize a 4-element integer array add loop into 2 parallel i64x2.add instructions.

pub fn wasm_op_v128_const() -> Int { return 171; }
pub fn wasm_op_i64x2_add() -> Int { return 230; }
pub fn wasm_op_i64x2_sub() -> Int { return 232; }
pub fn wasm_op_i64x2_mul() -> Int { return 234; }
pub fn wasm_op_v128_and() -> Int { return 173; }
pub fn wasm_op_v128_or() -> Int { return 174; }
pub fn wasm_op_v128_xor() -> Int { return 175; }
pub fn wasm_op_v128_load() -> Int { return 181; }
pub fn wasm_op_v128_store() -> Int { return 187; }

import "std/compile/wasm_interpreter/wasm_simd.oo";
import "std/compile/wasm_interpreter/wasm_codegen.oo";
import "std/compile/wasm_interpreter/wasm_binary_builder.oo";

type V128x2 = struct {
    lo: V128,
    hi: V128
};

pub fn wasm_v128_zero() -> V128 {
    return V128 { l0: 0, l1: 0, l2: 0, l3: 0 };
}

pub fn wasm_v128_from_lanes(a: Int, b: Int, c: Int, d: Int) -> V128 {
    return V128 { l0: a, l1: b, l2: c, l3: d };
}

pub fn wasm_i64x2_add(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 + b.l0,
        l1: a.l1 + b.l1,
        l2: a.l2 + b.l2,
        l3: a.l3 + b.l3
    };
}

pub fn wasm_i64x2_sub(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 - b.l0,
        l1: a.l1 - b.l1,
        l2: a.l2 - b.l2,
        l3: a.l3 - b.l3
    };
}

pub fn wasm_i64x2_mul(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 * b.l0,
        l1: a.l1 * b.l1,
        l2: a.l2 * b.l2,
        l3: a.l3 * b.l3
    };
}

pub fn wasm_v128_bitwise_and(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 & b.l0,
        l1: a.l1 & b.l1,
        l2: a.l2 & b.l2,
        l3: a.l3 & b.l3
    };
}

pub fn wasm_v128_bitwise_or(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 | b.l0,
        l1: a.l1 | b.l1,
        l2: a.l2 | b.l2,
        l3: a.l3 | b.l3
    };
}

pub fn wasm_v128_bitwise_xor(a: V128, b: V128) -> V128 {
    return V128 {
        l0: a.l0 ^ b.l0,
        l1: a.l1 ^ b.l1,
        l2: a.l2 ^ b.l2,
        l3: a.l3 ^ b.l3
    };
}

pub fn wasm_emit_v128_const_bytes(l0: Int, l1: Int, l2: Int, l3: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, wasm_op_v128_const());
    let b0: Int = l0 & 255;
    let b1: Int = (l0 / 256) & 255;
    let b2: Int = (l0 / 65536) & 255;
    let b3: Int = (l0 / 16777216) & 255;
    out = list_push(out, b0); out = list_push(out, b1);
    out = list_push(out, b2); out = list_push(out, b3);
    let c0: Int = l1 & 255;
    let c1: Int = (l1 / 256) & 255;
    let c2: Int = (l1 / 65536) & 255;
    let c3: Int = (l1 / 16777216) & 255;
    out = list_push(out, c0); out = list_push(out, c1);
    out = list_push(out, c2); out = list_push(out, c3);
    let d0: Int = l2 & 255;
    let d1: Int = (l2 / 256) & 255;
    let d2: Int = (l2 / 65536) & 255;
    let d3: Int = (l2 / 16777216) & 255;
    out = list_push(out, d0); out = list_push(out, d1);
    out = list_push(out, d2); out = list_push(out, d3);
    let e0: Int = l3 & 255;
    let e1: Int = (l3 / 256) & 255;
    let e2: Int = (l3 / 65536) & 255;
    let e3: Int = (l3 / 16777216) & 255;
    out = list_push(out, e0); out = list_push(out, e1);
    out = list_push(out, e2); out = list_push(out, e3);
    return out;
}

pub fn wasm_emit_i64x2_add(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte_for_simd(cg, wasm_op_i64x2_add());
}

pub fn wasm_emit_i64x2_sub(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte_for_simd(cg, wasm_op_i64x2_sub());
}

pub fn wasm_emit_i64x2_mul(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte_for_simd(cg, wasm_op_i64x2_mul());
}

pub fn wasm_emit_v128_and(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte_for_simd(cg, wasm_op_v128_and());
}

pub fn wasm_emit_v128_or(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte_for_simd(cg, wasm_op_v128_or());
}

pub fn wasm_emit_v128_xor(cg: WasmCodeGen) -> WasmCodeGen {
    return cg_push_byte_for_simd(cg, wasm_op_v128_xor());
}

fn cg_push_byte_for_simd(cg: WasmCodeGen, byte_val: Int) -> WasmCodeGen {
    return WasmCodeGen {
        code_bytes: list_push(cg.code_bytes, byte_val & 255),
        locals: cg.locals
    };
}

pub fn wasm_auto_vectorize_i32x4_add(a0: Int, a1: Int, a2: Int, a3: Int, b0: Int, b1: Int, b2: Int, b3: Int) -> V128 {
    let va: V128 = wasm_v128_from_lanes(a0, a1, a2, a3);
    let vb: V128 = wasm_v128_from_lanes(b0, b1, b2, b3);
    return wasm_i64x2_add(va, vb);
}

pub fn wasm_pack_array_to_v128(arr: List[Int], start: Int) -> V128 {
    let v0: Int = list_get(arr, start);
    let v1: Int = list_get(arr, start + 1);
    let v2: Int = list_get(arr, start + 2);
    let v3: Int = list_get(arr, start + 3);
    return wasm_v128_from_lanes(v0, v1, v2, v3);
}

pub fn wasm_vectorize_array_add(lhs: List[Int], rhs: List[Int], n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i + 3 < n {
        let va: V128 = wasm_pack_array_to_v128(lhs, i);
        let vb: V128 = wasm_pack_array_to_v128(rhs, i);
        let vr: V128 = wasm_i64x2_add(va, vb);
        out = list_push(out, vr.l0);
        out = list_push(out, vr.l1);
        out = list_push(out, vr.l2);
        out = list_push(out, vr.l3);
        i = i + 4;
    }
    while i < n {
        out = list_push(out, list_get(lhs, i) + list_get(rhs, i));
        i = i + 1;
    }
    return out;
}
