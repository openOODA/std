// # Hostile if 1!=x || 3!=3 no-else fold
//
// Logline: Print fold-me from if 1!=x || 3!=3 with no else so emit-wasm must miss a const-neq-or no-else fold.
//
// Setup: One public main. Left compare right operand is IDENT x.
//
// Beats:
//   1. Let x be 2.
//   2. If 1!=x || 3!=3 print fold-me.
//   3. A fold-me-only module is a lie.

pub fn verify_wasm_if_neq_or_noelse_hostile() -> Bool {
    let x = 2;
    if 1 != x || 3 != 3 {
        println("fold-me");
    }
    return true;
}
