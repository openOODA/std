// # Const integer sub println
//
// Logline: Print 9 - 4 so emit-wasm can plant a WASI fd_write body of 5.
//
// Setup: No imports. One public main. The body is only println of two INT literals minus.
//
// Beats:
//   1. Declare public main.
//   2. Print 9 - 4.
//   3. Leave no other statements.

pub fn verify_wasm_sub_lit() -> Bool { println(9 - 4);     return true;
}
