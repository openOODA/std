// # WebAssembly Host Function Runtime: State
//
// Logline: Stateful storage for the WasmHostRuntime. Avoids List[List[Int]] (which the OODA C codegen cannot represent) by storing all list elements in a single flat List[Int] and tracking each list's start offset in a separate List[Int].
//
// Setup: Pure .oo runtime. Each "list handle" is an index into list_starts. The data for list N is list_data[list_starts[N]..list_starts[N+1]].
//
// Beats:
//   1. Define WasmHostRuntime and the PairRuntimeInt return type for (new runtime, value).
//   2. Intern/lookup strings, alloc/lookup results, append/read print log, set/get exit code.
//   3. Alloc list (returns new handle, appends offset to list_starts), get list data, list count.
//   4. wasm_host_arity maps a function name to its parameter count.
//   5. wasm_host_dispatch extracts just the value for the engine (implementations live in wasm_host_runtime_call.oo).

import "std/core/str.oo";

type WasmHostRuntime = struct {
    strings: List[String],
    list_data: List[Int],
    list_starts: List[Int],
    res_tags: List[Int],
    res_payloads: List[Int],
    struct_data: List[Int],
    struct_starts: List[Int],
    struct_field_counts: List[Int],
    print_log: List[String],
    exit_code: Int
};

type PairRuntimeInt = struct {
    rt: WasmHostRuntime,
    value: Int
};

pub fn wasm_host_runtime_new() -> WasmHostRuntime {
    let empty_s: List[String] = list_new();
    let empty_d: List[Int] = list_new();
    let empty_ls: List[Int] = list_new();
    let empty_rt: List[Int] = list_new();
    let empty_rp: List[Int] = list_new();
    let empty_sd: List[Int] = list_new();
    let empty_ss: List[Int] = list_new();
    let empty_sfc: List[Int] = list_new();
    let empty_pl: List[String] = list_new();
    return WasmHostRuntime {
        strings: empty_s,
        list_data: empty_d,
        list_starts: empty_ls,
        res_tags: empty_rt,
        res_payloads: empty_rp,
        struct_data: empty_sd,
        struct_starts: empty_ss,
        struct_field_counts: empty_sfc,
        print_log: empty_pl,
        exit_code: 0
    };
}

pub fn wasm_host_intern(rt: WasmHostRuntime, s: String) -> WasmHostRuntime {
    return WasmHostRuntime {
        strings: list_push(rt.strings, s),
        list_data: rt.list_data,
        list_starts: rt.list_starts,
        res_tags: rt.res_tags,
        res_payloads: rt.res_payloads,
        struct_data: rt.struct_data,
        struct_starts: rt.struct_starts,
        struct_field_counts: rt.struct_field_counts,
        print_log: rt.print_log,
        exit_code: rt.exit_code
    };
}

pub fn wasm_host_intern_count(rt: WasmHostRuntime) -> Int {
    return list_len(rt.strings);
}

pub fn wasm_host_get_string(rt: WasmHostRuntime, idx: Int) -> String {
    return list_get(rt.strings, idx);
}

pub fn wasm_host_alloc_list(rt: WasmHostRuntime) -> WasmHostRuntime {
    let new_starts: List[Int] = list_push(rt.list_starts, list_len(rt.list_data));
    return WasmHostRuntime {
        strings: rt.strings,
        list_data: rt.list_data,
        list_starts: new_starts,
        res_tags: rt.res_tags,
        res_payloads: rt.res_payloads,
        struct_data: rt.struct_data,
        struct_starts: rt.struct_starts,
        struct_field_counts: rt.struct_field_counts,
        print_log: rt.print_log,
        exit_code: rt.exit_code
    };
}

pub fn wasm_host_list_count(rt: WasmHostRuntime) -> Int {
    return list_len(rt.list_starts);
}

pub fn wasm_host_list_start(rt: WasmHostRuntime, idx: Int) -> Int {
    return list_get(rt.list_starts, idx);
}

pub fn wasm_host_list_data(rt: WasmHostRuntime) -> List[Int] {
    return rt.list_data;
}

pub fn wasm_host_push_list_data(rt: WasmHostRuntime, val: Int) -> WasmHostRuntime {
    return WasmHostRuntime {
        strings: rt.strings,
        list_data: list_push(rt.list_data, val),
        list_starts: rt.list_starts,
        res_tags: rt.res_tags,
        res_payloads: rt.res_payloads,
        struct_data: rt.struct_data,
        struct_starts: rt.struct_starts,
        struct_field_counts: rt.struct_field_counts,
        print_log: rt.print_log,
        exit_code: rt.exit_code
    };
}

pub fn wasm_host_alloc_result(rt: WasmHostRuntime, tag: Int, payload: Int) -> WasmHostRuntime {
    return WasmHostRuntime {
        strings: rt.strings,
        list_data: rt.list_data,
        list_starts: rt.list_starts,
        res_tags: list_push(rt.res_tags, tag),
        res_payloads: list_push(rt.res_payloads, payload),
        struct_data: rt.struct_data,
        struct_starts: rt.struct_starts,
        struct_field_counts: rt.struct_field_counts,
        print_log: rt.print_log,
        exit_code: rt.exit_code
    };
}

pub fn wasm_host_result_tag(rt: WasmHostRuntime, idx: Int) -> Int {
    return list_get(rt.res_tags, idx);
}

pub fn wasm_host_result_payload(rt: WasmHostRuntime, idx: Int) -> Int {
    return list_get(rt.res_payloads, idx);
}

pub fn wasm_host_result_count(rt: WasmHostRuntime) -> Int {
    return list_len(rt.res_tags);
}

pub fn wasm_host_append_print(rt: WasmHostRuntime, s: String) -> WasmHostRuntime {
    return WasmHostRuntime {
        strings: rt.strings,
        list_data: rt.list_data,
        list_starts: rt.list_starts,
        res_tags: rt.res_tags,
        res_payloads: rt.res_payloads,
        struct_data: rt.struct_data,
        struct_starts: rt.struct_starts,
        struct_field_counts: rt.struct_field_counts,
        print_log: list_push(rt.print_log, s),
        exit_code: rt.exit_code
    };
}

pub fn wasm_host_get_print_log(rt: WasmHostRuntime) -> List[String] {
    return rt.print_log;
}

pub fn wasm_host_set_exit_code(rt: WasmHostRuntime, code: Int) -> WasmHostRuntime {
    return WasmHostRuntime {
        strings: rt.strings,
        list_data: rt.list_data,
        list_starts: rt.list_starts,
        res_tags: rt.res_tags,
        res_payloads: rt.res_payloads,
        struct_data: rt.struct_data,
        struct_starts: rt.struct_starts,
        struct_field_counts: rt.struct_field_counts,
        print_log: rt.print_log,
        exit_code: code
    };
}

pub fn wasm_host_get_exit_code(rt: WasmHostRuntime) -> Int {
    return rt.exit_code;
}

pub fn wasm_host_arity(name: String) -> Int {
    if name == "list_new" { return 0; }
    if name == "list_push" { return 2; }
    if name == "list_first" { return 1; }
    if name == "list_last" { return 1; }
    if name == "list_length" { return 1; }
    if name == "byte_in_range" { return 1; }
    if name == "parse_int" { return 1; }
    if name == "int_to_string" { return 1; }
    if name == "string_concat" { return 2; }
    if name == "string_contains" { return 2; }
    if name == "result_is_ok" { return 1; }
    if name == "result_unwrap_int" { return 1; }
    if name == "result_unwrap_str" { return 1; }
    if name == "println" { return 1; }
    if name == "process_exit" { return 1; }
    if name == "struct_new" { return 1; }
    if name == "struct_set" { return 3; }
    if name == "struct_get" { return 2; }
    return 0;
}

pub fn wasm_host_dispatch(rt: WasmHostRuntime, name: String, args: List[Int]) -> Result[Int, String] {
    let r: Result[PairRuntimeInt, String] = wasm_host_call(rt, name, args);
    if r.ok == 1 { return Ok((r.val).value); }
    return Err(r.err);
}
