// # Hostile if (true && x) no-else fold
//
// Logline: Print fold-me from if (true && x) with no else so emit-wasm must miss a const-paren-and no-else fold.
//
// Setup: One public main. Right operand is IDENT x.
//
// Beats:
//   1. Let x be true.
//   2. If (true && x) print fold-me.
//   3. A fold-me-only module is a lie.

pub fn verify_wasm_if_paren_and_noelse_hostile() -> Bool {
    let x = true;
    if (true && x) {
        println("fold-me");
    }
    return true;
}
