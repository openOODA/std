// # WebAssembly Host Runtime Struct Store
//
// Logline: Alloc, count, set, and get host-side struct handles in WasmHostRuntime.
//
// Setup: Imports wasm_host_runtime.oo. Used by wasm_host_runtime_call.oo.
//
// Beats:
//   1. wasm_host_alloc_struct appends a zeroed field block.
//   2. wasm_host_struct_set and wasm_host_struct_get index fields.

import "std/compile/wasm_interpreter/wasm_host_runtime.oo";

pub fn wasm_host_alloc_struct(rt: WasmHostRuntime, field_count: Int) -> WasmHostRuntime {
    let new_starts: List[Int] = list_push(rt.struct_starts, list_len(rt.struct_data));
    let new_counts: List[Int] = list_push(rt.struct_field_counts, field_count);
    let mut new_data: List[Int] = rt.struct_data;
    let mut i: Int = 0;
    while i < field_count {
        new_data = list_push(new_data, 0);
        i = i + 1;
    }
    return WasmHostRuntime {
        strings: rt.strings,
        list_data: rt.list_data,
        list_starts: rt.list_starts,
        res_tags: rt.res_tags,
        res_payloads: rt.res_payloads,
        struct_data: new_data,
        struct_starts: new_starts,
        struct_field_counts: new_counts,
        print_log: rt.print_log,
        exit_code: rt.exit_code
    };
}

pub fn wasm_host_struct_count(rt: WasmHostRuntime) -> Int {
    return list_len(rt.struct_starts);
}

pub fn wasm_host_struct_start(rt: WasmHostRuntime, idx: Int) -> Int {
    return list_get(rt.struct_starts, idx);
}

pub fn wasm_host_struct_field_count(rt: WasmHostRuntime, idx: Int) -> Int {
    return list_get(rt.struct_field_counts, idx);
}

pub fn wasm_host_struct_set(rt: WasmHostRuntime, handle: Int, field_idx: Int, value: Int) -> WasmHostRuntime {
    let start: Int = list_get(rt.struct_starts, handle);
    let pos: Int = start + field_idx;
    let mut new_data: List[Int] = list_new();
    let n: Int = list_len(rt.struct_data);
    let mut i: Int = 0;
    while i < n {
        if i == pos { new_data = list_push(new_data, value); }
        else { new_data = list_push(new_data, list_get(rt.struct_data, i)); }
        i = i + 1;
    }
    return WasmHostRuntime {
        strings: rt.strings,
        list_data: rt.list_data,
        list_starts: rt.list_starts,
        res_tags: rt.res_tags,
        res_payloads: rt.res_payloads,
        struct_data: new_data,
        struct_starts: rt.struct_starts,
        struct_field_counts: rt.struct_field_counts,
        print_log: rt.print_log,
        exit_code: rt.exit_code
    };
}

pub fn wasm_host_struct_get(rt: WasmHostRuntime, handle: Int, field_idx: Int) -> Int {
    let start: Int = list_get(rt.struct_starts, handle);
    let pos: Int = start + field_idx;
    return list_get(rt.struct_data, pos);
}

