// # WebAssembly Binary Treeshaker and Dead Code Stripper
//
// Logline: Build a dependency-graph reachability analyzer from main that treeshakes uncalled functions, unused type signatures, and dead data segments to produce minimal .wasm payloads.
//
// Setup: Pure stripper module operating on List[Int] function indices, type table, and data segment table to compute a reachability set and emit a stripped module marker.
//
// Beats:
//   1. Define a ModuleModule dependency graph: function table, type table, data segment table, and edge list.
//   2. Compute the transitive reachability set from a root function index using iterative worklist expansion.
//   3. Emit a stripped function index set and report the original versus stripped module size in bytes.
//   4. Strip unused data segments and unused type signatures, returning a stripped-module descriptor.

type WasmModuleGraph = struct {
    function_count: Int,
    type_count: Int,
    data_count: Int,
    function_calls: List[Int],
    function_types: List[Int],
    function_uses_data: List[Int]
};

pub fn wasm_module_graph_new(function_count: Int, type_count: Int, data_count: Int) -> WasmModuleGraph {
    return WasmModuleGraph {
        function_count: function_count,
        type_count: type_count,
        data_count: data_count,
        function_calls: list_new(),
        function_types: list_new(),
        function_uses_data: list_new()
    };
}

pub fn wasm_module_graph_function_count(g: WasmModuleGraph) -> Int {
    return g.function_count;
}

pub fn wasm_module_graph_type_count(g: WasmModuleGraph) -> Int {
    return g.type_count;
}

pub fn wasm_module_graph_data_count(g: WasmModuleGraph) -> Int {
    return g.data_count;
}

pub fn wasm_module_graph_add_call(g: WasmModuleGraph, caller: Int, callee: Int, type_idx: Int) -> WasmModuleGraph {
    let mut fc: List[Int] = g.function_calls;
    fc = list_push(fc, caller);
    fc = list_push(fc, callee);
    fc = list_push(fc, type_idx);
    let mut ft: List[Int] = g.function_types;
    while list_len(ft) <= caller {
        ft = list_push(ft, 0);
    }
    return WasmModuleGraph {
        function_count: g.function_count,
        type_count: g.type_count,
        data_count: g.data_count,
        function_calls: fc,
        function_types: ft,
        function_uses_data: g.function_uses_data
    };
}

pub fn wasm_module_graph_mark_uses_data(g: WasmModuleGraph, function_idx: Int, data_idx: Int) -> WasmModuleGraph {
    let mut ud: List[Int] = g.function_uses_data;
    ud = list_push(ud, function_idx);
    ud = list_push(ud, data_idx);
    return WasmModuleGraph {
        function_count: g.function_count,
        type_count: g.type_count,
        data_count: g.data_count,
        function_calls: g.function_calls,
        function_types: g.function_types,
        function_uses_data: ud
    };
}

pub fn wasm_reachability_compute(g: WasmModuleGraph, root: Int) -> List[Int] {
    let mut reached: List[Int] = list_new();
    let mut worklist: List[Int] = list_new();
    worklist = list_push(worklist, root);
    let mut safety: Int = 0;
    while list_len(worklist) > 0 && safety < 4096 {
        let last: Int = list_get(worklist, list_len(worklist) - 1);
        let mut new_worklist: List[Int] = list_new();
        let mut i: Int = 0;
        while i < list_len(worklist) - 1 {
            new_worklist = list_push(new_worklist, list_get(worklist, i));
            i = i + 1;
        }
        worklist = new_worklist;
        let already: Bool = list_contains_int(reached, last);
        if !already {
            reached = list_push(reached, last);
        }
        let n: Int = list_len(g.function_calls);
        let mut j: Int = 0;
        while j + 2 < n {
            let caller: Int = list_get(g.function_calls, j);
            if caller == last {
                let callee: Int = list_get(g.function_calls, j + 1);
                if !list_contains_int(reached, callee) && !list_contains_int(worklist, callee) {
                    worklist = list_push(worklist, callee);
                }
            }
            j = j + 3;
        }
        safety = safety + 1;
    }
    return reached;
}

fn list_contains_int(xs: List[Int], target: Int) -> Bool {
    let n: Int = list_len(xs);
    let mut i: Int = 0;
    while i < n {
        if list_get(xs, i) == target { return true; }
        i = i + 1;
    }
    return false;
}

type WasmStrippedModule = struct {
    reached_functions: List[Int],
    reached_types: List[Int],
    reached_data: List[Int],
    original_size: Int,
    stripped_size: Int
};

pub fn wasm_strip_module(g: WasmModuleGraph, root: Int) -> WasmStrippedModule {
    let reached: List[Int] = wasm_reachability_compute(g, root);
    let mut used_types: List[Int] = list_new();
    let rn: Int = list_len(reached);
    let mut i: Int = 0;
    while i < rn {
        let fn_idx: Int = list_get(reached, i);
        if fn_idx < list_len(g.function_types) {
            let t: Int = list_get(g.function_types, fn_idx);
            if !list_contains_int(used_types, t) {
                used_types = list_push(used_types, t);
            }
        }
        i = i + 1;
    }
    let mut used_data: List[Int] = list_new();
    let dn: Int = list_len(g.function_uses_data);
    let mut j: Int = 0;
    while j + 1 < dn {
        let fn_idx: Int = list_get(g.function_uses_data, j);
        let data_idx: Int = list_get(g.function_uses_data, j + 1);
        if list_contains_int(reached, fn_idx) {
            if !list_contains_int(used_data, data_idx) {
                used_data = list_push(used_data, data_idx);
            }
        }
        j = j + 2;
    }
    let total_fns: Int = g.function_count;
    let total_types: Int = g.type_count;
    let total_data: Int = g.data_count;
    let kept_fns: Int = list_len(reached);
    let kept_types: Int = list_len(used_types);
    let kept_data: Int = list_len(used_data);
    let original_size: Int = (total_fns * 64) + (total_types * 32) + (total_data * 128);
    let stripped_size: Int = (kept_fns * 64) + (kept_types * 32) + (kept_data * 128) + 8;
    return WasmStrippedModule {
        reached_functions: reached,
        reached_types: used_types,
        reached_data: used_data,
        original_size: original_size,
        stripped_size: stripped_size
    };
}

pub fn wasm_stripped_function_count(s: WasmStrippedModule) -> Int {
    return list_len(s.reached_functions);
}

pub fn wasm_stripped_type_count(s: WasmStrippedModule) -> Int {
    return list_len(s.reached_types);
}

pub fn wasm_stripped_data_count(s: WasmStrippedModule) -> Int {
    return list_len(s.reached_data);
}

pub fn wasm_stripped_original_size(s: WasmStrippedModule) -> Int {
    return s.original_size;
}

pub fn wasm_stripped_stripped_size(s: WasmStrippedModule) -> Int {
    return s.stripped_size;
}

pub fn wasm_stripped_is_under_30k(s: WasmStrippedModule) -> Bool {
    return s.stripped_size < 30720;
}
