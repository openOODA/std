// # WebAssembly Binary Module & LEB128 Encoder
//
// Logline: Build standard WebAssembly binary modules with the magic header, version, signed and unsigned LEB128 variable-length integer encoders, and per-section payload accumulators.
//
// Setup: Pure .oo encoder producing 8-bit byte vectors suitable for direct emission of section id 1 Type, 2 Import, 3 Function, 5 Memory, 6 Global, 7 Export, 10 Code, 11 Data sections.
//
// Beats:
//   1. Emit standard \0asm magic header and version 0x01, 0x00, 0x00, 0x00.
//   2. Encode u32, i32, and i64 signed/unsigned LEB128 variable-length integers.
//   3. Construct Type, Import, Function, Memory, Global, Export, Code, and Data section payloads with section id prefix.
//   4. Provide a continuous byte buffer vector accumulator with zero truncation.

type WasmModuleBuffer = struct {
    bytes: List[Int],
    size: Int
};

pub fn wasm_module_buffer_new() -> WasmModuleBuffer {
    return WasmModuleBuffer {
        bytes: list_new(),
        size: 0
    };
}

pub fn wasm_module_buffer_size(buf: WasmModuleBuffer) -> Int {
    return buf.size;
}

pub fn wasm_module_buffer_push_byte(buf: WasmModuleBuffer, byte_val: Int) -> WasmModuleBuffer {
    let masked: Int = byte_val & 255;
    return WasmModuleBuffer {
        bytes: list_push(buf.bytes, masked),
        size: buf.size + 1
    };
}

pub fn wasm_module_buffer_push_bytes(buf: WasmModuleBuffer, src: List[Int]) -> WasmModuleBuffer {
    let n: Int = list_len(src);
    let mut next: WasmModuleBuffer = buf;
    let mut i: Int = 0;
    while i < n {
        next = wasm_module_buffer_push_byte(next, list_get(src, i));
        i = i + 1;
    }
    return next;
}

pub fn wasm_module_buffer_push_u32(buf: WasmModuleBuffer, val: Int) -> WasmModuleBuffer {
    let encoded: List[Int] = wasm_binary_encode_u32_leb128(val);
    return wasm_module_buffer_push_bytes(buf, encoded);
}

pub fn wasm_module_buffer_to_list(buf: WasmModuleBuffer) -> List[Int] {
    return buf.bytes;
}

pub fn wasm_module_buffer_emit_header(buf: WasmModuleBuffer) -> WasmModuleBuffer {
    let mut next: WasmModuleBuffer = buf;
    next = wasm_module_buffer_push_byte(next, 0);
    next = wasm_module_buffer_push_byte(next, 97);
    next = wasm_module_buffer_push_byte(next, 115);
    next = wasm_module_buffer_push_byte(next, 109);
    next = wasm_module_buffer_push_byte(next, 1);
    next = wasm_module_buffer_push_byte(next, 0);
    next = wasm_module_buffer_push_byte(next, 0);
    next = wasm_module_buffer_push_byte(next, 0);
    return next;
}

pub fn wasm_module_buffer_emit_section(buf: WasmModuleBuffer, section_id: Int, payload: List[Int]) -> WasmModuleBuffer {
    let mut next: WasmModuleBuffer = buf;
    next = wasm_module_buffer_push_byte(next, section_id & 255);
    let pcount: Int = list_len(payload);
    next = wasm_module_buffer_push_u32(next, pcount);
    next = wasm_module_buffer_push_bytes(next, payload);
    return next;
}

pub fn wasm_binary_encode_u32_leb128(val: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let mut v: Int = val;
    let mut running: Bool = true;
    while running {
        let byte_val: Int = v & 127;
        v = v / 128;
        if v != 0 {
            res = list_push(res, byte_val | 128);
        } else {
            res = list_push(res, byte_val);
            running = false;
        }
    }
    return res;
}

pub fn wasm_binary_encode_i32_leb128(val: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let mut v: Int = val;
    let mut done: Bool = false;
    let mut safety: Int = 0;
    while !done {
        let byte_val: Int = v & 127;
        let shifted: Int = v >> 7;
        let sign_bit: Int = byte_val & 64;
        let is_neg: Bool = v < 0;
        if (shifted == 0 && sign_bit == 0) || (shifted == 0 - 1 && is_neg) {
            res = list_push(res, byte_val);
            done = true;
        } else {
            res = list_push(res, byte_val | 128);
            v = shifted;
        }
        safety = safety + 1;
        if safety > 16 {
            done = true;
        }
    }
    return res;
}

pub fn wasm_binary_encode_i64_leb128(val: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let mut v: Int = val;
    let mut done: Bool = false;
    let mut safety: Int = 0;
    while !done {
        let byte_val: Int = v & 127;
        let shifted: Int = v >> 7;
        let sign_bit: Int = byte_val & 64;
        let is_neg: Bool = v < 0;
        if (shifted == 0 && sign_bit == 0) || (shifted == 0 - 1 && is_neg) {
            res = list_push(res, byte_val);
            done = true;
        } else {
            res = list_push(res, byte_val | 128);
            v = shifted;
        }
        safety = safety + 1;
        if safety > 16 {
            done = true;
        }
    }
    return res;
}

pub fn wasm_binary_emit_type_section(func_types: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(func_types);
    out = list_push(out, n & 255);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, 96);
        let params: Int = list_get(func_types, i);
        out = list_push(out, params & 255);
        let mut p: Int = 0;
        while p < params {
            out = list_push(out, 127);
            p = p + 1;
        }
        out = list_push(out, 1);
        out = list_push(out, 127);
        i = i + 1;
    }
    return out;
}

pub fn wasm_binary_emit_import_section(imports: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(imports);
    out = list_push(out, n & 255);
    return out;
}

pub fn wasm_binary_emit_function_section(type_indices: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(type_indices);
    out = list_push(out, n & 255);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(type_indices, i) & 255);
        i = i + 1;
    }
    return out;
}

pub fn wasm_binary_emit_memory_section(min_pages: Int, max_pages: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 1);
    out = list_push(out, 0);
    out = list_push(out, min_pages & 255);
    if max_pages > 0 {
        out = list_push(out, 1);
        out = list_push(out, max_pages & 255);
    } else {
        out = list_push(out, 0);
    }
    return out;
}

pub fn wasm_binary_emit_export_section(name_bytes: List[Int], kind: Int, index: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 1);
    let name_len: Int = list_len(name_bytes);
    out = list_push(out, name_len & 255);
    let mut i: Int = 0;
    while i < name_len {
        out = list_push(out, list_get(name_bytes, i) & 255);
        i = i + 1;
    }
    out = list_push(out, kind & 255);
    out = list_push(out, index & 255);
    return out;
}

pub fn wasm_binary_emit_code_section(code_bodies: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(code_bodies);
    out = list_push(out, n & 255);
    let mut i: Int = 0;
    while i < n {
        let body_size: Int = list_get(code_bodies, i);
        out = list_push(out, body_size & 255);
        let mut j: Int = 0;
        while j < body_size {
            out = list_push(out, 0);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}
