// # Const if !false println no else
//
// Logline: Print not-ne when !false and there is no else branch.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If !false print not-ne.
//   3. Leave no else and no other statements.

pub fn verify_wasm_ifnot_noelse() -> Bool {
    if !false {
        println("not-ne");
    }
    return true;
}
