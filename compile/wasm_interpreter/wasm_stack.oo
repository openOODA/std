// # WebAssembly Operand Stack
//
// Logline: Type-safe operand stack implementation with underflow/overflow bounds checking and value operations.
//
// Setup: Pure Wasm evaluation stack storing 64-bit integer bit-patterns.
//
// Beats:
//   1. Implement stack initialization with configurable max depth.
//   2. Implement push, pop, peek with fail-closed bounds checking.
//   3. Implement stack manipulation routines: drop, dup, swap.
//   4. Enforce invariant stack depth tracking.

type WasmStack = struct {
    depth: Int,
    max_depth: Int,
    items: List[Int]
};

pub fn wasm_stack_new(max_capacity: Int) -> Result[WasmStack, String] {
    if max_capacity <= 0 {
        return Err("ERR\twasm_stack_new\tcapacity_must_be_positive");
    }
    let emp: List[Int] = list_new();
    let st: WasmStack = WasmStack {
        depth: 0,
        max_depth: max_capacity,
        items: emp
    };
    return Ok(st);
}

pub fn wasm_stack_push(st: WasmStack, val: Int) -> Result[WasmStack, String] {
    if st.depth >= st.max_depth {
        return Err("ERR\twasm_stack_push\tstack_overflow");
    }
    let xs: List[Int] = list_push(st.items, val);
    let new_st: WasmStack = WasmStack {
        depth: st.depth + 1,
        max_depth: st.max_depth,
        items: xs
    };
    return Ok(new_st);
}

type WasmPopResult = struct {
    stack: WasmStack,
    val: Int
};

fn wasm_stack_pop_helper(items: List[Int], src: List[Int], src_len: Int, idx: Int) -> List[Int] {
    if idx >= src_len {
        return items;
    }
    let v: Int = list_get(src, idx);
    let nxt: List[Int] = list_push(items, v);
    return wasm_stack_pop_helper(nxt, src, src_len, idx + 1);
}

pub fn wasm_stack_pop(st: WasmStack) -> Result[WasmPopResult, String] {
    if st.depth <= 0 {
        return Err("ERR\twasm_stack_pop\tstack_underflow");
    }
    let d: Int = st.depth;
    let top_val: Int = list_get(st.items, d - 1);
    let new_items: List[Int] = wasm_stack_pop_helper(list_new(), st.items, d - 1, 0);
    let next_st: WasmStack = WasmStack {
        depth: d - 1,
        max_depth: st.max_depth,
        items: new_items
    };
    return Ok(WasmPopResult {
        stack: next_st,
        val: top_val
    });
}

pub fn wasm_stack_peek(st: WasmStack) -> Result[Int, String] {
    if st.depth <= 0 {
        return Err("ERR\twasm_stack_peek\tstack_empty");
    }
    return Ok(list_get(st.items, st.depth - 1));
}
