// # Const if (2 > 1) println
//
// Logline: Print pgt-then when the condition is (2 > 1).
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If (2 > 1) print pgt-then else print pgt-else.
//   3. Leave no other statements.

pub fn verify_wasm_if_paren_gt() -> Bool {
    if (2 > 1) {
        println("pgt-then");
    } else {
        println("pgt-else");
    }
    return true;
}
