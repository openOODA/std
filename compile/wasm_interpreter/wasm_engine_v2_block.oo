// # WebAssembly Engine V2 Block Helpers
//
// Logline: Helpers for forward-scanning structured control flow (block/loop/if/end) and managing a label stack for br/br_if targets. The label stack tracks, for each open block/loop/if, the target PC the engine jumps to when a `br` or `br_if` references that label. For block/if the target is the matching `end` PC; for loop the target is the first PC of the loop body. The function label (for the enclosing function) is pushed at run entry with target = function end.
//
// Setup: Pure helpers over the body byte list. Imports the LEB128 size helper from wasm_engine_v2. Used by wasm_engine_v2_step to handle block, loop, if, end, br, and br_if without losing track of jump targets.
//
// Beats:
//   1. wasm_engine_v2_advance_pc skips past one instruction (opcode + immediates) for every opcode the slice1 subset uses.
//   2. wasm_engine_v2_block_end forward-scans from a block/loop/if opcode to the matching end PC, properly nesting on inner block/loop/if and treating `else` as transparent.
//   3. wasm_engine_v2_labels_pop drops the innermost N labels and returns the remaining prefix (used to shrink the label stack on end and on br N).

import "std/compile/wasm_interpreter/wasm_engine_v2.oo";

pub fn wasm_engine_v2_advance_pc(body: List[Int], pc: Int) -> Int {
    if pc >= list_len(body) { return pc; }
    let op: Int = list_get(body, pc);
    if op == 0 { return pc + 1; }
    if op == 1 { return pc + 1; }
    if op == 2 { return pc + 1 + wasm_engine_v2_imm_size(body, pc + 1); }
    if op == 3 { return pc + 1 + wasm_engine_v2_imm_size(body, pc + 1); }
    if op == 4 { return pc + 1 + wasm_engine_v2_imm_size(body, pc + 1); }
    if op == 5 { return pc + 1; }
    if op == 11 { return pc + 1; }
    if op == 12 { return pc + 1 + wasm_engine_v2_imm_size(body, pc + 1); }
    if op == 13 { return pc + 1 + wasm_engine_v2_imm_size(body, pc + 1); }
    if op == 15 { return pc + 1; }
    if op == 16 { return pc + 2; }
    if op == 26 { return pc + 1; }
    if op == 27 { return pc + 1; }
    if op == 32 { return pc + 2; }
    if op == 33 { return pc + 2; }
    if op == 34 { return pc + 2; }
    if op == 40 { return pc + 3; }
    if op == 41 { return pc + 3; }
    if op == 54 { return pc + 3; }
    if op == 55 { return pc + 3; }
    if op == 63 { return pc + 2; }
    if op == 64 { return pc + 1 + wasm_engine_v2_imm_size(body, pc + 1); }
    if op == 65 { return pc + 1 + wasm_engine_v2_imm_size(body, pc + 1); }
    if op == 66 { return pc + 1 + wasm_engine_v2_imm_size(body, pc + 1); }
    if op >= 69 && op <= 92 { return pc + 1; }
    if op >= 106 && op <= 117 { return pc + 1; }
    if op >= 124 && op <= 135 { return pc + 1; }
    return pc + 1;
}

pub fn wasm_engine_v2_block_end(body: List[Int], body_len: Int, block_pc: Int) -> Int {
    let mut cur: Int = block_pc + 1 + wasm_engine_v2_imm_size(body, block_pc + 1);
    let mut d: Int = 1;
    while cur < body_len {
        let op: Int = list_get(body, cur);
        if op == 2 || op == 3 || op == 4 {
            d = d + 1;
            cur = wasm_engine_v2_advance_pc(body, cur);
        } else if op == 5 {
            cur = cur + 1;
        } else if op == 11 {
            d = d - 1;
            if d == 0 { return cur; }
            cur = cur + 1;
        } else {
            cur = wasm_engine_v2_advance_pc(body, cur);
        }
    }
    return 0 - 1;
}

pub fn wasm_engine_v2_labels_pop(labels: List[Int], n: Int) -> List[Int] {
    let total: Int = list_len(labels);
    let keep: Int = total - n;
    if keep <= 0 { let empty: List[Int] = list_new(); return empty; }
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < keep { out = list_push(out, list_get(labels, i)); i = i + 1; }
    return out;
}

pub fn wasm_engine_v2_label_decode(raw: Int) -> Int {
    return raw / 2;
}

pub fn wasm_engine_v2_label_is_loop(raw: Int) -> Int {
    let r: Int = raw & 1;
    return r;
}
