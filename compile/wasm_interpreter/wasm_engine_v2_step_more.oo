// # WebAssembly Engine V2 Step More (call, return, binop)
//
// Logline: Handle else, end, call, return, and binary ops. Same opcode behavior as the former tail of wasm_engine_v2_step.
//
// Setup: Returns WasmStepCont. Called from wasm_engine_v2_step_once.
//
// Beats:
//   1. else/end unwind skip depth and call frames.
//   2. call/return/host dispatch and binop fallback.

import "std/compile/wasm_interpreter/wasm_stack.oo";
import "std/compile/wasm_interpreter/wasm_opcodes.oo";
import "std/compile/wasm_interpreter/wasm_host_runtime.oo";
import "std/compile/wasm_interpreter/wasm_host_runtime_call.oo";
import "std/compile/wasm_interpreter/wasm_engine_v2.oo";
import "std/compile/wasm_interpreter/wasm_engine_v2_eval.oo";
import "std/compile/wasm_interpreter/wasm_engine_v2_block.oo";
import "std/compile/wasm_interpreter/wasm_step_cont.oo";

pub fn wasm_engine_v2_step_more(mod: WasmModuleV2, body: List[Int], body_len: Int, pc: Int, st: WasmStack, locs: List[Int], local_base: Int, locals_top: Int, skip_depth: Int, block_depth: Int, call_stack: List[Int], func_idx: Int, rt: WasmHostRuntime, labels: List[Int]) -> WasmStepCont {
    let op: Int = list_get(body, pc);
    let user_count: Int = mod.user_count;
    if op == wasm_op_else() {
        let next_pc: Int = pc + 1;
        let new_skip: Int = if skip_depth == 1 { 0 } else if skip_depth > 1 { skip_depth } else { 1 };
        return wasm_step_cont_go(body, body_len, next_pc, st, locs, local_base, locals_top, new_skip, block_depth, call_stack, func_idx, rt, labels);
    }
    if op == wasm_op_end() {
        if skip_depth > 0 {
            let nl: List[Int] = wasm_engine_v2_labels_pop(labels, 1);
            return wasm_step_cont_go(body, body_len, pc + 1, st, locs, local_base, locals_top, skip_depth - 1, block_depth - 1, call_stack, func_idx, rt, nl);
        }
        if block_depth > 0 {
            let new_labels: List[Int] = wasm_engine_v2_labels_pop(labels, 1);
            return wasm_step_cont_go(body, body_len, pc + 1, st, locs, local_base, locals_top, skip_depth, block_depth - 1, call_stack, func_idx, rt, new_labels);
        }
        let cs_n: Int = list_len(call_stack);
        if cs_n == 0 { return wasm_step_cont_ok(rt, 0); }
        let saved_labels_len: Int = list_get(call_stack, cs_n - 1);
        let saved_func: Int = list_get(call_stack, cs_n - 5);
        let saved_pc: Int = list_get(call_stack, cs_n - 4);
        let saved_base: Int = list_get(call_stack, cs_n - 3);
        let callee_base: Int = local_base;
        let r_push: Result[WasmStack, String] = wasm_stack_push(st, 0);
        if r_push.ok == 1 {
            let sr: WasmStack = r_push.val;
            let mut new_cs: List[Int] = list_new();
            let mut kk: Int = 0;
            let keep_n: Int = cs_n - 5 - saved_labels_len;
            while kk < keep_n { new_cs = list_push(new_cs, list_get(call_stack, kk)); kk = kk + 1; }
            let new_locs: List[Int] = wasm_engine_v2_truncate_locs(locs, callee_base);
            let callee_body: List[Int] = wasm_module_v2_get_user_body(mod,  saved_func);
            let cb_len: Int = list_len(callee_body);
            let mut saved_labels: List[Int] = list_new();
            let mut sli: Int = 0;
            while sli < saved_labels_len { saved_labels = list_push(saved_labels, list_get(call_stack, keep_n + sli)); sli = sli + 1; }
            return wasm_step_cont_go(callee_body, cb_len, saved_pc, sr, new_locs, saved_base, saved_base, 0, 0, new_cs, saved_func, rt, saved_labels);
        } else { return wasm_step_cont_err("ERR\twasm_trap_stack_overflow\tat_end_return_push", rt); }
    }
    if op == wasm_op_call() {
        let target: Int = list_get(body, pc + 1);
        let next_pc: Int = pc + 2;
        if skip_depth != 0 {
            return wasm_step_cont_go(body, body_len, next_pc, st, locs, local_base, locals_top, skip_depth, block_depth, call_stack, func_idx, rt, labels);
        }
        if target < user_count {
            let arity: Int = list_get(mod.user_arity, target);
            let callee_locals: Int = list_get(mod.user_local_count, target);
            let r_pa: Result[WasmPopArgsResult, String] = wasm_engine_v2_pop_args_save(st, arity);
            if r_pa.ok == 1 {
                let pa: WasmPopArgsResult = r_pa.val;
                let st2: WasmStack = pa.stack;
                let arg_list: List[Int] = pa.args;
                let callee_body: List[Int] = wasm_module_v2_get_user_body(mod,  target);
                let cb_len: Int = list_len(callee_body);
                let mut start_pc: Int = 0;
                if cb_len > 0 { let lv: Int = wasm_engine_v2_decode_imm(callee_body, 0); start_pc = 1 + lv * 2; }
                let mut new_locs: List[Int] = list_new();
                let cn: Int = list_len(locs);
                let mut cli: Int = 0;
                while cli < cn { new_locs = list_push(new_locs, list_get(locs, cli)); cli = cli + 1; }
                let cn2: Int = cn;
                let mut li2: Int = 0;
                while li2 < callee_locals {
                    let mut vv: Int = 0;
                    if li2 < arity { vv = list_get(arg_list, li2); }
                    new_locs = list_push(new_locs, vv);
                    li2 = li2 + 1;
                }
                let mut new_cs: List[Int] = list_new();
                let cs_n: Int = list_len(call_stack);
                let mut kk: Int = 0;
                while kk < cs_n { new_cs = list_push(new_cs, list_get(call_stack, kk)); kk = kk + 1; }
                let labels_n: Int = list_len(labels);
                let mut lpi: Int = 0;
                while lpi < labels_n { new_cs = list_push(new_cs, list_get(labels, lpi)); lpi = lpi + 1; }
                new_cs = list_push(new_cs, func_idx);
                new_cs = list_push(new_cs, next_pc);
                new_cs = list_push(new_cs, local_base);
                new_cs = list_push(new_cs, st2.depth);
                new_cs = list_push(new_cs, labels_n);
                let callee_labels: List[Int] = list_new();
                return wasm_step_cont_go(callee_body, cb_len, start_pc, st2, new_locs, cn2, cn2 + callee_locals, 0, 0, new_cs, target, rt, callee_labels);
            } else {
                let e: String = r_pa.err;
                return wasm_step_cont_err(e, rt);
            }
        }
        let host_idx: Int = target - user_count;
        let hn: List[String] = mod.host_names;
        let host_name: String = list_get(hn, host_idx);
        let arity2: Int = wasm_host_arity(host_name);
        let r_pa2: Result[WasmPopArgsResult, String] = wasm_engine_v2_pop_args_save(st, arity2);
        if r_pa2.ok == 0 { return wasm_step_cont_err("ERR\twasm_trap_stack_underflow\tat_host_call_args", rt); }
        let pa2: WasmPopArgsResult = r_pa2.val;
        let st3: WasmStack = pa2.stack;
        let args: List[Int] = pa2.args;
        let r_disp: Result[PairRuntimeInt, String] = wasm_host_call(rt, host_name, args);
        if r_disp.ok == 1 {
            let p: PairRuntimeInt = r_disp.val;
            let new_rt: WasmHostRuntime = p.rt;
            let rv: Int = p.value;
            if host_name == "process_exit" { return wasm_step_cont_ok(new_rt, 0 - rv); }
            let r_push: Result[WasmStack, String] = wasm_stack_push(st3, rv);
            if r_push.ok == 1 {
                let sr: WasmStack = r_push.val;
                return wasm_step_cont_go(body, body_len, next_pc, sr, locs, local_base, locals_top, skip_depth, block_depth, call_stack, func_idx, new_rt, labels);
            } else { return wasm_step_cont_err("ERR\twasm_trap_stack_overflow\tat_host_call_push", rt); }
        } else {
            let e: String = r_disp.err;
            return wasm_step_cont_err(e, rt);
        }
    }
    if op == wasm_op_return() {
        if skip_depth != 0 {
            return wasm_step_cont_go(body, body_len, pc + 1, st, locs, local_base, locals_top, skip_depth, block_depth, call_stack, func_idx, rt, labels);
        }
        let cs_n2: Int = list_len(call_stack);
        if cs_n2 == 0 {
            let r_p: Result[WasmPopResult, String] = wasm_stack_pop(st);
            match r_p { Ok(pr) => { return wasm_step_cont_ok(rt, pr.val); } Err(_) => { return wasm_step_cont_ok(rt, 0); } }
        }
        let r_pp: Result[WasmPopResult, String] = wasm_stack_pop(st);
        let st_after: WasmStack = if r_pp.ok == 1 { (r_pp.val).stack; } else { st; };
        let ret_val: Int = if r_pp.ok == 1 { (r_pp.val).val; } else { 0; };
        let saved_labels_len2: Int = list_get(call_stack, cs_n2 - 1);
        let saved_func2: Int = list_get(call_stack, cs_n2 - 5);
        let saved_pc2: Int = list_get(call_stack, cs_n2 - 4);
        let saved_base2: Int = list_get(call_stack, cs_n2 - 3);
        let callee_base: Int = local_base;
        let r_push_ret: Result[WasmStack, String] = wasm_stack_push(st_after, ret_val);
        match r_push_ret {
            Ok(sr2) => {
                let mut new_cs2: List[Int] = list_new();
                let mut kk2: Int = 0;
                let keep_n2: Int = cs_n2 - 5 - saved_labels_len2;
                while kk2 < keep_n2 { new_cs2 = list_push(new_cs2, list_get(call_stack, kk2)); kk2 = kk2 + 1; }
                let new_locs2: List[Int] = wasm_engine_v2_truncate_locs(locs, callee_base);
                let callee_body2: List[Int] = wasm_module_v2_get_user_body(mod,  saved_func2);
                let cb_len2: Int = list_len(callee_body2);
                let mut saved_labels2: List[Int] = list_new();
                let mut sli2: Int = 0;
                while sli2 < saved_labels_len2 { saved_labels2 = list_push(saved_labels2, list_get(call_stack, keep_n2 + sli2)); sli2 = sli2 + 1; }
                return wasm_step_cont_go(callee_body2, cb_len2, saved_pc2, sr2, new_locs2, saved_base2, saved_base2, 0, 0, new_cs2, saved_func2, rt, saved_labels2);
            }
            Err(_) => { return wasm_step_cont_err("ERR\twasm_trap_stack_overflow\tat_return_push", rt); }
        }
    }
    let next_pc: Int = pc + 1;
    if skip_depth == 0 {
        let r2: Result[WasmStack, String] = wasm_engine_v2_eval_binop(st, op);
        if r2.ok == 1 {
            let s5: WasmStack = r2.val;
            return wasm_step_cont_go(body, body_len, next_pc, s5, locs, local_base, locals_top, skip_depth, block_depth, call_stack, func_idx, rt, labels);
        } else {
            let e: String = r2.err;
            return wasm_step_cont_err(e, rt);
        }
    }
    return wasm_step_cont_go(body, body_len, next_pc, st, locs, local_base, locals_top, skip_depth, block_depth, call_stack, func_idx, rt, labels);
}
