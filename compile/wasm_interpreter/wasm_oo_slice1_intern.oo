// # .oo Source Compiler for slice1: String Intern
//
// Logline: Strip quotes, unescape, intern strings into the host runtime, emit intern ids.
//
// Setup: Imports compile helpers and host runtime.
//
// Beats:
//   1. s1_strip_q and s1_unesc normalize string literals.
//   2. s1_intern_str and s1_emit_intern push interned ids.

import "std/compile/wasm_interpreter/wasm_oo_slice1_compile.oo";
import "std/compile/wasm_interpreter/wasm_host_runtime.oo";
import "std/core/str.oo";

pub fn verify_wasm_oo_slice1_intern() -> Bool {
    return true;
}

pub fn s1_strip_q(s: String) -> String {
    let n: Int = chars_len(s);
    if n >= 2 && char_at(s, 0) == "\"" && char_at(s, n - 1) == "\"" { return str_slice(s, 1, n - 1); }
    return s;
}

pub fn s1_unesc(s: String) -> String {
    let mut out: String = "";
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" && i + 1 < n {
            let nx: String = char_at(s, i + 1);
            if nx == "t" { out = out + "\t"; i = i + 2; }
            else if nx == "n" { out = out + "\n"; i = i + 2; }
            else { out = out + c; i = i + 1; }
        } else { out = out + c; i = i + 1; }
    }
    return out;
}

pub fn s1_intern_str(s: S1CC, str_val: String) -> S1CC {
    let n: Int = wasm_host_intern_count(s.rt);
    let mut i: Int = 0;
    while i < n { if wasm_host_get_string(s.rt, i) == str_val { return s; } i = i + 1; }
    return s1cc_setrt(s, wasm_host_intern(s.rt, str_val));
}

pub fn s1_emit_intern(s: S1CC, raw: String) -> S1CC {
    let unesc: String = s1_unesc(s1_strip_q(raw));
    let s2: S1CC = s1_intern_str(s, unesc);
    let rt2: WasmHostRuntime = s2.rt;
    let nn: Int = wasm_host_intern_count(rt2);
    let mut id: Int = 0 - 1;
    let mut j: Int = 0;
    while j < nn { if wasm_host_get_string(rt2, j) == unesc { id = j; } j = j + 1; }
    return s1cc_emit_i32(s2, id);}

