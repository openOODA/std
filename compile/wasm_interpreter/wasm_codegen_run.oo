// # WebAssembly Mini Engine For Codegen Tests
//
// Logline: Walk a code body interpreting const/add/sub/mul and return the stack.
//
// Setup: Uses WasmEngine.stack and wasm_stack_push/pop. Independent of engine V2.
//
// Beats:
//   1. Skip the locals prefix on the body.
//   2. Interpret i32/i64 const, add, sub, and mul opcodes.
//   3. Halt on end opcode 11.
//   4. Return WasmRunResult with the final stack.

import "std/compile/wasm_interpreter/wasm_stack.oo";
import "std/compile/wasm_interpreter/wasm_engine.oo";

type WasmRunResult = struct {
    halt: Int,
    stack: WasmStack
};

pub fn wasm_engine_run_function(eng: WasmEngine, body: List[Int]) -> Result[WasmRunResult, String] {
    let mut st: WasmStack = eng.stack;
    let mut pc: Int = 0;
    let body_len: Int = list_len(body);
    if body_len > 0 {
        let lv: Int = list_get(body, 0);
        pc = 1 + lv * 2;
    }
    let mut running: Bool = true;
    let mut res_stack: WasmStack = st;
    while running && pc < body_len {
        let op: Int = list_get(body, pc);
        if op == 65 || op == 66 {
            let mut imm: Int = 0;
            let mut mult: Int = 1;
            let mut cur_b: Int = 0;
            let mut reading: Bool = true;
            while reading && pc + 1 + cur_b < body_len {
                let b: Int = list_get(body, pc + 1 + cur_b);
                imm = imm + ((b & 127) * mult);
                if (b & 128) == 0 {
                    if (b & 64) != 0 { imm = imm - (mult * 128); }
                    reading = false;
                } else {
                    cur_b = cur_b + 1;
                    mult = mult * 128;
                }
            }
            let r_push: Result[WasmStack, String] = wasm_stack_push(st, imm);
            if r_push.ok == 0 { running = false; }
            else { let new_st: WasmStack = r_push.val; st = new_st; pc = pc + 2 + cur_b; }
        } else if op == 106 || op == 124 {
            let r_b: Result[WasmPopResult, String] = wasm_stack_pop(st);
            if r_b.ok == 0 { running = false; }
            else {
                let pr_b: WasmPopResult = r_b.val;
                let b_val: Int = pr_b.val;
                let r_a: Result[WasmPopResult, String] = wasm_stack_pop(pr_b.stack);
                if r_a.ok == 0 { running = false; }
                else {
                    let pr_a: WasmPopResult = r_a.val;
                    let r_push2: Result[WasmStack, String] = wasm_stack_push(pr_a.stack, pr_a.val + b_val);
                    if r_push2.ok == 0 { running = false; }
                    else { let new_st2: WasmStack = r_push2.val; st = new_st2; pc = pc + 1; }
                }
            }
        } else if op == 107 || op == 125 {
            let r_b: Result[WasmPopResult, String] = wasm_stack_pop(st);
            if r_b.ok == 0 { running = false; }
            else {
                let pr_b: WasmPopResult = r_b.val;
                let b_val: Int = pr_b.val;
                let r_a: Result[WasmPopResult, String] = wasm_stack_pop(pr_b.stack);
                if r_a.ok == 0 { running = false; }
                else {
                    let pr_a: WasmPopResult = r_a.val;
                    let r_push2: Result[WasmStack, String] = wasm_stack_push(pr_a.stack, pr_a.val - b_val);
                    if r_push2.ok == 0 { running = false; }
                    else { let new_st2: WasmStack = r_push2.val; st = new_st2; pc = pc + 1; }
                }
            }
        } else if op == 108 || op == 126 {
            let r_b: Result[WasmPopResult, String] = wasm_stack_pop(st);
            if r_b.ok == 0 { running = false; }
            else {
                let pr_b: WasmPopResult = r_b.val;
                let b_val: Int = pr_b.val;
                let r_a: Result[WasmPopResult, String] = wasm_stack_pop(pr_b.stack);
                if r_a.ok == 0 { running = false; }
                else {
                    let pr_a: WasmPopResult = r_a.val;
                    let r_push2: Result[WasmStack, String] = wasm_stack_push(pr_a.stack, pr_a.val * b_val);
                    if r_push2.ok == 0 { running = false; }
                    else { let new_st2: WasmStack = r_push2.val; st = new_st2; pc = pc + 1; }
                }
            }
        } else if op == 11 {
            running = false;
            res_stack = st;
        } else {
            pc = pc + 1;
        }
    }
    return Ok(WasmRunResult { halt: 1, stack: res_stack });
}
