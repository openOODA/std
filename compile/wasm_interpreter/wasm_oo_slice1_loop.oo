// # .oo Source Compiler for slice1: Loop Lowering
//
// Logline: Lower while statements to WASM blocks. while cond { body } emits block+loop+br_if+br. C-style for is a documented M1.11 follow-up.
//
// Setup: Pure .oo loop lowering utilities operating on S1CC compiler state.
//
// Beats:
//   1. Lower while loops: block { loop { cond_inverted; br_if 1; body; br 0 } end end }.
//   2. C-style for: stub (M1.11 follow-up; see s1_lower_for).

import "std/compile/wasm_interpreter/wasm_oo_slice1_token.oo";
import "std/compile/wasm_interpreter/wasm_oo_slice1_compile.oo";
import "std/compile/wasm_interpreter/wasm_oo_slice1_types.oo";
import "std/compile/wasm_interpreter/wasm_oo_slice1_expr.oo";
import "std/compile/wasm_interpreter/wasm_oo_slice1_stmt.oo";
import "std/core/str.oo";

pub fn s1_lower_while(s: S1CC, total_user_count: Int) -> S1CC {
    let s1: S1CC = s1cc_emit_op(s, 2);
    let s1b: S1CC = s1cc_emit_op(s1, 64);
    let s1c: S1CC = s1cc_emit_op(s1b, 3);
    let s1d: S1CC = s1cc_emit_op(s1c, 64);
    let s2: S1CC = s1cc_adv(s1d);
    let s3: S1CC = s1_lower_expr(s2, 0, total_user_count);
    let s4: S1CC = s1cc_emit_eqz(s3);
    let s5: S1CC = s1cc_emit_op(s4, 13);
    let s6: S1CC = s1cc_emit_bytes(s5, wasm_binary_encode_u32_leb128(1));
    let s6a: S1CC = if s1cc_t(s6) == "{" { s1cc_adv(s6) } else { s6 };
    let s7: S1CC = s1_lower_body(s6a, "}", total_user_count);
    let s8: S1CC = s1cc_emit_op(s7, 12);
    let s9: S1CC = s1cc_emit_bytes(s8, wasm_binary_encode_u32_leb128(0));
    let s10: S1CC = s1cc_emit_op(s9, 11);
    let s11: S1CC = s1cc_emit_op(s10, 11);
    return if s1cc_t(s11) == "}" { s1cc_adv(s11) } else { s11 };
}

pub fn s1_lower_for(s: S1CC, total_user_count: Int) -> S1CC {
    // C-style for: for [init]; [cond]; [update] { body }
    // Status: M1.11 follow-up. Two implementation attempts this turn produced stack_underflow
    // at runtime for the simplest case (empty body, empty init, simple cond+update). The
    // rewind-and-re-emit approach for the cond/body/update inside the loop interacts
    // poorly with s1cc_emit_op's code-list append semantics. A clean implementation likely
    // needs either a code-list splice primitive or a different lowering structure (e.g. an
    // 'update' block emitted after the loop body, then a single br that re-enters the loop).
    let s_adv: S1CC = s1cc_adv(s);
    return s1cc_err(s_adv, "ERR\tcompile\tunimplemented\tfor_loop");
}
