// # Hostile if (!(1 == x)) no-else fold
//
// Logline: Print fold-me from if (!(1 == x)) with no else so emit-wasm must miss a const-paren-not-eq no-else fold.
//
// Setup: One public main. Compare right operand is IDENT x.
//
// Beats:
//   1. Let x be 2.
//   2. If (!(1 == x)) print fold-me.
//   3. A fold-me-only module is a lie.

pub fn verify_wasm_if_paren_not_eq_noelse_hostile() -> Bool {
    let x = 2;
    if (!(1 == x)) {
        println("fold-me");
    }
    return true;
}
