// # Hostile ident if fold
//
// Logline: Print fold-me or other from if x so emit-wasm must miss a const-true fold.
//
// Setup: One public main. Condition is IDENT x, not KW_TRUE.
//
// Beats:
//   1. Let x be true.
//   2. If x print fold-me else print other.
//   3. A fold-me-only module is a lie.

pub fn verify_wasm_if_hostile() -> Bool {
    let x = true;
    if x {
        println("fold-me");
    } else {
        println("other");
    }
    return true;
}
