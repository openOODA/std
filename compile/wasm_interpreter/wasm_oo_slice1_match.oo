// # .oo Source Compiler for slice1: Match, Function, and Program
//
// Logline: Match (with type-checked Ok/Err bindings), function, top-level program, build+run. Match arm body shared via s1_lower_match_arm.
//
// Setup: import compile, expr, stmt, loop, and types.
//
// Beats:
//   1. Parse and lower match expressions and statement arms.
//   2. Bind pattern variables and evaluate branches.
//   3. Lower functions and function bodies.
import "std/compile/wasm_interpreter/wasm_oo_slice1_compile.oo";
import "std/compile/wasm_interpreter/wasm_oo_slice1_expr.oo";
import "std/compile/wasm_interpreter/wasm_oo_slice1_stmt.oo";
import "std/compile/wasm_interpreter/wasm_oo_slice1_loop.oo";
import "std/compile/wasm_interpreter/wasm_oo_slice1_types.oo";

pub fn s1_lower_match(s: S1CC, total_user_count: Int) -> S1CC {
    let s2: S1CC = s1cc_adv(s);
    let s3: S1CC = s1_lower_expr(s2, 0, total_user_count);
    let scrut_type: Int = s3.last_ret;
    if s1_rt_is_result(scrut_type) != 1 {
        let err_msg: String = "ERR\tcompile\tmatch_non_result_scrutinee\t" + scrut_type.to_string();
        return s1cc_err(s3, err_msg);
    }
    let cur_locs: List[String] = s3.locals;
    let scrut_idx: Int = list_len(cur_locs);
    let new_locs: List[String] = list_push(cur_locs, "_s");
    let new_lts: List[Int] = list_push(s3.local_types, scrut_type);
    let s4: S1CC = s1cc_setlocs_and_types(s3, new_locs, new_lts);
    let s5: S1CC = s1cc_emit_tee(s4, scrut_idx);
    let s5d: S1CC = s1cc_emit_drop(s5);
    let s6: S1CC = s1cc_emit_get(s5d, scrut_idx);
    let s7: S1CC = s1cc_emit_call(s6, total_user_count + 10);
    let s8: S1CC = s1cc_emit_if(s7);
    let s_ok: S1CC = s1_lower_match_arm(s8, scrut_idx, "Ok", total_user_count + 11, "missing_ok_arm", scrut_type, total_user_count);
    let s9: S1CC = s1cc_emit_else(s_ok);
    let s_err: S1CC = s1_lower_match_arm(s9, scrut_idx, "Err", total_user_count + 12, "missing_err_arm", scrut_type, total_user_count);
    let s_close: S1CC = if s1cc_t(s_err) == "}" { s1cc_adv(s_err) } else { s_err };
    return s1cc_emit_end(s_close);
}

pub fn s1_lower_match_arm(s: S1CC, scrut_idx: Int, expected: String, unwrap_target: Int, err_suffix: String, scrut_type: Int, total_user_count: Int) -> S1CC {
    let s_a: S1CC = if s1cc_t(s) == "{" { s1cc_adv(s) } else { s };
    if s1cc_t(s_a) != expected {
        let err_msg: String = "ERR\tcompile\tmatch_non_exhaustive\t" + err_suffix;
        return s1cc_err(s_a, err_msg);
    }
    let s_b: S1CC = s1cc_adv(s_a);
    let s_c: S1CC = if s1cc_t(s_b) == "(" { s1cc_adv(s_b) } else { s_b };
    let bind_name: String = s1cc_t(s_c);
    let s_d: S1CC = s1cc_adv(s_c);
    let s_e: S1CC = if s1cc_t(s_d) == ")" { s1cc_adv(s_d) } else { s_d };
    let s_f: S1CC = if s1cc_t(s_e) == "=" { s1cc_adv(s_e) } else { s_e };
    let s_g: S1CC = if s1cc_t(s_f) == ">" { s1cc_adv(s_f) } else { s_f };
    let s_h: S1CC = if s1cc_t(s_g) == "{" { s1cc_adv(s_g) } else { s_g };
    let arm_locs: List[String] = s_h.locals;
    let arm_idx: Int = list_len(arm_locs);
    let arm_new: List[String] = list_push(arm_locs, bind_name);
    let bind_type: Int = if expected == "Ok" { s1_rt_ok(scrut_type) } else { s1_rt_err(scrut_type) };
    let arm_new_types: List[Int] = list_push(s_h.local_types, bind_type);
    let s_i: S1CC = s1cc_setlocs_and_types(s_h, arm_new, arm_new_types);
    let payload: Int = if expected == "Ok" { s1_rt_ok(scrut_type) } else { s1_rt_err(scrut_type) };
    if payload != s1_rt_string() && s1_arm_uses_as_string(s_i, bind_name) {
        let err_msg: String = "ERR\tcompile\tmatch_binding_mismatch\t" + expected + "\t" + bind_name + "\tused_as_string_but_payload_is_int";
        return s1cc_err(s_i, err_msg);
    }
    if payload != s1_rt_int() && s1_arm_uses_as_int(s_i, bind_name) {
        let err_msg: String = "ERR\tcompile\tmatch_binding_mismatch\t" + expected + "\t" + bind_name + "\tused_as_int_but_payload_is_string";
        return s1cc_err(s_i, err_msg);
    }
    let s_j: S1CC = s1cc_emit_get(s_i, scrut_idx);
    let s_k: S1CC = s1cc_emit_call(s_j, unwrap_target);
    let s_l: S1CC = s1cc_emit_set(s_k, arm_idx);
    let s_m: S1CC = s1_lower_body(s_l, "}", total_user_count);
    return if s1cc_t(s_m) == "}" { s1cc_adv(s_m) } else { s_m };
}

pub fn s1_lower_function(s: S1CC, total_user_count: Int) -> S1CC {
    let mut cur: S1CC = s;
    if s1cc_t(cur) == "pub" { cur = s1cc_adv(cur); }
    if s1cc_t(cur) == "fn" { cur = s1cc_adv(cur); }
    let fn_name: String = s1cc_t(cur);
    if s1_user_fn(fn_name, cur.fns, cur.fns_count) >= 0 {
        let err_msg: String = "ERR\tcompile\tduplicate_function\t" + fn_name;
        return s1cc_err(cur, err_msg);
    }
    cur = s1cc_adv(cur);
    let new_count: Int = cur.fns_count + 1;
    let new_fns: List[String] = list_push(cur.fns, fn_name);
    let s_mid: S1CC = s1cc_setfns(cur, new_fns, new_count);
    cur = s1cc_adv(s_mid);
    let mut params: List[String] = list_new();
    let mut param_types: List[Int] = list_new();
    if s1cc_t(cur) == "(" { cur = s1cc_adv(cur); }
    while !s1cc_end(cur) && s1cc_t(cur) != ")" {
        if s1cc_match(cur, 5, "") {
            params = list_push(params, s1cc_t(cur));
            cur = s1cc_adv(cur);
            let pcode: Int = if s1cc_t(cur) == ":" { cur = s1cc_adv(cur); let c: Int = s1_parse_param_type(s1cc_t(cur)); cur = s1cc_adv(cur); c } else { s1_rt_unit() };
            param_types = list_push(param_types, pcode);
        } else { cur = s1cc_adv(cur); }
    }
    if s1cc_t(cur) == ")" { cur = s1cc_adv(cur); }
    let has_return: Bool = s1cc_t(cur) == "->";
    if has_return { cur = s1cc_adv(cur); while !s1cc_end(cur) && s1cc_match(cur, 5, "") { cur = s1cc_adv(cur); } }
    while !s1cc_end(cur) && s1cc_t(cur) != "{" { cur = s1cc_adv(cur); }
    if s1cc_end(cur) {
        let err_msg: String = "ERR\tcompile\teof_in_function\t" + fn_name;
        return s1cc_err(cur, err_msg);
    }
    if s1cc_t(cur) == "{" { cur = s1cc_adv(cur); }
    let fresh_code: List[Int] = list_new();
    let s_pre: S1CC = s1cc_setc(cur, fresh_code);
    let pn2: Int = list_len(params);
    let mut param_struct_ids: List[Int] = list_new();
    let mut psi: Int = 0;
    while psi < pn2 { param_struct_ids = list_push(param_struct_ids, 0 - 1); psi = psi + 1; }
    let s2: S1CC = s1cc_setlocs_types_structids(s_pre, params, param_types, param_struct_ids);
    let s3: S1CC = s1_lower_body(s2, "}", total_user_count);
    let s4: S1CC = if s1cc_t(s3) == "}" { s1cc_adv(s3) } else { s3 };
    if s1cc_end(s4) && s1cc_t(s3) != "}" {
        let err_msg: String = "ERR\tcompile\teof_in_function\t" + fn_name;
        return s1cc_err(s4, err_msg);
    }
    if has_return {
        let body_code: List[Int] = s4.code;
        let bl: Int = list_len(body_code);
        let mut has_ret: Bool = false;
        let mut k: Int = 0;
        while k < bl {
            if list_get(body_code, k) == 15 { has_ret = true; }
            k = k + 1;
        }
        if !has_ret {
            let err_msg: String = "ERR\tcompile\tmissing_return\t" + fn_name;
            return s1cc_err(s4, err_msg);
        }
    }
    return s1cc_emit_end(s4);
}

pub fn s1_lower_body(s: S1CC, end_text: String, total_user_count: Int) -> S1CC {
    let mut cur: S1CC = s;
    let mut running: Bool = true;
    while running {
        if s1cc_end(cur) { running = false; }
        else if s1cc_t(cur) == end_text { running = false; }
        else if s1cc_k(cur) == 220 {
            let bad: String = s1cc_t(cur);
            let err_msg: String = "ERR\tcompile\tunexpected_character\t" + bad;
            cur = s1cc_err(s1cc_adv(cur), err_msg);
            running = false;
        }
        else {
            let before: Int = cur.pos;
            cur = s1_lower_stmt(cur, total_user_count);
            if cur.pos <= before {
                let bad: String = s1cc_t(cur);
                let err_msg: String = "ERR\tcompile\tunexpected_token\t" + bad;
                cur = s1cc_err(s1cc_adv(cur), err_msg);
                running = false;
            }
        }
    }
    return cur;
}

pub fn s1_lower_stmt(s: S1CC, total_user_count: Int) -> S1CC {
    if s1cc_match(s, 21, "") { return s1_lower_let(s, total_user_count); }
    if s1cc_match(s, 28, "") {
        let s2: S1CC = s1cc_adv(s);
        let s3: S1CC = s1_lower_expr(s2, 0, total_user_count);
        let s4: S1CC = s1cc_emit_return(s3);
        return if s1cc_t(s4) == ";" { s1cc_adv(s4) } else { s4 };
    }
    if s1cc_match(s, 25, "") { return s1_lower_if(s, total_user_count); }
    if s1cc_match(s, 27, "") { return s1_lower_match(s, total_user_count); }
    if s1cc_match(s, 40, "") { return s1_lower_while(s, total_user_count); }
    if s1cc_match(s, 41, "") { return s1_lower_for(s, total_user_count); }
    if s1cc_match(s, 5, "") {
        let s2: S1CC = s1cc_adv(s);
        if s1cc_t(s2) == "=" {
            let s3: S1CC = s1cc_adv(s2);
            let s4: S1CC = s1_lower_expr(s3, 0, total_user_count);
            let name: String = s1cc_t(s);
            let idx: Int = s1_local_idx(s, name);
            let s5: S1CC = if idx >= 0 { s1cc_emit_set(s4, idx) } else { s4 };
            return if s1cc_t(s5) == ";" { s1cc_adv(s5) } else { s5 };
        }
        let s3: S1CC = s1_lower_expr(s, 0, total_user_count);
        let s4: S1CC = s1cc_emit_drop(s3);
        let s4b: S1CC = if s1cc_t(s4) == ";" { s1cc_adv(s4) } else { s4 };
        return s4b;
    }
    let s2: S1CC = s1_lower_expr(s, 0, total_user_count);
    let s3: S1CC = s1cc_emit_drop(s2);
    return if s1cc_t(s3) == ";" { s1cc_adv(s3) } else { s3 };
}
