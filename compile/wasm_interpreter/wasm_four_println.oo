// # Four println string statements
//
// Logline: Print four string literals so emit-wasm can plant all four texts.
//
// Setup: One public main. Body is only four println(STRING) statements.
//
// Beats:
//   1. Print line-a then line-b.
//   2. Print line-c then line-d.
//   3. Leave no other statements.

pub fn verify_wasm_four_println() -> Bool {
    println("line-a");
    println("line-b");
    println("line-c");
    println("line-d");
    return true;
}
