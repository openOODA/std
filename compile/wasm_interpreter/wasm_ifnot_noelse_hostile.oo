// # Hostile if !x no-else fold
//
// Logline: Print fold-me from if !x with no else so emit-wasm must miss a const-not no-else fold.
//
// Setup: One public main. Operand is IDENT x.
//
// Beats:
//   1. Let x be false.
//   2. If !x print fold-me.
//   3. A fold-me-only module is a lie.

pub fn verify_wasm_ifnot_noelse_hostile() -> Bool {
    let x = false;
    if !x {
        println("fold-me");
    }
    return true;
}
