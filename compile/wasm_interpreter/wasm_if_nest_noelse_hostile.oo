// # Hostile nested if x no-else fold
//
// Logline: Print fold-me from nested if true { if x } with no else so emit-wasm must miss a const-nest no-else fold.
//
// Setup: One public main. Inner condition is IDENT x.
//
// Beats:
//   1. Let x be true.
//   2. If true wrap if x print fold-me.
//   3. A fold-me-only module is a lie.

pub fn verify_wasm_if_nest_noelse_hostile() -> Bool {
    let x = true;
    if true {
        if x {
            println("fold-me");
        }
    }
    return true;
}
