// # Const if-true println
//
// Logline: Print then-yes when the condition is the true keyword.
//
// Setup: No imports. One public main. The body is only if true then else println.
//
// Beats:
//   1. Declare public main.
//   2. If true print then-yes else print else-no.
//   3. Leave no other statements.

pub fn verify_wasm_if_true() -> Bool {
    if true {
        println("then-yes");
    } else {
        println("else-no");
    }
    return true;
}
