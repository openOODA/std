// # .oo Source Compiler for slice1: Type Tables
//
// Logline: Return-type table for the 14 host functions, the binary-op precedence/op tables, and the match-arm body scanning helpers (s1_text_at, s1_kind_at, s1_arm_uses_as_string) used by Phase 3.14 to enforce Ok/Err binding types against Result payload types.
//
// Setup: Pure .oo. Type encoding: each type is a single Int. is_result * 10000 + err * 100 + ok. e.g. Result<Int,String> = 10201. local_types is List[Int] of encoded values because .oo lists only support List[Int] and List[String].
//
// Beats:
//   1. Define primitive return type tags.
//   2. Define Result type decomposition helpers.
//   3. Define host return type mapping.
//   4. Define operator precedence and arm scanning helpers.

import "std/core/str.oo";

pub fn s1_rt_unit() -> Int { return 0; }
pub fn s1_rt_int() -> Int { return 1; }
pub fn s1_rt_string() -> Int { return 2; }
pub fn s1_rt_bool() -> Int { return 3; }
pub fn s1_rt_list() -> Int { return 10; }
pub fn s1_rt_result_int_string() -> Int { return 1 * 10000 + 2 * 100 + 1; }

pub fn s1_rt_is_result(t: Int) -> Int { return t / 10000; }
pub fn s1_rt_ok(t: Int) -> Int { return t % 100; }
pub fn s1_rt_err(t: Int) -> Int { return (t / 100) % 100; }

pub fn s1_host_return_type(name: String) -> Int {
    if name == "list_new" { return s1_rt_list(); }
    if name == "list_push" { return s1_rt_int(); }
    if name == "list_first" { return s1_rt_result_int_string(); }
    if name == "list_last" { return s1_rt_result_int_string(); }
    if name == "byte_in_range" { return s1_rt_bool(); }
    if name == "parse_int" { return s1_rt_result_int_string(); }
    if name == "int_to_string" { return s1_rt_string(); }
    if name == "string_concat" { return s1_rt_string(); }
    if name == "string_contains" { return s1_rt_bool(); }
    if name == "result_is_ok" { return s1_rt_bool(); }
    if name == "result_unwrap_int" { return s1_rt_int(); }
    if name == "result_unwrap_str" { return s1_rt_string(); }
    if name == "println" { return s1_rt_unit(); }
    if name == "process_exit" { return s1_rt_unit(); }
    if name == "struct_new" { return s1_rt_int(); }
    if name == "struct_set" { return s1_rt_int(); }
    if name == "struct_get" { return s1_rt_int(); }
    return s1_rt_unit();
}

pub fn s1_call_arg_kind(name: String, idx: Int) -> Int {
    // Per-arg-kind table. -1 means "no constraint, skip the check".
    // Kinds mirror s1_rt_*: 1=int, 2=string, 3=bool, 10=list, 10201=result<int,string>.
    // Note: struct/result handles are encoded as ints at the wasm layer, so
    // int-kind args accept any handle-shaped value.
    if name == "list_push" {
        if idx == 0 { return s1_rt_int(); }
        if idx == 1 { return s1_rt_int(); }
    }
    if name == "list_first" { if idx == 0 { return s1_rt_int(); } }
    if name == "list_last" { if idx == 0 { return s1_rt_int(); } }
    if name == "byte_in_range" { if idx == 0 { return s1_rt_int(); } }
    if name == "parse_int" { if idx == 0 { return s1_rt_string(); } }
    if name == "int_to_string" { if idx == 0 { return s1_rt_int(); } }
    if name == "string_concat" {
        if idx == 0 { return s1_rt_string(); }
        if idx == 1 { return s1_rt_string(); }
    }
    if name == "string_contains" {
        if idx == 0 { return s1_rt_string(); }
        if idx == 1 { return s1_rt_string(); }
    }
    if name == "result_is_ok" { if idx == 0 { return s1_rt_int(); } }
    if name == "result_unwrap_int" { if idx == 0 { return s1_rt_int(); } }
    if name == "result_unwrap_str" { if idx == 0 { return s1_rt_int(); } }
    if name == "println" { if idx == 0 { return s1_rt_string(); } }
    if name == "process_exit" { if idx == 0 { return s1_rt_int(); } }
    if name == "struct_new" { if idx == 0 { return s1_rt_int(); } }
    if name == "struct_set" {
        if idx == 0 { return s1_rt_int(); }
        if idx == 1 { return s1_rt_int(); }
        if idx == 2 { return s1_rt_int(); }
    }
    if name == "struct_get" {
        if idx == 0 { return s1_rt_int(); }
        if idx == 1 { return s1_rt_int(); }
    }
    return 0 - 1;
}

pub fn s1_peek_arg_kind(s: S1CC) -> Int {
    // Peek the kind of the first token at position s WITHOUT advancing.
    // Returns s1_rt_* code (1/2/3/...) for known literal/ident kinds,
    // or -1 to indicate "unknown, skip the check".
    // For ident args, maps the high-level type to the wasm arg type:
    // list/result/struct handles are all i32 at the wasm layer, so they
    // peek as s1_rt_int(). Only string idents peek as s1_rt_string().
    let k: Int = s1cc_k(s);
    if k == 1 { return s1_rt_int(); }
    if k == 100 { return s1_rt_string(); }
    if k == 29 { return s1_rt_bool(); }
    if k == 30 { return s1_rt_bool(); }
    if k == 5 {
        let name: String = s1cc_t(s);
        let idx: Int = s1_local_idx(s, name);
        if idx >= 0 {
            let t: Int = s1_local_type(s, idx);
            if t == s1_rt_string() { return s1_rt_string(); }
            return s1_rt_int();
        }
        return 0 - 1;
    }
    return 0 - 1;
}

pub fn s1_parse_param_type(name: String) -> Int {
    // Map a parameter type name to its s1_rt_* code.
    // Returns s1_rt_unit() (0) for unknown types, which the caller can
    // detect and treat as a "skip the check" sentinel.
    if name == "Int" { return s1_rt_int(); }
    if name == "String" { return s1_rt_string(); }
    if name == "Bool" { return s1_rt_bool(); }
    if name == "List" { return s1_rt_list(); }
    if name == "Result" { return s1_rt_result_int_string(); }
    return s1_rt_unit();
}

pub fn s1_binop_prec_int(k: Int) -> Int {
    if k == 202 || k == 203 { return 4; }
    if k == 206 || k == 207 || k == 204 || k == 205 { return 5; }
    if k == 2 || k == 3 { return 6; }
    if k == 4 || k == 209 { return 7; }
    return 0;
}

pub fn s1_binop_op_int(k: Int) -> Int {
    if k == 2 { return 106; }
    if k == 3 { return 107; }
    if k == 4 { return 108; }
    if k == 209 { return 111; }
    if k == 202 { return 70; }
    if k == 203 { return 71; }
    if k == 206 { return 72; }
    if k == 207 { return 74; }
    if k == 204 { return 76; }
    if k == 205 { return 78; }
    return 0;
}

pub fn s1_text_at(s: S1CC, idx: Int) -> String {
    if idx < 0 { return ""; }
    return s1cc_t(s1cc_setpos(s, idx));
}

pub fn s1_kind_at(s: S1CC, idx: Int) -> Int {
    if idx < 0 { return 0; }
    return s1cc_k(s1cc_setpos(s, idx));
}

pub fn s1_arm_uses_as_string(s: S1CC, binding: String) -> Bool {
    let n: Int = list_len(s.kinds);
    let mut i: Int = s.pos;
    let mut depth: Int = 0;
    while i < n {
        let k: Int = s1_kind_at(s, i);
        let t: String = s1_text_at(s, i);
        if depth == 0 && t == "}" { return false; }
        if k == 5 && t == binding {
            let nt: String = s1_text_at(s, i + 1);
            let at: String = s1_text_at(s, i + 2);
            if nt == "." && at == "contains" {
                return true;
            }
        }
        if t == "{" { depth = depth + 1; }
        if t == "}" { depth = depth - 1; }
        i = i + 1;
    }
    return false;
}

pub fn s1_arm_uses_as_int(s: S1CC, binding: String) -> Bool {
    let n: Int = list_len(s.kinds);
    let mut i: Int = s.pos;
    let mut depth: Int = 0;
    while i < n {
        let k: Int = s1_kind_at(s, i);
        let t: String = s1_text_at(s, i);
        if depth == 0 && t == "}" { return false; }
        if k == 5 && t == binding {
            let prev_t: String = s1_text_at(s, i - 1);
            let next_t: String = s1_text_at(s, i + 1);
            let prev_k: Int = s1_kind_at(s, i - 2);
            let next_k: Int = s1_kind_at(s, i + 2);
            if prev_t == "+" && prev_k == 1 { return true; }
            if next_t == "+" && next_k == 1 { return true; }
        }
        if t == "{" { depth = depth + 1; }
        if t == "}" { depth = depth - 1; }
        i = i + 1;
    }
    return false;
}
