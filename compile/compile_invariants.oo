// # Compile-unit product invariants
//
// Logline: An empty module name is not a compile unit.
//
// Setup: Pure String checks. DomainCert is local because std/core/domain_cert.oo is absent.
//
// Beats:
//   1. compile_unit_ok("") returns 0.
//   2. compile_unit_ok of a non-empty name returns 1.
//   3. compile_unit_cert boxes the law into DomainCert.holds.

import "std/core/domain_cert.oo";
// Empty module name is not a compile unit.
pub fn compile_unit_ok(name: String) -> Int {
    if name == "" {
        return 0;
    }
    if name.len() == 0 {
        return 0;
    }
    return 1;
}

pub fn compile_unit_cert(name: String) -> DomainCert {
    return DomainCert {
        domain: "compile",
        law_name: "nonempty_unit",
        holds: compile_unit_ok(name)
    };
}
