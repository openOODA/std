// # Register allocation liveness principle
//
// Logline: A graph-coloring register allocation succeeds when the chromatic number chi(G) of the interference graph is <= k; otherwise one live range must be spilled and coloring retried.
//
// Setup: Pure Int. intervals is a flat list of (start, end) pairs length 2*N. start <= end. Empty list is Ok(0).
//
// Beats:
//   1. regalloc_chaitin_count(intervals) returns chi of the interval interference graph.
//   2. Two overlapping intervals force a conflict edge; non-overlapping intervals can share a register.
//   3. regalloc_needs_spill returns 1 when chi > k.
//   4. regalloc_spill_count returns the number of intervals that must be spilled when chi > k.

import "std/core/domain_cert.oo";

fn ral_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Count how many intervals contain a given point.
fn compile_regalloc_active_at(intervals: List[Int], n: Int, point: Int) -> Int {
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let s: Int = list_get(intervals, i * 2);
        let e: Int = list_get(intervals, i * 2 + 1);
        if point >= s {
            if point < e {
                c = c + 1;
            }
        }
        i = i + 1;
    }
    return c;
}

// Chi of the interval interference graph: max simultaneous live ranges.
// Empty list is Ok(0). Malformed input (odd length, bad bounds) is Err.
pub fn compile_regalloc_chaitin_count(intervals: List[Int]) -> Result[Int, String] {
    let len: Int = list_len(intervals);
    if len == 0 { return Ok(0); }
    if len % 2 != 0 { return Err("ERR\tral\tdomain"); }
    let n: Int = len / 2;
    let mut i: Int = 0;
    while i < n {
        let s: Int = list_get(intervals, i * 2);
        let e: Int = list_get(intervals, i * 2 + 1);
        if s < 0 { return Err("ERR\tral\tdomain"); }
        if e < s { return Err("ERR\tral\tdomain"); }
        i = i + 1;
    }
    // Scan unique endpoints and track max overlap.
    let mut max_chi: Int = 0;
    let mut j: Int = 0;
    while j < n {
        let p: Int = list_get(intervals, j * 2);
        let active: Int = compile_regalloc_active_at(intervals, n, p);
        if active > max_chi { max_chi = active; }
        j = j + 1;
    }
    return Ok(max_chi);
}

// 1 when chi > k (spill needed), 0 otherwise. Bad chi or k returns 0.
pub fn compile_regalloc_needs_spill(intervals: List[Int], k: Int) -> Int {
    if k < 0 { return 0; }
    let cr: Result[Int, String] = compile_regalloc_chaitin_count(intervals);
    if cr.is_ok() == false { return 0; }
    let chi: Int = ral_got(cr);
    if chi == 0 { return 0; }
    if chi > k { return 1; }
    return 0;
}

// Number of intervals to spill when chi > k. We spill enough intervals to
// drop the chromatic number to k: spill_count = chi - k. Ok(0) when no
// spill is required. Bad input is Err.
pub fn compile_regalloc_spill_count(intervals: List[Int], k: Int) -> Result[Int, String] {
    if k < 0 { return Err("ERR\tral\tdomain"); }
    let cr: Result[Int, String] = compile_regalloc_chaitin_count(intervals);
    if cr.is_ok() == false { return cr; }
    let chi: Int = ral_got(cr);
    if chi <= k { return Ok(0); }
    return Ok(chi - k);
}

// Golden builder: 2 intervals overlap -> chi = 2.
fn compile_regalloc_golden_overlap() -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 0);
    out = list_push(out, 5);
    out = list_push(out, 3);
    out = list_push(out, 8);
    return out;
}

// Golden builder: 2 non-overlapping intervals -> chi = 1.
fn compile_regalloc_golden_disjoint() -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 0);
    out = list_push(out, 3);
    out = list_push(out, 5);
    out = list_push(out, 8);
    return out;
}

// Domain certificate for the register allocation liveness principle.
pub fn compile_regalloc_cert(holds: Int) -> DomainCert {
    return domain_cert("compile", "regalloc_liveness", holds);
}

// KAT and hostile cases for the register allocation liveness principle.
pub fn verify_regalloc_liveness_principle() -> Bool {
    let overlap: List[Int] = compile_regalloc_golden_overlap();
    let disjoint: List[Int] = compile_regalloc_golden_disjoint();
    // Golden: 2 intervals overlap -> chi = 2.
    if ral_got(compile_regalloc_chaitin_count(overlap)) != 2 { return false; }
    if compile_regalloc_needs_spill(overlap, 1) != 1 { return false; }
    if ral_got(compile_regalloc_spill_count(overlap, 1)) != 1 { return false; }
    if compile_regalloc_needs_spill(overlap, 2) != 0 { return false; }
    let znosp: Result[Int, String] = compile_regalloc_spill_count(overlap, 2);
    if znosp.is_ok() == false { return false; }
    if ral_got(znosp) != 0 { return false; }
    if ral_got(compile_regalloc_chaitin_count(disjoint)) != 1 { return false; }
    if compile_regalloc_needs_spill(disjoint, 1) != 0 { return false; }
    // Golden: 3 intervals all overlap at point 5 -> chi = 3.
    let mut three: List[Int] = list_new();
    three = list_push(three, 0);
    three = list_push(three, 10);
    three = list_push(three, 2);
    three = list_push(three, 8);
    three = list_push(three, 5);
    three = list_push(three, 6);
    if ral_got(compile_regalloc_chaitin_count(three)) != 3 { return false; }
    if ral_got(compile_regalloc_spill_count(three, 2)) != 1 { return false; }
    if ral_got(compile_regalloc_spill_count(three, 1)) != 2 { return false; }
    let empty: List[Int] = list_new();
    let zchi: Result[Int, String] = compile_regalloc_chaitin_count(empty);
    if zchi.is_ok() == false { return false; }
    if ral_got(zchi) != 0 { return false; }
    if compile_regalloc_needs_spill(empty, 1) != 0 { return false; }
    let zsp: Result[Int, String] = compile_regalloc_spill_count(empty, 1);
    if zsp.is_ok() == false { return false; }
    if ral_got(zsp) != 0 { return false; }
    let mut odd: List[Int] = list_new();
    odd = list_push(odd, 0);
    odd = list_push(odd, 3);
    odd = list_push(odd, 5);
    if compile_regalloc_chaitin_count(odd).is_ok() { return false; }
    let mut bad: List[Int] = list_new();
    bad = list_push(bad, 5);
    bad = list_push(bad, 2);
    if compile_regalloc_chaitin_count(bad).is_ok() { return false; }
    let mut neg: List[Int] = list_new();
    neg = list_push(neg, 0 - 1);
    neg = list_push(neg, 3);
    if compile_regalloc_chaitin_count(neg).is_ok() { return false; }
    if compile_regalloc_needs_spill(overlap, 0 - 1) != 0 { return false; }
    if compile_regalloc_spill_count(overlap, 0 - 1).is_ok() { return false; }
    // Certificate round-trip.
    let c1: DomainCert = compile_regalloc_cert(1);
    if cert_holds(c1) != 1 { return false; }
    let c0: DomainCert = compile_regalloc_cert(0);
    if cert_holds(c0) != 0 { return false; }
    let c7: DomainCert = compile_regalloc_cert(7);
    if cert_holds(c7) != 0 { return false; }
    return true;
}
