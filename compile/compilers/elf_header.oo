// # ELF 64-bit Header Definitions
//
// Logline: ELF64 ident, machine, type, and 64-byte layout.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type / &ref destubbed to type + by-value.

type ElfHeader64 = struct {
    e_ident: List[Int],
    e_type: Int,
    e_machine: Int,
    e_version: Int,
    e_entry: Int,
    e_phoff: Int,
    e_shoff: Int,
    e_flags: Int
};

pub fn elf_machine_x86_64() -> Int {
    return 62;
}

pub fn elf_machine_aarch64() -> Int {
    return 183;
}

pub fn elf_machine_riscv() -> Int {
    return 243;
}

pub fn elf_type_rel() -> Int {
    return 1;
}

pub fn elf_type_exec() -> Int {
    return 2;
}

pub fn elf_type_dyn() -> Int {
    return 3;
}

pub fn elf_header64_default(machine: Int, e_type: Int) -> ElfHeader64 {
    let mut id: List[Int] = list_new();
    id = list_push(id, 2);
    id = list_push(id, 1);
    id = list_push(id, 1);
    id = list_push(id, 0);
    id = list_push(id, 0);
    let h: ElfHeader64 = ElfHeader64 {
        e_ident: id,
        e_type: e_type,
        e_machine: machine,
        e_version: 1,
        e_entry: 0,
        e_phoff: 64,
        e_shoff: 0,
        e_flags: 0
    };
    return h;
}

pub fn elf_header64_x86_64_exec(entry: Int) -> ElfHeader64 {
    let mut h: ElfHeader64 = elf_header64_default(elf_machine_x86_64(), elf_type_exec());
    h.e_entry = entry;
    return h;
}

pub fn elf_header64_aarch64_exec(entry: Int) -> ElfHeader64 {
    let mut h: ElfHeader64 = elf_header64_default(elf_machine_aarch64(), elf_type_exec());
    h.e_entry = entry;
    return h;
}

pub fn elf_header64_ident0(h: ElfHeader64) -> Int {
    return 127;
}

pub fn elf_header64_machine(h: ElfHeader64) -> Int {
    return h.e_machine;
}

pub fn elf_header64_validate(h: ElfHeader64) -> Int {
    if list_len(h.e_ident) < 5 {
        return 0;
    }
    if list_get(h.e_ident, 0) != 2 {
        return 0;
    }
    if list_get(h.e_ident, 1) != 1 {
        return 0;
    }
    if list_get(h.e_ident, 2) != 1 {
        return 0;
    }
    if h.e_phoff != 64 {
        return 0;
    }
    return 1;
}

pub fn elf_header64_to_bytes(h: ElfHeader64) -> List[Int] {
    let mut b: List[Int] = list_new();
    b = list_push(b, 127);
    b = list_push(b, 69);
    b = list_push(b, 76);
    b = list_push(b, 70);
    b = list_push(b, list_get(h.e_ident, 0));
    b = list_push(b, list_get(h.e_ident, 1));
    b = list_push(b, list_get(h.e_ident, 2));
    b = list_push(b, list_get(h.e_ident, 3));
    b = list_push(b, list_get(h.e_ident, 4));
    let mut p: Int = 0;
    while p < 7 {
        b = list_push(b, 0);
        p = p + 1;
    }
    b = list_push(b, h.e_type & 255);
    b = list_push(b, (h.e_type / 256) & 255);
    b = list_push(b, h.e_machine & 255);
    b = list_push(b, (h.e_machine / 256) & 255);
    b = list_push(b, h.e_version & 255);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 0);
    return b;
}
