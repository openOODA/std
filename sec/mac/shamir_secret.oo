// # Shamir secret sharing over GF(256)
//
// Logline: Splits a secret into n shares and recovers it from k shares by Lagrange interpolation over GF(256).
//
// Setup: Pure. Field polynomial is 283. Share x-coordinates are 1..n. k-1 shares fail closed.
//
// Beats:
//   1. Multiply and invert in GF(256).
//   2. Split each secret byte onto a degree-(k-1) polynomial.
//   3. Recover by Lagrange interpolation at x = 0.
//   4. Refuse fewer than k shares.

import "std/core/primitives/list.oo";

fn shamir_secret_xor(a: Int, b: Int) -> Int { return (a | b) - (a & b); }

fn shamir_secret_mul(aa: Int, bb: Int) -> Int {
    let mut p: Int = 0;
    let mut a: Int = aa & 255;
    let mut b: Int = bb & 255;
    let mut i: Int = 0;
    while i < 8 {
        if (b & 1) == 1 { p = shamir_secret_xor(p, a); }
        let hi: Int = a & 128;
        a = (a << 1) & 255;
        if hi != 0 { a = shamir_secret_xor(a, 27); }
        b = b >> 1;
        i = i + 1;
    }
    return p;
}

fn shamir_secret_inv(a: Int) -> Int {
    if a == 0 { return 0; }
    let mut r: Int = 1;
    let mut base: Int = a & 255;
    let mut e: Int = 254;
    while e > 0 {
        if (e & 1) == 1 { r = shamir_secret_mul(r, base); }
        base = shamir_secret_mul(base, base);
        e = e >> 1;
    }
    return r;
}

fn shamir_list_set(xs: List[Int], idx: Int, val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(xs);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, val);
        } else {
            out = list_push(out, list_get(xs, i));
        }
        i = i + 1;
    }
    return out;
}

pub fn shamir_secret_split(secret: List[Int], k: Int, n: Int, seed0: Int) -> Result[List[Int], String] {
    // Fail-closed: the deterministic LCG-based coefficient generator has been
    // removed. Shamir split requires a real entropy source for its polynomial
    // coefficients; callers must wire one in via a separate function or
    // migrate to a hardcoded-publish scheme. Recovery of legacy shares is
    // still possible via shamir_secret_recover below.
    if secret.len() < 0 || k < 0 || n < 0 || seed0 < 0 {
        return Err("shamir_secret_split: removed (LCG-based coefficient generation was not constant-time; use external entropy)");
    }
    return Err("shamir_secret_split: removed (LCG-based coefficient generation was not constant-time; use external entropy)");
}

fn shamir_secret_share_y(pack: List[Int], idx: Int, sl: Int, bytei: Int) -> Int {
    return list_get(pack, 3 + idx * (1 + sl) + 1 + bytei);
}

fn shamir_secret_share_x(pack: List[Int], idx: Int, sl: Int) -> Int {
    return list_get(pack, 3 + idx * (1 + sl));
}

pub fn shamir_secret_recover(pack: List[Int], use_n: Int) -> Result[List[Int], String] {
    if list_len(pack) < 4 { return Err("shamir pack short"); }
    let n: Int = list_get(pack, 0);
    let k: Int = list_get(pack, 1);
    let sl: Int = list_get(pack, 2);
    if use_n < k { return Err("shamir need k shares"); }
    if use_n > n { return Err("shamir use_n"); }
    if list_len(pack) != 3 + n * (1 + sl) { return Err("shamir pack size"); }
    let mut out: List[Int] = list_new();
    let mut b: Int = 0;
    while b < sl {
        let mut acc: Int = 0;
        let mut i: Int = 0;
        while i < k {
            let xi: Int = shamir_secret_share_x(pack, i, sl);
            let yi: Int = shamir_secret_share_y(pack, i, sl, b);
            let mut num: Int = 1;
            let mut den: Int = 1;
            let mut j: Int = 0;
            while j < k {
                if j != i {
                    let xj: Int = shamir_secret_share_x(pack, j, sl);
                    num = shamir_secret_mul(num, xj);
                    den = shamir_secret_mul(den, shamir_secret_xor(xi, xj));
                }
                j = j + 1;
            }
            let li: Int = shamir_secret_mul(num, shamir_secret_inv(den));
            acc = shamir_secret_xor(acc, shamir_secret_mul(yi, li));
            i = i + 1;
        }
        out = list_push(out, acc);
        b = b + 1;
    }
    return Ok(out);
}
