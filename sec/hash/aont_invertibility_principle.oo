// # AONT invertibility principle
//
// Logline: An All-Or-Nothing Transform (Rivest 1997) maps an n-block message plus a hash h to n+1 blocks; recovering any single block requires all n+1 blocks, so the transform is invertible iff all n+1 blocks are present.
//
// Setup: Pure Int. n is a non-negative block count. aont_block_count(n) = n + 1. aont_invertible(present_count, n) returns 1 iff present_count == n + 1, 0 otherwise; zero or fewer blocks fails closed.
//
// Beats:
//   1. aont_block_count(n) returns n + 1.
//   2. aont_invertible(present, n) returns 1 iff present == n + 1.
//   3. n-1 present blocks yields 0 (fails closed; Rivest 1997).
//   4. Zero blocks yields 0 (fail closed).
//   5. Coupled: AONT is (n,n)-secret sharing without key (Boyko 1998).

import "std/core/primitives/domain_cert.oo";

// Number of output blocks in an AONT of an n-block message.
// Source: Rivest 1997, "All-Or-Nothing Transform"; Boyko 1998
// "On the security properties of the OAEP". An AONT maps an n-block
// message plus a hash h to n + 1 blocks.
pub fn aont_block_count(n: Int) -> Result[Int, String] {
    if n < 0 {
        return Err("ERR\taont\tdomain");
    }
    return Ok(n + 1);
}

// 1 iff every output block of the AONT is present (present_count == n + 1).
// 0 otherwise. Zero or negative present_count fails closed to 0.
// Source: Rivest 1997, "All-Or-Nothing Transform" - without all n+1
// output blocks, none of the original n input blocks can be recovered.
pub fn aont_invertible(present_count: Int, n: Int) -> Int {
    if present_count <= 0 {
        return 0;
    }
    if n < 0 {
        return 0;
    }
    let total: Int = n + 1;
    if present_count != total {
        return 0;
    }
    return 1;
}

fn aont_count_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// DomainCert for the AONT invertibility principle. Holds iff n=1, n=2,
// and n=4 each invert only when all n+1 blocks are present and fail
// closed otherwise.
pub fn aont_invertibility_principle() -> DomainCert {
    // n = 1 -> 2 blocks needed; n = 2 -> 3; n = 4 -> 5.
    let i1a: Int = aont_invertible(2, 1);
    let i1b: Int = aont_invertible(1, 1);
    let i2a: Int = aont_invertible(3, 2);
    let i2b: Int = aont_invertible(2, 2);
    let i4a: Int = aont_invertible(5, 4);
    let i4b: Int = aont_invertible(4, 4);
    let b1: Int = aont_count_got(aont_block_count(1));
    let b2: Int = aont_count_got(aont_block_count(2));
    let b4: Int = aont_count_got(aont_block_count(4));
    if b1 != 2 { return domain_cert("hash", "aont_invertibility", 0); }
    if b2 != 3 { return domain_cert("hash", "aont_invertibility", 0); }
    if b4 != 5 { return domain_cert("hash", "aont_invertibility", 0); }
    if i1a != 1 { return domain_cert("hash", "aont_invertibility", 0); }
    if i1b != 0 { return domain_cert("hash", "aont_invertibility", 0); }
    if i2a != 1 { return domain_cert("hash", "aont_invertibility", 0); }
    if i2b != 0 { return domain_cert("hash", "aont_invertibility", 0); }
    if i4a != 1 { return domain_cert("hash", "aont_invertibility", 0); }
    if i4b != 0 { return domain_cert("hash", "aont_invertibility", 0); }
    return domain_cert("hash", "aont_invertibility", 1);
}

pub fn verify_aont_invertibility_principle() -> Bool {
    // Golden: block counts are n + 1.
    if aont_count_got(aont_block_count(0)) != 1 { return false; }
    if aont_count_got(aont_block_count(1)) != 2 { return false; }
    if aont_count_got(aont_block_count(2)) != 3 { return false; }
    if aont_count_got(aont_block_count(4)) != 5 { return false; }
    if aont_count_got(aont_block_count(8)) != 9 { return false; }
    // Golden: invertibility is 1 iff all n+1 blocks are present.
    if aont_invertible(2, 1) != 1 { return false; }
    if aont_invertible(3, 2) != 1 { return false; }
    if aont_invertible(5, 4) != 1 { return false; }
    if aont_invertible(9, 8) != 1 { return false; }
    // Golden: n-1 present blocks yields 0 (fail closed).
    if aont_invertible(1, 1) != 0 { return false; }
    if aont_invertible(2, 2) != 0 { return false; }
    if aont_invertible(4, 4) != 0 { return false; }
    if aont_invertible(8, 8) != 0 { return false; }
    // Hostile: zero blocks -> 0 (fail closed).
    if aont_invertible(0, 1) != 0 { return false; }
    if aont_invertible(0, 4) != 0 { return false; }
    // Hostile: negative n returns Err from aont_block_count.
    if aont_block_count(0 - 1).is_ok() { return false; }
    if aont_block_count(0 - 100).is_ok() { return false; }
    // Hostile: negative n in aont_invertible returns 0.
    if aont_invertible(1, 0 - 1) != 0 { return false; }
    // Hostile: extra blocks beyond n+1 do not flip invertibility to 1 for
    // the standard n+1 requirement (we keep strict equality).
    if aont_invertible(3, 1) != 0 { return false; }
    if aont_invertible(6, 4) != 0 { return false; }
    // Coupled: AONT is (n,n)-secret sharing without a key (Boyko 1998).
    // The threshold is exactly n+1 (== n) blocks; if even one block is
    // missing, the original n message blocks cannot be recovered.
    let n2_total: Int = aont_count_got(aont_block_count(2));
    if aont_invertible(n2_total - 1, 2) != 0 { return false; }
    if aont_invertible(n2_total, 2) != 1 { return false; }
    let n5_total: Int = aont_count_got(aont_block_count(5));
    if aont_invertible(n5_total - 1, 5) != 0 { return false; }
    if aont_invertible(n5_total, 5) != 1 { return false; }
    // DomainCert: the principle holds.
    if aont_invertibility_principle().holds != 1 { return false; }
    return true;
}
