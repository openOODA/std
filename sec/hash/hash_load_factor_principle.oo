// # Hash Load Factor Principle
//
// Logline: A hash table resizes when the entry count exceeds three quarters of the capacity; otherwise it holds.
//
// Setup: Pure Int. count and capacity are non-negative; capacity 0 fails closed to 0.
//
// Beats:
//   1. hash_load_factor_x100 returns count * 100 / capacity as a fixed-point percentage.
//   2. hash_resize_needed holds iff count * 4 > capacity * 3.
//   3. Capacity 0 or negative count fails closed to 0.

import "std/core/primitives/domain_cert.oo";

fn hlf_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn hash_load_factor_x100(count: Int, capacity: Int) -> Result[Int, String] {
    if count < 0 { return Err("ERR\thlf\tdomain"); }
    if capacity <= 0 { return Err("ERR\thlf\tdomain"); }
    return Ok((count * 100) / capacity);
}

pub fn hash_resize_needed(count: Int, capacity: Int) -> Int {
    if count < 0 {
        return 0;
    }
    if capacity <= 0 {
        return 0;
    }
    if (count * 4) > (capacity * 3) {
        return 1;
    }
    return 0;
}

pub fn hash_resize_law(count: Int, capacity: Int) -> DomainCert {
    return domain_cert("hash", "load_factor", hash_resize_needed(count, capacity));
}

pub fn verify_hash_load_factor_principle() -> Bool {
    // Golden: 10 / 16 = 62 (62.5% truncated to 62).
    if hlf_got(hash_load_factor_x100(10, 16)) != 62 { return false; }
    if hlf_got(hash_load_factor_x100(8, 16)) != 50 { return false; }
    let zlf: Result[Int, String] = hash_load_factor_x100(0, 16);
    if zlf.is_ok() == false { return false; }
    if hlf_got(zlf) != 0 { return false; }
    if hlf_got(hash_load_factor_x100(12, 16)) != 75 { return false; }
    if hash_load_factor_x100(0 - 1, 16).is_ok() { return false; }
    if hash_load_factor_x100(10, 0).is_ok() { return false; }
    if hash_load_factor_x100(10, 0 - 4).is_ok() { return false; }
    // Golden: 10 / 16 does not need resize (40 vs 48).
    if hash_resize_needed(10, 16) != 0 { return false; }
    // Golden: 12 / 16 does not need resize (48 vs 48, not strictly greater).
    if hash_resize_needed(12, 16) != 0 { return false; }
    // Golden: 0 / 16 does not need resize.
    if hash_resize_needed(0, 16) != 0 { return false; }
    // Hostile: 13 / 16 needs resize (52 > 48).
    if hash_resize_needed(13, 16) != 1 { return false; }
    // Hostile: 100 / 100 needs resize (400 > 300).
    if hash_resize_needed(100, 100) != 1 { return false; }
    // Hostile: 1 / 1 needs resize (4 > 3).
    if hash_resize_needed(1, 1) != 1 { return false; }
    // Hostile: negative count fails closed.
    if hash_resize_needed(-1, 16) != 0 { return false; }
    // Hostile: capacity 0 fails closed.
    if hash_resize_needed(10, 0) != 0 { return false; }
    // DomainCert.holds matches the Int law.
    if hash_resize_law(13, 16).holds != 1 { return false; }
    if hash_resize_law(10, 16).holds != 0 { return false; }
    return true;
}
