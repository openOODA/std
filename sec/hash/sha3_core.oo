// # SHA-3 / Keccak Lane Algebra and 50-Int State
//
// Logline: 32-bit hi/lo lane ops plus a 25-lane Keccak-f[1600] state as List[Int].
//
// Setup: Pure Int halves. LLVM struct-literal temps are 256 bytes, so the
//   400-byte 25-lane struct does not fit; 50 ints live on the list heap.
//
// Beats:
//   1. K64 xor/and/not/rotl and k_rc round constants.
//   2. k_empty / k_get / k_set / k_push on a 50-int state (hi, lo per lane).
//   3. k_theta column parity, D, xor into each lane.

type K64 = struct {
    hi: Int,
    lo: Int
};

type KRow = struct {
    a0: K64,
    a1: K64,
    a2: K64,
    a3: K64,
    a4: K64
};

pub fn k_mask(x: Int) -> Int {
    return x & 4294967295;
}

pub fn k_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

pub fn k_xor64(a: K64, b: K64) -> K64 {
    return K64 { hi: k_xor(a.hi, b.hi), lo: k_xor(a.lo, b.lo) };
}

pub fn k_and64(a: K64, b: K64) -> K64 {
    return K64 { hi: a.hi & b.hi, lo: a.lo & b.lo };
}

pub fn k_not64(a: K64) -> K64 {
    return K64 { hi: k_xor(a.hi, 4294967295), lo: k_xor(a.lo, 4294967295) };
}

pub fn k_rotl(a: K64, r: Int) -> K64 {
    let mut xh: Int = a.hi;
    let mut xl: Int = a.lo;
    let mut rr: Int = r;
    if rr >= 32 {
        xh = a.lo;
        xl = a.hi;
        rr = r - 32;
    }
    if rr == 0 {
        return K64 { hi: xh, lo: xl };
    }
    let sh: Int = 32 - rr;
    let nhi: Int = k_mask((xh << rr) | (xl >> sh));
    let nlo: Int = k_mask((xl << rr) | (xh >> sh));
    return K64 { hi: nhi, lo: nlo };
}

pub fn k_zero() -> K64 {
    return K64 { hi: 0, lo: 0 };
}

pub fn k_push(s: List[Int], w: K64) -> List[Int] {
    let a: List[Int] = list_push(s, w.hi);
    return list_push(a, w.lo);
}

pub fn k_empty() -> List[Int] {
    let mut s: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 25 {
        s = k_push(s, k_zero());
        i = i + 1;
    }
    return s;
}

pub fn k_get(s: List[Int], i: Int) -> K64 {
    return K64 { hi: list_get(s, i * 2), lo: list_get(s, i * 2 + 1) };
}

pub fn k_set(s: List[Int], i: Int, v: K64) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut j: Int = 0;
    while j < 25 {
        if j == i {
            out = k_push(out, v);
        } else {
            out = k_push(out, k_get(s, j));
        }
        j = j + 1;
    }
    return out;
}

pub fn k_rc(i: Int) -> K64 {
    if i == 0 { return K64 { hi: 0, lo: 1 }; }
    if i == 1 { return K64 { hi: 0, lo: 32898 }; }
    if i == 2 { return K64 { hi: 2147483648, lo: 32906 }; }
    if i == 3 { return K64 { hi: 2147483648, lo: 2147516416 }; }
    if i == 4 { return K64 { hi: 0, lo: 32907 }; }
    if i == 5 { return K64 { hi: 0, lo: 2147483649 }; }
    if i == 6 { return K64 { hi: 2147483648, lo: 2147516545 }; }
    if i == 7 { return K64 { hi: 2147483648, lo: 32777 }; }
    if i == 8 { return K64 { hi: 0, lo: 138 }; }
    if i == 9 { return K64 { hi: 0, lo: 136 }; }
    if i == 10 { return K64 { hi: 0, lo: 2147516425 }; }
    if i == 11 { return K64 { hi: 0, lo: 2147483658 }; }
    if i == 12 { return K64 { hi: 0, lo: 2147516555 }; }
    if i == 13 { return K64 { hi: 2147483648, lo: 139 }; }
    if i == 14 { return K64 { hi: 2147483648, lo: 32905 }; }
    if i == 15 { return K64 { hi: 2147483648, lo: 32771 }; }
    if i == 16 { return K64 { hi: 2147483648, lo: 32770 }; }
    if i == 17 { return K64 { hi: 2147483648, lo: 128 }; }
    if i == 18 { return K64 { hi: 0, lo: 32778 }; }
    if i == 19 { return K64 { hi: 2147483648, lo: 2147483658 }; }
    if i == 20 { return K64 { hi: 2147483648, lo: 2147516545 }; }
    if i == 21 { return K64 { hi: 2147483648, lo: 32896 }; }
    if i == 22 { return K64 { hi: 0, lo: 2147483649 }; }
    return K64 { hi: 2147483648, lo: 2147516424 };
}

pub fn k_dcol(d0: K64, d1: K64, d2: K64, d3: K64, d4: K64, col: Int) -> K64 {
    if col == 0 { return d0; }
    if col == 1 { return d1; }
    if col == 2 { return d2; }
    if col == 3 { return d3; }
    return d4;
}

pub fn k_theta(s: List[Int]) -> List[Int] {
    let c0: K64 = k_xor64(k_xor64(k_xor64(k_xor64(k_get(s, 0), k_get(s, 5)), k_get(s, 10)), k_get(s, 15)), k_get(s, 20));
    let c1: K64 = k_xor64(k_xor64(k_xor64(k_xor64(k_get(s, 1), k_get(s, 6)), k_get(s, 11)), k_get(s, 16)), k_get(s, 21));
    let c2: K64 = k_xor64(k_xor64(k_xor64(k_xor64(k_get(s, 2), k_get(s, 7)), k_get(s, 12)), k_get(s, 17)), k_get(s, 22));
    let c3: K64 = k_xor64(k_xor64(k_xor64(k_xor64(k_get(s, 3), k_get(s, 8)), k_get(s, 13)), k_get(s, 18)), k_get(s, 23));
    let c4: K64 = k_xor64(k_xor64(k_xor64(k_xor64(k_get(s, 4), k_get(s, 9)), k_get(s, 14)), k_get(s, 19)), k_get(s, 24));
    let d0: K64 = k_xor64(c4, k_rotl(c1, 1));
    let d1: K64 = k_xor64(c0, k_rotl(c2, 1));
    let d2: K64 = k_xor64(c1, k_rotl(c3, 1));
    let d3: K64 = k_xor64(c2, k_rotl(c4, 1));
    let d4: K64 = k_xor64(c3, k_rotl(c0, 1));
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 25 {
        let d: K64 = k_dcol(d0, d1, d2, d3, d4, i % 5);
        out = k_push(out, k_xor64(k_get(s, i), d));
        i = i + 1;
    }
    return out;
}
