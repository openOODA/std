// # SHA-512 one-shot
//
// Logline: Hashes a byte string with one-shot FIPS 180-4 SHA-512 and returns the 512-bit state as 128 lowercase hex chars.
//
// Setup: Pure Int 32-bit halves. Imports sha512_core.oo and sha512_codec.oo.
//
// Beats:
//   1. Pad to 128-byte blocks with 0x80 and 128-bit BE bit length.
//   2. Schedule 80 words; run 80 rounds via a worker; add back to state.
//   3. Emit the 8-word state as 128 lowercase hex chars.

import "./sha512_codec.oo";

type S5W = struct {
    a: W64,
    b: W64,
    c: W64,
    d: W64,
    e: W64,
    f: W64,
    g: W64,
    h: W64
};

pub fn s5_rnd(w: S5W, k: W64, x: W64) -> S5W {
    let t1: W64 = s5_add(s5_add(s5_add(s5_add(w.h, s5_Sigma1(w.e)), s5_ch(w.e, w.f, w.g)), k), x);
    let t2: W64 = s5_add(s5_Sigma0(w.a), s5_maj(w.a, w.b, w.c));
    return S5W {
        a: s5_add(t1, t2),
        b: w.a,
        c: w.b,
        d: w.c,
        e: s5_add(w.d, t1),
        f: w.e,
        g: w.f,
        h: w.g
    };
}

pub fn s5_get(s: S5W, i: Int) -> W64 {
    if i == 0 { return s.a; }
    if i == 1 { return s.b; }
    if i == 2 { return s.c; }
    if i == 3 { return s.d; }
    if i == 4 { return s.e; }
    if i == 5 { return s.f; }
    if i == 6 { return s.g; }
    return s.h;
}

pub fn s5_compress(w: S5W, data: String, n: Int, total: Int, base: Int) -> S5W {
    let z: W64 = W64 { hi: 0, lo: 0 };
    let mut w0: W64 = z; let mut w1: W64 = z; let mut w2: W64 = z; let mut w3: W64 = z;
    let mut w4: W64 = z; let mut w5: W64 = z; let mut w6: W64 = z; let mut w7: W64 = z;
    let mut w8: W64 = z; let mut w9: W64 = z; let mut w10: W64 = z; let mut w11: W64 = z;
    let mut w12: W64 = z; let mut w13: W64 = z; let mut w14: W64 = z; let mut w15: W64 = z;
    let mut s: S5W = w;
    let mut t: Int = 0;
    while t < 80 {
        let mut wt: W64 = z;
        if t < 16 {
            wt = s5_load(data, n, total, base, t);
        } else {
            wt = s5_add(s5_add(s5_sigma1(w14), w9), s5_add(s5_sigma0(w1), w0));
        }
        s = s5_rnd(s, s5_k(t), wt);
        w0 = w1; w1 = w2; w2 = w3; w3 = w4;
        w4 = w5; w5 = w6; w6 = w7; w7 = w8;
        w8 = w9; w9 = w10; w10 = w11; w11 = w12;
        w12 = w13; w13 = w14; w14 = w15; w15 = wt;
        t = t + 1;
    }
    return s;
}

pub fn s5_init() -> S5W {
    return S5W {
        a: W64 { hi: 1779033703, lo: 4089235720 },
        b: W64 { hi: 3144134277, lo: 2227873595 },
        c: W64 { hi: 1013904242, lo: 4271175723 },
        d: W64 { hi: 2773480762, lo: 1595750129 },
        e: W64 { hi: 1359893119, lo: 2917565137 },
        f: W64 { hi: 2600822924, lo: 725511199 },
        g: W64 { hi: 528734635, lo: 4215389547 },
        h: W64 { hi: 1541459225, lo: 327033209 }
    };
}

pub fn s5_addst(x: S5W, y: S5W) -> S5W {
    return S5W {
        a: s5_add(x.a, y.a), b: s5_add(x.b, y.b),
        c: s5_add(x.c, y.c), d: s5_add(x.d, y.d),
        e: s5_add(x.e, y.e), f: s5_add(x.f, y.f),
        g: s5_add(x.g, y.g), h: s5_add(x.h, y.h)
    };
}

pub fn sha512_hex(data: String) -> String {
    // bytes_len, NOT .len(): .len() counts Unicode scalars, truncating any
    // input with bytes >= 0x80 (found via ed25519 oracle, 2026-09-27).
    let n: Int = bytes_len(data);
    let rem: Int = n % 128;
    let mut blocks: Int = n / 128;
    if rem <= 111 {
        blocks = blocks + 1;
    } else {
        blocks = blocks + 2;
    }
    let total: Int = blocks * 128;
    let mut h: S5W = s5_init();
    let mut blk: Int = 0;
    while blk < blocks {
        let base: Int = blk * 128;
        let mut s: S5W = s5_compress(h, data, n, total, base);
        s = s5_addst(h, s);
        h = s;
        blk = blk + 1;
    }
    let mut out: String = "";
    out = out + s5_hexw(h.a);
    out = out + s5_hexw(h.b);
    out = out + s5_hexw(h.c);
    out = out + s5_hexw(h.d);
    out = out + s5_hexw(h.e);
    out = out + s5_hexw(h.f);
    out = out + s5_hexw(h.g);
    out = out + s5_hexw(h.h);
    return out;
}

pub fn sha512(data: String) -> String {
    return sha512_hex(data);
}
