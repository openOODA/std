// # SHA-3 / Keccak Absorb, Squeeze, and Round Step
//
// Logline: rhopi, chi, and 24-round k_f on a 50-int state; pad, load, hex digest.
//
// Setup: Pure Int 32-bit halves. Sibling of sha3_core.oo, called by sha3.oo.
//
// Beats:
//   1. rhopi lane rotations, chi_row, chi, and k_f 24-round state update.
//   2. k_padb + k_load8: pad domain byte (SHA3 0x06 / Keccak 0x01) and pack 8-byte lanes.
//   3. k_hex_lane / k_hex_out / k_hash: emit n-byte lowercase hex digest.

import "./sha3_core.oo";

pub fn k_rhopi(s: List[Int]) -> List[Int] {
    let mut o: List[Int] = list_new();
    o = k_push(o, k_rotl(k_get(s, 0), 0));
    o = k_push(o, k_rotl(k_get(s, 6), 44));
    o = k_push(o, k_rotl(k_get(s, 12), 43));
    o = k_push(o, k_rotl(k_get(s, 18), 21));
    o = k_push(o, k_rotl(k_get(s, 24), 14));
    o = k_push(o, k_rotl(k_get(s, 3), 28));
    o = k_push(o, k_rotl(k_get(s, 9), 20));
    o = k_push(o, k_rotl(k_get(s, 10), 3));
    o = k_push(o, k_rotl(k_get(s, 16), 45));
    o = k_push(o, k_rotl(k_get(s, 22), 61));
    o = k_push(o, k_rotl(k_get(s, 1), 1));
    o = k_push(o, k_rotl(k_get(s, 7), 6));
    o = k_push(o, k_rotl(k_get(s, 13), 25));
    o = k_push(o, k_rotl(k_get(s, 19), 8));
    o = k_push(o, k_rotl(k_get(s, 20), 18));
    o = k_push(o, k_rotl(k_get(s, 4), 27));
    o = k_push(o, k_rotl(k_get(s, 5), 36));
    o = k_push(o, k_rotl(k_get(s, 11), 10));
    o = k_push(o, k_rotl(k_get(s, 17), 15));
    o = k_push(o, k_rotl(k_get(s, 23), 56));
    o = k_push(o, k_rotl(k_get(s, 2), 62));
    o = k_push(o, k_rotl(k_get(s, 8), 55));
    o = k_push(o, k_rotl(k_get(s, 14), 39));
    o = k_push(o, k_rotl(k_get(s, 15), 41));
    o = k_push(o, k_rotl(k_get(s, 21), 2));
    return o;
}

pub fn k_chi_row(a: K64, b: K64, c: K64, d: K64, e: K64) -> KRow {
    return KRow {
        a0: k_xor64(a, k_and64(k_not64(b), c)),
        a1: k_xor64(b, k_and64(k_not64(c), d)),
        a2: k_xor64(c, k_and64(k_not64(d), e)),
        a3: k_xor64(d, k_and64(k_not64(e), a)),
        a4: k_xor64(e, k_and64(k_not64(a), b))
    };
}

pub fn k_chi(s: List[Int]) -> List[Int] {
    let r0: KRow = k_chi_row(k_get(s, 0), k_get(s, 1), k_get(s, 2), k_get(s, 3), k_get(s, 4));
    let r1: KRow = k_chi_row(k_get(s, 5), k_get(s, 6), k_get(s, 7), k_get(s, 8), k_get(s, 9));
    let r2: KRow = k_chi_row(k_get(s, 10), k_get(s, 11), k_get(s, 12), k_get(s, 13), k_get(s, 14));
    let r3: KRow = k_chi_row(k_get(s, 15), k_get(s, 16), k_get(s, 17), k_get(s, 18), k_get(s, 19));
    let r4: KRow = k_chi_row(k_get(s, 20), k_get(s, 21), k_get(s, 22), k_get(s, 23), k_get(s, 24));
    let mut o: List[Int] = list_new();
    o = k_push(o, r0.a0); o = k_push(o, r0.a1); o = k_push(o, r0.a2); o = k_push(o, r0.a3); o = k_push(o, r0.a4);
    o = k_push(o, r1.a0); o = k_push(o, r1.a1); o = k_push(o, r1.a2); o = k_push(o, r1.a3); o = k_push(o, r1.a4);
    o = k_push(o, r2.a0); o = k_push(o, r2.a1); o = k_push(o, r2.a2); o = k_push(o, r2.a3); o = k_push(o, r2.a4);
    o = k_push(o, r3.a0); o = k_push(o, r3.a1); o = k_push(o, r3.a2); o = k_push(o, r3.a3); o = k_push(o, r3.a4);
    o = k_push(o, r4.a0); o = k_push(o, r4.a1); o = k_push(o, r4.a2); o = k_push(o, r4.a3); o = k_push(o, r4.a4);
    return o;
}

pub fn k_f(s0: List[Int]) -> List[Int] {
    let mut s: List[Int] = s0;
    let mut r: Int = 0;
    while r < 24 {
        s = k_theta(s);
        s = k_rhopi(s);
        s = k_chi(s);
        s = k_set(s, 0, k_xor64(k_get(s, 0), k_rc(r)));
        r = r + 1;
    }
    return s;
}

pub fn k_padb(data: String, n: Int, total: Int, pos: Int, domain: Int) -> Int {
    if pos < n {
        return byte_at(data, pos);
    }
    let mut b: Int = 0;
    if pos == n {
        b = domain;
    }
    if pos == total - 1 {
        b = b | 128;
    }
    return b;
}

pub fn k_load8(data: String, n: Int, total: Int, pos: Int, domain: Int) -> K64 {
    let b0: Int = k_padb(data, n, total, pos, domain);
    let b1: Int = k_padb(data, n, total, pos + 1, domain);
    let b2: Int = k_padb(data, n, total, pos + 2, domain);
    let b3: Int = k_padb(data, n, total, pos + 3, domain);
    let b4: Int = k_padb(data, n, total, pos + 4, domain);
    let b5: Int = k_padb(data, n, total, pos + 5, domain);
    let b6: Int = k_padb(data, n, total, pos + 6, domain);
    let b7: Int = k_padb(data, n, total, pos + 7, domain);
    let lo: Int = b0 + (b1 << 8) + (b2 << 16) + (b3 << 24);
    let hi: Int = b4 + (b5 << 8) + (b6 << 16) + (b7 << 24);
    return K64 { hi: hi, lo: lo };
}

pub fn k_hexb(v: Int) -> String {
    let hx: String = "0123456789abcdef";
    let b: Int = v & 255;
    return char_at(hx, (b >> 4) & 15) + char_at(hx, b & 15);
}

pub fn k_hex_lane(w: K64) -> String {
    return k_hexb(w.lo) + k_hexb(w.lo >> 8) + k_hexb(w.lo >> 16) + k_hexb(w.lo >> 24) + k_hexb(w.hi) + k_hexb(w.hi >> 8) + k_hexb(w.hi >> 16) + k_hexb(w.hi >> 24);
}

pub fn k_hex_out(s: List[Int], nbytes: Int) -> String {
    let nl: Int = nbytes / 8;
    let mut out: String = "";
    let mut i: Int = 0;
    while i < nl {
        out = out + k_hex_lane(k_get(s, i));
        i = i + 1;
    }
    return out;
}

pub fn k_hash(data: String, rate: Int, domain: Int, out_len: Int) -> String {
    let n: Int = data.len();
    let total: Int = ((n / rate) + 1) * rate;
    let mut s: List[Int] = k_empty();
    let lanes: Int = rate / 8;
    let mut pos: Int = 0;
    while pos < total {
        let mut i: Int = 0;
        while i < lanes {
            let w: K64 = k_load8(data, n, total, pos + i * 8, domain);
            s = k_set(s, i, k_xor64(k_get(s, i), w));
            i = i + 1;
        }
        s = k_f(s);
        pos = pos + rate;
    }
    return k_hex_out(s, out_len);
}
