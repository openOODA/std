// # Hash Deterministic Law
//
// Logline: A hash function returns the same value for the same state and byte on every call.
//
// Setup: Pure Int. State is a non-negative accumulator; byte is 0..255; out-of-range returns Err. mix(0, 0) is Ok(0).
//
// Beats:
//   1. hash_djb2_mix is a deterministic mixing step: state * 33 + byte.
//   2. hash_fnv1a_mix is a deterministic mixing step with FNV-32 prime.
//   3. Two identical mix sequences must agree byte-for-byte; out-of-range input returns Err.

import "std/core/primitives/domain_cert.oo";

fn hsh_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn hash_djb2_mix(state: Int, b: Int) -> Result[Int, String] {
    if state < 0 { return Err("ERR\thash\tdomain"); }
    if b < 0 { return Err("ERR\thash\tdomain"); }
    if b > 255 { return Err("ERR\thash\tdomain"); }
    let h: Int = (state * 33) + b;
    return Ok(h);
}

pub fn hash_fnv1a_mix(state: Int, b: Int) -> Result[Int, String] {
    if state < 0 { return Err("ERR\thash\tdomain"); }
    if b < 0 { return Err("ERR\thash\tdomain"); }
    if b > 255 { return Err("ERR\thash\tdomain"); }
    let h: Int = (state * 16777619) & 4294967295;
    let h2: Int = h ^ b;
    return Ok(h2);
}

pub fn hash_deterministic_pair(a: Int, b: Int) -> Int {
    if a == b {
        return 1;
    }
    return 0;
}

pub fn hash_deterministic_law(state: Int, b: Int) -> DomainCert {
    let r1: Result[Int, String] = hash_djb2_mix(state, b);
    let r2: Result[Int, String] = hash_djb2_mix(state, b);
    if r1.is_ok() == false {
        return domain_cert("hash", "deterministic", 0);
    }
    if r2.is_ok() == false {
        return domain_cert("hash", "deterministic", 0);
    }
    let ok: Int = hash_deterministic_pair(hsh_got(r1), hsh_got(r2));
    return domain_cert("hash", "deterministic", ok);
}

pub fn verify_hash_deterministic_law() -> Bool {
    // Golden: identical djb2 mix of 5381 and 65 returns same value twice.
    let a1r: Result[Int, String] = hash_djb2_mix(5381, 65);
    let a2r: Result[Int, String] = hash_djb2_mix(5381, 65);
    if a1r.is_ok() == false { return false; }
    if a2r.is_ok() == false { return false; }
    if hash_deterministic_pair(hsh_got(a1r), hsh_got(a2r)) != 1 { return false; }
    // Golden: identical fnv1a mix of offset basis and 65 returns same value twice.
    let f1r: Result[Int, String] = hash_fnv1a_mix(2166136261, 65);
    let f2r: Result[Int, String] = hash_fnv1a_mix(2166136261, 65);
    if f1r.is_ok() == false { return false; }
    if f2r.is_ok() == false { return false; }
    if hash_deterministic_pair(hsh_got(f1r), hsh_got(f2r)) != 1 { return false; }
    // Golden: chained djb2 mix is still deterministic.
    let c1a: Result[Int, String] = hash_djb2_mix(5381, 65);
    let c2a: Result[Int, String] = hash_djb2_mix(5381, 65);
    if c1a.is_ok() == false { return false; }
    if c2a.is_ok() == false { return false; }
    let c1: Result[Int, String] = hash_djb2_mix(hsh_got(c1a), 66);
    let c2: Result[Int, String] = hash_djb2_mix(hsh_got(c2a), 66);
    if c1.is_ok() == false { return false; }
    if c2.is_ok() == false { return false; }
    if hash_deterministic_pair(hsh_got(c1), hsh_got(c2)) != 1 { return false; }
    // Golden: chained fnv1a mix is still deterministic.
    let d1a: Result[Int, String] = hash_fnv1a_mix(2166136261, 65);
    let d2a: Result[Int, String] = hash_fnv1a_mix(2166136261, 65);
    if d1a.is_ok() == false { return false; }
    if d2a.is_ok() == false { return false; }
    let d1: Result[Int, String] = hash_fnv1a_mix(hsh_got(d1a), 66);
    let d2: Result[Int, String] = hash_fnv1a_mix(hsh_got(d2a), 66);
    if d1.is_ok() == false { return false; }
    if d2.is_ok() == false { return false; }
    if hash_deterministic_pair(hsh_got(d1), hsh_got(d2)) != 1 { return false; }
    // Hostile: different bytes give different djb2 outputs.
    let e1: Result[Int, String] = hash_djb2_mix(5381, 65);
    let e2: Result[Int, String] = hash_djb2_mix(5381, 66);
    if e1.is_ok() == false { return false; }
    if e2.is_ok() == false { return false; }
    if hash_deterministic_pair(hsh_got(e1), hsh_got(e2)) != 0 { return false; }
    // Hostile: different bytes give different fnv1a outputs.
    let g1: Result[Int, String] = hash_fnv1a_mix(2166136261, 65);
    let g2: Result[Int, String] = hash_fnv1a_mix(2166136261, 66);
    if g1.is_ok() == false { return false; }
    if g2.is_ok() == false { return false; }
    if hash_deterministic_pair(hsh_got(g1), hsh_got(g2)) != 0 { return false; }
    // Hostile: out-of-range byte returns Err in djb2.
    if hash_djb2_mix(5381, 0 - 1).is_ok() { return false; }
    if hash_djb2_mix(5381, 256).is_ok() { return false; }
    // Hostile: out-of-range byte returns Err in fnv1a.
    if hash_fnv1a_mix(2166136261, 0 - 1).is_ok() { return false; }
    if hash_fnv1a_mix(2166136261, 256).is_ok() { return false; }
    // Hostile: negative state returns Err.
    if hash_djb2_mix(0 - 1, 65).is_ok() { return false; }
    if hash_fnv1a_mix(0 - 1, 65).is_ok() { return false; }
    // Identity: mix(0, 0) is Ok(0).
    let zmix: Result[Int, String] = hash_djb2_mix(0, 0);
    if zmix.is_ok() == false { return false; }
    if hsh_got(zmix) != 0 { return false; }
    let zfnv: Result[Int, String] = hash_fnv1a_mix(0, 0);
    if zfnv.is_ok() == false { return false; }
    if hsh_got(zfnv) != 0 { return false; }
    // DomainCert.holds matches the Int law.
    if hash_deterministic_law(5381, 65).holds != 1 { return false; }
    if hash_deterministic_law(0 - 1, 65).holds != 0 { return false; }
    return true;
}
