// # Linux Landlock LSM Security Policy Engine
//
// Logline: Compiles declarative unprivileged sandboxing rulesets into kernel Landlock LSM access masks.
//
// Setup: Sovereign security ruleset compiler for Landlock ABI v1..v4 capabilities.
//
// Beats:
//   1. Define LandlockAccessFs, LandlockPathRule, and LandlockRuleset structures.
//   2. Translate high-level filesystem operations into Landlock 14-bit access rights.
//   3. Validate path-based rules and enforce immutable default-deny containment.

type LandlockAccessFs = struct {
    read_file: Bool,
    read_dir: Bool,
    write_file: Bool,
    execute_file: Bool,
    create_char: Bool,
    create_dir: Bool,
    create_regular: Bool,
    create_symlink: Bool,
    remove_dir: Bool,
    remove_file: Bool,
    make_char: Bool,
    make_dir: Bool,
    make_reg: Bool,
    make_symlink: Bool
};

type LandlockPathRule = struct {
    path: String,
    access: LandlockAccessFs,
    is_beneath: Bool
};

type LandlockRuleset = struct {
    abi_version: Int,
    handled_access_fs: Int,
    rules: List[LandlockPathRule],
    rule_count: Int,
    is_compiled: Bool
};

pub fn landlock_access_fs_readonly() -> LandlockAccessFs {
    return LandlockAccessFs {
        read_file: true,
        read_dir: true,
        write_file: false,
        execute_file: false,
        create_char: false,
        create_dir: false,
        create_regular: false,
        create_symlink: false,
        remove_dir: false,
        remove_file: false,
        make_char: false,
        make_dir: false,
        make_reg: false,
        make_symlink: false
    };
}

pub fn landlock_access_fs_readwrite() -> LandlockAccessFs {
    return LandlockAccessFs {
        read_file: true,
        read_dir: true,
        write_file: true,
        execute_file: false,
        create_char: false,
        create_dir: true,
        create_regular: true,
        create_symlink: true,
        remove_dir: true,
        remove_file: true,
        make_char: false,
        make_dir: true,
        make_reg: true,
        make_symlink: true
    };
}

pub fn landlock_access_fs_exec_only() -> LandlockAccessFs {
    return LandlockAccessFs {
        read_file: true,
        read_dir: false,
        write_file: false,
        execute_file: true,
        create_char: false,
        create_dir: false,
        create_regular: false,
        create_symlink: false,
        remove_dir: false,
        remove_file: false,
        make_char: false,
        make_dir: false,
        make_reg: false,
        make_symlink: false
    };
}

pub fn landlock_access_to_mask(acc: LandlockAccessFs) -> Int {
    let mut mask: Int = 0;
    if acc.read_file { mask = mask | 1; }
    if acc.read_dir { mask = mask | 2; }
    if acc.write_file { mask = mask | 4; }
    if acc.execute_file { mask = mask | 8; }
    if acc.create_char { mask = mask | 16; }
    if acc.create_dir { mask = mask | 32; }
    if acc.create_regular { mask = mask | 64; }
    if acc.create_symlink { mask = mask | 128; }
    if acc.remove_dir { mask = mask | 256; }
    if acc.remove_file { mask = mask | 512; }
    if acc.make_char { mask = mask | 1024; }
    if acc.make_dir { mask = mask | 2048; }
    if acc.make_reg { mask = mask | 4096; }
    if acc.make_symlink { mask = mask | 8192; }
    return mask;
}

pub fn landlock_ruleset_new(abi_ver: Int) -> LandlockRuleset {
    let empty_rules: List[LandlockPathRule] = list_new();
    let handled_mask: Int = 16383;
    return LandlockRuleset {
        abi_version: abi_ver,
        handled_access_fs: handled_mask,
        rules: empty_rules,
        rule_count: 0,
        is_compiled: false
    };
}

pub fn landlock_ruleset_add_path(
    ruleset: LandlockRuleset,
    path: String,
    access: LandlockAccessFs,
    is_beneath: Bool
) -> LandlockRuleset {
    if ruleset.is_compiled {
        return ruleset;
    }
    let rule: LandlockPathRule = LandlockPathRule {
        path: path,
        access: access,
        is_beneath: is_beneath
    };
    let mut rlist: List[LandlockPathRule] = ruleset.rules;
    rlist = list_push(rlist, rule);
    let r_cnt: Int = ruleset.rule_count;
    return LandlockRuleset {
        abi_version: ruleset.abi_version,
        handled_access_fs: ruleset.handled_access_fs,
        rules: rlist,
        rule_count: r_cnt + 1,
        is_compiled: ruleset.is_compiled
    };
}

pub fn landlock_ruleset_compile(ruleset: LandlockRuleset) -> LandlockRuleset {
    let ver: Int = ruleset.abi_version;
    let cnt: Int = ruleset.rule_count;
    if ver < 1 || cnt == 0 {
        return ruleset;
    }
    return LandlockRuleset {
        abi_version: ruleset.abi_version,
        handled_access_fs: ruleset.handled_access_fs,
        rules: ruleset.rules,
        rule_count: ruleset.rule_count,
        is_compiled: true
    };
}

pub fn landlock_check_access(
    ruleset: LandlockRuleset,
    req_path: String,
    req_mask: Int
) -> Bool {
    let is_c: Bool = ruleset.is_compiled;
    if is_c == false {
        return false;
    }
    let mut i: Int = 0;
    let count: Int = ruleset.rule_count;
    while i < count {
        let r: LandlockPathRule = list_get(ruleset.rules, i);
        let p: String = r.path;
        if p == req_path {
            let rule_mask: Int = landlock_access_to_mask(r.access);
            if (rule_mask & req_mask) == req_mask {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}
