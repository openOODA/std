// # Linux Seccomp BPF Syscall Filter Generator
//
// Logline: Generates and validates classic BPF bytecode instruction sequences for Linux seccomp-bpf syscall filtering.
//
// Setup: Sovereign Seccomp BPF program builder and emulator.
//
// Beats:
//   1. Define BpfInstruction, SyscallRule, and SeccompFilter structures.
//   2. Encode architecture checks, syscall number comparisons, and SECCOMP_RET actions.
//   3. Validate BPF program termination, jump offsets, and default-deny fallback paths.

type BpfInstruction = struct {
    code: Int,
    jt: Int,
    jf: Int,
    k: Int
};

type SeccompAction = struct {
    action_type: Int,
    errno_val: Int
};

type SyscallRule = struct {
    syscall_nr: Int,
    action: SeccompAction,
    inspect_arg: Bool,
    arg_index: Int,
    arg_val: Int,
    arg_op: Int
};

type SeccompFilter = struct {
    arch: Int,
    default_action: SeccompAction,
    rules: List[SyscallRule],
    rule_count: Int,
    instructions: List[BpfInstruction],
    insn_count: Int,
    is_generated: Bool
};

pub fn seccomp_action_kill() -> SeccompAction {
    return SeccompAction { action_type: 0, errno_val: 0 };
}

pub fn seccomp_action_trap() -> SeccompAction {
    return SeccompAction { action_type: 1, errno_val: 0 };
}

pub fn seccomp_action_allow() -> SeccompAction {
    return SeccompAction { action_type: 5, errno_val: 0 };
}

pub fn seccomp_action_errno(err: Int) -> SeccompAction {
    return SeccompAction { action_type: 2, errno_val: err };
}

pub fn seccomp_filter_new(arch: Int, def_action: SeccompAction) -> SeccompFilter {
    let empty_rules: List[SyscallRule] = list_new();
    let empty_insns: List[BpfInstruction] = list_new();
    return SeccompFilter {
        arch: arch,
        default_action: def_action,
        rules: empty_rules,
        rule_count: 0,
        instructions: empty_insns,
        insn_count: 0,
        is_generated: false
    };
}

pub fn seccomp_filter_add_rule(
    filter: SeccompFilter,
    sys_nr: Int,
    action: SeccompAction
) -> SeccompFilter {
    if filter.is_generated {
        return filter;
    }
    let rule: SyscallRule = SyscallRule {
        syscall_nr: sys_nr,
        action: action,
        inspect_arg: false,
        arg_index: 0,
        arg_val: 0,
        arg_op: 0
    };
    let mut rlist: List[SyscallRule] = filter.rules;
    rlist = list_push(rlist, rule);
    let r_cnt: Int = filter.rule_count;
    return SeccompFilter {
        arch: filter.arch,
        default_action: filter.default_action,
        rules: rlist,
        rule_count: r_cnt + 1,
        instructions: filter.instructions,
        insn_count: filter.insn_count,
        is_generated: filter.is_generated
    };
}

pub fn seccomp_action_to_ret_val(act: SeccompAction) -> Int {
    let at: Int = act.action_type;
    if at == 0 { return 0; }
    if at == 1 { return 196608; }
    if at == 2 { return 327680 | (act.errno_val & 65535); }
    if at == 3 { return 458752; }
    if at == 4 { return 1879048192; }
    return 2147418112;
}

pub fn seccomp_filter_generate(filter: SeccompFilter) -> SeccompFilter {
    let mut insns: List[BpfInstruction] = list_new();
    let mut count: Int = 0;

    let insn_ld_arch: BpfInstruction = BpfInstruction { code: 32, jt: 0, jf: 0, k: 4 };
    insns = list_push(insns, insn_ld_arch);
    count = count + 1;

    let insn_chk_arch: BpfInstruction = BpfInstruction { code: 21, jt: 1, jf: 0, k: filter.arch };
    insns = list_push(insns, insn_chk_arch);
    count = count + 1;

    let insn_kill: BpfInstruction = BpfInstruction { code: 6, jt: 0, jf: 0, k: 0 };
    insns = list_push(insns, insn_kill);
    count = count + 1;

    let insn_ld_nr: BpfInstruction = BpfInstruction { code: 32, jt: 0, jf: 0, k: 0 };
    insns = list_push(insns, insn_ld_nr);
    count = count + 1;

    let r_len: Int = filter.rule_count;
    let mut i: Int = 0;
    while i < r_len {
        let r: SyscallRule = list_get(filter.rules, i);
        let act_code: Int = seccomp_action_to_ret_val(r.action);
        let insn_cmp: BpfInstruction = BpfInstruction { code: 21, jt: 0, jf: 1, k: r.syscall_nr };
        insns = list_push(insns, insn_cmp);
        count = count + 1;
        let insn_ret: BpfInstruction = BpfInstruction { code: 6, jt: 0, jf: 0, k: act_code };
        insns = list_push(insns, insn_ret);
        count = count + 1;
        i = i + 1;
    }

    let def_code: Int = seccomp_action_to_ret_val(filter.default_action);
    let insn_def: BpfInstruction = BpfInstruction { code: 6, jt: 0, jf: 0, k: def_code };
    insns = list_push(insns, insn_def);
    count = count + 1;

    return SeccompFilter {
        arch: filter.arch,
        default_action: filter.default_action,
        rules: filter.rules,
        rule_count: filter.rule_count,
        instructions: insns,
        insn_count: count,
        is_generated: true
    };
}

pub fn seccomp_filter_eval(filter: SeccompFilter, sys_nr: Int, arch: Int) -> Int {
    let is_g: Bool = filter.is_generated;
    if is_g == false {
        return 0;
    }
    let f_arch: Int = filter.arch;
    if f_arch != arch {
        return 0;
    }
    let r_len: Int = filter.rule_count;
    let mut i: Int = 0;
    while i < r_len {
        let r: SyscallRule = list_get(filter.rules, i);
        let nr: Int = r.syscall_nr;
        if nr == sys_nr {
            return seccomp_action_to_ret_val(r.action);
        }
        i = i + 1;
    }
    return seccomp_action_to_ret_val(filter.default_action);
}
