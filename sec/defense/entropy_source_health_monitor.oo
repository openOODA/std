// # NIST SP 800-90B Entropy Health Test Monitor
//
// Logline: Implements continuous Repetition Count and Adaptive Proportion health tests on hardware random number generators.
//
// Setup: Cryptographic RNG noise-source continuous health validation module.
//
// Beats:
//   1. Define HealthTestConfig, RctState, and AptState descriptors.
//   2. Run Repetition Count Test (RCT) to detect stuck bit patterns from entropy sources.
//   3. Run Adaptive Proportion Test (APT) to detect statistical distribution collapse.

type EntropyHealthReport = struct {
    rct_passed: Bool,
    apt_passed: Bool,
    consecutive_repeats: Int,
    window_samples_tested: Int,
    is_healthy: Bool
};

type EntropyMonitor = struct {
    rct_cutoff: Int,
    apt_cutoff: Int,
    last_sample: Int,
    repeat_count: Int,
    window_count: Int,
    violations: Int
};

pub fn entropy_monitor_new(rct_cut: Int, apt_cut: Int) -> EntropyMonitor {
    return EntropyMonitor {
        rct_cutoff: rct_cut,
        apt_cutoff: apt_cut,
        last_sample: -1,
        repeat_count: 0,
        window_count: 0,
        violations: 0
    };
}

pub fn entropy_monitor_feed_sample(
    mon: EntropyMonitor,
    sample: Int
) -> EntropyHealthReport {
    // FAIL-CLOSED: this is a structural health monitor, not a statistical
    // battery. The Adaptive Proportion Test (SP 800-90B §4.4.2) requires a
    // windowed count of the most-frequent value and an exact cutoff
    // comparison; the in-window accumulation lives in the caller. Until a
    // real APT implementation lands, mark apt_passed=false and let the
    // consumer decide whether to consume entropy from this source.
    mon.window_count = mon.window_count + 1;
    let mut rct_ok: Bool = true;

    if sample == mon.last_sample {
        mon.repeat_count = mon.repeat_count + 1;
        if mon.repeat_count >= mon.rct_cutoff {
            rct_ok = false;
            mon.violations = mon.violations + 1;
        }
    } else {
        mon.last_sample = sample;
        mon.repeat_count = 1;
    }

    let healthy: Bool = false;

    return EntropyHealthReport {
        rct_passed: rct_ok,
        apt_passed: false,
        consecutive_repeats: mon.repeat_count,
        window_samples_tested: mon.window_count,
        is_healthy: healthy
    };
}
