    return SandboxConfig {
        read_allowlist: cfg.read_allowlist,
        write_allowlist: cfg.write_allowlist,
        max_mem_mb: cfg.max_mem_mb,
        max_cpu_sec: sec,
        max_nofile: cfg.max_nofile,
        allowed_caps_mask: cfg.allowed_caps_mask,
        fail_closed: cfg.fail_closed
    };
