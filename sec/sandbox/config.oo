pub fn sandbox_config_with_caps_mask(cfg: SandboxConfig, mask: Int) -> SandboxConfig {
    return SandboxConfig {
        read_allowlist: cfg.read_allowlist,
        write_allowlist: cfg.write_allowlist,
        max_mem_mb: cfg.max_mem_mb,
        max_cpu_sec: cfg.max_cpu_sec,
        max_nofile: cfg.max_nofile,
        allowed_caps_mask: mask,
        fail_closed: cfg.fail_closed
    };
}

pub fn sandbox_config_validate_paths(paths: List[String]) -> Result[Bool, String] {
    let n: Int = list_len(paths);
    let mut i: Int = 0;
    while i < n {
        let p: String = list_get(paths, i);
        if chars_len(p) == 0 {
            return Err("sandbox: path must not be empty");
        }
        if str_slice(p, 0, 1) != "/" {
            return Err("sandbox: path must be absolute: " + p);
        }
        if str_contains(p, ":") {
            return Err("sandbox: path must not contain colon delimiter: " + p);
        }
        i = i + 1;
    }
    return Ok(true);
}

pub fn sandbox_config_paths_to_colon(paths: List[String]) -> String {
    let n: Int = list_len(paths);
    if n == 0 {
        return "";
    }
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let p: String = list_get(paths, i);
        if i > 0 {
            out = out + ":";
        }
        out = out + p;
        i = i + 1;
    }
    return out;
}
