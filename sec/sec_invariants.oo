// # Security default-deny grant law
//
// Logline: A missing token (0) cannot grant; only a nonzero token may grant.
//
// Setup: Pure Int token flag. No capability objects.
//
// Beats:
//   1. sec_grant_ok(0) holds=0 (default-deny).
//   2. sec_grant_ok(nonzero) holds=1.
//   3. domain_cert boxes the holds bit for the sec domain.
//
// residual: Int token model only; not a live capability check

import "std/core/primitives/domain_cert.oo";
pub fn sec_grant_ok(token: Int) -> Int {
    if token == 0 {
        return 0;
    }
    return 1;
}

pub fn sec_grant_law(token: Int) -> DomainCert {
    return domain_cert("sec", "grant_ok", sec_grant_ok(token));
}
