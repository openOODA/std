// # Refuse secret struct field in process_exec
//
// Logline: Passing a secret struct field payload to process_exec must fail closed.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag secret_cmd as secret.
//   2. Build CmdConfig with secret payload.
//   3. Pass cfg.payload to process_exec so the sink refuses.
//
// secret in struct field must not reach process_exec
type CmdConfig = struct { payload: String };
// SECRET: secret_cmd
pub fn verify_secret_struct_field_process_exec_fail(p: &ProcessCap) -> Bool {
    let secret_cmd = "s3cret-payload";
    let cfg = CmdConfig { payload: secret_cmd };
    let r = process_exec(p, cfg.payload);
    println(1);
    return false;
}
