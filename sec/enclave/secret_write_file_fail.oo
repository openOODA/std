// # Refuse secret write_file body
//
// Logline: Pass a secret IDENT as write_file content so the sink must refuse.
//
// Setup: Test fixture. Keep the SECRET tag and all code exact.
//
// Beats:
//   1. Tag token as secret.
//   2. Call write_file with token as content.
//   3. Print 1 after the call.
//
// M128: Secret content must not reach write_file
// SECRET: token
pub fn verify_secret_write_file_fail(fs: &FsWriteCap) -> Bool {
    let token = "s3cret";
    let path = "/tmp/ooda_secret_sink_should_not_write";
    let r = write_file(fs, path, token);
    println(1);
    return false;
}
