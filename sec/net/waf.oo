// # WAF Re-export Shim
//
// Logline: Re-export shim for WAF submodules; forwards HTTP request, rule, and engine constructors.
//
// Setup: Imports waf_types, waf_http, waf_rule, waf_engine, and waf_inspect.
//
// Beats:
//   1. shim_marker_http_request_create: forward http_request_create.
//   2. shim_marker_waf_action_allow: forward waf_action_allow.
//   3. shim_marker_waf_rule_create: forward waf_rule_create.
//   4. shim_marker_waf_ruleset_create: forward waf_ruleset_create.
//   5. shim_marker_waf_engine_init: forward waf_engine_init.

import "std/sec/net/waf_types.oo";
import "std/sec/net/waf_http.oo";
import "std/sec/net/waf_rule.oo";
import "std/sec/net/waf_engine.oo";
import "std/sec/net/waf_inspect.oo";

pub fn shim_marker_http_request_create() -> HttpRequest {
    return http_request_create("GET", "/", "", "127.0.0.1", "test-agent");
}

pub fn shim_marker_http_request_add_header(req: HttpRequest) -> HttpRequest {
    return http_request_add_header(req, "Host", "example.com");
}

pub fn shim_marker_http_request_is_valid(req: &HttpRequest) -> Bool {
    return http_request_is_valid(req);
}

pub fn shim_marker_waf_action_allow() -> WafAction {
    return waf_action_allow();
}

pub fn shim_marker_waf_rule_create() -> WafRule {
    return waf_rule_create("R1", "test", "SQLI", "' OR ", "ALL", "BLOCK", 9);
}

pub fn shim_marker_waf_ruleset_create() -> WafRuleSet {
    return waf_ruleset_create("rs-1", "default");
}

pub fn shim_marker_waf_engine_init() -> WafEngine {
    let cfg: WafEngineConfig = waf_config_default();
    return waf_engine_init(cfg);
}

pub fn shim_marker_waf_engine_inspect(e: &WafEngine, req: &HttpRequest) -> Result[WafInspectionResult, String] {
    return waf_engine_inspect_request(e, req, 0);
}

pub fn __dummy_std_src_ooda_sec_net_waf_oo() -> Int {
    return 0;
}
