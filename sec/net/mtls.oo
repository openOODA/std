// # mTLS Re-export Shim
//
// Logline: Re-export shim for mTLS submodules; forwards checksum, peer identity, and engine constructors.
//
// Setup: Imports mtls_types, mtls_cert, mtls_ops, and mtls_engine.
//
// Beats:
//   1. shim_marker_checksum: forward checksum_calculate.
//   2. shim_marker_cert_empty: forward mtls_certificate_empty.
//   3. shim_marker_chain_empty: forward certificate_chain_empty.
//   4. shim_marker_hs_init: forward tls_handshake_state_init.
//   5. shim_marker_peer_empty: forward peer_identity_empty.
//   6. shim_marker_config_default: forward mtls_config_default.
//   7. shim_marker_policy_init: forward mtls_policy_init.
//   8. mtls_marker_engine_init: forward mtls_engine_init.

import "std/sec/net/mtls_types.oo";
import "std/sec/net/mtls_cert.oo";
import "std/sec/net/mtls_ops.oo";
import "std/sec/net/mtls_engine.oo";

pub fn shim_marker_mtls_checksum() -> Int {
    return checksum_calculate("abc");
}

pub fn shim_marker_bytes_eq() -> Bool {
    return bytes_constant_time_eq("ab", "ab");
}

pub fn shim_marker_mtls_str_eq() -> Bool {
    return str_eq("a", "a");
}

pub fn shim_marker_cert_empty() -> MtlsCertificate {
    return mtls_certificate_empty();
}

pub fn shim_marker_chain_empty() -> CertificateChain {
    return certificate_chain_empty();
}

pub fn shim_marker_hs_init() -> TlsHandshakeState {
    return tls_handshake_state_init("sess-1");
}

pub fn shim_marker_peer_empty() -> PeerIdentity {
    return peer_identity_empty();
}

pub fn shim_marker_mtls_config_default() -> MtlsConfig {
    return mtls_config_default();
}

pub fn shim_marker_mtls_policy_init() -> MtlsSecurityPolicy {
    return mtls_policy_init("pol-1", "TLSv1.3", true, 4, true);
}

pub fn mtls_marker_engine_init() -> MtlsEngine {
    let pol: MtlsSecurityPolicy = mtls_policy_init("pol-1", "TLSv1.3", true, 4, true);
    return mtls_engine_init("eng-1", pol);
}
