// # JWT Core Types
//
// Logline: Define JwtHeader, JwtPayload, and JwtToken records; bind claims, alg, kid, and is_valid.
//
// Setup: rules.oot 1.4 default-deny; rules.oot 1.3 fail-closed residual.
//
// Beats:
//   1. JwtHeader: bind alg, typ, cty, kid, is_valid.
//   2. JwtPayload: bind sub, iss, aud, exp, nbf, iat, jti, roles, custom claims.
//   3. JwtToken: bind raw_token, header, payload, signature, issued_at.
//   4. jwt_payload_claim_get: lookup custom claim by key.
//
// residual: struct-only module; no crypto.

// rules.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required where applicable.
// rules.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

// -------------------------------------------------------------------
// Core Data Structures & Realistic Types
// -------------------------------------------------------------------

type JwtHeader = struct {
    alg: String,
    typ: String,
    cty: String,
    kid: String,
    is_valid: Bool
};

type JwtPayload = struct {
    sub: String,
    iss: String,
    aud: String,
    exp: Int,
    nbf: Int,
    iat: Int,
    jti: String,
    roles: List[String],
    custom_claim_keys: List[String],
    custom_claim_vals: List[String],
    is_valid: Bool
};

type JwtToken = struct {
    raw_token: String,
    header: JwtHeader,
    payload: JwtPayload,
    signature: String,
    signing_algorithm: String,
    issued_at: Int,
    expires_at: Int,
    is_verified: Bool,
    is_revoked: Bool,
    is_valid: Bool
};

type JwtConfig = struct {
    secret: String,
    algorithm: String,
    issuer: String,
    audience: String,
    default_ttl_seconds: Int,
    is_valid: Bool
};

type JwtValidationRules = struct {
    require_exp: Bool,
    require_nbf: Bool,
    require_iss: Bool,
    require_aud: Bool,
    expected_issuer: String,
    expected_audience: String,
    clock_skew_seconds: Int,
    allowed_algorithms: List[String],
    is_active: Bool
};

type JwtVerificationResult = struct {
    is_valid: Bool,
    subject: String,
    issuer: String,
    error_code: String,
    error_description: String,
    verification_time: Int
};

type JwtEngine = struct {
    engine_id: String,
    config: JwtConfig,
    validation_rules: JwtValidationRules,
    issued_tokens: List[JwtToken],
    revoked_jtis: List[String],
    tokens_issued: Int,
    tokens_verified: Int,
    tokens_rejected: Int,
    system_halted: Bool
};

pub fn jwt_token_create(
    header: JwtHeader,
    payload: JwtPayload,
    raw_token: String,
    signature: String
) -> Result[JwtToken, String] {
    let tok: JwtToken = JwtToken {
        raw_token: raw_token,
        header: header,
        payload: payload,
        signature: signature,
        signing_algorithm: header.alg,
        issued_at: payload.iat,
        expires_at: payload.exp,
        is_verified: false,
        is_revoked: false,
        is_valid: true
    };
    return Ok(tok);
}

pub fn jwt_token_is_valid(token: JwtToken, current_time: Int, config: JwtConfig) -> Bool {
    if token.is_valid == false { return false; }
    if token.is_revoked { return false; }
    if token.expires_at > 0 && current_time > token.expires_at { return false; }
    return true;
}

