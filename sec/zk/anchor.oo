pub fn zk_mod_groth16_verify(vk: Groth16VerifyingKey, proof: Groth16Proof, public_inputs: List[Int]) -> Result[Bool, String] { return groth16_verify(vk, proof, public_inputs); }
pub fn zk_mod_plonk_verify(vk: PlonkVerifyingKey, proof: PlonkProof, public_inputs: List[Int]) -> Result[Bool, String] { return plonk_verify(vk, proof, public_inputs); }
pub fn zk_mod_bulletproofs_range(prover_inst: BulletproofsRangeProver, proof: BulletproofsRangeProof) -> Bool { return bulletproofs_range_verify(prover_inst, proof); }
pub fn zk_mod_bn254_pairing(g1: Bn254G1Affine, g2: Bn254G2Affine) -> Bn254Gt { return bn254_pairing(g1, g2); }
pub fn zk_mod_poseidon_hash(msg: List[Int]) -> PosOut { return poseidon_sponge_hash(msg); }
