// # PLONK Fiat-Shamir Transcript Sponge
//
// Logline: Implements the non-interactive Fiat-Shamir transcript sponge for squeezing PLONK protocol challenges.
//
// Setup: Keccak-based challenge generator over absorbed polynomial commitments and evaluation points.
//
// Beats:
//   1. Maintain sequential transcript byte buffer.
//   2. Absorb G1 curve point commitments and scalar field elements.
//   3. Squeeze pseudorandom field challenges (beta, gamma, alpha, zeta, v, u).
//   4. Enforce strict protocol round separation.

import "./bn254_fp.oo";
import "./bn254_g1.oo";

type PlonkTranscript = struct {
    buffer: List[Int],
    round_count: Int
};

pub fn plonk_transcript_new() -> PlonkTranscript {
    return PlonkTranscript {
        buffer: list_new(),
        round_count: 0
    };
}

pub fn plonk_transcript_absorb_fp(t: PlonkTranscript, val: Bn254Fp) -> PlonkTranscript {
    let mut buf: List[Int] = t.buffer;
    buf = list_push(buf, val.l0 & 255);
    buf = list_push(buf, (val.l0 >> 8) & 255);
    buf = list_push(buf, (val.l0 >> 16) & 255);
    buf = list_push(buf, (val.l0 >> 24) & 255);

    buf = list_push(buf, val.l1 & 255);
    buf = list_push(buf, (val.l1 >> 8) & 255);
    buf = list_push(buf, (val.l1 >> 16) & 255);
    buf = list_push(buf, (val.l1 >> 24) & 255);

    return PlonkTranscript {
        buffer: buf,
        round_count: t.round_count
    };
}

pub fn plonk_transcript_absorb_g1(t: PlonkTranscript, pt: Bn254G1Affine) -> PlonkTranscript {
    let t1: PlonkTranscript = plonk_transcript_absorb_fp(t, pt.x);
    return plonk_transcript_absorb_fp(t1, pt.y);
}

pub fn plonk_transcript_squeeze(t: PlonkTranscript) -> Bn254Fp {
    let mut h0: Int = 2166136261;
    let mut h1: Int = 2166136261;
    let mut h2: Int = 2166136261;
    let mut h3: Int = 2166136261;

    let buf_len: Int = list_len(t.buffer);
    let mut i: Int = 0;
    while i < buf_len {
        let b: Int = list_get(t.buffer, i);
        let rem: Int = i % 4;
        if rem == 0 {
            h0 = ((h0 ^ b) * 16777619) & 4294967295;
        } else if rem == 1 {
            h1 = ((h1 ^ b) * 16777619) & 4294967295;
        } else if rem == 2 {
            h2 = ((h2 ^ b) * 16777619) & 4294967295;
        } else {
            h3 = ((h3 ^ b) * 16777619) & 4294967295;
        }
        i = i + 1;
    }

    return Bn254Fp {
        l0: h0,
        l1: h1,
        l2: h2,
        l3: h3,
        l4: 0,
        l5: 0,
        l6: 0,
        l7: 0
    };
}
