// # Groth16 Zero-Knowledge SNARK Verification Engine
//
// Logline: Evaluates the Groth16 4-pairing equation e(A, B) = e(alpha, beta) * e(L, gamma) * e(C, delta) over BN254.
//
// Setup: Fail-closed zero-knowledge verification engine accumulating public inputs into IC linear combination L.
//
// Beats:
//   1. Validate public input count against IC vector length (|x| + 1 == |IC|).
//   2. Accumulate public input linear combination L = IC_0 + sum(x_i * IC_i).
//   3. Compute the four bilinear pairings: e(A,B), e(alpha,beta), e(L,gamma), e(C,delta).
//   4. Validate equality e(A, B) == e(alpha, beta) * e(L, gamma) * e(C, delta).

import "./bn254_fp.oo";
import "./bn254_fp12.oo";
import "./bn254_g1.oo";
import "./bn254_g2.oo";
import "./bn254_pairing.oo";
import "./groth16_types.oo";

pub fn groth16_verify(vk: Groth16VerifyingKey, proof: Groth16Proof, public_inputs: List[Int]) -> Result[Bool, String] {
    if !proof.is_valid {
        return Err("ERR\tgroth16_verify: malformed proof structure");
    }

    let n_pub: Int = list_len(public_inputs);
    let total_ic_pts: Int = list_len(vk.ic_coords) / 16;
    if (n_pub + 1) != total_ic_pts {
        return Err("ERR\tgroth16_verify: public input count mismatch with IC vector");
    }

    let mut l_acc: Bn254G1Affine = if total_ic_pts > 0 { groth16_ic_get_point(vk.ic_coords, 0) } else { bn254_g1_infinity() };
    let mut i: Int = 0;
    while i < n_pub {
        let input_val: Int = list_get(public_inputs, i);
        let ic_pt: Bn254G1Affine = groth16_ic_get_point(vk.ic_coords, i + 1);
        let scaled: Bn254G1Affine = bn254_g1_scalar_mul(ic_pt, input_val);
        l_acc = bn254_g1_add(l_acc, scaled);
        i = i + 1;
    }

    let e_ab: Bn254Gt = bn254_pairing(proof.a_g1, proof.b_g2);
    let e_ab_vk: Bn254Gt = bn254_pairing(vk.alpha_g1, vk.beta_g2);
    let e_lg: Bn254Gt = bn254_pairing(l_acc, vk.gamma_g2);
    let e_cd: Bn254Gt = bn254_pairing(proof.c_g1, vk.delta_g2);

    let rhs_part: Bn254Gt = bn254_gt_mul(e_ab_vk, e_lg);
    let rhs: Bn254Gt = bn254_gt_mul(rhs_part, e_cd);

    if bn254_fp12_equal(e_ab.val, rhs.val) {
        return Ok(true);
    }
    return Err("ERR\tgroth16_verify: pairing equation failed");
}
