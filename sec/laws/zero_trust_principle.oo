// # Zero Trust Heuristic Principle
//
// Logline: Treat every request as if it arrived from an open network: require auth, authz, audit, and integrity on every call.
//
// Setup: Pure Int flag bits. zt_required_checks returns 1 only if all four checks are present. Missing checks fail closed.
//
// Beats:
//   1. Check bits: 1 AUTH, 2 AUTHZ, 4 AUDIT, 8 INTEGRITY.
//   2. All-present test: mask == 1|2|4|8 = 15 returns 1.
//   3. Missing-flag test: any of the four missing returns 0.
//   4. Hosts sec_invariants.oo stem for default-deny cross-link.

import "std/sec/sec_invariants.oo";
import "std/core/primitives/domain_cert.oo";

// Zero trust check bits: 1 AUTH, 2 AUTHZ, 4 AUDIT, 8 INTEGRITY.
pub fn zt_bit_auth() -> Int { return 1; }
pub fn zt_bit_authz() -> Int { return 2; }
pub fn zt_bit_audit() -> Int { return 4; }
pub fn zt_bit_integrity() -> Int { return 8; }

// Full required mask: all four checks present.
pub fn zt_full_mask() -> Int {
    return 1 + 2 + 4 + 8;
}

// Whether `check` is set in `mask` (each bit 0..15 walked manually).
pub fn zt_has_bit(mask: Int, check: Int) -> Int {
    if mask < 0 { return 0; }
    if check <= 0 { return 0; }
    if (mask & check) == check { return 1; }
    return 0;
}

// Count how many of the four bits are set in `mask`. Used by diagnostics.
fn ztc_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn zt_count_present(mask: Int) -> Result[Int, String] {
    if mask < 0 { return Err("ERR\tztc\tdomain"); }
    let mut c: Int = 0;
    if zt_has_bit(mask, 1) == 1 { c = c + 1; }
    if zt_has_bit(mask, 2) == 1 { c = c + 1; }
    if zt_has_bit(mask, 4) == 1 { c = c + 1; }
    if zt_has_bit(mask, 8) == 1 { c = c + 1; }
    return Ok(c);
}

// Required check: returns 1 if auth, authz, audit, and integrity are all present in the request mask.
pub fn zt_required_checks(request_mask: Int) -> Int {
    if zt_has_bit(request_mask, 1) != 1 { return 0; }
    if zt_has_bit(request_mask, 2) != 1 { return 0; }
    if zt_has_bit(request_mask, 4) != 1 { return 0; }
    if zt_has_bit(request_mask, 8) != 1 { return 0; }
    return 1;
}

// Domain certificate for the zero trust principle.
pub fn zero_trust_law(request_mask: Int) -> DomainCert {
    let h: Int = zt_required_checks(request_mask);
    return domain_cert("sec", "zero_trust_required", h);
}

// KAT and hostile cases for the zero trust principle.
pub fn verify_zero_trust_principle() -> Bool {
    let sec_inv_ok: Int = sec_grant_ok(1);
    if sec_inv_ok != 1 { return false; }
    if zt_full_mask() != 15 { return false; }
    if zt_bit_auth() != 1 { return false; }
    if zt_bit_authz() != 2 { return false; }
    if zt_bit_audit() != 4 { return false; }
    if zt_bit_integrity() != 8 { return false; }
    let c1: DomainCert = zero_trust_law(15);
    if c1.holds != 1 { return false; }
    let c2: DomainCert = zero_trust_law(7);
    if c2.holds != 0 { return false; }
    let c3: DomainCert = zero_trust_law(11);
    if c3.holds != 0 { return false; }
    let c4: DomainCert = zero_trust_law(13);
    if c4.holds != 0 { return false; }
    let c5: DomainCert = zero_trust_law(14);
    if c5.holds != 0 { return false; }
    let c6: DomainCert = zero_trust_law(0);
    if c6.holds != 0 { return false; }
    let c7: DomainCert = zero_trust_law(0 - 1);
    if c7.holds != 0 { return false; }
    let c8: DomainCert = zero_trust_law(31);
    if c8.holds != 1 { return false; }
    let c9: DomainCert = zero_trust_law(16);
    if c9.holds != 0 { return false; }
    if zt_has_bit(15, 1) != 1 { return false; }
    if zt_has_bit(15, 8) != 1 { return false; }
    if zt_has_bit(15, 16) != 0 { return false; }
    if zt_has_bit(7, 8) != 0 { return false; }
    if zt_has_bit(0 - 1, 1) != 0 { return false; }
    if zt_has_bit(15, 0) != 0 { return false; }
    if ztc_got(zt_count_present(15)) != 4 { return false; }
    if ztc_got(zt_count_present(7)) != 3 { return false; }
    if ztc_got(zt_count_present(11)) != 3 { return false; }
    if ztc_got(zt_count_present(13)) != 3 { return false; }
    if ztc_got(zt_count_present(14)) != 3 { return false; }
    let zmask: Result[Int, String] = zt_count_present(0);
    if zmask.is_ok() == false { return false; }
    if ztc_got(zmask) != 0 { return false; }
    if ztc_got(zt_count_present(16)) != 0 { return false; }
    if zt_count_present(0 - 1).is_ok() { return false; }
    return true;
}
