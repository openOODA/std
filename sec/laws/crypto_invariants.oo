// # Crypto key length law
//
// Logline: An empty key is not a valid key; keys need length at least 16.
//
// Setup: Pure String length check. No digest or cipher calls.
//
// Beats:
//   1. crypto_key_ok("") holds=0.
//   2. crypto_key_ok with len>=16 holds=1.
//   3. domain_cert boxes the holds bit for the crypto domain.
//
// residual: length gate only; not key material or KAT coverage

import "std/core/primitives/domain_cert.oo";
pub fn crypto_key_ok(key: String) -> Int {
    let n: Int = key.len();
    if n >= 16 {
        return 1;
    }
    return 0;
}

pub fn crypto_key_law(key: String) -> DomainCert {
    return domain_cert("crypto", "key_ok", crypto_key_ok(key));
}
