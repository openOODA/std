// # crypto literature KAT (post-2010 NIST PQC + SNARK)
//
// Logline: The five post-2010 cryptographic parameters match the documented standards: FIPS 203 ML-KEM-768, FIPS 204 ML-DSA-65, FIPS 205 SLH-DSA-SHA2-128s, BLS12-381 r from the IRTF CFRG BLS Signatures draft, and the PLONK 2019 paper publication year.
//
// Setup: Pure Int + String. Each constant is asserted exactly within 0.001% spec tolerance; BLS12-381 r is held as its 64-hex-digit canonical form to keep the 256-bit value in-band.
//
// RULES.oot 1.7: Under 256 lines; pure Int + String; no abs_f, close, or pow; uses * and %.
//
// Beats:
//   1. FIPS 203 ML-KEM-768: n=256, k=3, q=3329, eta1=2, eta2=2, du=10, dv=4 (NIST FIPS 203, Aug 2024, §8 Table 2).
//   2. FIPS 204 ML-DSA-65: n=256, k=6, q=8380417 (NIST FIPS 204, Aug 2024, §5 Table 1).
//   3. FIPS 205 SLH-DSA-SHA2-128s: n=16 (NIST FIPS 205, Aug 2024, §4 Table 1; n is the SHA-256 output size for SHA2 parameter set).
//   4. BLS12-381 r: canonical 64-hex-digit form (IRTF CFRG "BLS Signatures" draft v4 §1.1).
//   5. PLONK paper: Gabizon, Williamson, Ciobotaru, CCS 2019, IACR ePrint 2019/953.
//   6. domain_cert("crypto", "crypto_kat", holds).

import "std/core/primitives/domain_cert.oo";

// (a) FIPS 203 ML-KEM-768 (Module-Lattice-Based KEM) parameter set.
//   Source: NIST FIPS 203 (Aug 2024) §8 Table 2, ML-KEM-768 row.
//   n=256  -- ring dimension for R_q = Z_q[X] / (X^n + 1).
//   k=3    -- module rank (k=3 vectors of n-coefficient polynomials).
//   q=3329 -- prime modulus, FIPS 203 §4.1 (q = 2^8 * 13 + 1).
//   eta1=2 -- centre binomial distribution parameter for secret noise (s, e).
//   eta2=2 -- centre binomial distribution parameter for ciphertext noise.
//   du=10  -- compression bit-width for u (FIPS 203 §4.1.2).
//   dv=4   -- compression bit-width for v (FIPS 203 §4.1.2).
pub fn kat_ml_kem_768_n() -> Int { return 256; }
pub fn kat_ml_kem_768_k() -> Int { return 3; }
pub fn kat_ml_kem_768_q() -> Int { return 3329; }
pub fn kat_ml_kem_768_eta1() -> Int { return 2; }
pub fn kat_ml_kem_768_eta2() -> Int { return 2; }
pub fn kat_ml_kem_768_du() -> Int { return 10; }
pub fn kat_ml_kem_768_dv() -> Int { return 4; }

// (b) FIPS 204 ML-DSA-65 (Module-Lattice-Based Digital Signature Algorithm) parameter set.
//   Source: NIST FIPS 204 (Aug 2024) §5 Table 1, ML-DSA-65 row.
//   n=256     -- ring dimension.
//   k=6       -- number of rows in public-key matrix A.
//   q=8380417 -- prime modulus, FIPS 204 §5 (q = 2^23 - 2^13 + 1).
pub fn kat_ml_dsa_65_n() -> Int { return 256; }
pub fn kat_ml_dsa_65_k() -> Int { return 6; }
pub fn kat_ml_dsa_65_q() -> Int { return 8380417; }

// (c) FIPS 205 SLH-DSA-SHA2-128s (Stateless Hash-Based Digital Signature
// Algorithm with SHA-256, 128-bit security, "s" slow variant) parameter n.
//   Source: NIST FIPS 205 (Aug 2024) §4 Table 1, SLH-DSA-SHA2-128s row.
//   n=16  -- output size in bytes of the SHA-256 hash function used (16 bytes = 128 bits),
//            the parameter n in the FIPS 205 spec.
pub fn kat_slh_dsa_sha2_128s_n() -> Int { return 16; }

// (d) BLS12-381 scalar field order r (canonical hex form).
//   Source: IRTF CFRG "BLS Signatures" draft v4 §1.1 (2024) and the BLS12-381
//   paper. r = 0x73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001.
//   Held as 64-hex-digit string to keep the 256-bit value in-band.
pub fn kat_bls12_381_r_hex() -> String {
    return "73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001";
}

// (e) PLONK paper publication year.
//   Source: Gabizon, Williamson, Ciobotaru, "PLONK: Permutations over
//   Lagrange-bases for Oecumenical Noninteractive arguments of Knowledge",
//   ACM CCS 2019; IACR ePrint 2019/953.
pub fn kat_plonk_paper_year() -> Int { return 2019; }

// domain_cert wrapper for the crypto_kat literature lock.
pub fn crypto_kat_holds() -> DomainCert {
    if kat_ml_kem_768_n() != 256 { return domain_cert("crypto", "crypto_kat", 0); }
    if kat_ml_kem_768_k() != 3 { return domain_cert("crypto", "crypto_kat", 0); }
    if kat_ml_kem_768_q() != 3329 { return domain_cert("crypto", "crypto_kat", 0); }
    if kat_ml_dsa_65_n() != 256 { return domain_cert("crypto", "crypto_kat", 0); }
    if kat_ml_dsa_65_k() != 6 { return domain_cert("crypto", "crypto_kat", 0); }
    if kat_ml_dsa_65_q() != 8380417 { return domain_cert("crypto", "crypto_kat", 0); }
    if kat_slh_dsa_sha2_128s_n() != 16 { return domain_cert("crypto", "crypto_kat", 0); }
    if kat_plonk_paper_year() != 2019 { return domain_cert("crypto", "crypto_kat", 0); }
    return domain_cert("crypto", "crypto_kat", 1);
}

pub fn verify_crypto_kat() -> Bool {
    // (a) FIPS 203 ML-KEM-768: 0.001% precision exact match.
    if kat_ml_kem_768_n() != 256 { return false; }
    if kat_ml_kem_768_k() != 3 { return false; }
    if kat_ml_kem_768_q() != 3329 { return false; }
    if kat_ml_kem_768_eta1() != 2 { return false; }
    if kat_ml_kem_768_eta2() != 2 { return false; }
    if kat_ml_kem_768_du() != 10 { return false; }
    if kat_ml_kem_768_dv() != 4 { return false; }
    // FIPS 203 §4.1: q = 2^8 * 13 + 1 = 3329 exactly.
    if kat_ml_kem_768_q() != 256 * 13 + 1 { return false; }

    // (b) FIPS 204 ML-DSA-65: 0.001% precision exact match.
    if kat_ml_dsa_65_n() != 256 { return false; }
    if kat_ml_dsa_65_k() != 6 { return false; }
    if kat_ml_dsa_65_q() != 8380417 { return false; }
    // FIPS 204 §5: q = 2^23 - 2^13 + 1 = 8380417 exactly.
    if kat_ml_dsa_65_q() != 8388608 - 8192 + 1 { return false; }

    // (c) FIPS 205 SLH-DSA-SHA2-128s: n=16.
    if kat_slh_dsa_sha2_128s_n() != 16 { return false; }

    // (d) BLS12-381 r: 64-hex-digit canonical form.
    if kat_bls12_381_r_hex() != "73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001" { return false; }
    if kat_bls12_381_r_hex().len() != 64 { return false; }

    // (e) PLONK paper year: 2019.
    if kat_plonk_paper_year() != 2019 { return false; }

    // Coupled: domain_cert holds=1.
    let c1: DomainCert = crypto_kat_holds();
    if c1.holds != 1 { return false; }
    if c1.domain != "crypto" { return false; }
    if c1.law_name != "crypto_kat" { return false; }

    return true;
}
