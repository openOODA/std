// # Biba Integrity Law
//
// Logline: Subjects may not read down or write up across an integrity level lattice.
//
// Setup: Pure Int. Integrity levels 0..3. Out-of-range levels fail closed to deny.
//
// Beats:
//   1. Biba low-water-mark: read down is forbidden (subject integrity must dominate object).
//   2. Biba strict integrity star-property: write up is forbidden (subject must not exceed object).
//   3. Dual-of-Bell-LaPadula: the lattice of integrity levels.
//   4. Hosts sec_invariants.oo stem for cross-law correlation.

import "std/sec/sec_invariants.oo";

// Minimum integrity level (low-integrity / untrusted).
pub fn biba_level_min() -> Int {
    return 0;
}

// Maximum integrity level (high-integrity / trusted).
pub fn biba_level_max() -> Int {
    return 3;
}

// True if the integrity level is in 0..3.
pub fn biba_valid_level(level: Int) -> Bool {
    if level < 0 { return false; }
    if level > 3 { return false; }
    return true;
}

// Strict integrity: a subject may read an object only if
// subject integrity <= object integrity (no read down; subject must not exceed object).
pub fn biba_can_read(subject_integrity: Int, object_integrity: Int) -> Bool {
    if biba_valid_level(subject_integrity) == false { return false; }
    if biba_valid_level(object_integrity) == false { return false; }
    return subject_integrity <= object_integrity;
}

// Strict integrity star: a subject may write an object only if
// subject integrity >= object integrity (no write up).
pub fn biba_can_write(subject_integrity: Int, object_integrity: Int) -> Bool {
    if biba_valid_level(subject_integrity) == false { return false; }
    if biba_valid_level(object_integrity) == false { return false; }
    return subject_integrity >= object_integrity;
}

fn bjg_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Highest integrity level among two candidates. Join of min levels is Ok(0). Invalid is Err.
pub fn biba_join(a: Int, b: Int) -> Result[Int, String] {
    if biba_valid_level(a) == false { return Err("ERR\tbjg\tdomain"); }
    if biba_valid_level(b) == false { return Err("ERR\tbjg\tdomain"); }
    if a > b { return Ok(a); }
    return Ok(b);
}

// KAT and hostile cases for the Biba integrity law.
pub fn verify_biba_law() -> Bool {
    let sec_inv_ok: Int = sec_grant_ok(1);
    if sec_inv_ok != 1 { return false; }
    if biba_can_read(2, 2) == false { return false; }
    if biba_can_read(1, 3) == false { return false; }
    if biba_can_read(3, 1) == true { return false; }
    if biba_can_read(0, 3) == false { return false; }
    if biba_can_write(3, 2) == false { return false; }
    if biba_can_write(2, 2) == false { return false; }
    if biba_can_write(1, 3) == true { return false; }
    if biba_can_write(3, 3) == false { return false; }
    if biba_can_read(0 - 1, 2) == true { return false; }
    if biba_can_read(2, 4) == true { return false; }
    if biba_can_write(0 - 1, 2) == true { return false; }
    if biba_can_write(2, 4) == true { return false; }
    if bjg_got(biba_join(2, 3)) != 3 { return false; }
    if bjg_got(biba_join(3, 2)) != 3 { return false; }
    if bjg_got(biba_join(2, 2)) != 2 { return false; }
    let zjoin: Result[Int, String] = biba_join(0, 0);
    if zjoin.is_ok() == false { return false; }
    if bjg_got(zjoin) != 0 { return false; }
    if biba_join(0 - 1, 2).is_ok() { return false; }
    if biba_join(2, 5).is_ok() { return false; }
    return true;
}
