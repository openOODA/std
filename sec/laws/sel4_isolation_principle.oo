// # seL4 Isolation Principle
//
// Logline: seL4 (Klein et al. SOSP 2009; J. 2014) is the world's first formally verified general-purpose OS kernel; isolation is enforced by capability-based access control with a binary-equivalent ARM/C verified implementation.
//
// Setup: Pure Int counts and year markers, and a function-pointer equivalence check for the verified ARM/C implementations. Unverified revisions fail closed.
//
// Beats:
//   1. seL4 verified: 8700 LoC C, ~200,000 proof lines (Klein et al. SOSP 2009; expanded in Klein et al. J. 2014).
//   2. Function-pointer equivalence: the verified ARM implementation and its C source are binary-equivalent.
//   3. Capability-based access: every kernel entry checks a capability token (Klein 2009 Sec. 3).
//   4. Coupled: verification + capability enforcement = isolation guarantee.
//   5. Hosts sec_invariants.oo stem for default-deny cross-link.

import "std/sec/sec_invariants.oo";
import "std/core/primitives/domain_cert.oo";

// seL4 line counts. Klein et al. SOSP 2009: ~8700 LoC C source, ~200,000 proof lines.
// Klein et al. J. 2014 expands the proof to end-to-end functional correctness.
pub fn sel4_loc_c() -> Int { return 8700; }        // C source lines of code in the verified seL4.
pub fn sel4_proof_lines() -> Int { return 200000; } // Proof lines (Klein et al. 2009).
pub fn sel4_year_sosp() -> Int { return 2009; }    // Klein et al. SOSP 2009 paper year.
pub fn sel4_year_complete() -> Int { return 2014; } // Klein et al. 2014 complete verification year.

// Verification flag: 1 if this is the verified seL4 release.
pub fn sel4_is_verified(verified: Int) -> Int {
    if verified == 1 { return 1; }
    return 0;
}

// Binary targets in the verified tree: 1 ARM, 2 C-source, 3 both (Klein 2009 Sec. 5).
pub fn sel4_target_arm() -> Int { return 1; }
pub fn sel4_target_c_source() -> Int { return 2; }
pub fn sel4_target_both() -> Int { return 1 + 2; }

// Function-pointer equivalence: 1 if the ARM and C-source function-pointer tables match.
// arm_ptr and c_ptr are opaque Int handles for the verified tables; both must be non-zero
// and the equivalence mask must equal the both-tasks mask.
pub fn sel4_function_pointer_equivalence_check(arm_ptr: Int, c_ptr: Int, equiv_mask: Int) -> Int {
    if arm_ptr <= 0 { return 0; }
    if c_ptr <= 0 { return 0; }
    if equiv_mask < 0 { return 0; }
    if equiv_mask == sel4_target_both() { return 1; }
    return 0;
}

// Capability enforcement: 1 if the capability token is present and non-zero (Klein 2009 Sec. 3).
pub fn sel4_capability_enforced(cap_token: Int) -> Int {
    if cap_token <= 0 { return 0; }
    return 1;
}

// 0.001% precision check (1 ppm tolerance per unit expected).
pub fn sel4_close_enough(actual: Int, expected: Int, tolerance_ppm: Int) -> Int {
    if expected < 0 { return 0; }
    if tolerance_ppm < 0 { return 0; }
    let diff_pos: Int = actual - expected;
    let diff_neg: Int = expected - actual;
    let mut diff: Int = diff_pos;
    if diff_neg > diff_pos { diff = diff_neg; }
    if expected == 0 {
        if diff == 0 { return 1; }
        return 0;
    }
    let bound: Int = diff * 100000;
    let allowed: Int = tolerance_ppm * expected;
    if bound <= allowed { return 1; }
    return 0;
}

// Domain certificate: seL4 is verified.
pub fn sel4_verified_law(verified: Int) -> DomainCert {
    let h: Int = sel4_is_verified(verified);
    return domain_cert("sec", "sel4_verified", h);
}

// Domain certificate: function-pointer equivalence check.
pub fn sel4_fp_equiv_law(arm_ptr: Int, c_ptr: Int, equiv_mask: Int) -> DomainCert {
    let h: Int = sel4_function_pointer_equivalence_check(arm_ptr, c_ptr, equiv_mask);
    return domain_cert("sec", "sel4_fp_equiv", h);
}

// Coupled law: verification AND capability enforcement both hold -> isolation guaranteed.
pub fn sel4_coupled_law(verified: Int, cap_token: Int) -> Int {
    if sel4_is_verified(verified) != 1 { return 0; }
    if sel4_capability_enforced(cap_token) != 1 { return 0; }
    return 1;
}

pub fn sel4_coupled_cert(verified: Int, cap_token: Int) -> DomainCert {
    let h: Int = sel4_coupled_law(verified, cap_token);
    return domain_cert("sec", "sel4_coupled", h);
}

// KAT and hostile cases for the seL4 isolation principle.
pub fn verify_sel4_isolation_principle() -> Bool {
    let sec_inv_ok: Int = sec_grant_ok(1);
    if sec_inv_ok != 1 { return false; }
    if sel4_loc_c() != 8700 { return false; }
    if sel4_proof_lines() != 200000 { return false; }
    if sel4_year_sosp() != 2009 { return false; }
    if sel4_year_complete() != 2014 { return false; }
    if sel4_target_arm() != 1 { return false; }
    if sel4_target_c_source() != 2 { return false; }
    if sel4_target_both() != 3 { return false; }
    if sel4_is_verified(1) != 1 { return false; }
    if sel4_is_verified(0) != 0 { return false; }
    if sel4_is_verified(2) != 0 { return false; }
    if sel4_is_verified(0 - 1) != 0 { return false; }
    if sel4_function_pointer_equivalence_check(4096, 8192, sel4_target_both()) != 1 { return false; }
    if sel4_function_pointer_equivalence_check(4096, 8192, 0) != 0 { return false; }
    if sel4_function_pointer_equivalence_check(4096, 8192, 1) != 0 { return false; }
    if sel4_function_pointer_equivalence_check(4096, 8192, 2) != 0 { return false; }
    if sel4_function_pointer_equivalence_check(0, 8192, sel4_target_both()) != 0 { return false; }
    if sel4_function_pointer_equivalence_check(4096, 0, sel4_target_both()) != 0 { return false; }
    if sel4_function_pointer_equivalence_check(0 - 1, 8192, sel4_target_both()) != 0 { return false; }
    if sel4_capability_enforced(51966) != 1 { return false; }
    if sel4_capability_enforced(1) != 1 { return false; }
    if sel4_capability_enforced(0) != 0 { return false; }
    if sel4_capability_enforced(0 - 1) != 0 { return false; }
    let c1: DomainCert = sel4_verified_law(1);
    if c1.holds != 1 { return false; }
    let c2: DomainCert = sel4_verified_law(0);
    if c2.holds != 0 { return false; }
    let f1: DomainCert = sel4_fp_equiv_law(4096, 8192, sel4_target_both());
    if f1.holds != 1 { return false; }
    let f2: DomainCert = sel4_fp_equiv_law(4096, 8192, 1);
    if f2.holds != 0 { return false; }
    let cp1: DomainCert = sel4_coupled_cert(1, 51966);
    if cp1.holds != 1 { return false; }
    let cp2: DomainCert = sel4_coupled_cert(0, 51966);
    if cp2.holds != 0 { return false; }
    let cp3: DomainCert = sel4_coupled_cert(1, 0);
    if cp3.holds != 0 { return false; }
    if sel4_close_enough(8700, 8700, 1) != 1 { return false; }
    if sel4_close_enough(200000, 200000, 1) != 1 { return false; }
    if sel4_close_enough(0, 0, 1) != 1 { return false; }
    if sel4_close_enough(8701, 8700, 1) != 0 { return false; }
    return true;
}
