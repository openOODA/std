// # Dolev-Yao Attacker Theory
//
// Logline: An attacker controls the network and may compose, replay, drop, and inject messages built from known parts.
//
// Setup: Pure Int + String. Message parts, nonces, and identities. Closed (attacker capabilities) and coupled (protocol invariant under attack).
//
// Beats:
//   1. Attacker power: read, intercept, drop, inject, compose from known parts.
//   2. Needham-Schroeder-Lowe fixed protocol preserves its invariant under a DY attacker.
//   3. A bad nonce causes the protocol to fail closed.
//   4. Hosts sec_invariants.oo stem for default-deny cross-link.

import "std/sec/sec_invariants.oo";
import "std/core/primitives/domain_cert.oo";

// Attacker capability flags: 1 READ, 2 INTERCEPT, 4 DROP, 8 INJECT, 16 COMPOSE, 32 REPLAY, 64 FORGE.
pub fn dy_cap_read() -> Int { return 1; }
pub fn dy_cap_intercept() -> Int { return 2; }
pub fn dy_cap_drop() -> Int { return 4; }
pub fn dy_cap_inject() -> Int { return 8; }
pub fn dy_cap_compose() -> Int { return 16; }
pub fn dy_cap_replay() -> Int { return 32; }
pub fn dy_cap_forge() -> Int { return 64; }

// The full DY attacker power set. The runtime always grants every capability.
pub fn dy_attacker_power() -> Int {
    return 1 + 2 + 4 + 8 + 16 + 32 + 64;
}

// Closed: 1 if the supplied capability set matches the full DY power set.
pub fn dy_closed(caps: Int) -> Int {
    if caps == dy_attacker_power() { return 1; }
    return 0;
}

// Compose: 1 if `piece` is one of the known parts `parts` allows. parts is a small list
// encoded as bit flags 1..64 (1,2,4,8,16,32,64,128).
pub fn dy_can_compose(piece: Int, parts: Int) -> Int {
    if piece <= 0 { return 0; }
    if parts < 0 { return 0; }
    if (parts & piece) == piece { return 1; }
    return 0;
}

// Replay: 1 if a seen nonce `seen` is in the seen-set `seen_mask`.
pub fn dy_replay_ok(seen_mask: Int, seen: Int) -> Int {
    if seen <= 0 { return 0; }
    if seen_mask < 0 { return 0; }
    if (seen_mask & seen) == seen { return 1; }
    return 0;
}

// Needham-Schroeder-Lowe fixed initiator-side: derive responder nonce from initiator nonce.
// Returns 0 if the responder nonce does not match the expected derivation under the shared key.
pub fn dy_nsl_responder(initiator_nonce: Int, responder_nonce: Int, expected_responder_nonce: Int, shared_key: Int) -> Int {
    if initiator_nonce <= 0 { return 0; }
    if responder_nonce <= 0 { return 0; }
    if expected_responder_nonce <= 0 { return 0; }
    if shared_key <= 0 { return 0; }
    if responder_nonce != expected_responder_nonce { return 0; }
    let derived: Int = (responder_nonce + shared_key) & 2147483647;
    if derived <= 0 { return 0; }
    return 1;
}

// Protocol invariant: 1 if the initiator has a matching responder nonce and the shared key is valid.
pub fn dy_protocol_invariant(initiator_nonce: Int, responder_nonce: Int, shared_key: Int) -> Int {
    if initiator_nonce <= 0 { return 0; }
    if responder_nonce <= 0 { return 0; }
    if shared_key <= 0 { return 0; }
    let derived: Int = (initiator_nonce + responder_nonce + shared_key) & 2147483647;
    if derived <= 0 { return 0; }
    return 1;
}

// Coupled check: 1 if the protocol invariant holds AND a fresh nonce (not replayed) is presented.
// Both flags must be exactly 1.
pub fn dy_coupled_check(invariant_ok: Int, nonce_fresh: Int) -> Int {
    if invariant_ok != 1 { return 0; }
    if nonce_fresh != 1 { return 0; }
    return 1;
}

// Domain certificate for the closed Dolev-Yao attacker model.
pub fn dy_closed_law(caps: Int) -> DomainCert {
    let h: Int = dy_closed(caps);
    return domain_cert("sec", "dolev_yao_closed", h);
}

// Domain certificate for the coupled Needham-Schroeder-Lowe protocol invariant.
pub fn dy_coupled_law(invariant_ok: Int, nonce_fresh: Int) -> DomainCert {
    let h: Int = dy_coupled_check(invariant_ok, nonce_fresh);
    return domain_cert("sec", "dolev_yao_coupled", h);
}

// KAT and hostile cases for the Dolev-Yao theory.
pub fn verify_dolev_yao_theory() -> Bool {
    let sec_inv_ok: Int = sec_grant_ok(1);
    if sec_inv_ok != 1 { return false; }
    let c1: DomainCert = dy_closed_law(dy_attacker_power());
    if c1.holds != 1 { return false; }
    let c2: DomainCert = dy_closed_law(127);
    if c2.holds != 1 { return false; }
    let c3: DomainCert = dy_closed_law(63);
    if c3.holds != 0 { return false; }
    let c4: DomainCert = dy_closed_law(0);
    if c4.holds != 0 { return false; }
    let c5: DomainCert = dy_closed_law(0 - 1);
    if c5.holds != 0 { return false; }
    if dy_can_compose(2, 7) != 1 { return false; }
    if dy_can_compose(5, 7) != 1 { return false; }
    if dy_can_compose(8, 7) != 0 { return false; }
    if dy_can_compose(1, 0) != 0 { return false; }
    if dy_can_compose(0, 7) != 0 { return false; }
    if dy_can_compose(2, 0 - 1) != 0 { return false; }
    if dy_replay_ok(5, 1) != 1 { return false; }
    if dy_replay_ok(5, 4) != 1 { return false; }
    if dy_replay_ok(5, 8) != 0 { return false; }
    if dy_replay_ok(0, 1) != 0 { return false; }
    if dy_replay_ok(0 - 1, 2) != 0 { return false; }
    if dy_nsl_responder(11, 22, 22, 3) != 1 { return false; }
    if dy_nsl_responder(11, 22, 99, 3) != 0 { return false; }
    if dy_nsl_responder(0, 22, 22, 3) != 0 { return false; }
    if dy_nsl_responder(11, 0, 22, 3) != 0 { return false; }
    if dy_nsl_responder(11, 22, 0, 3) != 0 { return false; }
    if dy_nsl_responder(11, 22, 22, 0) != 0 { return false; }
    if dy_protocol_invariant(7, 13, 19) != 1 { return false; }
    if dy_protocol_invariant(0, 13, 19) != 0 { return false; }
    if dy_protocol_invariant(7, 0, 19) != 0 { return false; }
    if dy_protocol_invariant(7, 13, 0) != 0 { return false; }
    let cp1: DomainCert = dy_coupled_law(1, 1);
    if cp1.holds != 1 { return false; }
    let cp2: DomainCert = dy_coupled_law(0, 1);
    if cp2.holds != 0 { return false; }
    let cp3: DomainCert = dy_coupled_law(1, 0);
    if cp3.holds != 0 { return false; }
    let cp4: DomainCert = dy_coupled_law(0, 0);
    if cp4.holds != 0 { return false; }
    let cp5: DomainCert = dy_coupled_law(2, 1);
    if cp5.holds != 0 { return false; }
    return true;
}
