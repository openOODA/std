// # Least Privilege Attenuation Principle
//
// Logline: A subject operates with the minimum set of rights required to complete its current task.
//
// Setup: Pure Int rights bitmasks. Excess rights are attenuated; out-of-range inputs fail closed.
//
// Beats:
//   1. Right attenuation: child rights is parent rights AND required mask.
//   2. Excess right detection: rights contains bits outside the required mask.
//   3. Minimum-needed: a single right is the minimum-sufficient mask.
//   4. Hosts sec_invariants.oo stem for default-deny cross-link.

import "std/sec/sec_invariants.oo";

// Single rights bits: 0 NONE, 1 READ, 2 WRITE, 4 EXEC, 8 OWN.
pub fn lp_right_none() -> Int {
    return 0;
}

pub fn lp_right_read() -> Int {
    return 1;
}

pub fn lp_right_write() -> Int {
    return 2;
}

pub fn lp_right_exec() -> Int {
    return 4;
}

pub fn lp_right_own() -> Int {
    return 8;
}

// Attenuate parent rights to the required mask. Returns 0 (deny) on bad input.
pub fn lp_attenuate(parent_rights: Int, required_mask: Int) -> Int {
    if parent_rights < 0 { return 0; }
    if required_mask < 0 { return 0; }
    if required_mask == 0 { return 0; }
    return parent_rights & required_mask;
}

// Excess-right check: 1 if the rights contain any bit outside the required mask.
// We test each bit 0..7 individually to avoid relying on bitwise NOT.
pub fn lp_has_excess(rights: Int, required_mask: Int) -> Int {
    if rights < 0 { return 0; }
    if required_mask < 0 { return 0; }
    let mut bit: Int = 1;
    while bit <= 128 {
        let in_required: Int = required_mask & bit;
        let in_rights: Int = rights & bit;
        if in_required == 0 {
            if in_rights != 0 {
                return 1;
            }
        }
        bit = bit * 2;
    }
    return 0;
}

// Sufficient check: 1 if rights cover all bits of required_mask.
pub fn lp_sufficient(rights: Int, required_mask: Int) -> Int {
    if rights < 0 { return 0; }
    if required_mask < 0 { return 0; }
    let covered: Int = rights & required_mask;
    if covered == required_mask { return 1; }
    return 0;
}

// KAT and hostile cases for the least-privilege principle.
pub fn verify_least_privilege_principle() -> Bool {
    let sec_inv_ok: Int = sec_grant_ok(1);
    if sec_inv_ok != 1 { return false; }
    if lp_attenuate(7, 3) != 3 { return false; }
    if lp_attenuate(7, 5) != 5 { return false; }
    if lp_attenuate(7, 0) != 0 { return false; }
    if lp_attenuate(0, 1) != 0 { return false; }
    if lp_attenuate(0 - 1, 3) != 0 { return false; }
    if lp_attenuate(7, 0 - 1) != 0 { return false; }
    if lp_has_excess(7, 3) != 1 { return false; }
    if lp_has_excess(3, 3) != 0 { return false; }
    if lp_has_excess(1, 3) != 0 { return false; }
    if lp_has_excess(0, 0) != 0 { return false; }
    if lp_has_excess(0 - 1, 3) != 0 { return false; }
    if lp_has_excess(7, 0 - 1) != 0 { return false; }
    if lp_sufficient(7, 3) != 1 { return false; }
    if lp_sufficient(3, 3) != 1 { return false; }
    if lp_sufficient(1, 3) != 0 { return false; }
    if lp_sufficient(0, 1) != 0 { return false; }
    if lp_sufficient(7, 0) != 1 { return false; }
    if lp_sufficient(0 - 1, 1) != 0 { return false; }
    if lp_sufficient(7, 0 - 1) != 0 { return false; }
    return true;
}
