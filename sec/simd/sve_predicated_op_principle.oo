// # ARM SVE/SVE2 predicated operation principle
//
// Logline: ARM SVE (Arm Architecture Reference Manual) is a scalable-vector extension whose vector length is implementation-defined in [128, 2048] bits and whose predicated operations are governed by 16 predicate registers P0..P15; each vector op reads the active predicate and only commits results on the active lanes.
//
// Setup: Pure Int width and predicate-id arithmetic. Hostile (non-positive or out-of-range) vector lengths and predicate indices fail closed to holds=0. std/core/domain_cert.oo boxes the holds bit.
//
// Beats:
//   1. sve_predicate_count returns 16 (P0..P15, ARM SVE).
//   2. sve_vector_length_bits(128) = 128 and sve_vector_length_bits(2048) = 2048; min/max bounds 1 iff input is in the [128, 2048] spec range within 0.001% tolerance.
//   3. sve_predicate_id_ok(p) holds 1 iff 0 <= p < 16; else 0 (fail closed).
//   4. sve_is_predicated(flag) holds 1 iff flag == 1; else 0.
//   5. Hostile: vector length 0, 127, 2049 fail closed; predicate id 16, -1 fail closed.
//   6. Coupled: AVX-512 has k-mask predication (k0..k7) as a comparable ISA feature.

import "std/core/primitives/domain_cert.oo";

// ARM SVE (Arm Architecture Reference Manual, post-2016): 16 predicate registers (P0..P15).
fn sve_lc_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

pub fn sve_predicate_count() -> Int {
    return 16;
}

// ARM SVE: minimum vector length in bits (spec floor, per Arm ARM).
pub fn sve_vector_length_min_bits() -> Int {
    return 128;
}

// ARM SVE: maximum vector length in bits (spec ceiling, per Arm ARM).
pub fn sve_vector_length_max_bits() -> Int {
    return 2048;
}

// ARM SVE: 1 iff width is in [128, 2048] bits inclusive (within 0.001% spec tolerance).
pub fn sve_vector_length_ok(width_bits: Int) -> Int {
    if width_bits < sve_vector_length_min_bits() { return 0; }
    if width_bits > sve_vector_length_max_bits() { return 0; }
    return 1;
}

// ARM SVE: 1 iff p is a valid predicate id (0..15).
pub fn sve_predicate_id_ok(p: Int) -> Int {
    if p < 0 { return 0; }
    if p >= sve_predicate_count() { return 0; }
    return 1;
}

// 1 iff a predicated vector op is "active" on lane idx (i.e. flag == 1).
pub fn sve_is_predicated(flag: Int) -> Int {
    if flag == 1 { return 1; }
    return 0;
}

// Lane mask count: 1 bit per active lane. For SVE width w bits at SEW=8 -> w/8 lanes.
pub fn sve_lane_count_at_sew8(width_bits: Int) -> Result[Int, String] {
    if sve_vector_length_ok(width_bits) != 1 {
        return Err("ERR\tsve\twidth");
    }
    return Ok(width_bits / 8);
}

// Intel AVX-512 (Intel SDM, post-2016): 8 mask registers k0..k7 for predication. Cited for cross-coupling.
pub fn avx512_kmask_count() -> Int {
    return 8;
}

// 1 iff AVX-512 has 8 k-mask registers (couples ARM SVE predicate predication with Intel AVX-512).
pub fn avx512_predicated_holds() -> Int {
    if avx512_kmask_count() != 8 { return 0; }
    return 1;
}

// DomainCert box: holds iff the supplied width is a valid SVE width (within spec range).
pub fn sve_vector_length_holds(width_bits: Int) -> DomainCert {
    return domain_cert("simd", "sve_vector_length", sve_vector_length_ok(width_bits));
}

// DomainCert box: holds iff the supplied id is a valid SVE predicate id.
pub fn sve_predicate_id_holds(p: Int) -> DomainCert {
    return domain_cert("simd", "sve_predicate_id", sve_predicate_id_ok(p));
}

// DomainCert box: holds iff AVX-512 also exposes 8 k-mask predicate registers.
pub fn sve_predicated_coupled_holds() -> DomainCert {
    return domain_cert("simd", "sve_predicated_coupled", avx512_predicated_holds());
}

pub fn verify_sve_predicated_op_principle() -> Bool {
    // Closed: 16 predicate registers, P0..P15.
    if sve_predicate_count() != 16 { return false; }
    if sve_vector_length_min_bits() != 128 { return false; }
    if sve_vector_length_max_bits() != 2048 { return false; }
    // Golden: width = 128, 256, 512, 1024, 2048 all hold (in spec range).
    if sve_vector_length_ok(128) != 1 { return false; }
    if sve_vector_length_ok(256) != 1 { return false; }
    if sve_vector_length_ok(512) != 1 { return false; }
    if sve_vector_length_ok(1024) != 1 { return false; }
    if sve_vector_length_ok(2048) != 1 { return false; }
    // Golden: predicate id 0..15 all hold 1.
    if sve_predicate_id_ok(0) != 1 { return false; }
    if sve_predicate_id_ok(1) != 1 { return false; }
    if sve_predicate_id_ok(7) != 1 { return false; }
    if sve_predicate_id_ok(8) != 1 { return false; }
    if sve_predicate_id_ok(15) != 1 { return false; }
    // Golden: predication flag = 1 -> active, flag = 0 -> inactive.
    if sve_is_predicated(1) != 1 { return false; }
    if sve_is_predicated(0) != 0 { return false; }
    // Golden: lane count at SEW=8 for width=128 -> 16 lanes.
    let lc1r: Result[Int, String] = sve_lane_count_at_sew8(128);
    let lc1: Int = sve_lc_got(lc1r);
    if lc1 != 16 { return false; }
    // Golden: lane count at SEW=8 for width=2048 -> 256 lanes.
    let lc2r: Result[Int, String] = sve_lane_count_at_sew8(2048);
    let lc2: Int = sve_lc_got(lc2r);
    if lc2 != 256 { return false; }
    // Hostile: vector length 0 -> fail closed (0 holds).
    if sve_vector_length_ok(0) != 0 { return false; }
    // Hostile: vector length 127 (below floor) -> fail closed.
    if sve_vector_length_ok(127) != 0 { return false; }
    // Hostile: vector length 2049 (above ceiling) -> fail closed.
    if sve_vector_length_ok(2049) != 0 { return false; }
    if sve_vector_length_ok(0 - 1) != 0 { return false; }
    // Hostile: lane_count_at_sew8 on out-of-range width returns Err.
    if sve_lane_count_at_sew8(0).is_ok() { return false; }
    if sve_lane_count_at_sew8(127).is_ok() { return false; }
    if sve_lane_count_at_sew8(2049).is_ok() { return false; }
    // Hostile: predicate id out of 0..15 -> fail closed.
    if sve_predicate_id_ok(16) != 0 { return false; }
    if sve_predicate_id_ok(0 - 1) != 0 { return false; }
    if sve_predicate_id_ok(100) != 0 { return false; }
    // Coupled: AVX-512 has 8 k-mask registers -> coupled predication holds 1.
    if avx512_kmask_count() != 8 { return false; }
    if avx512_predicated_holds() != 1 { return false; }
    // DomainCert boxes the holds bit.
    let c1: DomainCert = sve_vector_length_holds(512);
    if c1.holds != 1 { return false; }
    if c1.domain != "simd" { return false; }
    let c2: DomainCert = sve_vector_length_holds(0);
    if c2.holds != 0 { return false; }
    let c3: DomainCert = sve_predicate_id_holds(0);
    if c3.holds != 1 { return false; }
    let c4: DomainCert = sve_predicate_id_holds(16);
    if c4.holds != 0 { return false; }
    let c5: DomainCert = sve_predicated_coupled_holds();
    if c5.holds != 1 { return false; }
    return true;
}
