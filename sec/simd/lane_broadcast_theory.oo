// # SIMD lane broadcast theory
//
// Logline: A broadcast of value v to N lanes yields a vector with all lanes equal to v; a shuffle gather of {0,0,...,0} from a single-lane vector equals a broadcast of lane 0.
//
// Setup: Pure Float lanes. lane_count in [1, 8]. Hostile: lane_count out of 1..8 returns Err. std/core/domain_cert.oo boxes the holds bit.
//
// Beats:
//   1. simd_lane_broadcast packs v into a fixed 4-lane vector with all lanes = v.
//   2. simd_broadcast_to_lanes computes lane_count * v via repeated-add (used for coupled sum check).
//   3. simd_shuffle_broadcast_first reads lane 0 and packs into all 4 lanes (couples with broadcast).
//   4. simd_broadcast_sum: sum of broadcast(v) over N lanes equals N * v.
//   5. Hostile: lane_count out of 1..8 returns Err and holds 0.
//   6. simd_lane_broadcast_holds boxes the certificate.

import "std/core/primitives/domain_cert.oo";

// 4-lane float vector.
type BcastVec4f = struct {
    v0: Float,
    v1: Float,
    v2: Float,
    v3: Float
};

fn lb_got(r: Result[Float, String]) -> Float {
    match r { Ok(v) => { return v; }, Err(_) => { return 0.0 - 1.0; } }
}

pub fn bcast_vec4f_get(v: BcastVec4f, idx: Int) -> Float {
    if idx == 0 { return v.v0; }
    if idx == 1 { return v.v1; }
    if idx == 2 { return v.v2; }
    return v.v3;
}

// Closed: broadcast v to a 4-lane vector.
pub fn simd_lane_broadcast(v: Float) -> BcastVec4f {
    return BcastVec4f { v0: v, v1: v, v2: v, v3: v };
}

// Coupled: gather with indices {0,0,0,0} reads lane 0 and writes it into all 4 lanes (matches broadcast).
pub fn simd_shuffle_broadcast_first(v: BcastVec4f) -> BcastVec4f {
    let x: Float = bcast_vec4f_get(v, 0);
    return BcastVec4f { v0: x, v1: x, v2: x, v3: x };
}

// Compute lane_count * v via repeated-add (lane_count small, 1..8).
pub fn simd_broadcast_to_lanes(v: Float, lane_count: Int) -> Result[Float, String] {
    if lane_count < 1 { return Err("ERR\tsimd\tlanes"); }
    if lane_count > 8 { return Err("ERR\tsimd\tlanes"); }
    let mut acc: Float = 0.0;
    let mut i: Int = 0;
    while i < lane_count {
        acc = acc + v;
        i = i + 1;
    }
    return Ok(acc);
}

// Sum of broadcast(v) over a 4-lane vector (closed form, all lanes are v).
pub fn simd_broadcast_sum_4(v: Float) -> Float {
    return v + v + v + v;
}

// 1 iff the broadcast sum matches lane_count * v; 0 on hostile inputs.
pub fn simd_broadcast_sum_ok(v: Float, lane_count: Int) -> Int {
    let sr: Result[Float, String] = simd_broadcast_to_lanes(v, lane_count);
    match sr {
        Ok(s) => {
            let mut n: Float = 0.0;
            let mut i: Int = 0;
            while i < lane_count {
                n = n + v;
                i = i + 1;
            }
            let mut diff: Float = s - n;
            if diff < 0.0 { diff = 0.0 - diff; }
            if diff <= 0.000001 { return 1; }
            return 0;
        },
        Err(_) => { return 0; }
    }
}

pub fn simd_lane_broadcast_holds(v: Float, lane_count: Int) -> DomainCert {
    let ok: Int = simd_broadcast_sum_ok(v, lane_count);
    return domain_cert("simd", "lane_broadcast", ok);
}

pub fn verify_lane_broadcast_theory() -> Bool {
    // Golden: broadcast 5.0 to a 4-lane vector -> all lanes 5.0.
    let b1: BcastVec4f = simd_lane_broadcast(5.0);
    if bcast_vec4f_get(b1, 0) != 5.0 { return false; }
    if bcast_vec4f_get(b1, 1) != 5.0 { return false; }
    if bcast_vec4f_get(b1, 2) != 5.0 { return false; }
    if bcast_vec4f_get(b1, 3) != 5.0 { return false; }
    // Golden: broadcast 0.0 -> zero vector.
    let b0: BcastVec4f = simd_lane_broadcast(0.0);
    if bcast_vec4f_get(b0, 0) != 0.0 { return false; }
    if bcast_vec4f_get(b0, 3) != 0.0 { return false; }
    // Golden: shuffle_broadcast_first from any vector equals broadcast of lane 0.
    let b_first: BcastVec4f = simd_shuffle_broadcast_first(b1);
    if bcast_vec4f_get(b_first, 0) != 5.0 { return false; }
    if bcast_vec4f_get(b_first, 3) != 5.0 { return false; }
    // Coupled: sum of broadcast(5.0) over 4 lanes = 4 * 5.0 = 20.0.
    if simd_broadcast_sum_4(5.0) != 20.0 { return false; }
    if lb_got(simd_broadcast_to_lanes(5.0, 4)) != 20.0 { return false; }
    if lb_got(simd_broadcast_to_lanes(2.0, 8)) != 16.0 { return false; }
    if lb_got(simd_broadcast_to_lanes(0.5, 2)) != 1.0 { return false; }
    // Golden: broadcast_sum_ok returns 1 for valid lane_count.
    if simd_broadcast_sum_ok(5.0, 4) != 1 { return false; }
    if simd_broadcast_sum_ok(2.0, 8) != 1 { return false; }
    if simd_broadcast_sum_ok(0.5, 2) != 1 { return false; }
    // Hostile: lane_count out of 1..8 returns Err and ok = 0.
    if simd_broadcast_to_lanes(5.0, 0).is_ok() { return false; }
    if simd_broadcast_to_lanes(5.0, 0 - 1).is_ok() { return false; }
    if simd_broadcast_sum_ok(5.0, 0) != 0 { return false; }
    if simd_broadcast_sum_ok(5.0, 0 - 1) != 0 { return false; }
    if simd_broadcast_to_lanes(5.0, 9).is_ok() { return false; }
    if simd_broadcast_sum_ok(5.0, 9) != 0 { return false; }
    // DomainCert boxes the holds bit from caller params.
    let c1: DomainCert = simd_lane_broadcast_holds(5.0, 4);
    if c1.holds != 1 { return false; }
    if c1.domain != "simd" { return false; }
    let c2: DomainCert = simd_lane_broadcast_holds(5.0, 0);
    if c2.holds != 0 { return false; }
    let c3: DomainCert = simd_lane_broadcast_holds(5.0, 9);
    if c3.holds != 0 { return false; }
    return true;
}
