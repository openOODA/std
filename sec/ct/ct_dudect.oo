// # Dudect Statistical Cache-Timing Analyzer
//
// Logline: Implements Welch's two-sample t-test statistical timing leakage evaluation (Dudect methodology) in pure .oo.
// Setup: Evaluates timing distribution differences between fixed and random input classes (|t| < 4.5 threshold).
// Beats:
//   1. Standard operating routine for this driver.
//   2. Errata/edge case handling.
// capability: Zero ambient authority; mathematical calculations and state tracking under explicit &AllocCap.
// verification: Unit tested against known variable-time leaks (|t| > 4.5) and constant-time operations (|t| < 4.5).

type DudectClassStats = struct {
    count: Int,
    sum: Float,
    sum_sq: Float
};

type DudectState = struct {
    class0: DudectClassStats,
    class1: DudectClassStats,
    threshold: Float,
    max_samples: Int
};

type DudectEvaluation = struct {
    t_statistic: Float,
    mean0: Float,
    mean1: Float,
    var0: Float,
    var1: Float,
    passed: Bool,
    sample_count: Int
};

pub fn ct_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    let mut is_neg: Bool = false;
    if count < 0 {
        is_neg = true;
        count = 0 - count;
    }
    while count >= 10000 {
        f = f + 10000.0;
        count = count - 10000;
    }
    while count >= 1000 {
        f = f + 1000.0;
        count = count - 1000;
    }
    while count >= 100 {
        f = f + 100.0;
        count = count - 100;
    }
    while count >= 10 {
        f = f + 10.0;
        count = count - 10;
    }
    while count > 0 {
        f = f + 1.0;
        count = count - 1;
    }
    if is_neg {
        return 0.0 - f;
    }
    return f;
}

pub fn dudect_class_init() -> DudectClassStats {
    return DudectClassStats {
        count: 0,
        sum: 0.0,
        sum_sq: 0.0
    };
}

pub fn dudect_init(max_samples: Int, threshold_t: Float) -> DudectState {
    return DudectState {
        class0: dudect_class_init(),
        class1: dudect_class_init(),
        threshold: threshold_t,
        max_samples: max_samples
    };
}

pub fn dudect_record_sample(state: DudectState, class_type: Int, ticks: Int) -> DudectState {
    let mut st: DudectState = state;
    let val_f: Float = ct_int_to_float(ticks);
    if class_type == 0 {
        let c0: DudectClassStats = st.class0;
        let new_c0: DudectClassStats = DudectClassStats {
            count: c0.count + 1,
            sum: c0.sum + val_f,
            sum_sq: c0.sum_sq + (val_f * val_f)
        };
        st.class0 = new_c0;
    } else {
        let c1: DudectClassStats = st.class1;
        let new_c1: DudectClassStats = DudectClassStats {
            count: c1.count + 1,
            sum: c1.sum + val_f,
            sum_sq: c1.sum_sq + (val_f * val_f)
        };
        st.class1 = new_c1;
    }
    return st;
}

pub fn dudect_evaluate(state: DudectState) -> DudectEvaluation {
    let c0: DudectClassStats = state.class0;
    let c1: DudectClassStats = state.class1;
    let n0: Int = c0.count;
    let n1: Int = c1.count;

    if n0 < 2 || n1 < 2 {
        // Insufficient samples to compute a meaningful variance. Fail
        // closed rather than returning a misleading t-statistic of 0.
        return DudectEvaluation {
            t_statistic: 9999.0,
            mean0: 0.0,
            mean1: 0.0,
            var0: 0.0,
            var1: 0.0,
            passed: false,
            sample_count: n0 + n1
        };
    }

    let n0_f: Float = ct_int_to_float(n0);
    let n1_f: Float = ct_int_to_float(n1);

    let mean0: Float = c0.sum / n0_f;
    let mean1: Float = c1.sum / n1_f;

    let var0: Float = (c0.sum_sq - (n0_f * mean0 * mean0)) / (n0_f - 1.0);
    let var1: Float = (c1.sum_sq - (n1_f * mean1 * mean1)) / (n1_f - 1.0);

    // Fraud detector: if the original variance of either class is 0 (or
    // below an epsilon), the input is not real timing data — it is either
    // a synthetic-tick constant (e.g. `sim_ticks = 1600 + (diff & 0)`)
    // or a constant that bypasses the constant-time check. This was the
    // structural-fraud pattern that hid real timing leaks in the prior
    // `ct_harness.oo` benchmarks and the test_c4_red8_byzantine_infiltrator
    // synthetic Dudect (`sim_ticks = 1600 + (diff & 0)` → t-stat always
    // 0 → ALWAYS PASSES). Fail closed with a sentinel t-statistic so the
    // redteam gate vetoes any test using this pattern.
    let var0_clamped: Bool = var0 < 0.000001;
    let var1_clamped: Bool = var1 < 0.000001;
    // Also detect: identical means on both classes (synthetic-tick pattern
    // where sim_ticks = X + (diff & 0) makes both classes have the same
    // X for any input).
    let mean_diff: Float = mean0 - mean1;
    let mut mean_diff_abs: Float = mean_diff;
    if mean_diff_abs < 0.0 { mean_diff_abs = 0.0 - mean_diff_abs; }
    let mean_identical: Bool = mean_diff_abs < 0.000001;

    let mut safe_var0: Float = var0;
    if safe_var0 < 0.000001 { safe_var0 = 0.000001; }
    let mut safe_var1: Float = var1;
    if safe_var1 < 0.000001 { safe_var1 = 0.000001; }

    let se_diff: Float = sqrt((safe_var0 / n0_f) + (safe_var1 / n1_f));
    let mut t_val: Float = 0.0;
    if se_diff > 0.0000001 {
        t_val = (mean0 - mean1) / se_diff;
    }

    let mut abs_t: Float = t_val;
    if abs_t < 0.0 { abs_t = 0.0 - abs_t; }

    // Fail closed when the input is not real timing data. A synthetic
    // tick fraud has both near-zero variance AND effectively identical
    // means (e.g. `sim_ticks = 1600 + (diff & 0)`). Requiring both
    // prevents false positives on tight-but-genuine constant-time runs.
    let synthetic_fraud: Bool = (var0_clamped && var1_clamped && mean_identical);
    let statistical_pass: Bool = abs_t < state.threshold;
    let is_passed: Bool = statistical_pass && !synthetic_fraud;
    if synthetic_fraud == true {
        // Force t_statistic to a sentinel value (huge) so callers
        // logging `t_statistic` see that the test is being vetoed.
        abs_t = 9999.0;
    }

    return DudectEvaluation {
        t_statistic: abs_t,
        mean0: mean0,
        mean1: mean1,
        var0: safe_var0,
        var1: safe_var1,
        passed: is_passed,
        sample_count: n0 + n1
    };
}
