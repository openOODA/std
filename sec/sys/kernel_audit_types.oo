// # Kernel audit types
//
// Logline: AuditRule standardized off List[Int] fields to perm_mask.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: List[struct] standardized.

type KernelAuditRule = struct {
    perm_mask: Int,
    action: Int
};

pub fn kernel_audit_rule_new(perm_mask: Int, action: Int) -> KernelAuditRule {
    return KernelAuditRule {
        perm_mask: perm_mask,
        action: action
    };
}

pub fn kernel_audit_rule_perm(r: KernelAuditRule) -> Int {
    return r.perm_mask;
}
