import "std/sec/sys/secure_boot_types.oo";

pub fn secure_boot_engine_init(violation_type: Int, action_taken: Int) -> SecureBootViolation {
    return sboot_violation_new(violation_type, action_taken);
}

pub fn secure_boot_engine_work(violation_type: Int, action_taken: Int) -> Int {
    let v: SecureBootViolation = sboot_violation_new(violation_type, action_taken);
    return v.violation_type + v.action_taken;
}

