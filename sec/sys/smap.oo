// # Supervisor Mode Access Prevention (SMAP) Facade
//
// Logline: Re-exports SMAP status structures, register bit helpers, and simulation engine.
//
// Setup: Pure module shim importing types, constants, operations, and engine submodules.
//
// Beats:
//   1. Import SMAP types, constants, operations, and engine companion modules.
//   2. Re-export public symbols with typed shim markers.

import "std/sec/sys/smap_types.oo";
import "std/sec/sys/smap_const.oo";
import "std/sec/sys/smap_ops.oo";
import "std/sec/sys/smap_engine.oo";

pub fn shim_marker_smap_cr4_bit() -> Int {
    return smap_cr4_bit();
}

pub fn shim_marker_smap_access_read() -> Int {
    return smap_access_read();
}

pub fn shim_marker_smap_status_new() -> SmapStatus {
    return smap_status_new();
}

pub fn shim_marker_smap_has_cr4_bit() -> Bool {
    return smap_has_cr4_bit(2097152);
}

pub fn shim_marker_smap_engine_init() -> SmapStatus {
    return smap_engine_init();
}

pub fn shim_marker_smap_engine_work() -> Int {
    return smap_engine_work(4096);
}