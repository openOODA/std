// # SMAP Simulation Engine
//
// Logline: standardized onto ./smap_types.oo Int-floor API.
//
// Setup: Companion types standardized; keep fail-closed real calls.
//
// Beats:
//   1. Import standardized companion.
//   2. Wrap constructor and Int query.
//   3. Deterministic work helper for prove.

import "std/sec/sys/smap_types.oo";
import "std/sec/sys/smap_ops.oo";

pub fn smap_engine_init() -> SmapStatus {
    return smap_status_new();
}

pub fn smap_engine_work(addr: Int) -> Int {
    let st: SmapStatus = smap_status_new();
    let st2: SmapStatus = smap_status_record(st, addr);
    return st2.violation_count + st2.last_violation_addr;
}
