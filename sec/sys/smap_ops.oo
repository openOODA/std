// # SMAP Operations & Register Bit Arithmetic
//
// Logline: Implements status constructors, CR4 and RFLAGS bitwise manipulation.
//
// Setup: Imports smap_types.oo and smap_const.oo for CPU register bitwise modeling.
//
// Beats:
//   1. Construct default SMAP status and update violation records.
//   2. Perform pure bitwise testing, setting, and clearing for CR4 and RFLAGS AC bit.
//   3. Export access prevention primitives.

import "std/sec/sys/smap_types.oo";
import "std/sec/sys/smap_const.oo";

pub fn smap_ops_init() -> SmapStatus {
    return smap_status_new();
}

pub fn smap_ops_record(s: SmapStatus, addr: Int) -> SmapStatus {
    return smap_status_record(s, addr);
}

pub fn smap_has_cr4_bit(cr4: Int) -> Bool {
    let bit: Int = smap_cr4_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    let masked: Int = cr4 & m;
    return masked != 0;
}

pub fn smap_set_cr4_bit(cr4: Int) -> Int {
    let bit: Int = smap_cr4_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    return cr4 | m;
}

pub fn smap_clear_cr4_bit(cr4: Int) -> Int {
    let bit: Int = smap_cr4_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    let inv: Int = 2147483647 - (m - 1);
    return cr4 & inv;
}

pub fn smap_ac_flag_set(rflags: Int) -> Int {
    let bit: Int = smap_rflags_ac_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    return rflags | m;
}

pub fn smap_ac_flag_clear(rflags: Int) -> Int {
    let bit: Int = smap_rflags_ac_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    let inv: Int = 2147483647 - (m - 1);
    return rflags & inv;
}

pub fn smap_ac_flag_is_set(rflags: Int) -> Bool {
    let bit: Int = smap_rflags_ac_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    let masked: Int = rflags & m;
    return masked != 0;
}
