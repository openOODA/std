//   3. Deterministic work helper for prove.

import "std/sec/sys/rop_types.oo";
import "std/sec/sys/rop_ops.oo";

pub fn rop_engine_init() -> GadgetChain {
    return gadget_chain_new();
}

pub fn rop_engine_work(address_val: Int, stack_delta_val: Int, gadget_type_val: Int) -> Int {
    let g: RopGadget = rop_gadget_create(address_val, stack_delta_val, gadget_type_val);
    let c: GadgetChain = gadget_chain_new();
    let c2: GadgetChain = gadget_chain_add_gadget(c, g);
    return c2.total_stack;
}

pub fn __dummy_std_src_ooda_sec_sys_rop_engine_oo() -> Int {
    return 0;
}
