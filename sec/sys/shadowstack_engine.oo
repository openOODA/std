// # Hardware Shadow Stack Engine
//
// Logline: standardized onto ./shadowstack_types.oo Int-floor API.
//
// Setup: Companion types standardized; keep fail-closed real calls.
//
// Beats:
//   1. Import standardized companion.
//   2. Wrap constructor and Int query.
//   3. Deterministic work helper for prove.

import "std/sec/sys/shadowstack_types.oo";
import "std/sec/sys/shadowstack_ops.oo";

pub fn shadowstack_engine_init(max_depth: Int) -> ShadowStack {
    return shadowstack_new(max_depth);
}

pub fn shadowstack_engine_work(max_depth: Int, ret_addr: Int) -> Int {
    let s: ShadowStack = shadowstack_new(max_depth);
    let f: ShadowStackFrame = shadowstack_frame_create(1, ret_addr);
    let s2: ShadowStack = shadowstack_push(s, f);
    return shadowstack_verify_top(s2, ret_addr);
}

pub fn __dummy_std_src_ooda_sec_sys_shadowstack_engine_oo() -> Int {
    return 0;
}
