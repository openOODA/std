// # Stack Canary Types
//
// Logline: StackIntegrity standardized off List[StackFrame].
//
// Setup: Pure Int integrity counters.
//
// Beats:
//   1. stack_integrity_new zeros.
//   2. stack_integrity_pass increments checked and passed.
// residual: List[StackFrame] standardized.

type StackIntegrity = struct {
    total_frames_checked: Int,
    passed_frames: Int,
    corrupted_frames: Int
};

pub fn stack_integrity_new() -> StackIntegrity {
    return StackIntegrity {
        total_frames_checked: 0,
        passed_frames: 0,
        corrupted_frames: 0
    };
}

pub fn stack_integrity_pass(s: StackIntegrity) -> StackIntegrity {
    let t: Int = s.total_frames_checked;
    let p: Int = s.passed_frames;
    return StackIntegrity {
        total_frames_checked: t + 1,
        passed_frames: p + 1,
        corrupted_frames: s.corrupted_frames
    };
}

type StackFrame = struct {
    function_name: String,
    frame_pointer: Int,
    canary_value: Int,
    is_valid: Bool
};

type CanaryGuard = struct {
    guard_id: String,
    global_canary_secret: Int,
    null_byte_terminator: Bool,
    active_frames: List[StackFrame],
    protection_level: Int,
    stats_frames_guarded: Int,
    stats_violations_detected: Int,
    stats_remediations: Int,
    is_active: Bool,
    is_compromised: Bool
};
