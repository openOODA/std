// # FIPS 204 ML-DSA Signature Verification Engine
//
// Logline: Verifies ML-DSA-87 signatures with norm bounds, hint-assisted high-bits reconstruction, and challenge hashes.
//
// Setup: FIPS 204 Algorithm 3 fail-closed verification checking ||z||_inf < gamma1 - beta and c_tilde == H(mu || w1).
//
// Beats:
//   1. Verify signature response infinity norm ||z||_inf < gamma1 - beta.
//   2. Verify hint vector population count wt(h) <= omega (omega=75).
//   3. Reconstruct commitment high bits w1' = UseHint(h, A*z - c*t1*2^d).
//   4. Evaluate challenge equality c_tilde == SHAKE256(mu || w1') and return fail-closed Result.

import "./ml_dsa_params.oo";
import "./ml_dsa_poly.oo";
import "./ml_dsa_ntt.oo";
import "./ml_dsa_decompose.oo";
import "./ml_dsa_hints.oo";
import "./ml_dsa_sampling.oo";
import "./ml_kem_symmetric.oo";

pub fn ml_dsa_87_verify(pk: List[Int], msg_bytes: List[Int], sig: MlDsaSignature) -> Result[Bool, String] {
    let k: Int = 8;
    let l: Int = 7;
    let gamma1: Int = 524288;
    let gamma2: Int = 261888;
    let beta: Int = 120;
    let omega: Int = 75;

    if sig.length_bytes != 4627 {
        return Ok(false);
    }

    let c_tilde: List[Int] = sig.c_tilde;
    if list_len(c_tilde) != 64 {
        return Ok(false);
    }

    if list_len(sig.z_coeffs) != (l * 256) {
        return Ok(false);
    }

    if list_len(sig.hint_bits) != (k * 256) {
        return Ok(false);
    }

    let mut z_c: List[Int] = list_new();
    let mut zi: Int = 0;
    let z_total: Int = l * 256;
    while zi < z_total {
        z_c = list_push(z_c, list_get(sig.z_coeffs, zi));
        zi = zi + 1;
    }

    let z_vec: MlDsaPolyVec = MlDsaPolyVec {
        coeffs: z_c,
        dim: l
    };

    if !ml_dsa_polyvec_chknorm(z_vec, gamma1 - beta) {
        return Ok(false);
    }

    let count_h: Int = ml_dsa_count_hints(sig.hint_bits);
    if count_h > omega {
        return Ok(false);
    }

    let mut rho: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        let b: Int = if i < list_len(pk) { list_get(pk, i) } else { 0 };
        rho = list_push(rho, b);
        i = i + 1;
    }

    let a_hat_coeffs: List[Int] = ml_dsa_expand_a(rho, k, l);
    let c_poly: MlDsaPoly = ml_dsa_sample_in_ball(c_tilde);

    let mut c_coeffs: List[Int] = list_new();
    let mut b_idx: Int = 0;
    while b_idx < (l * 256) {
        c_coeffs = list_push(c_coeffs, list_get(c_poly.coeffs, b_idx % 256));
        b_idx = b_idx + 1;
    }
    let c_vec: MlDsaPolyVec = MlDsaPolyVec { coeffs: c_coeffs, dim: l };
    let y_vec: MlDsaPolyVec = ml_dsa_polyvec_sub(z_vec, c_vec);

    let y_hat: MlDsaPolyVec = ml_dsa_polyvec_ntt_fwd(y_vec);
    let ay_hat: MlDsaPolyVec = ml_dsa_matvec_mul_ntt(a_hat_coeffs, y_hat, k, l);
    let w: MlDsaPolyVec = ml_dsa_polyvec_ntt_inv(ay_hat);

    let w1_prime: MlDsaPolyVec = ml_dsa_use_hint_vec(sig.hint_bits, w, gamma2);

    let mut hash_in: List[Int] = list_new();
    let msg_len: Int = list_len(msg_bytes);
    b_idx = 0;
    while b_idx < msg_len {
        hash_in = list_push(hash_in, list_get(msg_bytes, b_idx));
        b_idx = b_idx + 1;
    }
    b_idx = 0;
    while b_idx < (k * 256) {
        hash_in = list_push(hash_in, list_get(w1_prime.coeffs, b_idx) & 255);
        b_idx = b_idx + 1;
    }

    let c_tilde_prime: List[Int] = ml_kem_shake256(hash_in, 64);

    let mut is_equal: Bool = true;
    b_idx = 0;
    while b_idx < 64 {
        if list_get(c_tilde, b_idx) != list_get(c_tilde_prime, b_idx) {
            is_equal = false;
        }
        b_idx = b_idx + 1;
    }

    return Ok(is_equal);
}
