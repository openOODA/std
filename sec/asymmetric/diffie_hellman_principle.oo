// # Diffie-Hellman principle
//
// Logline: The shared secret g^(ab) mod p equals (g^a mod p)^b mod p and (g^b mod p)^a mod p, so both sides compute the same value when given the other's public key.
//
// Setup: Pure Int. Square-and-multiply mod_pow uses only *. Hostile p, a, b, exp, or m return Err. 0 is a valid modular value.
//
// RULES.oot 1.7: Under 256 lines; pure Int; no abs_f, close, or pow; uses * and %.
//
// Beats:
//   1. dh_shared_secret(g, a, b, p) = g^(a*b) mod p as Result.
//   2. dh_alice(g, a, p) = g^a mod p and dh_bob(g, b, p) = g^b mod p.
//   3. dh_derive_alice(alice_pub, bob_pub, a, b, p) reports both sides agree.
//   4. Golden (g=2, p=23, a=4, b=3) -> shared = 2. g^0 = Ok(1) identity.
//   5. Hostile p<=1, a<0, b<0, exp<0, m<=1 return Err("ERR\tdh\tdomain").

import "std/core/primitives/domain_cert.oo";

fn dh_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Modular exponentiation: base^exp mod m. Uses only * (no pow). Hostile m <= 1 or exp < 0 returns Err.
pub fn dh_mod_pow(base: Int, exp: Int, m: Int) -> Result[Int, String] {
    if m <= 1 { return Err("ERR\tdh\tdomain"); }
    if exp < 0 { return Err("ERR\tdh\tdomain"); }
    let mut m_res: Int = 1;
    let mut m_base: Int = base % m;
    if m_base < 0 { m_base = m_base + m; }
    let mut m_exp: Int = exp;
    while m_exp > 0 {
        if m_exp % 2 == 1 {
            m_res = (m_res * m_base) % m;
        }
        m_exp = m_exp / 2;
        m_base = (m_base * m_base) % m;
    }
    return Ok(m_res);
}

// Direct shared secret: g^(a*b) mod p. Hostile p <= 1, a < 0, or b < 0 returns Err.
pub fn dh_shared_secret(g: Int, a: Int, b: Int, p: Int) -> Result[Int, String] {
    if p <= 1 { return Err("ERR\tdh\tdomain"); }
    if a < 0 { return Err("ERR\tdh\tdomain"); }
    if b < 0 { return Err("ERR\tdh\tdomain"); }
    return dh_mod_pow(g, a * b, p);
}

// Alice's public key: g^a mod p.
pub fn dh_alice_pub(g: Int, a: Int, p: Int) -> Result[Int, String] {
    if p <= 1 { return Err("ERR\tdh\tdomain"); }
    if a < 0 { return Err("ERR\tdh\tdomain"); }
    return dh_mod_pow(g, a, p);
}

// Bob's public key: g^b mod p.
pub fn dh_bob_pub(g: Int, b: Int, p: Int) -> Result[Int, String] {
    if p <= 1 { return Err("ERR\tdh\tdomain"); }
    if b < 0 { return Err("ERR\tdh\tdomain"); }
    return dh_mod_pow(g, b, p);
}

// Alice's derived secret: bob_pub^a mod p.
pub fn dh_alice_secret(bob_pub: Int, a: Int, p: Int) -> Result[Int, String] {
    if p <= 1 { return Err("ERR\tdh\tdomain"); }
    if a < 0 { return Err("ERR\tdh\tdomain"); }
    return dh_mod_pow(bob_pub, a, p);
}

// Bob's derived secret: alice_pub^b mod p.
pub fn dh_bob_secret(alice_pub: Int, b: Int, p: Int) -> Result[Int, String] {
    if p <= 1 { return Err("ERR\tdh\tdomain"); }
    if b < 0 { return Err("ERR\tdh\tdomain"); }
    return dh_mod_pow(alice_pub, b, p);
}

// 1 if both sides derive the same shared secret; 0 otherwise. Err secrets disagree.
pub fn dh_agree(alice_pub: Int, bob_pub: Int, a: Int, b: Int, p: Int) -> Int {
    let sa: Result[Int, String] = dh_alice_secret(bob_pub, a, p);
    let sb: Result[Int, String] = dh_bob_secret(alice_pub, b, p);
    if sa.is_ok() == false { return 0; }
    if sb.is_ok() == false { return 0; }
    if dh_got(sa) == dh_got(sb) { return 1; }
    return 0;
}

pub fn dh_principle_holds(g: Int, a: Int, b: Int, p: Int) -> DomainCert {
    let direct: Result[Int, String] = dh_shared_secret(g, a, b, p);
    let alice_pub: Result[Int, String] = dh_alice_pub(g, a, p);
    let bob_pub: Result[Int, String] = dh_bob_pub(g, b, p);
    if direct.is_ok() == false { return domain_cert("crypto", "diffie_hellman_principle", 0); }
    if alice_pub.is_ok() == false { return domain_cert("crypto", "diffie_hellman_principle", 0); }
    if bob_pub.is_ok() == false { return domain_cert("crypto", "diffie_hellman_principle", 0); }
    let agree: Int = dh_agree(dh_got(alice_pub), dh_got(bob_pub), a, b, p);
    if dh_got(direct) >= 0 {
        if agree == 1 {
            return domain_cert("crypto", "diffie_hellman_principle", 1);
        }
    }
    return domain_cert("crypto", "diffie_hellman_principle", 0);
}

pub fn verify_diffie_hellman_principle() -> Bool {
    // Golden: g=2, p=23, a=4, b=3 -> shared = 2^12 mod 23 = 2.
    let s0: Result[Int, String] = dh_shared_secret(2, 4, 3, 23);
    if s0.is_ok() == false { return false; }
    if dh_got(s0) != 2 { return false; }
    // Golden: alice_pub = 2^4 mod 23 = 16, bob_pub = 2^3 mod 23 = 8.
    let ap: Result[Int, String] = dh_alice_pub(2, 4, 23);
    if ap.is_ok() == false { return false; }
    if dh_got(ap) != 16 { return false; }
    let bp: Result[Int, String] = dh_bob_pub(2, 3, 23);
    if bp.is_ok() == false { return false; }
    if dh_got(bp) != 8 { return false; }
    // Golden: both derived secrets equal 2.
    let as0: Result[Int, String] = dh_alice_secret(8, 4, 23);
    if as0.is_ok() == false { return false; }
    if dh_got(as0) != 2 { return false; }
    let bs0: Result[Int, String] = dh_bob_secret(16, 3, 23);
    if bs0.is_ok() == false { return false; }
    if dh_got(bs0) != 2 { return false; }
    // Golden: dh_agree reports 1.
    if dh_agree(16, 8, 4, 3, 23) != 1 { return false; }

    // Golden: zero exponent returns Ok(1) (g^0 = 1 identity).
    let z0: Result[Int, String] = dh_shared_secret(2, 0, 3, 23);
    if z0.is_ok() == false { return false; }
    if dh_got(z0) != 1 { return false; }
    // Golden: 0^ab mod p is Ok(0), not dummy-0.
    let zm: Result[Int, String] = dh_shared_secret(0, 4, 3, 23);
    if zm.is_ok() == false { return false; }
    if dh_got(zm) != 0 { return false; }
    // Golden: g=5, p=23, a=2, b=3 -> 5^6 mod 23 = 8.
    let s5: Result[Int, String] = dh_shared_secret(5, 2, 3, 23);
    if s5.is_ok() == false { return false; }
    if dh_got(s5) != 8 { return false; }
    // Golden: g=2, p=23, a=1, b=0 -> shared = 1 (anything^0 = 1).
    let z1: Result[Int, String] = dh_shared_secret(2, 1, 0, 23);
    if z1.is_ok() == false { return false; }
    if dh_got(z1) != 1 { return false; }
    let z2: Result[Int, String] = dh_shared_secret(2, 0, 1, 23);
    if z2.is_ok() == false { return false; }
    if dh_got(z2) != 1 { return false; }
    // Golden: commutativity ab == ba.
    let cab: Result[Int, String] = dh_shared_secret(2, 4, 3, 23);
    let cba: Result[Int, String] = dh_shared_secret(2, 3, 4, 23);
    if cab.is_ok() == false { return false; }
    if cba.is_ok() == false { return false; }
    if dh_got(cab) != dh_got(cba) { return false; }

    // Coupled: both sides derive the same secret for a different key set.
    let ap2: Result[Int, String] = dh_alice_pub(3, 5, 31);
    let bp2: Result[Int, String] = dh_bob_pub(3, 7, 31);
    if ap2.is_ok() == false { return false; }
    if bp2.is_ok() == false { return false; }
    if dh_agree(dh_got(ap2), dh_got(bp2), 5, 7, 31) != 1 { return false; }

    // Hostile: p <= 1, a < 0, b < 0, exp < 0, m <= 1 fail closed (is_ok false, not dummy 0).
    if dh_shared_secret(2, 4, 3, 0).is_ok() { return false; }
    if dh_shared_secret(2, 4, 3, 0 - 1).is_ok() { return false; }
    if dh_shared_secret(2, 4, 3, 1).is_ok() { return false; }
    if dh_shared_secret(2, 0 - 1, 3, 23).is_ok() { return false; }
    if dh_alice_pub(2, 0 - 1, 23).is_ok() { return false; }
    if dh_shared_secret(2, 4, 0 - 1, 23).is_ok() { return false; }
    if dh_bob_pub(2, 0 - 1, 23).is_ok() { return false; }
    if dh_mod_pow(2, 0 - 1, 23).is_ok() { return false; }
    if dh_mod_pow(2, 4, 1).is_ok() { return false; }
    if dh_alice_secret(8, 0 - 1, 23).is_ok() { return false; }
    if dh_bob_secret(16, 0 - 1, 23).is_ok() { return false; }
    if dh_agree(16, 8, 0 - 1, 3, 23) != 0 { return false; }

    // Coupled: domain_cert holds=1 for golden tuple and 0 for hostile.
    let c1: DomainCert = dh_principle_holds(2, 4, 3, 23);
    if c1.holds != 1 { return false; }
    if c1.domain != "crypto" { return false; }
    if c1.law_name != "diffie_hellman_principle" { return false; }
    let c0: DomainCert = dh_principle_holds(0, 4, 3, 23);
    if c0.holds != 1 { return false; }
    let c2: DomainCert = dh_principle_holds(2, 0 - 1, 3, 23);
    if c2.holds != 0 { return false; }
    let c3: DomainCert = dh_principle_holds(2, 4, 3, 0);
    if c3.holds != 0 { return false; }

    return true;
}
