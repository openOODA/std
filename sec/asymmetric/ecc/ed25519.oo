// # Ed25519 RFC 8032 Sign/Verify Facade
//
// Logline: High-level RFC 8032 Ed25519 facade that exposes seed hash, scalar clamp, public key derivation, signature generation, and signature verification using the openOODA SHA-512 hex digest, twisted Edwards curve point operations, and the 256-bit wide scalar multiplier.
//
// Setup: Pure. The seed is a 64-char lowercase hex string (32 bytes). Hex inputs and outputs are 64-char strings for keys and 128-char strings for signatures. Wide scalarmult walks 256 bits in 16 16-bit limbs.
//
// Beats:
//   1. Hash the seed with SHA-512 and expose the 128-char hex digest.
//   2. Clamp the low 256 bits of the seed hash to form the secret scalar per RFC 8032 Section 5.1.3.
//   3. Derive the candidate public key by 256-bit scalar-multiplying the base point and compressing the result to 32 bytes.
//   4. Sign a message by computing r, R = [r]B, k, and S = r + k * a, returning the 64-byte R||S frame.
//   5. Verify a signature by recomputing [S]B - [k]A and comparing to R.

import "std/sec/hash/sha512.oo";
import "ed25519_curve.oo";
import "ed25519_scalarmult_wide.oo";
import "ed25519_bigint.oo";
import "std/sec/ct/ct_primitives.oo";
import "std/core/encoding/hex.oo";

// Ed25519 hashes RAW BYTES (RFC 8032). The _hex APIs take hex text, so
// every hash site must hex-decode first. Hashing the hex text itself is
// a verified-wrong variant (rejected the oracle vector, 2026-09-27).
fn sha512_of_hex(hexdata: String) -> Result[String, String] {
    let raw: Result[String, String] = hex_decode(hexdata);
    if raw.is_err() { return Err("ERR\ted25519\thex_decode_failed"); }
    return Ok(sha512(match raw { Ok(s) => s, Err(_) => "" }));
}

pub fn ed25519_hash_seed(seed_hex: String) -> String {
    let hr: Result[String, String] = sha512_of_hex(seed_hex);
    return match hr { Ok(s) => s, Err(_) => "" };
}

pub fn ed25519_scalar_clamp_hex(seed_hash_hex: String) -> String {
    // RFC 8032 §5.1.5 on the FIRST 32 bytes (little-endian scalar):
    // byte0 &= 248; byte31 &= 63; byte31 |= 64.
    if chars_len(seed_hash_hex) < 64 { return seed_hash_hex; }
    let b0: Int = hex_nibble_val(char_at(seed_hash_hex, 0)) * 16 + hex_nibble_val(char_at(seed_hash_hex, 1));
    let b31: Int = hex_nibble_val(char_at(seed_hash_hex, 62)) * 16 + hex_nibble_val(char_at(seed_hash_hex, 63));
    let c0: String = hex_byte_to_str(b0 & 248, false);
    let c31: String = hex_byte_to_str((b31 & 63) | 64, false);
    return c0 + str_slice(seed_hash_hex, 2, 62) + c31;
}

pub fn ed25519_pubkey_from_seed_hex(seed_hex: String) -> Result[String, String] {
    let hr: Result[String, String] = sha512_of_hex(seed_hex);
    if hr.is_err() { return Err("ERR\ted25519\tbad_seed_hex"); }
    let h: String = match hr { Ok(s) => s, Err(_) => "" };
    let clamped_hex: String = ed25519_scalar_clamp_hex(h);
    let limbs: List[Int] = hex_to_limbs16(clamped_hex);
    let base: List[Int] = ed25519_curve_base();
    let q: List[Int] = ed25519_curve_scalarmult_wide(base, limbs);
    let cr: Result[List[Int], String] = ed25519_curve_compress(q);
    match cr {
        Ok(bytes) => { return Ok(bytes_to_hex(bytes)); }
        Err(_)    => { return Err("ERR\ted25519\tcompress_failed"); }
    }
}

pub fn ed25519_sign_hex(seed_hex: String, msg_hex: String) -> Result[String, String] {
    let hr: Result[String, String] = sha512_of_hex(seed_hex);
    if hr.is_err() { return Err("ERR\ted25519\tbad_seed_hex"); }
    let h: String = match hr { Ok(s) => s, Err(_) => "" };
    let clamped_hex: String = ed25519_scalar_clamp_hex(h);
    let prefix_hex: String = str_slice(h, 64, 128);
    let nonce_input: String = prefix_hex + msg_hex;
    let nr: Result[String, String] = sha512_of_hex(nonce_input);
    if nr.is_err() { return Err("ERR\ted25519\tbad_nonce_hex"); }
    let r_hex: String = match nr { Ok(s) => s, Err(_) => "" };
    let r_limbs: List[Int] = hex_to_limbs16(r_hex);
    let base: List[Int] = ed25519_curve_base();
    let r_point: List[Int] = ed25519_curve_scalarmult_wide(base, r_limbs);
    let rc: Result[List[Int], String] = ed25519_curve_compress(r_point);
    if rc.is_err() { return Err("ERR\ted25519\tr_compress_failed"); }
    let r_bytes: List[Int] = unwrap_bytes(rc);
    let pk_res: Result[String, String] = ed25519_pubkey_from_seed_hex(seed_hex);
    if pk_res.is_err() { return Err("ERR\ted25519\tpk_derive_failed"); }
    let pk_hex: String = unwrap_string(pk_res);
    let r_hex_str: String = bytes_to_hex(r_bytes);
    let hram_input: String = r_hex_str + pk_hex + msg_hex;
    let kr: Result[String, String] = sha512_of_hex(hram_input);
    if kr.is_err() { return Err("ERR\ted25519\tbad_hram_hex"); }
    let hram_hex: String = match kr { Ok(s) => s, Err(_) => "" };
    let k_limbs: List[Int] = hex_to_limbs16(hram_hex);
    let a_limbs: List[Int] = hex_to_limbs16(clamped_hex);
    // Reduce 512-bit k and r first: mul/add only keep 16x16->32 / 16+16 limbs,
    // so feeding 32-limb values silently dropped their high halves (2026-09-27).
    let k_mod: List[Int] = ed25519_limbs32_mod_l(k_limbs);
    let r_mod: List[Int] = ed25519_limbs32_mod_l(r_limbs);
    let ka_full: List[Int] = ed25519_limbs16_mul(a_limbs, k_mod);
    let ka_mod: List[Int] = ed25519_limbs32_mod_l(ka_full);
    let s_mod: List[Int] = ed25519_limbs16_mod_l(ed25519_limbs16_add(r_mod, ka_mod));
    let s_bytes: List[Int] = ed25519_limbs16_to_bytes_le(s_mod);
    let s_hex_str: String = bytes_to_hex(s_bytes);
    let sig_hex: String = r_hex_str + s_hex_str;
    return Ok(sig_hex);
}

pub fn ed25519_verify_hex(pubkey_hex: String, msg_hex: String, sig_hex: String) -> Bool {
    if chars_len(sig_hex) != 128 { return false; }
    let r_hex: String = str_slice(sig_hex, 0, 64);
    let s_hex: String = str_slice(sig_hex, 64, 128);
    let r_bytes: List[Int] = hex_to_bytes(r_hex);
    let pk_bytes: List[Int] = hex_to_bytes(pubkey_hex);
    let ar: Result[List[Int], String] = ed25519_curve_decompress(pk_bytes);
    if ar.is_err() { return false; }
    let a_pt: List[Int] = unwrap_bytes(ar);
    let base: List[Int] = ed25519_curve_base();
    let s_limbs: List[Int] = hex_to_limbs16(s_hex);
    let sb: List[Int] = ed25519_curve_scalarmult_wide(base, s_limbs);
    let hram_input: String = r_hex + pubkey_hex + msg_hex;
    let kr: Result[String, String] = sha512_of_hex(hram_input);
    if kr.is_err() { return false; }
    let hram_hex: String = match kr { Ok(s) => s, Err(_) => "" };
    let k_limbs: List[Int] = hex_to_limbs16(hram_hex);
    let ka: List[Int] = ed25519_curve_scalarmult_wide(a_pt, k_limbs);
    let neg_ka: List[Int] = ed25519_curve_neg(ka);
    let lhs: List[Int] = ed25519_curve_add(sb, neg_ka);
    let lhs_c: Result[List[Int], String] = ed25519_curve_compress(lhs);
    let lhs_bytes: List[Int] = unwrap_bytes(lhs_c);
    return bytes_equal(lhs_bytes, r_bytes);
}

pub fn ed25519_signature_frame_hex(pubkey_hex: String, sig_hex: String) -> String {
    return pubkey_hex + ":" + sig_hex;
}

fn hex_nibble_val(c: String) -> Int {
    let hex_chars: String = "0123456789abcdef";
    let idx_l: Int = str_index_of(hex_chars, c);
    if idx_l >= 0 { return idx_l; }
    return 0;
}

fn hex_byte_to_str(b: Int, upper: Bool) -> String {
    let hex_lo: String = "0123456789abcdef";
    let hex_up: String = "0123456789ABCDEF";
    let lo: Int = b & 15;
    let hi: Int = (b >> 4) & 15;
    if upper { return char_at(hex_up, hi) + char_at(hex_up, lo); }
    return char_at(hex_lo, hi) + char_at(hex_lo, lo);
}

fn bytes_to_hex(bytes: List[Int]) -> String {
    let mut out: String = "";
    let mut i: Int = 0;
    while i < list_len(bytes) {
        let b: Int = list_get(bytes, i);
        let bb: Int = if b < 0 { b + 256 } else { b };
        out = out + hex_byte_to_str(bb, false);
        i = i + 1;
    }
    return out;
}

fn hex_to_bytes(hex: String) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = chars_len(hex);
    let mut i: Int = 0;
    while i + 1 < n {
        let hi: Int = hex_nibble_val(char_at(hex, i));
        let lo: Int = hex_nibble_val(char_at(hex, i + 1));
        out = list_push(out, (hi * 16) + lo);
        i = i + 2;
    }
    return out;
}

fn hex_to_limbs16(hex: String) -> List[Int] {
    let bytes: List[Int] = hex_to_bytes(hex);
    let mut out: List[Int] = list_new();
    let n: Int = list_len(bytes);
    let mut i: Int = 0;
    while i < n {
        let lo: Int = list_get(bytes, i) & 255;
        let mut hi: Int = 0;
        if i + 1 < n { hi = list_get(bytes, i + 1) & 255; }
        out = list_push(out, lo + (hi * 256));
        i = i + 2;
    }
    while list_len(out) < 16 {
        out = list_push(out, 0);
    }
    return out;
}

fn bytes_equal(a: List[Int], b: List[Int]) -> Bool {
    return ct_memcmp_eq(a, b) == 1;
}

fn unwrap_bytes(r: Result[List[Int], String]) -> List[Int] {
    if r.is_ok() {
        match r {
            Ok(b)  => { return b; }
            Err(_) => { return list_new(); }
        }
    }
    return list_new();
}

fn unwrap_string(r: Result[String, String]) -> String {
    if r.is_ok() {
        match r {
            Ok(s)  => { return s; }
            Err(_) => { return ""; }
        }
    }
    return "";
}

