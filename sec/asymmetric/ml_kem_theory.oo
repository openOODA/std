// # ML-KEM (Module-Lattice-Based KEM) theory
//
// Logline: FIPS 203 ML-KEM-768 is a Module-LWE key-encapsulation mechanism with documented parameters n=256, k=3, q=3329, eta1=2, eta2=2, du=10, dv=4; unknown parameter-set names fail closed; the scheme is built on Module-LWE so the LWE hardness assumption is the coupled primitive.
//
// Setup: Pure Int. ml_kem_params("ML-KEM-768") returns a 7-element list [n, k, q, eta1, eta2, du, dv] holding the documented FIPS 203 §8 parameter set. Hostile or unknown name returns Err. ml_kem_is_module_lwe reports the coupled primitive.
//
// RULES.oot 1.7: Under 256 lines; pure Int; no abs_f, close, or pow; uses * and %.
//
// Beats:
//   1. ml_kem_params returns [n, k, q, eta1, eta2, du, dv] for the FIPS 203 §8 names.
//   2. ml_kem_params("ML-KEM-768") -> [256, 3, 3329, 2, 2, 10, 4].
//   3. ml_kem_params("ML-KEM-512") and "ML-KEM-1024" return their respective FIPS 203 §8 tuples.
//   4. ml_kem_params rejects unknown or empty names with Err.
//   5. ml_kem_is_module_lwe() reports 1 (ML-KEM is Module-LWE based per FIPS 203 §4 and CRYSTALS-Kyber Round 3 §3.1).
//   6. domain_cert("crypto", "ml_kem_theory", holds) is the certificate; verify_ml_kem_theory aggregates every assertion.

import "std/core/primitives/domain_cert.oo";

// FIPS 203 (Aug 2024) ML-KEM parameter sources for the 7-tuple [n, k, q, eta1, eta2, du, dv]:
//   n=256, k=3  -- FIPS 203 §8 Table 2 (ML-KEM-768 row).
//   q=3329      -- FIPS 203 §4.1 (the prime q = 2^8 * 13 + 1).
//   eta1, eta2  -- FIPS 203 §8 Table 2 (centre binomial distribution params).
//   du, dv      -- FIPS 203 §4.1.2 (compression bit widths for u and v).

fn mlk_got(r: Result[Int, String]) -> Int {
    match r { Ok(v) => { return v; }, Err(_) => { return 0 - 1; } }
}

// Build a 7-element [n, k, q, eta1, eta2, du, dv] list.
fn mlk_pack(n: Int, k: Int, q: Int, eta1: Int, eta2: Int, du: Int, dv: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, n);
    out = list_push(out, k);
    out = list_push(out, q);
    out = list_push(out, eta1);
    out = list_push(out, eta2);
    out = list_push(out, du);
    out = list_push(out, dv);
    return out;
}

// Lookup a named ML-KEM parameter set. Recognizes the three FIPS 203 §8 names
// (ML-KEM-512, ML-KEM-768, ML-KEM-1024). Unknown or empty name returns Err.
pub fn ml_kem_params(name: String) -> Result[List[Int], String] {
    if name == "ML-KEM-768" {
        // FIPS 203 §8 Table 2: ML-KEM-768.
        return Ok(mlk_pack(256, 3, 3329, 2, 2, 10, 4));
    }
    if name == "ML-KEM-512" {
        // FIPS 203 §8 Table 2: ML-KEM-512.
        return Ok(mlk_pack(256, 2, 3329, 3, 2, 10, 4));
    }
    if name == "ML-KEM-1024" {
        // FIPS 203 §8 Table 2: ML-KEM-1024.
        return Ok(mlk_pack(256, 4, 3329, 2, 2, 11, 5));
    }
    return Err("ERR\tmlkem\tname");
}

// Convenience accessors. Caller has already validated is_ok.
pub fn mlk_n(p: List[Int]) -> Int { return list_get(p, 0); }
pub fn mlk_k(p: List[Int]) -> Int { return list_get(p, 1); }
pub fn mlk_q(p: List[Int]) -> Int { return list_get(p, 2); }
pub fn mlk_eta1(p: List[Int]) -> Int { return list_get(p, 3); }
pub fn mlk_eta2(p: List[Int]) -> Int { return list_get(p, 4); }
pub fn mlk_du(p: List[Int]) -> Int { return list_get(p, 5); }
pub fn mlk_dv(p: List[Int]) -> Int { return list_get(p, 6); }

// 1 if ML-KEM is built on Module-LWE per FIPS 203 §4 and Bos-Lyubashevsky
// CRYSTALS-Kyber Round 3 spec §3.1; 0 otherwise. The coupled primitive
// assertion is the foundation of the security claim.
pub fn ml_kem_is_module_lwe() -> Int {
    return 1;
}

// FIPS 203 §4.1: q is a prime of the form 2^8 * 13 + 1 = 3329. Confirm by
// reconstructing the prime from its factorisation; a stray q fails closed.
pub fn ml_kem_q_factor_ok(q: Int) -> Int {
    if q != 3329 { return 0; }
    if q != 256 * 13 + 1 { return 0; }
    return 1;
}

// domain_cert wrapper for the ml_kem_theory law.
pub fn ml_kem_theory_holds(name: String) -> DomainCert {
    let pr: Result[List[Int], String] = ml_kem_params(name);
    if pr.is_ok() == false { return domain_cert("crypto", "ml_kem_theory", 0); }
    if ml_kem_is_module_lwe() != 1 { return domain_cert("crypto", "ml_kem_theory", 0); }
    return domain_cert("crypto", "ml_kem_theory", 1);
}

pub fn verify_ml_kem_theory() -> Bool {
    // Golden: ML-KEM-768 returns the FIPS 203 §8 documented tuple.
    let p768: Result[List[Int], String] = ml_kem_params("ML-KEM-768");
    if p768.is_ok() == false { return false; }
    let l768: List[Int] = p768.val;
    // 0.001% precision: every field must match the spec value exactly.
    if mlk_n(l768) != 256 { return false; }
    if mlk_k(l768) != 3 { return false; }
    if mlk_q(l768) != 3329 { return false; }
    if mlk_eta1(l768) != 2 { return false; }
    if mlk_eta2(l768) != 2 { return false; }
    if mlk_du(l768) != 10 { return false; }
    if mlk_dv(l768) != 4 { return false; }
    if list_len(l768) != 7 { return false; }

    // Golden: ML-KEM-512.
    let p512: Result[List[Int], String] = ml_kem_params("ML-KEM-512");
    if p512.is_ok() == false { return false; }
    let l512: List[Int] = p512.val;
    if mlk_n(l512) != 256 { return false; }
    if mlk_k(l512) != 2 { return false; }
    if mlk_q(l512) != 3329 { return false; }
    if mlk_eta1(l512) != 3 { return false; }
    if mlk_eta2(l512) != 2 { return false; }
    if mlk_du(l512) != 10 { return false; }
    if mlk_dv(l512) != 4 { return false; }

    // Golden: ML-KEM-1024.
    let p1024: Result[List[Int], String] = ml_kem_params("ML-KEM-1024");
    if p1024.is_ok() == false { return false; }
    let l1024: List[Int] = p1024.val;
    if mlk_n(l1024) != 256 { return false; }
    if mlk_k(l1024) != 4 { return false; }
    if mlk_q(l1024) != 3329 { return false; }
    if mlk_eta1(l1024) != 2 { return false; }
    if mlk_eta2(l1024) != 2 { return false; }
    if mlk_du(l1024) != 11 { return false; }
    if mlk_dv(l1024) != 5 { return false; }

    // Golden: 0.001% precision on the q factorisation identity q = 2^8 * 13 + 1.
    // FIPS 203 §4.1: q = 3329 exactly; 0.001% tolerance means any divergence
    // larger than 0.033 unit fails. Here we check the literal equality first.
    if ml_kem_q_factor_ok(3329) != 1 { return false; }
    if ml_kem_q_factor_ok(3328) != 0 { return false; }
    if ml_kem_q_factor_ok(0) != 0 { return false; }
    if ml_kem_q_factor_ok(3330) != 0 { return false; }

    // Hostile: unknown names fail closed (is_ok false, not dummy 0).
    if ml_kem_params("ML-KEM-999").is_ok() { return false; }
    if ml_kem_params("kyber").is_ok() { return false; }
    if ml_kem_params("").is_ok() { return false; }
    if ml_kem_params("ml-kem-768").is_ok() { return false; }

    // Coupled: ML-KEM is Module-LWE based per FIPS 203 §4.
    if ml_kem_is_module_lwe() != 1 { return false; }

    // Coupled: domain_cert holds=1 for valid name, 0 for unknown.
    let c1: DomainCert = ml_kem_theory_holds("ML-KEM-768");
    if c1.holds != 1 { return false; }
    if c1.domain != "crypto" { return false; }
    if c1.law_name != "ml_kem_theory" { return false; }
    let c0: DomainCert = ml_kem_theory_holds("bogus");
    if c0.holds != 0 { return false; }

    return true;
}
