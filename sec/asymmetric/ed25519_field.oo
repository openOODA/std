// # Ed25519 Field Reduction
//
// Logline: Canonical modular reduction for the Ed25519 field 2^255-19 so point compression always emits fully reduced encodings.
//
// Setup: Pure. A field element is 16 little-endian 16-bit limbs (limb 0 may carry a small excess after carry chains).
//
// Beats:
//   1. Subtract p = 2^255-19 with a borrow chain when the input is >= p.
//   2. Return the input unchanged when it is already below p.
//   3. Two passes reduce any value below 2^255 + 2^242 into [0, p).
pub fn ed25519_field_sub_p_if_ge(t: List[Int]) -> List[Int] {
    // p = 2^255 - 19, LE 16-bit limbs: [65517, 65535 x13, 32767].
    let mut d: List[Int] = list_new();
    let mut borrow: Int = 0;
    let mut i: Int = 0;
    while i < 16 {
        let pi: Int = if i == 0 { 65517 } else if i == 15 { 32767 } else { 65535 };
        let cur: Int = list_get(t, i) - pi - borrow;
        d = list_push(d, cur & 65535);
        borrow = if cur < 0 { 1 } else { 0 };
        i = i + 1;
    }
    if borrow == 0 { return d; }
    return t;
}
