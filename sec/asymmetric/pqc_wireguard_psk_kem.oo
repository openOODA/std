// # WireGuard Post-Quantum PSK Key Encapsulation
//
// Logline: Injects dynamic post-quantum ML-KEM shared secrets into WireGuard Noise IKpsk2 Pre-Shared Key slots.
//
// Setup: Imports fips203_ml_kem_types.oo.
//
// Beats:
//   1. Define WgPskSession, WgNoiseHandshake, and WgPqPskConfig records.
//   2. Derive ephemeral 32-byte Pre-Shared Key from ML-KEM shared secret.
//   3. Implement re-keying timer state and secure zeroization triggers.

import "./fips203_ml_kem_types.oo";

type WgNoiseState = struct {
    chaining_key: List[Int],
    hash_h: List[Int],
    psk_slot: List[Int],
    rekey_counter: Int,
    is_established: Bool
};

pub fn wg_noise_state_new() -> WgNoiseState {
    return WgNoiseState {
        chaining_key: list_new(),
        hash_h: list_new(),
        psk_slot: list_new(),
        rekey_counter: 0,
        is_established: false
    };
}

pub fn wg_inject_pq_psk(state: WgNoiseState, pq_secret: MlKemSharedSecret) -> WgNoiseState {
    let mut psk: List[Int] = list_new();
    let count: Int = list_len(pq_secret.secret_bytes);
    let mut i: Int = 0;
    while i < 32 {
        let mut b: Int = 0;
        if i < count {
            b = list_get(pq_secret.secret_bytes, i);
        }
        psk = list_push(psk, b);
        i = i + 1;
    }
    let mut next_st: WgNoiseState = state;
    next_st.psk_slot = psk;
    next_st.is_established = true;
    next_st.rekey_counter = next_st.rekey_counter + 1;
    return next_st;
}
