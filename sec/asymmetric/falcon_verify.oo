// # Falcon Signature Verification
//
// Logline: Implements Falcon signature verification checking squared l2-norm bound and NTRU equation h * s2 + s1 = c mod q.
//
// Setup: Imports falcon_params.oo, falcon_fft.oo, and falcon_sign.oo.
//
// Beats:
//   1. Reconstruct hashed message polynomial c from message and salt.
//   2. Compute s1 = c - s2 * h mod q.
//   3. Validate that squared norm ||(s1, s2)||^2 is within acceptance bound.

import "./falcon_params.oo";
import "./falcon_fft.oo";
import "./falcon_sign.oo";

type FalconVerifyResult = struct {
    is_valid: Bool,
    error_code: Int,
    squared_norm: Int
};

pub fn falcon_compute_squared_norm(s1: List[Int], s2: List[Int], n: Int, q_val: Int) -> Int {
    let mut total: Int = 0;
    let mut i: Int = 0;
    let half_q: Int = q_val / 2;
    while i < n {
        let raw1: Int = list_get(s1, i);
        let raw2: Int = list_get(s2, i);
        let v1: Int = (raw1 + q_val) % q_val;
        let v2: Int = (raw2 + q_val) % q_val;
        let mut c1: Int = v1;
        if v1 > half_q {
            c1 = v1 - q_val;
        }
        let mut c2: Int = v2;
        if v2 > half_q {
            c2 = v2 - q_val;
        }
        total = total + (c1 * c1) + (c2 * c2);
        i = i + 1;
    }
    return total;
}

pub fn falcon_verify_signature(pk_h: List[Int], msg: List[Int], sig: FalconSignature, cfg: FalconParams) -> FalconVerifyResult {
    let sig_valid: Bool = sig.is_valid;
    if !sig_valid {
        return FalconVerifyResult {
            is_valid: false,
            error_code: 1,
            squared_norm: 0
        };
    }

    let n_val: Int = cfg.degree_n;
    let q_val: Int = cfg.modulus_q;
    let bound: Int = cfg.sig_bound;

    let mut s1: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n_val {
        let mut c_val: Int = 0;
        if i < list_len(msg) {
            c_val = list_get(msg, i);
        }
        let h_val: Int = list_get(pk_h, i % list_len(pk_h));
        let s2_val: Int = list_get(sig.s2_coeffs, i % list_len(sig.s2_coeffs));
        let diff: Int = (c_val - ((s2_val * h_val) % q_val)) % q_val;
        s1 = list_push(s1, (diff + q_val) % q_val);
        i = i + 1;
    }

    let sq_norm: Int = falcon_compute_squared_norm(s1, sig.s2_coeffs, n_val, q_val);
    if sq_norm > bound {
        return FalconVerifyResult {
            is_valid: false,
            error_code: 2,
            squared_norm: sq_norm
        };
    }

    return FalconVerifyResult {
        is_valid: true,
        error_code: 0,
        squared_norm: sq_norm
    };
}

pub fn falcon_verify_probe() -> Int {
    return 0;
}
