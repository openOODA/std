// # FHE Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for FHE.
//
// Setup: Imports fhe_types.oo for data structure definitions.
//
// Beats:
//   1. Import FHE types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.
//
// HOMOMORPHIC ARITHMETIC: The symbolic polynomial shims fhe_add /
// fhe_sub / fhe_add_plain / fhe_sub_plain / fhe_multiply /
// fhe_multiply_plain / fhe_negate / fhe_rotate have been removed
// entirely. They returned a tagged token whose c0_poly / c1_poly
// were string fragments like "(c0_a + c0_b)", not RLWE ciphertexts.
// Real homomorphic computation requires a vetted lattice-crypto FFI
// (OpenFHE / SEAL / Lattigo / HElib); the openOODA compiler does not
// provide one.

import "./fhe_types.oo";

pub fn fhe_ops_probe() -> Int {
    return 1;
}

pub fn fhe_encode_int(encode_val: Int, encode_params: FheParams) -> FhePlaintext {
    let p_mod: Int = encode_params.plain_modulus;
    let mod_val: Int = encode_val % p_mod;
    let val_str: String = mod_val.to_string();
    let enc_poly: String = "poly_val_" + val_str;
    let raw_val_str: String = encode_val.to_string();
    let plain_id_str: String = "plain_" + raw_val_str;

    return FhePlaintext {
        plain_id: plain_id_str,
        value: mod_val,
        encoded_poly: enc_poly,
        scale: 1,
        is_valid: true
    };
}

pub fn fhe_decode_int(decode_plain: FhePlaintext) -> Result[Int, String] {
    if decode_plain.is_valid == false {
        return Err("INVALID_PLAINTEXT: Cannot decode invalid plaintext structure");
    }
    return Ok(decode_plain.value);
}

// FAIL-CLOSED. A prior version built a "ciphertext" by concatenating
// string fragments of the public key and the plaintext value into
// c0_poly / c1_poly. That is not encryption: anyone with the public
// key and the plaintext can produce the identical symbol, and the
// "decrypt" path returned `cipher.checksum % plain_modulus`, which
// is recoverable from the ciphertext alone. Real FHE (BFV / BGV /
// CKKS / TFHE) requires a vetted lattice-crypto library; the
// openOODA compiler does not provide one.
pub fn fhe_encrypt(
    _encrypt_pk: FhePublicKey,
    _encrypt_params: FheParams,
    _encrypt_plain: FhePlaintext
) -> Result[FheCiphertext, String] {
    return Err("UNSUPPORTED: fhe_encrypt: compiler limitation; real FHE requires a vetted library FFI (e.g., OpenFHE, Microsoft SEAL, Lattigo, or HElib)");
}

pub fn fhe_encrypt_with_capability(
    _sys_cap: &SysCap,
    encrypt_cap_pk: FhePublicKey,
    encrypt_cap_params: FheParams,
    encrypt_cap_plain: FhePlaintext
) -> Result[FheCiphertext, String] {
    return fhe_encrypt(encrypt_cap_pk, encrypt_cap_params, encrypt_cap_plain);
}

// FAIL-CLOSED. The previous body returned `cipher.checksum %
// plain_modulus`. That value is recoverable from the ciphertext
// alone (checksum is in FheCiphertext) and has no relation to the
// real plaintext — it is a deterministic function of public data,
// not a decryption. Returning Ok with such a value would let any
// caller believe they recovered a real plaintext from any FHE
// ciphertext produced by this module.
pub fn fhe_decrypt(
    _decrypt_sk: FheSecretKey,
    _decrypt_params: FheParams,
    _decrypt_cipher: FheCiphertext
) -> Result[FhePlaintext, String] {
    return Err("UNSUPPORTED: fhe_decrypt: compiler limitation; real FHE requires a vetted library FFI (e.g., OpenFHE, Microsoft SEAL, Lattigo, or HElib)");
}

pub fn fhe_decrypt_with_capability(
    _sys_cap: &SysCap,
    decrypt_cap_sk: FheSecretKey,
    decrypt_cap_params: FheParams,
    decrypt_cap_cipher: FheCiphertext
) -> Result[FhePlaintext, String] {
    return fhe_decrypt(decrypt_cap_sk, decrypt_cap_params, decrypt_cap_cipher);
}
