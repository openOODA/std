// # Build Standard Library — Typecheck and Verify Hub
//
// Logline: Typecheck std/ANCHOR.oo with sovereign compiler. Fail closed on error.
//
// Setup: FsReadCap, ProcessCap, EnvCap. Requires sovereign compiler.
//
// Beats:
//   1. Resolve sovereign compiler binary.
//   2. Typecheck std/ANCHOR.oo with oodac check.
//   3. Print build success.

import "std/fs/process/env.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let mut oodac: String = match cr { Ok(s) => s, Err(_) => "" };
    if oodac == "" {
        oodac = "/home/jeryd/.local/bin/oodac";
    }
    println("Checking std library with " + oodac);
    let r: Result[String, String] = sys_exec(p, oodac, "check", "ANCHOR.oo");
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        return Err("std check failed: " + e);
    }
    println("std build: ANCHOR.oo typechecked successfully");
    return Ok(0);
}
